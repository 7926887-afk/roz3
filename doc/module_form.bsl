// ============================================================================
// Внешняя обработка "ОтправкаЗадачиВJira" для Розница 3.0 (управляемые формы).
// Вставляется целиком в МОДУЛЬ ЕДИНСТВЕННОЙ УПРАВЛЯЕМОЙ ФОРМЫ обработки.
// Реквизиты и элементы формы создаются программно, вручную в конфигураторе
// ничего добавлять не нужно: достаточно пустой управляемой формы.
// ============================================================================

#Область Настройки

// ВНИМАНИЕ: токен хранится в тексте обработки. Не передавайте файл посторонним.
&НаСервереБезКонтекста
Функция НастройкиJira()

	Настройки = Новый Структура;
	Настройки.Вставить("Хост",       "1c-online.atlassian.net");
	Настройки.Вставить("Email",      "ВАШ_EMAIL_ATLASSIAN");
	Настройки.Вставить("ApiToken",   "ВАШ_API_ТОКЕН");
	Настройки.Вставить("КлючПроекта","KOMP");       // KOMP или ROZN
	Настройки.Вставить("ТипЗадачи",  "Задача");
	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Реквизиты формы.
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("ОбъектЗадачи", 
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300)), , "Объект"));
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("Проблема", 
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)), , "Проблема"));
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("ЧтоНеобходимоСделать", 
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)), , "Что необходимо сделать"));
	ИзменитьРеквизиты(НовыеРеквизиты);

	// Поле "Объект" (выбор из списка открытых окон, допускается и ручной ввод).
	ПолеОбъект = Элементы.Добавить("ОбъектЗадачи", Тип("ПолеФормы"));
	ПолеОбъект.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОбъект.ПутьКДанным = "ОбъектЗадачи";
	ПолеОбъект.Заголовок = "Объект";
	ПолеОбъект.РежимВыбораИзСписка = Ложь;
	ПолеОбъект.КнопкаВыпадающегоСписка = Истина;
	ПолеОбъект.ПодсказкаВвода = "Выберите из открытых окон или введите вручную";

	// Поле "Проблема".
	ПолеПроблема = Элементы.Добавить("Проблема", Тип("ПолеФормы"));
	ПолеПроблема.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПроблема.ПутьКДанным = "Проблема";
	ПолеПроблема.Заголовок = "Проблема";
	ПолеПроблема.МногострочныйРежим = Истина;
	ПолеПроблема.Высота = 6;
	ПолеПроблема.РасширенноеРедактирование = Ложь;

	// Поле "Что необходимо сделать".
	ПолеЧтоСделать = Элементы.Добавить("ЧтоНеобходимоСделать", Тип("ПолеФормы"));
	ПолеЧтоСделать.Вид = ВидПоляФормы.ПолеВвода;
	ПолеЧтоСделать.ПутьКДанным = "ЧтоНеобходимоСделать";
	ПолеЧтоСделать.Заголовок = "Что необходимо сделать";
	ПолеЧтоСделать.МногострочныйРежим = Истина;
	ПолеЧтоСделать.Высота = 6;

	// Команды и кнопки.
	КомандаОбновить = Команды.Добавить("ОбновитьСписокОбъектов");
	КомандаОбновить.Действие = "ОбновитьСписокОбъектов";
	КомандаОбновить.Заголовок = "Обновить список окон";

	КомандаОтправить = Команды.Добавить("Отправить");
	КомандаОтправить.Действие = "Отправить";
	КомандаОтправить.Заголовок = "Отправить";

	КнопкаОбновить = Элементы.Добавить("КнопкаОбновитьСписокОбъектов", Тип("КнопкаФормы"));
	КнопкаОбновить.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаОбновить.ИмяКоманды = "ОбновитьСписокОбъектов";

	КнопкаОтправить = Элементы.Добавить("КнопкаОтправить", Тип("КнопкаФормы"));
	КнопкаОтправить.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаОтправить.ИмяКоманды = "Отправить";
	КнопкаОтправить.КнопкаПоУмолчанию = Истина;

	ЭтотОбъект.Заголовок = "Отправка задачи в Jira";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьСписокОбъектов();

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ОбновитьСписокОбъектов(Команда)

	ЗаполнитьСписокОбъектов();

КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(СокрЛП(ЭтотОбъект.Проблема)) Тогда
		ПоказатьПредупреждение(, "Заполните поле ""Проблема"".");
		Возврат;
	КонецЕсли;

	Результат = ОтправитьЗадачуНаСервере(ЭтотОбъект.ОбъектЗадачи, ЭтотОбъект.Проблема, ЭтотОбъект.ЧтоНеобходимоСделать);

	Если Результат.Успех Тогда
		ЭтотОбъект.ОбъектЗадачи = "";
		ЭтотОбъект.Проблема = "";
		ЭтотОбъект.ЧтоНеобходимоСделать = "";
		ПоказатьПредупреждение(, "Задача создана в Jira: " + Результат.Ключ + Символы.ПС + Результат.Ссылка);
	Иначе
		ПоказатьПредупреждение(, "Не удалось создать задачу." + Символы.ПС + Результат.Ошибка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОткрытыеОкна

&НаКлиенте
Процедура ЗаполнитьСписокОбъектов()

	Список = Элементы.ОбъектЗадачи.СписокВыбора;
	Список.Очистить();
	Добавленные = Новый Соответствие;

	Попытка
		Окна = ПолучитьОкна();
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Окно Из Окна Цикл

		Попытка
			Содержимое = Окно.Содержимое;
		Исключение
			Продолжить;
		КонецПопытки;

		Для Каждого ОткрытаяФорма Из Содержимое Цикл

			Попытка
				ИмяФормы = ОткрытаяФорма.ИмяФормы;
				Заголовок = ОткрытаяФорма.Заголовок;
			Исключение
				Продолжить;
			КонецПопытки;

			// Пропускаем саму обработку.
			Если СтрНачинаетсяС(ИмяФормы, "ВнешняяОбработка.") Тогда
				Продолжить;
			КонецЕсли;

			// Имя объекта метаданных: всё, что до ".Форма.".
			ПозицияФормы = СтрНайти(ИмяФормы, ".Форма.");
			Если ПозицияФормы > 0 Тогда
				ИмяОбъекта = Лев(ИмяФормы, ПозицияФормы - 1);
			Иначе
				ИмяОбъекта = ИмяФормы;
			КонецЕсли;

			Если ПустаяСтрока(Заголовок) Тогда
				Значение = ИмяОбъекта;
			Иначе
				Значение = СокрЛП(Заголовок) + " [" + ИмяОбъекта + "]";
			КонецЕсли;

			Если Добавленные[Значение] = Неопределено Тогда
				Добавленные[Значение] = Истина;
				Список.Добавить(Значение);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОтправкаВJira

&НаСервереБезКонтекста
Функция ОтправитьЗадачуНаСервере(Знач ОбъектЗадачи, Знач Проблема, Знач ЧтоНеобходимоСделать)

	Результат = Новый Структура("Успех, Ключ, Ссылка, Ошибка", Ложь, "", "", "");
	Настройки = НастройкиJira();

	Если ПустаяСтрока(Настройки.Email) Или СтрНачинаетсяС(Настройки.Email, "ВАШ_")
		Или ПустаяСтрока(Настройки.ApiToken) Или СтрНачинаетсяС(Настройки.ApiToken, "ВАШ_") Тогда
		Результат.Ошибка = "В функции НастройкиJira не заполнены Email и ApiToken.";
		Возврат Результат;
	КонецЕсли;

	// Заголовок: объект + первая строка проблемы (не длиннее 200 символов).
	ПерваяСтрока = СокрЛП(СтрПолучитьСтроку(Проблема, 1));
	Если ПустаяСтрока(ОбъектЗадачи) Тогда
		Заголовок = ПерваяСтрока;
	Иначе
		Заголовок = СокрЛП(ОбъектЗадачи) + ": " + ПерваяСтрока;
	КонецЕсли;
	Если СтрДлина(Заголовок) > 200 Тогда
		Заголовок = Лев(Заголовок, 197) + "...";
	КонецЕсли;

	// Описание в формате Atlassian Document Format.
	Содержимое = Новый Массив;
	Если Не ПустаяСтрока(ОбъектЗадачи) Тогда
		Содержимое.Добавить(АбзацADF("Объект: " + СокрЛП(ОбъектЗадачи)));
	КонецЕсли;
	Содержимое.Добавить(АбзацADF("Проблема:"));
	ДобавитьСтрокиADF(Содержимое, Проблема);
	Если Не ПустаяСтрока(СокрЛП(ЧтоНеобходимоСделать)) Тогда
		Содержимое.Добавить(АбзацADF("Что необходимо сделать:"));
		ДобавитьСтрокиADF(Содержимое, ЧтоНеобходимоСделать);
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("type", "doc");
	Описание.Вставить("version", 1);
	Описание.Вставить("content", Содержимое);

	Поля = Новый Структура;
	Поля.Вставить("project", Новый Структура("key", Настройки.КлючПроекта));
	Поля.Вставить("summary", Заголовок);
	Поля.Вставить("issuetype", Новый Структура("name", Настройки.ТипЗадачи));
	Поля.Вставить("description", Описание);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("fields", Поля));
	Тело = Запись.Закрыть();

	// Basic-авторизация: email:token в Base64.
	Авторизация = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Настройки.Email + ":" + Настройки.ApiToken, КодировкаТекста.UTF8));
	Авторизация = СтрЗаменить(СтрЗаменить(Авторизация, Символы.ПС, ""), Символы.ВК, "");

	Запрос = Новый HTTPЗапрос("/rest/api/3/issue");
	Запрос.Заголовки.Вставить("Authorization", "Basic " + Авторизация);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение(Настройки.Хост, 443, Неопределено, Неопределено, Неопределено, 30,
			Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Если Ответ.КодСостояния = 201 Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Результат.Успех = Истина;
		Результат.Ключ = Данные["key"];
		Результат.Ссылка = "https://" + Настройки.Хост + "/browse/" + Результат.Ключ;
	Иначе
		Результат.Ошибка = "HTTP " + Ответ.КодСостояния + ": " + ТелоОтвета;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция АбзацADF(Знач Текст)

	Абзац = Новый Структура;
	Абзац.Вставить("type", "paragraph");
	Узел = Новый Структура("type, text", "text", Текст);
	Абзац.Вставить("content", Новый Массив);
	Абзац.content.Добавить(Узел);
	Возврат Абзац;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокиADF(Содержимое, Знач Текст)

	Для Н = 1 По СтрЧислоСтрок(Текст) Цикл
		ТекстСтроки = СокрЛП(СтрПолучитьСтроку(Текст, Н));
		Если Не ПустаяСтрока(ТекстСтроки) Тогда
			Содержимое.Добавить(АбзацADF(ТекстСтроки));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Или Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	эв_ЗаполнитьЦены();
	
КонецПроцедуры

Процедура эв_ЗаполнитьЦены()
	
	Записи = эв_ТаблицаЗаписейДляЦены();
	Если Записи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Записи", Записи);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Записи.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Записи.Номенклатура КАК Номенклатура,
	|	Записи.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ЗаписиОстатков
	|ИЗ
	|	&Записи КАК Записи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.РозничныйВидЦен КАК ВидЦен
	|ИЗ
	|	ЗаписиОстатков КАК ЗаписиОстатков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК Магазины
	|		ПО ЗаписиОстатков.СтруктурнаяЕдиница = Магазины.Ссылка
	|ГДЕ
	|	Магазины.РозничныйВидЦен <> ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаписиОстатков.Номенклатура КАК Номенклатура
	|ИЗ
	|	ЗаписиОстатков КАК ЗаписиОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаписиОстатков.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Магазины.РозничныйВидЦен КАК ВидЦен
	|ИЗ
	|	ЗаписиОстатков КАК ЗаписиОстатков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК Магазины
	|		ПО ЗаписиОстатков.СтруктурнаяЕдиница = Магазины.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаписиОстатков.СтруктурнаяЕдиница,
	|	Магазины.РозничныйВидЦен";
	
	Результаты = Запрос.ВыполнитьПакет();
	ВидыЦен = Результаты[1].Выгрузить().ВыгрузитьКолонку("ВидЦен");
	Номенклатура = Результаты[2].Выгрузить().ВыгрузитьКолонку("Номенклатура");
	Если ВидыЦен.Количество() = 0 Или Номенклатура.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВидыЦенМагазинов = Новый Соответствие;
	ВыборкаМагазинов = Результаты[3].Выбрать();
	Пока ВыборкаМагазинов.Следующий() Цикл
		ВидыЦенМагазинов.Вставить(ВыборкаМагазинов.СтруктурнаяЕдиница, ВыборкаМагазинов.ВидЦен);
	КонецЦикла;
	
	Цены = эв_ЦеныНоменклатуры(Номенклатура, ВидыЦен);
	ПустаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если ТипЗнч(Запись.СтруктурнаяЕдиница) <> Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
			Продолжить;
		КонецЕсли;
		
		ВидЦен = ВидыЦенМагазинов.Получить(Запись.СтруктурнаяЕдиница);
		Если Не ЗначениеЗаполнено(ВидЦен) Тогда
			Запись.Цена = 0;
			Продолжить;
		КонецЕсли;
		
		Цена = Цены.Получить(эв_КлючЦены(ВидЦен, Запись.Номенклатура, Запись.Характеристика));
		Если Цена = Неопределено И Запись.Характеристика <> ПустаяХарактеристика Тогда
			Цена = Цены.Получить(эв_КлючЦены(ВидЦен, Запись.Номенклатура, ПустаяХарактеристика));
		КонецЕсли;
		Запись.Цена = ?(Цена = Неопределено, 0, Цена);
		
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ТаблицаЗаписейДляЦены()
	
	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("СтруктурнаяЕдиница", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	Записи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Записи.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если ТипЗнч(Запись.СтруктурнаяЕдиница) <> Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗаписи = Записи.Добавить();
		СтрокаЗаписи.СтруктурнаяЕдиница = Запись.СтруктурнаяЕдиница;
		СтрокаЗаписи.Номенклатура = Запись.Номенклатура;
		СтрокаЗаписи.Характеристика = Запись.Характеристика;
	КонецЦикла;
	
	Записи.Свернуть("СтруктурнаяЕдиница, Номенклатура, Характеристика");
	Возврат Записи;
	
КонецФункции

Функция эв_ЦеныНоменклатуры(Номенклатура, ВидыЦен)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидыЦен", ВидыЦен);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.ВидЦен КАК ВидЦен,
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Характеристика КАК Характеристика,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			Актуальность
	|				И Номенклатура В (&Номенклатура)
	|				И ВидЦен В (&ВидыЦен)) КАК Цены";
	
	Цены = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цены.Вставить(эв_КлючЦены(Выборка.ВидЦен, Выборка.Номенклатура, Выборка.Характеристика), Выборка.Цена);
	КонецЦикла;
	
	Возврат Цены;
	
КонецФункции

Функция эв_КлючЦены(ВидЦен, Номенклатура, Характеристика)
	
	Возврат Строка(ВидЦен.УникальныйИдентификатор())
		+ "|" + Строка(Номенклатура.УникальныйИдентификатор())
		+ "|" + Строка(Характеристика.УникальныйИдентификатор());
	
КонецФункции

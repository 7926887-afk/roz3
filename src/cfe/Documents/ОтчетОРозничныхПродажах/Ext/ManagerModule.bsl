
&Вместо("ТекстЗапросаИнициализироватьДанныеДокумента")
Функция эв_ТекстЗапросаИнициализироватьДанныеДокумента()
	
	ТекстЗапроса = ПродолжитьВызов();
	
	// Важно: не заменять по префиксу "ВременнаяТаблицаЗапасы" —
	// иначе затронется ВременнаяТаблицаЗапасыСгруппированная (там есть СГРУППИРОВАТЬ ПО).
	СтрокаЗамены =
	"
	|ПОМЕСТИТЬ ВременнаяТаблицаЗапасы
	|ИЗ
	|    Документ.ОтчетОРозничныхПродажах.Запасы КАК ОтчетОРозничныхПродажахЗапасы";
	СтрокаВставки =
	"
	|,
	|ОтчетОРозничныхПродажахЗапасы.эв_ИБ КАК эв_ИБ,
	|ОтчетОРозничныхПродажахЗапасы.эв_КБ КАК эв_КБ
	|ПОМЕСТИТЬ ВременнаяТаблицаЗапасы
	|ИЗ
	|    Документ.ОтчетОРозничныхПродажах.Запасы КАК ОтчетОРозничныхПродажахЗапасы";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, СтрокаЗамены, СтрокаВставки);
	
	Возврат ТекстЗапроса;
	
КонецФункции

&После("ЗаполнитьОтчетОРозничныхПродажахПоДаннымВЧеках")
Процедура эв_ЗаполнитьОтчетОРозничныхПродажахПоДаннымВЧеках(ОтчетОРозничныхПродажахОбъект)
	
	эв_ПеренестиРеквизитыПервостольникаИзЧеков(ОтчетОРозничныхПродажахОбъект);
	
КонецПроцедуры

Процедура эв_ПеренестиРеквизитыПервостольникаИзЧеков(ОтчетОРозничныхПродажахОбъект)
	
	Если ОтчетОРозничныхПродажахОбъект.Запасы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЧекККМЗапасы.Номенклатура КАК Номенклатура,
	|	ЧекККМЗапасы.Характеристика КАК Характеристика,
	|	ЧекККМЗапасы.Партия КАК Партия,
	|	ЧекККМЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЧекККМЗапасы.Цена КАК Цена,
	|	ЧекККМЗапасы.СтавкаНДС КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеСклада = ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВШапке)
	|			ТОГДА ЧекККМЗапасы.Ссылка.СтруктурнаяЕдиница
	|		ИНАЧЕ ЧекККМЗапасы.СтруктурнаяЕдиница
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеСклада = ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВШапке)
	|			ТОГДА ЧекККМЗапасы.Ссылка.Ячейка
	|		ИНАЧЕ ЧекККМЗапасы.Ячейка
	|	КОНЕЦ КАК Ячейка,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеОтветственный В (ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВШапке),
	|			ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ПустаяСсылка))
	|			ТОГДА ЧекККМЗапасы.Ссылка.Ответственный
	|		ИНАЧЕ ЧекККМЗапасы.Ответственный
	|	КОНЕЦ КАК Ответственный,
	|	ЧекККМЗапасы.Заказ КАК Заказ,
	|	ЧекККМЗапасы.НоменклатураНабора КАК НоменклатураНабора,
	|	ЧекККМЗапасы.ХарактеристикаНабора КАК ХарактеристикаНабора,
	|	ЗНАЧЕНИЕ(Документ.ЧекККМ.ПустаяСсылка) КАК ДокументПродажи,
	|	ЧекККМЗапасы.Ссылка.Контрагент КАК Контрагент,
	|	ЧекККМЗапасы.Ссылка.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	ЧекККМЗапасы.Ссылка.ВидСкидкиНаценки КАК ВидСкидкиНаценки,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеПатента = ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
	|			ТОГДА ЧекККМЗапасы.Патент
	|		ИНАЧЕ ЧекККМЗапасы.Ссылка.Патент
	|	КОНЕЦ КАК Патент,
	|	ЧекККМЗапасы.ДоговорПлатежногоАгента КАК ДоговорПлатежногоАгента,
	|	ЛОЖЬ КАК ВозвратБезОснования,
	|	ЗНАЧЕНИЕ(Справочник.ПричиныВозврата.ПустаяСсылка) КАК ПричинаВозврата,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СистемыНалогообложенияОрганизаций.ПлательщикУСН, ЛОЖЬ)
	|			И ЧекККМЗапасы.Ссылка.СпециальныйНалоговыйРежим = ЗНАЧЕНИЕ(Перечисление.СпециальныеНалоговыеРежимы.НеПрименяется)
	|			И ЕСТЬNULL(ЧекККМЗапасы.Партия.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыПартий.СобственныеЗапасы)) <> ЗНАЧЕНИЕ(Перечисление.СтатусыПартий.ТоварыНаКомиссии)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК УчитыватьВНУ,
	|	СУММА(ЧекККМЗапасы.эв_ИБ) КАК эв_ИБ,
	|	СУММА(ЧекККМЗапасы.эв_КБ) КАК эв_КБ
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК ЧекККМЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СистемыНалогообложенияОрганизаций.СрезПоследних(&ТекущаяДата, ) КАК СистемыНалогообложенияОрганизаций
	|		ПО ЧекККМЗапасы.Ссылка.Организация = СистемыНалогообложенияОрганизаций.Организация
	|ГДЕ
	|	ЧекККМЗапасы.Ссылка.КассоваяСмена = &КассоваяСмена
	|	И ЧекККМЗапасы.Ссылка.Проведен
	|	И НЕ ЧекККМЗапасы.Ссылка.ОперацияСДенежнымиСредствами
	|	И ЧекККМЗапасы.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	|	И (ЧекККМЗапасы.эв_ИБ <> 0
	|		ИЛИ ЧекККМЗапасы.эв_КБ <> 0)
	|СГРУППИРОВАТЬ ПО
	|	ЧекККМЗапасы.Номенклатура,
	|	ЧекККМЗапасы.Характеристика,
	|	ЧекККМЗапасы.Партия,
	|	ЧекККМЗапасы.ЕдиницаИзмерения,
	|	ЧекККМЗапасы.Цена,
	|	ЧекККМЗапасы.СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеСклада = ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВШапке)
	|			ТОГДА ЧекККМЗапасы.Ссылка.СтруктурнаяЕдиница
	|		ИНАЧЕ ЧекККМЗапасы.СтруктурнаяЕдиница
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеСклада = ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВШапке)
	|			ТОГДА ЧекККМЗапасы.Ссылка.Ячейка
	|		ИНАЧЕ ЧекККМЗапасы.Ячейка
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеОтветственный В (ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВШапке),
	|			ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ПустаяСсылка))
	|			ТОГДА ЧекККМЗапасы.Ссылка.Ответственный
	|		ИНАЧЕ ЧекККМЗапасы.Ответственный
	|	КОНЕЦ,
	|	ЧекККМЗапасы.Заказ,
	|	ЧекККМЗапасы.НоменклатураНабора,
	|	ЧекККМЗапасы.ХарактеристикаНабора,
	|	ЧекККМЗапасы.Ссылка.Контрагент,
	|	ЧекККМЗапасы.Ссылка.ДисконтнаяКарта,
	|	ЧекККМЗапасы.Ссылка.ВидСкидкиНаценки,
	|	ВЫБОР
	|		КОГДА ЧекККМЗапасы.Ссылка.ПоложениеПатента = ЗНАЧЕНИЕ(Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти)
	|			ТОГДА ЧекККМЗапасы.Патент
	|		ИНАЧЕ ЧекККМЗапасы.Ссылка.Патент
	|	КОНЕЦ,
	|	ЧекККМЗапасы.ДоговорПлатежногоАгента,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СистемыНалогообложенияОрганизаций.ПлательщикУСН, ЛОЖЬ)
	|			И ЧекККМЗапасы.Ссылка.СпециальныйНалоговыйРежим = ЗНАЧЕНИЕ(Перечисление.СпециальныеНалоговыеРежимы.НеПрименяется)
	|			И ЕСТЬNULL(ЧекККМЗапасы.Партия.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыПартий.СобственныеЗапасы)) <> ЗНАЧЕНИЕ(Перечисление.СтатусыПартий.ТоварыНаКомиссии)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("КассоваяСмена", ОтчетОРозничныхПродажахОбъект.Ссылка);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	ТаблицаБонусов = Запрос.Выполнить().Выгрузить();
	Если ТаблицаБонусов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КлючиПоиска = "Номенклатура, Характеристика, Партия, ЕдиницаИзмерения, Цена, СтавкаНДС, СтруктурнаяЕдиница, Ячейка, Ответственный, Заказ, НоменклатураНабора, ХарактеристикаНабора, ДокументПродажи, Контрагент, ДисконтнаяКарта, ВидСкидкиНаценки, Патент, ДоговорПлатежногоАгента, ВозвратБезОснования, ПричинаВозврата, УчитыватьВНУ";
	
	Для Каждого СтрокаБонусов Из ТаблицаБонусов Цикл
		
		СтруктураПоиска = Новый Структура(КлючиПоиска);
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаБонусов);
		
		НайденныеСтроки = ОтчетОРозничныхПродажахОбъект.Запасы.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаЗапасы Из НайденныеСтроки Цикл
			СтрокаЗапасы.эв_ИБ = СтрокаБонусов.эв_ИБ;
			СтрокаЗапасы.эв_КБ = СтрокаБонусов.эв_КБ;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&После("СформироватьТаблицаПродажи")
Процедура эв_СформироватьТаблицаПродажи(ДокументСсылкаОтчетОРозничныхПродажах, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПродажи.Дата КАК Период,
	|	ТаблицаПродажи.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаПродажи.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|			ТОГДА ТаблицаПродажи.СтруктурнаяЕдиница
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|	КОНЕЦ КАК Склад,
	|	ТаблицаПродажи.Номенклатура КАК Номенклатура,
	|	ТаблицаПродажи.Характеристика КАК Характеристика,
	|	ТаблицаПродажи.НоменклатураНабора КАК НоменклатураНабора,
	|	ТаблицаПродажи.ХарактеристикаНабора КАК ХарактеристикаНабора,
	|	ТаблицаПродажи.Партия КАК Партия,
	|	ТаблицаПродажи.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ВЫБОР
	|		КОГДА ТаблицаПродажи.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА ТаблицаПродажи.КассаККМ.Проект
	|		ИНАЧЕ ТаблицаПродажи.ЗаказПокупателя.Проект
	|	КОНЕЦ КАК Проект,
	|	ТаблицаПродажи.Документ КАК Документ,
	|	ТаблицаПродажи.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаПродажи.Подразделение КАК Подразделение,
	|	ТаблицаПродажи.Ответственный КАК Ответственный,
	|	ТаблицаПродажи.Контрагент КАК Контрагент,
	|	СУММА(ТаблицаПродажи.Количество) КАК Количество,
	|	СУММА(ТаблицаПродажи.СуммаНДСЗакупкиПродажи) КАК СуммаНДС,
	|	СУММА(ТаблицаПродажи.Сумма) КАК Сумма,
	|	СУММА(ТаблицаПродажи.Сумма + ТаблицаПродажи.СуммаСкидкиНаценки + ТаблицаПродажи.СуммаАвтоматическойСкидки +
	|		ТаблицаПродажи.СуммаСкидкиОплатыБонусом) КАК СуммаБезСкидки,
	|	0 КАК СебестоимостьБезНДС,
	|	0 КАК Себестоимость,
	|	СУММА(ТаблицаПродажи.эв_ИБ) КАК эв_ИБ,
	|	СУММА(ТаблицаПродажи.эв_КБ) КАК эв_КБ
	|ИЗ
	|	ВременнаяТаблицаЗапасы КАК ТаблицаПродажи
	|ГДЕ
	|	&ПолноеПроведение
	|	И НЕ ТаблицаПродажи.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПродажи.Дата,
	|	ТаблицаПродажи.Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаПродажи.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|			ТОГДА ТаблицаПродажи.СтруктурнаяЕдиница
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|	КОНЕЦ,
	|	ТаблицаПродажи.Номенклатура,
	|	ТаблицаПродажи.Характеристика,
	|	ТаблицаПродажи.НоменклатураНабора,
	|	ТаблицаПродажи.ХарактеристикаНабора,
	|	ТаблицаПродажи.Партия,
	|	ТаблицаПродажи.ЗаказПокупателя,
	|	ВЫБОР
	|		КОГДА ТаблицаПродажи.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА ТаблицаПродажи.КассаККМ.Проект
	|		ИНАЧЕ ТаблицаПродажи.ЗаказПокупателя.Проект
	|	КОНЕЦ,
	|	ТаблицаПродажи.Документ,
	|	ТаблицаПродажи.СтавкаНДС,
	|	ТаблицаПродажи.Подразделение,
	|	ТаблицаПродажи.Ответственный,
	|	ТаблицаПродажи.Контрагент
	|ИМЕЮЩИЕ
	|	(СУММА(ТаблицаПродажи.Количество) <> 0
	|	ИЛИ СУММА(ТаблицаПродажи.СуммаНДСЗакупкиПродажи) <> 0
	|	ИЛИ СУММА(ТаблицаПродажи.Сумма) <> 0
	|	ИЛИ СУММА(ТаблицаПродажи.эв_ИБ) <> 0
	|	ИЛИ СУММА(ТаблицаПродажи.эв_КБ) <> 0)";
	
	Запрос.УстановитьПараметр("ПолноеПроведение", СтруктураДополнительныеСвойства.ДляПроведения.ПолноеПроведение);
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаПродажи", Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&После("ИнициализироватьДанныеДокумента")
Процедура эв_ИнициализироватьДанныеДокумента(ДокументСсылкаОтчетОРозничныхПродажах, СтруктураДополнительныеСвойства)
	
	Если СтруктураДополнительныеСвойства.Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаПродажи") Тогда
		СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить(
			"Таблицаэв_КошелекПервостольника",
			Новый ТаблицаЗначений);
		Возврат;
	КонецЕсли;
	
	эв_СформироватьТаблицаКошелекПервостольника(ДокументСсылкаОтчетОРозничныхПродажах, СтруктураДополнительныеСвойства);
	
КонецПроцедуры

Процедура эв_СформироватьТаблицаКошелекПервостольника(ДокументСсылкаОтчетОРозничныхПродажах, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаЗапасы.Дата КАК Период,
	|	ТаблицаЗапасы.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ТаблицаЗапасы.Ответственный КАК Ответственный,
	|	СУММА(ТаблицаЗапасы.эв_ИБ) КАК эв_ИБ,
	|	СУММА(ТаблицаЗапасы.эв_КБ) КАК эв_КБ
	|ИЗ
	|	ВременнаяТаблицаЗапасы КАК ТаблицаЗапасы
	|ГДЕ
	|	&ПолноеПроведение
	|	И (ТаблицаЗапасы.эв_ИБ <> 0
	|		ИЛИ ТаблицаЗапасы.эв_КБ <> 0)
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЗапасы.Дата,
	|	ТаблицаЗапасы.СтруктурнаяЕдиница,
	|	ТаблицаЗапасы.Ответственный";
	
	Запрос.УстановитьПараметр("ПолноеПроведение", СтруктураДополнительныеСвойства.ДляПроведения.ПолноеПроведение);
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить(
		"Таблицаэв_КошелекПервостольника",
		Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

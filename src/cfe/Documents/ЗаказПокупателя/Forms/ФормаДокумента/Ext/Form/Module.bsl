
&Вместо ("ЗапасыХарактеристикаПриИзменении")
&НаКлиенте
Процедура эв_ЗапасыХарактеристикаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда Возврат КонецЕсли;
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Организация", Компания);
	СтруктураДанные.Вставить("Номенклатура", 	СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("Характеристика", 	СтрокаТабличнойЧасти.Характеристика);
	СтруктураДанные.Вставить("НалогообложениеНДС", Объект.НалогообложениеНДС);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу") Тогда
		СтруктураДанные.Вставить("ВключаяШаблоны", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВидЦен) Тогда  
		
		СтруктураДанные.Вставить("ДатаОбработки", 		Объект.Дата);
		СтруктураДанные.Вставить("ВалютаДокумента", 	Объект.ВалютаДокумента);
		СтруктураДанные.Вставить("СуммаВключаетНДС",	Объект.СуммаВключаетНДС);
		
		СтруктураДанные.Вставить("СтавкаНДС", 	СтрокаТабличнойЧасти.СтавкаНДС);
		СтруктураДанные.Вставить("Цена", 		СтрокаТабличнойЧасти.Цена);
		
		СтруктураДанные.Вставить("ВидЦен", Объект.ВидЦен);
		СтруктураДанные.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧасти.ЕдиницаИзмерения);
		
	КонецЕсли;

	РезервированиеЗапасов = ?(КэшЗначений.Свойство("РезервированиеЗапасов"), КэшЗначений.РезервированиеЗапасов, Ложь);	
	ЦенообразованиеКлиентСервер.ДополнитьСтруктуруДанныхНоменклатурыПолямиЦенообразования(Объект, СтрокаТабличнойЧасти, СтруктураДанные, , НЕ РезервированиеЗапасов);	
	
	СтруктураДанные = ПолучитьДанныеХарактеристикаПриИзменении(СтруктураДанные);
	
	Если СтруктураДанные.ЭтоНабор Тогда
		
		// Наборы
		ЗаменитьСтрокуЗапасовДаннымиНабора(ЭтотОбъект, СтрокаТабличнойЧасти, СтруктураДанные);
		
		ЗаполнитьПризнакиИспользованияХарактеристик();
		
		// АвтоматическиеСкидки.
		СброситьФлагСкидкиРассчитаныКлиент("РассчитатьСуммуВСтрокеТабличнойЧасти", "Сумма");
		// Конец АвтоматическиеСкидки
		
		Если РежимОстаткиИРезервы Тогда
			ЗаполнитьЗначенияРезервовИОстатокНоменклатурыВТабличнойЧастиНаСервере();
		КонецЕсли;
		
	Иначе
		Если НЕ Объект.ВидЗаказа = ПредопределенноеЗначение("Справочник.ВидыЗаказовПокупателей.Основной") Тогда 
			//##По интернет заказам цены не пересчитываем
			СтрокаТабличнойЧасти.Цена = СтруктураДанные.Цена;
		КонецЕсли;

		Если СтруктураДанные.Свойство("МинимальнаяЦена") 
			И СтрокаТабличнойЧасти.Свойство("МинимальнаяЦена") Тогда
			СтрокаТабличнойЧасти.МинимальнаяЦена = СтруктураДанные.МинимальнаяЦена;			
		КонецЕсли;
		СтрокаТабличнойЧасти.Содержание = "";
		СтрокаТабличнойЧасти.Спецификация = СтруктураДанные.Спецификация;
		СтрокаТабличнойЧасти.ЭтоШаблонСпецификации = СтруктураДанные.ЭтоШаблонСпецификации;
		СтрокаТабличнойЧасти.ЕстьДопРеквизитыСпецификации = СтруктураДанные.ЕстьДопРеквизитыСпецификации;
		Если СтрокаТабличнойЧасти.ЕстьДопРеквизитыСпецификации Тогда
			Если СтрокаТабличнойЧасти.КлючСвязи<>0 Тогда
				ТабличныеЧастиУНФКлиентСервер.УдалитьСтрокиПоКлючуСвязи(Объект.РеквизитыПараметрическихСпецификаций, СтрокаТабличнойЧасти);
			КонецЕсли; 
			ЗаполнитьДопРеквизитыПоУмолчанию(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
			ОбновитьОписанияДопРеквизитов(ЭтотОбъект, СтрокаТабличнойЧасти.КлючСвязи);
		КонецЕсли; 
		
		РассчитатьСуммуВСтрокеТабличнойЧасти();
		
		Если РежимОстаткиИРезервы Тогда
			ЗаполнитьЗначенияРезервовИОстатокНоменклатурыВТабличнойЧастиНаСервере(,СтрокаТабличнойЧасти.Номенклатура);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьИтогиКлиент();
	ОчиститьКалькуляцию();
	ВключитьИндикаторНеобходимостиПересчетаСтоимостиДоставки();
	
	ОбновитьВидимостьКолонкиПараметровСпецификации(ЭтотОбъект);
	
	// СборкаЗаказов
	Если ФОСборкаЗаказов Тогда
		СтрокаТабличнойЧасти.КоличествоСобрано = 0;
		СборкаЗаказовКлиент.РассчитатьРасхождения(ЭтаФорма, СтрокаТабличнойЧасти);
	КонецЕсли;
	// Конец СборкаЗаказов
	
КонецПроцедуры

&Вместо ("РассчитатьСкидкиНаценки")
&НаКлиенте
Процедура эв_РассчитатьСкидкиНаценки(Команда)
	
	Если Объект.Запасы.Количество() = 0      //## Отключим скидки для интернет заказов
		ИЛИ Объект.ВидЗаказа = ПредопределенноеЗначение("Справочник.ВидыЗаказовПокупателей.Основной") Тогда
		Если Объект.СкидкиНаценки.Количество() > 0 Тогда
			Объект.СкидкиНаценки.Очистить();
		КонецЕсли; 
		Возврат;
	КонецЕсли;
	
	РассчитатьСкидкиНаценкиКлиент();
	
КонецПроцедуры

&После("УстановитьВидимостьЭлементовПоНастройкеПользователя")
&НаКлиентеНаСервереБезКонтекста
Процедура эв_УстановитьВидимостьКолонкиСодержание(Форма)
    
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
        Форма.Элементы, "ЗапасыСодержание", "Видимость", Истина);
    
КонецПроцедуры

&НаКлиенте
Процедура эв_ПоказатьИсходныйПакет(Команда)
	
	ТекстПакета = эв_ТекстИсходногоПакета();
	Если Не ЗначениеЗаполнено(ТекстПакета) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Исходный пакет не найден.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Текст", ТекстПакета);
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Исходный пакет'"));
	
	ФормаТекста = ОткрытьФорму("ОбщаяФорма.РедактированиеТекста", ПараметрыФормы, ЭтотОбъект);
	Если ФормаТекста <> Неопределено Тогда
		ФормаТекста.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция эв_ТекстИсходногоПакета()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказыСайта.эв_ИсходныйПакет КАК ИсходныйПакет
	|ИЗ
	|	РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыСайта
	|ГДЕ
	|	ЗаказыСайта.ЗаказПокупателя = &ЗаказПокупателя";
	Запрос.УстановитьПараметр("ЗаказПокупателя", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.ИсходныйПакет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстПакета = Выборка.ИсходныйПакет.Получить();
	Если ТипЗнч(ТекстПакета) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ТекстПакета;
	
КонецФункции


&Перед("ПередЗаписью")
&НаКлиенте
Процедура эв_ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Отказ Или ПараметрыЗаписи.Свойство("эв_ПроверкаСборкиВыполнена") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ФОСборкаЗаказов Или Не эв_ЭтоЗаказМегааптекиЮтеки(Объект.ВидЗаказа) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ эв_ТребуетсяПроверкаПодтверждения(Объект.ВидЗаказа, Объект.СостояниеЗаказа, эв_ИсточникЗаказа) Тогда
		Возврат;
	КонецЕсли;
	
	СостояниеСборкиЗаказа = эв_СборкаЗаказаНеполная();
	
	Оповещение = Новый ОписаниеОповещения("эв_ПередЗаписьюПослеВопросаОСборке", ЭтотОбъект, ПараметрыЗаписи);
	Если СостояниеСборкиЗаказа = "Заказ не собран" Тогда

	Отказ = Истина;
	
	ПоказатьВопрос(
		Оповещение,
		НСтр("ru = 'Сборка заказа не выполнялась. Заказ будет отменен. Продолжить?'"),
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Да); 

	ИначеЕсли СостояниеСборкиЗаказа = "Собран частично" Тогда	
	
	Отказ = Истина;

	ПоказатьВопрос(
		Оповещение,
		НСтр("ru = 'Сборка заказа неполная. Установить состояние заказа ""Ожидает подтверждения""?'"),
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Да); 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура эв_ПередЗаписьюПослеВопросаОСборке(Результат, ПараметрыЗаписи) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ДанныеОжиданияПодтверждения = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(эв_ИсточникЗаказа, "7");
		
		Если Не ЗначениеЗаполнено(ДанныеОжиданияПодтверждения.ВидСтатуса) Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Не найдено состояние заказа ""Ожидает подтверждения"".'"));
			Возврат;
		КонецЕсли;
		
		Объект.СостояниеЗаказа = ДанныеОжиданияПодтверждения.ВидСтатуса;
		ОбработатьИзменениеСостоянияЗаказа();
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаписи.Вставить("эв_ПроверкаСборкиВыполнена", Истина);
	Записать(ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Функция эв_СборкаЗаказаНеполная()
	
	ИтогоСобрано    = Объект.Запасы.Итог("КоличествоСобрано");
	ИтогоКоличество = Объект.Запасы.Итог("Количество");
	
	Если ИтогоСобрано = 0 Тогда
	    Инфо = "Заказ не собран";
	ИначеЕсли ИтогоСобрано <> ИтогоКоличество Тогда
		Инфо = "Собран частично";
	Иначе
		Инфо = "";
	КонецЕсли; 
	
	Возврат Инфо;
	
КонецФункции

&НаСервереБезКонтекста
Функция эв_ТребуетсяПроверкаПодтверждения(ВидЗаказа, СостояниеЗаказа, эв_ИсточникЗаказа)
	
	Если Не ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
		// Не требуется, это закрытие 
		Возврат Ложь;
	КонецЕсли;
	
	эв_ИсточникЗаказа = эв_ОбменСПорталамиСервер.ИсточникЗаказовПоВидуЗаказа(ВидЗаказа);
	Если Не ЗначениеЗаполнено(эв_ИсточникЗаказа) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДанныеОжиданияПодтверждения = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(эв_ИсточникЗаказа, "7");

	Если НЕ ЗначениеЗаполнено(ДанныеОжиданияПодтверждения.ВидСтатуса) ИЛИ СостояниеЗаказа = ДанныеОжиданияПодтверждения.ВидСтатуса Тогда
		// Не требуется, указан нужный статус (7)
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МИНИМУМ(ПорядокТекущего.НомерСтроки) КАК ИндексТекущего,
	|	МИНИМУМ(ПорядокОжидания.НомерСтроки) КАК ИндексОжидания
	|ИЗ
	|	Справочник.ВидыЗаказовПокупателей КАК ВидыЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ПорядокТекущего
	|		ПО ВидыЗаказов.Ссылка = ПорядокТекущего.Ссылка
	|			И ПорядокТекущего.Состояние = &ТекущееСостояние
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ПорядокОжидания
	|		ПО ВидыЗаказов.Ссылка = ПорядокОжидания.Ссылка
	|			И ПорядокОжидания.Состояние = &СостояниеОжидаетПодтверждения
	|ГДЕ
	|	ВидыЗаказов.Ссылка = &ВидЗаказа";
	Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказа);
	Запрос.УстановитьПараметр("ТекущееСостояние", СостояниеЗаказа);
	Запрос.УстановитьПараметр("СостояниеОжидаетПодтверждения", ДанныеОжиданияПодтверждения.ВидСтатуса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Выборка.ИндексТекущего)
		И ЗначениеЗаполнено(Выборка.ИндексОжидания)
		И Выборка.ИндексТекущего >= Выборка.ИндексОжидания;
	
КонецФункции

&НаСервереБезКонтекста
Функция эв_ЭтоЗаказМегааптекиЮтеки(ВидЗаказа)
	
	Если Не ЗначениеЗаполнено(ВидЗаказа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Портал = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЗаказа, "Портал");
	Возврат Портал = Перечисления.эв_ВидыИсточниковЗаказа.МегаАптека
		ИЛИ Портал = Перечисления.эв_ВидыИсточниковЗаказа.Ютека;
	
КонецФункции



&Перед ("ОбработкаПроведения")
Процедура _ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьПоследовательностьСостоянияЗаказа(Отказ);
	
КонецПроцедуры

&После ("ОбработкаПроведения")
Процедура _ОбработкаПроведенияПосле(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидЗаказа = Справочники.ВидыЗаказовПокупателей.Основной Тогда
		Возврат;
	КонецЕсли;
	
	ИсточникЗаказов = эв_ОбменСПорталамиСервер.ИсточникЗаказовПоВидуЗаказа(ВидЗаказа);
	Если Не ЗначениеЗаполнено(ИсточникЗаказов) Тогда
		Возврат;
	КонецЕсли;
	
	эв_ОбменСПорталамиСервер.ПоставитьЗаказВОчередьСтатусов(Ссылка, ИсточникЗаказов, СостояниеЗаказа);
	
	//Статус в очереди может быть Комплектуется, а задаем в заказе Готов к выдаче. Очищаем не актуальную очередь.
	эв_ОбменСПорталамиСервер.УдалитьЗаписьОчередиУстановкиСтатуса(Ссылка);
	
КонецПроцедуры

Процедура ПроверитьПоследовательностьСостоянияЗаказа(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидЗаказа) Или Не ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийСтатус = эв_ОбменСПорталамиСервер.ТекущийСтатусЗаказа(Ссылка);
	Если Не ЗначениеЗаполнено(ТекущийСтатус) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	&ТекущийСтатус КАК ТекущийСтатус,
		|	ПорядокТекущего.НомерСтроки КАК ИндексТекущего,
		|	ПорядокНового.НомерСтроки КАК ИндексНового
		|ИЗ
		|	Справочник.ВидыЗаказовПокупателей КАК ВидыЗаказов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ПорядокТекущего
		|		ПО ВидыЗаказов.Ссылка = ПорядокТекущего.Ссылка
		|			И ПорядокТекущего.Состояние = &ТекущийСтатус
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ПорядокНового
		|		ПО ВидыЗаказов.Ссылка = ПорядокНового.Ссылка
		|			И ПорядокНового.Состояние = &НовоеСостояние
		|ГДЕ
		|	ВидыЗаказов.Ссылка = &ВидЗаказа";
	Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказа);
	Запрос.УстановитьПараметр("ТекущийСтатус", ТекущийСтатус);
	Запрос.УстановитьПараметр("НовоеСостояние", СостояниеЗаказа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Если эв_ОбменСПорталамиСервер.ПереходКСтатусуВыполненЗапрещен(Ссылка, СостояниеЗаказа) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Нельзя установить состояние ""%1"": заказ в статусе ""%2"".'"),
			СостояниеЗаказа,
			Выборка.ТекущийСтатус);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "СостояниеЗаказа", , Отказ);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.ИндексТекущего) Или Не ЗначениеЗаполнено(Выборка.ИндексНового) Тогда
		Возврат;
	КонецЕсли;
	
	Если Выборка.ИндексНового < Выборка.ИндексТекущего Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Нельзя установить состояние ""%1"": текущее состояние заказа ""%2"" идет позже в порядке состояний вида заказа.'"),
			СостояниеЗаказа,
			Выборка.ТекущийСтатус);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "СостояниеЗаказа", , Отказ);
	КонецЕсли;
	
КонецПроцедуры


&После("ПередЗаписью")
Процедура _ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Или ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВариантЗавершенияОтменен();
	
КонецПроцедуры

Процедура УстановитьВариантЗавершенияОтменен()
	
	Если Не ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(НРег(Строка(СостояниеЗаказа)), "отменен") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен;
	
КонецПроцедуры


	


&После("ОбработкаПроведения")
Процедура эв_ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Отказ Или Не эв_ЭтоПоступлениеРазмена() Тогда
		Возврат;
	КонецЕсли;
	
	эв_ЗакрытьДенежныеСредстваКПоступлению();
	
КонецПроцедуры

Функция эв_ЭтоПоступлениеРазмена()
	
	Если ВидОперации <> Перечисления.ВидыОперацийПоступлениеВКассу.Прочее Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ВыемкаНаличных") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Не ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДокументОснование, "ОтчетОРозничныхПродажах"));
	
КонецФункции

Процедура эв_ЗакрытьДенежныеСредстваКПоступлению()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Выемка", ДокументОснование);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Организация КАК Организация,
	|	Движения.Касса КАК Касса,
	|	Движения.ДокументПередачи КАК ДокументПередачи,
	|	Движения.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Движения.КассаОтправитель КАК КассаОтправитель,
	|	Движения.Сумма КАК Сумма,
	|	Движения.СуммаВал КАК СуммаВал
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваКПоступлению КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Выемка
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
	
	Набор = Движения.ДенежныеСредстваКПоступлению;
	Набор.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Движение = Набор.ДобавитьРасход();
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		Движение.Период = Дата;
	КонецЦикла;
	
	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Набор.Записывать = Истина;
	Набор.Записать();
	Набор.Записывать = Ложь;
	
КонецПроцедуры

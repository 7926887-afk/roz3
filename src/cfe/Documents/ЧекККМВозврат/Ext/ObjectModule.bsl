
&После("ЗаполнитьПоЧекуККМ")
Процедура эв_ЗаполнитьПоЧекуККМ(ДанныеЗаполнения)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыЧека = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДанныеЗаполнения, "РасчетВИнтернете, АдресСайта, ЧасоваяЗона");
	РасчетВИнтернете = РеквизитыЧека.РасчетВИнтернете;
	АдресСайта = РеквизитыЧека.АдресСайта;
	ЧасоваяЗона = РеквизитыЧека.ЧасоваяЗона;
	
КонецПроцедуры

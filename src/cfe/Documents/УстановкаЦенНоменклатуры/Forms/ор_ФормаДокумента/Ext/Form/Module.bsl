
&Перед("ДобавитьНоменклатуру")
&НаСервере
Процедура эв_ДобавитьНоменклатуру(СтруктураТаблицДанных, ДополнительныеПараметры)
	
	эв_СоздатьНедостающиеКолонкиЦен("ТЧНоменклатура");
	Если эв_ЕстьСтрокиХарактеристик(СтруктураТаблицДанных) Тогда
		Объект.ПоказыватьХарактеристики = Истина;
		эв_СоздатьНедостающиеКолонкиЦен("ТЧХарактеристики");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция эв_ЕстьСтрокиХарактеристик(СтруктураТаблицДанных)
	
	Если ТипЗнч(СтруктураТаблицДанных) <> Тип("Структура")
		Или Не СтруктураТаблицДанных.Свойство("ТаблицаХарактеристик") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтруктураТаблицДанных.ТаблицаХарактеристик.Количество() > 0;
	
КонецФункции

&НаСервере
Процедура эв_СоздатьНедостающиеКолонкиЦен(ИмяТабличнойЧасти)
	
	Если Не КэшЗначений.Свойство("ВыбранныеВидыЦен")
		Или КэшЗначений.ВыбранныеВидыЦен.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КэшЗначений.Свойство("НовыеВидыЦен") И КэшЗначений.Свойство("ОтключенныеВидыЦен") Тогда
		ИзменитьСоставРеквизитовИЭлементовТабличнойЧасти(ИмяТабличнойЧасти);
	КонецЕсли;
	
	ТаблицаФормы = РеквизитФормыВЗначение(ИмяТабличнойЧасти);
	Идентификаторы = Новый Массив;
	эв_СобратьИдентификаторыБезКолонки(КэшЗначений.ВыбранныеВидыЦен, ИмяТабличнойЧасти, ТаблицаФормы, Идентификаторы);
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипЧислоПлюс = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	ТипЧислоЛюбое = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипВалюта = Новый ОписаниеТипов("СправочникСсылка.Валюты");
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.ЕдиницыИзмерения"));
	МассивТипов.Добавить(Тип("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТипЕдИзмерения = Новый ОписаниеТипов(МассивТипов);
	
	Суффиксы = Новый Структура;
	Суффиксы.Вставить("_ЦенаДо", ТипЧислоПлюс);
	Суффиксы.Вставить("_ЦенаНовая", ТипЧислоПлюс);
	Суффиксы.Вставить("_ВалютаДо", ТипВалюта);
	Суффиксы.Вставить("_ВалютаНовая", ТипВалюта);
	Суффиксы.Вставить("_ПроцентИзменения", ТипЧислоЛюбое);
	Суффиксы.Вставить("_Дельта", ТипЧислоЛюбое);
	Суффиксы.Вставить("_ЕдИзм", ТипЕдИзмерения);
	Суффиксы.Вставить("_ЦенуИзменили", ТипБулево);
	Суффиксы.Вставить("_ВалютаВидимость", ТипБулево);
	Суффиксы.Вставить("_ВалютаДельта", ТипВалюта);
	Суффиксы.Вставить("_ДельтаКартинка", ТипЧислоЛюбое);
	Суффиксы.Вставить("_ПроцентНаценки", ТипЧислоЛюбое);
	
	МассивРеквизитов = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Для Каждого Суффикс Из Суффиксы Цикл
			ИмяРеквизита = ИмяТабличнойЧасти + Идентификатор + Суффикс.Ключ;
			Если ТаблицаФормы.Колонки.Найти(ИмяРеквизита) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизита, Суффикс.Значение, ИмяТабличнойЧасти));
		КонецЦикла;
	КонецЦикла;
	
	Если МассивРеквизитов.Количество() > 0 Тогда
		ИзменитьРеквизиты(МассивРеквизитов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура эв_СобратьИдентификаторыБезКолонки(ВидыЦен, ИмяТабличнойЧасти, ТаблицаФормы, Идентификаторы)
	
	Если ТипЗнч(ВидыЦен) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементВидаЦен Из ВидыЦен Цикл
		Идентификатор = ЭлементВидаЦен.Ключ.ИдентификаторФормул;
		ИмяКолонки = ИмяТабличнойЧасти + Идентификатор + "_ЦенаДо";
		Если ЗначениеЗаполнено(Идентификатор)
			И ТаблицаФормы.Колонки.Найти(ИмяКолонки) = Неопределено
			И Идентификаторы.Найти(Идентификатор) = Неопределено Тогда
			Идентификаторы.Добавить(Идентификатор);
		КонецЕсли;
		эв_СобратьИдентификаторыБезКолонки(ЭлементВидаЦен.Значение, ИмяТабличнойЧасти, ТаблицаФормы, Идентификаторы);
	КонецЦикла;
	
КонецПроцедуры

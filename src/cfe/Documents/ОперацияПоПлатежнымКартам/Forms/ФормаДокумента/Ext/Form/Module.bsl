
&Вместо("НапечататьЧек")
&НаКлиенте
Процедура эв_НапечататьЧек(Команда)
	
	Если Не эв_ЭтоВозвратАвансаБезОборудования() Тогда
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;
	
	ТекстЗапрета = эв_ТекстЗапретаВозвратаПослеОтгрузки();
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстЗапрета);
		Возврат;
	КонецЕсли;
	
	Если Объект.ВалютаДенежныхСредств <> УправлениеНебольшойФирмойПовтИсп.ПолучитьНациональнуюВалюту() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Валюта оплаты отличается от национальной.'"));
		Возврат;
	КонецЕсли;
	
	Если ВТабличнойЧастиЕстьКомиссионнаяПартияБезВладельца() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'В табличной части есть документы с комиссионными партиями в которых не указан владелец. Печать чека невозможна.'"));
		Возврат;
	КонецЕсли;
	
	Если СокрЛП(Объект.ВидПлатежнойКарты) = "" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Перед печатью чека необходимо принять оплату по карте.'"));
		Возврат;
	КонецЕсли;
	
	Если ПечатьДокументовУНФКлиент.ПечатьЧекаНевозможна(ЭтотОбъект, НСтр("ru = 'Не удалось провести документ'")) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = эв_ПоставитьВозвратАвансаВОчередьНаСервере();
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция эв_ЭтоВозвратАвансаБезОборудования()
	
	Если КассаККМИспользоватьБезПодключенияОборудования <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(КассаВЭТ) = Тип("СправочникСсылка.Кассы") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийЭквайринга.ВозвратОплатыПокупателю") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ТипЗнч(Объект.ОперацияПоПлатежнымКартамШапка) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам")
		И ЗначениеЗаполнено(Объект.ОперацияПоПлатежнымКартамШапка);
	
КонецФункции

&НаСервере
Функция эв_ТекстЗапретаВозвратаПослеОтгрузки()
	
	Возврат эв_РаспределеннаяФискализация.эв_ТекстЗапретаВозвратаПослеОтгрузки(РеквизитФормыВЗначение("Объект"));
	
КонецФункции

&НаСервере
Функция эв_ПоставитьВозвратАвансаВОчередьНаСервере()
	
	Возврат эв_РаспределеннаяФискализация.эв_ПоставитьВозвратАвансаБезОборудованияВОчередь(Объект.Ссылка);
	
КонецФункции

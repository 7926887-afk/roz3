
&После("ОбработкаПроведения")
Процедура эв_ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Статус <> Перечисления.СтатусыЧековККМ.Пробит Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказыПокупателей = ЗаказыПокупателейЧека();
	Если ЗаказыПокупателей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоставитьЗаказыВОчередьИОбработать(ЗаказыПокупателей);
	
КонецПроцедуры

Процедура ПоставитьЗаказыВОчередьИОбработать(ЗаказыПокупателей)
	
	НачатьТранзакцию();
	Попытка
		эв_ОбменСПорталамиСервер.ПоставитьЗаказыВОчередьУстановкиСтатусаВыполнен(ЗаказыПокупателей);
		эв_ОбменСПорталамиСервер.ВыполнитьОбработкуОчередиУстановкиСтатусов();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			"ЧекККМ.УстановкаСтатусаЗаказа",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ЗаказыПокупателейЧека()
	
	Заказы = Новый Массив;
	
	Если ЗначениеЗаполнено(Заказ) Тогда
		Заказы.Добавить(Заказ);
	КонецЕсли;
	
	Для Каждого СтрокаЗапасов Из Запасы Цикл
		Если ЗначениеЗаполнено(СтрокаЗапасов.Заказ)
			И Заказы.Найти(СтрокаЗапасов.Заказ) = Неопределено Тогда
			Заказы.Добавить(СтрокаЗапасов.Заказ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Заказы;
	
КонецФункции

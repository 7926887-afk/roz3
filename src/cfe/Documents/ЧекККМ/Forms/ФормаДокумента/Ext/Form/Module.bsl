

&После("ПриСозданииНаСервере")
&НаСервере
Процедура эв_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Предоплата.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаПредоплата", "Видимость", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаЗачтенаПредоплата", "Видимость", Истина);
	
КонецПроцедуры

&После("ПослеЗаписи")
&НаКлиенте
Процедура эв_ПослеЗаписи(ПараметрыЗаписи)
	
	Если Не КассаККМИспользоватьБезПодключенияОборудования Тогда
		Возврат;
	КонецЕсли;
	
	эв_ПоставитьЧекБезОборудованияВОчередьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура эв_ПоставитьЧекБезОборудованияВОчередьНаСервере()
	
	эв_РаспределеннаяФискализация.эв_ПоставитьЧекБезОборудованияВОчередь(РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

&Вместо("ОбработатьНеобходимоПроверитьКММДЛПНаККТ")
&НаКлиенте
Процедура эв_ОбработатьНеобходимоПроверитьКММДЛПНаККТ(ДанныеШтрихкода, ТекШтрихкод, ДопПараметры)
	
	Если Не КассаККМИспользоватьБезПодключенияОборудования Тогда
		ПродолжитьВызов(ДанныеШтрихкода, ТекШтрихкод, ДопПараметры);
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = эв_ПроверитьКодМаркировкиВнешнимСервисом(эв_КодМаркировкиМДЛП(ТекШтрихкод));
	Если Не эв_ПроверкаКодаМаркировкиПройдена(РезультатПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекШтрихкод.Свойство("ДанныеМаркировкиМДЛП") Тогда
		эв_ЗаполнитьРеквизитыРазрешительногоРежима(ТекШтрихкод.ДанныеМаркировкиМДЛП, РезультатПроверки);
	КонецЕсли;
	ТекШтрихкод.Вставить("ПроверкаКММДЛПВыполнялась");
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(ДанныеШтрихкода);
	ЗаполнитьПоДаннымШтрихкодовЗавершение(
		Новый Структура("МассивНоменклатуры, ТекШтрихкод", МассивСтрок, ТекШтрихкод),
		ДопПараметры);
	эв_ЗафиксироватьРезультатВНомерахУпаковок(ТекШтрихкод, РезультатПроверки);
	
КонецПроцедуры

&Вместо("Подключаемый_ОткрытьФормуУточненияДанных")
&НаКлиенте
Процедура эв_Подключаемый_ОткрытьФормуУточненияДанных()
	
	ИмяРеквизитаКодМаркировки = "КодМаркировкиДляУточнения";
	КодДляУточнения = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаКодМаркировки) Тогда
		КодДляУточнения = ЭтотОбъект[ИмяРеквизитаКодМаркировки];
	КонецЕсли;
	Если Не КассаККМИспользоватьБезПодключенияОборудования
		Или Не эв_ОжидаетсяПроверкаКодаМаркировки(КодДляУточнения) Тогда
		ПродолжитьВызов();
		Возврат;
	КонецЕсли;
	
	РезультатОбработки = КодДляУточнения.РезультатОбработкиШтрихкода;
	РезультатПроверки = эв_ПроверитьКодМаркировкиВнешнимСервисом(эв_КодМаркировкиИСМП(РезультатОбработки.ДанныеШтрихкода));
	Если Не эв_ПроверкаКодаМаркировкиПройдена(РезультатПроверки) Тогда
		ЭтотОбъект[ИмяРеквизитаКодМаркировки] = Неопределено;
		Возврат;
	КонецЕсли;
	
	эв_ЗаполнитьРеквизитыРазрешительногоРежима(РезультатОбработки.ДанныеШтрихкода, РезультатПроверки);
	эв_ОтметитьПроверкуКодаМаркировкиЗавершенной(РезультатОбработки);
	ПродолжитьВызов();
	эв_ЗафиксироватьРезультатВАкцизныхМарках(РезультатОбработки.ДанныеШтрихкода, РезультатПроверки);
	
КонецПроцедуры

&НаКлиенте
Функция эв_ПроверитьКодМаркировкиВнешнимСервисом(КодМаркировки)
	
	Состояние(НСтр("ru = 'Проверка кода маркировки...'"));
	Возврат эв_РаспределеннаяФискализация.эв_ПроверитьКодМаркировкиТСПИоТ(Объект.КассаККМ, КодМаркировки);
	
КонецФункции

&НаКлиенте
Функция эв_ПроверкаКодаМаркировкиПройдена(РезультатПроверки)
	
	Если РезультатПроверки.Успех И РезультатПроверки.РазрешенаПродажа Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстОшибки = РезультатПроверки.ТекстОшибки;
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТекстОшибки = НСтр("ru = 'Продажа товара запрещена по результатам проверки кода маркировки.'");
	КонецЕсли;
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция эв_КодМаркировкиМДЛП(ТекШтрихкод)
	
	ДанныеМаркировки = Неопределено;
	Если ТекШтрихкод.Свойство("ДанныеМаркировкиМДЛП", ДанныеМаркировки)
		И ТипЗнч(ДанныеМаркировки) = Тип("Структура")
		И ДанныеМаркировки.Свойство("ШтрихкодBase64")
		И ЗначениеЗаполнено(ДанныеМаркировки.ШтрихкодBase64) Тогда
		Возврат ДанныеМаркировки.ШтрихкодBase64;
	КонецЕсли;
	
	Возврат ТекШтрихкод.Штрихкод;
	
КонецФункции

&НаКлиенте
Функция эв_КодМаркировкиИСМП(ДанныеШтрихкода)
	
	Если ЗначениеЗаполнено(ДанныеШтрихкода.ПолныйКодМаркировки) Тогда
		Возврат ДанныеШтрихкода.ПолныйКодМаркировки;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШтрихкода, "ШтрихкодBase64")
		И ЗначениеЗаполнено(ДанныеШтрихкода.ШтрихкодBase64) Тогда
		Возврат ДанныеШтрихкода.ШтрихкодBase64;
	КонецЕсли;
	
	Возврат ДанныеШтрихкода.Штрихкод;
	
КонецФункции

&НаКлиенте
Функция эв_ОжидаетсяПроверкаКодаМаркировки(КодДляУточнения)
	
	Если Не ЗначениеЗаполнено(КодДляУточнения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РезультатОбработки = КодДляУточнения.РезультатОбработкиШтрихкода;
	Если эв_СвойствоИстина(РезультатОбработки, "ОткрытьФормуВводаКодаМаркировки")
		Или эв_СвойствоИстина(РезультатОбработки, "ТребуетсяУточнениеДанных")
		Или эв_СвойствоИстина(РезультатОбработки, "ТребуетсяУточнениеСоставаУпаковки")
		Или эв_СвойствоИстина(РезультатОбработки, "ТребуетсяВскрытиеПотребительскойУпаковки") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат эв_ПроверкаНеЗавершена(РезультатОбработки, "ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ", "ПроверкаНаТСПИоТЗавершена")
		Или эв_ПроверкаНеЗавершена(РезультатОбработки, "ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле", "ПроверкаНаЛокальномМодулеЧестныйЗнакЗавершена")
		Или эв_ПроверкаНеЗавершена(РезультатОбработки, "ТребуетсяПроверкаСредствамиККТ", "ПроверкаСредствамиККТЗавершена");
	
КонецФункции

&НаКлиенте
Функция эв_СвойствоИстина(Источник, ИмяСвойства)
	
	Значение = Неопределено;
	Возврат Источник.Свойство(ИмяСвойства, Значение) И Значение = Истина;
	
КонецФункции

&НаКлиенте
Функция эв_ПроверкаНеЗавершена(РезультатОбработки, ИмяТребования, ИмяЗавершения)
	
	Возврат эв_СвойствоИстина(РезультатОбработки, ИмяТребования)
		И Не эв_СвойствоИстина(РезультатОбработки, ИмяЗавершения);
	
КонецФункции

&НаКлиенте
Процедура эв_ОтметитьПроверкуКодаМаркировкиЗавершенной(РезультатОбработки)
	
	эв_УстановитьСвойство(РезультатОбработки, "ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле", Ложь);
	эв_УстановитьСвойство(РезультатОбработки, "ПроверкаНаТСПИоТЗавершена", Истина);
	эв_УстановитьСвойство(РезультатОбработки, "ПроверкаСредствамиККТЗавершена", Истина);
	эв_УстановитьСвойство(РезультатОбработки, "ЕстьОшибки", Ложь);
	эв_УстановитьСвойство(РезультатОбработки, "ТекстОшибки", "");
	
КонецПроцедуры

&НаКлиенте
Процедура эв_УстановитьСвойство(Приемник, ИмяСвойства, Значение)
	
	Если Приемник.Свойство(ИмяСвойства) Тогда
		Приемник[ИмяСвойства] = Значение;
	Иначе
		Приемник.Вставить(ИмяСвойства, Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура эв_ЗаполнитьРеквизитыРазрешительногоРежима(Приемник, РезультатПроверки)
	
	ИменаРеквизитов = СтрРазделить(
		"РазрешительныйРежимИдентификаторЗапросаГИСМТ,РазрешительныйРежимДатаЗапросаГИСМТ,РазрешительныйРежимИдентификаторЭкземпляраПО,РазрешительныйРежимВерсияБазы",
		",");
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Приемник, ИмяРеквизита) Тогда
			Приемник[ИмяРеквизита] = РезультатПроверки[ИмяРеквизита];
		ИначеЕсли ТипЗнч(Приемник) = Тип("Структура") Тогда
			Приемник.Вставить(ИмяРеквизита, РезультатПроверки[ИмяРеквизита]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура эв_ЗафиксироватьРезультатВНомерахУпаковок(ТекШтрихкод, РезультатПроверки)
	
	ДанныеМаркировки = Неопределено;
	Если Не ТекШтрихкод.Свойство("ДанныеМаркировкиМДЛП", ДанныеМаркировки)
		Или ТипЗнч(ДанныеМаркировки) <> Тип("Структура")
		Или Не ДанныеМаркировки.Свойство("sgtin") Тогда
		Возврат;
	КонецЕсли;
	
	эв_ЗаполнитьСтрокуРазрешительногоРежима(Объект.ор_НомераУпаковок, ДанныеМаркировки.sgtin, РезультатПроверки);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ор_НомераУпаковокПодарков") Тогда
		эв_ЗаполнитьСтрокуРазрешительногоРежима(Объект.ор_НомераУпаковокПодарков, ДанныеМаркировки.sgtin, РезультатПроверки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура эв_ЗаполнитьСтрокуРазрешительногоРежима(ТабличнаяЧасть, НомерКИЗ, РезультатПроверки)
	
	НайденныеСтроки = ТабличнаяЧасть.НайтиСтроки(Новый Структура("НомерКИЗ", НомерКИЗ));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	эв_ЗаполнитьРеквизитыРазрешительногоРежима(НайденныеСтроки[НайденныеСтроки.Количество() - 1], РезультатПроверки);
	
КонецПроцедуры

&НаКлиенте
Процедура эв_ЗафиксироватьРезультатВАкцизныхМарках(ДанныеШтрихкода, РезультатПроверки)
	
	СтрокаМарки = эв_СтрокаАкцизнойМарки(ДанныеШтрихкода);
	Если СтрокаМарки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	эв_ЗаполнитьРеквизитыРазрешительногоРежима(СтрокаМарки, РезультатПроверки);
	
КонецПроцедуры

&НаКлиенте
Функция эв_СтрокаАкцизнойМарки(ДанныеШтрихкода)
	
	ШтрихкодУпаковки = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШтрихкода, "ШтрихкодУпаковки") Тогда
		ШтрихкодУпаковки = ДанныеШтрихкода.ШтрихкодУпаковки;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
		НайденныеСтроки = Объект.АкцизныеМарки.НайтиСтроки(Новый Структура("ШтрихкодУпаковки", ШтрихкодУпаковки));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НайденныеСтроки = Объект.АкцизныеМарки.НайтиСтроки(Новый Структура("АкцизнаяМарка", ШтрихкодУпаковки));
		КонецЕсли;
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат НайденныеСтроки[НайденныеСтроки.Количество() - 1];
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШтрихкода, "Штрихкод")
		И ЗначениеЗаполнено(ДанныеШтрихкода.Штрихкод) Тогда
		НайденныеСтроки = Объект.АкцизныеМарки.НайтиСтроки(Новый Структура("КодАкцизнойМарки", ДанныеШтрихкода.Штрихкод));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат НайденныеСтроки[НайденныеСтроки.Количество() - 1];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

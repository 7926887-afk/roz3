Перем Клиент;

Процедура УстановитьСоединение() Экспорт
	
	КомпонентаПодключена = ПодключитьВнешнююКомпоненту(
		"Обработка.эв_КомпонентаRabbitMQ.Макет.эв_PinkRabbitMQ",
		"RabbitMQ",
		ТипВнешнейКомпоненты.Native);
	Если Не КомпонентаПодключена Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось подключить внешнюю компоненту PinkRabbitMQ'");
	КонецЕсли;
	
	Клиент = Новый("AddIn.RabbitMQ.PinkRabbitMQ");
	
	ПортСоединения = ?(Порт = 0, 5672, Порт);
	ВиртуальныйХостСоединения = ?(ПустаяСтрока(ВиртуальныйХост), "/", ВиртуальныйХост);
	ЧастотаПульсаСоединения = ?(ЧастотаПульса = 0, 60, ЧастотаПульса);
	
	Попытка
		Клиент.Connect(
			Адрес,
			ПортСоединения,
			Пользователь,
			Пароль,
			ВиртуальныйХостСоединения,
			ЧастотаПульсаСоединения,
			ЗащищенноеСоединение);
	Исключение
		ТекстОшибки = НСтр("ru = 'Компонента PinkRabbitMQ - не удалось установить соединение с сервером RabbitMQ.
			|'") + ТекстОшибкиКомпоненты();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗавершитьСоединение() Экспорт
	
	Клиент = Неопределено;
	
КонецПроцедуры

Функция ОтправитьСообщение(ТекстСообщения, КлючМаршрутизации, ИдентификаторСообщения = Неопределено, ТаймаутПодтверждения = 10000) Экспорт
	
	Результат = Новый Структура("Успешно, ТекстОшибки", Ложь, "");
	
	Попытка
		Клиент.MessageID = ?(ЗначениеЗаполнено(ИдентификаторСообщения), ИдентификаторСообщения, Строка(Новый УникальныйИдентификатор));
		Клиент.BasicPublish(ТочкаОбмена, КлючМаршрутизации, ТекстСообщения, ТаймаутПодтверждения, Истина);
		Результат.Успешно = Истина;
	Исключение
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС
			+ ТекстОшибкиКомпоненты();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция НачатьЧтение(Знач ИмяОчереди) Экспорт
	
	Возврат Клиент.BasicConsume(ИмяОчереди, "", Ложь, Ложь, 1);
	
КонецФункции

Функция ПрочитатьСообщение(Знач ИдентификаторПотребителя, Знач Таймаут = 1000) Экспорт
	
	ТекстСообщения = "";
	ТегСообщения = 0;
	Успешно = Клиент.BasicConsumeMessage(ИдентификаторПотребителя, ТекстСообщения, ТегСообщения, Таймаут);
	Если Не Успешно Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстСообщения", ТекстСообщения);
	Результат.Вставить("ТегСообщения", ТегСообщения);
	Результат.Вставить("КлючМаршрутизации", Клиент.GetRoutingKey());
	Возврат Результат;
	
КонецФункции

Процедура ЗакончитьЧтение(Знач ИдентификаторПотребителя) Экспорт
	
	Попытка
		Клиент.BasicCancel(ИдентификаторПотребителя);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция ПодтвердитьСообщение(ТегСообщения) Экспорт
	
	Попытка
		Клиент.BasicAck(ТегСообщения);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ТекстОшибкиКомпоненты()
	
	Если Клиент = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Клиент.GetLastError();
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

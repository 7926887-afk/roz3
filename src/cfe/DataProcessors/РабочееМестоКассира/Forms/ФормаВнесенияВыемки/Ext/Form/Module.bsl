
&После("ПриСозданииНаСервере")
&НаСервере
Процедура эв_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтоВнесение Или Не ПравоПросмотраОстаткаНаличныхРМК Тогда
		Возврат;
	КонецЕсли;
	
	СоставОстатка = ОбщегоНазначенияРМКУНФ.эв_СоставОстаткаКассыККМ(Организация, КассаККМ);
	ТекстРасшифровки = СтрШаблон(НСтр("ru = 'Размен: %1 %2'"),
		Формат(СоставОстатка.СуммаРазмена, "ЧДЦ=2; ЧРД=,; ЧН=0,00"), ПредставлениеВалюты)
		+ Символы.ПС
		+ СтрШаблон(НСтр("ru = 'Выручка: %1 %2'"),
			Формат(СоставОстатка.СуммаВыручки, "ЧДЦ=2; ЧРД=,; ЧН=0,00"), ПредставлениеВалюты);
	
	Подсказка = Элементы.СуммаОперации.Подсказка;
	ПозицияПереноса = СтрНайти(Подсказка, Символы.ПС);
	Если ПозицияПереноса > 0 И СтрНачинаетсяС(Подсказка, НСтр("ru = 'Наличные в кассе'")) Тогда
		ТекстРасшифровки = ТекстРасшифровки + Сред(Подсказка, ПозицияПереноса);
	КонецЕсли;
	
	Элементы.СуммаОперации.Подсказка = ТекстРасшифровки;
	
КонецПроцедуры

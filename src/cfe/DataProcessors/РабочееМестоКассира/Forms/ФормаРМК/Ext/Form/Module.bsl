#Область эв_КошелекПервостольника

&НаСервере
Процедура эв_ДобавитьРеквизитыКошелькаПервостольника()
	
	ДобавляемыеРеквизиты = Новый Массив;
	ТипСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2));
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_ИБ") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_ИБ",
			ТипСуммы,
			"Объект.Товары",
			НСтр("ru = 'Индивидуальный бонус'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_КБ") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_КБ",
			ТипСуммы,
			"Объект.Товары",
			НСтр("ru = 'Коллективный бонус'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_СтавкаСуммаИБ") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СтавкаСуммаИБ",
			ТипСуммы,
			"Объект.Товары",
			НСтр("ru = 'Ставка сумма ИБ'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_СтавкаСуммаКБ") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СтавкаСуммаКБ",
			ТипСуммы,
			"Объект.Товары",
			НСтр("ru = 'Ставка сумма КБ'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_СтавкаПроцентИБ") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СтавкаПроцентИБ",
			ТипСуммы,
			"Объект.Товары",
			НСтр("ru = 'Ставка процент ИБ'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_СтавкаПроцентКБ") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СтавкаПроцентКБ",
			ТипСуммы,
			"Объект.Товары",
			НСтр("ru = 'Ставка процент КБ'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_ЦенаЗакупки") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_ЦенаЗакупки",
			ТипСуммы,
			"Объект.Товары",
			НСтр("ru = 'Цена закупки'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_СтавкиБонусовЗаполнены") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СтавкиБонусовЗаполнены",
			Новый ОписаниеТипов("Булево"),
			"Объект.Товары",
			НСтр("ru = 'Ставки бонусов заполнены'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("", "эв_СуммаИБМесяц") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СуммаИБМесяц",
			ТипСуммы,
			,
			НСтр("ru = 'Месяц'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("", "эв_СуммаИБСегодня") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СуммаИБСегодня",
			ТипСуммы,
			,
			НСтр("ru = 'Сегодня'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("", "эв_СуммаИБЧек") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_СуммаИБЧек",
			ТипСуммы,
			,
			НСтр("ru = 'Чек'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("", "эв_ОборотИБМесяцБаза") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_ОборотИБМесяцБаза",
			ТипСуммы,
			,
			НСтр("ru = 'Оборот ИБ месяц база'")));
	КонецЕсли;
	
	Если Не эв_ЕстьРеквизитФормы("", "эв_ОборотИБДеньБаза") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"эв_ОборотИБДеньБаза",
			ТипСуммы,
			,
			НСтр("ru = 'Оборот ИБ день база'")));
	КонецЕсли;
	
	Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	эв_ВывестиКолонкиКошелькаВТовары();
	эв_ВывестиИнформационныеПоляКошелька();
	
КонецПроцедуры

&НаСервере
Функция эв_ЕстьРеквизитФормы(Путь, ИмяРеквизита)
	
	Для Каждого Реквизит Из ПолучитьРеквизиты(Путь) Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура эв_ВывестиКолонкиКошелькаВТовары()
	
	ТаблицаТовары = Элементы.Найти("Товары");
	Если ТаблицаТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	эв_ДобавитьПолеКолонкиТовары(ТаблицаТовары, "эв_ИБ", НСтр("ru = 'Индивидуальный бонус'"));
	эв_ДобавитьПолеКолонкиТовары(ТаблицаТовары, "эв_КБ", НСтр("ru = 'Коллективный бонус'"));
	
КонецПроцедуры

&НаСервере
Процедура эв_ДобавитьПолеКолонкиТовары(ТаблицаТовары, ИмяРеквизита, ЗаголовокПоля)
	
	ИмяЭлемента = "Товары" + ИмяРеквизита;
	Если Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ТаблицаТовары);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.Товары." + ИмяРеквизита;
	НовыйЭлемент.Заголовок = ЗаголовокПоля;
	НовыйЭлемент.Ширина = 10;
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.ТолькоПросмотр = Истина;
	НовыйЭлемент.ПропускатьПриВводе = Истина;
	
КонецПроцедуры

&НаСервере
Процедура эв_ВывестиИнформационныеПоляКошелька()
	
	Если Элементы.Найти("ГруппаэвКошелекПервостольника") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РодительскаяГруппа = Элементы.Найти("ГруппаСуммаИтогоПоЧеку");
	Если РодительскаяГруппа = Неопределено Тогда
		РодительскаяГруппа = Элементы.Найти("ГруппаОбщиеИтоги");
	КонецЕсли;
	Если РодительскаяГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РодительскаяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ГруппаКошелька = Элементы.Добавить("ГруппаэвКошелекПервостольника", Тип("ГруппаФормы"), РодительскаяГруппа);
    ГруппаКошелька.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаКошелька.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
    ГруппаКошелька.Заголовок = НСтр("ru = 'Кошелек первостольника'");
    ГруппаКошелька.ОтображатьЗаголовок = Истина;
    ГруппаКошелька.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
    ГруппаКошелька.РастягиватьПоГоризонтали = Истина;
 	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ЦветаФормы")
        И ЦветаФормы.Свойство("АктивнаяКнопка") Тогда
        ГруппаКошелька.ЦветФона = ЦветаФормы.АктивнаяКнопка;
    Иначе
        ГруппаКошелька.ЦветФона = ЦветаСтиля.ЦветАктивнойКнопкиРМК;
    КонецЕсли;       
    
    ТекущаяДата = ТекущаяДатаСеанса();
	ЗаголовокМесяца = ВРег(Формат(ТекущаяДата, "ДФ=ММММ"));
	
	эв_ДобавитьИнформационноеПолеКошелька(ГруппаКошелька, "эв_СуммаИБМесяц", ЗаголовокМесяца);
	эв_ДобавитьИнформационноеПолеКошелька(ГруппаКошелька, "эв_СуммаИБСегодня", НСтр("ru = 'СЕГОДНЯ'"));
	эв_ДобавитьИнформационноеПолеКошелька(ГруппаКошелька, "эв_СуммаИБЧек", НСтр("ru = 'ЧЕК'"));
	
КонецПроцедуры

&НаСервере
Процедура эв_ДобавитьИнформационноеПолеКошелька(РодительскаяГруппа, ИмяРеквизита, ЗаголовокПоля)
	
	Если Элементы.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеСуммы = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), РодительскаяГруппа);
	ПолеСуммы.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеСуммы.ПутьКДанным = ИмяРеквизита;
	ПолеСуммы.Заголовок = ЗаголовокПоля;
	ПолеСуммы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	ПолеСуммы.Формат = "ЧДЦ=2; ЧН=0,00";
	ПолеСуммы.ТолькоПросмотр = Истина;
	ПолеСуммы.ПропускатьПриВводе = Истина;
	ПолеСуммы.Ширина = 12;
	ПолеСуммы.РастягиватьПоГоризонтали = Истина;
   	ПолеСуммы.Шрифт = ШрифтыСтиля.ШрифтОбычный12РМК;
   	ПолеСуммы.ШрифтЗаголовка = ШрифтыСтиля.ШрифтОбычный12РМК;    
	
КонецПроцедуры

&НаСервере
Процедура эв_ОбновитьОборотыКошелькаПервостольникаНаСервере()
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "эв_ОборотИБМесяцБаза") Тогда
		Возврат;
	КонецЕсли;
	
	Обороты = эв_ОборотыКошелькаПервостольника(
		Объект.Кассир,
		Объект.ТорговыйОбъект,
		ТекущаяДатаСеанса());
	
	ЭтотОбъект.эв_ОборотИБМесяцБаза = Обороты.Месяц;
	ЭтотОбъект.эв_ОборотИБДеньБаза = Обороты.День;
	
	ПолеМесяца = Элементы.Найти("эв_СуммаИБМесяц");
	Если ПолеМесяца <> Неопределено Тогда
		ПолеМесяца.Заголовок = ВРег(Формат(ТекущаяДатаСеанса(), "ДФ=ММММ"));
	КонецЕсли;
	
	эв_ПересчитатьПоказателиКошелькаПервостольникаСервер();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция эв_ОборотыКошелькаПервостольника(Ответственный, СтруктурнаяЕдиница, ДатаРасчета)
	
	Результат = Новый Структура("Месяц, День", 0, 0);
	
	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НачалоМесяца = НачалоМесяца(ДатаРасчета);
	НачалоДня = НачалоДня(ДатаРасчета);
	КонецДня = КонецДня(ДатаРасчета);
	БезОтбораПоТочке = Не ЗначениеЗаполнено(СтруктурнаяЕдиница);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Обороты.эв_ИБОборот), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.эв_КошелекПервостольника.Обороты(&НачалоПериода, &КонецПериода, ,
	|		Ответственный = &Ответственный
	|			И (&БезОтбораПоТочке
	|				ИЛИ СтруктурнаяЕдиница = &СтруктурнаяЕдиница)) КАК Обороты";
	
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("БезОтбораПоТочке", БезОтбораПоТочке);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня);
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца);
	ВыборкаМесяц = Запрос.Выполнить().Выбрать();
	Если ВыборкаМесяц.Следующий() Тогда
		Результат.Месяц = ВыборкаМесяц.Сумма;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня);
	ВыборкаДень = Запрос.Выполнить().Выбрать();
	Если ВыборкаДень.Следующий() Тогда
		Результат.День = ВыборкаДень.Сумма;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура эв_ПересчитатьПоказателиКошелькаПервостольникаКлиент()
	

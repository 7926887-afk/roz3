#Область эв_РасчетБонусовПервостольника

&НаСервере
Процедура эв_РассчитатьБонусыПервостольникаВСтрокеНаСервере(ИдентификаторСтроки)
	
	СтрокаТовара = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	эв_РассчитатьБонусыПервостольникаВСтроке(СтрокаТовара);
	эв_ПересчитатьПоказателиКошелькаПервостольникаСервер();
	
КонецПроцедуры

&НаСервере
Процедура эв_РассчитатьБонусыПервостольникаВТоварах()
    
    Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_ИБ") Тогда
        Возврат;
    КонецЕсли;
    
    Если Объект.Товары.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    НоменклатураТоваров = Новый Массив;
    ТоварыДляСебестоимости = эв_НоваяТаблицаТоваровДляСебестоимости();
    
    Для Каждого СтрокаТовара Из Объект.Товары Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
            Продолжить;
        КонецЕсли;
        НоменклатураТоваров.Добавить(СтрокаТовара.Номенклатура);
        эв_ДобавитьСтрокуТовараДляСебестоимости(ТоварыДляСебестоимости, СтрокаТовара);
    КонецЦикла;
    
    ДатаРасчета = ТекущаяДатаСеанса();
    СтавкиПоНоменклатуре = эв_СтавкиБонусовПервостольникаПоНоменклатуре(
        НоменклатураТоваров,
        Объект.ТорговыйОбъект,
        ДатаРасчета);
    СебестоимостьПоТоварам = эв_СебестоимостьНоменклатуры(
        ТоварыДляСебестоимости,
        Объект.ТорговыйОбъект,
        ДатаРасчета);
    
    Для Каждого СтрокаТовара Из Объект.Товары Цикл
        СтруктураБонусов = эв_СтруктураБонусовДляСтрокиТовара(
            СтрокаТовара,
            СтавкиПоНоменклатуре,
            СебестоимостьПоТоварам);
        эв_ЗаполнитьКэшСтавокБонусовВСтроке(СтрокаТовара, СтруктураБонусов);
        эв_ПрименитьРасчетБонусовПервостольникаКСтроке(СтрокаТовара, СтруктураБонусов);
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Процедура эв_РассчитатьБонусыПервостольникаВСтроке(СтрокаТовара)
    
    Если Не эв_ЕстьРеквизитФормы("Объект.Товары", "эв_ИБ") Тогда
        Возврат;
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
        СтрокаТовара.эв_ИБ = 0;
        СтрокаТовара.эв_КБ = 0;
        Возврат;
    КонецЕсли;
    
    ДатаРасчета = ТекущаяДатаСеанса();
    ТоварыДляСебестоимости = эв_НоваяТаблицаТоваровДляСебестоимости();
    эв_ДобавитьСтрокуТовараДляСебестоимости(ТоварыДляСебестоимости, СтрокаТовара);
    
    СтавкиПоНоменклатуре = эв_СтавкиБонусовПервостольникаПоНоменклатуре(
        ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаТовара.Номенклатура),
        Объект.ТорговыйОбъект,
        ДатаРасчета);
    СебестоимостьПоТоварам = эв_СебестоимостьНоменклатуры(
        ТоварыДляСебестоимости,
        Объект.ТорговыйОбъект,
        ДатаРасчета);
    
    СтруктураБонусов = эв_СтруктураБонусовДляСтрокиТовара(
        СтрокаТовара,
        СтавкиПоНоменклатуре,
        СебестоимостьПоТоварам);
    
    эв_ЗаполнитьКэшСтавокБонусовВСтроке(СтрокаТовара, СтруктураБонусов);
    эв_ПрименитьРасчетБонусовПервостольникаКСтроке(СтрокаТовара, СтруктураБонусов);
    
КонецПроцедуры

&НаКлиенте
Процедура эв_ПересчитатьБонусыПервостольникаПоКэшуСтавокКлиент()
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "эв_СуммаИБЧек") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		
		Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "эв_СтавкиБонусовЗаполнены")
			Или Не СтрокаТовара.эв_СтавкиБонусовЗаполнены Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураБонусов = Новый Структура;
		СтруктураБонусов.Вставить("СуммаИБ", СтрокаТовара.эв_СтавкаСуммаИБ);
		СтруктураБонусов.Вставить("СуммаКБ", СтрокаТовара.эв_СтавкаСуммаКБ);
		СтруктураБонусов.Вставить("ПроцентИБ", СтрокаТовара.эв_СтавкаПроцентИБ);
		СтруктураБонусов.Вставить("ПроцентКБ", СтрокаТовара.эв_СтавкаПроцентКБ);
		СтруктураБонусов.Вставить("ЦенаЗакупки", СтрокаТовара.эв_ЦенаЗакупки);
		
		эв_ПрименитьРасчетБонусовПервостольникаКСтроке(СтрокаТовара, СтруктураБонусов);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура эв_ЗаполнитьКэшСтавокБонусовВСтроке(СтрокаТовара, СтруктураБонусов)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "эв_СтавкиБонусовЗаполнены") Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТовара.эв_СтавкаСуммаИБ = СтруктураБонусов.СуммаИБ;
	СтрокаТовара.эв_СтавкаСуммаКБ = СтруктураБонусов.СуммаКБ;
	СтрокаТовара.эв_СтавкаПроцентИБ = СтруктураБонусов.ПроцентИБ;
	СтрокаТовара.эв_СтавкаПроцентКБ = СтруктураБонусов.ПроцентКБ;
	СтрокаТовара.эв_ЦенаЗакупки = СтруктураБонусов.ЦенаЗакупки;
	СтрокаТовара.эв_СтавкиБонусовЗаполнены = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура эв_ПрименитьРасчетБонусовПервостольникаКСтроке(СтрокаТовара, СтруктураБонусов)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "эв_ИБ") Тогда
		Возврат;
	КонецЕсли;
	
	СуммаСкидкиОплатыБонусом = 0;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "СуммаСкидкиОплатыБонусом") Тогда
		СуммаСкидкиОплатыБонусом = СтрокаТовара.СуммаСкидкиОплатыБонусом;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураБонусов.СуммаИБ) Тогда
		СтрокаТовара.эв_ИБ = СтрокаТовара.Количество * СтруктураБонусов.СуммаИБ;
	Иначе
		Если СтруктураБонусов.ЦенаЗакупки = 0 Тогда
			СтрокаТовара.эв_ИБ = 0;
		Иначе
			СтрокаТовара.эв_ИБ = Окр(
				(СтрокаТовара.Сумма + СуммаСкидкиОплатыБонусом
					- СтруктураБонусов.ЦенаЗакупки * СтрокаТовара.Количество)
					* СтруктураБонусов.ПроцентИБ / 100,
				2);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураБонусов.СуммаКБ) Тогда
		СтрокаТовара.эв_КБ = СтрокаТовара.Количество * СтруктураБонусов.СуммаКБ;
	Иначе
		Если СтруктураБонусов.ЦенаЗакупки = 0 Тогда
			СтрокаТовара.эв_КБ = 0;
		Иначе
			СтрокаТовара.эв_КБ = Окр(
				(СтрокаТовара.Сумма + СуммаСкидкиОплатыБонусом
					- СтруктураБонусов.ЦенаЗакупки * СтрокаТовара.Количество)
					* СтруктураБонусов.ПроцентКБ / 100,
				2);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция эв_ПустаяСтруктураБонусовПервостольника()
	
	Результат = Новый Структура;
	Результат.Вставить("СуммаИБ", 0);
	Результат.Вставить("СуммаКБ", 0);
	Результат.Вставить("ПроцентИБ", 0);
	Результат.Вставить("ПроцентКБ", 0);
	Результат.Вставить("ЦенаЗакупки", 0);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция эв_СтавкиБонусовПервостольникаПоНоменклатуре(НоменклатураТоваров, СтруктурнаяЕдиница, ДатаРасчета)
    
    Результат = Новый Соответствие;
    Если НоменклатураТоваров.Количество() = 0 Или Не ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда
        Возврат Результат;
    КонецЕсли;
    
    УникальнаяНоменклатура = Новый Массив;
    Для Каждого Номенклатура Из НоменклатураТоваров Цикл
        Если ЗначениеЗаполнено(Номенклатура) И УникальнаяНоменклатура.Найти(Номенклатура) = Неопределено Тогда
            УникальнаяНоменклатура.Добавить(Номенклатура);
        КонецЕсли;
    КонецЦикла;
    
    Если УникальнаяНоменклатура.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    
    РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(УникальнаяНоменклатура, "ЦеноваяГруппа");
    ЦеновыеГруппы = Новый Массив;
    Для Каждого КлючИЗначение Из РеквизитыНоменклатуры Цикл
        ЦеноваяГруппа = КлючИЗначение.Значение.ЦеноваяГруппа;
        Если ЗначениеЗаполнено(ЦеноваяГруппа) И ЦеновыеГруппы.Найти(ЦеноваяГруппа) = Неопределено Тогда
            ЦеновыеГруппы.Добавить(ЦеноваяГруппа);
        КонецЕсли;
    КонецЦикла;
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Ставки.Номенклатура КАК Номенклатура,
    |   Ставки.ЦеноваяГруппа КАК ЦеноваяГруппа,
    |   Ставки.ПроцентИБ КАК ПроцентИБ,
    |   Ставки.ПроцентКБ КАК ПроцентКБ,
    |   Ставки.СуммаИБ КАК СуммаИБ,
    |   Ставки.СуммаКБ КАК СуммаКБ
    |ИЗ
    |   РегистрСведений.эв_СтавкиБонусовПервостольника.СрезПоследних(
    |           &ДатаРасчета,
    |           СтруктурнаяЕдиница = &СтруктурнаяЕдиница
    |               И (Номенклатура В (&Номенклатура)
    |                   ИЛИ Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |                       И ЦеноваяГруппа В (&ЦеновыеГруппы))) КАК Ставки
    |ГДЕ
    |   (Ставки.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
    |       ИЛИ Ставки.ДатаОкончания >= &НачалоДняРасчета)";
    
    Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
    Запрос.УстановитьПараметр("НачалоДняРасчета", НачалоДня(ДатаРасчета));
    Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
    Запрос.УстановитьПараметр("Номенклатура", УникальнаяНоменклатура);
    Запрос.УстановитьПараметр("ЦеновыеГруппы", ЦеновыеГруппы);
    
    СтавкиПоНоменклатуре = Новый Соответствие;
    СтавкиПоЦеновойГруппе = Новый Соответствие;
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        
        СтруктураБонусов = эв_ПустаяСтруктураБонусовПервостольника();
        СтруктураБонусов.СуммаИБ = Выборка.СуммаИБ;
        СтруктураБонусов.СуммаКБ = Выборка.СуммаКБ;
        СтруктураБонусов.ПроцентИБ = Выборка.ПроцентИБ;
        СтруктураБонусов.ПроцентКБ = Выборка.ПроцентКБ;
        
        Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
            СтавкиПоНоменклатуре.Вставить(Выборка.Номенклатура, СтруктураБонусов);
        ИначеЕсли ЗначениеЗаполнено(Выборка.ЦеноваяГруппа) Тогда
            СтавкиПоЦеновойГруппе.Вставить(Выборка.ЦеноваяГруппа, СтруктураБонусов);
        КонецЕсли;
        
    КонецЦикла;
    
    Для Каждого Номенклатура Из УникальнаяНоменклатура Цикл
        
        СтруктураБонусов = СтавкиПоНоменклатуре.Получить(Номенклатура);
        Если СтруктураБонусов = Неопределено Тогда
            Реквизиты = РеквизитыНоменклатуры.Получить(Номенклатура);
            Если Реквизиты <> Неопределено И ЗначениеЗаполнено(Реквизиты.ЦеноваяГруппа) Тогда
                СтруктураБонусов = СтавкиПоЦеновойГруппе.Получить(Реквизиты.ЦеноваяГруппа);
            КонецЕсли;
        КонецЕсли;
        
        Если СтруктураБонусов = Неопределено Тогда
            СтруктураБонусов = эв_ПустаяСтруктураБонусовПервостольника();
        Иначе
            СтруктураБонусов = Новый Структура(
                "СуммаИБ, СуммаКБ, ПроцентИБ, ПроцентКБ, ЦенаЗакупки",
                СтруктураБонусов.СуммаИБ,
                СтруктураБонусов.СуммаКБ,
               СтруктураБонусов.ПроцентИБ,
                СтруктураБонусов.ПроцентКБ,
                0);
        КонецЕсли;
        
        Результат.Вставить(Номенклатура, СтруктураБонусов);
        
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

&НаСервереБезКонтекста
Функция эв_НоваяТаблицаТоваровДляСебестоимости()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Возврат ТаблицаТоваров;
	
КонецФункции

&НаСервереБезКонтекста
Процедура эв_ДобавитьСтрокуТовараДляСебестоимости(ТаблицаТоваров, СтрокаТовара)
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "Характеристика")
		И ЗначениеЗаполнено(СтрокаТовара.Характеристика) Тогда
		Характеристика = СтрокаТовара.Характеристика;
	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура, Характеристика", СтрокаТовара.Номенклатура, Характеристика);
	Если ТаблицаТоваров.НайтиСтроки(Отбор).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ТаблицаТоваров.Добавить();
	НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
	НоваяСтрока.Характеристика = Характеристика;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция эв_СтруктураБонусовДляСтрокиТовара(СтрокаТовара, СтавкиПоНоменклатуре, СебестоимостьПоТоварам)
	
	СтруктураБонусов = СтавкиПоНоменклатуре.Получить(СтрокаТовара.Номенклатура);
	Если СтруктураБонусов = Неопределено Тогда
		СтруктураБонусов = эв_ПустаяСтруктураБонусовПервостольника();
	Иначе
		СтруктураБонусов = Новый Структура(
			"СуммаИБ, СуммаКБ, ПроцентИБ, ПроцентКБ, ЦенаЗакупки",
			СтруктураБонусов.СуммаИБ,
			СтруктураБонусов.СуммаКБ,
			СтруктураБонусов.ПроцентИБ,
			СтруктураБонусов.ПроцентКБ,
			0);
	КонецЕсли;
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "Характеристика")
		И ЗначениеЗаполнено(СтрокаТовара.Характеристика) Тогда
		Характеристика = СтрокаТовара.Характеристика;
	КонецЕсли;
	
	СтруктураБонусов.ЦенаЗакупки = эв_СебестоимостьИзСоответствия(
		СебестоимостьПоТоварам,
		СтрокаТовара.Номенклатура,
		Характеристика);
	
	Возврат СтруктураБонусов;
	
КонецФункции

&НаСервереБезКонтекста
Функция эв_СебестоимостьИзСоответствия(СебестоимостьПоТоварам, Номенклатура, Характеристика)
	
	ПоНоменклатуре = СебестоимостьПоТоварам.Получить(Номенклатура);
	Если ПоНоменклатуре = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Себестоимость = ПоНоменклатуре.Получить(Характеристика);
	Если Себестоимость = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Себестоимость;
	
КонецФункции

&НаСервереБезКонтекста
Функция эв_СебестоимостьНоменклатуры(ТоварыДляРасчета, СтруктурнаяЕдиница, ДатаРасчета)
	
	Результат = Новый Соответствие;
	Если ТоварыДляРасчета.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТоварыДляРасчета КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗапасыОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыОстатки.Характеристика КАК Характеристика,
	|	СУММА(ЗапасыОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	СУММА(ЗапасыОстатки.СуммаОстаток) КАК СуммаОстаток
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			&ДатаРасчета,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТТовары.Номенклатура
	|					ИЗ
	|						ВТТовары КАК ВТТовары)
	|				И (&БезОтбораПоТочке
	|					ИЛИ СтруктурнаяЕдиница = &СтруктурнаяЕдиница)) КАК ЗапасыОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыОстатки.Номенклатура,
	|	ЗапасыОстатки.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Номенклатура КАК Номенклатура,
	|	ВТТовары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(СУММА(ВТОстатки.КоличествоОстаток), 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(СУММА(ВТОстатки.СуммаОстаток), 0) КАК СуммаОстаток
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ВТТовары.Номенклатура = ВТОстатки.Номенклатура
	|			И (ВЫБОР
	|				КОГДА ВТТовары.Номенклатура.ИспользоватьХарактеристики
	|					ТОГДА ВТТовары.Характеристика = ВТОстатки.Характеристика
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТТовары.Номенклатура,
	|	ВТТовары.Характеристика";
	
	Запрос.УстановитьПараметр("ТоварыДляРасчета", ТоварыДляРасчета);
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("БезОтбораПоТочке", Не ЗначениеЗаполнено(СтруктурнаяЕдиница));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПоНоменклатуре = Результат.Получить(Выборка.Номенклатура);
		Если ПоНоменклатуре = Неопределено Тогда
			ПоНоменклатуре = Новый Соответствие;
			Результат.Вставить(Выборка.Номенклатура, ПоНоменклатуре);
		КонецЕсли;
		
		Если Выборка.КоличествоОстаток = 0 Тогда
			Себестоимость = 0;
		Иначе
			Себестоимость = Окр(Выборка.СуммаОстаток / Выборка.КоличествоОстаток, 2);
		КонецЕсли;
		
		ПоНоменклатуре.Вставить(Выборка.Характеристика, Себестоимость);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


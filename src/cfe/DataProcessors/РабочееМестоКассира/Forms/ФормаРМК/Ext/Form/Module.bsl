		  
#Область эв_СберСпасибо


&ИзменениеИКонтроль ("ОплатитьКартой")
&НаКлиенте
Процедура эв_ОплатитьКартой(ТекущийТерминал)
	
	СтруктураОтбора = ВыбраннаяОрганизацияИСНО();
	СтруктураОтбора.Вставить("Оплачено", Ложь);
	
	СтрокиОплаты = ТаблицаОплатКартой.НайтиСтроки(СтруктураОтбора);
	Если СтрокиОплаты.Количество() > 0 Тогда
		СтрокаДляОплаты = СтрокиОплаты[0];
	ИначеЕсли ТранзакцияПоКартеЗавершена Тогда
		
		ТипОплаты = "Карта";
		НачатьПечатьЧека(); 
		Возврат;
		
	Иначе
		
		ТекстЗаголовка = НСтр("ru = 'При выполнении операции возникла ошибка'");
		ТекстСообщения = НСтр("ru = 'При оплате картой возникла ошибка, перезаполните оплаты.'");
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ТекстЗаголовка);
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		Возврат;
		
	КонецЕсли;

	ПараметрыОперации = МенеджерОборудованияРМККлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
	ПараметрыОперации.ТипТранзакции = НСтр("ru = 'AuthorizeSales'");
	ПараметрыОперации.СуммаОперации = СтрокаДляОплаты.Сумма;
	ПараметрыОперации.НомерЧека = НСтр("ru = ' '");
	ПараметрыОперации.РеквизитыКартыQR = РеквизитыQRПлатежнойКарты;
	
	ПараметрыДействия = Новый Структура();
	ПараметрыДействия.Вставить("ДанныеТерминала", ТекущийТерминал);

	#Вставка      
	ПараметрыДействия.Вставить("МаксСуммаОплатыСпасибо", ЭтотОбъект.МаксСуммаОплатыСпасибо);
	ПараметрыДействия.Вставить("СуммаОперации", СтрокаДляОплаты.Сумма);
	ПараметрыДействия.Вставить("ВидОплаты", СтрокаДляОплаты.ВидОплаты);
	ПараметрыДействия.Вставить("Команда", НСтр("ru = 'AuthorizeSales'"));
	ПараметрыДействия.Вставить("ФормаВладелец", ЭтотОбъект);
	ПараметрыДействия.Вставить("Корзина", Объект.Товары);
	#КонецВставки

	Доступность = Ложь;
	
	ВозможнаВыдачаНаличных = СуммаНаличныхКВыдаче > 0 И ВыдаватьНаличныеНаКассе
		И ТекущийТерминал.ПоддерживаетВыдачуНаличных;
	КонтекстДополнительнойПроверки = Новый Структура();
	КонтекстДополнительнойПроверки.Вставить("ДанныеТерминала", ТекущийТерминал);
	КонтекстДополнительнойПроверки.Вставить("КонтекстФормы", ЭтотОбъект);
	ОбщегоНазначенияРМККлиент.
		ПроверитьДополнительныеУсловияВыполненияВыдачиНаличных(ВозможнаВыдачаНаличных, КонтекстДополнительнойПроверки);

	ВыполнитьОперациюПакетнойФискализации = НЕ ТекущийТерминал.ИспользоватьБезПодключенияОборудования
		И ВозможнаВыдачаНаличных И ТаблицаОплатКартой.Количество() = 1;
	
	Если ВыполнитьОперациюПакетнойФискализации Тогда
		
		ЭквайринговыйТерминалВыполненияОперации = ТекущийТерминал.ЭквайринговыйТерминал;
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("ВидОплаты", ТекущийТерминал.ВидОплаты);
		МассивОплат = Объект.Оплата.НайтиСтроки(СтруктураПоиска);
	
		Если МассивОплат.Количество() > 0 Тогда
			
			СтрокаОплаты = МассивОплат[0];
			СтрокаОплаты.ЭквайринговыйТерминал = ТекущийТерминал.ЭквайринговыйТерминал;
			СтрокаОплаты.ПроцентКомиссии = ТекущийТерминал.ПроцентКомиссииПриПродаже;
			СтрокаОплаты.СуммаКомиссии = СтрокаОплаты.Сумма * СтрокаОплаты.ПроцентКомиссии / 100;
		КонецЕсли;
		
		НачатьПечатьЧека(Истина);
		
	Иначе
		
		ПоказатьОкноОжиданияОплатыНаТерминале();
		Если ПечататьКороткийСлипЧек И ТаблицаОплатКартой.Количество() = 1 Тогда
			ПараметрыОперации.ИспользоватьПечатающееУстройство = Ложь;
		КонецЕсли;
		ЭквайринговыйТерминалВыполненияОперации = ТекущийТерминал.ЭквайринговыйТерминал;
		ЭквайринговыйТерминал = ТекущийТерминал.ПодключаемоеОборудование;
		ПечатающееУстройство = ПодключаемоеОборудование;
		Если ПодключенаОблачнаяККТ Тогда
			ПараметрыОперации.ИспользоватьПечатающееУстройство = Ложь;
			ПечатающееУстройство = Неопределено;
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ОплатитьКартойЗавершение", ЭтотОбъект, ПараметрыДействия);
		МенеджерОборудованияРМККлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение,
			Неопределено,
			ЭквайринговыйТерминал,
			ПараметрыОперации, ,
			ПечатающееУстройство);
		
	КонецЕсли;
	
КонецПроцедуры

&ИзменениеИКонтроль ("ВернутьОплатуПоКартеДляСтрокиОплаты")
&НаКлиенте
Процедура эв_ВернутьОплатуПоКартеДляСтрокиОплаты(СтрокаОплаты, ТекущийЭквайринговыйТерминал)
	
	ПараметрыОперации = МенеджерОборудованияРМККлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
	ПараметрыОперации.ТипТранзакции = НСтр("ru = 'AuthorizeRefund'");
	ПараметрыОперации.СуммаОперации = СтрокаОплаты.Сумма;
	ПараметрыОперации.НомерЧека = НСтр("ru = ' '");
	ПараметрыОперации.ДокументОснование = ЧекККМВОбработке;
	ПараметрыОперации.ВидОплатыНаТерминале = МенеджерОборудованияРМККлиент.СпособОплатыЭТ(СтрокаОплаты.КодСпособаОплатыЭТ);
	
	ЭквайринговыйТерминал = Неопределено;
	ТекущийТерминал = Неопределено;
		
	Если ЭтоВозвратБезОснования Тогда
		
		ТекущийТерминал = ТекущийЭквайринговыйТерминал;
		ЭквайринговыйТерминал = ТекущийЭквайринговыйТерминал.ПодключаемоеОборудование;
		
	Иначе
		
		СтруктураПоискаТерминала = Новый Структура();
		СтруктураПоискаТерминала.Вставить("ЭквайринговыйТерминал", СтрокаОплаты.ЭквайринговыйТерминал);
		
		МассивТерминалов = ТаблицаТерминалы.НайтиСтроки(СтруктураПоискаТерминала);
		Если МассивТерминалов.Количество() > 0 Тогда
			
			ТекущийТерминал = МассивТерминалов[0];
			ЭквайринговыйТерминал = ТекущийТерминал.ПодключаемоеОборудование;
			
		Иначе
			
			ТекущийТерминал = ТекущийЭквайринговыйТерминал;
			ЭквайринговыйТерминал = ТекущийЭквайринговыйТерминал.ПодключаемоеОборудование;
			
		КонецЕсли;
		
	КонецЕсли;
		
	ПараметрДействия = Новый Структура();
	ПараметрДействия.Вставить("СтрокаОплаты", СтрокаОплаты);
	ПараметрДействия.Вставить("ТекущийТерминал", ТекущийТерминал);
	ЗаполнитьЗначенияСвойств(ПараметрыОперации, СтрокаОплаты);
	
	ПечатающееУстройство = ПодключаемоеОборудование;
	Если ПодключенаОблачнаяККТ Тогда
		ПараметрыОперации.ИспользоватьПечатающееУстройство = Ложь;
		ПечатающееУстройство = Неопределено;
	КонецЕсли;

	#Вставка
	ДанныеОплатыПродажи = эв_ДанныеОплатыЧекаПродажи();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИдентификаторПС", ДанныеОплатыПродажи.ИдентификаторПлатежнойСистемы);
	ДополнительныеПараметры.Вставить("СуммаБонусовВозврата", ДанныеОплатыПродажи.СуммаБонусовВозврата);
	ДополнительныеПараметры.Вставить("ЭквайринговыйТерминалВыполненияОперации", ЭтотОбъект.ЭквайринговыйТерминалВыполненияОперации);	 
	ДополнительныеПараметры.Вставить("Корзина", Объект.Товары);
	
	Оповещение = Новый ОписаниеОповещения("ВернутьОплатуПоКартеЗавершение", ЭтотОбъект, ПараметрДействия);
	МенеджерОборудованияРМККлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение,
		Неопределено, ЭквайринговыйТерминал, ПараметрыОперации, ДополнительныеПараметры, ПечатающееУстройство);
	#КонецВставки

	#Удаление
	Оповещение = Новый ОписаниеОповещения("ВернутьОплатуПоКартеЗавершение", ЭтотОбъект, ПараметрДействия);
	МенеджерОборудованияРМККлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение,
		Неопределено, ЭквайринговыйТерминал, ПараметрыОперации, , ПечатающееУстройство);
	#КонецУдаления 
	
КонецПроцедуры
	
&НаКлиенте
&Вместо("ОплатитьКартойЗавершение")
Процедура эв_ОплатитьКартойЗавершение(РезультатВыполнения, ДополнительныеПараметры)
    
    Если РезультатВыполнения.Свойство("ОписаниеОшибки")
        И СтрНайти(РезультатВыполнения.ОписаниеОшибки, "4353") > 0 Тогда
        
        РезультатВыполнения.Результат = Истина;
        
        // Не вызываем типовой обработчик ошибки: иначе откроется форма ошибки РМК
        // и сорвёт асинхронное открытие формы списания бонусов.
        СкрытьОкноОжиданияОплатыНаТерминалеПриНеобходимости();

        эвСберСпасибоКлиент.ЗапросВБонусныйПроцессинг(РезультатВыполнения, ДополнительныеПараметры);
        
    Иначе
   	 
     ПоказатьОкноОжиданияОплатыНаТерминале();
    
     ПродолжитьВызов(РезультатВыполнения, ДополнительныеПараметры);
       
    КонецЕсли;
    
    
КонецПроцедуры

&НаКлиенте
Процедура эв_ОплатитьКартойЗавершениеПослеСпасибо(РезультатВыполнения, ДополнительныеПараметры) Экспорт
    
	// Корректируем сумму оплаты рублями и бонусами.
	
	СуммаОперацииСпасибо = 0;
	Если РезультатВыполнения.Свойство("СуммаОперацииСпасибо") Тогда
		СуммаОперацииСпасибо = РезультатВыполнения.СуммаОперацииСпасибо;
	КонецЕсли;
	
	Если СуммаОперацииСпасибо > 0 Тогда
		
		// Добавляем строку оплаты
		СтрокаОплаты = Объект.Оплата[0];
		СтрокаОплаты.Сумма = РезультатВыполнения.СуммаОперации;
		СтрокаОплаты.ИдентификаторПлатежнойСистемы = СтрШаблон("%1/%2", РезультатВыполнения.НомерЧекаВСистемеСпасибо, РезультатВыполнения.RRN);
		
		Для каждого СтрОплаты Из ТаблицаОплатКартой Цикл
		    Если СтрОплаты.ВидОплаты = ДополнительныеПараметры.ВидОплаты Тогда
				СтрОплаты.Сумма = РезультатВыполнения.СуммаОперации;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		СуммаОплаченоБН = СуммаОплаченоБН - СуммаОперацииСпасибо;

		// Распределяем Спасибо как скидку
		эв_РаспределитьСуммуСпасибоПоТоварамНаСервере(СуммаОперацииСпасибо);
		
		// Не обнуляем суммы оплат — распределение выполняется уже после оплаты картой.
   	 	ПересчитатьИтогиТабличнойЧастиТовары(Ложь);

	КонецЕсли;
	
	// Возврат из эвСберСпасибоКлиент после регистрации/списания/оплаты остатка/подтверждения.
	ОплатитьКартойЗавершение(РезультатВыполнения, ДополнительныеПараметры);
    

КонецПроцедуры

&НаСервере
Процедура эв_РаспределитьСуммуСпасибоПоТоварамНаСервере(СуммаОперацииСпасибо) Экспорт
    
    эвСберСпасибоСервер.РаспределитьСуммуСпасибоПоТоварам(Объект, СуммаОперацииСпасибо);
    
КонецПроцедуры

&НаКлиенте
Процедура эв_ОткрытьФормуСписанияБонусовСпасибо(ПараметрыФормы, ПараметрыСписанияБонусов) Экспорт
    
    Оповещение = Новый ОписаниеОповещения(
        "эв_ПолучитьРазмерБонусовКСписаниюОкончание",
        ЭтотОбъект,
        ПараметрыСписанияБонусов);
    
    ОткрытьФорму(
        "ОбщаяФорма.эвСписаниеБонусовСпасибо",
        ПараметрыФормы,
        ЭтотОбъект,
        Новый УникальныйИдентификатор,
        ,
        ,
        Оповещение,
        РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
    
КонецПроцедуры

&НаКлиенте
Процедура эв_ПолучитьРазмерБонусовКСписаниюОкончание(Результат, ПараметрыСписанияБонусов) Экспорт
    
    эвСберСпасибоКлиент.ПолучитьРазмерБонусовКСписаниюОкончание(Результат, ПараметрыСписанияБонусов);
    
КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура эв_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	эвСберСпасибоСервер.эв_ДобавитьРеквизитыСпасибо(ЭтаФорма);
	
	ЭтаФорма.МаксимальныйПроцентОплатыБонусами = эвСберСпасибоСервер.эв_ПолучитьМаксПроцентОплатыБонусамиНаСервере(Объект.КассаККМ);

	эв_ДобавитьРеквизитыКошелькаПервостольника();
    эв_ОбновитьОборотыКошелькаПервостольникаНаСервере();
	
КонецПроцедуры

&НаКлиенте
&После("ПриОткрытии")
Процедура эв_ПриОткрытии(Отказ)
    
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
    
    эв_ПроверитьСвязьСПроцессингомСпасибо();
    ПодключитьОбработчикОжидания("эв_ПроверитьСвязьСПроцессингомСпасибо", 60);
    
    эв_ОбновитьОборотыКошелькаПервостольникаНаСервере();

КонецПроцедуры

&НаКлиенте
&После("ПриЗакрытии")
Процедура эв_ПриЗакрытии(ЗавершениеРаботы)
    
    Если ЗавершениеРаботы Тогда
        Возврат;
    КонецЕсли;
    
    ОтключитьОбработчикОжидания("эв_ПроверитьСвязьСПроцессингомСпасибо");
    
КонецПроцедуры

&НаКлиенте
Процедура эв_ПроверитьСвязьСПроцессингомСпасибо()
    
    эвСберСпасибоКлиент.ПроверитьСвязьСПроцессингомНаФормеРМК(ЭтотОбъект);
    
КонецПроцедуры

&НаКлиенте
&После("ПересчитатьИтогиТабличнойЧастиТовары")
Процедура эв_ПересчитатьИтогиТабличнойЧастиТовары(ОбнулитьСуммыОплат = Истина, ОбнулитьПодарочныеСертификаты = Истина,
		ПослеУдаленияСтроки = Ложь)
		
	СуммаБонусовПланФакт = Объект.Товары.Итог("СуммаСкидкиОплатыБонусом");
	
	Если СуммаБонусовПланФакт = 0 Тогда
		
		Для каждого Стр Из Объект.Товары Цикл
			Если Стр.эвНеВходитВАссортиментСберСпасибо Тогда
				Продолжить;	   	
			КонецЕсли;
			
			СуммаБонусовПланФакт = СуммаБонусовПланФакт + Окр(Стр.Сумма * ЭтаФорма.МаксимальныйПроцентОплатыБонусами / 100, 2);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЭтотОбъект["МаксСуммаОплатыСпасибо"] = СуммаБонусовПланФакт;
	
	эв_ПересчитатьБонусыПервостольникаПоКэшуСтавокКлиент();
	эв_ПересчитатьПоказателиКошелькаПервостольникаКлиент();
	
КонецПроцедуры

// При удалении всех товаров из чека типовой код обнуляет СуммаБезСкидки через СоздатьНовыйНабор,
// минуя ПересчитатьИтогиТабличнойЧастиТовары — поэтому «Спасибо» тоже пересчитываем здесь.
&НаСервере
&После("СоздатьНовыйНабор")
Процедура эв_СоздатьНовыйНабор(ПараметрыЗавершения = Неопределено)
    
    ЭтотОбъект["МаксСуммаОплатыСпасибо"] = 0;

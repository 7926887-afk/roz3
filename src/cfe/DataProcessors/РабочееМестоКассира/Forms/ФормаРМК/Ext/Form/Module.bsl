&НаСервереБезКонтекста
&Вместо("СтрокаТовараНаСервереБезКонтекста")
Функция эв_СтрокаТовараНаСервереБезКонтекста(Знач ТекущийВыбор, Знач ДополнительныеДанные)
    
    РезультатФункции = ПродолжитьВызов(ТекущийВыбор, ДополнительныеДанные);
    
    СтрокаТовара = РезультатФункции.СтрокаТовара;
    Если СтрокаТовара <> Неопределено
        И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовара, "Номенклатура")
        И ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
        
        СтрокаТовара.Вставить(
            "эвНеВходитВАссортиментСберСпасибо",
            эв_ПризнакНеВходитВАссортиментСберСпасибо(СтрокаТовара.Номенклатура));
			
		Характеристика = Неопределено;
        Если СтрокаТовара.Свойство("Характеристика") Тогда
            Характеристика = СтрокаТовара.Характеристика;
        КонецЕсли;
        
        СтрокаТовара.Вставить(
            "эв_Штрихкод",
            эв_ШтрихкодыВДокументах.ШтрихкодПоНоменклатуре(СтрокаТовара.Номенклатура, Характеристика));
        СтрокаТовара.Вставить(
            "эв_ШтрихкодКлюч",
            эв_ШтрихкодыВДокументах.КлючШтрихкода(СтрокаТовара.Номенклатура, Характеристика));
        
    КонецЕсли;
    
    Возврат РезультатФункции;
    
КонецФункции


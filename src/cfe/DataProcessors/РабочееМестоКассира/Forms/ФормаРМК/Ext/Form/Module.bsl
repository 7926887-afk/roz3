&НаСервере
Процедура эв_ДобавитьРеквизитИПолеНеВходитВАссортиментСберСпасибо()
    
    ИмяРеквизита = "эвНеВходитВАссортиментСберСпасибо";
    ИмяПоля = "ТоварыэвНеВходитВАссортиментСберСпасибо";
    
    Если Элементы.Найти(ИмяПоля) <> Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ДобавляемыеРеквизиты = Новый Массив;
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
        ИмяРеквизита,
        Новый ОписаниеТипов("Булево"),
        "Объект.Товары",
        НСтр("ru = 'Не входит в ассортимент СберСпасибо'")));
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);
    
    ТаблицаТовары = Элементы.Найти("Товары");
    Если ТаблицаТовары = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ПолеПризнака = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), ТаблицаТовары);
    ПолеПризнака.Вид = ВидПоляФормы.ПолеФлажка;
    ПолеПризнака.ПутьКДанным = "Объект.Товары." + ИмяРеквизита;
    ПолеПризнака.Видимость = Ложь;
    ПолеПризнака.ТолькоПросмотр = Истина;
    ПолеПризнака.ПропускатьПриВводе = Истина;
    
КонецПроцедуры

&НаСервере
Процедура эв_ЗаполнитьПризнакАссортиментаСберСпасибоВТоварах()
    
    Если Объект.Товары.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    НоменклатураТоваров = Новый Массив;
    Для Каждого СтрокаТовара Из Объект.Товары Цикл
        Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
            НоменклатураТоваров.Добавить(СтрокаТовара.Номенклатура);
        КонецЕсли;
    КонецЦикла;
    
    ПризнакиПоНоменклатуре = эв_ПризнакиНеВходитВАссортиментСберСпасибо(НоменклатураТоваров);
    
    Для Каждого СтрокаТовара Из Объект.Товары Цикл
        Признак = ПризнакиПоНоменклатуре.Получить(СтрокаТовара.Номенклатура);
        СтрокаТовара["эвНеВходитВАссортиментСберСпасибо"] = ?(Признак = Неопределено, Ложь, Признак);
    КонецЦикла;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция эв_ПризнакНеВходитВАссортиментСберСпасибо(Номенклатура)
    
    Если Не ЗначениеЗаполнено(Номенклатура) Тогда
        Возврат Ложь;
    КонецЕсли;
    
    ПризнакиПоНоменклатуре = эв_ПризнакиНеВходитВАссортиментСберСпасибо(
        ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Номенклатура));
    Признак = ПризнакиПоНоменклатуре.Получить(Номенклатура);
    
    Возврат ?(Признак = Неопределено, Ложь, Признак);
    
КонецФункции

&НаСервереБезКонтекста
Функция эв_ПризнакиНеВходитВАссортиментСберСпасибо(НоменклатураТоваров)
    
    ПризнакиПоНоменклатуре = Новый Соответствие;
    Если НоменклатураТоваров.Количество() = 0 Тогда
        Возврат ПризнакиПоНоменклатуре;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Номенклатура.Ссылка КАК Номенклатура,
    |   Номенклатура.эвНеВходитВАссортиментСберСпасибо КАК эвНеВходитВАссортиментСберСпасибо
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Ссылка В (&Номенклатура)";
    Запрос.УстановитьПараметр("Номенклатура", НоменклатураТоваров);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ПризнакиПоНоменклатуре.Вставить(Выборка.Номенклатура, Выборка.эвНеВходитВАссортиментСберСпасибо);
    КонецЦикла;
    
    Возврат ПризнакиПоНоменклатуре;
    
КонецФункции


&НаКлиенте
Процедура эв_ОбновитьНадписьRRN()
    
    НадписьRRN = Элементы.Найти("эвНадписьRRN");
    Если НадписьRRN = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ДанныеОплатыПродажи = эв_ДанныеОплатыЧекаПродажи();
    Если ЗначениеЗаполнено(ДанныеОплатыПродажи.ИдентификаторПлатежнойСистемы) Тогда 
   	 
   	 Позиция = Найти(ДанныеОплатыПродажи.ИдентификаторПлатежнойСистемы, "/");
   	 Если Позиция > 0 Тогда
   		 RRN = Сред(ДанныеОплатыПродажи.ИдентификаторПлатежнойСистемы, Позиция + 1);
   	 Иначе
   		 RRN = ""; 
   	 КонецЕсли;
   	 
   	 НадписьRRN.Заголовок = СтрШаблон("RRN: %1", RRN);
   	 НадписьRRN.Видимость = Истина;
    Иначе
   	 НадписьRRN.Заголовок = "";
   	 НадписьRRN.Видимость = Ложь;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция эв_ДанныеОплатыЧекаПродажи()
    
    Результат = эвСберСпасибоСервер.ДанныеОплатыЧекаПродажиДляСпасибо(ЧекККМПродажа);
    // Сумма бонусов — из текущего состава чека: при частичном возврате
    // РМК пересчитывает СуммаСкидкиОплатыБонусом, а оплата чека продажи остаётся полной.
    Результат.СуммаБонусовВозврата = Объект.Товары.Итог("СуммаСкидкиОплатыБонусом");
    
    Возврат Результат;
    
КонецФункции

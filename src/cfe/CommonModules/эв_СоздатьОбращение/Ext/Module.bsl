
#Область ПрограммныйИнтерфейс

Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	Если НастройкиФормы.Свойство("ЭтоФормаОбъекта") И Не НастройкиФормы.ЭтоФормаОбъекта Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Использование", Метаданные.Обработки.эв_СоздатьОбращение) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыИсточников = Неопределено;
	НастройкиФормы.Свойство("ТипыИсточников", ТипыИсточников);
	Если ТипыИсточников = Неопределено Или ТипыИсточников.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Команда = Команды.Добавить();
	Команда.Вид = "КоманднаяПанель";
	Команда.Идентификатор = "эв_СоздатьОбращение";
	Команда.Представление = НСтр("ru = 'Создать обращение'");
	Команда.Картинка = БиблиотекаКартинок.СообщениеВТехПоддержку;
	Команда.ОтображениеКнопки = ОтображениеКнопки.Картинка;
	Команда.Назначение = "ДляОбъекта";
	Команда.РежимЗаписи = "ЗаписыватьТолькоНовые";
	Команда.МножественныйВыбор = Ложь;
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.ТипПараметра = Новый ОписаниеТипов(ТипыИсточников);
	Команда.Обработчик = "эв_СоздатьОбращениеКлиент.СоздатьОбращение";
	Команда.Порядок = 50;
	
КонецПроцедуры

#КонецОбласти

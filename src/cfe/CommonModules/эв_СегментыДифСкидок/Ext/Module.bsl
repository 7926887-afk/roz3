#Область ПрограммныйИнтерфейс

// Обрабатывает очередь установок цен и записывает номенклатуру
// в сегмент наценки регистра СоставСегментаНоменклатуры.
//
Процедура ОбновитьСегментыДифСкидок() Экспорт
	
	ДанныеМагазина = ДанныеТекущегоМагазина();
	Если ДанныеМагазина = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Сегменты = СегментыДифСкидок();
	Если Сегменты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидЦеныЗакупочная = Справочники.ВидыЦен.НайтиПоНаименованию("Основной тип цен закупки", Истина);
	Если Не ЗначениеЗаполнено(ВидЦеныЗакупочная) Тогда
		ЗаписатьОшибкуСегментов("Не найден вид цен ""Основной тип цен закупки"".");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОчереди();
	Запрос.УстановитьПараметр("ВидЦеныЗакупочная", ВидЦеныЗакупочная);
	Запрос.УстановитьПараметр("ВидЦеныПродажи", ДанныеМагазина.ВидЦеныПродажи);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДатаНачДня", НачалоДня(ТекущаяДатаСеанса()));
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	СегментыГорода = СегментыГорода(ДанныеМагазина.ИНН, Сегменты);
	Выборка = РезультатЗапроса[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ЦенаЗ = 0 Или Выборка.ЦенаР = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Наценка = Окр((Выборка.ЦенаР - Выборка.ЦенаЗ) / Выборка.ЦенаЗ * 100, 2);
		Сегмент = СегментПоНаценке(ДанныеМагазина.ИНН, Наценка, Сегменты);
		Если Сегмент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗаписатьСоставСегмента(Сегмент, СегментыГорода, Выборка.Номенклатура, Выборка.Характеристика);
		Исключение
			ЗаписатьОшибкуСегментов(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Выборка = РезультатЗапроса[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.эв_ОчередьСегментовДифСкидок.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		Попытка
			МенеджерЗаписи.Записать();
		Исключение
			ЗаписатьОшибкуСегментов(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Ставит проведенную установку цен в очередь сегментов. Повторное проведение сбрасывает признак обработки.
//
// Параметры:
//  УстановкаЦен - ДокументСсылка.УстановкаЦенНоменклатуры
//
Процедура ПоставитьУстановкуЦенВОчередь(УстановкаЦен) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.эв_ОчередьСегментовДифСкидок.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УстановкаЦен = УстановкаЦен;
	МенеджерЗаписи.Обработано = Ложь;
	МенеджерЗаписи.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Удаляет установку цен из очереди, если проведение снято до обработки.
//
// Параметры:
//  УстановкаЦен - ДокументСсылка.УстановкаЦенНоменклатуры
//
Процедура УдалитьУстановкуЦенИзОчереди(УстановкаЦен) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.эв_ОчередьСегментовДифСкидок.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УстановкаЦен = УстановкаЦен;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеТекущегоМагазина()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтруктурныеЕдиницы.Организация.ИНН КАК ИНН,
	|	СтруктурныеЕдиницы.РозничныйВидЦен КАК ВидЦеныПродажи
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|ГДЕ
	|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
	|	И НЕ СтруктурныеЕдиницы.ЭтоГруппа
	|	И СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Розница)
	|	И СтруктурныеЕдиницы.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И СтруктурныеЕдиницы.РозничныйВидЦен <> ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|	И СтруктурныеЕдиницы.Организация.ИНН <> """"";
	
	ТаблицаМагазинов = Запрос.Выполнить().Выгрузить();
	Если ТаблицаМагазинов.Количество() = 0 Тогда
		ЗаписатьОшибкуСегментов("Не найдена розничная структурная единица с организацией и розничным видом цен.");
		Возврат Неопределено;
	КонецЕсли;
	
	ИНН = СокрЛП(ТаблицаМагазинов[0].ИНН);
	ВидЦеныПродажи = ТаблицаМагазинов[0].ВидЦеныПродажи;
	Для Каждого СтрокаМагазина Из ТаблицаМагазинов Цикл
		Если СокрЛП(СтрокаМагазина.ИНН) <> ИНН
			Или СтрокаМагазина.ВидЦеныПродажи <> ВидЦеныПродажи Тогда
			ЗаписатьОшибкуСегментов(
				"Несколько розничных структурных единиц с разным ИНН или розничным видом цен. Обработка очереди остановлена.");
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("ИНН, ВидЦеныПродажи", ИНН, ВидЦеныПродажи);
	
КонецФункции

Функция СегментыДифСкидок()
	
	Сегмент15_25Москва = Справочники.СегментыНоменклатуры.НайтиПоНаименованию("Сегмент 15-25% наценки", Истина);
	Сегмент25_60Москва = Справочники.СегментыНоменклатуры.НайтиПоНаименованию("Сегмент 25-60% наценки", Истина);
	Сегмент60Москва = Справочники.СегментыНоменклатуры.НайтиПоНаименованию("Сегмент >60% наценки", Истина);
	Сегмент15_80Питер = Справочники.СегментыНоменклатуры.НайтиПоНаименованию("Сегмент 15-80% наценки", Истина);
	Сегмент80Питер = Справочники.СегментыНоменклатуры.НайтиПоНаименованию("Сегмент >80% наценки", Истина);
	
	Если Не ЗначениеЗаполнено(Сегмент15_25Москва)
		Или Не ЗначениеЗаполнено(Сегмент25_60Москва)
		Или Не ЗначениеЗаполнено(Сегмент60Москва)
		Или Не ЗначениеЗаполнено(Сегмент15_80Питер)
		Или Не ЗначениеЗаполнено(Сегмент80Питер) Тогда
		ЗаписатьОшибкуСегментов("Не найден один из сегментов наценки.");
		Возврат Неопределено;
	КонецЕсли;
	
	СегментыМосква = Новый Массив;
	СегментыМосква.Добавить(Сегмент15_25Москва);
	СегментыМосква.Добавить(Сегмент25_60Москва);
	СегментыМосква.Добавить(Сегмент60Москва);
	
	СегментыПитер = Новый Массив;
	СегментыПитер.Добавить(Сегмент15_80Питер);
	СегментыПитер.Добавить(Сегмент80Питер);
	
	Сегменты = Новый Структура;
	Сегменты.Вставить("Сегмент15_25Москва", Сегмент15_25Москва);
	Сегменты.Вставить("Сегмент25_60Москва", Сегмент25_60Москва);
	Сегменты.Вставить("Сегмент60Москва", Сегмент60Москва);
	Сегменты.Вставить("Сегмент15_80Питер", Сегмент15_80Питер);
	Сегменты.Вставить("Сегмент80Питер", Сегмент80Питер);
	Сегменты.Вставить("СегментыМосква", СегментыМосква);
	Сегменты.Вставить("СегментыПитер", СегментыПитер);
	
	Возврат Сегменты;
	
КонецФункции

Функция СегментыГорода(ИНН, Сегменты)
	
	Если ИНН = "7704729709" Тогда
		Возврат Сегменты.СегментыМосква;
	ИначеЕсли ИНН = "7840054942" Тогда
		Возврат Сегменты.СегментыПитер;
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

Функция СегментПоНаценке(ИНН, Наценка, Сегменты)
	
	Сегмент = Неопределено;
	
	Если ИНН = "7704729709" И Наценка >= 15 И Наценка < 25 Тогда
		Сегмент = Сегменты.Сегмент15_25Москва;
	ИначеЕсли ИНН = "7704729709" И Наценка >= 25 И Наценка < 60 Тогда
		Сегмент = Сегменты.Сегмент25_60Москва;
	ИначеЕсли ИНН = "7704729709" И Наценка >= 60 Тогда
		Сегмент = Сегменты.Сегмент60Москва;
	ИначеЕсли ИНН = "7840054942" И Наценка >= 15 И Наценка < 80 Тогда
		Сегмент = Сегменты.Сегмент15_80Питер;
	ИначеЕсли ИНН = "7840054942" И Наценка >= 80 Тогда
		Сегмент = Сегменты.Сегмент80Питер;
	КонецЕсли;
	
	Возврат Сегмент;
	
КонецФункции

Процедура ЗаписатьСоставСегмента(Сегмент, СегментыГорода, Номенклатура, Характеристика)
	
	Для Каждого СегментГорода Из СегментыГорода Цикл
		Если СегментГорода = Сегмент Тогда
			Продолжить;
		КонецЕсли;
		УдалитьРучноеВхождение(СегментГорода, Номенклатура, Характеристика);
	КонецЦикла;
	
	Если НоменклатураВСегменте(Сегмент, Номенклатура, Характеристика) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = НаборСоставаСегмента(Сегмент, Номенклатура, Характеристика);
	НаборЗаписей.Отбор.СпособДобавления.Установить(Перечисления.СпособыДобавленияВСегмент.Вручную);
	Запись = НаборЗаписей.Добавить();
	Запись.Сегмент = Сегмент;
	Запись.СпособДобавления = Перечисления.СпособыДобавленияВСегмент.Вручную;
	Запись.Номенклатура = Номенклатура;
	Запись.Характеристика = Характеристика;
	Запись.СегментДляСписка = ПланыВидовХарактеристик.РеквизитыДляСписка.СегментыНоменклатуры;
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Процедура УдалитьРучноеВхождение(Сегмент, Номенклатура, Характеристика)
	
	НаборЗаписей = НаборСоставаСегмента(Сегмент, Номенклатура, Характеристика);
	НаборЗаписей.Отбор.СпособДобавления.Установить(Перечисления.СпособыДобавленияВСегмент.Вручную);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Функция НоменклатураВСегменте(Сегмент, Номенклатура, Характеристика)
	
	НаборЗаписей = НаборСоставаСегмента(Сегмент, Номенклатура, Характеристика);
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей.Количество() > 0;
	
КонецФункции

Функция НаборСоставаСегмента(Сегмент, Номенклатура, Характеристика)
	
	НаборЗаписей = РегистрыСведений.СоставСегментаНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Сегмент.Установить(Сегмент);
	НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
	НаборЗаписей.Отбор.Характеристика.Установить(Характеристика);
	Возврат НаборЗаписей;
	
КонецФункции

Функция ТекстЗапросаОчереди()
	
	Возврат
	"ВЫБРАТЬ
	|	эв_ОчередьСегментовДифСкидок.УстановкаЦен КАК УстановкаЦен
	|ПОМЕСТИТЬ ВТ_УЦ
	|ИЗ
	|	РегистрСведений.эв_ОчередьСегментовДифСкидок КАК эв_ОчередьСегментовДифСкидок
	|ГДЕ
	|	эв_ОчередьСегментовДифСкидок.Обработано = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстановкаЦенНоменклатуры.Ссылка КАК УстановкаЦен
	|ПОМЕСТИТЬ ВТ_УЦ_за_день
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УЦ КАК ВТ_УЦ
	|		ПО ВТ_УЦ.УстановкаЦен = УстановкаЦенНоменклатуры.Ссылка
	|ГДЕ
	|	ВТ_УЦ.УстановкаЦен ЕСТЬ NULL
	|	И УстановкаЦенНоменклатуры.Дата > &ДатаНачДня
	|	И УстановкаЦенНоменклатуры.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_УЦ.УстановкаЦен
	|ИЗ
	|	ВТ_УЦ КАК ВТ_УЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстановкаЦенНоменклатурыЗапасы.Номенклатура КАК Номенклатура,
	|	УстановкаЦенНоменклатурыЗапасы.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	ВТ_УЦ_за_день КАК ВТ_УЦ_за_день
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УстановкаЦенНоменклатуры.Запасы КАК УстановкаЦенНоменклатурыЗапасы
	|		ПО ВТ_УЦ_за_день.УстановкаЦен = УстановкаЦенНоменклатурыЗапасы.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УстановкаЦенНоменклатурыЗапасы.Характеристика,
	|	УстановкаЦенНоменклатурыЗапасы.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.Характеристика КАК Характеристика,
	|	ЦеныЗакупки.Цена КАК ЦенаЗ,
	|	ЦеныПродажи.Цена КАК ЦенаР
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&Период,
	|				ВидЦен = &ВидЦеныЗакупочная
	|					И (Номенклатура, Характеристика) В
	|						(ВЫБРАТЬ
	|							ВТ_Товары.Номенклатура КАК Номенклатура,
	|							ВТ_Товары.Характеристика КАК Характеристика
	|						ИЗ
	|							ВТ_Товары КАК ВТ_Товары)) КАК ЦеныЗакупки
	|		ПО ВТ_Товары.Номенклатура = ЦеныЗакупки.Номенклатура
	|			И ВТ_Товары.Характеристика = ЦеныЗакупки.Характеристика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&Период,
	|				ВидЦен = &ВидЦеныПродажи
	|					И (Номенклатура, Характеристика) В
	|						(ВЫБРАТЬ
	|							ВТ_Товары.Номенклатура КАК Номенклатура,
	|							ВТ_Товары.Характеристика КАК Характеристика
	|						ИЗ
	|							ВТ_Товары КАК ВТ_Товары)) КАК ЦеныПродажи
	|		ПО ВТ_Товары.Номенклатура = ЦеныПродажи.Номенклатура
	|			И ВТ_Товары.Характеристика = ЦеныПродажи.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_УЦ_за_день.УстановкаЦен КАК УстановкаЦен,
	|	ИСТИНА КАК Обработано
	|ИЗ
	|	ВТ_УЦ_за_день КАК ВТ_УЦ_за_день";
	
КонецФункции

Процедура ЗаписатьОшибкуСегментов(Комментарий)
	
	ЗаписьЖурналаРегистрации(
		"Сегменты диф скидок",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Комментарий);
	
КонецПроцедуры

#КонецОбласти

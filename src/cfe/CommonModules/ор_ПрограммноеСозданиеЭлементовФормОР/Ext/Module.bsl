
#Область ПрограммныйИнтерфейс

&После("ОбработатьПрограммноеСозданиеЭлементовФормы")
Процедура эв_ОбработатьПрограммноеСозданиеЭлементовФормы(ИмяПроцедуры, Форма, СписокОшибок)
    
    Если ИмяПроцедуры = "СпрНоменклатураФормаЭлемента" Тогда
        эв_ВывестиРеквизитНеВходитВАссортиментСберСпасибо(Форма);
    ИначеЕсли ИмяПроцедуры = "ДокЧекККМФормаДокумента" Тогда
        эв_ВывестиРеквизитыПервостольникаВЗапасы(Форма);
		эв_ШтрихкодыВДокументах.ДобавитьРеквизитШтрихкодНаФорму(Форма, "Запасы", "Объект.Запасы", "ЗапасыПартия");
	ИначеЕсли ИмяПроцедуры = "ДокЗаказПокупателяФормаДокумента" Тогда
		эв_ШтрихкодыВДокументах.ДобавитьРеквизитШтрихкодНаФорму(Форма, "Запасы", "Объект.Запасы", "ЗапасыПартия");  
		эв_ВывестиРеквизитыИнтернетЗаказа(Форма);
 		эв_ВывестиГиперссылкуИсходногоПакета(Форма);
 	    эв_ВариантЗавершенияСписком(Форма);
	ИначеЕсли ИмяПроцедуры = "ОбрРабочееМестоКассираФормаРМК" Тогда
		эв_ШтрихкодыВДокументах.ДобавитьРеквизитШтрихкодНаФорму(Форма, "Товары", "Объект.Товары");
	ИначеЕсли ИмяПроцедуры = "СпрВидыЗаказовПокупателейФормаЭлемента" Тогда
		эв_ВывестиРеквизитПортал(Форма); 
    КонецЕсли;
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура эв_ВывестиРеквизитНеВходитВАссортиментСберСпасибо(Форма)
    
    ИмяЭлемента = "эвНеВходитВАссортиментСберСпасибо";
    
    Если Форма.Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, ИмяЭлемента) Тогда
        Возврат;
    КонецЕсли;
    
    РодительскаяГруппа = Форма.Элементы.Найти("ГруппаФлажкиЛекСредства");
    Если РодительскаяГруппа = Неопределено Тогда
        РодительскаяГруппа = Форма.Элементы.Найти("ГруппаОсновноеЛеваяКолонка");
    КонецЕсли;
    Если РодительскаяГруппа = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ЭлементПеред = Форма.Элементы.Найти("ГруппаНаркотическоеСредствоЯд");
    
    НовыйЭлемент = Форма.Элементы.Вставить(
        ИмяЭлемента,
        Тип("ПолеФормы"),
        РодительскаяГруппа,
        ЭлементПеред);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
    НовыйЭлемент.ПутьКДанным = "Объект." + ИмяЭлемента;
    НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
    НовыйЭлемент.Заголовок = НСтр("ru = 'Не входит в ассортимент СберСпасибо'");
    
КонецПроцедуры

Процедура эв_ВывестиРеквизитыПервостольникаВЗапасы(Форма)
    
    ТаблицаЗапасы = Форма.Элементы.Найти("Запасы");
    Если ТаблицаЗапасы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    эв_ДобавитьПолеРеквизитаЗапасы(Форма, ТаблицаЗапасы, "эв_ИБ", НСтр("ru = 'Индивидуальный бонус'"));
    эв_ДобавитьПолеРеквизитаЗапасы(Форма, ТаблицаЗапасы, "эв_КБ", НСтр("ru = 'Коллективный бонус'"));
    
КонецПроцедуры

Процедура эв_ДобавитьПолеРеквизитаЗапасы(Форма, ТаблицаЗапасы, ИмяРеквизита, ЗаголовокПоля)
    
    ИмяЭлемента = "Запасы" + ИмяРеквизита;
    
    Если Форма.Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ТаблицаЗапасы);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.Запасы." + ИмяРеквизита;
    НовыйЭлемент.Заголовок = ЗаголовокПоля;
    НовыйЭлемент.Ширина = 10;
    НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
    
КонецПроцедуры

Процедура эв_ВывестиРеквизитыИнтернетЗаказа(Форма)

	Форма.Элементы.Итоги.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	КрупныйШрифт1 = Новый Шрифт(Форма.Элементы.ИтогВсего.Шрифт, , , , , , , 140);
	КрупныйШрифт  = Новый Шрифт(Форма.Элементы.ИтогВсего.Шрифт, , , , , , , 170);
	
	Форма.Элементы.Скидки.Видимость        = Ложь;
	Форма.Элементы.ИтогВсего.Видимость     = Ложь;
	Форма.Элементы.ИтогСуммаНДС.Видимость  = Ложь;
	Форма.Элементы.ГруппаСсылки.Видимость  = Ложь;
	Форма.Элементы.ГруппаСОтступом.Видимость  = Ложь;
	Форма.Элементы.ПредоплатаИтогСуммаРасчетов.Видимость  = Ложь;
	Форма.Элементы.Договор.Видимость             = Ложь;
	Форма.Элементы.ДоговорИнформация.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Форма.Элементы.ЗапасыГруппаСерииНоменклатуры.Видимость             = Ложь;
	Форма.Элементы.ЗапасыСуммаСкидкиОплатыБонусом.Видимость             = Ложь;
	
	
	Форма.Элементы.Комментарий.МногострочныйРежим = Ложь;
	Форма.Элементы.Комментарий.Высота = 1;
	
	эв_ВывестиСуммуОплатыНаСайте(Форма, КрупныйШрифт);
	
	Элемент = Форма.Элементы.Добавить("эв_ИтогВсего", Тип("ПолеФормы"), Форма.Элементы.Итоги);
	Элемент.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент.ПутьКДанным = "ИтогВсего";
	Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;  
	Элемент.Шрифт = КрупныйШрифт;
	Элемент.Заголовок = "Всего";

	Элемент = Форма.Элементы.Добавить("эв_ИтогСуммаНДС", Тип("ПолеФормы"), Форма.Элементы.Итоги);
	Элемент.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент.ПутьКДанным = "ИтогСуммаНДС";
	Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;  
	Элемент.Шрифт = КрупныйШрифт;
	Элемент.Заголовок = "НДС";

	Элемент = Форма.Элементы.Добавить("эв_КонтактыКлиентаТелефон", Тип("ПолеФормы"), Форма.Элементы.ДоговорИнформация);
	Элемент.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент.ПутьКДанным = "Объект.КонтактныйТелефон";
	Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;  
	Элемент.Шрифт = КрупныйШрифт1;
	Элемент.РастягиватьПоГоризонтали = Ложь;

	Элемент = Форма.Элементы.Добавить("эв_КонтактыКлиентаПочта", Тип("ПолеФормы"), Форма.Элементы.ДоговорИнформация);
	Элемент.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент.ПутьКДанным = "Объект.ПочтаПолучателя";
	Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;  
	Элемент.Шрифт = КрупныйШрифт1;
	Элемент.РастягиватьПоГоризонтали = Ложь;
	

КонецПроцедуры

Процедура эв_ВывестиСуммуОплатыНаСайте(Форма, ШрифтПоля)
	
	ИмяРеквизита = "эв_СуммаОплатыНаСайте";
	Если Не эв_ЕстьРеквизитФормы(Форма, ИмяРеквизита) Тогда
		ДобавляемыеРеквизиты = Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			ИмяРеквизита,
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)),
			,
			НСтр("ru = 'Оплачено на сайте'")));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	эв_ЗаполнитьСуммуОплатыНаСайте(Форма);
	
	ИмяЭлемента = "эв_ИтогСуммаРасчетов";
	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если Элемент = Неопределено Тогда
		Элемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Форма.Элементы.Итоги);
		Элемент.Вид = ВидПоляФормы.ПолеНадписи;
		Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		Элемент.Шрифт = ШрифтПоля;
		Элемент.Заголовок = НСтр("ru = 'Оплачено на сайте'");
		Элемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	КонецЕсли;
	Элемент.ПутьКДанным = ИмяРеквизита;
	
КонецПроцедуры

Процедура эв_ЗаполнитьСуммуОплатыНаСайте(Форма) Экспорт
	
	Если Не эв_ЕстьРеквизитФормы(Форма, "эв_СуммаОплатыНаСайте") Тогда
		Возврат;
	КонецЕсли;
	
	Форма.эв_СуммаОплатыНаСайте = эв_СуммаОплатыЗаказа(Форма.Объект.Ссылка);
	
КонецПроцедуры

Функция эв_СуммаОплатыЗаказа(Заказ)
	
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат 0;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ФактОплатыЗаказов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.СчетНаОплату = Заказ;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат МенеджерЗаписи.СуммаАванса + МенеджерЗаписи.СуммаОплаты;
	
КонецФункции

Функция эв_ЕстьРеквизитФормы(Форма, ИмяРеквизита)
	
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты() Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура эв_ВывестиРеквизитПортал(Форма)
	
	ИмяЭлемента = "Портал";
	
	Если Форма.Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементПеред = Форма.Элементы.Найти("Страницы");
	НовыйЭлемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), , ЭлементПеред);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.Портал";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	
КонецПроцедуры

Процедура эв_ВывестиГиперссылкуИсходногоПакета(Форма)
    
    ИмяКоманды = "эв_ПоказатьИсходныйПакет";
    Если Форма.Элементы.Найти(ИмяКоманды) <> Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    СтраницаДополнительно = Форма.Элементы.Найти("СтраницаДополнительно");
    Если СтраницаДополнительно = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Команда = Форма.Команды.Добавить(ИмяКоманды);
    Команда.Заголовок = НСтр("ru = 'Исходный пакет'");
    Команда.Действие = ИмяКоманды;
    
    Группа = Форма.Элементы.Добавить("эв_ГруппаИсходныйПакет", Тип("ГруппаФормы"), СтраницаДополнительно);
    Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
    Группа.ОтображатьЗаголовок = Ложь;
    Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
    Группа.РастягиватьПоВертикали = Истина;
    
    Отступ = Форма.Элементы.Добавить("эв_ОтступИсходныйПакет", Тип("ДекорацияФормы"), Группа);
    Отступ.Вид = ВидДекорацииФормы.Надпись;
    Отступ.Заголовок = "";
    Отступ.РастягиватьПоВертикали = Истина;
    
    Гиперссылка = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Группа);
    Гиперссылка.Вид = ВидКнопкиФормы.Гиперссылка;
    Гиперссылка.ИмяКоманды = ИмяКоманды;
    
КонецПроцедуры

Процедура эв_ВариантЗавершенияСписком(Форма)
	
	эв_ДобавитьПолеВыбораВместоТумблера(
		Форма,
		"ВариантЗавершения",
		"эв_ВариантЗавершения",
		"ВариантЗавершенияПриИзменении");
	эв_ДобавитьПолеВыбораВместоТумблера(
		Форма,
		"ВариантЗавершенияПраваяПанель",
		"эв_ВариантЗавершенияПраваяПанель",
		"ВариантЗавершенияПраваяПанельПриИзменении");
	
КонецПроцедуры

Процедура эв_ДобавитьПолеВыбораВместоТумблера(Форма, ИмяТумблера, ИмяПоля, ИмяОбработчика)
	
	Тумблер = Форма.Элементы.Найти(ИмяТумблера);
	Если Тумблер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеВыбора = Форма.Элементы.Найти(ИмяПоля);
	Если ПолеВыбора = Неопределено Тогда
		
		ПолеВыбора = Форма.Элементы.Вставить(ИмяПоля, Тип("ПолеФормы"), Тумблер.Родитель, Тумблер);
		ПолеВыбора.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВыбора.ПутьКДанным = "Объект.ВариантЗавершения";
		ПолеВыбора.Заголовок = Тумблер.Заголовок;
		ПолеВыбора.ПоложениеЗаголовка = Тумблер.ПоложениеЗаголовка;
		//ПолеВыбора.РежимВыбораИзСписка = Истина;
		//ПолеВыбора.КнопкаВыпадающегоСписка = Истина;
		ПолеВыбора.КнопкаВыбора = Истина;
		ПолеВыбора.РастягиватьПоГоризонтали = Ложь;
		ПолеВыбора.УстановитьДействие("ПриИзменении", ИмяОбработчика);
		
		//Для Каждого ЭлементСписка Из Тумблер.СписокВыбора Цикл
		//	ПолеВыбора.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		//КонецЦикла;
		
	КонецЕсли;
	
	ПолеВыбора.Видимость = Тумблер.Видимость;
	Тумблер.Видимость = Ложь;
	
КонецПроцедуры

#КонецОбласти  




&Вместо("ДоступныеРасширенияФормата")
Функция эв_ДоступныеРасширенияФормата(ВерсияФорматаОбмена)
	
	Результат = ПродолжитьВызов(ВерсияФорматаОбмена);
	ПространствоИменСкидок = "http://evalar.ru/edi/EnterpriseData/СкидкиНаценки";
	Если Результат.Получить(ПространствоИменСкидок) <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ПространствоИменФормата = "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/" + ВерсияФорматаОбмена;
	Если ФабрикаXDTO.Тип(ПространствоИменФормата, "Справочник.СкидкиНаценки") <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить(ПространствоИменСкидок, СтрШаблон("ext%1", XMLСтрока(Результат.Количество() + 1)));
	Возврат Результат;
	
КонецФункции

&После("ЗаполнитьПоддерживаемыеОбъектыXDTO")
Процедура эв_ЗаполнитьПоддерживаемыеОбъектыXDTO(КомпонентыОбмена)
	
	Если КомпонентыОбмена.ПоддерживаемыеОбъектыXDTO.Найти("Справочник.СкидкиНаценки") = Неопределено Тогда
		КомпонентыОбмена.ПоддерживаемыеОбъектыXDTO.Добавить("Справочник.СкидкиНаценки");
	КонецЕсли;
	
КонецПроцедуры

	КонецЕсли;
	Если ДанныеРегистров.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_РегистрыЗаказа", ДанныеРегистров);
	КонецЕсли;
	
КонецПроцедуры

&После("ПКО_Документ_ЗаказПокупателя_Получение_ПередЗаписьюПолученныхДанных")
Процедура эв_ПКО_Документ_ЗаказПокупателя_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектЗаписи = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если ОбъектЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидЗаказа = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ВидЗаказа", ВидЗаказа) И ЗначениеЗаполнено(ВидЗаказа) Тогда
		ОбъектЗаписи.ВидЗаказа = ВидЗаказа;
	КонецЕсли;
	
	СостояниеЗаказа = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_СостояниеЗаказа", СостояниеЗаказа) И ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		ОбъектЗаписи.СостояниеЗаказа = СостояниеЗаказа;
	КонецЕсли;
	
	ЗавершенУспешно = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ЗавершенУспешно", ЗавершенУспешно) Тогда
		Если ЗавершенУспешно = Истина Тогда
			ОбъектЗаписи.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
		Иначе
			ОбъектЗаписи.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен;
		КонецЕсли;
	КонецЕсли;
	
	НоменклатураДоставки = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_НоменклатураДоставки", НоменклатураДоставки)
		И ЗначениеЗаполнено(НоменклатураДоставки) Тогда
		ОбъектЗаписи.НоменклатураДоставки = НоменклатураДоставки;
	КонецЕсли;
	
	СтавкаНДСДоставки = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_СтавкаНДСДоставки", СтавкаНДСДоставки)
		И ЗначениеЗаполнено(СтавкаНДСДоставки) Тогда
		ОбъектЗаписи.СтавкаНДСДоставки = СтавкаНДСДоставки;
	КонецЕсли;
	
	ПричинаОтмены = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ПричинаОтмены", ПричинаОтмены)
		И ЗначениеЗаполнено(ПричинаОтмены) Тогда
		ОбъектЗаписи.ПричинаОтмены = ПричинаОтмены;
	КонецЕсли;
	
	ВариантЗавершения = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ВариантЗавершения", ВариантЗавершения)
		И ЗначениеЗаполнено(ВариантЗавершения) Тогда
		ОбъектЗаписи.ВариантЗавершения = ВариантЗавершения;
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("Заметки,КонтактноеЛицо,КонтактныйТелефон,ПочтаПолучателя,АдресСайта", ",") Цикл
		ЗначениеРеквизита = Неопределено;
		Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_" + ИмяРеквизита, ЗначениеРеквизита)
			И ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ОбъектЗаписи[ИмяРеквизита] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("ДатаОтгрузки,ОжидаемаяДатаВручения,ВремяДоставкиС,ВремяДоставкиПо", ",") Цикл
		ЗначениеРеквизита = Неопределено;
		Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_" + ИмяРеквизита, ЗначениеРеквизита)
			И ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ОбъектЗаписи[ИмяРеквизита] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	СуммаНДСДоставки = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_СуммаНДСДоставки", СуммаНДСДоставки) Тогда
		ОбъектЗаписи.СуммаНДСДоставки = эв_ЧислоИзЗначения(СуммаНДСДоставки);
	КонецЕсли;
	
	СтрокиЗапасов = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_СтрокиЗапасов", СтрокиЗапасов) Тогда
		эв_ПрименитьСтрокиЗапасов(ОбъектЗаписи, СтрокиЗапасов);
	КонецЕсли;
	эв_ПрименитьКоличествоЗапасов(ОбъектЗаписи);
	
	ОтмененныеЗапасы = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ОтмененныеЗапасы", ОтмененныеЗапасы) Тогда
		эв_ЗаполнитьОтмененныеЗапасы(ОбъектЗаписи, ОтмененныеЗапасы);
	КонецЕсли;
	
КонецПроцедуры

&После("ПКО_Документ_ОперацияПоПлатежнойКарте_Отправка_ПриОтправкеДанных")
Процедура эв_ПКО_Документ_ОперацияПоПлатежнойКарте_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	

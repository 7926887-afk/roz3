Процедура эв_ВыгрузитьВидыЦенУстановкиЦен(КомпонентыОбмена, ТаблицаТоваров)
	
	ВыгружаемыеВидыЦен = Новый Массив;
	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл
		ВидЦен = СтрокаТовары.ТипЦен;
		Если Не ЗначениеЗаполнено(ВидЦен) Или ВыгружаемыеВидыЦен.Найти(ВидЦен) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВыгружаемыеВидыЦен.Добавить(ВидЦен);
		Если КомпонентыОбмена.ВыгруженныеОбъекты.Найти(ВидЦен) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ВидЦен);
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ЗаполнитьВидыЦенСтрокУстановкиЦен(ПолученныеДанные, Шапка)
	
	ВидыЦенСтрок = эв_МассивДанных(эв_ЗначениеСвойства(Шапка, "ВидыЦенСтрок"));
	Если ВидыЦенСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = 0;
	Для Каждого СтрокаЗапасы Из ПолученныеДанные.Запасы Цикл
		Если Индекс >= ВидыЦенСтрок.Количество() Тогда
			Прервать;
		КонецЕсли;
		ВидЦены = эв_ВидЦенИзОписания(ВидыЦенСтрок[Индекс]);
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			СтрокаЗапасы.ВидЦены = ВидЦены;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ВидЦенИзОписания(Описание)
	
	Ссылка = эв_СсылкаИзОписания(Описание);
	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("СправочникСсылка.ВидыЦен") Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Наименование = эв_СтрокаСвойства(Описание, "Наименование");
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.ВидыЦен.НайтиПоНаименованию(Наименование, Истина);
	
КонецФункции

Процедура эв_ЗарегистрироватьЗаказПокупателяКОбменуУниверсальный(Источник, Отказ, РежимЗаписи) Экспорт
	
	Если Отказ
		Или Источник.ОбменДанными.Загрузка
		Или ТипЗнч(Источник) <> Тип("ДокументОбъект.ЗаказПокупателя")
		Или Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение И Не Источник.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	УзлыОбмена = эв_УзлыОбменаУниверсальный();
	Отправитель = Источник.ОбменДанными.Отправитель;
	
	// Новый заказ ещё не записан: ссылки в базе нет, ЗарегистрироватьИзменения по ней недоступен.
	// Узлы кладём в получатели — платформа зарегистрирует изменение при записи документа.
	Если СокрЛП(Источник.ВерсияДанных)= "" Тогда
		Для Каждого УзелОбмена Из УзлыОбмена Цикл
			Если УзелОбмена = Отправитель Тогда
				Продолжить;
			КонецЕсли;
			Источник.ОбменДанными.Получатели.Добавить(УзелОбмена);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого УзелОбмена Из УзлыОбмена Цикл
		Если УзелОбмена = Отправитель Тогда
			Продолжить;
		КонецЕсли;
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Источник.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Функция эв_УзлыОбменаУниверсальный()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УзлыОбмена.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК УзлыОбмена
	|ГДЕ
	|	НЕ УзлыОбмена.ЭтотУзел
	|	И НЕ УзлыОбмена.ПометкаУдаления
	|	И НЕ УзлыОбмена.РучнойОбмен
	|	И УзлыОбмена.ВариантНастройки = ""ОбменУниверсальный""";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура эв_ДополнитьВыгрузкуРеквизитовЗаказа(ДанныеИБ, ДанныеXDTO)
	
	ДополнительнаяИнформация = эв_СтруктураAdditionalInfo(ДанныеXDTO);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Если ДанныеXDTO.Свойство("AdditionalInfo")
			И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Строка")
			И ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
			Возврат;
		КонецЕсли;
		ДополнительнаяИнформация = Новый Структура;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВидЗаказа) Тогда
		ДополнительнаяИнформация.Вставить("ВидЗаказа", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.ВидЗаказа));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.СостояниеЗаказа) Тогда
		ОписаниеСостояния = эв_ОписаниеСсылкиЗаказа(ДанныеИБ.СостояниеЗаказа);
		Если ДанныеИБ.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
			ОписаниеСостояния.Вставить("ЗавершенУспешно",
				ДанныеИБ.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно);
		КонецЕсли;
		ДополнительнаяИнформация.Вставить("СостояниеЗаказа", ОписаниеСостояния);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.НоменклатураДоставки) Тогда
		ДополнительнаяИнформация.Вставить("НоменклатураДоставки", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.НоменклатураДоставки));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.СтавкаНДСДоставки) Тогда
		ДополнительнаяИнформация.Вставить("СтавкаНДСДоставки", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.СтавкаНДСДоставки));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.ПричинаОтмены) Тогда
		ДополнительнаяИнформация.Вставить("ПричинаОтмены", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.ПричинаОтмены));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.ВариантЗавершения) Тогда
		ДополнительнаяИнформация.Вставить("ВариантЗавершения", XMLСтрока(ДанныеИБ.ВариантЗавершения));
	КонецЕсли;
	Для Каждого ИмяРеквизита Из СтрРазделить("Заметки,КонтактноеЛицо,КонтактныйТелефон,ПочтаПолучателя,АдресСайта", ",") Цикл
		Если ЗначениеЗаполнено(ДанныеИБ[ИмяРеквизита]) Тогда
			ДополнительнаяИнформация.Вставить(ИмяРеквизита, ДанныеИБ[ИмяРеквизита]);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяРеквизита Из СтрРазделить("ДатаОтгрузки,ОжидаемаяДатаВручения,ВремяДоставкиС,ВремяДоставкиПо", ",") Цикл
		Если ЗначениеЗаполнено(ДанныеИБ[ИмяРеквизита]) Тогда
			ДополнительнаяИнформация.Вставить(ИмяРеквизита, эв_ДатаВСтроку(ДанныеИБ[ИмяРеквизита]));
		КонецЕсли;
	КонецЦикла;
	ДополнительнаяИнформация.Вставить("СуммаНДСДоставки", ДанныеИБ.СуммаНДСДоставки);
	
	СтрокиЗапасов = эв_ВыгрузитьСтрокиЗапасов(ДанныеИБ);
	Если СтрокиЗапасов.Количество() > 0 Тогда
		ДополнительнаяИнформация.Вставить("эв_СтрокиЗапасов", СтрокиЗапасов);
	КонецЕсли;
	ДополнительнаяИнформация.Вставить("эв_ОтмененныеЗапасы", эв_ВыгрузитьОтмененныеЗапасы(ДанныеИБ));
	
	ДанныеXDTO.AdditionalInfo = эв_JSONИзСтруктуры(ДополнительнаяИнформация);
	
КонецПроцедуры

Функция эв_ОписаниеСсылкиЗаказа(Ссылка)
	
	Описание = Новый Структура;
	Описание.Вставить("Ссылка", XMLСтрока(Ссылка));
	Описание.Вставить("Наименование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование"));
	
	Возврат Описание;
	
КонецФункции

Процедура эв_УдалитьСтрокуДоставкиИзВыгрузкиЗаказа(ДанныеXDTO, ДанныеИБ)
	
	Если Не ЗначениеЗаполнено(ДанныеИБ.НоменклатураДоставки)
		Или Не ЗначениеЗаполнено(ДанныеИБ.СтоимостьДоставки) Тогда
		Возврат;
	КонецЕсли;
	
	эв_УдалитьСинтетическуюСтрокуДоставки(ДанныеXDTO, "Услуги", ДанныеИБ.НоменклатураДоставки);
	эв_УдалитьСинтетическуюСтрокуДоставки(ДанныеXDTO, "Товары", ДанныеИБ.НоменклатураДоставки);
	
КонецПроцедуры

Процедура эв_УдалитьСинтетическуюСтрокуДоставки(ДанныеXDTO, ИмяТаблицы, НоменклатураДоставки)
	
	Таблица = Неопределено;
	Если Не ДанныеXDTO.Свойство(ИмяТаблицы, Таблица)
		Или ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонкиНоменклатуры = "";
	Если Таблица.Колонки.Найти("Номенклатура") <> Неопределено Тогда
		ИмяКолонкиНоменклатуры = "Номенклатура";
	ИначеЕсли Таблица.Колонки.Найти("ДанныеНоменклатуры") <> Неопределено Тогда
		ИмяКолонкиНоменклатуры = "ДанныеНоменклатуры";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяКолонкиНоменклатуры)
		Или Таблица.Колонки.Найти("НомерСтрокиДокумента") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.НомерСтрокиДокумента = 0
			И СтрокаТаблицы[ИмяКолонкиНоменклатуры] = НоменклатураДоставки Тогда
			СтрокиКУдалению.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из СтрокиКУдалению Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Если Таблица.Количество() = 0 И ТипЗнч(ДанныеXDTO) = Тип("Структура") Тогда
		ДанныеXDTO.Удалить(ИмяТаблицы);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ЗапомнитьРеквизитыЗаказаИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные)
	
	ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
	
	ВидЗаказа = эв_СсылкаПоОписанию(ДополнительныеДанные, "ВидЗаказа", Справочники.ВидыЗаказовПокупателей);
	Если ЗначениеЗаполнено(ВидЗаказа) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ВидЗаказа", ВидЗаказа);
	КонецЕсли;
	
	СостояниеЗаказа = эв_СсылкаПоОписанию(ДополнительныеДанные, "СостояниеЗаказа", Справочники.СостоянияЗаказовПокупателей);
	Если ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_СостояниеЗаказа", СостояниеЗаказа);
	КонецЕсли;
	
	ОписаниеСостояния = Неопределено;
	Если ДополнительныеДанные.Свойство("СостояниеЗаказа", ОписаниеСостояния) Тогда
		ОписаниеСостояния = эв_СтруктураИзДанныхJSON(ОписаниеСостояния);
		ЗавершенУспешно = Неопределено;
		Если ОписаниеСостояния <> Неопределено
			И ОписаниеСостояния.Свойство("ЗавершенУспешно", ЗавершенУспешно) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ЗавершенУспешно", ЗавершенУспешно);
		КонецЕсли;
	КонецЕсли;
	
	НоменклатураДоставки = эв_СсылкаПоОписанию(ДополнительныеДанные, "НоменклатураДоставки", Справочники.Номенклатура);
	Если ЗначениеЗаполнено(НоменклатураДоставки) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_НоменклатураДоставки", НоменклатураДоставки);
	КонецЕсли;
	
	СтавкаНДСДоставки = эв_СсылкаПоОписанию(ДополнительныеДанные, "СтавкаНДСДоставки", Справочники.СтавкиНДС);
	Если ЗначениеЗаполнено(СтавкаНДСДоставки) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_СтавкаНДСДоставки", СтавкаНДСДоставки);
	КонецЕсли;
	
	ПричинаОтмены = эв_СсылкаПоОписанию(ДополнительныеДанные, "ПричинаОтмены", Справочники.ПричиныОтменыЗаказа);
	Если ЗначениеЗаполнено(ПричинаОтмены) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ПричинаОтмены", ПричинаОтмены);
	КонецЕсли;
	
	ВариантЗавершения = эв_ВариантЗавершенияИзAdditionalInfo(ДополнительныеДанные);
	Если ЗначениеЗаполнено(ВариантЗавершения) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ВариантЗавершения", ВариантЗавершения);
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("Заметки,КонтактноеЛицо,КонтактныйТелефон,ПочтаПолучателя,АдресСайта", ",") Цикл
		ЗначениеРеквизита = Неопределено;
		Если ДополнительныеДанные.Свойство(ИмяРеквизита, ЗначениеРеквизита) И ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_" + ИмяРеквизита, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("ДатаОтгрузки,ОжидаемаяДатаВручения,ВремяДоставкиС,ВремяДоставкиПо", ",") Цикл
		ЗначениеРеквизита = Неопределено;
		Если Не ДополнительныеДанные.Свойство(ИмяРеквизита, ЗначениеРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		ДатаРеквизита = эв_ДатаИзСтроки(ЗначениеРеквизита);
		Если ЗначениеЗаполнено(ДатаРеквизита) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_" + ИмяРеквизита, ДатаРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	СуммаНДСДоставки = Неопределено;
	Если ДополнительныеДанные.Свойство("СуммаНДСДоставки", СуммаНДСДоставки) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_СуммаНДСДоставки", СуммаНДСДоставки);
	КонецЕсли;
	
	СтрокиЗапасов = Неопределено;
	Если ДополнительныеДанные.Свойство("эв_СтрокиЗапасов", СтрокиЗапасов) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_СтрокиЗапасов", СтрокиЗапасов);
	КонецЕсли;
	
	ОтмененныеЗапасы = Неопределено;
	Если ДополнительныеДанные.Свойство("эв_ОтмененныеЗапасы", ОтмененныеЗапасы) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ОтмененныеЗапасы", ОтмененныеЗапасы);
	КонецЕсли;
	
КонецПроцедуры

Функция эв_ВариантЗавершенияИзAdditionalInfo(ДополнительныеДанные)
	
	Значение = Неопределено;
	Если Не ДополнительныеДанные.Свойство("ВариантЗавершения", Значение)
		Или ТипЗнч(Значение) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("ПеречислениеСсылка.ВариантыЗавершенияЗаказа"), Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция эв_СсылкаПоОписанию(ДополнительныеДанные, ИмяСвойства, МенеджерСправочника)
	
	Описание = Неопределено;
	Если Не ДополнительныеДанные.Свойство(ИмяСвойства, Описание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = Неопределено;
	Если Описание.Свойство("Ссылка", Ссылка) Тогда
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) И ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
		Если ТипЗнч(Ссылка) = Тип("Строка") И ЗначениеЗаполнено(Ссылка) Тогда
			Попытка
				НайденнаяСсылка = МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор(Ссылка));
			Исключение
				НайденнаяСсылка = Неопределено;
			КонецПопытки;
			Если ЗначениеЗаполнено(НайденнаяСсылка) И ОбщегоНазначения.СсылкаСуществует(НайденнаяСсылка) Тогда
				Возврат НайденнаяСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Наименование = "";
	Если Описание.Свойство("Наименование", Наименование) И ЗначениеЗаполнено(Наименование) Тогда
		Возврат МенеджерСправочника.НайтиПоНаименованию(Наименование, Истина);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_ВыгрузитьСтрокиЗапасов(ДанныеИБ)
	
	Результат = Новый Массив;
	РеквизитыЗапасов = Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти.Запасы.Реквизиты;
	ЕстьКП = ДанныеИБ.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу
		И ДанныеИБ.КоличествоВариантовКП > 0;
	
	ПорядокТипов = Новый Массив;
	ПорядокТипов.Добавить(Истина);
	ПорядокТипов.Добавить(Ложь);
	Для Каждого ЭтоЗапас Из ПорядокТипов Цикл
		Для Каждого СтрокаЗапасов Из ДанныеИБ.Запасы Цикл
			Если СтрокаЗапасов.ТипНоменклатурыЗапас <> ЭтоЗапас Тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьКП И СтрокаЗапасов.НомерВариантаКП <> ДанныеИБ.ОсновнойВариантКП Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(эв_ОписаниеСтрокиЗапасов(СтрокаЗапасов, РеквизитыЗапасов));
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ОписаниеСтрокиЗапасов(СтрокаЗапасов, РеквизитыЗапасов)
	
	Описание = Новый Структура;
	Описание.Вставить("НомерВариантаКП", СтрокаЗапасов.НомерВариантаКП);
	Описание.Вставить("Номенклатура", ?(ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура), XMLСтрока(СтрокаЗапасов.Номенклатура), ""));
	Описание.Вставить("Характеристика", ?(ЗначениеЗаполнено(СтрокаЗапасов.Характеристика), XMLСтрока(СтрокаЗапасов.Характеристика), ""));
	Описание.Вставить("Количество", СтрокаЗапасов.Количество);
	Описание.Вставить("Цена", СтрокаЗапасов.Цена);
	Описание.Вставить("Содержание", СтрокаЗапасов.Содержание);
	Описание.Вставить("КоличествоСобрано", СтрокаЗапасов.КоличествоСобрано);
	Описание.Вставить("Резерв", СтрокаЗапасов.Резерв);
	Описание.Вставить("РезервОтгрузка", СтрокаЗапасов.РезервОтгрузка);
	Если ЗначениеЗаполнено(СтрокаЗапасов.СтруктурнаяЕдиницаРезерв) Тогда
		Описание.Вставить("СтруктурнаяЕдиницаРезерв", эв_ОписаниеСсылкиЗаказа(СтрокаЗапасов.СтруктурнаяЕдиницаРезерв));
	КонецЕсли;
	Если РеквизитыЗапасов.Найти("Отменен") <> Неопределено Тогда
		Описание.Вставить("Отменен", СтрокаЗапасов.Отменен);
	КонецЕсли;
	Если РеквизитыЗапасов.Найти("ПричинаОтмены") <> Неопределено
		И ЗначениеЗаполнено(СтрокаЗапасов.ПричинаОтмены) Тогда
		Описание.Вставить("ПричинаОтмены", эв_ОписаниеСсылкиЗаказа(СтрокаЗапасов.ПричинаОтмены));
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция эв_ВыгрузитьОтмененныеЗапасы(ДанныеИБ)
	
	Результат = Новый Массив;
	Реквизиты = Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти.ОтмененныеЗапасы.Реквизиты;
	Для Каждого СтрокаТЧ Из ДанныеИБ.ОтмененныеЗапасы Цикл
		Описание = Новый Структура;
		Для Каждого Реквизит Из Реквизиты Цикл
			ЗначениеВыгрузки = эв_ЗначениеДляВыгрузки(СтрокаТЧ[Реквизит.Имя]);
			Если ЗначениеВыгрузки <> Неопределено Тогда
				Описание.Вставить(Реквизит.Имя, ЗначениеВыгрузки);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура эв_ПрименитьСтрокиЗапасов(ОбъектЗаписи, Строки)
	
	РеквизитыЗапасов = Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти.Запасы.Реквизиты;
	ЕстьОтменен = РеквизитыЗапасов.Найти("Отменен") <> Неопределено;
	ЕстьПричинаОтмены = РеквизитыЗапасов.Найти("ПричинаОтмены") <> Неопределено;
	ИспользованныеСтроки = Новый Соответствие;
	Индекс = 0;
	
	Для Каждого ОписаниеСтроки Из эв_МассивДанных(Строки) Цикл
		Индекс = Индекс + 1;
		ОписаниеСтроки = эв_СтруктураИзДанныхJSON(ОписаниеСтроки);
		Если ОписаниеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаЗапасов = эв_НайтиСтрокуЗапасов(ОбъектЗаписи.Запасы, ОписаниеСтроки, ИспользованныеСтроки);
		Если СтрокаЗапасов = Неопределено И ОбъектЗаписи.ЭтоНовый() Тогда
			ИндексСтроки = Индекс - 1;
			Если ИндексСтроки < ОбъектЗаписи.Запасы.Количество() Тогда
				Кандидат = ОбъектЗаписи.Запасы[ИндексСтроки];
				Если ИспользованныеСтроки.Получить(Кандидат) = Неопределено Тогда
					СтрокаЗапасов = Кандидат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если СтрокаЗапасов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИспользованныеСтроки.Вставить(СтрокаЗапасов, Истина);
		
		Если ОписаниеСтроки.Свойство("Содержание") Тогда
			СтрокаЗапасов.Содержание = Строка(эв_ЗначениеСвойства(ОписаниеСтроки, "Содержание", ""));
		КонецЕсли;
		Если ОписаниеСтроки.Свойство("КоличествоСобрано") Тогда
			СтрокаЗапасов.КоличествоСобрано = эв_ЧислоСвойства(ОписаниеСтроки, "КоличествоСобрано");
		КонецЕсли;
		Если ОписаниеСтроки.Свойство("Резерв") Тогда
			СтрокаЗапасов.Резерв = эв_ЧислоСвойства(ОписаниеСтроки, "Резерв");
		КонецЕсли;
		Если ОписаниеСтроки.Свойство("РезервОтгрузка") Тогда
			СтрокаЗапасов.РезервОтгрузка = эв_ЧислоСвойства(ОписаниеСтроки, "РезервОтгрузка");
		КонецЕсли;
		Если ОписаниеСтроки.Свойство("СтруктурнаяЕдиницаРезерв") Тогда
			Склад = эв_СсылкаПоОписанию(ОписаниеСтроки, "СтруктурнаяЕдиницаРезерв", Справочники.СтруктурныеЕдиницы);
			Если ЗначениеЗаполнено(Склад) Тогда
				СтрокаЗапасов.СтруктурнаяЕдиницаРезерв = Склад;
			КонецЕсли;
		КонецЕсли;
		Если ЕстьОтменен И ОписаниеСтроки.Свойство("Отменен") Тогда
			СтрокаЗапасов.Отменен = эв_ЧислоСвойства(ОписаниеСтроки, "Отменен");
		КонецЕсли;
		Если ЕстьПричинаОтмены И ОписаниеСтроки.Свойство("ПричинаОтмены") Тогда
			ПричинаОтмены = эв_СсылкаПоОписанию(ОписаниеСтроки, "ПричинаОтмены", Справочники.ПричиныОтменыЗаказа);
			Если ЗначениеЗаполнено(ПричинаОтмены) Тогда
				СтрокаЗапасов.ПричинаОтмены = ПричинаОтмены;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ПрименитьКоличествоЗапасов(ОбъектЗаписи)
	
	Если ОбъектЗаписи.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиПолученные = Неопределено;
	Если Не ОбъектЗаписи.ДополнительныеСвойства.Свойство("Запасы", СтрокиПолученные)
		Или ТипЗнч(СтрокиПолученные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользованныеСтроки = Новый Соответствие;
	Индекс = 0;
	КоличествоСтрокСовпадает = СтрокиПолученные.Количество() = ОбъектЗаписи.Запасы.Количество();
	КоличествоИзменено = Ложь;
	Для Каждого ОписаниеСтроки Из СтрокиПолученные Цикл
		Индекс = Индекс + 1;
		ОписаниеСтроки = эв_СтруктураИзДанныхJSON(ОписаниеСтроки);
		Если ОписаниеСтроки = Неопределено Или Не ОписаниеСтроки.Свойство("Количество") Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаЗапасов = эв_НайтиСтрокуЗапасовДляКоличества(ОбъектЗаписи.Запасы, ОписаниеСтроки, ИспользованныеСтроки);
		Если СтрокаЗапасов = Неопределено И КоличествоСтрокСовпадает Тогда
			Кандидат = ОбъектЗаписи.Запасы[Индекс - 1];
			Если ИспользованныеСтроки.Получить(Кандидат) = Неопределено Тогда
				СтрокаЗапасов = Кандидат;
			КонецЕсли;
		КонецЕсли;
		Если СтрокаЗапасов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИспользованныеСтроки.Вставить(СтрокаЗапасов, Истина);
		
		НовоеКоличество = эв_ЧислоСвойства(ОписаниеСтроки, "Количество");
		Если СтрокаЗапасов.Количество = НовоеКоличество Тогда
			Продолжить;
		КонецЕсли;
		эв_УстановитьКоличествоСтрокиЗапасов(СтрокаЗапасов, НовоеКоличество, ОбъектЗаписи);
		КоличествоИзменено = Истина;
	КонецЦикла;
	
	Если КоличествоИзменено Тогда
		ОбъектЗаписи.СуммаДокумента = ОбъектЗаписи.Запасы.Итог("Всего");
	КонецЕсли;
	
КонецПроцедуры

Функция эв_НайтиСтрокуЗапасовДляКоличества(Запасы, ОписаниеСтроки, ИспользованныеСтроки)
	
	Номенклатура = Неопределено;
	ОписаниеСтроки.Свойство("Номенклатура", Номенклатура);
	ИдентификаторНоменклатуры = эв_ИдентификаторНоменклатурыXDTO(Номенклатура);
	Если Не ЗначениеЗаполнено(ИдентификаторНоменклатуры) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Характеристика = Неопределено;
	ОписаниеСтроки.Свойство("Характеристика", Характеристика);
	ИдентификаторХарактеристики = эв_ИдентификаторНоменклатурыXDTO(Характеристика);
	
	Для Каждого СтрокаЗапасов Из Запасы Цикл
		Если ИспользованныеСтроки.Получить(СтрокаЗапасов) <> Неопределено
			Или Не ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если эв_НормализоватьИдентификатор(XMLСтрока(СтрокаЗапасов.Номенклатура)) <> ИдентификаторНоменклатуры Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИдентификаторХарактеристики) Тогда
			Если Не ЗначениеЗаполнено(СтрокаЗапасов.Характеристика)
				Или эв_НормализоватьИдентификатор(XMLСтрока(СтрокаЗапасов.Характеристика)) <> ИдентификаторХарактеристики Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Возврат СтрокаЗапасов;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура эв_УстановитьКоличествоСтрокиЗапасов(СтрокаЗапасов, НовоеКоличество, ОбъектЗаписи)
	
	ПрежнееКоличество = СтрокаЗапасов.Количество;
	СтрокаЗапасов.Количество = НовоеКоличество;
	Если ПрежнееКоличество <> 0 Тогда
		СтрокаЗапасов.Вес = СтрокаЗапасов.Вес / ПрежнееКоличество * НовоеКоличество;
		СтрокаЗапасов.Объем = СтрокаЗапасов.Объем / ПрежнееКоличество * НовоеКоличество;
	КонецЕсли;
	
	СтрокаЗапасов.Сумма = СтрокаЗапасов.Количество * СтрокаЗапасов.Цена;
	СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаЗапасов.СтавкаНДС);
	СтрокаЗапасов.СуммаНДС = ?(ОбъектЗаписи.СуммаВключаетНДС,
		СтрокаЗапасов.Сумма - СтрокаЗапасов.Сумма / ((СтавкаНДС + 100) / 100),
		СтрокаЗапасов.Сумма * СтавкаНДС / 100);
	СтрокаЗапасов.Всего = СтрокаЗапасов.Сумма + ?(ОбъектЗаписи.СуммаВключаетНДС, 0, СтрокаЗапасов.СуммаНДС);
	
КонецПроцедуры

Функция эв_НайтиСтрокуЗапасов(Запасы, ОписаниеСтроки, ИспользованныеСтроки)
	
	ИдентификаторНоменклатуры = эв_НормализоватьИдентификатор(эв_ЗначениеСвойства(ОписаниеСтроки, "Номенклатура", ""));
	Если Не ЗначениеЗаполнено(ИдентификаторНоменклатуры) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторХарактеристики = эв_НормализоватьИдентификатор(эв_ЗначениеСвойства(ОписаниеСтроки, "Характеристика", ""));
	ЕстьКоличество = ОписаниеСтроки.Свойство("Количество") И ОписаниеСтроки.Свойство("Цена");
	Количество = эв_ЧислоСвойства(ОписаниеСтроки, "Количество");
	Цена = эв_ЧислоСвойства(ОписаниеСтроки, "Цена");
	ЕстьВариант = ОписаниеСтроки.Свойство("НомерВариантаКП");
	НомерВарианта = эв_ЧислоСвойства(ОписаниеСтроки, "НомерВариантаКП");
	
	ЛучшаяСтрока = Неопределено;
	ЛучшийПриоритет = 0;
	Для Каждого СтрокаЗапасов Из Запасы Цикл
		Если ИспользованныеСтроки.Получить(СтрокаЗапасов) <> Неопределено
			Или Не ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если эв_НормализоватьИдентификатор(XMLСтрока(СтрокаЗапасов.Номенклатура)) <> ИдентификаторНоменклатуры Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИдентификаторХарактеристики) Тогда
			Если Не ЗначениеЗаполнено(СтрокаЗапасов.Характеристика)
				Или эв_НормализоватьИдентификатор(XMLСтрока(СтрокаЗапасов.Характеристика)) <> ИдентификаторХарактеристики Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Приоритет = 1;
		Если ЕстьВариант И СтрокаЗапасов.НомерВариантаКП = НомерВарианта Тогда
			Приоритет = 2;
		КонецЕсли;
		Если Приоритет = 2 И ЕстьКоличество
			И СтрокаЗапасов.Количество = Количество
			И СтрокаЗапасов.Цена = Цена Тогда
			Возврат СтрокаЗапасов;
		КонецЕсли;
		Если Приоритет > ЛучшийПриоритет Тогда
			ЛучшаяСтрока = СтрокаЗапасов;
			ЛучшийПриоритет = Приоритет;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЛучшаяСтрока;
	
КонецФункции

Процедура эв_ЗаполнитьОтмененныеЗапасы(ОбъектЗаписи, Строки)
	
	ОбъектЗаписи.ОтмененныеЗапасы.Очистить();
	Реквизиты = Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти.ОтмененныеЗапасы.Реквизиты;
	Для Каждого ОписаниеСтроки Из эв_МассивДанных(Строки) Цикл
		ОписаниеСтроки = эв_СтруктураИзДанныхJSON(ОписаниеСтроки);
		Если ОписаниеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ОбъектЗаписи.ОтмененныеЗапасы.Добавить();
		Для Каждого Реквизит Из Реквизиты Цикл
			Если Не ОписаниеСтроки.Свойство(Реквизит.Имя) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока[Реквизит.Имя] = эв_ПривестиЗначениеРеквизита(ОписаниеСтроки[Реквизит.Имя], Реквизит.Тип);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ЗначениеДляВыгрузки(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			Описание = Новый Структура;
			Описание.Вставить("Тип", XMLТип(ТипЗначения).ИмяТипа);
			Описание.Вставить("Значение", XMLСтрока(Значение));
			Возврат Описание;
		КонецЕсли;
		Возврат эв_ОписаниеСсылки(Значение);
	КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат эв_ДатаВСтроку(Значение);
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") И Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция эв_ПривестиЗначениеРеквизита(Значение, ОписаниеТипов, СохранятьСсылкуПоУИД = Ложь)
	
	Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Ссылка = эв_СсылкаРеквизитаЗаказа(Значение, СохранятьСсылкуПоУИД);
		Если Ссылка = Неопределено Тогда
			Возврат ОписаниеТипов.ПривестиЗначение(Неопределено);
		КонецЕсли;
		Возврат ОписаниеТипов.ПривестиЗначение(Ссылка);
	КонецЕсли;
	Если ОписаниеТипов.СодержитТип(Тип("Дата"))
		И (ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Дата")) Тогда
		Возврат ОписаниеТипов.ПривестиЗначение(эв_ДатаИзСтроки(Значение));
	КонецЕсли;
	
	Возврат ОписаниеТипов.ПривестиЗначение(Значение);
	
КонецФункции

Функция эв_СсылкаРеквизитаЗаказа(Описание, СохранятьСсылкуПоУИД = Ложь)
	
	Данные = эв_СтруктураИзДанныхJSON(Описание);
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Данные.Свойство("Значение") И Данные.Свойство("Тип") И Не Данные.Свойство("УИД") Тогда
		Попытка
			Возврат XMLЗначение(Тип(Данные.Тип), Данные.Значение);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Ссылка = эв_СсылкаПоУИД(Данные);
	Если ЗначениеЗаполнено(Ссылка) И ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Наименование = "";
	ТипСсылки = "";
	Если Данные.Свойство("Тип", ТипСсылки)
		И СтрНачинаетсяС(ТипСсылки, "CatalogRef.")
		И Данные.Свойство("Наименование", Наименование)
		И ЗначениеЗаполнено(Наименование) Тогда
		ИмяСправочника = Сред(ТипСсылки, СтрДлина("CatalogRef.") + 1);
		Попытка
			НайденнаяСсылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
		Исключение
			НайденнаяСсылка = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
			Возврат НайденнаяСсылка;
		КонецЕсли;
	КонецЕсли;
	
	Если СохранятьСсылкуПоУИД И ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_ЧислоИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Возврат Число(Значение);
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция эв_ЧислоСвойства(Данные, ИмяСвойства)
	
	Возврат эв_ЧислоИзЗначения(эв_ЗначениеСвойства(Данные, ИмяСвойства, 0));
	
КонецФункции

Процедура эв_УдалитьСтрокуДоставкиПриПолученииЗаказа(ДанныеXDTO, ПолученныеДанные)
	
	СтрокиЗапасов = Неопределено;
	Если Не ПолученныеДанные.ДополнительныеСвойства.Свойство("Запасы", СтрокиЗапасов)
		Или ТипЗнч(СтрокиЗапасов) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДоставки = эв_ИдентификаторДоставкиИзAdditionalInfo(ДанныеXDTO.AdditionalInfo);
	СуммаДоставки = Неопределено;
	ДанныеXDTO.AdditionalInfo.Свойство("СуммаДоставки", СуммаДоставки);
	
	Пока СтрокиЗапасов.Количество() > 0 Цикл
		Индекс = СтрокиЗапасов.Количество() - 1;
		СтрокаЗапасов = эв_СтруктураИзДанныхJSON(СтрокиЗапасов[Индекс]);
		Если СтрокаЗапасов = Неопределено
			Или Не эв_ЭтоСтрокаДоставки(СтрокаЗапасов, ИдентификаторДоставки, СуммаДоставки) Тогда
			Прервать;
		КонецЕсли;
		СтрокиЗапасов.Удалить(Индекс);
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ИдентификаторДоставкиИзAdditionalInfo(ДополнительныеДанные)
	
	Описание = Неопределено;
	Если Не ДополнительныеДанные.Свойство("НоменклатураДоставки", Описание) Тогда
		Возврат "";
	КонецЕсли;
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Ссылка = Неопределено;
	Если Не Описание.Свойство("Ссылка", Ссылка) Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
		Возврат эв_НормализоватьИдентификатор(XMLСтрока(Ссылка));
	КонецЕсли;
	
	Возврат эв_НормализоватьИдентификатор(Ссылка);
	
КонецФункции

Функция эв_ЭтоСтрокаДоставки(СтрокаЗапасов, ИдентификаторДоставки, СуммаДоставки)
	
	Номенклатура = Неопределено;
	Если ЗначениеЗаполнено(ИдентификаторДоставки) Тогда
		Возврат СтрокаЗапасов.Свойство("Номенклатура", Номенклатура)
			И эв_ИдентификаторНоменклатурыXDTO(Номенклатура) = ИдентификаторДоставки;
	КонецЕсли;
	
	Если СуммаДоставки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Количество = Неопределено;
	Сумма = Неопределено;
	Цена = Неопределено;
	Содержание = Неопределено;
	Если Не СтрокаЗапасов.Свойство("Количество", Количество)
		Или Не СтрокаЗапасов.Свойство("Сумма", Сумма)
		Или Не СтрокаЗапасов.Свойство("Цена", Цена)
		Или Не СтрокаЗапасов.Свойство("Содержание", Содержание) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Количество = 1
		И Сумма = СуммаДоставки
		И Цена = СуммаДоставки
		И ЗначениеЗаполнено(Содержание);
	
КонецФункции

Функция эв_ИдентификаторНоменклатурыXDTO(Номенклатура)
	
	Если Номенклатура = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Номенклатура)) Тогда
		Возврат эв_НормализоватьИдентификатор(XMLСтрока(Номенклатура));
	КонецЕсли;
	
	ДанныеНоменклатуры = эв_СтруктураИзДанныхJSON(Номенклатура);
	Ссылка = Неопределено;
	Если ДанныеНоменклатуры <> Неопределено Тогда
		ДанныеНоменклатуры.Свойство("Ссылка", Ссылка);
	Иначе
		Попытка
			Ссылка = Номенклатура.Ссылка;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Ссылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
		Возврат эв_НормализоватьИдентификатор(XMLСтрока(Ссылка));
	КонецЕсли;
	Если ТипЗнч(Ссылка) = Тип("Строка") Тогда
		Возврат эв_НормализоватьИдентификатор(Ссылка);
	КонецЕсли;
	
	ДанныеСсылки = эв_СтруктураИзДанныхJSON(Ссылка);
	Значение = Неопределено;
	Если ДанныеСсылки <> Неопределено И ДанныеСсылки.Свойство("Значение", Значение) Тогда
		Возврат эв_НормализоватьИдентификатор(Значение);
	КонецЕсли;
	Попытка
		Возврат эв_НормализоватьИдентификатор(Ссылка.Значение);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция эв_НормализоватьИдентификатор(Значение)
	
	Идентификатор = СокрЛП(Строка(Значение));
	Идентификатор = СтрЗаменить(Идентификатор, "{", "");
	Идентификатор = СтрЗаменить(Идентификатор, "}", "");
	
	Возврат ВРег(Идентификатор);
	
КонецФункции

Функция эв_ВыгрузитьЗаказыПокупателейССайта(ЗаказПокупателя)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	|	Заказы.ДатаЗаказаНаСайте КАК ДатаЗаказаНаСайте,
	|	Заказы.УзелОбмена КАК УзелОбмена,
	|	Заказы.эв_ОплаченНаПортале КАК эв_ОплаченНаПортале,
	|	Заказы.эв_ИсходныйПакет КАК эв_ИсходныйПакет,
	|	Заказы.КлючИнтеграции КАК КлючИнтеграции,
	|	Заказы.НастройкаИнтеграции КАК НастройкаИнтеграции,
	|	Заказы.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ЗаказыПокупателейССайта КАК Заказы
	|ГДЕ
	|	Заказы.ЗаказПокупателя = &ЗаказПокупателя";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("НомерЗаказаНаСайте", Выборка.НомерЗаказаНаСайте);
		Запись.Вставить("ДатаЗаказаНаСайте", эв_ДатаВСтроку(Выборка.ДатаЗаказаНаСайте));
		Запись.Вставить("эв_ОплаченНаПортале", Выборка.эв_ОплаченНаПортале);
		Запись.Вставить("эв_ИсходныйПакет", эв_ТекстХранилища(Выборка.эв_ИсходныйПакет));
		Запись.Вставить("Идентификатор", Выборка.Идентификатор);
		эв_ДобавитьОписаниеСсылки(Запись, "УзелОбмена", Выборка.УзелОбмена);
		эв_ДобавитьОписаниеСсылки(Запись, "КлючИнтеграции", Выборка.КлючИнтеграции);
		эв_ДобавитьОписаниеСсылки(Запись, "НастройкаИнтеграции", Выборка.НастройкаИнтеграции);
		Результат.Добавить(Запись);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ВыгрузитьИсториюСтатусовЗаказов(ЗаказПокупателя)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.Период КАК Период,
	|	История.СтатусЗаказа КАК СтатусЗаказа,
	|	История.ДатаОкончанияРезерва КАК ДатаОкончанияРезерва
	|ИЗ
	|	РегистрСведений.эв_ИсторияСтатусовЗаказов КАК История
	|ГДЕ
	|	История.ЗаказПокупателя = &ЗаказПокупателя
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Период", эв_ДатаВСтроку(Выборка.Период));
		Запись.Вставить("ДатаОкончанияРезерва", эв_ДатаВСтроку(Выборка.ДатаОкончанияРезерва));
		эв_ДобавитьОписаниеСсылки(Запись, "СтатусЗаказа", Выборка.СтатусЗаказа);
		Результат.Добавить(Запись);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура эв_ЗаписатьЗаказыПокупателейССайта(ЗаказПокупателя, Строки)
	
	Набор = РегистрыСведений.ЗаказыПокупателейССайта.СоздатьНаборЗаписей();
	Набор.Отбор.ЗаказПокупателя.Установить(ЗаказПокупателя);
	
	СтрокиДанных = эв_МассивДанных(Строки);
	Если СтрокиДанных.Количество() > 0 Тогда
		СтрокаДанных = эв_СтруктураИзДанныхJSON(СтрокиДанных[СтрокиДанных.Количество() - 1]);
		Если СтрокаДанных <> Неопределено Тогда
			Запись = Набор.Добавить();
			Запись.ЗаказПокупателя = ЗаказПокупателя;
			Запись.НомерЗаказаНаСайте = эв_СтрокаСвойства(СтрокаДанных, "НомерЗаказаНаСайте", 100);
			Запись.ДатаЗаказаНаСайте = эв_ДатаИзСтроки(эв_ЗначениеСвойства(СтрокаДанных, "ДатаЗаказаНаСайте"));
			Запись.эв_ОплаченНаПортале = эв_БулевоСвойства(СтрокаДанных, "эв_ОплаченНаПортале");
			Запись.Идентификатор = эв_СтрокаСвойства(СтрокаДанных, "Идентификатор", 255);
			эв_УстановитьСсылкуЗаписи(Запись, "УзелОбмена", СтрокаДанных);
			эв_УстановитьСсылкуЗаписи(Запись, "КлючИнтеграции", СтрокаДанных);
			эв_УстановитьСсылкуЗаписи(Запись, "НастройкаИнтеграции", СтрокаДанных);
			ТекстПакета = эв_СтрокаСвойства(СтрокаДанных, "эв_ИсходныйПакет");
			Если ЗначениеЗаполнено(ТекстПакета) Тогда
				Запись.эв_ИсходныйПакет = Новый ХранилищеЗначения(ТекстПакета, Новый СжатиеДанных(9));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
КонецПроцедуры

Процедура эв_ЗаписатьИсториюСтатусовЗаказов(ЗаказПокупателя, Строки)
	
	Набор = РегистрыСведений.эв_ИсторияСтатусовЗаказов.СоздатьНаборЗаписей();
	Набор.Отбор.ЗаказПокупателя.Установить(ЗаказПокупателя);
	
	ЗаписиПоПериодам = Новый Соответствие;
	Для Каждого Элемент Из эв_МассивДанных(Строки) Цикл
		СтрокаДанных = эв_СтруктураИзДанныхJSON(Элемент);
		Если СтрокаДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Период = эв_ДатаИзСтроки(эв_ЗначениеСвойства(СтрокаДанных, "Период"));
		Если Не ЗначениеЗаполнено(Период) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписиПоПериодам.Вставить(Период, СтрокаДанных);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ЗаписиПоПериодам Цикл
		СтрокаДанных = КлючИЗначение.Значение;
		Запись = Набор.Добавить();
		Запись.Период = КлючИЗначение.Ключ;
		Запись.ЗаказПокупателя = ЗаказПокупателя;
		Запись.ДатаОкончанияРезерва = эв_ДатаИзСтроки(эв_ЗначениеСвойства(СтрокаДанных, "ДатаОкончанияРезерва"));
		эв_УстановитьСсылкуЗаписи(Запись, "СтатусЗаказа", СтрокаДанных);
	КонецЦикла;
	
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
КонецПроцедуры

Процедура эв_ДобавитьОписаниеСсылки(Запись, ИмяПоля, Ссылка)
	
	Описание = эв_ОписаниеСсылки(Ссылка);
	Если Описание <> Неопределено Тогда
		Запись.Вставить(ИмяПоля, Описание);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_УстановитьСсылкуЗаписи(Запись, ИмяПоля, СтрокаДанных)
	
	Ссылка = эв_СсылкаИзОписания(эв_ЗначениеСвойства(СтрокаДанных, ИмяПоля));
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Запись[ИмяПоля] = Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Функция эв_ОписаниеСсылки(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Тип", XMLТип(ТипЗнч(Ссылка)).ИмяТипа);
	Описание.Вставить("УИД", Строка(Ссылка.УникальныйИдентификатор()));
	
	МетаданныеСсылки = Ссылка.Метаданные();
	Если Метаданные.Справочники.Содержит(МетаданныеСсылки)
		Или Метаданные.ПланыОбмена.Содержит(МетаданныеСсылки) Тогда
		Описание.Вставить("Наименование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование"));
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция эв_СсылкаИзОписания(Описание)
	
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = эв_СсылкаПоУИД(Описание);
	Если ЗначениеЗаполнено(Ссылка) И ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	ТипСсылки = "";
	Наименование = "";
	Если Описание.Свойство("Тип", ТипСсылки)
		И ТипСсылки = "CatalogRef.СостоянияЗаказовПокупателей"
		И Описание.Свойство("Наименование", Наименование)
		И ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию(Наименование, Истина);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_СсылкаПоУИД(Описание)
	
	УИД = "";
	ТипСсылки = "";
	Если Не Описание.Свойство("УИД", УИД) Или Не ЗначениеЗаполнено(УИД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не Описание.Свойство("Тип", ТипСсылки) Или Не ЗначениеЗаполнено(ТипСсылки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип(ТипСсылки), УИД);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция эв_МассивДанных(Значение)
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Описание = эв_СтруктураИзДанныхJSON(Значение);
	Результат = Новый Массив;
	Если Описание <> Неопределено Тогда
		Результат.Добавить(Описание);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ЗначениеСвойства(Данные, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	
	Данные = эв_СтруктураИзДанныхJSON(Данные);
	Если Данные = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Не Данные.Свойство(ИмяСвойства, Значение) Или Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция эв_СтрокаСвойства(Данные, ИмяСвойства, Длина = 0)
	
	Значение = эв_ЗначениеСвойства(Данные, ИмяСвойства, "");
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Значение = Строка(Значение);
	КонецЕсли;
	Если Длина > 0 И СтрДлина(Значение) > Длина Тогда
		Возврат Лев(Значение, Длина);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция эв_БулевоСвойства(Данные, ИмяСвойства)
	
	Значение = эв_ЗначениеСвойства(Данные, ИмяСвойства, Ложь);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Значение = Истина Или НРег(Строка(Значение)) = "true";
	
КонецФункции

Функция эв_ДатаВСтроку(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(Дата);
	
КонецФункции

Функция эв_ДатаИзСтроки(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Значение);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

Функция эв_ТекстХранилища(Хранилище)
	
	Если Хранилище = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Значение = Хранилище.Получить();
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Процедура эв_ЗаписатьAdditionalInfo(ДанныеXDTO, Данные)
	
	ТекстJSON = эв_JSONИзСтруктуры(Данные);
	Попытка
		ДанныеXDTO.AdditionalInfo = ТекстJSON;
		Возврат;
	Исключение
		Если ТипЗнч(ДанныеXDTO) = Тип("Структура") Тогда
			ДанныеXDTO.Вставить("AdditionalInfo", ТекстJSON);
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

Функция эв_ВыгрузитьОперациюПоПлатежнымКартам(ДанныеИБ)
	
	Результат = Новый Структура;
	Шапка = Новый Структура;
	Для Каждого Реквизит Из ДанныеИБ.Метаданные().Реквизиты Цикл
		ЗначениеРеквизита = эв_ЗначениеЗеркала(ДанныеИБ[Реквизит.Имя]);
		Если ЗначениеРеквизита <> Неопределено Тогда
			Шапка.Вставить(Реквизит.Имя, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Шапка", Шапка);
	
	ТабличныеЧасти = Новый Структура;
	Для Каждого ТабличнаяЧасть Из ДанныеИБ.Метаданные().ТабличныеЧасти Цикл
		ТабличныеЧасти.Вставить(ТабличнаяЧасть.Имя,
			эв_ВыгрузитьТабличнуюЧастьЗеркально(ДанныеИБ[ТабличнаяЧасть.Имя], ТабличнаяЧасть.Реквизиты));
	КонецЦикла;
	Результат.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	Результат.Вставить("Проведен", ДанныеИБ.Проведен);
	
	Возврат Результат;
	
КонецФункции

Функция эв_ВыгрузитьТабличнуюЧастьЗеркально(ТабличнаяЧасть, Реквизиты)
	
	Результат = Новый Массив;
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Описание = Новый Структура;
		Для Каждого Реквизит Из Реквизиты Цикл
			ЗначениеРеквизита = эв_ЗначениеЗеркала(СтрокаТЧ[Реквизит.Имя]);
			Если ЗначениеРеквизита <> Неопределено Тогда
				Описание.Вставить(Реквизит.Имя, ЗначениеРеквизита);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ЗначениеЗеркала(Значение)
	
	ЗначениеВыгрузки = эв_ЗначениеДляВыгрузки(Значение);
	Если ЗначениеВыгрузки <> Неопределено Тогда
		Если эв_МожноЗаписатьВJSON(ЗначениеВыгрузки) Тогда
			Возврат ЗначениеВыгрузки;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗначения)
		Или ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_МожноЗаписатьВJSON(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево") Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если Не эв_МожноЗаписатьВJSON(Элемент) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;
	Если ТипЗначения <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Значение Цикл
		Если Не эв_МожноЗаписатьВJSON(КлючИЗначение.Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура эв_ПрименитьОперациюПоПлатежнымКартам(ОбъектЗаписи)
	
	Операция = Неопределено;
	Если Не ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ОперацияПоПлатежнымКартам", Операция) Тогда
		Возврат;
	КонецЕсли;
	Операция = эв_СтруктураИзДанныхJSON(Операция);
	Если Операция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Шапка = Неопределено;
	Если Операция.Свойство("Шапка", Шапка) Тогда
		эв_ПрименитьШапкуЗеркально(ОбъектЗаписи, Шапка);
	КонецЕсли;
	эв_ПрименитьБулевоЗеркала(ОбъектЗаписи, Операция, "Проведен");
	
	ТабличныеЧасти = Неопределено;
	Если Не Операция.Свойство("ТабличныеЧасти", ТабличныеЧасти) Тогда
		Возврат;
	КонецЕсли;
	ТабличныеЧасти = эв_СтруктураИзДанныхJSON(ТабличныеЧасти);
	Если ТабличныеЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из ОбъектЗаписи.Метаданные().ТабличныеЧасти Цикл
		Строки = Неопределено;
		Если Не ТабличныеЧасти.Свойство(ТабличнаяЧасть.Имя, Строки) Тогда
			Продолжить;
		КонецЕсли;
		эв_ЗаполнитьТабличнуюЧастьЗеркально(ОбъектЗаписи[ТабличнаяЧасть.Имя], Строки, ТабличнаяЧасть.Реквизиты);
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ПрименитьШапкуЗеркально(ОбъектЗаписи, Шапка)
	
	Шапка = эв_СтруктураИзДанныхJSON(Шапка);
	Если Шапка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Реквизит Из ОбъектЗаписи.Метаданные().Реквизиты Цикл
		Если Не Шапка.Свойство(Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектЗаписи[Реквизит.Имя] = эв_ПривестиЗначениеРеквизита(Шапка[Реквизит.Имя], Реквизит.Тип, Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ПрименитьБулевоЗеркала(ОбъектЗаписи, Операция, ИмяРеквизита)
	
	Значение = Неопределено;
	Если Операция.Свойство(ИмяРеквизита, Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
		ОбъектЗаписи[ИмяРеквизита] = Значение;
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ЗаполнитьТабличнуюЧастьЗеркально(ТабличнаяЧасть, Строки, Реквизиты)
	
	ТабличнаяЧасть.Очистить();
	Для Каждого ОписаниеСтроки Из эв_МассивДанных(Строки) Цикл
		ОписаниеСтроки = эв_СтруктураИзДанныхJSON(ОписаниеСтроки);
		Если ОписаниеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		Для Каждого Реквизит Из Реквизиты Цикл
			Если Не ОписаниеСтроки.Свойство(Реквизит.Имя) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока[Реквизит.Имя] = эв_ПривестиЗначениеРеквизита(ОписаниеСтроки[Реквизит.Имя], Реквизит.Тип, Истина);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ВключитьВыгрузкуЧека(ИспользованиеПКО, КомпонентыОбмена, ИмяПравила54ФЗ, ИмяПростогоПравила)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	ИспользованиеПКО.Вставить(ИмяПравила54ФЗ, Истина);
	ИспользованиеПКО.Вставить(ИмяПростогоПравила, Ложь);
	
КонецПроцедуры

Процедура эв_ДополнитьВыгрузкуЧека(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки, ЭтоВозврат)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена)
		Или ДанныеXDTO = Неопределено
		Или СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	КассовыеДанные = Новый Структура;
	КассовыеДанные.Вставить("ЭтоВозврат", ЭтоВозврат);
	КассовыеДанные.Вставить("Архивный", ДанныеИБ.Архивный);
	КассовыеДанные.Вставить("Проведен", ДанныеИБ.Проведен);
	КассовыеДанные.Вставить("ОтчетОРозничныхПродажах", эв_ОписаниеКассовогоДокумента(ДанныеИБ.КассоваяСмена));
	эв_ДобавитьКассовыеДанные(ДанныеXDTO, КассовыеДанные);
	эв_ВыгрузитьНепроведенныйОтчетЧека(ДанныеИБ, КомпонентыОбмена);
	
КонецПроцедуры

Процедура эв_ЗаполнитьВыгрузкуОтчетаРозничныхПродаж(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена)
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВалютаДокумента) Тогда
		ДанныеXDTO.Вставить("Валюта", ДанныеИБ.ВалютаДокумента);
	Иначе
		ДанныеXDTO.Вставить("Валюта", КомпонентыОбмена.ПараметрыКонвертации.НациональнаяВалюта);
	КонецЕсли;
	
	Патент = Справочники.Патенты.ПустаяСсылка();
	Если ДанныеИБ.КассаККМ.ТипКассы = Перечисления.ТипыКассККМ.АвтономнаяККМ Тогда
		Патент = ДанныеИБ.Патент;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6") Тогда
		ДанныеXDTO.Вставить("КассаККМ", ДанныеИБ.КассаККМ);
	КонецЕсли;
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ИспользуютсяСкладыВТабличныхЧастях Тогда
		Склад = КомпонентыОбмена.ПараметрыКонвертации.ОбобщенныйСклад;
	Иначе
		Склад = ДанныеИБ.СтруктурнаяЕдиница;
	КонецЕсли;
	ДанныеXDTO.Вставить("Склад", Склад);
	
	ВерсияФорматаБольше1_10 = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10");
	Если ВерсияФорматаБольше1_10 Тогда
		ДанныеXDTO.Вставить("Патент", Патент);
	КонецЕсли;
	
	РасширенныеДанныеИБ = ДанныеОтчетОРозничныхПродажах(ДанныеИБ, Неопределено, КомпонентыОбмена);
	
	ТоварыПродажа = РасширенныеДанныеИБ.ТоварыПродажа;
	Если Не ВерсияФорматаБольше1_10 Тогда
		ТоварыПродажа.Колонки.Удалить("Патент");
	КонецЕсли;
	ТаблицаТоварыГТД = ДополнитьДаннымиПрослеживаемостиИГТД(ДанныеИБ, ТоварыПродажа, РасширенныеДанныеИБ.СведенияПрослеживаемости, "Сумма,СуммаНДС,Всего", КомпонентыОбмена);
	Если ТаблицаТоварыГТД.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ТоварыПродажа", ТаблицаТоварыГТД);
	КонецЕсли;
	
	ТоварыВозвратПродажи = РасширенныеДанныеИБ.ТоварыВозвратПродажи;
	Если Не ВерсияФорматаБольше1_10 Тогда
		ТоварыВозвратПродажи.Колонки.Удалить("Патент");
	КонецЕсли;
	ТаблицаТоварыГТДВозврат = ДополнитьДаннымиПрослеживаемостиИГТД(ДанныеИБ, ТоварыВозвратПродажи, РасширенныеДанныеИБ.СведенияПрослеживаемости, "Сумма,СуммаНДС,Всего", КомпонентыОбмена);
	Если ТаблицаТоварыГТДВозврат.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ТоварыВозвратПродажи", ТаблицаТоварыГТДВозврат);
	КонецЕсли;
	
	Услуги = РасширенныеДанныеИБ.Услуги;
	Если Не ВерсияФорматаБольше1_10 Тогда
		Услуги.Колонки.Удалить("Патент");
	КонецЕсли;
	Если Услуги.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
	
	СерииНоменклатуры = ДанныеДокументаСерииНоменклатурыВыгрузка(ДанныеИБ, КомпонентыОбмена);
	Если СерииНоменклатуры.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("СерииНоменклатуры", СерииНоменклатуры);
	КонецЕсли;
	
	ПодарочныеСертификаты = РасширенныеДанныеИБ.ПодарочныеСертификаты;
	Если ПодарочныеСертификаты.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ПодарочныеСертификаты", ПодарочныеСертификаты);
	КонецЕсли;
	
	ОплатаПлатежнымиКартами = РасширенныеДанныеИБ.ОплатаПлатежнымиКартами;
	Если Не ВерсияФорматаБольше1_10 Тогда
		ОплатаПлатежнымиКартами.Колонки.Удалить("Патент");
	КонецЕсли;
	Если ОплатаПлатежнымиКартами.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ОплатаПлатежнымиКартами", ОплатаПлатежнымиКартами);
	КонецЕсли;
	
	ОплатаБанковскимиКредитами = РасширенныеДанныеИБ.ОплатаБанковскимиКредитами;
	Если Не ВерсияФорматаБольше1_10 Тогда
		ОплатаБанковскимиКредитами.Колонки.Удалить("Патент");
	КонецЕсли;
	Если ОплатаБанковскимиКредитами.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ОплатаБанковскимиКредитами", ОплатаБанковскимиКредитами);
	КонецЕсли;
	
	ОплатаСертификатами = РасширенныеДанныеИБ.ОплатаСертификатами;
	Если ОплатаСертификатами.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ОплатаСертификатами", ОплатаСертификатами);
	КонецЕсли;
	
	ОплатаБонуснымиБаллами = РасширенныеДанныеИБ.ОплатаБонуснымиБаллами;
	Если ОплатаБонуснымиБаллами.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ОплатаБонуснымиБаллами", ОплатаБонуснымиБаллами);
	КонецЕсли;
	
	НачислениеБонусныхБаллов = РасширенныеДанныеИБ.НачислениеБонусныхБаллов;
	Если НачислениеБонусныхБаллов.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("НачислениеБонусныхБаллов", НачислениеБонусныхБаллов);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.16") Тогда
		ЗаполнитьСведенияОПрослеживаемости(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ВыгрузитьНепроведенныйОтчетЧека(ДанныеИБ, КомпонентыОбмена)
	
	Отчет = ДанныеИБ.КассоваяСмена;
	Если Не ЗначениеЗаполнено(Отчет)
		Или КомпонентыОбмена.ВыгруженныеОбъекты.Найти(Отчет) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтчетОбъект = Отчет.ПолучитьОбъект();
	Если ОтчетОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтчетОбъект.ДополнительныеСвойства.Вставить("эв_ВыгрузкаНепроведенногоПоСсылке", Истина);
	ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ОтчетОбъект);
	
КонецПроцедуры

Процедура эв_ДобавитьКассовыеДанные(ДанныеXDTO, КассовыеДанные)
	
	Дополнение = эв_СтруктураAdditionalInfo(ДанныеXDTO);
	Если Дополнение = Неопределено Тогда
		Дополнение = Новый Структура;
	КонецЕсли;
	Дополнение.Вставить("ор_КассовыеДокументы", эв_JSONИзСтруктуры(эв_СтруктураДляJSON(КассовыеДанные)));
	ДанныеXDTO.Вставить("AdditionalInfo", Дополнение);
	
КонецПроцедуры

Процедура эв_ЗапомнитьКассовыеДанныеЧека(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Или ПолученныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КассовыеДанные = эв_КассовыеДанныеИзXDTO(ДанныеXDTO);
	Если КассовыеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_КассовыеДанные", КассовыеДанные);
	
КонецПроцедуры

Процедура эв_ПрименитьКассовыеДанныеЧека(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Или ПолученныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КассовыеДанные = Неопределено;
	Если Не ПолученныеДанные.ДополнительныеСвойства.Свойство("эв_КассовыеДанные", КассовыеДанные) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОтчета = эв_ЗначениеСвойства(КассовыеДанные, "ОтчетОРозничныхПродажах");
	Отчет = эв_ОбеспечитьОтчетРозничныхПродаж(ОписаниеОтчета, ПолученныеДанные.КассаККМ);
	Если ЗначениеЗаполнено(Отчет) Тогда
		ПолученныеДанные.КассоваяСмена = Отчет;
	КонецЕсли;
	
	ПолученныеДанные.Архивный = эв_БулевоСвойства(КассовыеДанные, "Архивный");
	Если Не ПолученныеДанные.Архивный И эв_ОтчетЗакрытСАрхивациейЧеков(Отчет) Тогда
		ПолученныеДанные.Архивный = Истина;
	КонецЕсли;
	ПолученныеДанные.Проведен = Истина;
	Если ПолученныеДанные.Метаданные().Реквизиты.Найти("Статус") <> Неопределено
		И Не ЗначениеЗаполнено(ПолученныеДанные.Статус) Тогда
		ПолученныеДанные.Статус = Перечисления.СтатусыЧековККМ.Пробит;
	КонецЕсли;
	
	Если ДанныеИБ <> Неопределено Тогда
		ДанныеИБ.КассоваяСмена = ПолученныеДанные.КассоваяСмена;
		ДанныеИБ.Архивный = ПолученныеДанные.Архивный;
		ДанныеИБ.Проведен = ПолученныеДанные.Проведен;
		Если ДанныеИБ.Метаданные().Реквизиты.Найти("Статус") <> Неопределено Тогда
			ДанныеИБ.Статус = ПолученныеДанные.Статус;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция эв_КассовыеДанныеИзXDTO(ДанныеXDTO)
	
	ДополнительныеДанные = эв_СтруктураAdditionalInfo(ДанныеXDTO);
	Если ДополнительныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Текст = эв_ЗначениеСвойства(ДополнительныеДанные, "ор_КассовыеДокументы");
	Если ТипЗнч(Текст) <> Тип("Строка") Или Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат эв_СтруктураИзДанныхJSON(Данные);
	
КонецФункции

Функция эв_ОписаниеКассовогоДокумента(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Тип", XMLТип(ТипЗнч(Ссылка)).ИмяТипа);
	Описание.Вставить("УИД", Строка(Ссылка.УникальныйИдентификатор()));
	
	ИменаРеквизитов = "Номер,Дата,Проведен";
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
		ИменаРеквизитов = ИменаРеквизитов + ",КассаККМ,Организация,СтруктурнаяЕдиница,СтатусКассовойСмены,КассоваяСмена,НачалоКассовойСмены,ОкончаниеКассовойСмены";
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.КассоваяСмена") Тогда
		ИменаРеквизитов = ИменаРеквизитов + ",КассаККМ,Организация,Статус,НомерСменыККТ,НачалоКассовойСмены,ОкончаниеКассовойСмены";
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ИменаРеквизитов);
	Описание.Вставить("Номер", Реквизиты.Номер);
	Описание.Вставить("Дата", эв_ДатаВСтроку(Реквизиты.Дата));
	Описание.Вставить("Проведен", Реквизиты.Проведен);
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
		Описание.Вставить("КассаККМ", эв_ОписаниеСсылки(Реквизиты.КассаККМ));
		Описание.Вставить("Организация", эв_ОписаниеСсылки(Реквизиты.Организация));
		Описание.Вставить("СтруктурнаяЕдиница", эв_ОписаниеСсылки(Реквизиты.СтруктурнаяЕдиница));
		Описание.Вставить("СтатусКассовойСмены", эв_ИмяЗначенияПеречисления(Реквизиты.СтатусКассовойСмены));
		Описание.Вставить("НачалоКассовойСмены", эв_ДатаВСтроку(Реквизиты.НачалоКассовойСмены));
		Описание.Вставить("ОкончаниеКассовойСмены", эв_ДатаВСтроку(Реквизиты.ОкончаниеКассовойСмены));
		Описание.Вставить("КассоваяСмена", эв_ОписаниеКассовогоДокумента(Реквизиты.КассоваяСмена));
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.КассоваяСмена") Тогда
		Описание.Вставить("КассаККМ", эв_ОписаниеСсылки(Реквизиты.КассаККМ));
		Описание.Вставить("Организация", эв_ОписаниеСсылки(Реквизиты.Организация));
		Описание.Вставить("Статус", эв_ИмяЗначенияПеречисления(Реквизиты.Статус));
		Описание.Вставить("НомерСменыККТ", Реквизиты.НомерСменыККТ);
		Описание.Вставить("НачалоКассовойСмены", эв_ДатаВСтроку(Реквизиты.НачалоКассовойСмены));
		Описание.Вставить("ОкончаниеКассовойСмены", эв_ДатаВСтроку(Реквизиты.ОкончаниеКассовойСмены));
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция эв_ПолноеПроведениеОтчета(ДанныеИБ)
	
	Если Не ДанныеИБ.Проведен Или Не ЗначениеЗаполнено(ДанныеИБ.КассаККМ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипКассы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.КассаККМ, "ТипКассы");
	Статус = ДанныеИБ.СтатусКассовойСмены;
	Если ТипКассы = Перечисления.ТипыКассККМ.ФискальныйРегистратор
		Или ТипКассы = Перечисления.ТипыКассККМ.ККМED Тогда
		Возврат Статус = Перечисления.СтатусыОтчетаОРозничныхПродажах.ЗакрытаЧекиЗаархивированы;
	КонецЕсли;
	
	Возврат Статус = Перечисления.СтатусыОтчетаОРозничныхПродажах.Закрыта
		Или Статус = Перечисления.СтатусыОтчетаОРозничныхПродажах.ЗакрытаЧекиЗаархивированы;
	
КонецФункции

Функция эв_ОбеспечитьОтчетРозничныхПродаж(ОписаниеОтчета, КассаККМЧека)
	
	ОписаниеОтчета = эв_СтруктураИзДанныхJSON(ОписаниеОтчета);
	Если ОписаниеОтчета = Неопределено Тогда
		Возврат Документы.ОтчетОРозничныхПродажах.ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = эв_СсылкаПоУИД(ОписаниеОтчета);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Документы.ОтчетОРозничныхПродажах.ПустаяСсылка();
	КонецЕсли;
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	КассаККМ = эв_СуществующаяСсылка(эв_ЗначениеСвойства(ОписаниеОтчета, "КассаККМ"));
	Если Не ЗначениеЗаполнено(КассаККМ) Тогда
		КассаККМ = КассаККМЧека;
	КонецЕсли;
	КассоваяСмена = эв_ОбеспечитьКассовыйДокумент(эв_ЗначениеСвойства(ОписаниеОтчета, "КассоваяСмена"), КассаККМ);
	
	ОтчетОбъект = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
	ОтчетОбъект.УстановитьСсылкуНового(Ссылка);
	ОтчетОбъект.Номер = эв_СтрокаСвойства(ОписаниеОтчета, "Номер");
	ОтчетОбъект.Дата = эв_ДатаИзСтроки(эв_ЗначениеСвойства(ОписаниеОтчета, "Дата"));
	ОтчетОбъект.КассаККМ = КассаККМ;
	ОтчетОбъект.КассоваяСмена = КассоваяСмена;
	ОтчетОбъект.Организация = эв_СуществующаяСсылка(эв_ЗначениеСвойства(ОписаниеОтчета, "Организация"));
	ОтчетОбъект.СтруктурнаяЕдиница = эв_СуществующаяСсылка(эв_ЗначениеСвойства(ОписаниеОтчета, "СтруктурнаяЕдиница"));
	Если Не ЗначениеЗаполнено(ОтчетОбъект.Организация) И ЗначениеЗаполнено(КассаККМ) Тогда
		ОтчетОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ, "Владелец");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОтчетОбъект.СтруктурнаяЕдиница) И ЗначениеЗаполнено(КассаККМ) Тогда
		ОтчетОбъект.СтруктурнаяЕдиница = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ, "СтруктурнаяЕдиница");
	КонецЕсли;
	ОтчетОбъект.НачалоКассовойСмены = эв_ДатаИзСтроки(эв_ЗначениеСвойства(ОписаниеОтчета, "НачалоКассовойСмены"));
	Если Не ЗначениеЗаполнено(ОтчетОбъект.НачалоКассовойСмены) Тогда
		ОтчетОбъект.НачалоКассовойСмены = ОтчетОбъект.Дата;
	КонецЕсли;
	ОтчетОбъект.ОкончаниеКассовойСмены = эв_ДатаИзСтроки(эв_ЗначениеСвойства(ОписаниеОтчета, "ОкончаниеКассовойСмены"));
	Статус = эв_СтатусОтчетаОРозничныхПродажах(эв_СтрокаСвойства(ОписаниеОтчета, "СтатусКассовойСмены"));
	ОтчетОбъект.СтатусКассовойСмены = ?(ЗначениеЗаполнено(Статус), Статус, Перечисления.СтатусыОтчетаОРозничныхПродажах.Открыта);
	ОтчетОбъект.Проведен = Ложь;
	ОтчетОбъект.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	эв_ЗаписатьКассовыйДокумент(ОтчетОбъект);
	
	Возврат Ссылка;
	
КонецФункции

Функция эв_ОбеспечитьКассовыйДокумент(Описание, КассаККМПоУмолчанию)
	
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат Документы.КассоваяСмена.ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = эв_СсылкаПоУИД(Описание);
	Если Не ЗначениеЗаполнено(Ссылка) Или ТипЗнч(Ссылка) <> Тип("ДокументСсылка.КассоваяСмена") Тогда
		Возврат Документы.КассоваяСмена.ПустаяСсылка();
	КонецЕсли;
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	КассаККМ = эв_СуществующаяСсылка(эв_ЗначениеСвойства(Описание, "КассаККМ"));
	Если Не ЗначениеЗаполнено(КассаККМ) Тогда
		КассаККМ = КассаККМПоУмолчанию;
	КонецЕсли;
	
	СменаОбъект = Документы.КассоваяСмена.СоздатьДокумент();
	СменаОбъект.УстановитьСсылкуНового(Ссылка);
	СменаОбъект.Номер = эв_СтрокаСвойства(Описание, "Номер");
	СменаОбъект.Дата = эв_ДатаИзСтроки(эв_ЗначениеСвойства(Описание, "Дата"));
	СменаОбъект.КассаККМ = КассаККМ;
	СменаОбъект.Организация = эв_СуществующаяСсылка(эв_ЗначениеСвойства(Описание, "Организация"));
	Если Не ЗначениеЗаполнено(СменаОбъект.Организация) И ЗначениеЗаполнено(КассаККМ) Тогда
		СменаОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ, "Владелец");
	КонецЕсли;
	СменаОбъект.НомерСменыККТ = эв_ЧислоСвойства(Описание, "НомерСменыККТ");
	СменаОбъект.НачалоКассовойСмены = эв_ДатаИзСтроки(эв_ЗначениеСвойства(Описание, "НачалоКассовойСмены"));
	СменаОбъект.ОкончаниеКассовойСмены = эв_ДатаИзСтроки(эв_ЗначениеСвойства(Описание, "ОкончаниеКассовойСмены"));
	Статус = эв_СтатусКассовойСмены(эв_СтрокаСвойства(Описание, "Статус"));
	СменаОбъект.Статус = ?(ЗначениеЗаполнено(Статус), Статус, Перечисления.СтатусыКассовойСмены.Открыта);
	СменаОбъект.Проведен = эв_БулевоСвойства(Описание, "Проведен");
	эв_ЗаписатьКассовыйДокумент(СменаОбъект);
	
	Возврат Ссылка;
	
КонецФункции

Функция эв_ОписаниеЗаказовСтрокОтчета(ДанныеИБ, ДанныеXDTO = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запасы.НомерСтроки КАК НомерСтроки,
	|	Запасы.Номенклатура КАК Номенклатура,
	|	Запасы.Количество КАК Количество,
	|	Запасы.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВтЗапасы
	|ИЗ
	|	&Запасы КАК Запасы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтЗапасы.НомерСтроки КАК НомерСтроки,
	|	ВтЗапасы.Заказ КАК Заказ,
	|	ВЫБОР
	|		КОГДА ВтЗапасы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|				И ВтЗапасы.Количество > 0
	|			ТОГДА ""Продажа""
	|		КОГДА ВтЗапасы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|				И ВтЗапасы.Количество < 0
	|			ТОГДА ""Возврат""
	|		КОГДА ВтЗапасы.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|				И ВтЗапасы.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
	|			ТОГДА ""Услуга""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Вид
	|ИЗ
	|	ВтЗапасы КАК ВтЗапасы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Запасы", ДанныеИБ.Запасы);
	
	ИндексыУслуг = эв_ИндексыУслуг(ДанныеXDTO);
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Заказ) Или Не ЗначениеЗаполнено(Выборка.Вид) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("НомерСтроки", Выборка.НомерСтроки);
		Описание.Вставить("Вид", Выборка.Вид);
		Описание.Вставить("Заказ", эв_ОписаниеСсылки(Выборка.Заказ));
		Если Выборка.Вид = "Услуга" Тогда
			ИндексУслуги = ИндексыУслуг.Получить(Выборка.НомерСтроки);
			Если ИндексУслуги = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Описание.Вставить("Индекс", ИндексУслуги);
		КонецЕсли;
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ИндексыУслуг(ДанныеXDTO)
	
	Индексы = Новый Соответствие;
	Если ДанныеXDTO = Неопределено Или Не ДанныеXDTO.Свойство("Услуги") Тогда
		Возврат Индексы;
	КонецЕсли;
	
	Таблица = ДанныеXDTO.Услуги;
	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений")
		Или Таблица.Колонки.Найти("НомерСтрокиДокумента") = Неопределено Тогда
		Возврат Индексы;
	КонецЕсли;
	
	ИндексУслуги = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИндексУслуги = ИндексУслуги + 1;
		Индексы.Вставить(Число(СтрокаТаблицы.НомерСтрокиДокумента), ИндексУслуги);
	КонецЦикла;
	
	Возврат Индексы;
	
КонецФункции

Функция эв_ЗаказыСтрокОтчета(ДанныеXDTO, КассовыеДанные, КомпонентыОбмена)
	
	ЗаказыПоНомеру = Новый Соответствие;
	ЗаказыУслуг = Новый Соответствие;
	Для Каждого ОписаниеСтроки Из эв_МассивДанных(эв_ЗначениеСвойства(КассовыеДанные, "ЗаказыСтрок")) Цикл
		ОписаниеСтроки = эв_СтруктураИзДанныхJSON(ОписаниеСтроки);
		ОписаниеЗаказа = эв_СтруктураИзДанныхJSON(эв_ЗначениеСвойства(ОписаниеСтроки, "Заказ"));
		Если ОписаниеЗаказа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Заказ = эв_СсылкаПоУИД(ОписаниеЗаказа);
		Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Продолжить;
		КонецЕсли;
		Если эв_СтрокаСвойства(ОписаниеСтроки, "Вид") = "Услуга" Тогда
			ЗаказыУслуг.Вставить(эв_ЧислоСвойства(ОписаниеСтроки, "Индекс"), Заказ);
		Иначе
			ЗаказыПоНомеру.Вставить(эв_ЧислоСвойства(ОписаниеСтроки, "НомерСтроки"), Заказ);
		КонецЕсли;
	КонецЦикла;
	
	ЗаказыСтрок = Новый Массив;
	Версия16 = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6");
	эв_ДобавитьЗаказыТаблицыТоваров(ЗаказыСтрок, ДанныеXDTO, ?(Версия16, "ТоварыПродажа", "Товары"), ЗаказыПоНомеру, Истина);
	эв_ДобавитьЗаказыТаблицыТоваров(ЗаказыСтрок, ДанныеXDTO, ?(Версия16, "ТоварыВозвратПродажи", "ВозвратТоваров"), ЗаказыПоНомеру, Ложь);
	эв_ДобавитьЗаказыУслуг(ЗаказыСтрок, ДанныеXDTO, ЗаказыУслуг);
	эв_ДобавитьПустыеЗаказы(ЗаказыСтрок, ДанныеXDTO, "ПодарочныеСертификаты");
	
	Возврат ЗаказыСтрок;
	
КонецФункции

Процедура эв_ДобавитьЗаказыТаблицыТоваров(ЗаказыСтрок, ДанныеXDTO, ИмяТаблицы, ЗаказыПоНомеру, ПропускатьПустоеКоличество)
	
	Таблица = Неопределено;
	Если Не ДанныеXDTO.Свойство(ИмяТаблицы, Таблица)
		Или ТипЗнч(Таблица) <> Тип("ТаблицаЗначений")
		Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьНомер = Таблица.Колонки.Найти("НомерСтрокиДокумента") <> Неопределено;
	ЕстьКоличество = Таблица.Колонки.Найти("Количество") <> Неопределено;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ПропускатьПустоеКоличество И ЕстьКоличество И Не ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			Продолжить;
		КонецЕсли;
		Заказ = Неопределено;
		Если ЕстьНомер Тогда
			Заказ = ЗаказыПоНомеру.Получить(Число(СтрокаТаблицы.НомерСтрокиДокумента));
		КонецЕсли;
		ЗаказыСтрок.Добавить(Заказ);
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ДобавитьЗаказыУслуг(ЗаказыСтрок, ДанныеXDTO, ЗаказыУслуг)
	
	Таблица = Неопределено;
	Если Не ДанныеXDTO.Свойство("Услуги", Таблица)
		Или ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ИндексУслуги = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИндексУслуги = ИндексУслуги + 1;
		ЗаказыСтрок.Добавить(ЗаказыУслуг.Получить(ИндексУслуги));
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ДобавитьПустыеЗаказы(ЗаказыСтрок, ДанныеXDTO, ИмяТаблицы)
	
	Таблица = Неопределено;
	Если Не ДанныеXDTO.Свойство(ИмяТаблицы, Таблица)
		Или ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаказыСтрок.Добавить(Неопределено);
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ПрименитьЗаказыСтрок(ОбъектЗаписи, ЗаказыСтрок)
	
	Если ОбъектЗаписи = Неопределено
		Или ТипЗнч(ЗаказыСтрок) <> Тип("Массив")
		Или ЗаказыСтрок.Количество() = 0
		Или ЗаказыСтрок.Количество() <> ОбъектЗаписи.Запасы.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = 0;
	Для Каждого СтрокаЗапасов Из ОбъектЗаписи.Запасы Цикл
		Заказ = ЗаказыСтрок[Индекс];
		Если ЗначениеЗаполнено(Заказ) Тогда
			СтрокаЗапасов.Заказ = Заказ;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура эв_ПрименитьСостояниеОтчетаРозничныхПродаж(ОбъектЗаписи, КассовыеДанные, КассоваяСмена, Статус)
	
	Если КассовыеДанные.Свойство("Проведен") Тогда
		ОбъектЗаписи.Проведен = эв_БулевоСвойства(КассовыеДанные, "Проведен");
	КонецЕсли;
	Если ЗначениеЗаполнено(КассоваяСмена) Тогда
		ОбъектЗаписи.КассоваяСмена = КассоваяСмена;
	КонецЕсли;
	Если ЗначениеЗаполнено(Статус) Тогда
		ОбъектЗаписи.СтатусКассовойСмены = Статус;
	КонецЕсли;
	Если КассовыеДанные.Свойство("НачалоКассовойСмены") Тогда
		НачалоКассовойСмены = эв_ДатаИзСтроки(эв_ЗначениеСвойства(КассовыеДанные, "НачалоКассовойСмены"));
		Если ЗначениеЗаполнено(НачалоКассовойСмены) Тогда
			ОбъектЗаписи.НачалоКассовойСмены = НачалоКассовойСмены;
		КонецЕсли;
	КонецЕсли;
	Если КассовыеДанные.Свойство("ОкончаниеКассовойСмены") Тогда
		ОбъектЗаписи.ОкончаниеКассовойСмены = эв_ДатаИзСтроки(эв_ЗначениеСвойства(КассовыеДанные, "ОкончаниеКассовойСмены"));
	КонецЕсли;
	Если КассовыеДанные.Свойство("СуммаПредоплаты") Тогда
		ОбъектЗаписи.СуммаПредоплаты = эв_ЧислоСвойства(КассовыеДанные, "СуммаПредоплаты");
	КонецЕсли;
	Если КассовыеДанные.Свойство("ПолученаПредоплата") Тогда
		ОбъектЗаписи.ПолученаПредоплата = эв_ЧислоСвойства(КассовыеДанные, "ПолученаПредоплата");
	КонецЕсли;
	Если КассовыеДанные.Свойство("ОптимизированнаяСхемаДвижений") Тогда
		ОбъектЗаписи.ОптимизированнаяСхемаДвижений = эв_БулевоСвойства(КассовыеДанные, "ОптимизированнаяСхемаДвижений");
	КонецЕсли;
	Если КассовыеДанные.Свойство("ПолноеПроведение") Тогда
		ОбъектЗаписи.ДополнительныеСвойства.Вставить("эв_ПолноеПроведение", эв_БулевоСвойства(КассовыеДанные, "ПолноеПроведение"));
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ЗаписатьКассовыйДокумент(ДокументОбъект)
	
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Процедура эв_АрхивироватьЧекиОтчета(Отчет)
	
	Если Не ЗначениеЗаполнено(Отчет) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЧекККМ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.КассоваяСмена = &Отчет
	|	И ЧекККМ.Проведен
	|	И НЕ ЧекККМ.Архивный
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЧекККМВозврат.Ссылка
	|ИЗ
	|	Документ.ЧекККМВозврат КАК ЧекККМВозврат
	|ГДЕ
	|	ЧекККМВозврат.КассоваяСмена = &Отчет
	|	И ЧекККМВозврат.Проведен
	|	И НЕ ЧекККМВозврат.Архивный";
	Запрос.УстановитьПараметр("Отчет", Отчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЧекОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЧекОбъект.Архивный = Истина;
		ЧекОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
		Попытка
			ЧекОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЧекОбъект.ОбменДанными.Загрузка = Истина;
			ЧекОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ОтчетЗакрытСАрхивациейЧеков(Отчет)
	
	Если Не ЗначениеЗаполнено(Отчет) Или Не ОбщегоНазначения.СсылкаСуществует(Отчет) Тогда
		Возврат Ложь;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет, "Проведен,СтатусКассовойСмены");
	Возврат Реквизиты.Проведен
		И Реквизиты.СтатусКассовойСмены = Перечисления.СтатусыОтчетаОРозничныхПродажах.ЗакрытаЧекиЗаархивированы;
	
КонецФункции

Функция эв_СуществующаяСсылка(Описание)
	
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = эв_СсылкаПоУИД(Описание);
	Если ЗначениеЗаполнено(Ссылка) И ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_СтруктураДляJSON(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Значение Цикл
		Если КлючИЗначение.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Структура") Тогда
			ВложеннаяСтруктура = эв_СтруктураДляJSON(КлючИЗначение.Значение);
			Если ВложеннаяСтруктура.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(КлючИЗначение.Ключ, ВложеннаяСтруктура);
		Иначе
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ИмяЗначенияПеречисления(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(Значение);
	
КонецФункции

Функция эв_СтатусОтчетаОРозничныхПродажах(ИмяСтатуса)
	
	Если Не ЗначениеЗаполнено(ИмяСтатуса) Тогда
		Возврат Перечисления.СтатусыОтчетаОРозничныхПродажах.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("ПеречислениеСсылка.СтатусыОтчетаОРозничныхПродажах"), ИмяСтатуса);
	Исключение
		Возврат Перечисления.СтатусыОтчетаОРозничныхПродажах.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция эв_СтатусКассовойСмены(ИмяСтатуса)
	
	Если Не ЗначениеЗаполнено(ИмяСтатуса) Тогда
		Возврат Перечисления.СтатусыКассовойСмены.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("ПеречислениеСсылка.СтатусыКассовойСмены"), ИмяСтатуса);
	Исключение
		Возврат Перечисления.СтатусыКассовойСмены.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция эв_ВерсияФорматаЭДО(СтрокаВерсии)
	
	РазрядыВерсии = СтрРазделить(СтрокаВерсии, ".");
	Если РазрядыВерсии.Количество() < 2 Тогда
		Возврат СтрокаВерсии;
	КонецЕсли;
	
	Возврат РазрядыВерсии[0] + "." + РазрядыВерсии[1];
	
КонецФункции

Функция эв_РеквизитыСчетаФактурыПолученного(ДанныеXDTO)
	
	Реквизиты = Новый Структура;
	
	КодВидаОперации = "";
	Если ДанныеXDTO.Свойство("КодВидаОперации", КодВидаОперации)
		И ТипЗнч(КодВидаОперации) = Тип("Строка")
		И ЗначениеЗаполнено(КодВидаОперации) Тогда
		Реквизиты.Вставить("КодВидаОперации", КодВидаОперации);
	КонецЕсли;
	
	СпособВыставления = Неопределено;
	Если ДанныеXDTO.Свойство("СпособВыставления", СпособВыставления) И ЗначениеЗаполнено(СпособВыставления) Тогда
		ИмяСпособа = эв_СтрокаПеречисленияXDTO(СпособВыставления);
		Если ИмяСпособа = "ВЭлектронномВиде" Тогда
			Реквизиты.Вставить("КодСпособаВыставления", 2);
		ИначеЕсли ИмяСпособа = "НаБумажномНосителе" Тогда
			Реквизиты.Вставить("КодСпособаВыставления", 1);
		КонецЕсли;
	КонецЕсли;
	
	ДатаПолучения = Неопределено;
	Если ДанныеXDTO.Свойство("ДатаПолучения", ДатаПолучения) Тогда
		ДатаПолучения = эв_ДатаИзСтроки(ДатаПолучения);
		Если ЗначениеЗаполнено(ДатаПолучения) Тогда
			Реквизиты.Вставить("ДатаПолучения", ДатаПолучения);
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеДанные = эв_ДополнительныеРеквизитыСчетаФактуры(ДанныеXDTO);
	Если ДополнительныеДанные <> Неопределено Тогда
		Если ДополнительныеДанные.Свойство("ДатаПолучения") Тогда
			ДатаПолучения = эв_ДатаИзСтроки(ДополнительныеДанные.ДатаПолучения);
			Если ЗначениеЗаполнено(ДатаПолучения) Тогда
				Реквизиты.Вставить("ДатаПолучения", ДатаПолучения);
			КонецЕсли;
		КонецЕсли;
		Если ДополнительныеДанные.Свойство("Дата") Тогда
			ДатаДокумента = эв_ДатаИзСтроки(ДополнительныеДанные.Дата);
			Если ЗначениеЗаполнено(ДатаДокумента) Тогда
				Реквизиты.Вставить("Дата", ДатаДокумента);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не Реквизиты.Свойство("Дата") И Реквизиты.Свойство("ДатаПолучения")
		И Реквизиты.ДатаПолучения <> НачалоДня(Реквизиты.ДатаПолучения) Тогда
		Реквизиты.Вставить("Дата", Реквизиты.ДатаПолучения);
		Реквизиты.Удалить("ДатаПолучения");
	КонецЕсли;
	
	Возврат Реквизиты;
	
КонецФункции

Функция эв_ДополнительныеРеквизитыСчетаФактуры(ДанныеXDTO)
	
	ДополнительныеДанные = эв_СтруктураAdditionalInfo(ДанныеXDTO);
	Если ДополнительныеДанные <> Неопределено
		И (ДополнительныеДанные.Свойство("Дата") Или ДополнительныеДанные.Свойство("ДатаПолучения")) Тогда
		Возврат ДополнительныеДанные;
	КонецЕсли;
	
	Комментарий = "";
	Если Не ДанныеXDTO.Свойство("КомментарийМногоязычный", Комментарий)
		Или ТипЗнч(Комментарий) <> Тип("Строка")
		Или Не СтрНачинаетсяС(Комментарий, "орСФ:") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Обертка = Новый Структура("AdditionalInfo", Сред(Комментарий, 6));
	Возврат эв_СтруктураAdditionalInfo(Обертка);
	
КонецФункции

Процедура эв_ПрименитьРеквизитыСчетаФактуры(ОбъектДокумента, Реквизиты)
	
	Если Реквизиты.Свойство("КодВидаОперации") Тогда
		ОбъектДокумента.КодВидаОперации = Реквизиты.КодВидаОперации;
	КонецЕсли;
	Если Реквизиты.Свойство("КодСпособаВыставления") Тогда
		ОбъектДокумента.КодСпособаВыставления = Реквизиты.КодСпособаВыставления;
	КонецЕсли;
	Если Реквизиты.Свойство("ДатаПолучения") Тогда
		ОбъектДокумента.ДатаПолучения = Реквизиты.ДатаПолучения;
	КонецЕсли;
	Если Реквизиты.Свойство("Дата") Тогда
		ОбъектДокумента.Дата = Реквизиты.Дата;
	КонецЕсли;
	
КонецПроцедуры

Функция эв_СтрокаПеречисленияXDTO(Значение)
	
	Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Значение") Тогда
		Возврат Строка(Значение.Значение);
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции


	ДопустимыеСвойстваДополнительныхДанных.Добавить("ИдентификаторПлатежа");
	#Вставка
	ДопустимыеСвойстваДополнительныхДанных.Добавить("эв_ЗаказыПокупателейССайта");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("эв_ИсторияСтатусовЗаказов");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("НоменклатураДоставки");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("СтавкаНДСДоставки");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("ВариантЗавершения");

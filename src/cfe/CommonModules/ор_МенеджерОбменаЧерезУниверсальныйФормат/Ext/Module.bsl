		Или ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Тогда
		эв_ЗапомнитьРеквизитыЗаказаИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные);
		эв_УдалитьСтрокуДоставкиПриПолученииЗаказа(ДанныеXDTO, ПолученныеДанные);
	КонецЕсли;
	
	ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;

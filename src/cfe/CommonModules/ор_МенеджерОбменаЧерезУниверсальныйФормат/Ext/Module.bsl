#Область ПрограммныйИнтерфейс

&ИзменениеИКонтроль("ПКО_Справочник_Номенклатура_Получение_ПриКонвертацииДанныхXDTO")
Процедура эв_ПКО_Справочник_Номенклатура_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
	ПолученныеДанные.МетодОценки = Перечисления.МетодОценкиЗапасов.ПоСредней;
	ПолученныеДанные.СчетУчетаЗапасов = Справочники.Номенклатура.СчетУчетаЗапасов();
	ПолученныеДанные.СчетУчетаЗатрат = ПланыСчетов.Управленческий.НезавершенноеПроизводство;
	ПолученныеДанные.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	
	Если ДанныеXDTO.Свойство("СтавкаНДС") Тогда 
		СтавкаНДССсылка = СтавкаНДСПолучение(ДанныеXDTO.СтавкаНДС, КомпонентыОбмена);
		ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ВидСтавки(СтавкаНДССсылка);
	Иначе
		ВидСтавкиНДС = Справочники.Организации.ОсновнаяОрганизация.ВидСтавкиНДСПоУмолчанию;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидСтавкиНДС) Тогда
		ПолученныеДанные.ВидСтавкиНДС = ВидСтавкиНДС;
	КонецЕсли;
	
	ИнструкцияВидНоменклатуры = Новый Структура;
	Если ДанныеXDTO.Свойство("ВидНоменклатуры") Тогда
		ИнструкцияВидНоменклатуры.Вставить("Значение", ДанныеXDTO.ВидНоменклатуры);
		ИнструкцияВидНоменклатуры.Вставить("ИмяПКО", "Справочник_КатегорииНоменклатурыВН_Получение");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнструкцияВидНоменклатуры) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КатегорияНоменклатуры", ИнструкцияВидНоменклатуры);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ВидНоменклатуры") И ЗначениеЗаполнено(ДанныеXDTO.ВидНоменклатуры) Тогда
		Если ДанныеXDTO.ВидНоменклатуры.Свойство("ПродаетсяВРозлив") Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПродаетсяВРозлив", ДанныеXDTO.ВидНоменклатуры.ПродаетсяВРозлив);
		КонецЕсли;	
	КонецЕсли;
		
	Попытка
	
	Если КомпонентыОбмена.УзелКорреспондентаОбъект.ПереноситьКатегорииКакВидыНоменклатуры Тогда
		
		лКатегория = Неопределено;
		Если ДанныеXDTO.Свойство("ВидНоменклатуры") Тогда
			Если ДанныеXDTO.ВидНоменклатуры.Свойство("Ссылка") И ДанныеXDTO.ВидНоменклатуры.Ссылка.Свойство("Значение") Тогда
				Попытка
					лКатегория = Справочники.КатегорииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеXDTO.ВидНоменклатуры.Ссылка.Значение));
				Исключение
				КонецПопытки;
			ИначеЕсли ЗначениеЗаполнено(ДанныеXDTO.ВидНоменклатуры.Наименование) Тогда
				лКатегория = Справочники.КатегорииНоменклатуры.НайтиПоНаименованию(ДанныеXDTO.ВидНоменклатуры.Наименование);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(лКатегория) И ОбщегоНазначения.СсылкаСуществует(лКатегория) Тогда
			ПолученныеДанные.КатегорияНоменклатуры = лКатегория;
		КонецЕсли;
		
		лНаправление = Неопределено;
		Если ДанныеXDTO.Свойство("ГруппаАналитическогоУчета") Тогда
			Если ДанныеXDTO.ГруппаАналитическогоУчета.Свойство("Ссылка") И ДанныеXDTO.ГруппаАналитическогоУчета.Ссылка.Свойство("Значение") Тогда
				Попытка
					лНаправление = Справочники.НаправленияДеятельности.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеXDTO.ГруппаАналитическогоУчета.Ссылка.Значение));
				Исключение
				КонецПопытки;
			ИначеЕсли ЗначениеЗаполнено(ДанныеXDTO.ГруппаАналитическогоУчета.Наименование) Тогда
				лНаправление = Справочники.НаправленияДеятельности.НайтиПоНаименованию(ДанныеXDTO.ГруппаАналитическогоУчета.Наименование);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(лНаправление) И ОбщегоНазначения.СсылкаСуществует(лНаправление) Тогда
			ПолученныеДанные.НаправлениеДеятельности = лНаправление;
		КонецЕсли;
		
	КонецЕсли;
	
	Исключение
	КонецПопытки;
	
	Если ДанныеXDTO.Свойство("ВидПродукцииИС") И ЗначениеЗаполнено(ДанныеXDTO.ВидПродукцииИС) Тогда
		ПКПД = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("Перечисление_ВидыПродукцииИС", "ИмяПКПД");
		ВидПродукцииИС = ПКПД.КонвертацииЗначенийПриПолучении.Получить(ДанныеXDTO.ВидПродукцииИС.Значение);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидПродукцииИС", ВидПродукцииИС);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") 
		И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда
		
		Если ДанныеXDTO.AdditionalInfo.Свойство("ВидПродукцииИС") Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидПродукцииИС", ДанныеXDTO.AdditionalInfo.ВидПродукцииИС);
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьКодТНВЭДВДопСвойства(ПолученныеДанные, ДанныеXDTO, "ТоварнаяНоменклатураВЭД", "КодТНВЭД", КомпонентыОбмена);
	
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") И ДанныеXDTO.КлючевыеСвойства.Свойство("Группа") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Родитель", ДанныеXDTO.КлючевыеСвойства.Группа);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) = ВерсияФорматаЧислом("1.14") Тогда
		Если ДанныеXDTO.Свойство("ПризнакПредметаРасчета") 
			И ЗначениеЗаполнено(ДанныеXDTO.ПризнакПредметаРасчета) Тогда
	
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПризнакПредметаРасчета",
				Новый Структура("Значение, ИмяПКО", ДанныеXDTO.ПризнакПредметаРасчета, "Перечисление_ПризнакиПредметаРасчета14"));
		КонецЕсли;
	КонецЕсли;
	
	// ор ++.
	Если ДанныеXDTO.Свойство("ор_АТХКлассификация") И ЗначениеЗаполнено(ДанныеXDTO.ор_АТХКлассификация) Тогда
		
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("АТХ", "АТХ");
		
		МассивСтрокАТХ = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.ор_АТХКлассификация Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			МассивСтрокАТХ.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокАТХ.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ор_АТХКлассификация", МассивСтрокАТХ);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ор_ФармакологическиеГруппы") И ЗначениеЗаполнено(ДанныеXDTO.ор_ФармакологическиеГруппы) Тогда
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ФармакологическаяГруппа", "ФармакологическаяГруппа");
		
		МассивСтрокФармакологическиеГруппы = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.ор_ФармакологическиеГруппы Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			МассивСтрокФармакологическиеГруппы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокФармакологическиеГруппы.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ор_ФармакологическиеГруппы", МассивСтрокФармакологическиеГруппы);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ор_Нозологии") И ЗначениеЗаполнено(ДанныеXDTO.ор_Нозологии) Тогда
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("Нозология", "Нозология");
		
		МассивСтрокФармакологическиеГруппы = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.ор_Нозологии Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			МассивСтрокФармакологическиеГруппы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокФармакологическиеГруппы.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ор_Нозологии", МассивСтрокФармакологическиеГруппы);
		КонецЕсли;
	КонецЕсли;
	
	// +ор Обмен с УА3
	#Удаление
	Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда
	#КонецУдаления
	#Вставка
	Если ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура")
		И ДанныеXDTO.Свойство("AdditionalInfo") Тогда
	#КонецВставки
		AdditionalInfo = ДанныеXDTO.AdditionalInfo;
		Если AdditionalInfo.Свойство("ОсобенностьУчета") Тогда
			Если Не AdditionalInfo.ОсобенностьУчета = "ПродукцияМаркируемаяДляМДЛП" Тогда
				СтрокаПравил = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.НайтиСтроки(Новый Структура("ИмяПКПД", "Перечисление_ВидыПродукцииИС"));
				Если СтрокаПравил.Количество() > 0 Тогда
					ВидПродукцииИС = СтрокаПравил[0].КонвертацииЗначенийПриПолучении.Получить(AdditionalInfo.ОсобенностьУчета);
					Если ВидПродукцииИС <> Неопределено Тогда
						ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидПродукцииИС", ВидПродукцииИС);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// -ор Обмен с УА3
	#Вставка
	эв_ЗагрузитьРеквизитыНоменклатурыИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные);
	#КонецВставки
	
	// ор --.
	
	Если (КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменКасса") Тогда
		Если ДанныеXDTO.Свойство("ДополнительныеРеквизиты") Тогда
			Для каждого Строка Из ДанныеXDTO.ДополнительныеРеквизиты Цикл
				Если Строка.Свойство.Наименование = "ЦенаПродажи" Тогда
					ПолученныеДанные.ДополнительныеСвойства.Вставить("ЦенаПродажи", Строка.ЗначениеСвойства);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_Номенклатура_Получение_ПередЗаписьюПолученныхДанных")
Процедура эв_ПКО_Справочник_Номенклатура_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено Тогда
	
		Если ПолученныеДанные.КодМедицинскогоИзделия = "" Тогда
		    ПолученныеДанные.КодМедицинскогоИзделия = ДанныеИБ.КодМедицинскогоИзделия;
		КонецЕсли;
		
		ПолученныеДанные.СпособПополнения = ДанныеИБ.СпособПополнения;
		ПолученныеДанные.МетодОценки = ДанныеИБ.МетодОценки;
		ПолученныеДанные.СчетУчетаЗапасов = ДанныеИБ.СчетУчетаЗапасов;
		ПолученныеДанные.СчетУчетаЗатрат = ДанныеИБ.СчетУчетаЗатрат;
		ПолученныеДанные.НаправлениеДеятельности = ДанныеИБ.НаправлениеДеятельности;
		
		Если ЗначениеЗаполнено(ПолученныеДанные.ВидСтавкиНДС) Тогда
			ДанныеИБ.ВидСтавкиНДС = ПолученныеДанные.ВидСтавкиНДС;
		КонецЕсли;
		
		Если ДанныеИБ.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПодарочныйСертификат Тогда
			ПолученныеДанные.ТипНоменклатуры = ДанныеИБ.ТипНоменклатуры;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПолученныеДанные.ТипНоменклатуры) Тогда
			ПолученныеДанные.ТипНоменклатуры = ДанныеИБ.ТипНоменклатуры;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПолученныеДанные.ТоварнаяНоменклатураВЭД) Тогда
			ПолученныеДанные.ТоварнаяНоменклатураВЭД = ДанныеИБ.ТоварнаяНоменклатураВЭД;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.КатегорияНоменклатуры) Тогда
			ПолученныеДанные.КатегорияНоменклатуры = ДанныеИБ.КатегорияНоменклатуры;
		КонецЕсли;
		
		Если НЕ ПолученныеДанные.ДополнительныеСвойства.Свойство("Родитель") Тогда
			ПолученныеДанные.Родитель = ДанныеИБ.Родитель;
		КонецЕсли;
		
		Если ПолученныеДанные.ИспользоватьСерииНоменклатуры Тогда
			ПолученныеДанные.ПолитикаУчетаСерий = ДанныеИБ.ПолитикаУчетаСерий;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.ТипНоменклатуры) Тогда
		ПолученныеДанные.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.КатегорияНоменклатуры) Тогда
		ПолученныеДанные.ИспользоватьХарактеристики = ПолученныеДанные.КатегорияНоменклатуры.ИспользоватьХарактеристики;
	КонецЕсли;
	#Вставка
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("эв_ИспользоватьХарактеристики") Тогда
		ПолученныеДанные.ИспользоватьХарактеристики = ПолученныеДанные.ДополнительныеСвойства.эв_ИспользоватьХарактеристики;
	КонецЕсли;
	#КонецВставки
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.КатегорияНоменклатуры) Тогда
		ПолученныеДанные.КатегорияНоменклатуры = Справочники.КатегорииНоменклатуры.БезКатегории;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ВидПродукцииИС")
		И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ВидПродукцииИС) Тогда
		
		ВидПродукцииИС = ПолученныеДанные.ДополнительныеСвойства.ВидПродукцииИС;
		ЗаполнитьПризнакиВидаПродукцииИС(ПолученныеДанные, ДанныеИБ, ВидПродукцииИС);
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено
		И ПолученныеДанные.ИспользоватьСерииНоменклатуры Тогда
		ПолученныеДанные.ПолитикаУчетаСерий = КомпонентыОбмена.ПараметрыКонвертации.ПолитикаУчетаСерийПоУмолчанию;
	КонецЕсли;	
	
	Если (КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменКасса")
		И ПолученныеДанные.ДополнительныеСвойства.Свойство("ЦенаПродажи")
		И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ЦенаПродажи) Тогда
			НоменклатураСсылка = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
			ЗаписатьРозничныеЦены(НоменклатураСсылка, ПолученныеДанные.ЕдиницаИзмерения, ПолученныеДанные.ДополнительныеСвойства.ЦенаПродажи);
	КонецЕсли;
	#Вставка
	эв_ЗаписатьУчетнуюЦенуНоменклатуры(ПолученныеДанные, ДанныеИБ);
	#КонецВставки
КонецПроцедуры

&После("ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных")
Процедура эв_ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если СтекВыгрузки.Количество() > 1
		Или ТипЗнч(ДанныеИБ) = Тип("Структура")
		Или ДанныеИБ.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеXDTO.Свойство("AdditionalInfo")
		Или ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ДанныеXDTO.AdditionalInfo);
		ДополнительнаяИнформация = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	ДополнительнаяИнформация = эв_СтруктураИзДанныхJSON(ДополнительнаяИнформация);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОбъекта = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ДополнительныеРеквизитыОбъекта", РеквизитыОбъекта) Тогда
		РеквизитыОбъекта = эв_СтруктураИзДанныхJSON(РеквизитыОбъекта);
	КонецЕсли;
	Если РеквизитыОбъекта = Неопределено Тогда
		РеквизитыОбъекта = Новый Структура;
	КонецЕсли;
	
	РеквизитыОбъекта.Вставить("эвНеВходитВАссортиментСберСпасибо", ДанныеИБ.эвНеВходитВАссортиментСберСпасибо);
	ДополнительнаяИнформация.Вставить("ДополнительныеРеквизитыОбъекта", РеквизитыОбъекта);
	ДанныеXDTO.Вставить("AdditionalInfo", эв_JSONИзСтруктуры(ДополнительнаяИнформация));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура эв_ЗагрузитьРеквизитыНоменклатурыИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные)
	Если ПолученныеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Если Не ДанныеXDTO.Свойство("AdditionalInfo")
		Или ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ДанныеXDTO.AdditionalInfo);
		ДополнительнаяИнформация = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	ДополнительнаяИнформация = эв_СтруктураИзДанныхJSON(ДополнительнаяИнформация);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОбъекта = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ДополнительныеРеквизитыОбъекта", РеквизитыОбъекта) Тогда
		РеквизитыОбъекта = эв_СтруктураИзДанныхJSON(РеквизитыОбъекта);
		Если РеквизитыОбъекта <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, РеквизитыОбъекта);
			НеВходитВАссортиментСберСпасибо = Неопределено;
			Если РеквизитыОбъекта.Свойство("эвНеВходитВАссортиментСберСпасибо", НеВходитВАссортиментСберСпасибо) Тогда
				ПолученныеДанные.эвНеВходитВАссортиментСберСпасибо = НеВходитВАссортиментСберСпасибо;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИспользоватьХарактеристики = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ИспользоватьХарактеристики", ИспользоватьХарактеристики) Тогда
		ПолученныеДанные.ИспользоватьХарактеристики = ИспользоватьХарактеристики;
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ИспользоватьХарактеристики", ИспользоватьХарактеристики);
	КонецЕсли;
	
	ЗаполнятьХарактеристикуОбязательно = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ЗаполнятьХарактеристикуОбязательно", ЗаполнятьХарактеристикуОбязательно) Тогда
		ПолученныеДанные.ПроверятьЗаполнениеХарактеристики = ЗаполнятьХарактеристикуОбязательно;
	КонецЕсли;
	
	Недействителен = Неопределено;
	Если ДополнительнаяИнформация.Свойство("Недействителен", Недействителен) Тогда
		ПолученныеДанные.Недействителен = Недействителен;
	КонецЕсли;
	
	КодПризнакаПредметаРасчета = Неопределено;
	Если ДополнительнаяИнформация.Свойство("КодПризнакаПредметаРасчета", КодПризнакаПредметаРасчета)
		И ТипЗнч(КодПризнакаПредметаРасчета) = Тип("Число") Тогда
		ПризнакПредметаРасчета = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПризнакПредметаРасчетаПоКоду(КодПризнакаПредметаРасчета);
		Если ЗначениеЗаполнено(ПризнакПредметаРасчета) Тогда
			ПолученныеДанные.ПризнакПредметаРасчета = ПризнакПредметаРасчета;
		КонецЕсли;
	КонецЕсли;
	
	Цена = Неопределено;
	Если ДополнительнаяИнформация.Свойство("Цена", Цена) И ТипЗнч(Цена) = Тип("Число") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_УчетнаяЦена", Цена);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ЗаписатьУчетнуюЦенуНоменклатуры(ПолученныеДанные, ДанныеИБ)
	
	Цена = Неопределено;
	Если ПолученныеДанные.ЭтоГруппа
		Или Не ПолученныеДанные.ДополнительныеСвойства.Свойство("эв_УчетнаяЦена", Цена) Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	ВидЦен = Справочники.ВидыЦен.Учетная;
	Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидЦен", ВидЦен);
	Отбор.Вставить("Номенклатура", Номенклатура);
	Отбор.Вставить("Характеристика", Характеристика);
	Срез = РегистрыСведений.ЦеныНоменклатуры.СрезПоследних(ТекущаяДатаСеанса(), Отбор);
	Если Срез.Количество() > 0 И Срез[0].Цена = Цена Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = НачалоДня(ТекущаяДатаСеанса());
	МенеджерЗаписи.ВидЦен = ВидЦен;
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.Характеристика = Характеристика;
	МенеджерЗаписи.Цена = Цена;
	МенеджерЗаписи.ЕдиницаИзмерения = ПолученныеДанные.ЕдиницаИзмерения;
	МенеджерЗаписи.Актуальность = Истина;
	МенеджерЗаписи.ВалютаЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦен, "ВалютаЦены");
	МенеджерЗаписи.ОбменДанными.Загрузка = Истина;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Функция эв_JSONИзСтруктуры(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция эв_СтруктураИзДанныхJSON(Данные)
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Возврат Данные;
	КонецЕсли;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Данные Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

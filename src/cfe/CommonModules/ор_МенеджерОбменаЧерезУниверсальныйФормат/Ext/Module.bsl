&Вместо("ПКО_Документ_ОтчетОРозничныхПродажах_Отправка_ПриОтправкеДанных")
Процедура эв_ПКО_Документ_ОтчетОРозничныхПродажах_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Тогда
		ПродолжитьВызов(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
		Возврат;
	КонецЕсли;
	Если ДанныеXDTO = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтекВыгрузки.Количество() <= 1 Тогда
		эв_ЗаполнитьВыгрузкуОтчетаРозничныхПродаж(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена);
	ИначеЕсли Не ДанныеИБ.ДополнительныеСвойства.Свойство("эв_ВыгрузкаНепроведенногоПоСсылке") Тогда
		Возврат;
	КонецЕсли;
	
	КассовыеДанные = Новый Структура;
	КассовыеДанные.Вставить("Проведен", ДанныеИБ.Проведен);
	КассовыеДанные.Вставить("СтатусКассовойСмены", эв_ИмяЗначенияПеречисления(ДанныеИБ.СтатусКассовойСмены));
	КассовыеДанные.Вставить("НачалоКассовойСмены", эв_ДатаВСтроку(ДанныеИБ.НачалоКассовойСмены));
	КассовыеДанные.Вставить("ОкончаниеКассовойСмены", эв_ДатаВСтроку(ДанныеИБ.ОкончаниеКассовойСмены));
	КассовыеДанные.Вставить("КассоваяСмена", эв_ОписаниеКассовогоДокумента(ДанныеИБ.КассоваяСмена));
	КассовыеДанные.Вставить("СуммаПредоплаты", ДанныеИБ.СуммаПредоплаты);
	КассовыеДанные.Вставить("ПолученаПредоплата", ДанныеИБ.ПолученаПредоплата);
	КассовыеДанные.Вставить("ОптимизированнаяСхемаДвижений", ДанныеИБ.ОптимизированнаяСхемаДвижений);
	КассовыеДанные.Вставить("ПолноеПроведение", эв_ПолноеПроведениеОтчета(ДанныеИБ));
	ЗаказыСтрок = эв_ОписаниеЗаказовСтрокОтчета(ДанныеИБ, ДанныеXDTO);
	Если ЗаказыСтрок.Количество() > 0 Тогда
		КассовыеДанные.Вставить("ЗаказыСтрок", ЗаказыСтрок);
	КонецЕсли;
	эв_ДобавитьКассовыеДанные(ДанныеXDTO, КассовыеДанные);
	
КонецПроцедуры


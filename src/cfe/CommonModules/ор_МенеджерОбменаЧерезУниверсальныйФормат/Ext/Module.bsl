#Область ПрограммныйИнтерфейс

&ИзменениеИКонтроль("ПКО_Справочник_Номенклатура_Получение_ПриКонвертацииДанныхXDTO")
Процедура эв_ПКО_Справочник_Номенклатура_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
	ПолученныеДанные.МетодОценки = Перечисления.МетодОценкиЗапасов.ПоСредней;
	ПолученныеДанные.СчетУчетаЗапасов = Справочники.Номенклатура.СчетУчетаЗапасов();
	ПолученныеДанные.СчетУчетаЗатрат = ПланыСчетов.Управленческий.НезавершенноеПроизводство;
	ПолученныеДанные.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	
	Если ДанныеXDTO.Свойство("СтавкаНДС") Тогда 
		СтавкаНДССсылка = СтавкаНДСПолучение(ДанныеXDTO.СтавкаНДС, КомпонентыОбмена);
		ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ВидСтавки(СтавкаНДССсылка);
	Иначе
		ВидСтавкиНДС = Справочники.Организации.ОсновнаяОрганизация.ВидСтавкиНДСПоУмолчанию;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидСтавкиНДС) Тогда
		ПолученныеДанные.ВидСтавкиНДС = ВидСтавкиНДС;
	КонецЕсли;
	
	ИнструкцияВидНоменклатуры = Новый Структура;
	Если ДанныеXDTO.Свойство("ВидНоменклатуры") Тогда
		ИнструкцияВидНоменклатуры.Вставить("Значение", ДанныеXDTO.ВидНоменклатуры);
		ИнструкцияВидНоменклатуры.Вставить("ИмяПКО", "Справочник_КатегорииНоменклатурыВН_Получение");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнструкцияВидНоменклатуры) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КатегорияНоменклатуры", ИнструкцияВидНоменклатуры);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ВидНоменклатуры") И ЗначениеЗаполнено(ДанныеXDTO.ВидНоменклатуры) Тогда
		Если ДанныеXDTO.ВидНоменклатуры.Свойство("ПродаетсяВРозлив") Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПродаетсяВРозлив", ДанныеXDTO.ВидНоменклатуры.ПродаетсяВРозлив);
		КонецЕсли;	
	КонецЕсли;
		
	Попытка
	
	Если КомпонентыОбмена.УзелКорреспондентаОбъект.ПереноситьКатегорииКакВидыНоменклатуры Тогда
		
		лКатегория = Неопределено;
		Если ДанныеXDTO.Свойство("ВидНоменклатуры") Тогда
			Если ДанныеXDTO.ВидНоменклатуры.Свойство("Ссылка") И ДанныеXDTO.ВидНоменклатуры.Ссылка.Свойство("Значение") Тогда
				Попытка
					лКатегория = Справочники.КатегорииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеXDTO.ВидНоменклатуры.Ссылка.Значение));
				Исключение
				КонецПопытки;
			ИначеЕсли ЗначениеЗаполнено(ДанныеXDTO.ВидНоменклатуры.Наименование) Тогда
				лКатегория = Справочники.КатегорииНоменклатуры.НайтиПоНаименованию(ДанныеXDTO.ВидНоменклатуры.Наименование);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(лКатегория) И ОбщегоНазначения.СсылкаСуществует(лКатегория) Тогда
			ПолученныеДанные.КатегорияНоменклатуры = лКатегория;
		КонецЕсли;
		
		лНаправление = Неопределено;
		Если ДанныеXDTO.Свойство("ГруппаАналитическогоУчета") Тогда
			Если ДанныеXDTO.ГруппаАналитическогоУчета.Свойство("Ссылка") И ДанныеXDTO.ГруппаАналитическогоУчета.Ссылка.Свойство("Значение") Тогда
				Попытка
					лНаправление = Справочники.НаправленияДеятельности.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеXDTO.ГруппаАналитическогоУчета.Ссылка.Значение));
				Исключение
				КонецПопытки;
			ИначеЕсли ЗначениеЗаполнено(ДанныеXDTO.ГруппаАналитическогоУчета.Наименование) Тогда
				лНаправление = Справочники.НаправленияДеятельности.НайтиПоНаименованию(ДанныеXDTO.ГруппаАналитическогоУчета.Наименование);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(лНаправление) И ОбщегоНазначения.СсылкаСуществует(лНаправление) Тогда
			ПолученныеДанные.НаправлениеДеятельности = лНаправление;
		КонецЕсли;
		
	КонецЕсли;
	
	Исключение
	КонецПопытки;
	
	Если ДанныеXDTO.Свойство("ВидПродукцииИС") И ЗначениеЗаполнено(ДанныеXDTO.ВидПродукцииИС) Тогда
		ПКПД = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("Перечисление_ВидыПродукцииИС", "ИмяПКПД");
		ВидПродукцииИС = ПКПД.КонвертацииЗначенийПриПолучении.Получить(ДанныеXDTO.ВидПродукцииИС.Значение);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидПродукцииИС", ВидПродукцииИС);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") 
		И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда
		
		Если ДанныеXDTO.AdditionalInfo.Свойство("ВидПродукцииИС") Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидПродукцииИС", ДанныеXDTO.AdditionalInfo.ВидПродукцииИС);
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьКодТНВЭДВДопСвойства(ПолученныеДанные, ДанныеXDTO, "ТоварнаяНоменклатураВЭД", "КодТНВЭД", КомпонентыОбмена);
	
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") И ДанныеXDTO.КлючевыеСвойства.Свойство("Группа") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Родитель", ДанныеXDTO.КлючевыеСвойства.Группа);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) = ВерсияФорматаЧислом("1.14") Тогда
		Если ДанныеXDTO.Свойство("ПризнакПредметаРасчета") 
			И ЗначениеЗаполнено(ДанныеXDTO.ПризнакПредметаРасчета) Тогда
	
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПризнакПредметаРасчета",
				Новый Структура("Значение, ИмяПКО", ДанныеXDTO.ПризнакПредметаРасчета, "Перечисление_ПризнакиПредметаРасчета14"));
		КонецЕсли;
	КонецЕсли;
	
	// ор ++.
	Если ДанныеXDTO.Свойство("ор_АТХКлассификация") И ЗначениеЗаполнено(ДанныеXDTO.ор_АТХКлассификация) Тогда
		
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("АТХ", "АТХ");
		
		МассивСтрокАТХ = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.ор_АТХКлассификация Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			МассивСтрокАТХ.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокАТХ.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ор_АТХКлассификация", МассивСтрокАТХ);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ор_ФармакологическиеГруппы") И ЗначениеЗаполнено(ДанныеXDTO.ор_ФармакологическиеГруппы) Тогда
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ФармакологическаяГруппа", "ФармакологическаяГруппа");
		
		МассивСтрокФармакологическиеГруппы = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.ор_ФармакологическиеГруппы Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			МассивСтрокФармакологическиеГруппы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокФармакологическиеГруппы.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ор_ФармакологическиеГруппы", МассивСтрокФармакологическиеГруппы);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ор_Нозологии") И ЗначениеЗаполнено(ДанныеXDTO.ор_Нозологии) Тогда
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("Нозология", "Нозология");
		
		МассивСтрокФармакологическиеГруппы = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.ор_Нозологии Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			МассивСтрокФармакологическиеГруппы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокФармакологическиеГруппы.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ор_Нозологии", МассивСтрокФармакологическиеГруппы);
		КонецЕсли;
	КонецЕсли;
	
	// +ор Обмен с УА3
	#Удаление
	Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда
	#КонецУдаления
	#Вставка
	Если ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура")
		И ДанныеXDTO.Свойство("AdditionalInfo") Тогда
	#КонецВставки
		AdditionalInfo = ДанныеXDTO.AdditionalInfo;
		Если AdditionalInfo.Свойство("ОсобенностьУчета") Тогда
			Если Не AdditionalInfo.ОсобенностьУчета = "ПродукцияМаркируемаяДляМДЛП" Тогда
				СтрокаПравил = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.НайтиСтроки(Новый Структура("ИмяПКПД", "Перечисление_ВидыПродукцииИС"));
				Если СтрокаПравил.Количество() > 0 Тогда
					ВидПродукцииИС = СтрокаПравил[0].КонвертацииЗначенийПриПолучении.Получить(AdditionalInfo.ОсобенностьУчета);
					Если ВидПродукцииИС <> Неопределено Тогда
						ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидПродукцииИС", ВидПродукцииИС);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// -ор Обмен с УА3
	#Вставка
	эв_ЗагрузитьРеквизитыНоменклатурыИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные);
	#КонецВставки
	
	// ор --.
	
	Если (КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменКасса") Тогда
		Если ДанныеXDTO.Свойство("ДополнительныеРеквизиты") Тогда
			Для каждого Строка Из ДанныеXDTO.ДополнительныеРеквизиты Цикл
				Если Строка.Свойство.Наименование = "ЦенаПродажи" Тогда
					ПолученныеДанные.ДополнительныеСвойства.Вставить("ЦенаПродажи", Строка.ЗначениеСвойства);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_Номенклатура_Получение_ПередЗаписьюПолученныхДанных")
Процедура эв_ПКО_Справочник_Номенклатура_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено Тогда
	
		Если ПолученныеДанные.КодМедицинскогоИзделия = "" Тогда
		    ПолученныеДанные.КодМедицинскогоИзделия = ДанныеИБ.КодМедицинскогоИзделия;
		КонецЕсли;
		
		ПолученныеДанные.СпособПополнения = ДанныеИБ.СпособПополнения;
		ПолученныеДанные.МетодОценки = ДанныеИБ.МетодОценки;
		ПолученныеДанные.СчетУчетаЗапасов = ДанныеИБ.СчетУчетаЗапасов;
		ПолученныеДанные.СчетУчетаЗатрат = ДанныеИБ.СчетУчетаЗатрат;
		ПолученныеДанные.НаправлениеДеятельности = ДанныеИБ.НаправлениеДеятельности;
		
		Если ЗначениеЗаполнено(ПолученныеДанные.ВидСтавкиНДС) Тогда
			ДанныеИБ.ВидСтавкиНДС = ПолученныеДанные.ВидСтавкиНДС;
		КонецЕсли;
		
		Если ДанныеИБ.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПодарочныйСертификат Тогда
			ПолученныеДанные.ТипНоменклатуры = ДанныеИБ.ТипНоменклатуры;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПолученныеДанные.ТипНоменклатуры) Тогда
			ПолученныеДанные.ТипНоменклатуры = ДанныеИБ.ТипНоменклатуры;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПолученныеДанные.ТоварнаяНоменклатураВЭД) Тогда
			ПолученныеДанные.ТоварнаяНоменклатураВЭД = ДанныеИБ.ТоварнаяНоменклатураВЭД;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.КатегорияНоменклатуры) Тогда
			ПолученныеДанные.КатегорияНоменклатуры = ДанныеИБ.КатегорияНоменклатуры;
		КонецЕсли;
		
		Если НЕ ПолученныеДанные.ДополнительныеСвойства.Свойство("Родитель") Тогда
			ПолученныеДанные.Родитель = ДанныеИБ.Родитель;
		КонецЕсли;
		
		Если ПолученныеДанные.ИспользоватьСерииНоменклатуры Тогда
			ПолученныеДанные.ПолитикаУчетаСерий = ДанныеИБ.ПолитикаУчетаСерий;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.ТипНоменклатуры) Тогда
		ПолученныеДанные.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.КатегорияНоменклатуры) Тогда
		ПолученныеДанные.ИспользоватьХарактеристики = ПолученныеДанные.КатегорияНоменклатуры.ИспользоватьХарактеристики;
	КонецЕсли;
	#Вставка
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("эв_ИспользоватьХарактеристики") Тогда
		ПолученныеДанные.ИспользоватьХарактеристики = ПолученныеДанные.ДополнительныеСвойства.эв_ИспользоватьХарактеристики;
	КонецЕсли;
	#КонецВставки
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.КатегорияНоменклатуры) Тогда
		ПолученныеДанные.КатегорияНоменклатуры = Справочники.КатегорииНоменклатуры.БезКатегории;
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ВидПродукцииИС")
		И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ВидПродукцииИС) Тогда
		
		ВидПродукцииИС = ПолученныеДанные.ДополнительныеСвойства.ВидПродукцииИС;
		ЗаполнитьПризнакиВидаПродукцииИС(ПолученныеДанные, ДанныеИБ, ВидПродукцииИС);
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено
		И ПолученныеДанные.ИспользоватьСерииНоменклатуры Тогда
		ПолученныеДанные.ПолитикаУчетаСерий = КомпонентыОбмена.ПараметрыКонвертации.ПолитикаУчетаСерийПоУмолчанию;
	КонецЕсли;	
	
	Если (КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменКасса")
		И ПолученныеДанные.ДополнительныеСвойства.Свойство("ЦенаПродажи")
		И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ЦенаПродажи) Тогда
			НоменклатураСсылка = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
			ЗаписатьРозничныеЦены(НоменклатураСсылка, ПолученныеДанные.ЕдиницаИзмерения, ПолученныеДанные.ДополнительныеСвойства.ЦенаПродажи);
	КонецЕсли;
	#Вставка
	эв_ЗаписатьУчетнуюЦенуНоменклатуры(ПолученныеДанные, ДанныеИБ);
	#КонецВставки
КонецПроцедуры

&После("ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных")
Процедура эв_ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если СтекВыгрузки.Количество() > 1
		Или ТипЗнч(ДанныеИБ) = Тип("Структура")
		Или ДанныеИБ.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеXDTO.Свойство("AdditionalInfo")
		Или ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ДанныеXDTO.AdditionalInfo);
		ДополнительнаяИнформация = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	ДополнительнаяИнформация = эв_СтруктураИзДанныхJSON(ДополнительнаяИнформация);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОбъекта = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ДополнительныеРеквизитыОбъекта", РеквизитыОбъекта) Тогда
		РеквизитыОбъекта = эв_СтруктураИзДанныхJSON(РеквизитыОбъекта);
	КонецЕсли;
	Если РеквизитыОбъекта = Неопределено Тогда
		РеквизитыОбъекта = Новый Структура;
	КонецЕсли;
	
	РеквизитыОбъекта.Вставить("эвНеВходитВАссортиментСберСпасибо", ДанныеИБ.эвНеВходитВАссортиментСберСпасибо);
	ДополнительнаяИнформация.Вставить("ДополнительныеРеквизитыОбъекта", РеквизитыОбъекта);
	ДанныеXDTO.Вставить("AdditionalInfo", эв_JSONИзСтруктуры(ДополнительнаяИнформация));
	
КонецПроцедуры

&После("ПКО_Документ_ЗаказПокупателя_Отправка_ПриОтправкеДанных")
Процедура эв_ПКО_Документ_ЗаказПокупателя_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если СтекВыгрузки.Количество() > 1
		Или ТипЗнч(ДанныеИБ) = Тип("Структура")
		Или Не ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Тогда
		эв_УдалитьСтрокуДоставкиИзВыгрузкиЗаказа(ДанныеXDTO, ДанныеИБ);
		эв_ДополнитьВыгрузкуРеквизитовЗаказа(ДанныеИБ, ДанныеXDTO);
	КонецЕсли;
	
	ЗаказыССайта = эв_ВыгрузитьЗаказыПокупателейССайта(ДанныеИБ.Ссылка);
	ИсторияСтатусов = эв_ВыгрузитьИсториюСтатусовЗаказов(ДанныеИБ.Ссылка);
	Если ЗаказыССайта.Количество() = 0 И ИсторияСтатусов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительнаяИнформация = эв_СтруктураAdditionalInfo(ДанныеXDTO);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Если ДанныеXDTO.Свойство("AdditionalInfo")
			И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Строка")
			И ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
			Возврат;
		КонецЕсли;
		ДополнительнаяИнформация = Новый Структура;
	КонецЕсли;
	
	Если ЗаказыССайта.Количество() > 0 Тогда
		ДополнительнаяИнформация.Вставить("эв_ЗаказыПокупателейССайта", ЗаказыССайта);
	КонецЕсли;
	Если ИсторияСтатусов.Количество() > 0 Тогда
		ДополнительнаяИнформация.Вставить("эв_ИсторияСтатусовЗаказов", ИсторияСтатусов);
	КонецЕсли;
	ДанныеXDTO.AdditionalInfo = эв_JSONИзСтруктуры(ДополнительнаяИнформация);
	
КонецПроцедуры

&ИзменениеИКонтроль("ПОД_Документ_ЗаказПокупателя_Получение_ПриОбработке")
Процедура эв_ПОД_Документ_ЗаказПокупателя_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	Если НЕ ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ДанныеXDTO.AdditionalInfo);
	ДополнительныеДанные = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	AdditionalInfo = Новый Структура;
	
	Если ДополнительныеДанные.Свойство("СостояниеЗаказа") Тогда
		AdditionalInfo.Вставить("СостояниеЗаказа", Новый Структура);
		Если ДополнительныеДанные.СостояниеЗаказа.Свойство("Ссылка") Тогда
			AdditionalInfo.СостояниеЗаказа.Вставить("Ссылка", Справочники.СостоянияЗаказовПокупателей.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ДополнительныеДанные.СостояниеЗаказа.Ссылка)));
		КонецЕсли;
		#Вставка
		Если ДополнительныеДанные.СостояниеЗаказа.Свойство("Наименование") Тогда
			AdditionalInfo.СостояниеЗаказа.Вставить("Наименование", ДополнительныеДанные.СостояниеЗаказа.Наименование);
		КонецЕсли;
		#КонецВставки
		Если ДополнительныеДанные.СостояниеЗаказа.Свойство("ЗавершенУспешно") Тогда
			AdditionalInfo.СостояниеЗаказа.Вставить("ЗавершенУспешно", ДополнительныеДанные.СостояниеЗаказа.ЗавершенУспешно);
		КонецЕсли;
		Если ДополнительныеДанные.СостояниеЗаказа.Свойство("ПричинаОтмены") Тогда
			AdditionalInfo.СостояниеЗаказа.Вставить("ПричинаОтмены", ДополнительныеДанные.СостояниеЗаказа.ПричинаОтмены);
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеДанные.Свойство("ВидЗаказа") Тогда
		AdditionalInfo.Вставить("ВидЗаказа", Новый Структура);
		Если ДополнительныеДанные.ВидЗаказа.Свойство("Ссылка") Тогда
			AdditionalInfo.ВидЗаказа.Вставить("Ссылка", Справочники.ВидыЗаказовПокупателей.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ДополнительныеДанные.ВидЗаказа.Ссылка)));
		КонецЕсли;
		#Вставка
		Если ДополнительныеДанные.ВидЗаказа.Свойство("Наименование") Тогда
			AdditionalInfo.ВидЗаказа.Вставить("Наименование", ДополнительныеДанные.ВидЗаказа.Наименование);
		КонецЕсли;
		#КонецВставки
	КонецЕсли;
	
	ДопустимыеСвойстваДополнительныхДанных = Новый Массив;
	ДопустимыеСвойстваДополнительныхДанных.Добавить("СформироватьСсылкуДляОплатыВПриложении");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("СпособДоставки");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("ПунктВыдачиЗаказаУникальныйИдентификатор");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("СуммаДоставки");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("ПараметрыПоискаКонтрагента");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("ИдентификаторПлатежа");
	#Вставка
	ДопустимыеСвойстваДополнительныхДанных.Добавить("эв_ЗаказыПокупателейССайта");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("эв_ИсторияСтатусовЗаказов");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("НоменклатураДоставки");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("СтавкаНДСДоставки");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("ВариантЗавершения");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("ПричинаОтмены");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("Заметки");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("КонтактныйТелефон");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("ПочтаПолучателя");
	ДопустимыеСвойстваДополнительныхДанных.Добавить("АдресСайта");
	#КонецВставки
	Для каждого ИмяСвойства Из ДопустимыеСвойстваДополнительныхДанных Цикл
		Если ДополнительныеДанные.Свойство(ИмяСвойства) Тогда
			AdditionalInfo.Вставить(ИмяСвойства, ДополнительныеДанные[ИмяСвойства]);
		КонецЕсли;
	КонецЦикла;
	
	Если AdditionalInfo.Количество() <> 0 Тогда
		ДанныеXDTO.Вставить("AdditionalInfo", AdditionalInfo);
	КонецЕсли;
КонецПроцедуры

&После("ПКО_Документ_ЗаказПокупателя_Получение_ПриКонвертацииДанныхXDTO")
Процедура эв_ПКО_Документ_ЗаказПокупателя_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если ЭтоЗагрузкаКлючевыхСвойств(ДанныеXDTO)
		Или Не ДанныеXDTO.Свойство("AdditionalInfo")
		Или ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Тогда
		эв_ЗапомнитьРеквизитыЗаказаИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные);
		эв_УдалитьСтрокуДоставкиПриПолученииЗаказа(ДанныеXDTO, ПолученныеДанные);
	КонецЕсли;
	
	ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
	ДанныеРегистров = Новый Структура;
	Если ДополнительныеДанные.Свойство("эв_ЗаказыПокупателейССайта") Тогда
		ДанныеРегистров.Вставить("ЗаказыПокупателейССайта", ДополнительныеДанные.эв_ЗаказыПокупателейССайта);
	КонецЕсли;
	Если ДополнительныеДанные.Свойство("эв_ИсторияСтатусовЗаказов") Тогда
		ДанныеРегистров.Вставить("ИсторияСтатусовЗаказов", ДополнительныеДанные.эв_ИсторияСтатусовЗаказов);
	КонецЕсли;
	Если ДанныеРегистров.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_РегистрыЗаказа", ДанныеРегистров);
	КонецЕсли;
	
КонецПроцедуры

&После("ПКО_Документ_ЗаказПокупателя_Получение_ПередЗаписьюПолученныхДанных")
Процедура эв_ПКО_Документ_ЗаказПокупателя_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектЗаписи = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если ОбъектЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидЗаказа = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ВидЗаказа", ВидЗаказа) И ЗначениеЗаполнено(ВидЗаказа) Тогда
		ОбъектЗаписи.ВидЗаказа = ВидЗаказа;
	КонецЕсли;
	
	СостояниеЗаказа = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_СостояниеЗаказа", СостояниеЗаказа) И ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		ОбъектЗаписи.СостояниеЗаказа = СостояниеЗаказа;
	КонецЕсли;
	
	ЗавершенУспешно = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ЗавершенУспешно", ЗавершенУспешно) Тогда
		Если ЗавершенУспешно = Истина Тогда
			ОбъектЗаписи.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
		Иначе
			ОбъектЗаписи.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен;
		КонецЕсли;
	КонецЕсли;
	
	НоменклатураДоставки = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_НоменклатураДоставки", НоменклатураДоставки)
		И ЗначениеЗаполнено(НоменклатураДоставки) Тогда
		ОбъектЗаписи.НоменклатураДоставки = НоменклатураДоставки;
	КонецЕсли;
	
	СтавкаНДСДоставки = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_СтавкаНДСДоставки", СтавкаНДСДоставки)
		И ЗначениеЗаполнено(СтавкаНДСДоставки) Тогда
		ОбъектЗаписи.СтавкаНДСДоставки = СтавкаНДСДоставки;
	КонецЕсли;
	
	ПричинаОтмены = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ПричинаОтмены", ПричинаОтмены)
		И ЗначениеЗаполнено(ПричинаОтмены) Тогда
		ОбъектЗаписи.ПричинаОтмены = ПричинаОтмены;
	КонецЕсли;
	
	ВариантЗавершения = Неопределено;
	Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_ВариантЗавершения", ВариантЗавершения)
		И ЗначениеЗаполнено(ВариантЗавершения) Тогда
		ОбъектЗаписи.ВариантЗавершения = ВариантЗавершения;
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("Заметки,КонтактныйТелефон,ПочтаПолучателя,АдресСайта", ",") Цикл
		ЗначениеРеквизита = Неопределено;
		Если ОбъектЗаписи.ДополнительныеСвойства.Свойство("эв_" + ИмяРеквизита, ЗначениеРеквизита)
			И ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ОбъектЗаписи[ИмяРеквизита] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&После("ОтложеннаяОбработка_ЗаказПокупателя")
Процедура эв_ОтложеннаяОбработка_ЗаказПокупателя(Объект, КомпонентыОбмена)
	
	ДанныеРегистров = Неопределено;
	Если Не Объект.ДополнительныеСвойства.Свойство("эв_РегистрыЗаказа", ДанныеРегистров) Тогда
		Возврат;
	КонецЕсли;
	ДанныеРегистров = эв_СтруктураИзДанныхJSON(ДанныеРегистров);
	Если ДанныеРегистров = Неопределено Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеРегистров.Свойство("ЗаказыПокупателейССайта") Тогда
		эв_ЗаписатьЗаказыПокупателейССайта(Объект.Ссылка, ДанныеРегистров.ЗаказыПокупателейССайта);
	КонецЕсли;
	Если ДанныеРегистров.Свойство("ИсторияСтатусовЗаказов") Тогда
		эв_ЗаписатьИсториюСтатусовЗаказов(Объект.Ссылка, ДанныеРегистров.ИсторияСтатусовЗаказов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура эв_ЗагрузитьРеквизитыНоменклатурыИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные)
	Если ПолученныеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Если Не ДанныеXDTO.Свойство("AdditionalInfo")
		Или ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ДанныеXDTO.AdditionalInfo);
		ДополнительнаяИнформация = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	ДополнительнаяИнформация = эв_СтруктураИзДанныхJSON(ДополнительнаяИнформация);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОбъекта = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ДополнительныеРеквизитыОбъекта", РеквизитыОбъекта) Тогда
		РеквизитыОбъекта = эв_СтруктураИзДанныхJSON(РеквизитыОбъекта);
		Если РеквизитыОбъекта <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, РеквизитыОбъекта);
			НеВходитВАссортиментСберСпасибо = Неопределено;
			Если РеквизитыОбъекта.Свойство("эвНеВходитВАссортиментСберСпасибо", НеВходитВАссортиментСберСпасибо) Тогда
				ПолученныеДанные.эвНеВходитВАссортиментСберСпасибо = НеВходитВАссортиментСберСпасибо;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИспользоватьХарактеристики = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ИспользоватьХарактеристики", ИспользоватьХарактеристики) Тогда
		ПолученныеДанные.ИспользоватьХарактеристики = ИспользоватьХарактеристики;
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ИспользоватьХарактеристики", ИспользоватьХарактеристики);
	КонецЕсли;
	
	ЗаполнятьХарактеристикуОбязательно = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ЗаполнятьХарактеристикуОбязательно", ЗаполнятьХарактеристикуОбязательно) Тогда
		ПолученныеДанные.ПроверятьЗаполнениеХарактеристики = ЗаполнятьХарактеристикуОбязательно;
	КонецЕсли;
	
	Недействителен = Неопределено;
	Если ДополнительнаяИнформация.Свойство("Недействителен", Недействителен) Тогда
		ПолученныеДанные.Недействителен = Недействителен;
	КонецЕсли;
	
	КодПризнакаПредметаРасчета = Неопределено;
	Если ДополнительнаяИнформация.Свойство("КодПризнакаПредметаРасчета", КодПризнакаПредметаРасчета)
		И ТипЗнч(КодПризнакаПредметаРасчета) = Тип("Число") Тогда
		ПризнакПредметаРасчета = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПризнакПредметаРасчетаПоКоду(КодПризнакаПредметаРасчета);
		Если ЗначениеЗаполнено(ПризнакПредметаРасчета) Тогда
			ПолученныеДанные.ПризнакПредметаРасчета = ПризнакПредметаРасчета;
		КонецЕсли;
	КонецЕсли;
	
	Цена = Неопределено;
	Если ДополнительнаяИнформация.Свойство("Цена", Цена) И ТипЗнч(Цена) = Тип("Число") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_УчетнаяЦена", Цена);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ЗаписатьУчетнуюЦенуНоменклатуры(ПолученныеДанные, ДанныеИБ)
	
	Цена = Неопределено;
	Если ПолученныеДанные.ЭтоГруппа
		Или Не ПолученныеДанные.ДополнительныеСвойства.Свойство("эв_УчетнаяЦена", Цена) Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	ВидЦен = Справочники.ВидыЦен.Учетная;
	Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидЦен", ВидЦен);
	Отбор.Вставить("Номенклатура", Номенклатура);
	Отбор.Вставить("Характеристика", Характеристика);
	Срез = РегистрыСведений.ЦеныНоменклатуры.СрезПоследних(ТекущаяДатаСеанса(), Отбор);
	Если Срез.Количество() > 0 И Срез[0].Цена = Цена Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = НачалоДня(ТекущаяДатаСеанса());
	МенеджерЗаписи.ВидЦен = ВидЦен;
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.Характеристика = Характеристика;
	МенеджерЗаписи.Цена = Цена;
	МенеджерЗаписи.ЕдиницаИзмерения = ПолученныеДанные.ЕдиницаИзмерения;
	МенеджерЗаписи.Актуальность = Истина;
	МенеджерЗаписи.ВалютаЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦен, "ВалютаЦены");
	МенеджерЗаписи.ОбменДанными.Загрузка = Истина;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Функция эв_JSONИзСтруктуры(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция эв_СтруктураИзДанныхJSON(Данные)
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Возврат Данные;
	КонецЕсли;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Данные Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_СтруктураAdditionalInfo(ДанныеXDTO)
	
	Если Не ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	AdditionalInfo = ДанныеXDTO.AdditionalInfo;
	Если ТипЗнч(AdditionalInfo) = Тип("Структура")
		Или ТипЗнч(AdditionalInfo) = Тип("Соответствие") Тогда
		Возврат эв_СтруктураИзДанныхJSON(AdditionalInfo);
	КонецЕсли;
	Если ТипЗнч(AdditionalInfo) <> Тип("Строка") Или Не ЗначениеЗаполнено(AdditionalInfo) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(AdditionalInfo);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат эв_СтруктураИзДанныхJSON(Данные);
	
КонецФункции

Функция эв_ЭтоОбменУниверсальный(КомпонентыОбмена)
	
	Возврат КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменУниверсальный";
	
КонецФункции

Процедура эв_ДополнитьВыгрузкуРеквизитовЗаказа(ДанныеИБ, ДанныеXDTO)
	
	ДополнительнаяИнформация = эв_СтруктураAdditionalInfo(ДанныеXDTO);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Если ДанныеXDTO.Свойство("AdditionalInfo")
			И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Строка")
			И ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
			Возврат;
		КонецЕсли;
		ДополнительнаяИнформация = Новый Структура;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВидЗаказа) Тогда
		ДополнительнаяИнформация.Вставить("ВидЗаказа", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.ВидЗаказа));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.СостояниеЗаказа) Тогда
		ОписаниеСостояния = эв_ОписаниеСсылкиЗаказа(ДанныеИБ.СостояниеЗаказа);
		Если ДанныеИБ.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
			ОписаниеСостояния.Вставить("ЗавершенУспешно",
				ДанныеИБ.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно);
		КонецЕсли;
		ДополнительнаяИнформация.Вставить("СостояниеЗаказа", ОписаниеСостояния);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.НоменклатураДоставки) Тогда
		ДополнительнаяИнформация.Вставить("НоменклатураДоставки", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.НоменклатураДоставки));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.СтавкаНДСДоставки) Тогда
		ДополнительнаяИнформация.Вставить("СтавкаНДСДоставки", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.СтавкаНДСДоставки));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.ПричинаОтмены) Тогда
		ДополнительнаяИнформация.Вставить("ПричинаОтмены", эв_ОписаниеСсылкиЗаказа(ДанныеИБ.ПричинаОтмены));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеИБ.ВариантЗавершения) Тогда
		ДополнительнаяИнформация.Вставить("ВариантЗавершения", XMLСтрока(ДанныеИБ.ВариантЗавершения));
	КонецЕсли;
	Для Каждого ИмяРеквизита Из СтрРазделить("Заметки,КонтактныйТелефон,ПочтаПолучателя,АдресСайта", ",") Цикл
		Если ЗначениеЗаполнено(ДанныеИБ[ИмяРеквизита]) Тогда
			ДополнительнаяИнформация.Вставить(ИмяРеквизита, ДанныеИБ[ИмяРеквизита]);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеXDTO.AdditionalInfo = эв_JSONИзСтруктуры(ДополнительнаяИнформация);
	
КонецПроцедуры

Функция эв_ОписаниеСсылкиЗаказа(Ссылка)
	
	Описание = Новый Структура;
	Описание.Вставить("Ссылка", XMLСтрока(Ссылка));
	Описание.Вставить("Наименование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование"));
	
	Возврат Описание;
	
КонецФункции

Процедура эв_УдалитьСтрокуДоставкиИзВыгрузкиЗаказа(ДанныеXDTO, ДанныеИБ)
	
	Если Не ЗначениеЗаполнено(ДанныеИБ.НоменклатураДоставки)
		Или Не ЗначениеЗаполнено(ДанныеИБ.СтоимостьДоставки) Тогда
		Возврат;
	КонецЕсли;
	
	эв_УдалитьСинтетическуюСтрокуДоставки(ДанныеXDTO, "Услуги", ДанныеИБ.НоменклатураДоставки);
	эв_УдалитьСинтетическуюСтрокуДоставки(ДанныеXDTO, "Товары", ДанныеИБ.НоменклатураДоставки);
	
КонецПроцедуры

Процедура эв_УдалитьСинтетическуюСтрокуДоставки(ДанныеXDTO, ИмяТаблицы, НоменклатураДоставки)
	
	Таблица = Неопределено;
	Если Не ДанныеXDTO.Свойство(ИмяТаблицы, Таблица)
		Или ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонкиНоменклатуры = "";
	Если Таблица.Колонки.Найти("Номенклатура") <> Неопределено Тогда
		ИмяКолонкиНоменклатуры = "Номенклатура";
	ИначеЕсли Таблица.Колонки.Найти("ДанныеНоменклатуры") <> Неопределено Тогда
		ИмяКолонкиНоменклатуры = "ДанныеНоменклатуры";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяКолонкиНоменклатуры)
		Или Таблица.Колонки.Найти("НомерСтрокиДокумента") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.НомерСтрокиДокумента = 0
			И СтрокаТаблицы[ИмяКолонкиНоменклатуры] = НоменклатураДоставки Тогда
			СтрокиКУдалению.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из СтрокиКУдалению Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Если Таблица.Количество() = 0 И ТипЗнч(ДанныеXDTO) = Тип("Структура") Тогда
		ДанныеXDTO.Удалить(ИмяТаблицы);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ЗапомнитьРеквизитыЗаказаИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные)
	
	ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
	
	ВидЗаказа = эв_СсылкаПоОписанию(ДополнительныеДанные, "ВидЗаказа", Справочники.ВидыЗаказовПокупателей);
	Если ЗначениеЗаполнено(ВидЗаказа) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ВидЗаказа", ВидЗаказа);
	КонецЕсли;
	
	СостояниеЗаказа = эв_СсылкаПоОписанию(ДополнительныеДанные, "СостояниеЗаказа", Справочники.СостоянияЗаказовПокупателей);
	Если ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_СостояниеЗаказа", СостояниеЗаказа);
	КонецЕсли;
	
	ОписаниеСостояния = Неопределено;
	Если ДополнительныеДанные.Свойство("СостояниеЗаказа", ОписаниеСостояния) Тогда
		ОписаниеСостояния = эв_СтруктураИзДанныхJSON(ОписаниеСостояния);
		ЗавершенУспешно = Неопределено;
		Если ОписаниеСостояния <> Неопределено
			И ОписаниеСостояния.Свойство("ЗавершенУспешно", ЗавершенУспешно) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ЗавершенУспешно", ЗавершенУспешно);
		КонецЕсли;
	КонецЕсли;
	
	НоменклатураДоставки = эв_СсылкаПоОписанию(ДополнительныеДанные, "НоменклатураДоставки", Справочники.Номенклатура);
	Если ЗначениеЗаполнено(НоменклатураДоставки) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_НоменклатураДоставки", НоменклатураДоставки);
	КонецЕсли;
	
	СтавкаНДСДоставки = эв_СсылкаПоОписанию(ДополнительныеДанные, "СтавкаНДСДоставки", Справочники.СтавкиНДС);
	Если ЗначениеЗаполнено(СтавкаНДСДоставки) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_СтавкаНДСДоставки", СтавкаНДСДоставки);
	КонецЕсли;
	
	ПричинаОтмены = эв_СсылкаПоОписанию(ДополнительныеДанные, "ПричинаОтмены", Справочники.ПричиныОтменыЗаказа);
	Если ЗначениеЗаполнено(ПричинаОтмены) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ПричинаОтмены", ПричинаОтмены);
	КонецЕсли;
	
	ВариантЗавершения = эв_ВариантЗавершенияИзAdditionalInfo(ДополнительныеДанные);
	Если ЗначениеЗаполнено(ВариантЗавершения) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ВариантЗавершения", ВариантЗавершения);
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("Заметки,КонтактныйТелефон,ПочтаПолучателя,АдресСайта", ",") Цикл
		ЗначениеРеквизита = Неопределено;
		Если ДополнительныеДанные.Свойство(ИмяРеквизита, ЗначениеРеквизита) И ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_" + ИмяРеквизита, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ВариантЗавершенияИзAdditionalInfo(ДополнительныеДанные)
	
	Значение = Неопределено;
	Если Не ДополнительныеДанные.Свойство("ВариантЗавершения", Значение)
		Или ТипЗнч(Значение) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("ПеречислениеСсылка.ВариантыЗавершенияЗаказа"), Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция эв_СсылкаПоОписанию(ДополнительныеДанные, ИмяСвойства, МенеджерСправочника)
	
	Описание = Неопределено;
	Если Не ДополнительныеДанные.Свойство(ИмяСвойства, Описание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = Неопределено;
	Если Описание.Свойство("Ссылка", Ссылка) Тогда
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) И ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
		Если ТипЗнч(Ссылка) = Тип("Строка") И ЗначениеЗаполнено(Ссылка) Тогда
			Попытка
				НайденнаяСсылка = МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор(Ссылка));
			Исключение
				НайденнаяСсылка = Неопределено;
			КонецПопытки;
			Если ЗначениеЗаполнено(НайденнаяСсылка) И ОбщегоНазначения.СсылкаСуществует(НайденнаяСсылка) Тогда
				Возврат НайденнаяСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Наименование = "";
	Если Описание.Свойство("Наименование", Наименование) И ЗначениеЗаполнено(Наименование) Тогда
		Возврат МенеджерСправочника.НайтиПоНаименованию(Наименование, Истина);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура эв_УдалитьСтрокуДоставкиПриПолученииЗаказа(ДанныеXDTO, ПолученныеДанные)
	
	СтрокиЗапасов = Неопределено;
	Если Не ПолученныеДанные.ДополнительныеСвойства.Свойство("Запасы", СтрокиЗапасов)
		Или ТипЗнч(СтрокиЗапасов) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДоставки = эв_ИдентификаторДоставкиИзAdditionalInfo(ДанныеXDTO.AdditionalInfo);
	СуммаДоставки = Неопределено;
	ДанныеXDTO.AdditionalInfo.Свойство("СуммаДоставки", СуммаДоставки);
	
	Пока СтрокиЗапасов.Количество() > 0 Цикл
		Индекс = СтрокиЗапасов.Количество() - 1;
		СтрокаЗапасов = эв_СтруктураИзДанныхJSON(СтрокиЗапасов[Индекс]);
		Если СтрокаЗапасов = Неопределено
			Или Не эв_ЭтоСтрокаДоставки(СтрокаЗапасов, ИдентификаторДоставки, СуммаДоставки) Тогда
			Прервать;
		КонецЕсли;
		СтрокиЗапасов.Удалить(Индекс);
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ИдентификаторДоставкиИзAdditionalInfo(ДополнительныеДанные)
	
	Описание = Неопределено;
	Если Не ДополнительныеДанные.Свойство("НоменклатураДоставки", Описание) Тогда
		Возврат "";
	КонецЕсли;
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Ссылка = Неопределено;
	Если Не Описание.Свойство("Ссылка", Ссылка) Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
		Возврат эв_НормализоватьИдентификатор(XMLСтрока(Ссылка));
	КонецЕсли;
	
	Возврат эв_НормализоватьИдентификатор(Ссылка);
	
КонецФункции

Функция эв_ЭтоСтрокаДоставки(СтрокаЗапасов, ИдентификаторДоставки, СуммаДоставки)
	
	Номенклатура = Неопределено;
	Если ЗначениеЗаполнено(ИдентификаторДоставки) Тогда
		Возврат СтрокаЗапасов.Свойство("Номенклатура", Номенклатура)
			И эв_ИдентификаторНоменклатурыXDTO(Номенклатура) = ИдентификаторДоставки;
	КонецЕсли;
	
	Если СуммаДоставки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Количество = Неопределено;
	Сумма = Неопределено;
	Цена = Неопределено;
	Содержание = Неопределено;
	Если Не СтрокаЗапасов.Свойство("Количество", Количество)
		Или Не СтрокаЗапасов.Свойство("Сумма", Сумма)
		Или Не СтрокаЗапасов.Свойство("Цена", Цена)
		Или Не СтрокаЗапасов.Свойство("Содержание", Содержание) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Количество = 1
		И Сумма = СуммаДоставки
		И Цена = СуммаДоставки
		И ЗначениеЗаполнено(Содержание);
	
КонецФункции

Функция эв_ИдентификаторНоменклатурыXDTO(Номенклатура)
	
	Если Номенклатура = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Номенклатура)) Тогда
		Возврат эв_НормализоватьИдентификатор(XMLСтрока(Номенклатура));
	КонецЕсли;
	
	ДанныеНоменклатуры = эв_СтруктураИзДанныхJSON(Номенклатура);
	Ссылка = Неопределено;
	Если ДанныеНоменклатуры <> Неопределено Тогда
		ДанныеНоменклатуры.Свойство("Ссылка", Ссылка);
	Иначе
		Попытка
			Ссылка = Номенклатура.Ссылка;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Ссылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
		Возврат эв_НормализоватьИдентификатор(XMLСтрока(Ссылка));
	КонецЕсли;
	Если ТипЗнч(Ссылка) = Тип("Строка") Тогда
		Возврат эв_НормализоватьИдентификатор(Ссылка);
	КонецЕсли;
	
	ДанныеСсылки = эв_СтруктураИзДанныхJSON(Ссылка);
	Значение = Неопределено;
	Если ДанныеСсылки <> Неопределено И ДанныеСсылки.Свойство("Значение", Значение) Тогда
		Возврат эв_НормализоватьИдентификатор(Значение);
	КонецЕсли;
	Попытка
		Возврат эв_НормализоватьИдентификатор(Ссылка.Значение);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция эв_НормализоватьИдентификатор(Значение)
	
	Идентификатор = СокрЛП(Строка(Значение));
	Идентификатор = СтрЗаменить(Идентификатор, "{", "");
	Идентификатор = СтрЗаменить(Идентификатор, "}", "");
	
	Возврат ВРег(Идентификатор);
	
КонецФункции

Функция эв_ВыгрузитьЗаказыПокупателейССайта(ЗаказПокупателя)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	|	Заказы.ДатаЗаказаНаСайте КАК ДатаЗаказаНаСайте,
	|	Заказы.УзелОбмена КАК УзелОбмена,
	|	Заказы.эв_ОплаченНаПортале КАК эв_ОплаченНаПортале,
	|	Заказы.эв_ИсходныйПакет КАК эв_ИсходныйПакет,
	|	Заказы.КлючИнтеграции КАК КлючИнтеграции,
	|	Заказы.НастройкаИнтеграции КАК НастройкаИнтеграции,
	|	Заказы.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ЗаказыПокупателейССайта КАК Заказы
	|ГДЕ
	|	Заказы.ЗаказПокупателя = &ЗаказПокупателя";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("НомерЗаказаНаСайте", Выборка.НомерЗаказаНаСайте);
		Запись.Вставить("ДатаЗаказаНаСайте", эв_ДатаВСтроку(Выборка.ДатаЗаказаНаСайте));
		Запись.Вставить("эв_ОплаченНаПортале", Выборка.эв_ОплаченНаПортале);
		Запись.Вставить("эв_ИсходныйПакет", эв_ТекстХранилища(Выборка.эв_ИсходныйПакет));
		Запись.Вставить("Идентификатор", Выборка.Идентификатор);
		эв_ДобавитьОписаниеСсылки(Запись, "УзелОбмена", Выборка.УзелОбмена);
		эв_ДобавитьОписаниеСсылки(Запись, "КлючИнтеграции", Выборка.КлючИнтеграции);
		эв_ДобавитьОписаниеСсылки(Запись, "НастройкаИнтеграции", Выборка.НастройкаИнтеграции);
		Результат.Добавить(Запись);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ВыгрузитьИсториюСтатусовЗаказов(ЗаказПокупателя)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.Период КАК Период,
	|	История.СтатусЗаказа КАК СтатусЗаказа,
	|	История.ДатаОкончанияРезерва КАК ДатаОкончанияРезерва
	|ИЗ
	|	РегистрСведений.эв_ИсторияСтатусовЗаказов КАК История
	|ГДЕ
	|	История.ЗаказПокупателя = &ЗаказПокупателя
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Период", эв_ДатаВСтроку(Выборка.Период));
		Запись.Вставить("ДатаОкончанияРезерва", эв_ДатаВСтроку(Выборка.ДатаОкончанияРезерва));
		эв_ДобавитьОписаниеСсылки(Запись, "СтатусЗаказа", Выборка.СтатусЗаказа);
		Результат.Добавить(Запись);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура эв_ЗаписатьЗаказыПокупателейССайта(ЗаказПокупателя, Строки)
	
	Набор = РегистрыСведений.ЗаказыПокупателейССайта.СоздатьНаборЗаписей();
	Набор.Отбор.ЗаказПокупателя.Установить(ЗаказПокупателя);
	
	СтрокиДанных = эв_МассивДанных(Строки);
	Если СтрокиДанных.Количество() > 0 Тогда
		СтрокаДанных = эв_СтруктураИзДанныхJSON(СтрокиДанных[СтрокиДанных.Количество() - 1]);
		Если СтрокаДанных <> Неопределено Тогда
			Запись = Набор.Добавить();
			Запись.ЗаказПокупателя = ЗаказПокупателя;
			Запись.НомерЗаказаНаСайте = эв_СтрокаСвойства(СтрокаДанных, "НомерЗаказаНаСайте", 100);
			Запись.ДатаЗаказаНаСайте = эв_ДатаИзСтроки(эв_ЗначениеСвойства(СтрокаДанных, "ДатаЗаказаНаСайте"));
			Запись.эв_ОплаченНаПортале = эв_БулевоСвойства(СтрокаДанных, "эв_ОплаченНаПортале");
			Запись.Идентификатор = эв_СтрокаСвойства(СтрокаДанных, "Идентификатор", 255);
			эв_УстановитьСсылкуЗаписи(Запись, "УзелОбмена", СтрокаДанных);
			эв_УстановитьСсылкуЗаписи(Запись, "КлючИнтеграции", СтрокаДанных);
			эв_УстановитьСсылкуЗаписи(Запись, "НастройкаИнтеграции", СтрокаДанных);
			ТекстПакета = эв_СтрокаСвойства(СтрокаДанных, "эв_ИсходныйПакет");
			Если ЗначениеЗаполнено(ТекстПакета) Тогда
				Запись.эв_ИсходныйПакет = Новый ХранилищеЗначения(ТекстПакета, Новый СжатиеДанных(9));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
КонецПроцедуры

Процедура эв_ЗаписатьИсториюСтатусовЗаказов(ЗаказПокупателя, Строки)
	
	Набор = РегистрыСведений.эв_ИсторияСтатусовЗаказов.СоздатьНаборЗаписей();
	Набор.Отбор.ЗаказПокупателя.Установить(ЗаказПокупателя);
	
	ЗаписиПоПериодам = Новый Соответствие;
	Для Каждого Элемент Из эв_МассивДанных(Строки) Цикл
		СтрокаДанных = эв_СтруктураИзДанныхJSON(Элемент);
		Если СтрокаДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Период = эв_ДатаИзСтроки(эв_ЗначениеСвойства(СтрокаДанных, "Период"));
		Если Не ЗначениеЗаполнено(Период) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписиПоПериодам.Вставить(Период, СтрокаДанных);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ЗаписиПоПериодам Цикл
		СтрокаДанных = КлючИЗначение.Значение;
		Запись = Набор.Добавить();
		Запись.Период = КлючИЗначение.Ключ;
		Запись.ЗаказПокупателя = ЗаказПокупателя;
		Запись.ДатаОкончанияРезерва = эв_ДатаИзСтроки(эв_ЗначениеСвойства(СтрокаДанных, "ДатаОкончанияРезерва"));
		эв_УстановитьСсылкуЗаписи(Запись, "СтатусЗаказа", СтрокаДанных);
	КонецЦикла;
	
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
КонецПроцедуры

Процедура эв_ДобавитьОписаниеСсылки(Запись, ИмяПоля, Ссылка)
	
	Описание = эв_ОписаниеСсылки(Ссылка);
	Если Описание <> Неопределено Тогда
		Запись.Вставить(ИмяПоля, Описание);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_УстановитьСсылкуЗаписи(Запись, ИмяПоля, СтрокаДанных)
	
	Ссылка = эв_СсылкаИзОписания(эв_ЗначениеСвойства(СтрокаДанных, ИмяПоля));
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Запись[ИмяПоля] = Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Функция эв_ОписаниеСсылки(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Тип", XMLТип(ТипЗнч(Ссылка)).ИмяТипа);
	Описание.Вставить("УИД", Строка(Ссылка.УникальныйИдентификатор()));
	
	МетаданныеСсылки = Ссылка.Метаданные();
	Если Метаданные.Справочники.Содержит(МетаданныеСсылки)
		Или Метаданные.ПланыОбмена.Содержит(МетаданныеСсылки) Тогда
		Описание.Вставить("Наименование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование"));
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция эв_СсылкаИзОписания(Описание)
	
	Описание = эв_СтруктураИзДанныхJSON(Описание);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = эв_СсылкаПоУИД(Описание);
	Если ЗначениеЗаполнено(Ссылка) И ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	ТипСсылки = "";
	Наименование = "";
	Если Описание.Свойство("Тип", ТипСсылки)
		И ТипСсылки = "CatalogRef.СостоянияЗаказовПокупателей"
		И Описание.Свойство("Наименование", Наименование)
		И ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию(Наименование, Истина);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_СсылкаПоУИД(Описание)
	
	УИД = "";
	ТипСсылки = "";
	Если Не Описание.Свойство("УИД", УИД) Или Не ЗначениеЗаполнено(УИД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не Описание.Свойство("Тип", ТипСсылки) Или Не ЗначениеЗаполнено(ТипСсылки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип(ТипСсылки), УИД);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция эв_МассивДанных(Значение)
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Описание = эв_СтруктураИзДанныхJSON(Значение);
	Результат = Новый Массив;
	Если Описание <> Неопределено Тогда
		Результат.Добавить(Описание);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ЗначениеСвойства(Данные, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	
	Данные = эв_СтруктураИзДанныхJSON(Данные);
	Если Данные = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Не Данные.Свойство(ИмяСвойства, Значение) Или Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция эв_СтрокаСвойства(Данные, ИмяСвойства, Длина = 0)
	
	Значение = эв_ЗначениеСвойства(Данные, ИмяСвойства, "");
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Значение = Строка(Значение);
	КонецЕсли;
	Если Длина > 0 И СтрДлина(Значение) > Длина Тогда
		Возврат Лев(Значение, Длина);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция эв_БулевоСвойства(Данные, ИмяСвойства)
	
	Значение = эв_ЗначениеСвойства(Данные, ИмяСвойства, Ложь);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Значение = Истина Или НРег(Строка(Значение)) = "true";
	
КонецФункции

Функция эв_ДатаВСтроку(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(Дата);
	
КонецФункции

Функция эв_ДатаИзСтроки(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Значение);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

Функция эв_ТекстХранилища(Хранилище)
	
	Если Хранилище = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Значение = Хранилище.Получить();
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

КонецФункции

Функция эв_ВидыЦенУзлаОбмена(КомпонентыОбмена)
	
	Результат = Новый Массив;
	Узел = КомпонентыОбмена.УзелКорреспондента;
	Если Узел = Неопределено
		Или Узел.Метаданные().ТабличныеЧасти.Найти("ВидыЦен") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаВидаЦен Из Узел.ВидыЦен Цикл
		Если ЗначениеЗаполнено(СтрокаВидаЦен.ВидЦен) Тогда
			Результат.Добавить(СтрокаВидаЦен.ВидЦен);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_МаркерШапкиУстановкиЦен()
	
	Возврат "эв_ШапкаУстановкиЦен:";
	
КонецФункции

Функция эв_ШапкаИзКомментарияУстановкиЦен(Комментарий)
	
	Маркер = эв_МаркерШапкиУстановкиЦен();
	Если ТипЗнч(Комментарий) <> Тип("Строка") Или СтрНайти(Комментарий, Маркер) <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = Новый Структура("AdditionalInfo", Сред(Комментарий, СтрДлина(Маркер) + 1));
	Шапка = эв_СтруктураAdditionalInfo(Данные);
	Если Шапка = Неопределено Или Не эв_БулевоСвойства(Шапка, "эв_ШапкаУстановкиЦен") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Шапка;
	
КонецФункции

Функция эв_ИменаПризнаковШапкиУстановкиЦен()
	
	Возврат "ПоказыватьХарактеристики,ПоказыватьНовуюЦену,ПоказыватьДействующуюЦену,ПоказыватьЕдиницыИзмерения,"
		+ "ПоказыватьЗависимыеЦены,ПоказыватьНедействительныеХарактеристики,ПоказыватьОтклонениеЦен,"
		+ "УстанавливатьХарактеристикамБезЦен,ОтображатьНаценку,ЗаписыватьНовыеЦеныПоверхУстановленных,"
		+ "РасчетИзВидаЦен,СлужебныйНовыйФормат";
	
КонецФункции

Функция эв_ШапкаУстановкиЦен(Документ)
	
	Шапка = Новый Структура;
	Шапка.Вставить("эв_ШапкаУстановкиЦен", Истина);
	Для Каждого ИмяПризнака Из СтрРазделить(эв_ИменаПризнаковШапкиУстановкиЦен(), ",") Цикл
		Шапка.Вставить(ИмяПризнака, Документ[ИмяПризнака]);
	КонецЦикла;
	Шапка.Вставить("ИспользуютсяХарактеристики", Документ.ПоказыватьХарактеристики);
	Шапка.Вставить("ор_ДатаСогласованияЦенЖНВЛП", эв_ДатаВСтроку(Документ.ор_ДатаСогласованияЦенЖНВЛП));
	Основание = эв_ОписаниеСсылки(Документ.ДокументОснование);
	Если Основание <> Неопределено Тогда
		Шапка.Вставить("ДокументОснованиеТип", Основание.Тип);
		Шапка.Вставить("ДокументОснованиеУИД", Основание.УИД);
	КонецЕсли;
	
	Возврат Шапка;
	
КонецФункции

Процедура эв_ЗаполнитьШапкуУстановкиЦен(ПолученныеДанные, Шапка)
	
	Для Каждого ИмяПризнака Из СтрРазделить(эв_ИменаПризнаковШапкиУстановкиЦен(), ",") Цикл
		ПолученныеДанные[ИмяПризнака] = эв_БулевоСвойства(Шапка, ИмяПризнака);
	КонецЦикла;
	ПолученныеДанные.Комментарий = эв_СтрокаСвойства(Шапка, "Комментарий");
	ПолученныеДанные.ор_ДатаСогласованияЦенЖНВЛП = эв_ДатаИзСтроки(
		эв_ЗначениеСвойства(Шапка, "ор_ДатаСогласованияЦенЖНВЛП"));
	
	ОписаниеОснования = Новый Структура;
	ОписаниеОснования.Вставить("Тип", эв_ЗначениеСвойства(Шапка, "ДокументОснованиеТип", ""));
	ОписаниеОснования.Вставить("УИД", эв_ЗначениеСвойства(Шапка, "ДокументОснованиеУИД", ""));
	Основание = эв_СсылкаИзОписания(ОписаниеОснования);
	Если ЗначениеЗаполнено(Основание) Тогда
		ПолученныеДанные.ДокументОснование = Основание;
	КонецЕсли;
	
КонецПроцедуры

Функция эв_ВидыЦенДляУстановкиЦен(КомпонентыОбмена)
	
	ПараметрыКонвертации = КомпонентыОбмена.ПараметрыКонвертации;
	ВидыЦен = Новый Массив;
	Если ПараметрыКонвертации.ИспользоватьОтборПоВидамЦен
		И ПараметрыКонвертации.МассивВидовЦен <> Неопределено Тогда
		Для Каждого ВидЦен Из ПараметрыКонвертации.МассивВидовЦен Цикл
			Если ЗначениеЗаполнено(ВидЦен) Тогда
				ВидыЦен.Добавить(ВидЦен);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ВидыЦен.Количество() = 0 Тогда
		ВидыЦен = эв_ВидыЦенУзлаОбмена(КомпонентыОбмена);
	КонецЕсли;
	Если ВидыЦен.Количество() = 0 Тогда
		ВидыЦен = эв_ВсеВидыЦен();
	КонецЕсли;
	
	Возврат ВидыЦен;
	
КонецФункции

Функция эв_ТаблицаТоваровУстановкиЦен(Документ, ВидыЦен)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатуры.ВидЦены КАК ТипЦен,
	|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатуры.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ЦеныНоменклатуры.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|			ТОГДА ЦеныНоменклатуры.ЕдиницаИзмерения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК Упаковка,
	|	МАКСИМУМ(ЦеныНоменклатуры.Цена) КАК Цена,
	|	МИНИМУМ(ЦеныНоменклатуры.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры.Запасы КАК ЦеныНоменклатуры
	|ГДЕ
	|	ЦеныНоменклатуры.Ссылка = &Ссылка
	|	И ЦеныНоменклатуры.Цена <> 0
	|	И ЦеныНоменклатуры.ВидЦены В(&ВидыЦенНоменклатуры)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныНоменклатуры.ВидЦены,
	|	ЦеныНоменклатуры.Номенклатура,
	|	ЦеныНоменклатуры.Характеристика,
	|	ВЫБОР
	|		КОГДА ЦеныНоменклатуры.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|			ТОГДА ЦеныНоменклатуры.ЕдиницаИзмерения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	Запрос.УстановитьПараметр("ВидыЦенНоменклатуры", ВидыЦен);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция эв_ОписанияВидовЦенСтрок(ТаблицаТоваров)
	
	Описания = Новый Массив;
	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл
		Описания.Добавить(эв_ОписаниеСсылки(СтрокаТовары.ТипЦен));
	КонецЦикла;
	
	Возврат Описания;
	

&Вместо("ПОД_Документ_УстановкаЦенНоменклатуры_Отправка_ПриОбработке")
Процедура эв_ПОД_Документ_УстановкаЦенНоменклатуры_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	
	Если Не эв_ЭтоОбменУниверсальный(КомпонентыОбмена)
		Или ТипЗнч(ДанныеИБ) = Тип("Структура") Тогда
		ПродолжитьВызов(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	
	ПараметрыКонвертации = КомпонентыОбмена.ПараметрыКонвертации;
	ОтборПоВидамЦен = ПараметрыКонвертации.ИспользоватьОтборПоВидамЦен;
	МассивВидовЦен = ПараметрыКонвертации.МассивВидовЦен;
	ВидыЦен = эв_ВидыЦенДляУстановкиЦен(КомпонентыОбмена);
	
	ТаблицаТоваров = эв_ТаблицаТоваровУстановкиЦен(ДанныеИБ, ВидыЦен);
	Если ТаблицаТоваров.Количество() = 0 Тогда
		ИспользованиеПКО.Документ_УстановкаЦенНоменклатуры_Отправка = Ложь;
		Возврат;
	КонецЕсли;
	
	Шапка = Неопределено;
	Попытка
		Шапка = эв_ШапкаУстановкиЦен(ДанныеИБ);
	Исключение
		Шапка = Новый Структура("эв_ШапкаУстановкиЦен", Истина);
	КонецПопытки;
	Шапка.Вставить("ВидыЦенСтрок", эв_ОписанияВидовЦенСтрок(ТаблицаТоваров));
	ТаблицаТоваров.Колонки.Удалить("НомерСтроки");
	
	ДанныеИБСтруктура = Новый Структура("Дата, Номер, Автор, Комментарий, Ссылка");
	ЗаполнитьЗначенияСвойств(ДанныеИБСтруктура, ДанныеИБ);
	ДанныеИБСтруктура.Вставить("ТипЦен", ТаблицаТоваров[0].ТипЦен);
	ДанныеИБСтруктура.Вставить("Товары", ТаблицаТоваров);
	
	ПараметрыКонвертации.ИспользоватьОтборПоВидамЦен = Истина;
	ПараметрыКонвертации.МассивВидовЦен = ВидыЦен;
	ПараметрыКонвертации.Вставить("эв_ШапкаУстановкиЦен", Шапка);
	Попытка
		эв_ВыгрузитьВидыЦенУстановкиЦен(КомпонентыОбмена, ТаблицаТоваров);
		ПравилоОтправки = КомпонентыОбмена.ПравилаОбработкиДанных.Найти(
			"Документ_УстановкаЦенНоменклатуры_Отправка", "Имя");
		Если ПравилоОтправки <> Неопределено Тогда
			ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ДанныеИБСтруктура, ПравилоОтправки);
		КонецЕсли;
	Исключение
		ПараметрыКонвертации.ИспользоватьОтборПоВидамЦен = ОтборПоВидамЦен;
		ПараметрыКонвертации.МассивВидовЦен = МассивВидовЦен;
		Если ПараметрыКонвертации.Свойство("эв_ШапкаУстановкиЦен") Тогда
			ПараметрыКонвертации.Удалить("эв_ШапкаУстановкиЦен");
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ПараметрыКонвертации.ИспользоватьОтборПоВидамЦен = ОтборПоВидамЦен;
	ПараметрыКонвертации.МассивВидовЦен = МассивВидовЦен;
	Если ПараметрыКонвертации.Свойство("эв_ШапкаУстановкиЦен") Тогда
		ПараметрыКонвертации.Удалить("эв_ШапкаУстановкиЦен");
	КонецЕсли;
	
	ИспользованиеПКО.Документ_УстановкаЦенНоменклатуры_Отправка = Ложь;
	
КонецПроцедуры


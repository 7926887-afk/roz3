	ЗаказыСтрок = Неопределено;
	КомпонентыОбмена.ПараметрыКонвертации.Свойство("эв_ЗаказыСтрокОРП", ЗаказыСтрок);
	КомпонентыОбмена.ПараметрыКонвертации.Удалить("эв_ЗаказыСтрокОРП");
	Если КассовыеДанные = Неопределено И ПолученныеДанные <> Неопределено Тогда
		ПолученныеДанные.ДополнительныеСвойства.Свойство("эв_КассовыеДанные", КассовыеДанные);
	КонецЕсли;
	Если КассовыеДанные = Неопределено И ДанныеИБ <> Неопределено Тогда
		ДанныеИБ.ДополнительныеСвойства.Свойство("эв_КассовыеДанные", КассовыеДанные);
	КонецЕсли;
	Если КассовыеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КассаККМ = Неопределено;
	Если ПолученныеДанные <> Неопределено Тогда
		КассаККМ = ПолученныеДанные.КассаККМ;
	ИначеЕсли ДанныеИБ <> Неопределено Тогда
		КассаККМ = ДанныеИБ.КассаККМ;
	КонецЕсли;
	КассоваяСмена = эв_ОбеспечитьКассовыйДокумент(эв_ЗначениеСвойства(КассовыеДанные, "КассоваяСмена"), КассаККМ);
	Статус = эв_СтатусОтчетаОРозничныхПродажах(эв_СтрокаСвойства(КассовыеДанные, "СтатусКассовойСмены"));
	
	Если ПолученныеДанные <> Неопределено Тогда
		эв_ПрименитьСостояниеОтчетаРозничныхПродаж(ПолученныеДанные, КассовыеДанные, КассоваяСмена, Статус);
	КонецЕсли;
	Если ДанныеИБ <> Неопределено И ДанныеИБ <> ПолученныеДанные Тогда
		эв_ПрименитьСостояниеОтчетаРозничныхПродаж(ДанныеИБ, КассовыеДанные, КассоваяСмена, Статус);
	КонецЕсли;
	ОбъектЗапасов = ?(ДанныеИБ <> Неопределено, ДанныеИБ, ПолученныеДанные);
	эв_ПрименитьЗаказыСтрок(ОбъектЗапасов, ЗаказыСтрок);
	
	ОбъектОтчета = ?(ДанныеИБ <> Неопределено, ДанныеИБ, ПолученныеДанные);
	Если ОбъектОтчета <> Неопределено
		И ОбъектОтчета.Проведен
		И ОбъектОтчета.СтатусКассовойСмены = Перечисления.СтатусыОтчетаОРозничныхПродажах.ЗакрытаЧекиЗаархивированы Тогда
		СсылкаОтчета = ?(ОбъектОтчета.ЭтоНовый(), ОбъектОтчета.ПолучитьСсылкуНового(), ОбъектОтчета.Ссылка);
		эв_АрхивироватьЧекиОтчета(СсылкаОтчета);
	КонецЕсли;
	
КонецПроцедуры

&После("ПКО_Документ_СчетФактураПолученный_Отправка_ПриОтправкеДанных")
Процедура эв_ПКО_Документ_СчетФактураПолученный_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если СтекВыгрузки.Количество() > 1
		Или ТипЗнч(ДанныеИБ) <> Тип("ДокументОбъект.СчетФактураПолученный") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.КодВидаОперации) Тогда
		ДанныеXDTO.Вставить("КодВидаОперации", ДанныеИБ.КодВидаОперации);
	КонецЕсли;
	
	Если ДанныеИБ.КодСпособаВыставления = 2 Тогда
		ДанныеXDTO.Вставить("СпособВыставления", "ВЭлектронномВиде");
	Иначе
		ДанныеXDTO.Вставить("СпособВыставления", "НаБумажномНосителе");
	КонецЕсли;
	
	// В формате это дата со временем. Сюда кладём дату документа (на форме — ДатаПолученияНДС):
	// типовое правило берёт её из даты входящего документа, а там времени нет.
	ДанныеXDTO.Вставить("ДатаПолучения", ДанныеИБ.Дата);
	
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("Дата", эв_ДатаВСтроку(ДанныеИБ.Дата));
	Если ЗначениеЗаполнено(ДанныеИБ.ДатаПолучения) Тогда
		ДополнительныеДанные.Вставить("ДатаПолучения", эв_ДатаВСтроку(ДанныеИБ.ДатаПолучения));
	КонецЕсли;
	ДанныеXDTO.Вставить("КомментарийМногоязычный", "орСФ:" + эв_JSONИзСтруктуры(ДополнительныеДанные));
	
	Информация = эв_СтруктураAdditionalInfo(ДанныеXDTO);
	Если Информация = Неопределено Тогда
		Информация = Новый Структура;
	КонецЕсли;
	Для Каждого КлючИЗначение Из ДополнительныеДанные Цикл
		Информация.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	эв_ЗаписатьAdditionalInfo(ДанныеXDTO, Информация);
	
КонецПроцедуры

&После("ПКО_Документ_СчетФактураПолученный_Получение_ПриКонвертацииДанныхXDTO")
Процедура эв_ПКО_Документ_СчетФактураПолученный_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если ЭтоЗагрузкаКлючевыхСвойств(ДанныеXDTO) Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = эв_РеквизитыСчетаФактурыПолученного(ДанныеXDTO);
	Если Реквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	эв_ПрименитьРеквизитыСчетаФактуры(ПолученныеДанные, Реквизиты);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ор_СчетФактураПолученный", Реквизиты);
	
КонецПроцедуры

&После("ПКО_Документ_СчетФактураПолученный_Получение_ПередЗаписьюПолученныхДанных")
Процедура эв_ПКО_Документ_СчетФактураПолученный_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	Реквизиты = Неопределено;
	Если Не ПолученныеДанные.ДополнительныеСвойства.Свойство("ор_СчетФактураПолученный", Реквизиты) Тогда
		Возврат;
	КонецЕсли;
	Если ДанныеИБ = Неопределено Или ДанныеИБ = ПолученныеДанные Тогда
		Возврат;
	КонецЕсли;
	
	эв_ПрименитьРеквизитыСчетаФактуры(ДанныеИБ, Реквизиты);
	
КонецПроцедуры

&ИзменениеИКонтроль("ПОД_Справочник_СостоянияЭД_Отправка_ПриОбработке")
Процедура эв_ПОД_Справочник_СостоянияЭД_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.7")
		ИЛИ ДанныеИБ.Количество() = 0  Тогда
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
		Возврат;	
	КонецЕсли;
	
	СсылкаНаОбъект = ДанныеИБ.Отбор.СсылкаНаОбъект.Значение;
	ИмяПКООснованиеЭД = ИмяПКОДляДокумента(СсылкаНаОбъект);
	
	Если КомпонентыОбмена.УзелКорреспондента.ИспользоватьОтборПоОрганизациям Тогда
		Если НЕ (ЗначениеЗаполнено(СсылкаНаОбъект)
			И СсылкаНаОбъект.Метаданные().Реквизиты.Найти("Организация") <> Неопределено
			И КомпонентыОбмена.УзелКорреспондента.Организации.Найти(СсылкаНаОбъект.Организация) <> Неопределено) Тогда
		
			ОчиститьИспользованиеПКО(ИспользованиеПКО);
			Возврат;	
		КонецЕсли; 
	КонецЕсли;
	
	ТаблицаЗаписи = ДанныеИБ.Выгрузить();
	СостояниеЭДО = ТаблицаЗаписи[0].СостояниеЭДО;
#Удаление
	СостояниеЭлектронногоДокумента = ОбменСКонтрагентами.ТипСостоянияЭлектронногоДокументаУниверсальногоФормата(
		КомпонентыОбмена.ВерсияФорматаОбмена, СостояниеЭДО);
	СводныеСостояния = ОбменСКонтрагентами.ТипыСводныхСостоянийЭДОУниверсальногоФормата(
		КомпонентыОбмена.ВерсияФорматаОбмена, СостояниеЭДО);
#КонецУдаления
#Вставка
	ВерсияФорматаЭДО = эв_ВерсияФорматаЭДО(КомпонентыОбмена.ВерсияФорматаОбмена);
	СостояниеЭлектронногоДокумента = ОбменСКонтрагентами.ТипСостоянияЭлектронногоДокументаУниверсальногоФормата(
		ВерсияФорматаЭДО, СостояниеЭДО);
	СводныеСостояния = ОбменСКонтрагентами.ТипыСводныхСостоянийЭДОУниверсальногоФормата(
		ВерсияФорматаЭДО, СостояниеЭДО);
#КонецВставки
	СостояниеОбменаЭДНаНашейСтороне = СводныеСостояния.НаНашейСтороне;	
	СостояниеОбменаЭДНаСторонеКонтрагента = СводныеСостояния.НаСторонеКонтрагента;
	
	Если НЕ ЗначениеЗаполнено(ИмяПКООснованиеЭД) Или НЕ ЗначениеЗаполнено(СостояниеЭлектронногоДокумента)
		Или НЕ ЗначениеЗаполнено(СостояниеОбменаЭДНаНашейСтороне)
		Или НЕ ЗначениеЗаполнено(СостояниеОбменаЭДНаСторонеКонтрагента)
		Или СостояниеОбменаЭДНаНашейСтороне = "ПригласитьКОбмену"
		Или СостояниеОбменаЭДНаСторонеКонтрагента = "ПригласитьКОбмену" Тогда
		ИспользованиеПКО.Очистить();
	Иначе
		ДанныеИБ.ДополнительныеСвойства.Вставить("ОснованиеЭлектронногоДокумента",
					Новый Структура("Значение, ИмяПКО", СсылкаНаОбъект, ИмяПКООснованиеЭД));
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеЭлектронногоДокумента", СостояниеЭлектронногоДокумента);
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеОбменаЭДНаНашейСтороне", СостояниеОбменаЭДНаНашейСтороне);
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеОбменаЭДНаСторонеКонтрагента", СостояниеОбменаЭДНаСторонеКонтрагента);
	КонецЕсли;
КонецПроцедуры

&После("ОтложеннаяОбработка_ЗаказПокупателя")
Процедура эв_ОтложеннаяОбработка_ЗаказПокупателя(Объект, КомпонентыОбмена)
	
	ДанныеРегистров = Неопределено;
	Если Не Объект.ДополнительныеСвойства.Свойство("эв_РегистрыЗаказа", ДанныеРегистров) Тогда
		Возврат;
	КонецЕсли;
	ДанныеРегистров = эв_СтруктураИзДанныхJSON(ДанныеРегистров);
	Если ДанныеРегистров = Неопределено Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеРегистров.Свойство("ЗаказыПокупателейССайта") Тогда
		эв_ЗаписатьЗаказыПокупателейССайта(Объект.Ссылка, ДанныеРегистров.ЗаказыПокупателейССайта);
	КонецЕсли;
	Если ДанныеРегистров.Свойство("ИсторияСтатусовЗаказов") Тогда
		эв_ЗаписатьИсториюСтатусовЗаказов(Объект.Ссылка, ДанныеРегистров.ИсторияСтатусовЗаказов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура эв_ЗагрузитьРеквизитыНоменклатурыИзAdditionalInfo(ДанныеXDTO, ПолученныеДанные)
	Если ПолученныеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Если Не ДанныеXDTO.Свойство("AdditionalInfo")
		Или ТипЗнч(ДанныеXDTO.AdditionalInfo) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ДанныеXDTO.AdditionalInfo);
		ДополнительнаяИнформация = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	ДополнительнаяИнформация = эв_СтруктураИзДанныхJSON(ДополнительнаяИнформация);
	Если ДополнительнаяИнформация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОбъекта = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ДополнительныеРеквизитыОбъекта", РеквизитыОбъекта) Тогда
		РеквизитыОбъекта = эв_СтруктураИзДанныхJSON(РеквизитыОбъекта);
		Если РеквизитыОбъекта <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, РеквизитыОбъекта);
			НеВходитВАссортиментСберСпасибо = Неопределено;
			Если РеквизитыОбъекта.Свойство("эвНеВходитВАссортиментСберСпасибо", НеВходитВАссортиментСберСпасибо) Тогда
				ПолученныеДанные.эвНеВходитВАссортиментСберСпасибо = НеВходитВАссортиментСберСпасибо;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИспользоватьХарактеристики = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ИспользоватьХарактеристики", ИспользоватьХарактеристики) Тогда
		ПолученныеДанные.ИспользоватьХарактеристики = ИспользоватьХарактеристики;
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_ИспользоватьХарактеристики", ИспользоватьХарактеристики);
	КонецЕсли;
	
	ЗаполнятьХарактеристикуОбязательно = Неопределено;
	Если ДополнительнаяИнформация.Свойство("ЗаполнятьХарактеристикуОбязательно", ЗаполнятьХарактеристикуОбязательно) Тогда
		ПолученныеДанные.ПроверятьЗаполнениеХарактеристики = ЗаполнятьХарактеристикуОбязательно;
	КонецЕсли;
	
	Недействителен = Неопределено;
	Если ДополнительнаяИнформация.Свойство("Недействителен", Недействителен) Тогда
		ПолученныеДанные.Недействителен = Недействителен;
	КонецЕсли;
	
	КодПризнакаПредметаРасчета = Неопределено;
	Если ДополнительнаяИнформация.Свойство("КодПризнакаПредметаРасчета", КодПризнакаПредметаРасчета)
		И ТипЗнч(КодПризнакаПредметаРасчета) = Тип("Число") Тогда
		ПризнакПредметаРасчета = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПризнакПредметаРасчетаПоКоду(КодПризнакаПредметаРасчета);
		Если ЗначениеЗаполнено(ПризнакПредметаРасчета) Тогда
			ПолученныеДанные.ПризнакПредметаРасчета = ПризнакПредметаРасчета;
		КонецЕсли;
	КонецЕсли;
	
	Цена = Неопределено;
	Если ДополнительнаяИнформация.Свойство("Цена", Цена) И ТипЗнч(Цена) = Тип("Число") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("эв_УчетнаяЦена", Цена);
	КонецЕсли;
	
КонецПроцедуры

Процедура эв_ЗаписатьУчетнуюЦенуНоменклатуры(ПолученныеДанные, ДанныеИБ)
	
	Цена = Неопределено;
	Если ПолученныеДанные.ЭтоГруппа
		Или Не ПолученныеДанные.ДополнительныеСвойства.Свойство("эв_УчетнаяЦена", Цена) Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	ВидЦен = Справочники.ВидыЦен.Учетная;
	Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидЦен", ВидЦен);
	Отбор.Вставить("Номенклатура", Номенклатура);
	Отбор.Вставить("Характеристика", Характеристика);
	Срез = РегистрыСведений.ЦеныНоменклатуры.СрезПоследних(ТекущаяДатаСеанса(), Отбор);
	Если Срез.Количество() > 0 И Срез[0].Цена = Цена Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = НачалоДня(ТекущаяДатаСеанса());
	МенеджерЗаписи.ВидЦен = ВидЦен;
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.Характеристика = Характеристика;
	МенеджерЗаписи.Цена = Цена;
	МенеджерЗаписи.ЕдиницаИзмерения = ПолученныеДанные.ЕдиницаИзмерения;
	МенеджерЗаписи.Актуальность = Истина;
	МенеджерЗаписи.ВалютаЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦен, "ВалютаЦены");
	МенеджерЗаписи.ОбменДанными.Загрузка = Истина;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Функция эв_JSONИзСтруктуры(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция эв_СтруктураИзДанныхJSON(Данные)
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Возврат Данные;
	КонецЕсли;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Данные Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_СтруктураAdditionalInfo(ДанныеXDTO)
	
	Если Не ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	AdditionalInfo = ДанныеXDTO.AdditionalInfo;
	Если ТипЗнч(AdditionalInfo) = Тип("Структура")
		Или ТипЗнч(AdditionalInfo) = Тип("Соответствие") Тогда
		Возврат эв_СтруктураИзДанныхJSON(AdditionalInfo);
	КонецЕсли;
	Если ТипЗнч(AdditionalInfo) <> Тип("Строка") Или Не ЗначениеЗаполнено(AdditionalInfo) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(AdditionalInfo);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат эв_СтруктураИзДанныхJSON(Данные);
	
КонецФункции

Функция эв_ЭтоОбменУниверсальный(КомпонентыОбмена)
	
	Возврат КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменУниверсальный";
	
КонецФункции

Процедура эв_ДописатьШапкуУстановкиЦенВКомментарий(ДанныеXDTO, КомпонентыОбмена)
	
	Шапка = Неопределено;
	Если ДанныеXDTO = Неопределено
		Или Не КомпонентыОбмена.ПараметрыКонвертации.Свойство("эв_ШапкаУстановкиЦен", Шапка)
		Или Шапка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Комментарий = "";
		ДанныеXDTO.Свойство("Комментарий", Комментарий);
		Если ТипЗнч(Комментарий) <> Тип("Строка") Тогда
			Комментарий = "";
		КонецЕсли;
		Шапка.Вставить("Комментарий", Комментарий);
		ДанныеXDTO.Вставить("Комментарий", эв_МаркерШапкиУстановкиЦен() + эв_JSONИзСтруктуры(Шапка));
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Процедура эв_УпаковатьСтрокиУстановкиЦен(ДанныеXDTO, КомпонентыОбмена)
	
	Если ДанныеXDTO = Неопределено
		Или ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.7") Тогда
		Возврат;
	КонецЕсли;
	
	Товары = Неопределено;
	Если Не ДанныеXDTO.Свойство("Товары", Товары)
		Или ТипЗнч(Товары) <> Тип("ТаблицаЗначений")
		Или Товары.Колонки.Найти("Номенклатура") = Неопределено
		Или Товары.Колонки.Найти("ДанныеНоменклатуры") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Товары.Колонки.Добавить("ДанныеНоменклатуры");
	ЕстьХарактеристика = Товары.Колонки.Найти("Характеристика") <> Неопределено;
	ЕстьУпаковка = Товары.Колонки.Найти("Упаковка") <> Неопределено;
	Для Каждого СтрокаТовары Из Товары Цикл
		ДанныеНоменклатуры = Новый Структура("Номенклатура", СтрокаТовары.Номенклатура);
		Если ЕстьХарактеристика И ЗначениеЗаполнено(СтрокаТовары.Характеристика) Тогда
			ДанныеНоменклатуры.Вставить("Характеристика", СтрокаТовары.Характеристика);
		КонецЕсли;
		Если ЕстьУпаковка И ЗначениеЗаполнено(СтрокаТовары.Упаковка) Тогда
			ДанныеНоменклатуры.Вставить("Упаковка", СтрокаТовары.Упаковка);
		КонецЕсли;
		СтрокаТовары.ДанныеНоменклатуры = ДанныеНоменклатуры;
	КонецЦикла;
	
КонецПроцедуры

Функция эв_ВсеВидыЦен()
	

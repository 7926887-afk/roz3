
&ИзменениеИКонтроль("СинхронизацияДанныхЧерезУниверсальныйФорматПередЗаписью")
Процедура эв_СинхронизацияДанныхЧерезУниверсальныйФорматПередЗаписью(Источник, Отказ)
	
	#Вставка
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.АвтоматическиеСкидки")
		И Не эв_ЭтоГлавныйУзел() Тогда
		Возврат;
	КонецЕсли;
	#КонецВставки
	Попытка
		ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписью("СинхронизацияДанныхЧерезУниверсальныйФормат", Источник, Отказ);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&После("СинхронизацияДанныхЧерезУниверсальныйФорматПередЗаписьюДокумента")
Процедура эв_СинхронизацияДанныхЧерезУниверсальныйФорматПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения)
	
	ор_МенеджерОбменаЧерезУниверсальныйФормат.эв_ЗарегистрироватьЗаказПокупателяКОбменуУниверсальный(Источник, Отказ, РежимЗаписи);
	
КонецПроцедуры

Функция эв_ЭтоГлавныйУзел()
	
	// Константа ГлавныйУзел — ссылка на узел РИБ. В главном узле она не заполнена.
	УстановитьПривилегированныйРежим(Истина);
	Возврат ПланыОбмена.ГлавныйУзел() = Неопределено
		И Не ЗначениеЗаполнено(Константы.ГлавныйУзел.Получить());
	
КонецФункции

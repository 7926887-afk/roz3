
#Область ПрограммныйИнтерфейс

// Открывает форму создания обращения и подставляет навигационную ссылку вызвавшей формы.
//
// Параметры:
//  ПараметрКоманды - ЛюбаяСсылка
//  ПараметрыВыполненияКоманды - Структура - см. ПодключаемыеКомандыКлиент.ПараметрыВыполненияКоманды
//
Процедура СоздатьОбращение(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	ОткрытьСозданиеОбращения(ПараметрыВыполненияКоманды.Форма, ПараметрКоманды);
	
КонецПроцедуры

// Вызывается из стандартной формы отчета.
//
// Параметры:
//  ФормаИсточник - ФормаКлиентскогоПриложения
//  Команда - КомандаФормы
//
Процедура СоздатьОбращениеИзФормы(ФормаИсточник, Команда) Экспорт
	
	ОткрытьСозданиеОбращения(ФормаИсточник, Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОткрытьСозданиеОбращения(ФормаИсточник, ПараметрКоманды)
	
	НавигационнаяСсылка = "";
	ОкноФормы = ФормаИсточник.Окно;
	Если ОкноФормы <> Неопределено Тогда
		НавигационнаяСсылка = ОкноФормы.ПолучитьНавигационнуюСсылку();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НавигационнаяСсылка)
		И ЗначениеЗаполнено(ПараметрКоманды)
		И ТипЗнч(ПараметрКоманды) <> Тип("Массив") Тогда
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ПараметрКоманды);
	КонецЕсли;
	
	ФормаОбращения = ПолучитьФорму("Обработка.эв_СоздатьОбращение.Форма", , ФормаИсточник);
	ФормаОбращения.ОбъектЗадачи = НавигационнаяСсылка;
	ФормаОбращения.Открыть();
	
КонецПроцедуры

#КонецОбласти

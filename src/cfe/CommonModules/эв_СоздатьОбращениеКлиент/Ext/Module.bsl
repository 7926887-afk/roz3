
#Область ПрограммныйИнтерфейс

// Открывает форму создания обращения и подставляет навигационную ссылку вызвавшей формы.
//
// Параметры:
//  ПараметрКоманды - ЛюбаяСсылка
//  ПараметрыВыполненияКоманды - Структура - см. ПодключаемыеКомандыКлиент.ПараметрыВыполненияКоманды
//
Процедура СоздатьОбращение(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	ОткрытьСозданиеОбращения(ПараметрыВыполненияКоманды.Форма, ПараметрКоманды);
	
КонецПроцедуры

// Вызывается из стандартной формы отчета.
//
// Параметры:
//  ФормаИсточник - ФормаКлиентскогоПриложения
//  Команда - КомандаФормы
//
Процедура СоздатьОбращениеИзФормы(ФормаИсточник, Команда) Экспорт
	
	ОткрытьСозданиеОбращения(ФормаИсточник, Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОткрытьСозданиеОбращения(ФормаИсточник, ПараметрКоманды)
	
	НавигационнаяСсылка = НавигационнаяСсылкаИсточника(ФормаИсточник, ПараметрКоманды);
	
	ФормаОбращения = ПолучитьФорму("Обработка.эв_СоздатьОбращение.Форма", , ФормаИсточник);
	ФормаОбращения.ОбъектЗадачи = НавигационнаяСсылка;
	ФормаОбращения.Открыть();
	
КонецПроцедуры

Функция НавигационнаяСсылкаИсточника(ФормаИсточник, ПараметрКоманды)
	
	// У формы отчета ссылка окна пустая: платформа публикует ссылку варианта.
	НавигационнаяСсылка = НавигационнаяСсылкаВариантаОтчета(ФормаИсточник);
	
	Если Не ЗначениеЗаполнено(НавигационнаяСсылка)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаИсточник, "НавигационнаяСсылка") Тогда
		НавигационнаяСсылка = ФормаИсточник.НавигационнаяСсылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НавигационнаяСсылка) И ФормаИсточник.Окно <> Неопределено Тогда
		НавигационнаяСсылка = ФормаИсточник.Окно.ПолучитьНавигационнуюСсылку();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НавигационнаяСсылка)
		И ЗначениеЗаполнено(ПараметрКоманды)
		И ТипЗнч(ПараметрКоманды) <> Тип("Массив") Тогда
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ПараметрКоманды);
	КонецЕсли;
	
	Возврат НавигационнаяСсылка;
	
КонецФункции

Функция НавигационнаяСсылкаВариантаОтчета(ФормаИсточник)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаИсточник, "НастройкиОтчета") Тогда
		Возврат "";
	КонецЕсли;
	
	НастройкиОтчета = ФормаИсточник.НастройкиОтчета;
	ТипНастроек = ТипЗнч(НастройкиОтчета);
	Если ТипНастроек <> Тип("Структура")
		И ТипНастроек <> Тип("ФиксированнаяСтруктура")
		И ТипНастроек <> Тип("ДанныеФормыСтруктура") Тогда
		Возврат "";
	КонецЕсли;
	
	ВариантСсылка = Неопределено;
	Внешний = Ложь;
	НастройкиОтчета.Свойство("ВариантСсылка", ВариантСсылка);
	НастройкиОтчета.Свойство("Внешний", Внешний);
	Если Внешний = Истина Или Не ЗначениеЗаполнено(ВариантСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПолучитьНавигационнуюСсылку(ВариантСсылка);
	
КонецФункции

#КонецОбласти

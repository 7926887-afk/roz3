#Область ПрограммныйИнтерфейс

&ИзменениеИКонтроль("СформироватьДокументВыемки")
Функция эв_СформироватьДокументВыемки(Результат, ПараметрыВыемки)
	
	ДокументВыемки = Неопределено;
	
	ИзымаемаяСумма = ПараметрыВыемки.ИзымаемаяСумма;
	КассаККМ = ПараметрыВыемки.КассаККМ;
	ОРП = ПараметрыВыемки.ОРП;
	
	ПараметрыКассаККМ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассаККМ, "ВалютаДенежныхСредств, Владелец");
	
	СуммаДокумента = ?(Результат = Неопределено, ИзымаемаяСумма, Результат);
	
	Если Результат <> Неопределено Тогда
		
		#Вставка
		Возврат эв_СоздатьВыемкиРазменаИВыручки(СуммаДокумента, КассаККМ, ОРП, ПараметрыКассаККМ);
		#КонецВставки
		УстановитьПривилегированныйРежим(Истина);
		
		НовыйДокумент = Документы.ВыемкаНаличных.СоздатьДокумент();
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());
		СтруктураЗаполнения.Вставить("СуммаДокумента", СуммаДокумента);
		СтруктураЗаполнения.Вставить("КассаККМ", КассаККМ);
		СтруктураЗаполнения.Вставить("ВалютаДенежныхСредств", ПараметрыКассаККМ.ВалютаДенежныхСредств);
		СтруктураЗаполнения.Вставить("Организация", ПараметрыКассаККМ.Владелец);
		СтруктураЗаполнения.Вставить("ОтчетОРозничныхПродажах", ОРП);
		
		НовыйДокумент.Заполнить(СтруктураЗаполнения);
		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Ошибка при записи документа ""Выемка наличных"".'"),
				УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		ДокументВыемки = НовыйДокумент.Ссылка;
		
	КонецЕсли;
	
	Возврат ДокументВыемки;
	
КонецФункции

&ИзменениеИКонтроль("СоздатьПоступлениеВКассу")
Процедура эв_СоздатьПоступлениеВКассу(ДокументОснование, ПараметрыСозданияПоступления)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПоступлениеВКассу = Документы.ПоступлениеВКассу.СоздатьДокумент();
	
	ПоступлениеВКассу.Заполнить(ДокументОснование);
	ПоступлениеВКассу.Касса = ПараметрыСозданияПоступления;
	ПоступлениеВКассу.Дата = ТекущаяДатаСеанса();
	#Вставка
	эв_НастроитьПоступлениеРазмена(ПоступлениеВКассу);
	#КонецВставки
	
	Если ПерсональныеНастройкиРУНФ.Прочитать("ЗаполнятьПринятоОтТекущимПользователем") Тогда
		ПоступлениеВКассу.ПринятоОт = Строка(ПоступлениеВКассу.Автор);
	КонецЕсли;
	
	Попытка
		ПоступлениеВКассу.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Ошибка при записи документа ""Поступление в кассу"".'"),
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&После("ЗаполнитьОбщиеПараметрыЧекаКоррекцииПоДаннымФискальнойОперации")
Процедура эв_ЗаполнитьОбщиеПараметрыЧекаКоррекцииПоДаннымФискальнойОперации(ОбщиеПараметры, ФискальнаяОперация)
	
	эв_ЗаполнитьСистемуНалогообложенияЧекаКоррекции(ОбщиеПараметры, ФискальнаяОперация.ДокументОснование);
	
КонецПроцедуры

&ИзменениеИКонтроль("ЧекКоррекцииСторно")
Процедура эв_ЧекКоррекцииСторно(Контекст, РезультатЧекСторно)
	
	ЧекОбъект = Документы.ЧекККМКоррекции.СоздатьДокумент();
	ЧекОбъект.Дата = ТекущаяДатаСеанса();
	ЧекОбъект.ЭтоСторно = Истина;
	
	ОбщиеПараметры = ОборудованиеЧекопечатающиеУстройства.ЗагрузитьДанныеФискализацииИзXML(
		Контекст.ДанныеXMLКорректируемогоЧека);
	#Вставка
	Если (ТипЗнч(Контекст.ДокументОснование) = Тип("ДокументСсылка.ЧекККМ")
		Или ТипЗнч(Контекст.ДокументОснование) = Тип("ДокументСсылка.ЧекККМВозврат"))
		И ЗначениеЗаполнено(ОбщиеПараметры)
		И Не ЗначениеЗаполнено(ОбщиеПараметры.СистемаНалогообложения) Тогда
		ОбщиеПараметры.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ.ОСН;
	КонецЕсли;
	#КонецВставки
	
	ЗаполнитьЗначенияСвойств(
		ЧекОбъект,
		Контекст,
		"ДатаКоррекции,
		|ДокументОснование,
		|ДокументРасчетов, 
		|ДополнительныйРеквизит,
		|КассаККМ,
		|СтруктурнаяЕдиница,
		|НомерПредписания,
		|ОписаниеКоррекции,
		|Организация,
		|Ответственный,
		|ТипКоррекции,
		|Комментарий,
		|Кассир,
		|КассирИНН");
	
	ЗаполнитьЗначенияСвойств(
		ЧекОбъект,
		ОбщиеПараметры,
		"АдресМагазина,
		|АдресРасчетов,
		|ПокупательEmail,
		|ПокупательНомер,
		|МестоРасчетов,
		|ПризнакАгента,
		|СистемаНалогообложения,
		|ЧасоваяЗона");
	
	ЧекОбъект.РасчетВИнтернете = ОбщиеПараметры.Интернет;
	
	Если ЗначениеЗаполнено(ОбщиеПараметры.Получатель) Тогда
		ЧекОбъект.Покупатель = ОбщиеПараметры.Получатель;
	Иначе
		ЧекОбъект.Покупатель = ОбщиеПараметры.СведенияОПокупателе.Покупатель;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбщиеПараметры.ПолучательИНН) Тогда
		ЧекОбъект.ПокупательИНН = ОбщиеПараметры.ПолучательИНН;
	Иначе
		ЧекОбъект.ПокупательИНН = ОбщиеПараметры.СведенияОПокупателе.ПокупательИНН;
	КонецЕсли;
	
	Если ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств Тогда
		ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	ИначеЕсли ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств Тогда
		ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	ИначеЕсли ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.РасходДенежныхСредств Тогда
		ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратРасходаДенежныхСредств;
	ИначеЕсли ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратРасходаДенежныхСредств Тогда
		ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.РасходДенежныхСредств;
	Иначе
		ТипРасчета = Неопределено;
	КонецЕсли;
	
	ЧекОбъект.ТипРасчета = ТипРасчета;
	
	// Позиции чека
	ЗаполнитьПозицииЧекаКоррекцииНаОсновании(Контекст.ДокументОснование, ОбщиеПараметры, ЧекОбъект.ПозицииЧека);
	
	// Оплаты
	Для Каждого СтрокаОплаты Из ОбщиеПараметры.ТаблицаОплат Цикл
		
		НоваяСтрока = ЧекОбъект.Оплата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОплаты);
		
	КонецЦикла;
	
	// Запись чека
	Попытка
		ЧекОбъект.Записать(РежимЗаписиДокумента.Запись);
		РезультатЧекСторно = ЧекОбъект.Ссылка;
	Исключение
		СтрокаОшибки = НСтр("ru = 'Не удалось записать чек коррекции сторно по причине:'") + Символы.ПС + ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки);
		РезультатЧекСторно = Неопределено;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура эв_ЗаполнитьСистемуНалогообложенияЧекаКоррекции(ОбщиеПараметры, ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ЧекККМ")
		И ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ЧекККМВозврат") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбщиеПараметры)
		Или ЗначениеЗаполнено(ОбщиеПараметры.СистемаНалогообложения) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщиеПараметры.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ.ОСН;
	
КонецПроцедуры

Функция эв_ИмяСтатьиПоступленияРазмена()
	
	Возврат НСтр("ru = 'Поступление денежных средств из кассы ККМ (Размен)'");
	
КонецФункции

Функция эв_СоставОстаткаКассыККМ(Организация, КассаККМ) Экспорт
	
	Состав = Новый Структура("Остаток, СуммаРазмена, СуммаВыручки", 0, 0, 0);
	
	ОрганизацияОстатков = Организация;
	Если Константы.УчетПоКомпании.Получить() Тогда
		ОрганизацияОстатков = Константы.Компания.Получить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ОрганизацияОстатков);
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ДенежныеСредстваВКассахККМОстатки.СуммаВалОстаток), 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваВКассахККМ.Остатки(
	|			,
	|			Организация = &Организация
	|				И КассаККМ = &КассаККМ) КАК ДенежныеСредстваВКассахККМОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ДенежныеСредстваРазменОстатки.СуммаВалОстаток), 0) КАК СуммаРазмена
	|ИЗ
	|	РегистрНакопления.эв_ДенежныеСредстваВКассахККМРазмен.Остатки(
	|			,
	|			Организация = &Организация
	|				И КассаККМ = &КассаККМ) КАК ДенежныеСредстваРазменОстатки";
	
	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаОстатка = Результаты[0].Выбрать();
	Если ВыборкаОстатка.Следующий() Тогда
		Состав.Остаток = ВыборкаОстатка.Остаток;
	КонецЕсли;
	
	ВыборкаРазмена = Результаты[1].Выбрать();
	Если ВыборкаРазмена.Следующий() Тогда
		Состав.СуммаРазмена = Макс(ВыборкаРазмена.СуммаРазмена, 0);
	КонецЕсли;
	
	Если Состав.СуммаРазмена > Состав.Остаток Тогда
		Состав.СуммаРазмена = Макс(Состав.Остаток, 0);
	КонецЕсли;
	Состав.СуммаВыручки = Состав.Остаток - Состав.СуммаРазмена;
	
	Возврат Состав;
	
КонецФункции

Функция эв_СоздатьВыемкиРазменаИВыручки(СуммаДокумента, КассаККМ, ОРП, ПараметрыКассаККМ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Состав = эв_СоставОстаткаКассыККМ(ПараметрыКассаККМ.Владелец, КассаККМ);
	СуммаРазмена = Состав.СуммаРазмена;
	СуммаВыручки = Состав.СуммаВыручки;
	
	Если СуммаРазмена > 0 И эв_СуммыРавны(СуммаДокумента, СуммаРазмена) Тогда
		Возврат эв_ЗаписатьВыемкуНаличных(СуммаРазмена, КассаККМ, Неопределено, ПараметрыКассаККМ, ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если СуммаВыручки > 0 И эв_СуммыРавны(СуммаДокумента, СуммаВыручки) Тогда
		Возврат эв_ЗаписатьВыемкуНаличных(СуммаВыручки, КассаККМ, ОРП, ПараметрыКассаККМ, ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если СуммаРазмена > 0 И СуммаДокумента > СуммаРазмена Тогда
		ДатаРазмена = ТекущаяДатаСеанса();
		ДокументРазмена = эв_ЗаписатьВыемкуНаличных(СуммаРазмена, КассаККМ, Неопределено, ПараметрыКассаККМ, ДатаРазмена);
		Если Не ЗначениеЗаполнено(ДокументРазмена) Тогда
			Возврат Неопределено;
		КонецЕсли;
		эв_СоздатьПоступлениеРазмена(ДокументРазмена, КассаККМ);
		Возврат эв_ЗаписатьВыемкуНаличных(СуммаДокумента - СуммаРазмена, КассаККМ, ОРП, ПараметрыКассаККМ, ДатаРазмена + 1);
	КонецЕсли;
	
	Если СуммаРазмена > 0 И СуммаДокумента < СуммаРазмена Тогда
		Возврат эв_ЗаписатьВыемкуНаличных(СуммаДокумента, КассаККМ, Неопределено, ПараметрыКассаККМ, ТекущаяДатаСеанса());
	КонецЕсли;
	
	Возврат эв_ЗаписатьВыемкуНаличных(СуммаДокумента, КассаККМ, ОРП, ПараметрыКассаККМ, ТекущаяДатаСеанса());
	
КонецФункции

Функция эв_ЗаписатьВыемкуНаличных(СуммаДокумента, КассаККМ, ОРП, ПараметрыКассаККМ, ДатаДокумента)
	
	НовыйДокумент = Документы.ВыемкаНаличных.СоздатьДокумент();
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("Дата", ДатаДокумента);
	СтруктураЗаполнения.Вставить("СуммаДокумента", СуммаДокумента);
	СтруктураЗаполнения.Вставить("КассаККМ", КассаККМ);
	СтруктураЗаполнения.Вставить("ВалютаДенежныхСредств", ПараметрыКассаККМ.ВалютаДенежныхСредств);
	СтруктураЗаполнения.Вставить("Организация", ПараметрыКассаККМ.Владелец);
	Если ЗначениеЗаполнено(ОРП) Тогда
		СтруктураЗаполнения.Вставить("ОтчетОРозничныхПродажах", ОРП);
	КонецЕсли;
	
	НовыйДокумент.Заполнить(СтруктураЗаполнения);
	Если Не ЗначениеЗаполнено(ОРП) Тогда
		НовыйДокумент.ОтчетОРозничныхПродажах = Документы.ОтчетОРозничныхПродажах.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Ошибка при записи документа ""Выемка наличных"".'"),
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат НовыйДокумент.Ссылка;
	
КонецФункции

Процедура эв_СоздатьПоступлениеРазмена(ДокументВыемки, КассаККМ)
	
	Если Не ЗначениеЗаполнено(ДокументВыемки) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыКассы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассаККМ,
		"СоздаватьПоступлениеВКассу, КассаДляРозничнойВыручки");
	Если Не РеквизитыКассы.СоздаватьПоступлениеВКассу
		Или Не ЗначениеЗаполнено(РеквизитыКассы.КассаДляРозничнойВыручки) Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьПоступлениеВКассу(ДокументВыемки, РеквизитыКассы.КассаДляРозничнойВыручки);
	
КонецПроцедуры

Процедура эв_НастроитьПоступлениеРазмена(ПоступлениеВКассу) Экспорт
	
	Если ТипЗнч(ПоступлениеВКассу.ДокументОснование) <> Тип("ДокументСсылка.ВыемкаНаличных") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ПоступлениеВКассу.ДокументОснование, "ОтчетОРозничныхПродажах")) Тогда
		Возврат;
	КонецЕсли;
	
	ПоступлениеВКассу.ВидОперации = Перечисления.ВидыОперацийПоступлениеВКассу.Прочее;
	ПоступлениеВКассу.Корреспонденция = ПланыСчетов.Управленческий.ПереводыВПути;
	ПоступлениеВКассу.РасшифровкаПлатежа.Очистить();
	
	СтатьяРазмена = эв_СтатьяПоступленияРазмена();
	Если ЗначениеЗаполнено(СтатьяРазмена) Тогда
		ПоступлениеВКассу.Статья = СтатьяРазмена;
	Иначе
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Не найдена статья движения денежных средств ""%1"".'"),
			эв_ИмяСтатьиПоступленияРазмена()));
	КонецЕсли;
	
КонецПроцедуры

Функция эв_СтатьяПоступленияРазмена()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", эв_ИмяСтатьиПоступленияРазмена());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Статьи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК Статьи
	|ГДЕ
	|	Статьи.Наименование = &Наименование
	|	И НЕ Статьи.ЭтоГруппа
	|	И НЕ Статьи.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	
КонецФункции

Функция эв_СуммыРавны(Сумма1, Сумма2)
	
	Возврат Окр(Сумма1, 2) = Окр(Сумма2, 2);
	
КонецФункции

Процедура эв_ОтразитьРазменКассыККМ(ДокументОбъект, ВидДвижения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвижения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДвиженияКассы.Организация КАК Организация,
	|	ДвиженияКассы.КассаККМ КАК КассаККМ,
	|	СУММА(ДвиженияКассы.Сумма) КАК Сумма,
	|	СУММА(ДвиженияКассы.СуммаВал) КАК СуммаВал
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваВКассахККМ КАК ДвиженияКассы
	|ГДЕ
	|	ДвиженияКассы.Регистратор = &Ссылка
	|	И ДвиженияКассы.ВидДвижения = &ВидДвижения
	|	И ДвиженияКассы.СуммаВал <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияКассы.Организация,
	|	ДвиженияКассы.КассаККМ";
	
	Набор = ДокументОбъект.Движения.эв_ДенежныеСредстваВКассахККМРазмен;
	Набор.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Движение = Набор.Добавить();
		Движение.ВидДвижения = ВидДвижения;
		Движение.Период = ДокументОбъект.Дата;
		Движение.Организация = Выборка.Организация;
		Движение.КассаККМ = Выборка.КассаККМ;
		Движение.Сумма = Выборка.Сумма;
		Движение.СуммаВал = Выборка.СуммаВал;
	КонецЦикла;
	
	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Набор.Записывать = Истина;
	Набор.Записать();
	Набор.Записывать = Ложь;
	
КонецПроцедуры

#КонецОбласти

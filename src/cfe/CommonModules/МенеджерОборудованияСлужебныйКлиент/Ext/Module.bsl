
&Вместо ("ОбработатьРезультат")
Асинх Функция эв_ОбработатьРезультат(Контекст, Команда, РезультатОперации)
	
	//##+
	// Возврат Спасибо: сразу после эквайринга и до серверной сборки/печати слипа,
    // чтобы текст процессинга попал в XML слипа.
   	 Если Команда = "AuthorizeRefund"
   		 И РезультатОперации.Результат
   		 И Контекст.ДополнительныеПараметры.Свойство("ИдентификаторПС") 
   		 И ЗначениеЗаполнено(Контекст.ДополнительныеПараметры.ИдентификаторПС) Тогда
   		 
   		 Попытка
   			 Результат = Ждать эвСберСпасибоКлиент.ОбработатьВозвратДоПечатиСлипа(Контекст, Команда, РезультатОперации);
   		 Исключение
   		     //Ошибка Спасибо не должна срывать печать слипа и завершение возврата по карте.
   		 КонецПопытки;
   		 
   	 КонецЕсли;
   	 //##-
	
	РезультатОперации.Вставить("ТестовоеПолеСозданноеНаКлиенте", Новый Структура);
	
	Если Контекст.ОбработатьДанныеПриОшибкеСервер 
		Или (Контекст.ОбработатьДанныеСервер И РезультатОперации.Результат) Тогда
		ПараметрыПодключенияСервер = ПараметрыПодключенияСервер(Контекст);
		МенеджерОборудованияВызовСервера.ПриОбработкеРезультатовОперации(
			Контекст.ПроцессорДанныхСервер,
			Контекст.ДанныеОперации, 
			ПараметрыПодключенияСервер, 
			Команда, 
			РезультатОперации);
	КонецЕсли;
		
	Если Контекст.ОбработатьДанныеПриОшибкеКлиент
		Или (Контекст.ОбработатьДанныеКлиент И РезультатОперации.Результат) Тогда
		
		Контекст.ДанныеОперации.Вставить("ДополнительныеПараметры", Контекст.ДополнительныеПараметры);
		МодульПроцессорДанных = ОбщегоНазначенияБПОКлиент.ОбщийМодуль(Контекст.ПроцессорДанныхКлиент);
		ПараметрыПодключенияКлиент = ПараметрыПодключенияКлиент(Контекст);
		Ждать МодульПроцессорДанных.ПриОбработкеРезультатовОперацииАсинх(
			Контекст.ДанныеОперации, 
			ПараметрыПодключенияКлиент, 
			Команда, 
			РезультатОперации);
		Контекст.ДанныеОперации.Удалить("ДополнительныеПараметры");
	КонецЕсли;
	
	Возврат РезультатОперации;
	
КонецФункции


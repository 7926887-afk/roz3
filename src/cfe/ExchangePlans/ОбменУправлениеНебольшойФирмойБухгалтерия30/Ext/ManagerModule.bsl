
&Вместо("ОбъектПодходитПодНастройкиВыгрузкиУзла")
Функция эв_ОбъектПодходитПодНастройкиВыгрузкиУзла(Узел, Объект)
	
	Если эв_ЭтоЗаказПокупателяОбменаУниверсальный(Узел, Объект) Тогда
		Возврат Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "РучнойОбмен");
	КонецЕсли;
	
	Возврат ПродолжитьВызов(Узел, Объект);
	
КонецФункции

Функция эв_ЭтоЗаказПокупателяОбменаУниверсальный(Узел, Объект)
	
	Если ТипЗнч(Узел) <> Тип("ПланОбменаСсылка.СинхронизацияДанныхЧерезУниверсальныйФормат") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Объект) <> Тип("ДокументОбъект.ЗаказПокупателя")
		И ТипЗнч(Объект) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ВариантНастройки") = "ОбменУниверсальный";
	
КонецФункции

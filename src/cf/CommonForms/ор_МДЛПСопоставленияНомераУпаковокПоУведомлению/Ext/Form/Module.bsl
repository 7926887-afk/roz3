&НаКлиенте
Процедура ПеренестиВверхВнизНомерУпаковки(Вверх = Ложь)
	
	Если Вверх Тогда
		
		ТекущаяСтрокаНЕсопосталена = Элементы.НомераУпаковокУведомления.ТекущиеДанные;
		
		Если ТекущаяСтрокаНЕсопосталена = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ТекущаяСтрокаТовары = Элементы.Товары.ТекущиеДанные;
		
		Если ТекущаяСтрокаТовары = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НайденныеСтрокиНомеров = НомераУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрокаТовары.ор_ИдентификаторСтроки));
		
		Если НайденныеСтрокиНомеров.Количество() = ТекущаяСтрокаТовары.Количество Тогда
			ТекстСообщения = НСтр("ru='Для выбранной строки таблицы ""Товары"" номера упаковок заполнены.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		Если НЕ Игнорироватьцену И ТекущаяСтрокаНЕсопосталена.Цена <> ТекущаяСтрокаТовары.Цена Тогда
			ТекстСообщения = НСтр("ru='Цена переносимой строки отличается от цены выбранной строки таблицы ""Товары"".'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		НоваяСтрока = НомераУпаковок.Добавить();
		НоваяСтрока.НомерКИЗ = ТекущаяСтрокаНЕсопосталена.НомерКИЗ;
		НоваяСтрока.Цена = ТекущаяСтрокаНЕсопосталена.Цена;
		НоваяСтрока.Уведомление = ТекущаяСтрокаНЕсопосталена.Уведомление;
		НоваяСтрока.СостояниеПодтверждения = ТекущаяСтрокаНЕсопосталена.СостояниеПодтверждения;
		НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрокаТовары.ор_ИдентификаторСтроки;
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрокаТовары.GTIN) Тогда
			ТекущаяСтрокаТовары.GTIN = ТекущаяСтрокаНЕсопосталена.GTIN;
		КонецЕсли;
		
		Если НЕ ТекущаяСтрокаТовары.ИспользоватьНомераУпаковок Тогда
			ТекущаяСтрокаТовары.ИспользоватьНомераУпаковок = Истина;
		КонецЕсли;
		
		НомераУпаковокУведомления.Удалить(ТекущаяСтрокаНЕсопосталена);
		
		ор_ИнтеграцияМДЛПКлиентСервер.ОбновитьСтатусыЗаполненияНомеровУпаковок(ЭтотОбъект, "Товары", "НомераУпаковок");
		
	Иначе
		
		ТекущаяСтрокаНомераУпаковки = Элементы.НомераУпаковок.ТекущиеДанные;
		
		Если ТекущаяСтрокаНомераУпаковки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НоваяСтрока = НомераУпаковокУведомления.Добавить();
		НоваяСтрока.НомерКИЗ = ТекущаяСтрокаНомераУпаковки.НомерКИЗ;
		НоваяСтрока.Цена = ТекущаяСтрокаНомераУпаковки.Цена;
		НоваяСтрока.Уведомление = ТекущаяСтрокаНомераУпаковки.Уведомление;
		НоваяСтрока.СостояниеПодтверждения = ТекущаяСтрокаНомераУпаковки.СостояниеПодтверждения;
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.GTIN = Лев(НоваяСтрока.НомерКИЗ, 14);
		
		НомераУпаковок.Удалить(ТекущаяСтрокаНомераУпаковки);
		
		ор_ИнтеграцияМДЛПКлиентСервер.ОбновитьСтатусыЗаполненияНомеровУпаковок(ЭтотОбъект, "Товары", "НомераУпаковок");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВверхВнизТранспортнуюУпаковку(Вверх = Ложь)
	
	Если Вверх Тогда
		
		ТекущаяСтрокаТранспортнаяУпаковкаУедомления = Элементы.ТранспортныеУпаковкиУведомления.ТекущиеДанные;
		
		Если ТекущаяСтрокаТранспортнаяУпаковкаУедомления = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НоваяСтрока = ТранспортныеУпаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрокаТранспортнаяУпаковкаУедомления);
		
		НайденныеСтрокиСостава = СоставТранспортныхУпаковокУведомления.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрокаТранспортнаяУпаковкаУедомления.ИдентификаторСтроки));
		
		МассивСтрокУдаления = Новый Массив;
		
		Для Каждого Строка Из НайденныеСтрокиСостава Цикл
			
			НоваяСтрокаСостава = СоставТранспортныхУпаковок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, Строка);
			
			МассивСтрокУдаления.Добавить(Строка);
			
		КонецЦикла;
		
		ТранспортныеУпаковкиУведомления.Удалить(ТекущаяСтрокаТранспортнаяУпаковкаУедомления);
		
		Для Каждого Строка Из МассивСтрокУдаления Цикл
			СоставТранспортныхУпаковокУведомления.Удалить(Строка);
		КонецЦикла;
		
	Иначе
		
		ТекущаяСтрокаТранспортнаяУпаковка = Элементы.ТранспортныеУпаковки.ТекущиеДанные;
		
		Если ТекущаяСтрокаТранспортнаяУпаковка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ТекущаяСтрокаТранспортнаяУпаковка.ИзОснования Тогда
			ТекстСообщения = НСтр("ru='Номер транспортной упаковки %НомерУпаковки% уже заполнен в документе.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", ТекущаяСтрокаТранспортнаяУпаковка.НомерУпаковки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		НоваяСтрока = ТранспортныеУпаковкиУведомления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрокаТранспортнаяУпаковка);
		
		НайденныеСтрокиСостава = СоставТранспортныхУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрокаТранспортнаяУпаковка.ИдентификаторСтроки));
		
		МассивСтрокУдаления = Новый Массив;
		
		Для Каждого Строка Из НайденныеСтрокиСостава Цикл
			
			НоваяСтрокаСостава = СоставТранспортныхУпаковокУведомления.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, Строка);
			
			МассивСтрокУдаления.Добавить(Строка);
			
		КонецЦикла;
		
		ТранспортныеУпаковки.Удалить(ТекущаяСтрокаТранспортнаяУпаковка);
		
		Для Каждого Строка Из МассивСтрокУдаления Цикл
			СоставТранспортныхУпаковок.Удалить(Строка);
		КонецЦикла;
		
	КонецЕсли;
	
	НомерСтроки = 1;
	Для Каждого Строка Из СоставТранспортныхУпаковок Цикл
		Строка.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		Если ЗначениеЗаполнено(Строка.Характеристика) Тогда
			Строка.МаркируемыйТовар = ОбновитьПризнакМаркируемыйТовар(Строка.Характеристика);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОбновитьПризнакМаркируемыйТовар(Характеристика)
	
	Возврат Характеристика.ор_МаркируемыйТовар;
	
КонецФункции

&НаСервере
Функция ПроверитьСериюПроизводителяХарактеристики(Характеристика, НомерСерии)
	
	Если НомерСерии = Характеристика.ор_СерияПроизводителя Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруНедоступныхНомеров(СписокУведомлений2)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Номераупаковок", Новый СписокЗначений);
	СтруктураВозврата.Вставить("ТранспортныеУпаковки", Новый СписокЗначений);
	
	Если ФормаОткрытаИзУведомления Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОснованиеСсылкаВходящая) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	
	Если ТипЗнч(ОснованиеСсылкаВходящая) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.НомерКИЗ КАК НомерКИЗ
		|ПОМЕСТИТЬ втНомераДокумента
		|ИЗ
		|	Документ.ПриходныйОрдер.ор_НомераУпаковок КАК ПриходныйОрдерНаТоварыор_НомераУпаковок
		|ГДЕ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка.ДокументОснование В (&СписокДокументов)
		|	И НЕ ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка В (&СписокИсключений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.НомерКИЗ КАК НомерКИЗ
		|ПОМЕСТИТЬ втНомераУведомлений
		|ИЗ
		|	Документ.УведомлениеОПриемкеМДЛП.НомераУпаковок КАК УведомлениеОПриемкеМДЛПНомераУпаковок
		|ГДЕ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка В(&СписокУведомлений)
		|	И УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка.Основание = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	втНомераДокумента.НомерКИЗ КАК НомерКИЗ
		|ИЗ
		|	втНомераДокумента КАК втНомераДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втНомераУведомлений КАК втНомераУведомлений
		|		ПО втНомераДокумента.НомерКИЗ = втНомераУведомлений.НомерКИЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.НомерУпаковки КАК НомерУпаковки
		|ПОМЕСТИТЬ втТранспортныеУпаковкиДокумента
		|ИЗ
		|	Документ.ПриходныйОрдер.ор_ТранспортныеУпаковки КАК ПриходныйОрдерНаТоварыор_НомераУпаковок
		|ГДЕ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка.ДокументОснование В (&СписокДокументов)
		|	И НЕ ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка В (&СписокИсключений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.НомерУпаковки КАК НомерУпаковки
		|ПОМЕСТИТЬ втТранспортныеУпаковкиУведомлений
		|ИЗ
		|	Документ.УведомлениеОПриемкеМДЛП.ТранспортныеУпаковки КАК УведомлениеОПриемкеМДЛПНомераУпаковок
		|ГДЕ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка В(&СписокУведомлений)
		|	И УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка.Основание = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	втТранспортныеУпаковкиДокумента.НомерУпаковки КАК НомерУпаковки
		|ИЗ
		|	втТранспортныеУпаковкиДокумента КАК втТранспортныеУпаковкиДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТранспортныеУпаковкиУведомлений КАК втТранспортныеУпаковкиУведомлений
		|		ПО втТранспортныеУпаковкиДокумента.НомерУпаковки = втТранспортныеУпаковкиУведомлений.НомерУпаковки";
		
		СписокИсключений = Новый СписокЗначений;
		СписокИсключений.Добавить(ОснованиеСсылкаВходящая);
		
		СписокДокументов = Новый СписокЗначений;
		СписокДокументов.Добавить(ОснованиеСсылка);
		
		Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
		Запрос.УстановитьПараметр("СписокИсключений", СписокИсключений);
		Запрос.УстановитьПараметр("СписокУведомлений", СписокУведомлений2);
		Запрос.УстановитьПараметр("Основание", ОснованиеСсылка);
		
		Результат = Запрос.ВыполнитьПакет();
		РезультатНомера = Результат[2].Выгрузить();
		РезультатТранспортные = Результат[5].Выгрузить();
		
		Для Каждого Строка Из РезультатНомера Цикл
			СтруктураВозврата.НомераУпаковок.Добавить(Строка.НомерКИЗ);
		КонецЦикла;
		
		Для Каждого Строка Из РезультатТранспортные Цикл
			СтруктураВозврата.ТранспортныеУпаковки.Добавить(Строка.НомерУпаковки);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОснованиеСсылкаВходящая) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.НомерКИЗ КАК НомерКИЗ
		|ПОМЕСТИТЬ втНомераДокумента
		|ИЗ
		|	Документ.РасходныйОрдер.ор_НомераУпаковок КАК ПриходныйОрдерНаТоварыор_НомераУпаковок
		|ГДЕ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка.ДокументОснование В(&СписокДокументов)
		|	И НЕ ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка В (&СписокИсключений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.НомерКИЗ КАК НомерКИЗ
		|ПОМЕСТИТЬ втНомераУведомлений
		|ИЗ
		|	Документ.УведомлениеОбОтгрузкеМДЛП.НомераУпаковок КАК УведомлениеОПриемкеМДЛПНомераУпаковок
		|ГДЕ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка В(&СписокУведомлений)
		|	И УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка.Основание = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	втНомераДокумента.НомерКИЗ КАК НомерКИЗ
		|ИЗ
		|	втНомераДокумента КАК втНомераДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втНомераУведомлений КАК втНомераУведомлений
		|		ПО втНомераДокумента.НомерКИЗ = втНомераУведомлений.НомерКИЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.НомерУпаковки КАК НомерУпаковки
		|ПОМЕСТИТЬ втТранспортныеУпаковкиДокумента
		|ИЗ
		|	Документ.РасходныйОрдер.ор_ТранспортныеУпаковки КАК ПриходныйОрдерНаТоварыор_НомераУпаковок
		|ГДЕ
		|	ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка.ДокументОснование В(&СписокДокументов)
		|	И НЕ ПриходныйОрдерНаТоварыор_НомераУпаковок.Ссылка В (&СписокИсключений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.НомерУпаковки КАК НомерУпаковки
		|ПОМЕСТИТЬ втТранспортныеУпаковкиУведомлений
		|ИЗ
		|	Документ.УведомлениеОбОтгрузкеМДЛП.ТранспортныеУпаковки КАК УведомлениеОПриемкеМДЛПНомераУпаковок
		|ГДЕ
		|	УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка В(&СписокУведомлений)
		|	И УведомлениеОПриемкеМДЛПНомераУпаковок.Ссылка.Основание = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	втТранспортныеУпаковкиДокумента.НомерУпаковки КАК НомерУпаковки
		|ИЗ
		|	втТранспортныеУпаковкиДокумента КАК втТранспортныеУпаковкиДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТранспортныеУпаковкиУведомлений КАК втТранспортныеУпаковкиУведомлений
		|		ПО втТранспортныеУпаковкиДокумента.НомерУпаковки = втТранспортныеУпаковкиУведомлений.НомерУпаковки";
		
		СписокИсключений = Новый СписокЗначений;
		СписокДокументов.Добавить(ОснованиеСсылкаВходящая);
		
		СписокДокументов = Новый СписокЗначений;
		СписокДокументов.Добавить(ОснованиеСсылка);
		
		Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
		Запрос.УстановитьПараметр("СписокИсключений", СписокИсключений);
		Запрос.УстановитьПараметр("СписокУведомлений", СписокУведомлений2);
		Запрос.УстановитьПараметр("Основание", ОснованиеСсылка);
		
		Результат = Запрос.ВыполнитьПакет();
		РезультатНомера = Результат[2].Выгрузить();
		РезультатТранспортные = Результат[5].Выгрузить();
		
		Для Каждого Строка Из РезультатНомера Цикл
			СтруктураВозврата.НомераУпаковок.Добавить(Строка.НомерКИЗ);
		КонецЦикла;
		
		Для Каждого Строка Из РезультатТранспортные Цикл
			СтруктураВозврата.ТранспортныеУпаковки.Добавить(Строка.НомерУпаковки);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ПолученнаяТекущаяСтраница <> ТекущаяСтраница.Имя Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы[ПолученнаяТекущаяСтраница];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекущуюСтраницу(ИмяСтраницы)
	
	ПолученнаяТекущаяСтраница = ИмяСтраницы;
	
	Элементы.Страницы.ТекущаяСтраница = Элементы[ИмяСтраницы];
	
КонецПроцедуры

&НаСервере
Процедура ОткорректироватьСписокУведомлний()
	
	СписокУведомлений1 = Новый СписокЗначений;
	
	Для Каждого Строка Из Уведомления Цикл
		СписокУведомлений1.Добавить(Строка.Ссылка);
	КонецЦикла;
	
	Если СписокУведомлений1.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяОбъектаУведомления = СписокУведомлений1[0].Значение.Метаданные().Имя;
	
	СтруктураНедоступныхНомеров = ПолучитьСтруктуруНедоступныхНомеров(СписокУведомлений1);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НомераУпаковок.Ссылка КАК Уведомление
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП.Товары КАК Товары
	|		ПО НомераУпаковок.ИдентификаторСтроки = Товары.ИдентификаторСтроки
	|			И НомераУпаковок.Ссылка = Товары.Ссылка
	|ГДЕ
	|	НомераУпаковок.Ссылка В(&СписокУведомлений)
	|	И НЕ Товары.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В (&СписокНомеровИсключений)
	|	И НомераУпаковок.СостояниеПодтверждения В(&СписокСостояний)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.Ссылка КАК Уведомление
	|ПОМЕСТИТЬ втТранспортные
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|ГДЕ
	|	ТранспортныеУпаковки.Ссылка В(&СписокУведомлений)
	|	И НЕ ТранспортныеУпаковки.НомерУпаковки В (&СписокТранспортныхНомеровИсключений)
	|	И ТранспортныеУпаковки.СостояниеПодтверждения В(&СписокСостояний)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Уведомление КАК Уведомление
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Уведомление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втТранспортные.Уведомление
	|ИЗ
	|	втТранспортные КАК втТранспортные";
	
	Запрос.УстановитьПараметр("СписокСостояний", ор_ИнтеграцияМДЛП.ПолучитьСписокСостоянийПодтверждения(Истина));
	
	Запрос.УстановитьПараметр("СписокУведомлений"                  , СписокУведомлений1);
	Запрос.УстановитьПараметр("СписокНомеровИсключений"            , СтруктураНедоступныхНомеров.Номераупаковок);
	Запрос.УстановитьПараметр("СписокТранспортныхНомеровИсключений", СтруктураНедоступныхНомеров.ТранспортныеУпаковки);
	
	Если ИмяОбъектаУведомления = "УведомлениеОбОтгрузкеМДЛП" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УведомлениеОПриемкеМДЛП", "УведомлениеОбОтгрузкеМДЛП");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МассивСтрокДляУдаления = Новый Массив;
	
	Для Каждого Строка Из Уведомления Цикл
		
		НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("Уведомление", Строка.Ссылка));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			МассивСтрокДляУдаления.Добавить(Строка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из МассивСтрокДляУдаления Цикл
		Уведомления.Удалить(Строка)
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоДругимОтгрузкам()
	
	Если Не ОтображатьУведомленияПоДругимОтгрузкам Тогда
		
		Для Каждого строка Из Уведомления Цикл
			Если Строка.Выбран И НЕ Строка.Отображать Тогда
				Строка.Выбран = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		ИнтеграцияМДЛПКлиент.УстановитьОтборСтрок(
			Элементы.Уведомления.ОтборСтрок,
			Новый Структура("Отображать", Истина));
		
	Иначе
		ИнтеграцияМДЛПКлиент.СнятьОтборСтрок(Элементы.Уведомления.ОтборСтрок, "Отображать");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыДляРегистрацииGTIN()
	
	ТоварыРегистрацииGTIN.Очистить();
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.GTIN)
			И ЗначениеЗаполнено(Строка.Номенклатура)
			И ЗначениеЗаполнено(Строка.Характеристика) Тогда
			НоваяСтрока = ТоварыРегистрацииGTIN.Добавить();
			НоваяСтрока.GTIN           = Строка.GTIN;
			НоваяСтрока.Номенклатура   = Строка.Номенклатура;
			НоваяСтрока.Характеристика = Строка.Характеристика;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из СоставТранспортныхУпаковок Цикл
		Если ЗначениеЗаполнено(Строка.GTIN)
			И ЗначениеЗаполнено(Строка.Номенклатура)
			И ЗначениеЗаполнено(Строка.Характеристика) Тогда
			НоваяСтрока = ТоварыРегистрацииGTIN.Добавить();
			НоваяСтрока.GTIN           = Строка.GTIN;
			НоваяСтрока.Номенклатура   = Строка.Номенклатура;
			НоваяСтрока.Характеристика = Строка.Характеристика;
		КонецЕсли;
	КонецЦикла;
	
	вТоварыРегистрацииGTIN = ТоварыРегистрацииGTIN.Выгрузить();
	ор_ИнтеграцияМДЛП.ОбработатьТаблицуТоваровДляРегистрацииGTIN(вТоварыРегистрацииGTIN);
	ТоварыРегистрацииGTIN.Загрузить(вТоварыРегистрацииGTIN);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияGTINПродолжить(РезультатПроверки)
	
	ЗарегистрироватьGTINНаСервере(РезультатПроверки);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьGTINПоРегиструШК()
	
	РезультатПроверки = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаТовары.ДляХарактеристики КАК ДляХарактеристики,
	|	ТаблицаТовары.GTIN КАК GTIN,
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК GTIN,
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика
	|ИЗ
	|	втТовары КАК втТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|		ПО втТовары.Номенклатура = Штрихкоды.Номенклатура
	|			И втТовары.Характеристика = Штрихкоды.Характеристика
	|			И втТовары.GTIN <> Штрихкоды.Штрихкод
	|			И (втТовары.ДляХарактеристики)
	|			И (Штрихкоды.Партия = &Партия)
	|			И (Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения)
	|
	|ИТОГИ ПО
	|	Номенклатура,
	|	Характеристика";
	
	Запрос.УстановитьПараметр("ТаблицаТовары"   , ТоварыРегистрацииGTIN.Выгрузить());
	Запрос.УстановитьПараметр("Партия"          , Справочники.ПартииНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	
	GtinДляУдаления = Новый Массив;
	ТекстПредупреждения = "";
	
	ВыборкаПоНоменклатуре = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоНоменклатуре.Следующий() Цикл
		
		ВыборкаПоХарактеристике = ВыборкаПоНоменклатуре.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоХарактеристике.Следующий() Цикл
			
			ПредставлениеТовара = ор_ИнтеграцияМДЛП.ПредставлениеНоменклатуры(ВыборкаПоНоменклатуре.Номенклатура, ВыборкаПоХарактеристике.Характеристика);
			
			ВыборкаПоGTIN = ВыборкаПоХарактеристике.Выбрать();
			
			GtinТекИтерация = Новый Массив;
			Пока ВыборкаПоGTIN.Следующий() Цикл
				Если НЕ ор_ИнтеграцияМДЛПКлиентСервер.ЭтоGTIN(ВыборкаПоGTIN.GTIN) Тогда
					Продолжить;
				КонецЕсли;
				СтруктураGTIN = Новый Структура("GTIN,Номенклатура,Характеристика");
				ЗаполнитьЗначенияСвойств(СтруктураGTIN, ВыборкаПоGTIN);
				GtinДляУдаления.Добавить(СтруктураGTIN);
				GtinТекИтерация.Добавить(ВыборкаПоGTIN.GTIN);
			КонецЦикла;
			
			Если GtinТекИтерация.Количество() = 1 Тогда
				ТекстПредупреждения = НСтр("ru = 'В регистре ""Штрихкоды"" для ""%Товар%""  уже существует запись с другим GTIN %GTIN%.'");
				ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%GTIN%", GtinТекИтерация[0]);
				ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%Товар%", ПредставлениеТовара);
			ИначеЕсли GtinТекИтерация.Количество() > 1 Тогда
				ТекстПредупреждения = НСтр("ru = 'В регистре ""Штрихкоды"" для ""%Товар%"" уже существуют записи с другими GTIN.'");
				ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%Товар%", ПредставлениеТовара);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если GtinДляУдаления.Количество() > 0 Тогда
		ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + НСтр("ru = 'Записи будут удалены. Продолжить?'");
		РезультатПроверки.Вставить("ТекстПредупреждения", ТекстПредупреждения);
		РезультатПроверки.Вставить("УдалитьСтарыеЗаписи", GtinДляУдаления);
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Процедура ЗарегистрироватьGTINНаСервере(РезультатПроверки)
	
	ЕстьОшибки = Ложь;
	
	НачатьТранзакцию();
	
	Если РезультатПроверки.Свойство("УдалитьСтарыеЗаписи") Тогда
		GtinДляУдаления = РезультатПроверки.УдалитьСтарыеЗаписи;
		Для Каждого СтрокаGTIN Из GtinДляУдаления Цикл
			НовыйШтрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
			НовыйШтрихкод.Штрихкод = СтрокаGTIN.GTIN;
			НовыйШтрихкод.Номенклатура = СтрокаGTIN.Номенклатура;
			НовыйШтрихкод.Характеристика = СтрокаGTIN.Характеристика;
			НовыйШтрихкод.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
			НовыйШтрихкод.Партия = Справочники.ПартииНоменклатуры.ПустаяСсылка();
			Попытка
				НовыйШтрихкод.Удалить();
			Исключение
				ОтменитьТранзакцию();
				ТекстСообщения = НСтр("ru= 'Не удалось удалить GTIN %GTIN% по причине: %Причина%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%GTIN%", СтрокаGTIN.GTIN);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				ЕстьОшибки = Истина;
				Прервать;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьОшибки Тогда
		Возврат;
	КонеЦЕсли;
	
	Для Каждого Строка Из ТоварыРегистрацииGTIN Цикл
		НовыйШтрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		НовыйШтрихкод.Штрихкод = Строка.GTIN;
		НовыйШтрихкод.Номенклатура = Строка.Номенклатура;
		НовыйШтрихкод.Характеристика = ?(Строка.ДляХарактеристики, Строка.Характеристика, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		НовыйШтрихкод.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		НовыйШтрихкод.Партия = Справочники.ПартииНоменклатуры.ПустаяСсылка();
		
		Попытка
			НовыйШтрихкод.Записать(Истина);
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru= 'Не удалось записать GTIN %GTIN% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%GTIN%", Строка.GTIN);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ЕстьОшибки = Истина;
			Прервать;
		КонецПопытки;
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Возврат;
	КонеЦЕсли;
	
	ЗафиксироватьТранзакцию();
	
	ЗаполнитьТоварыДляРегистрацииGTIN();
	
	Возврат;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СоставТранспортныхУпаковокХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.СоставТранспортныхУпаковок.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено
		И НЕ ЗначениеЗаполнено(ТекущаяСтрока.Характеристика)
		И ЗначениеЗаполнено(ТекущаяСтрока.СерияПроизводителя)
		И ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ТекущаяСтрока"       , ТекущаяСтрока);
		СтруктураПараметров.Вставить("Элемент"             , Элемент);
		СтруктураПараметров.Вставить("ДанныеВыбора"        , ДанныеВыбора);
		СтруктураПараметров.Вставить("СтандартнаяОбработка", СтандартнаяОбработка);
		
		Оповещение = Новый ОписаниеОповещения("ВопросСоздатьНовуюХарактеристикуЗавершение", ЭтотОбъект, СтруктураПараметров);
		
		НовоеНаименование = ор_ОбщегоНазначенияКлиентСервер.СформироватьНаименованиеСерии(ТекущаяСтрока.СерияПроизводителя, ТекущаяСтрока.СрокГодности);
		
		ТекстВопроса = НСтр("ru = 'Создать новую характеристику'") + " """ + НовоеНаименование + """?";
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставТранспортныхУпаковокХарактеристикаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.СоставТранспортныхУпаковок.ТекущиеДанные;
	
	Если ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		
		Если НЕ ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(ТекущаяСтрока.Характеристика) Тогда
			ТекстСообщения = НСтр("ru = 'Для выбранной характеристики не ведется учет маркируемых товаров.'");
			ПоказатьПредупреждение(,ТекстСообщения);
			ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.СерияПроизводителя)
		И НЕ ПроверитьСериюПроизводителяХарактеристики(ТекущаяСтрока.Характеристика, ТекущаяСтрока.СерияПроизводителя) Тогда
		ТекстСообщения = НСтр("ru = 'Серия производителя выбранной характеристики не совпадает с номером серии уведомления.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности)
		И НЕ ПроверитьСрокГодностиХарактеристики(ТекущаяСтрока.Характеристика, ТекущаяСтрока.СрокГодности) Тогда
		ТекстСообщения = НСтр("ru = 'Срок годности выбранной характеристики не совпадает со сроком годности уведомления.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	КонецЕсли;
	
	ТекущаяСтрока.МаркируемыйТовар = ОбновитьПризнакМаркируемыйТовар(ТекущаяСтрока.Характеристика);
	
КонецПроцедуры


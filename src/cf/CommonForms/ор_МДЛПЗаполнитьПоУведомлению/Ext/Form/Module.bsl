
#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения;

#КонецОбласти

#Область ПрограмныйИнтерфейс

&НаКлиенте
Процедура ВопросСоздатьНовуюХарактеристикуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		СоздатьНовуюСерию(ДополнительныеПараметры.ТекущаяСтрока);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросРазныеНомераЗавершение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьТаблицы();
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары;
		ОбновитьСостояниеКнопокСтраницы();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(Параметры.АдресВоВременномХранилище) Тогда
		ТекстСообщения = НСтр("ru='Предусмотрено открытие формы только из документов.'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	АдресВоВременномХранилище = Параметры.АдресВоВременномХранилище;
	
	Параметры.Свойство("ОснованиеСсылка", ОснованиеСсылка);
	Параметры.Свойство("ЭтоВозврат"     , ЭтоВозврат);
	
	Если НЕ ЗначениеЗаполнено(ОснованиеСсылка) Тогда
		РежимНовогоДокумента = Истина;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПараметры;
	Иначе
		РежимНовогоДокумента = Ложь;
		ЗаполнитьТаблицуУведомлений();
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаУведомления;
	КонецЕсли;
	
	ГосударственныеИнформационныеСистемыПереопределяемый.УстановитьПараметрыВыбораНоменклатуры(ЭтотОбъект);
	ГосударственныеИнформационныеСистемыПереопределяемый.УстановитьСвязиПараметровВыбораСНоменклатурой(ЭтотОбъект, Элементы.ТоварыХарактеристика.Имя);
	
	ГосударственныеИнформационныеСистемыПереопределяемый.УстановитьПараметрыВыбораНоменклатуры(ЭтотОбъект, Элементы.СоставТранспортныхУпаковокНоменклатура.Имя);
	ГосударственныеИнформационныеСистемыПереопределяемый.УстановитьСвязиПараметровВыбораСНоменклатурой(ЭтотОбъект, Элементы.СоставТранспортныхУпаковокХарактеристика.Имя, "Элементы.СоставТранспортныхУпаковок.ТекущиеДанные.Номенклатура");
	
	ИспользоватьХарактеристики = ИнтеграцияМДЛП.ИспользоватьХарактеристикиНоменклатуры();
	Элементы.ТоварыХарактеристика.Видимость = ИспользоватьХарактеристики;
	Элементы.СоставТранспортныхУпаковокХарактеристика.Видимость = ИспользоватьХарактеристики;
	
	ГосударственныеИнформационныеСистемыПереопределяемый.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(
		ЭтотОбъект, Элементы.Товары.Имя, "Товары.ХарактеристикиИспользуются");
	ГосударственныеИнформационныеСистемыПереопределяемый.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(
		ЭтотОбъект, Элементы.СоставТранспортныхУпаковокХарактеристика.Имя, "СоставТранспортныхУпаковок.ХарактеристикиИспользуются");
	
	ОтображатьУведомленияПоДругимОтгрузкам = Ложь;
	Элементы.ФормаУведомленияПоДругимОтгрузкам.Пометка = ОтображатьУведомленияПоДругимОтгрузкам;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьСостояниеКнопокСтраницы();
	УстановитьОтборПоДругимОтгрузкам();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура УведомленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Уведомления.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.Выбран = Не ТекущаяСтрока.Выбран;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧастиТовары

&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ИнтеграцияМДЛПКлиент.УстановитьОтборСтрок(
			Элементы.НомераУпаковок.ОтборСтрок,
			Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если НЕ ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(ТекущаяСтрока.Номенклатура) Тогда
		ТекстСообщения = НСтр("ru = 'Для выбранной номенклатуры не ведется учет маркируемых товаров.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		ТекущаяСтрока.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	КонецЕсли;
	
	ТекущаяСтрока.МаркируемыйТовар = ОбновитьПризнакМаркируемыйТовар(ТекущаяСтрока.Характеристика);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено
		И НЕ ЗначениеЗаполнено(ТекущаяСтрока.Характеристика)
		И ЗначениеЗаполнено(ТекущаяСтрока.СерияПроизводителя)
		И ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ТекущаяСтрока"       , ТекущаяСтрока);
		СтруктураПараметров.Вставить("Элемент"             , Элемент);
		СтруктураПараметров.Вставить("ДанныеВыбора"        , ДанныеВыбора);
		СтруктураПараметров.Вставить("СтандартнаяОбработка", СтандартнаяОбработка);
		
		Оповещение = Новый ОписаниеОповещения("ВопросСоздатьНовуюХарактеристикуЗавершение", ЭтотОбъект, СтруктураПараметров);
		
		НовоеНаименование = ор_ОбщегоНазначенияКлиентСервер.СформироватьНаименованиеСерии(ТекущаяСтрока.СерияПроизводителя, ТекущаяСтрока.СрокГодности);
		
		ТекстВопроса = НСтр("ru = 'Создать новую характеристику'") + " """ + НовоеНаименование + """?";
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		
		Если НЕ ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(ТекущаяСтрока.Характеристика) Тогда
			ТекстСообщения = НСтр("ru = 'Для выбранной характеристики не ведется учет маркируемых товаров.'");
			ПоказатьПредупреждение(,ТекстСообщения);
			ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.СерияПроизводителя)
		И НЕ ПроверитьСериюПроизводителяХарактеристики(ТекущаяСтрока.Характеристика, ТекущаяСтрока.СерияПроизводителя) Тогда
		ТекстСообщения = НСтр("ru = 'Серия производителя выбранной характеристики не совпадает с номером серии уведомления.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности)
		И НЕ ПроверитьСрокГодностиХарактеристики(ТекущаяСтрока.Характеристика, ТекущаяСтрока.СрокГодности) Тогда
		ТекстСообщения = НСтр("ru = 'Срок годности выбранной характеристики не совпадает со сроком годности уведомления.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	КонецЕсли;
	
	ТекущаяСтрока.МаркируемыйТовар = ОбновитьПризнакМаркируемыйТовар(ТекущаяСтрока.Характеристика);
	
КонецПроцедуры


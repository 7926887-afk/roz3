// Конструктор таблицы локальных модулей честный знак.
//
// Возвращаемое значение:
//  Структура - описание подключения локального модуля:
//   * Организация          - СправочникСсылка.ОрганизацииМДЛП - организация для отправки запроса в ЛМ.
//   * РабочееМесто         - СправочникСсылка.РабочиеМеста - рабочее место для получения запроса.
//   * ФорматОбмена         - ПеречислениеСсылка.ВерсииФорматаОбменаЛокальногоМодуляМДЛП - формат обмена с ЛМ ЧЗ.
//   * ОбменНаСервере       - Булево - Истина, если обмен производится на сервере.
//   * АдресПодключения     - Строка - адрес площадки.
//   * Адрес                - Строка - адрес сервера.
//   * Сервер               - Строка - адрес сервера.
//   * Порт                 - Число - порт.
//   * ЗащищенноеСоединение - Булево - защищенное соединение.
//   * Логин                - Строка - логин администратора ЛМ ЧЗ.
//   * Пароль               - Строка - пароль администратора ЛМ ЧЗ.
//   * Таймаут              - Число - таймаут подключения.
//
Функция КонструкторПодключенияЛокальногоМодуляЧестныйЗнак()
	
	СтруктураЛокальногоМодуля = Новый Структура;
	
	СтруктураЛокальногоМодуля.Вставить("Организация"         , Справочники.ОрганизацииМДЛП.ПустаяСсылка());
	СтруктураЛокальногоМодуля.Вставить("РабочееМесто"        , Справочники.РабочиеМеста.ПустаяСсылка());
	СтруктураЛокальногоМодуля.Вставить("ФорматОбмена"        , Перечисления.ВерсииФорматаОбменаЛокальногоМодуляМДЛП.ПустаяСсылка());
	// ор ++
	СтруктураЛокальногоМодуля.Вставить("Приоритет"           , 0);
	// ор --
	СтруктураЛокальногоМодуля.Вставить("ОбменНаСервере"      , Ложь);
	СтруктураЛокальногоМодуля.Вставить("АдресПодключения"    , "");
	СтруктураЛокальногоМодуля.Вставить("Адрес"               , ""); // Сервер
	СтруктураЛокальногоМодуля.Вставить("Сервер"              , ""); // Адрес
	СтруктураЛокальногоМодуля.Вставить("Порт"                , 0);
	СтруктураЛокальногоМодуля.Вставить("ЗащищенноеСоединение", Ложь);
	СтруктураЛокальногоМодуля.Вставить("Логин"               , "");
	СтруктураЛокальногоМодуля.Вставить("Пароль"              , "");
	СтруктураЛокальногоМодуля.Вставить("Таймаут"             , 0);
	
	Возврат СтруктураЛокальногоМодуля;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсиюЗаполнениеФорматаОбмена(Параметры) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП;
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ПолноеИмяРегистра = МетаданныеРегистра.ПолноеИмя();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	
	Данные = Новый ТаблицаЗначений;
	СтрокаИзмерений = "";
	
	Для Каждого ИзмерениеРегистра Из МетаданныеРегистра.Измерения Цикл
		Данные.Колонки.Добавить(ИзмерениеРегистра.Имя, ИзмерениеРегистра.Тип);
		СтрокаИзмерений = СтрокаИзмерений + ?(ЗначениеЗаполнено(СтрокаИзмерений), ", ", "") + ИзмерениеРегистра.Имя;
	КонецЦикла;
	
	ВерсияПодсистемыНаНачалоОбновления = Неопределено;
	
	Если Параметры <> Неопределено Тогда
		Параметры.Свойство("ВерсияПодсистемыНаНачалоОбновления", ВерсияПодсистемыНаНачалоОбновления);
	КонецЕсли;
	
	Если ВерсияПодсистемыНаНачалоОбновления = Неопределено Тогда
		ВерсияПодсистемыНаНачалоОбновления = ОбновлениеИнформационнойБазы.ВерсияИБ("БиблиотекаИнтеграцииМДЛП");
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияПодсистемыНаНачалоОбновления, "1.2.13.1") < 0 Тогда
		
		Данные_ЗаполнитьФорматОбмена = ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьФорматОбменаПоУмолчанию();
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Данные_ЗаполнитьФорматОбмена, Данные);
		
	КонецЕсли;
	
	Данные.Свернуть(СтрокаИзмерений);
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры

Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьФорматОбменаПоУмолчанию() Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	НастройкиПодключенияЛокальныхМодулей.Организация        КАК Организация,
	|	НастройкиПодключенияЛокальныхМодулей.РабочееМесто       КАК РабочееМесто,
	|	НастройкиПодключенияЛокальныхМодулей.Приоритет          КАК Приоритет,
	|	НастройкиПодключенияЛокальныхМодулей.АдресПодключенияЛМ КАК АдресПодключенияЛМ
	|ИЗ
	|	РегистрСведений.НастройкиПодключенияЛокальныхМодулейМДЛП КАК НастройкиПодключенияЛокальныхМодулей
	|ГДЕ
	|	НастройкиПодключенияЛокальныхМодулей.ФорматОбмена = ЗНАЧЕНИЕ(Перечисление.ВерсииФорматаОбменаЛокальногоМодуляМДЛП.ПустаяСсылка)
	|");
	ТаблицаИзмерений = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаИзмерений;
	
КонецФункции

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсиюЗаполнениеФорматаОбмена(Параметры) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП;
	ПолноеИмяРегистра  = МетаданныеРегистра.ПолноеИмя();
	
	ВерсияПодсистемыНаНачалоОбновления = Неопределено;
	
	Если Параметры <> Неопределено Тогда
		Параметры.Свойство("ВерсияПодсистемыНаНачалоОбновления", ВерсияПодсистемыНаНачалоОбновления);
	КонецЕсли;
	
	Если ВерсияПодсистемыНаНачалоОбновления = Неопределено Тогда
		ВерсияПодсистемыНаНачалоОбновления = ОбновлениеИнформационнойБазы.ВерсияИБ("БиблиотекаИнтеграцииМДЛП");
	КонецЕсли;
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьИзмеренияНезависимогоРегистраСведенийДляОбработки(Параметры.Очередь, ПолноеИмяРегистра);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяРегистра);
			
			ЭлементБлокировки.УстановитьЗначение("Организация",  Выборка.Организация);
			ЭлементБлокировки.УстановитьЗначение("РабочееМесто", Выборка.РабочееМесто);
			ЭлементБлокировки.УстановитьЗначение("Приоритет",    Выборка.Приоритет);
			
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			НаборЗаписей = СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор["Организация"].Установить(Выборка.Организация);
			НаборЗаписей.Отбор["РабочееМесто"].Установить(Выборка.РабочееМесто);
			НаборЗаписей.Отбор["Приоритет"].Установить(Выборка.Приоритет);
			
			НаборЗаписей.Прочитать();
			
			Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияПодсистемыНаНачалоОбновления, "1.2.13.1") < 0 Тогда
				
				Для Каждого Запись Из НаборЗаписей Цикл
					Если Запись.УдалитьФорматОбмена = Перечисления.ВерсииФорматаОбменаЛокальногоМодуляИСМП.V2 Тогда
						Запись.ФорматОбмена = Перечисления.ВерсииФорматаОбменаЛокальногоМодуляМДЛП.V2;
					Иначе
						Запись.ФорматОбмена = Перечисления.ВерсииФорматаОбменаЛокальногоМодуляМДЛП.V1;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			ТекстСообщения = НСтр("ru = 'Не удалось установить формат обмена по умолчанию по настройке ЛМ ЧЗ: %1 - % 2 по причине: %3'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщения,
				Выборка.Организация,
				?(ЗначениеЗаполнено(Выборка.РабочееМесто), Выборка.РабочееМесто, НСтр("ru = '<без отбора по рабочему месту>'")),
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеРегистра,,
				ТекстСообщения);
			
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
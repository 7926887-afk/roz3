
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Функция возвращает прочитанный пароль администратора из безопасного хранилища по данным записи регистра.
//
// Параметры:
//  ХешСумма - Строка - хеш сумма настроек подключения, определяющие пароль.
// 
// Возвращаемое значение:
//  Произвольный, Структура, Неопределено - Пароль администратора из безопасного хранилища.
//
Функция ПарольАдминистратораИзБезопасногоХранилища(ХешСумма) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пароль = ПрочитатьПарольАдминистратораИзБезопасногоХранилища(ХешСумма);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Пароль;
	
КонецФункции

// Процедура сохраняет пароль администратора в безопасное хранилище под данными регистра.
//
// Параметры:
//  ХешСумма - Строка - хеш сумма настроек подключения, определяющие пароль.
//  Пароль - Строка - установленный пароль.
//
Процедура СохранитьПарольАдминистратораВБезопасноеХранилище(ХешСумма, Пароль) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписатьПарольАдминистратораВБезопасноеХранилище(ХешСумма, Пароль);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Конструктор записи владельца пароля и расчета хеша.
//
// Возвращаемое значение:
//  Структура - Конструктор записи владельца пароля:
// * РабочееМесто - Произвольный, Неопределено - рабочее место.
// * АдресПодключенияЛМ - Строка - строка подключения.
//
Функция КонструкторЗаписиВладельцаПароля() Экспорт
	
	СтруктураВозврата = Новый Структура();
	
	СтруктураВозврата.Вставить("РабочееМесто"      , Справочники.РабочиеМеста.ПустаяСсылка());
	СтруктураВозврата.Вставить("АдресПодключенияЛМ", "");
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Возвращает ранжированный список локальных модулей "Честный знак" для офлайн проверки кодов маркировки
// от наиболее приоритетного до наименее приоритетного.
// Параметры:
//  Организация - СправочникСсылка.ОрганизацииМДЛП - организация для отправки запроса в ЛМ.
//  РабочееМесто - СправочникСсылка.РабочиеМеста - рабочее место для получения запроса.
//
// Возвращаемое значение:
//  Структура:
//  * СерверныеМодули  - Массив из КонструкторПодключенияЛокальногоМодуляЧестныйЗнак.
//  * КлиентскиеМодули - Массив из КонструкторПодключенияЛокальногоМодуляЧестныйЗнак.
//
Функция СортированнаяТаблицаЛокальныхМодулейЧестныйЗнак(Организация, РабочееМесто = Неопределено) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СерверныеМодули",  Неопределено);
	СтруктураВозврата.Вставить("КлиентскиеМодули", Неопределено);
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	НастройкиПодключенияЛокальныхМодулей.Организация               КАК Организация,
	|	НастройкиПодключенияЛокальныхМодулей.РабочееМесто              КАК РабочееМесто,
	|	НастройкиПодключенияЛокальныхМодулей.ФорматОбмена              КАК ФорматОбмена,
	|	НастройкиПодключенияЛокальныхМодулей.Приоритет                 КАК Приоритет,
	|	НастройкиПодключенияЛокальныхМодулей.ОбменНаСервере            КАК ОбменНаСервере,
	|	НастройкиПодключенияЛокальныхМодулей.АдресПодключенияЛМ        КАК АдресПодключения,
	|	НастройкиПодключенияЛокальныхМодулей.СерверПодключенияЛМ       КАК Адрес,
	|	НастройкиПодключенияЛокальныхМодулей.СерверПодключенияЛМ       КАК Сервер,
	|	НастройкиПодключенияЛокальныхМодулей.ПортПодключенияЛМ         КАК Порт,
	|	НастройкиПодключенияЛокальныхМодулей.ЗащищенноеСоединение      КАК ЗащищенноеСоединение,
	|	НастройкиПодключенияЛокальныхМодулей.Таймаут                   КАК Таймаут,
	|	НастройкиПодключенияЛокальныхМодулей.Логин                     КАК Логин,
	|	НастройкиПодключенияЛокальныхМодулей.ХешСумма                  КАК ХешСумма
	|ИЗ
	|	РегистрСведений.НастройкиПодключенияЛокальныхМодулейМДЛП КАК НастройкиПодключенияЛокальныхМодулей
	|ГДЕ
	|	НастройкиПодключенияЛокальныхМодулей.Организация = &Организация
	|	И ВЫБОР
	|		КОГДА &РабочееМесто = НЕОПРЕДЕЛЕНО
	|			ТОГДА НастройкиПодключенияЛокальныхМодулей.ОбменНаСервере
	|		ИНАЧЕ НастройкиПодключенияЛокальныхМодулей.РабочееМесто = &РабочееМесто
	|			ИЛИ НастройкиПодключенияЛокальныхМодулей.РабочееМесто = &ПустоеЗначениеРабочееМесто
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	ОбменНаСервере УБЫВ,
	|	Приоритет
	|");
	
	Запрос.УстановитьПараметр("Организация",                Организация);
	Запрос.УстановитьПараметр("РабочееМесто",               РабочееМесто);
	Запрос.УстановитьПараметр("ПустоеЗначениеРабочееМесто", Справочники.РабочиеМеста.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоваяСтрока = КонструкторПодключенияЛокальногоМодуляЧестныйЗнак();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		
		ПарольАдминистратора = ПарольАдминистратораИзБезопасногоХранилища(ВыборкаДетальныеЗаписи.ХешСумма);
		НоваяСтрока.Пароль = ПарольАдминистратора;
		
		Если ВыборкаДетальныеЗаписи.ОбменНаСервере Тогда
			Если СтруктураВозврата.СерверныеМодули = Неопределено Тогда
				СтруктураВозврата.СерверныеМодули = Новый Массив;
			КонецЕсли;
			СтруктураВозврата.СерверныеМодули.Добавить(НоваяСтрока);
		Иначе
			Если СтруктураВозврата.КлиентскиеМодули = Неопределено Тогда
				СтруктураВозврата.КлиентскиеМодули = Новый Массив;
			КонецЕсли;
			СтруктураВозврата.КлиентскиеМодули.Добавить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция НомерПриоритетаНастройкиПодключения(Организация, РабочееМесто) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкиПодключенияЛокальныхМодулей.Приоритет КАК Приоритет
	|ИЗ
	|	РегистрСведений.НастройкиПодключенияЛокальныхМодулейМДЛП КАК НастройкиПодключенияЛокальныхМодулей
	|ГДЕ
	|	НастройкиПодключенияЛокальныхМодулей.Организация = &Организация
	|	И НастройкиПодключенияЛокальныхМодулей.РабочееМесто = &РабочееМесто
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет УБЫВ
	|");
	
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Приоритет + 1;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Возвращает наиболее приоритетную настройку подключения по ТС ПИоТу.
// Параметры:
//  Организация  - СправочникСсылка.ОрганизацииМДЛП - организация для отправки запроса в ЛМ.
//  РабочееМесто - СправочникСсылка.РабочиеМеста - рабочее место для получения запроса.
// 
// Возвращаемое значение:
//  Структура:
//  * НастроеноПодключение - Булево - Истина, если настроено подключение к ЛМ ЧЗ
//  * Настройки - см. КонструкторПодключенияЛокальногоМодуляЧестныйЗнак
//
Функция НастройкиОсновногоПодключенияЛокальномуМодулюЧестныйЗнакПоОрганизацииРабочемуМесту(Организация, РабочееМесто = Неопределено) Экспорт
	
	СтруктураПодключения = КонструкторПодключенияЛокальногоМодуляЧестныйЗнак();
	СтруктураВозврата    = Новый Структура("НастроеноПодключение, Настройки", Ложь, СтруктураПодключения);
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкиПодключенияЛокальныхМодулей.Организация           КАК Организация,
	|	НастройкиПодключенияЛокальныхМодулей.РабочееМесто          КАК РабочееМесто,
	|	НастройкиПодключенияЛокальныхМодулей.ФорматОбмена          КАК ФорматОбмена,
	|	НастройкиПодключенияЛокальныхМодулей.Приоритет             КАК Приоритет,
	|	НастройкиПодключенияЛокальныхМодулей.ОбменНаСервере        КАК ОбменНаСервере,
	|	НастройкиПодключенияЛокальныхМодулей.АдресПодключенияЛМ    КАК АдресПодключения,
	|	НастройкиПодключенияЛокальныхМодулей.СерверПодключенияЛМ   КАК Адрес,
	|	НастройкиПодключенияЛокальныхМодулей.СерверПодключенияЛМ   КАК Сервер,
	|	НастройкиПодключенияЛокальныхМодулей.ПортПодключенияЛМ     КАК Порт,
	|	НастройкиПодключенияЛокальныхМодулей.ЗащищенноеСоединение  КАК ЗащищенноеСоединение,
	|	НастройкиПодключенияЛокальныхМодулей.Таймаут               КАК Таймаут,
	|	НастройкиПодключенияЛокальныхМодулей.Логин                 КАК Логин,
	|	НастройкиПодключенияЛокальныхМодулей.ХешСумма              КАК ХешСумма
	|ИЗ
	|	РегистрСведений.НастройкиПодключенияЛокальныхМодулейМДЛП КАК НастройкиПодключенияЛокальныхМодулей
	|ГДЕ
	|	НастройкиПодключенияЛокальныхМодулей.Организация = &Организация
	|	И ВЫБОР
	|		КОГДА &РабочееМесто = НЕОПРЕДЕЛЕНО
	|			ТОГДА НастройкиПодключенияЛокальныхМодулей.ОбменНаСервере
	|		ИНАЧЕ НастройкиПодключенияЛокальныхМодулей.РабочееМесто = &РабочееМесто
	|			ИЛИ НастройкиПодключенияЛокальныхМодулей.РабочееМесто = &ПустоеЗначениеРабочееМесто
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|");
	
	Запрос.УстановитьПараметр("Организация",                Организация);
	Запрос.УстановитьПараметр("РабочееМесто",               РабочееМесто);
	Запрос.УстановитьПараметр("ПустоеЗначениеРабочееМесто", Справочники.РабочиеМеста.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураПодключения, Выборка);
		
		ПарольАдминистратора = ПарольАдминистратораИзБезопасногоХранилища(Выборка.ХешСумма);
		
		СтруктураПодключения.Пароль = ПарольАдминистратора;
		
		СтруктураВозврата.НастроеноПодключение = Истина;
		СтруктураВозврата.Настройки            = СтруктураПодключения;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти // СлужебныйПрограммныйИнтерфейс


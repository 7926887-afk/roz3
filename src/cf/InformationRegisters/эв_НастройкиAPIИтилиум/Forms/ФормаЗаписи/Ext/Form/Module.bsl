

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСвязь(Команда)
	
	// ++ Эвалар 2026-11-24
	Результат = эв_ОбработкаОбращений.ПроверитьСвязь(Запись.Адрес, Запись.Логин, Запись.Пароль);
	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Связь с Итилиум установлена.'"));
	Иначе
		ПоказатьПредупреждение(, Результат.Ошибка);
	КонецЕсли;
	// -- Эвалар 2026-11-24
	
КонецПроцедуры


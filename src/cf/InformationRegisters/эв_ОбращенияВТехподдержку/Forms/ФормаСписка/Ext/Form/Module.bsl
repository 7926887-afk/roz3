

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	ОбщегоНазначенияКлиент.СообщитьПользователю("Добавление обращений выполняется из форм документов и справочников!");
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// ++ Эвалар 2026-11-23
	СоздатьОтборПоСтатусу();
	УстановитьОтборПоСтатусу();
	УстановитьУсловноеОформлениеОжидаетОтвета();
	// -- Эвалар 2026-11-23
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы


&НаКлиенте
Процедура ОтборПоСтатусуПриИзменении(Элемент)
	
	// ++ Эвалар 2026-11-23
	УстановитьОтборПоСтатусу();
	// -- Эвалар 2026-11-23
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьИзИтилиум(Команда)
	
	Результат = эв_ОбработкаОбращений.ОбновитьОбращенияИзИтилиум();
	Элементы.Список.Обновить();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Обновление обращений'"),
			,
			СтрШаблон(НСтр("ru = 'Обновлено: %1'"), Результат.Обновлено));
	Иначе
		ПоказатьПредупреждение(, Результат.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьОтборПоСтатусу()
	
	// ++ Эвалар 2026-11-23
	ОписаниеФлажков = ОписаниеОтбораПоСтатусу();
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого ОписаниеФлажка Из ОписаниеФлажков Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ОписаниеФлажка.Имя, Новый ОписаниеТипов("Булево")));
	КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ГруппаОтбора = Элементы.Добавить("ГруппаОтборПоСтатусу", Тип("ГруппаФормы"));
	ГруппаОтбора.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтбора.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаОтбора.ОтображатьЗаголовок = Ложь;
	ГруппаОтбора.Отображение = ОтображениеОбычнойГруппы.Нет;
	Элементы.Переместить(ГруппаОтбора, ЭтотОбъект, Элементы.Список);
	
	Для Каждого ОписаниеФлажка Из ОписаниеФлажков Цикл
		ЭтотОбъект[ОписаниеФлажка.Имя] = Истина;
		ДобавитьФлажокОтбора(ОписаниеФлажка, ГруппаОтбора);
	КонецЦикла;
	// -- Эвалар 2026-11-23
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьФлажокОтбора(ОписаниеФлажка, ГруппаОтбора)
	
	// ++ Эвалар 2026-11-23
	Флажок = Элементы.Добавить(ОписаниеФлажка.Имя, Тип("ПолеФормы"), ГруппаОтбора);
	Флажок.Вид = ВидПоляФормы.ПолеФлажка;
	Флажок.ПутьКДанным = ОписаниеФлажка.Имя;
	Флажок.Заголовок = ОписаниеФлажка.Заголовок;
	Флажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Флажок.РастягиватьПоГоризонтали = Ложь;
	Флажок.УстановитьДействие("ПриИзменении", "ОтборПоСтатусуПриИзменении");
	// -- Эвалар 2026-11-23
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоСтатусу()
	
	// ++ Эвалар 2026-11-23
	Статусы = Новый СписокЗначений;
	Для Каждого ОписаниеФлажка Из ОписаниеОтбораПоСтатусу() Цикл
		Если ЭтотОбъект[ОписаниеФлажка.Имя] Тогда
			Статусы.Добавить(ОписаниеФлажка.Статус);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Статус",
		Статусы,
		ВидСравненияКомпоновкиДанных.ВСписке,
		,
		Истина);
	// -- Эвалар 2026-11-23
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеОжидаетОтвета()
	
	// ++ Эвалар 2026-11-23
	ЭлементОформления = Список.УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.эв_СтатусыОбращенийВТехподдержку.ОжиданиеОтвета;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Розовый);
	ЭлементОформления.Использование = Истина;
	// -- Эвалар 2026-11-23
	
КонецПроцедуры

&НаСервере
Функция ОписаниеОтбораПоСтатусу()
	
	// ++ Эвалар 2026-11-23
	Описание = Новый Массив;
	Описание.Добавить(Новый Структура(
		"Имя, Заголовок, Статус",
		"ОтборКВыполнению",
		НСтр("ru = 'К выполнению'"),
		Перечисления.эв_СтатусыОбращенийВТехподдержку.КВыполнению));
	Описание.Добавить(Новый Структура(
		"Имя, Заголовок, Статус",
		"ОтборВРаботе",
		НСтр("ru = 'В работе'"),
		Перечисления.эв_СтатусыОбращенийВТехподдержку.ВРаботе));
	Описание.Добавить(Новый Структура(
		"Имя, Заголовок, Статус",
		"ОтборОжиданиеОтвета",
		НСтр("ru = 'Ожидание ответа'"),
		Перечисления.эв_СтатусыОбращенийВТехподдержку.ОжиданиеОтвета));
	Описание.Добавить(Новый Структура(
		"Имя, Заголовок, Статус",
		"ОтборВыполнено",
		НСтр("ru = 'Выполнено'"),
		Перечисления.эв_СтатусыОбращенийВТехподдержку.Выполнено));
	Описание.Добавить(Новый Структура(
		"Имя, Заголовок, Статус",
		"ОтборОтменено",
		НСтр("ru = 'Отменено'"),
		Перечисления.эв_СтатусыОбращенийВТехподдержку.Отменено));
	
	Возврат Описание;
	// -- Эвалар 2026-11-23
	
КонецФункции

#КонецОбласти

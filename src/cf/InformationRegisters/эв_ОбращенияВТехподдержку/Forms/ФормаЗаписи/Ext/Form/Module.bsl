
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтатусДоИзменения = Запись.Статус;
	ОбновитьТекстЗадачиНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Запись.Статус = СтатусДоИзменения Тогда
		Возврат;
	КонецЕсли;
	
	Результат = эв_ОбработкаОбращений.ОбновитьСтатусВИтилиум(Запись.id, Запись.Статус);
	Если Не Результат.Успех Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(, Результат.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	СтатусДоИзменения = Запись.Статус;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПутьФайлаКомментарияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выберите файл'");
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = НСтр("ru = 'Изображения и файлы'") + "|*.png;*.jpg;*.jpeg;*.bmp;*.gif;*.pdf;*.doc;*.docx;*.xls;*.xlsx;*.zip;*.*";
	Диалог.Показать(Новый ОписаниеОповещения("ПутьФайлаКомментарияПослеВыбора", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьФайлаКомментарияПослеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПутьФайлаКомментария = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьФайлаКомментарияОчистка(Элемент, СтандартнаяОбработка)
	
	ПутьФайлаКомментария = "";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьКомментарий(Команда)
	
	Если ПустаяСтрока(СокрЛП(ТекстКомментария)) И ПустаяСтрока(СокрЛП(ПутьФайлаКомментария)) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните текст комментария или выберите файл.'"));
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(СокрЛП(ПутьФайлаКомментария)) Тогда
		ЗавершитьОтправкуКомментария(Новый Массив);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОтправитьКомментарийПослеПомещенияФайла", ЭтотОбъект);
	Попытка
		НачатьПомещениеФайла(Оповещение, , ПутьФайлаКомментария, Ложь, УникальныйИдентификатор);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКомментарийПослеПомещенияФайла(Помещен, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Помещен Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось прочитать файл'"));
		Возврат;
	КонецЕсли;
	
	Файл = Новый Файл(ПутьФайлаКомментария);
	ИмяФайла = Файл.Имя;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "file.bin";
	КонецЕсли;
	
	Файлы = Новый Массив;
	Файлы.Добавить(Новый Структура("ИмяФайла, Адрес", ИмяФайла, Адрес));
	ЗавершитьОтправкуКомментария(Файлы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьОтправкуКомментария(ФайлыКомментария)
	
	Результат = ОтправитьКомментарийНаСервере(ТекстКомментария, ФайлыКомментария);
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;
	
	ТекстКомментария = "";
	ПутьФайлаКомментария = "";
	ПоказатьОповещениеПользователя(НСтр("ru = 'Комментарий отправлен'"));
	
КонецПроцедуры

&НаСервере
Функция ОтправитьКомментарийНаСервере(Знач Текст, Знач ФайлыКомментария)
	
	Результат = эв_ОбработкаОбращений.ОтправитьКомментарийВИтилиум(Запись.id, Текст, ФайлыКомментария);
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запись.Прочитать();
	ОбновитьТекстЗадачиНаФорме();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьТекстЗадачиНаФорме()
	
	Задача = эв_ОбработкаОбращений.ТекстЗадачиHTML(Запись.ТекстОбращения, Запись.ТекстОтвета, Запись.Скриншоты);
	
КонецПроцедуры

#КонецОбласти

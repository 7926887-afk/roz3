
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтатусДоИзменения = Запись.Статус;
	ОбновитьТекстЗадачиНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Запись.Статус = СтатусДоИзменения Тогда
		Возврат;
	КонецЕсли;
	
	Результат = эв_ОбработкаОбращений.ОбновитьСтатусВИтилиум(Запись.id, Запись.Статус);
	Если Не Результат.Успех Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(, Результат.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	СтатусДоИзменения = Запись.Статус;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлКомментария(Команда)
	
	ЗафиксироватьТекстКомментарияСПоля();
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьФайлКомментарияЗавершение", ЭтотОбъект);
	Попытка
		НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлКомментарияЗавершение(Помещен, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Помещен Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайлаКомментария = Адрес;
	
	ИмяФайла = ВыбранноеИмяФайла;
	Если Не ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = СтрЗаменить(ИмяФайла, "\", "/");
		ЧастиИмени = СтрРазделить(ИмяФайла, "/", Ложь);
		Если ЧастиИмени.Количество() > 0 Тогда
			ИмяФайла = ЧастиИмени[ЧастиИмени.Количество() - 1];
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "file.bin";
	КонецЕсли;
	
	ИмяФайлаКомментария = ИмяФайла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФайлКомментария(Команда)
	
	АдресФайлаКомментария = "";
	ИмяФайлаКомментария = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКомментарий(Команда)
	
	Текст = ЗафиксироватьТекстКомментарияСПоля();
	
	Если ПустаяСтрока(Текст) И ПустаяСтрока(АдресФайлаКомментария) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните текст комментария или выберите файл.'"));
		Возврат;
	КонецЕсли;
	
	Файлы = Новый Массив;
	Если Не ПустаяСтрока(АдресФайлаКомментария) Тогда
		ИмяФайла = ИмяФайлаКомментария;
		Если ПустаяСтрока(ИмяФайла) Тогда
			ИмяФайла = "file.bin";
		КонецЕсли;
		Файлы.Добавить(Новый Структура("ИмяФайла, Адрес", ИмяФайла, АдресФайлаКомментария));
	КонецЕсли;
	
	Результат = ОтправитьКомментарийНаСервере(Текст, Файлы);
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;
	
	ТекстКомментария = "";
	АдресФайлаКомментария = "";
	ИмяФайлаКомментария = "";
	ПоказатьОповещениеПользователя(НСтр("ru = 'Комментарий отправлен'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗафиксироватьТекстКомментарияСПоля()
	
	Текст = "";
	Попытка
		Текст = СокрЛП(Элементы.ТекстКомментария.ТекстРедактирования);
	Исключение
		Текст = "";
	КонецПопытки;
	
	Если ПустаяСтрока(Текст) Тогда
		Текст = СокрЛП(ТекстКомментария);
	КонецЕсли;
	
	ТекстКомментария = Текст;
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ОтправитьКомментарийНаСервере(Знач Текст, Знач ФайлыКомментария)
	
	Результат = эв_ОбработкаОбращений.ОтправитьКомментарийВИтилиум(Запись.id, Текст, ФайлыКомментария);
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запись.ТекстОтвета = Результат.ТекстОтвета;
	Если Результат.Скриншоты <> Неопределено Тогда
		Запись.Скриншоты = Результат.Скриншоты;
	КонецЕсли;
	ОбновитьТекстЗадачиНаФорме();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьТекстЗадачиНаФорме()
	
	Задача = эв_ОбработкаОбращений.ТекстЗадачиHTML(Запись.ТекстОбращения, Запись.ТекстОтвета, Запись.Скриншоты);
	
КонецПроцедуры

#КонецОбласти


#Область ОписаниеПеременных

&НаКлиенте
Перем ОтправкаКомментарияВыполняется;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтатусДоИзменения = Запись.Статус;
	ОбновитьТекстЗадачиНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Запись.Статус = СтатусДоИзменения Тогда
		Возврат;
	КонецЕсли;
	
	Результат = эв_ОбработкаОбращений.ОбновитьСтатусВИтилиум(Запись.id, Запись.Статус);
	Если Не Результат.Успех Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(, Результат.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	СтатусДоИзменения = Запись.Статус;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ФайлыКомментарияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	ЗафиксироватьТекстКомментарияСПоля();
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выберите файл'");
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = НСтр("ru = 'Изображения'") + "|*.png;*.jpg;*.jpeg;*.bmp;*.gif";
	Диалог.Показать(Новый ОписаниеОповещения("ФайлыКомментарияПослеВыбораФайла", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыКомментарияПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ФайлыКомментария.Добавить();
	НоваяСтрока.Файл = ВыбранныеФайлы[0];
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьКомментарий(Команда)
	
	Если ОтправкаКомментарияВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Текст = ЗафиксироватьТекстКомментарияСПоля();
	
	Очередь = Новый Массив;
	Для Каждого СтрокаФайла Из ФайлыКомментария Цикл
		Путь = СокрЛП(СтрокаФайла.Файл);
		Если Не ПустаяСтрока(Путь) Тогда
			Очередь.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(Текст) И Очередь.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните текст комментария или добавьте файл.'"));
		Возврат;
	КонецЕсли;
	
	ОтправкаКомментарияВыполняется = Истина;
	
	Контекст = Новый Структура;
	Контекст.Вставить("Текст", Текст);
	Контекст.Вставить("Очередь", Очередь);
	Контекст.Вставить("Индекс", 0);
	Контекст.Вставить("Файлы", Новый Массив);
	ПоместитьСледующийФайлКомментария(Контекст);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗафиксироватьТекстКомментарияСПоля()
	
	Текст = "";
	Попытка
		Текст = СокрЛП(Элементы.ТекстКомментария.ТекстРедактирования);
	Исключение
		Текст = "";
	КонецПопытки;
	
	Если ПустаяСтрока(Текст) Тогда
		Текст = СокрЛП(ТекстКомментария);
	КонецЕсли;
	
	ТекстКомментария = Текст;
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Процедура ПоместитьСледующийФайлКомментария(Контекст)
	
	Если Контекст.Индекс >= Контекст.Очередь.Количество() Тогда
		ЗавершитьОтправкуКомментария(Контекст.Текст, Контекст.Файлы);
		Возврат;
	КонецЕсли;
	
	Путь = Контекст.Очередь[Контекст.Индекс];
	Оповещение = Новый ОписаниеОповещения("ПоместитьФайлКомментарияЗавершение", ЭтотОбъект, Контекст);
	Попытка
		НачатьПомещениеФайла(Оповещение, , Путь, Ложь, УникальныйИдентификатор);
	Исключение
		ОтправкаКомментарияВыполняется = Ложь;
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьФайлКомментарияЗавершение(Помещен, Адрес, ВыбранноеИмяФайла, Контекст) Экспорт
	
	Если Не Помещен Тогда
		ОтправкаКомментарияВыполняется = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось прочитать файл'") + " " + Контекст.Очередь[Контекст.Индекс]);
		Возврат;
	КонецЕсли;
	
	Файл = Новый Файл(Контекст.Очередь[Контекст.Индекс]);
	ИмяФайла = Файл.Имя;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "file.bin";
	КонецЕсли;
	
	Контекст.Файлы.Добавить(Новый Структура("ИмяФайла, Адрес", ИмяФайла, Адрес));
	Контекст.Индекс = Контекст.Индекс + 1;
	ПоместитьСледующийФайлКомментария(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОтправкуКомментария(Текст, Файлы)
	
	Результат = ОтправитьКомментарийНаСервере(Текст, Файлы);
	ОтправкаКомментарияВыполняется = Ложь;
	
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;
	
	ТекстКомментария = "";
	ФайлыКомментария.Очистить();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Комментарий отправлен'"));
	
КонецПроцедуры

&НаСервере
Функция ОтправитьКомментарийНаСервере(Знач Текст, Знач ФайлыКомментарияДляОтправки)
	
	Результат = эв_ОбработкаОбращений.ОтправитьКомментарийВИтилиум(Запись.id, Текст, ФайлыКомментарияДляОтправки);
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запись.ТекстОтвета = Результат.ТекстОтвета;
	Если Результат.Скриншоты <> Неопределено Тогда
		Запись.Скриншоты = Результат.Скриншоты;
	КонецЕсли;
	ОбновитьТекстЗадачиНаФорме();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьТекстЗадачиНаФорме()
	
	Задача = эв_ОбработкаОбращений.ТекстЗадачиHTML(Запись.ТекстОбращения, Запись.ТекстОтвета, Запись.Скриншоты);
	
КонецПроцедуры

#КонецОбласти

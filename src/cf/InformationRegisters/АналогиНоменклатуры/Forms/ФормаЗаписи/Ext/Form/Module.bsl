
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ор_ПрограммноеСозданиеЭлементовФорм.СоздатьЭлементыФормы(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(Запись.Аналог) Тогда
		Запись.Приоритет      = ПолучитьПриоритетВСписке(Запись.Номенклатура);
		Запись.ор_Коэффициент = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Запись.Номенклатура = Запись.Аналог Тогда
		СтрокаСообщения = НСтр("ru = 'Значение полей ""Номенклатура"" и ""Аналог"" не могут совпадать.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрокаСообщения,,ЭтаФорма);
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЭтотОбъект.БылаЗаписьОбратнойЗамены Тогда
		ВыполнитьОбратнуюЗамену(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	
	БылаЗапись = Не Отказ;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Не ЗавершениеРаботы И БылаЗапись Тогда
		
		СтруктураПараметров = Новый Структура("Номенклатура, Аналог", Запись.Номенклатура, Запись.Аналог);
		
		Оповестить("ЗаписьАналога", СтруктураПараметров, "ФормаЗаписи");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Подключаемый_ЭлементПриИзменении(Элемент)
	ЭтотОбъект.БылаЗаписьОбратнойЗамены = Ложь;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПриоритетВСписке(Номенклатура)
	
	// Сначала выясним значение первого меньшего приоритета.
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Аналоги.Аналог КАК Аналог,
	|	Аналоги.Приоритет КАК Приоритет
	|ИЗ
	|	РегистрСведений.АналогиНоменклатуры КАК Аналоги
	|ГДЕ
	|	Аналоги.Номенклатура = &Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет УБЫВ");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	ПервыйПриоритет = 0;
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ПервыйПриоритет = Выборка.Приоритет + 1;
	КонецЕсли;
	
	Возврат ПервыйПриоритет;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОбратныйКоэффициент(Номенклатура, Аналог)
	
	// Проверим, а есть ли уже обратная замена.
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Аналоги.Номенклатура КАК Номенклатура,
	|	Аналоги.Аналог КАК Аналог,
	|	Аналоги.ор_Коэффициент КАК Коэффициент
	|ИЗ
	|	РегистрСведений.АналогиНоменклатуры КАК Аналоги
	|ГДЕ
	|	Аналоги.Номенклатура = &Аналог
	|	И Аналоги.Аналог = &Номенклатура");
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Аналог", Аналог);
	
	// Если таковой нет, то добавим.
	ОбратныйКоэффициент = 0;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ОбратныйКоэффициент = Выборка.Коэффициент;
	КонецЕсли;
	
	Возврат ОбратныйКоэффициент;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьЗаписьДляОбратнойЗамены(Номенклатура, Аналог, КоэффициентЗамены, Обратимость)
	
	Если Обратимость Тогда
		НоваяЗапись = РегистрыСведений.АналогиНоменклатуры.СоздатьМенеджерЗаписи();
		НоваяЗапись.Номенклатура = Аналог;
		НоваяЗапись.Аналог       = Номенклатура;
		НоваяЗапись.Прочитать();
		Если НЕ НоваяЗапись.Выбран() Тогда
			НоваяЗапись.Приоритет = ПолучитьПриоритетВСписке(Аналог);
		КонецЕсли;
		НоваяЗапись.ор_Коэффициент = КоэффициентЗамены;
		НоваяЗапись.ор_Обратимость = Истина;
		НоваяЗапись.Номенклатура   = Аналог;
		НоваяЗапись.Аналог         = Номенклатура;
		НоваяЗапись.Записать();
	Иначе
		НоваяЗапись = РегистрыСведений.АналогиНоменклатуры.СоздатьМенеджерЗаписи();
		НоваяЗапись.Номенклатура = Аналог;
		НоваяЗапись.Аналог       = Номенклатура;
		НоваяЗапись.Прочитать();
		НоваяЗапись.Удалить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбратнуюЗамену(Отказ, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(Запись.Аналог) Тогда
		Возврат;
	КонецЕсли;
	
	КоэффициентЗамены = Запись.ор_Коэффициент;
	Если Запись.ор_Обратимость Тогда
		ОбратныйКоэффициент = ПолучитьОбратныйКоэффициент(Запись.Номенклатура, Запись.Аналог);
		Если ОбратныйКоэффициент = 0 ИЛИ ОбратныйКоэффициент <> 1 ИЛИ КоэффициентЗамены <> 1 Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Номенклатура", Запись.Номенклатура);
			ПараметрыФормы.Вставить("Аналог", Запись.Аналог);
			ПараметрыФормы.Вставить("Коэффициент", ?(КоэффициентЗамены > 0, 1 / КоэффициентЗамены, 1));
			
			ОткрытьФорму(
				"РегистрСведений.АналогиНоменклатуры.Форма.ФормаОбратимости",
				ПараметрыФормы,
				ЭтотОбъект,,,,
				Новый ОписаниеОповещения("ВыполнитьОбратнуюЗаменуЗавершение", ЭтотОбъект, ПараметрыЗаписи),
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Отказ = Истина;
		КонецЕсли;
	Иначе
		ВыполнитьЗаписьДляОбратнойЗамены(Запись.Номенклатура, Запись.Аналог, КоэффициентЗамены, Запись.ор_Обратимость);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбратнуюЗаменуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.Свойство("Коэффициент") Тогда
		КоэффициентЗамены = Результат.Коэффициент;
	Иначе
		КоэффициентЗамены = ?(Запись.ор_Коэффициент > 0,1 / Запись.ор_Коэффициент, 1);
	КонецЕсли;
	ВыполнитьЗаписьДляОбратнойЗамены(Запись.Номенклатура, Запись.Аналог, КоэффициентЗамены, Запись.ор_Обратимость);
	
	ЭтотОбъект.БылаЗаписьОбратнойЗамены = Истина;
	
	Записать(ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти
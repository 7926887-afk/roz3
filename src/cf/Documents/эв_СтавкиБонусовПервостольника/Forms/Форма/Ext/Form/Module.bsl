		 Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(ЗначениеВЯчейке, Истина);
		 Если НЕ Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда  
			 Если НЕ СписокНоменклатуры.НайтиПоЗначению(Номенклатура) = Неопределено Тогда
				 Продолжить;
			 КонецЕсли;
			 СписокНоменклатуры.Добавить(Номенклатура);
		 Иначе
			 НЕСписокНоменклатуры.Добавить(ЗначениеВЯчейке);
		 КонецЕсли;
		 
	 КонецЦикла; 
	 
	 Если НЕСписокНоменклатуры.Количество() > 0 Тогда
		 
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена номенклатура:"); 
		 НеНайдено = 0;
		 Для Каждого НетНоменклатуры Из НЕСписокНоменклатуры Цикл
			 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1", НетНоменклатуры));
			 НеНайдено = НеНайдено + 1;
		 КонецЦикла;
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не найдено %1 позиций ЛС. Отредактируйте список бонусной номенклатуры вручную!", НеНайдено));
		 
	 КонецЕсли; 
	 
	 Если СписокНоменклатуры.Количество() > 0 Тогда
	 	ЗаполнитьНаСервере("Номенклатура", ВидСравненияКомпоновкиДанных.ВСписке, СписокНоменклатуры, Магазин);
	 КонецЕсли;
	 
	

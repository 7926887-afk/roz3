&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Отказ Тогда
	    Возврат;
	КонецЕсли;
	
	ПризнакИзменен = ПризнакОтбораИзменен();
	ПризнакНовый = ПризнакОтбораНовый();
	
	Для Каждого СтрокаСтавки Из Объект.СтавкиБонусов Цикл
		Если СтрокаСтавки.ПризнакОтбора = ПризнакНовый Тогда
			СтрокаСтавки.ПризнакОтбора = ПризнакИзменен;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьОтборСтавокБонусов();
	
КонецПроцедуры

&НаСервере   
Процедура УстановитьПараметр(НастройкиКомпоновки, Рекв, Значение)

	ПараметрКомпоновки   = Новый ПараметрКомпоновкиДанных(Рекв);
	ПараметрСКД          = НастройкиКомпоновки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновки);
	Если ПараметрСКД = Неопределено Тогда
	   Возврат;
	КонецЕсли;
	ПараметрСКД.Значение = Значение;
	ПараметрСКД.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементОтбора(Родитель, ИмяОтбора, ВидСравненияКомпоновки, Значение)
	
	ЭлементОтбора = Родитель.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяОтбора);
	ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновки;
	ЭлементОтбора.Использование  = Истина;
	ЭлементОтбора.ПравоеЗначение = Значение;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере(ИмяОтбора, ВидСравненияКомпоновки, Значение, Магазин)
	// Вставить содержимое обработчика.
	
	СхемаКомпоновки     = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СКД");   
	НастройкиКомпоновки = ОтборКомпоновщикНастроек.ПолучитьНастройки(); 
	
	УстановитьПараметр(НастройкиКомпоновки, "СтруктурныеЕдиницы", Магазин);
	УстановитьПараметр(НастройкиКомпоновки, "Период",           КонецДня(Объект.Дата));
	
	ДобавитьЭлементОтбора(НастройкиКомпоновки.Отбор.Элементы, ИмяОтбора, ВидСравненияКомпоновки, Значение);

	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки1 	= КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки1);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТабЗнач = Новый ТаблицаЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТабЗнач);

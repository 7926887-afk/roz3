&НаКлиенте
Функция СтруктурнаяЕдиницаГлавнойТаблицыЗаполнена()
	
	ТекущиеДанныеГлавной = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	
	Если ТекущиеДанныеГлавной = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанныеГлавной.СтруктурнаяЕдиница) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите Аптеку в таблице слева!");
		Возврат Ложь;
	ИНаче
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуСтруктурныхЕдиниц()
	
	СтруктурныеЕдиницы.Очистить();
	
	УникальныеЗначения = Новый Массив;
	
	Если Объект.ВерсияДанных = "" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СинхронизацияДанныхЧерезУниверсальныйФорматСклады.Склад КАК Склад
		|ИЗ
		|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Склады КАК СинхронизацияДанныхЧерезУниверсальныйФорматСклады";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			// Вставить обработку выборки ВыборкаДетальныеЗаписи
			УникальныеЗначения.Добавить(ВыборкаДетальныеЗаписи.Склад);
		КонецЦикла;
		
	Иначе	
		
		Для Каждого СтрокаСтавки Из Объект.СтавкиБонусов Цикл
			
			Если НЕ УникальныеЗначения.Найти(СтрокаСтавки.СтруктурнаяЕдиница) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			УникальныеЗначения.Добавить(СтрокаСтавки.СтруктурнаяЕдиница);
			
		КонецЦикла;
	КонецЕсли;
	
	Для каждого Склад Из УникальныеЗначения Цикл
		НоваяСтрока = СтруктурныеЕдиницы.Добавить();
		НоваяСтрока.СтруктурнаяЕдиница = Склад;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоНоменклатуре(ТекущиеДанные)
	
	ДанныеНоменклатуры = ДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
	ТекущиеДанные.ЦеноваяГруппа = ДанныеНоменклатуры.ЦеноваяГруппа;
	ТекущиеДанные.Производитель = ДанныеНоменклатуры.Производитель;
	ТекущиеДанные.Специализация = ДанныеНоменклатуры.Специализация;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеНоменклатуры(Номенклатура)
	
	Результат = Новый Структура;
	Результат.Вставить("ЦеноваяГруппа", Справочники.ЦеновыеГруппы.ПустаяСсылка());
	Результат.Вставить("Производитель", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("Специализация", Справочники.Номенклатура.ПустаяСсылка());
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Номенклатура,
		"ЦеноваяГруппа, Производитель, Родитель");
	
	Результат.ЦеноваяГруппа = ЗначенияРеквизитов.ЦеноваяГруппа;
	Результат.Производитель = ЗначенияРеквизитов.Производитель;
	Результат.Специализация = ЗначенияРеквизитов.Родитель;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПризнакНовый(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ПризнакОтбора = ПризнакОтбораНовый();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтавокБонусов()
	
	Элементы.СтавкиБонусов.ОтборСтрок = Новый ФиксированнаяСтруктура(ПараметрыОтбораСтавокБонусов());
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыОтбораСтавокБонусов()
	
	ПараметрыОтбора = Новый Структура;
	
	ТекущиеДанные = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПараметрыОтбора.Вставить("СтруктурнаяЕдиница",
			ПредопределенноеЗначение("Справочник.СтруктурныеЕдиницы.ПустаяСсылка"));
	Иначе
		ПараметрыОтбора.Вставить("СтруктурнаяЕдиница", ТекущиеДанные.СтруктурнаяЕдиница);
	КонецЕсли;
	
	Если ТолькоИзмененные = РежимОтбораНовый() Тогда
		ПараметрыОтбора.Вставить("ПризнакОтбора", ПризнакОтбораНовый());
	ИначеЕсли ТолькоИзмененные = РежимОтбораИзменен() Тогда
		ПараметрыОтбора.Вставить("ПризнакОтбора", ПризнакОтбораИзменен());
	КонецЕсли;
	
	Возврат ПараметрыОтбора;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПризнакОтбораНовый()
	
	Возврат "Новый";
	
КонецФункции


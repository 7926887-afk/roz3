
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимОтбора = РежимОтбораВсе();
	ЗаполнитьТаблицуСтруктурныхЕдиниц();
	
	Если Объект.ВерсияДанных = "" Тогда
		Объект.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборСтавокБонусов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	
	УстановитьОтборСтавокБонусов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтруктурныеЕдиницы

&НаКлиенте
Процедура СтруктурныеЕдиницыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СтруктурнаяЕдиницаДоИзменения = ПредопределенноеЗначение("Справочник.СтруктурныеЕдиницы.ПустаяСсылка");
	Иначе
		СтруктурнаяЕдиницаДоИзменения = ТекущиеДанные.СтруктурнаяЕдиница;
	КонецЕсли;
	
	УстановитьОтборСтавокБонусов();
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктурныеЕдиницыПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("СтруктурнаяЕдиница", ТекущиеДанные.СтруктурнаяЕдиница);
	СтрокиСтавок = Объект.СтавкиБонусов.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаСтавки Из СтрокиСтавок Цикл
		Объект.СтавкиБонусов.Удалить(СтрокаСтавки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктурныеЕдиницыСтруктурнаяЕдиницаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовоеЗначение = ТекущиеДанные.СтруктурнаяЕдиница;
	
	Если НовоеЗначение = СтруктурнаяЕдиницаДоИзменения Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовоеЗначение) Тогда
		ПараметрыПоиска = Новый Структура("СтруктурнаяЕдиница", НовоеЗначение);
		НайденныеСтроки = СтруктурныеЕдиницы.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() > 1 Тогда
			ТекущиеДанные.СтруктурнаяЕдиница = СтруктурнаяЕдиницаДоИзменения;
			ПоказатьПредупреждение(, НСтр("ru = 'Структурная единица уже добавлена.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктурнаяЕдиницаДоИзменения) Тогда
		ПараметрыПоиска = Новый Структура("СтруктурнаяЕдиница", СтруктурнаяЕдиницаДоИзменения);
		СтрокиСтавок = Объект.СтавкиБонусов.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаСтавки Из СтрокиСтавок Цикл
			СтрокаСтавки.СтруктурнаяЕдиница = НовоеЗначение;
			УстановитьПризнакНовый(СтрокаСтавки);
		КонецЦикла;
	КонецЕсли;
	
	СтруктурнаяЕдиницаДоИзменения = НовоеЗначение;
	УстановитьОтборСтавокБонусов();
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктурныеЕдиницыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СтруктурнаяЕдиница) Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ОтменаРедактирования = Истина;
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтавкиБонусов

&НаКлиенте
Процедура СтавкиБонусовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Не СтруктурнаяЕдиницаГлавнойТаблицыЗаполнена() Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкиБонусовПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СтавкиБонусов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СтруктурнаяЕдиница) Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ОтменаРедактирования = Истина;
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкиБонусовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СтавкиБонусов.ТекущиеДанные;
	ТекущиеДанныеГлавной = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	
	Если ТекущиеДанныеГлавной <> Неопределено Тогда
		ТекущиеДанные.СтруктурнаяЕдиница = ТекущиеДанныеГлавной.СтруктурнаяЕдиница;
	КонецЕсли;
	
	Если Не Копирование Тогда
		ТекущиеДанные.Автор = ПользователиКлиент.ТекущийПользователь();
	КонецЕсли;
	
	УстановитьПризнакНовый(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкиБонусовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПризнакНовый(Элементы.СтавкиБонусов.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкиБонусовНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтавкиБонусов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРеквизитыПоНоменклатуре(ТекущиеДанные);
	УстановитьПризнакНовый(ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьБонусыКлиент()
	
	ПараметрыОтбора = ПараметрыОтбораСтавокБонусов();
	СтрокиДляЗаполнения = Объект.СтавкиБонусов.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаСтавки Из СтрокиДляЗаполнения Цикл
		СтрокаСтавки.ПроцентИБ = ИБ;
		СтрокаСтавки.ПроцентКБ = КБ;
		СтрокаСтавки.СуммаИБ = ИБФС;
		СтрокаСтавки.СуммаКБ = КБФС;
		СтрокаСтавки.ДатаОкончания = Объект.ДатаОкончания;
		УстановитьПризнакНовый(СтрокаСтавки);
	КонецЦикла;
	
	УстановитьОтборСтавокБонусов();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСОтбором(Команда)
	
	Если Не СтруктурнаяЕдиницаГлавнойТаблицыЗаполнена() Тогда
        Возврат;  
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ЗаполнитьДопОтборНаКлиенте", ЭтаФорма, Неопределено);
	ТекстВопроса = "Будут добавлены товары по доп. отбору. Продолжжить?";
		 
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);  

КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьДопОтборНаКлиенте(Результат, ДопПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Нет Тогда
		 Возврат;
	КонецЕсли;
	
	ТекущиеДанныеГлавной = Элементы.СтруктурныеЕдиницы.ТекущиеДанные;
	
	Если ТекущиеДанныеГлавной <> Неопределено Тогда
		
		ПараметрыОтбора = Новый Структура("Период, Магазин, УникальныйИдентификатор", КонецДня(Объект.Дата), ТекущиеДанныеГлавной.СтруктурнаяЕдиница, УникальныйИдентификатор);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьОтборОкончание", ЭтотОбъект, ПараметрыОтбора);
		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("Документ.эв_СтавкиБонусовПервостольника.Форма.ФормаОтбора", ПараметрыОтбора, Новый УникальныйИдентификатор,,,, ОписаниеОповещения, Режим); 
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервереПоДопОтбору(АдресТаблицыРезультата)
	
	ТаблицаРезультата = ПолучитьИзВременногоХранилища(АдресТаблицыРезультата);
	
	Попытка
		Объект.СтавкиБонусов.Загрузить(ТаблицаРезультата);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьОтборОкончание(Результат, ДопПараметры) Экспорт
	
	Если Результат.Свойство("АдресТаблицыРезультата") И ЗначениеЗаполнено(Результат.АдресТаблицыРезультата) Тогда

		ЗаполнитьНаСервереПоДопОтбору(Результат.АдресТаблицыРезультата); 
		
	//	УстановитьСтатусФормы(Ложь);

	Иначе
		Возврат;    
	КонецЕсли;  


КонецПроцедуры

&НаСервере
Функция НоменклатураПараметрыНаСервере(Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.ор_Производитель КАК Производитель,
		|	Номенклатура.ЦеноваяГруппа КАК ЦеноваяГруппа,
		|	Номенклатура.Родитель КАК Специализация
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтруктураПараметров = Новый Структура;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Вставить обработку выборки ВыборкаДетальныеЗаписи   
		СтруктураПараметров.Вставить("Производитель", ВыборкаДетальныеЗаписи.Производитель);
		СтруктураПараметров.Вставить("ЦеноваяГруппа", ВыборкаДетальныеЗаписи.ЦеноваяГруппа);
		СтруктураПараметров.Вставить("Специализация", ВыборкаДетальныеЗаписи.Специализация);
	КонецЦикла;
	
	Возврат СтруктураПараметров;	

	
КонецФункции

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ЗадатьДатуОкончания();
КонецПроцедуры

&НаСервере
Процедура ЗадатьДатуОкончания()

	ДатаОкончания = КонецМесяца(Объект.Дата);

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьИзФайлаНаСервере(Адрес, Расширение)
	
	НЕСписокНоменклатуры = Новый СписокЗначений;

	НовоеИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДД = ПолучитьИзВременногоХранилища(Адрес);
	ДД.Записать(НовоеИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(НовоеИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	
	МассивАртикулов    = Новый Массив;
	МассивШК           = Новый Массив;
	МассивНаименований = Новый Массив;

	Для Каждого ОбластьТД ИЗ ТабличныйДокумент.Области Цикл
		
		ИмяЛиста     = ОбластьТД.Имя;
		ОбластьФайла = ТабличныйДокумент.ПолучитьОбласть(ИмяЛиста);
		
		КолВоСтрокФайла   = ОбластьФайла.ПолучитьРазмерОбластиДанныхПоВертикали();
		
		Для нСтрокаТФ = 2 ПО КолВоСтрокФайла Цикл
			нСтрока = СтрЗаменить(нСтрокаТФ, Символы.НПП, "");
			
			НаименованиеТовара = ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+1).ТекущаяОбласть.Текст;
			АртикулТовара      = ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+2).ТекущаяОбласть.Текст;
			ШтрихкодТовара     = ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+3).ТекущаяОбласть.Текст;
			
			НС = Объект.СтавкиБонусов.Добавить();
			
			НС.Наименование = НаименованиеТовара;
			НС.Артикул      = АртикулТовара;
			НС.ШК           = ШтрихкодТовара;
			Если ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+4).ТекущаяОбласть.Текст = "" Тогда
				НС.ПроцентИБНовый = 0;
			ИНаче	
				НС.ПроцентИБНовый = ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+4).ТекущаяОбласть.Значение;
			КонецЕсли;
			Если ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+5).ТекущаяОбласть.Текст = "" Тогда
				НС.ПроцентКБНовый = 0;
			ИНаче	
				НС.ПроцентКБНовый = ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+5).ТекущаяОбласть.Значение;
			КонецЕсли;
			Если ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+6).ТекущаяОбласть.Текст = "" Тогда
				НС.СуммаИБНовый = 0;
			ИНаче	
				НС.СуммаИБНовый = ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+6).ТекущаяОбласть.Значение;
			КонецЕсли;
			Если ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+7).ТекущаяОбласть.Текст = "" Тогда
				НС.СуммаКБНовый = 0;
			ИНаче	
				НС.СуммаКБНовый = ОбластьФайла.ПолучитьОбласть("R"+нСтрока+"C"+7).ТекущаяОбласть.Значение;
			КонецЕсли;
			
			НС.ДатаОкончанияНовый = Объект.ДатаОкончания;
			
			Если МассивАртикулов.Найти(АртикулТовара) = Неопределено Тогда
			    МассивАртикулов.Добавить(АртикулТовара);
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.Артикул КАК Артикул,
		|	Товары.Ссылка КАК Товар
		|ИЗ
		|	Справочник.Номенклатура КАК Товары
		|ГДЕ
		|	Товары.Артикул В(&Артикулы)";
	
	Запрос.УстановитьПараметр("Артикулы", МассивАртикулов);
	
	РезультатЗапросаАртикулы = Запрос.Выполнить().Выгрузить();
	
	Отбор = новый Структура("Артикул");
	Для каждого Стр Из Объект.СтавкиБонусов Цикл
	   Отбор.Артикул = Стр.Артикул;
	   
	   МС = РезультатЗапросаАртикулы.НайтиСтроки(Отбор);
	   Если МС.Количество() = 0 Тогда
		   Если ЗначениеЗаполнено(Стр.ШК) И МассивШК.Найти(Стр.ШК) = Неопределено Тогда
	       	МассивШК.Добавить(Стр.ШК);  	
		   КонецЕсли;
	   ИНаче
		   Стр.Номенклатура = МС[0].Товар;
	   КонецЕсли;	
	
	КонецЦикла;
	

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Штрихкоды.Владелец КАК Справочник.Номенклатура) КАК Товар,
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В(&Штрихкоды)";
	
	Запрос.УстановитьПараметр("Штрихкоды", МассивШК);
	
	ТЗ_ШК = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура("Штрихкод");
	Для каждого Стр Из Объект.СтавкиБонусов Цикл
	   Отбор.Штрихкод = Стр.ШК;
	   
	   МС = ТЗ_ШК.НайтиСтроки(Отбор);
	   Если МС.Количество() = 0 Тогда
           Стр.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Стр.Наименование,Истина);
	   ИНаче
		   Стр.Номенклатура = МС[0].Товар;
	   КонецЕсли;	
	   
	   Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
		   СтрМассив = Новый Массив;
		   СтрМассив.Добавить(Стр.Артикул);
		   СтрМассив.Добавить(Стр.ШК);
		   СтрМассив.Добавить(Стр.Наименование);
		   
		   НЕСписокНоменклатуры.Добавить(СтрСоединить(СтрМассив," "));
	   Иначе
		   
 			Стр.Производитель = Стр.Номенклатура.ор_Производитель;  
			Стр.Специализация = Стр.Номенклатура.родитель;
			Стр.ЦеноваяГруппа = Стр.Номенклатура.ЦеноваяГруппа;
			Стр.ПризнакОтбора = "Новый";

	   КонецЕсли;
	КонецЦикла;


	Если НЕСписокНоменклатуры.Количество() > 0 Тогда
		 
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена номенклатура:"); 
		 НеНайдено = 0;
		 Для Каждого НетНоменклатуры Из НЕСписокНоменклатуры Цикл
			 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1", НетНоменклатуры));
			 НеНайдено = НеНайдено + 1;
		 КонецЦикла;
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не найдено %1 позиций ЛС. Отредактируйте список бонусной номенклатуры вручную!", НеНайдено));
		 
	 КонецЕсли; 
	
КонецПроцедуры


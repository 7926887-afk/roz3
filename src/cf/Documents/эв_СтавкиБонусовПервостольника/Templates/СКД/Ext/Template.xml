		<query>ВЫБРАТЬ
	Номенклатура.Ссылка КАК Товар,
	Номенклатура.Родитель КАК Специализация,
	Номенклатура.ор_Производитель КАК Производитель,
	Номенклатура.ЦеноваяГруппа КАК ЦеноваяГруппа

ПОМЕСТИТЬ ВТ_Товары
ИЗ
	Справочник.Номенклатура КАК Номенклатура
ГДЕ
	Номенклатура.ПометкаУдаления = ЛОЖЬ
	И Номенклатура.ЭтоГруппа = ЛОЖЬ

ИНДЕКСИРОВАТЬ ПО
	Товар
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Товары.Товар КАК Номенклатура,
	ВТ_Товары.Специализация КАК Специализация,
	ВТ_Товары.Производитель КАК Производитель,
	ВТ_Товары.ЦеноваяГруппа КАК ЦеноваяГруппа,
	эв_СтавкиБонусовСрезПоследних.ПроцентИБ КАК ПроцентИБНовый,
	эв_СтавкиБонусовСрезПоследних.ПроцентКБ КАК ПроцентКБНовый,
	эв_СтавкиБонусовСрезПоследних.СуммаИБ КАК СуммаИБНовый,
	эв_СтавкиБонусовСрезПоследних.СуммаКБ КАК СуммаКБНовый,
	эв_СтавкиБонусовСрезПоследних.ДатаОкончания КАК ДатаОкончанияНовый,
	эв_СтавкиБонусовСрезПоследних.ПроцентИБ КАК ПроцентИБ,
	эв_СтавкиБонусовСрезПоследних.ПроцентКБ КАК ПроцентКБ,
	эв_СтавкиБонусовСрезПоследних.СуммаИБ КАК СуммаИБ,
	эв_СтавкиБонусовСрезПоследних.СуммаКБ КАК СуммаКБ,
	эв_СтавкиБонусовСрезПоследних.ДатаОкончания КАК ДатаОкончания,
	"Новый" КАК ПризнакОтбора,
	&amp;Магазин КАК СтруктурнаяЕдиница
ИЗ
	ВТ_Товары КАК ВТ_Товары
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.эв_СтавкиБонусовПервостольника.СрезПоследних(, СтруктурнаяЕдиница = (&amp;Магазин)) КАК эв_СтавкиБонусовСрезПоследних
		ПО ВТ_Товары.Товар = эв_СтавкиБонусовСрезПоследних.Номенклатура</query>

&НаКлиенте
Процедура Подключаемый_ор_СоставТранспортныхУпаковокПослеУдаления(Элемент)
	
	ор_ИнтеграцияМДЛПКлиентСервер.ОбновитьСтатусыЗаполненияНомеровУпаковок(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ор_СоставТранспортныхУпаковокКоличествоПриИзменении(Элемент)
	
	ор_ИнтеграцияМДЛПКлиентСервер.ОбновитьСтатусыЗаполненияНомеровУпаковок(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ор_СоставТранспортныхУпаковокПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеДанные = Элементы.ор_СоставТранспортныхУпаковок.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область МаркировкаМДЛПЗаполнениеТранспортныхУпаковок

&НаКлиенте
Процедура Подключаемый_ЗаполнитьСоставТранспортнойУпаковки(Команда)
	
	ТекущиеДанные = Элементы.ор_ТранспортныеУпаковки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрана транспортная упаковка.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	НайденныйСтроки = Объект.ор_СоставТранспортныхУпаковок.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныйСтроки.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьСоставТранспортнойУпаковкиОповещения", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Состав транспортой упаковки ""%НомерУпаковки%"" будет перезаполнен. Продолжить?'");
		ТекстВопроса = СтрЗаменить(ТекстВопроса, "%НомерУпаковки%", ТекущиеДанные.НомерУпаковки);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПродолжитьЗаполнениеСоставаТранспортнойУпаковки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСоставТранспортнойУпаковкиОповещения(ОтветНаВопрос, Параметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьЗаполнениеСоставаТранспортнойУпаковки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗаполнениеСоставаТранспортнойУпаковки()
	
	ТекущиеДанныеИдентификатор = Элементы.ор_ТранспортныеУпаковки.ТекущиеДанные.ПолучитьИдентификатор();
	ПараметрыФормыУказания = ПараметрыФормыЗаполненияСоставаТранспортнойУпаковки(ТекущиеДанныеИдентификатор);
	
	Если ПараметрыФормыУказания.Свойство("Отказ") Тогда
		Если ПараметрыФормыУказания.Свойство("ТекстОшибки") Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ПараметрыФормыУказания.ТекстОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ОбработчикЗаполненияНомеровУпаковок = Новый ОписаниеОповещения("ЗаполнениеСоставаТранспортнойУпаковкиЗавершение", ЭтотОбъект, ПараметрыФормыУказания);
	РежимБлокировки = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	
	ОткрытьФорму(ПараметрыФормыУказания.ИмяФормы, ПараметрыФормыУказания, ЭтаФорма,,,, ОбработчикЗаполненияНомеровУпаковок, РежимБлокировки);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыФормыЗаполненияСоставаТранспортнойУпаковки(ТекущиеДанныеИдентификатор)
	
	ПараметрыФормыУказанияМДЛП = ор_ИнтеграцияМДЛПКлиентСервер.ПараметрыФормыУказанияМДЛП();
	ПараметрыФормыУказанияМДЛП.ТекущиеДанныеИдентификатор = ТекущиеДанныеИдентификатор;
	
	Возврат ор_ИнтеграцияМДЛП.ПолучитьПараметрыФормыЗаполненияСоставаТранспортнойУпаковки(Объект, ЭтаФорма, ПараметрыФормыУказанияМДЛП);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнениеСоставаТранспортнойУпаковкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("Результат", Результат);
		ЗаполнениеСоставаТранспортнойУпаковкиЗавершениеСервер(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеСоставаТранспортнойУпаковкиЗавершениеСервер(ДополнительныеПараметры)
	
	ор_ИнтеграцияМДЛП.ЗаполнитьСоставТранспортныхУпаковок(Объект, ДополнительныеПараметры, ЭтотОбъект);
	
	ЗаполнитьПризнакиИспользованияХарактеристик();
	
	ИнтеграцияМДЛПВызовСервера();
	
КонецПроцедуры

#КонецОбласти

#Область МаркировкаМДЛППрочее

&НаКлиенте
Функция ПроверитьЗаполнениеДляУведомления(ИмяКоманды)
	
	ЕстьОшибки = Ложь;
	
	Если ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций() И Не ЗначениеЗаполнено(Объект.СтруктурнаяЕдиница) Тогда
		ТекстСообщения = НСтр("ru = 'Склад не заполнен'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЕстьОшибки И
		(Модифицированность ИЛИ Объект.Ссылка.Пустая()) Тогда
		ЕстьОшибки = Истина;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьДокументОповещения", ЭтотОбъект, Новый Структура("ИмяКоманды",ИмяКоманды));
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Документ не записан. Записать?'"), РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
	Возврат НЕ ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьДокументОповещения(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если Записать() Тогда
		СопоставитьПоУведомлению(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций()
	
	Возврат ор_ИнтеграцияМДЛП.ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций();
	
КонецФункции

&НаСервере
Процедура ИнтеграцияМДЛПВызовСервера()
	
	ор_ИнтеграцияМДЛПКлиентСервер.ЗаполнитьПризнакИспользоватьНомераУпаковок(Объект,, ПолучитьПризнакЗапретаСервер());
	ор_ИнтеграцияМДЛПКлиентСервер.ОбновитьСтатусыЗаполненияНомеровУпаковок(Объект);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПризнакЗапрета()
	
	Возврат ПолучитьПризнакЗапретаСерверБезКонтекста(Объект.ДокументОснование);
	
КонецФункции

&НаСервере
Функция ПолучитьПризнакЗапретаСервер()
	
	Возврат ПолучитьПризнакЗапретаСерверБезКонтекста(Объект.ДокументОснование);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПризнакЗапретаСерверБезКонтекста(ДокументПеремещение)
	
	Если ТипЗнч(ДокументПеремещение) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		Если ДокументПеремещение.ор_ЕстьМаркируемаяПродукция Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция УдалитьСтрокиУпаковокИзТабличнойЧасти(ТабличнаяЧасть, СтрокиКУдалению, СоставУпаковок = Неопределено)
	
	УдаляемыеСтроки = Новый Массив;
	Для Каждого ИдентификаторСтроки Из СтрокиКУдалению Цикл
		ТекущаяСтрока = ТабличнаяЧасть.НайтиПоИдентификатору(ИдентификаторСтроки);
		УдаляемыеСтроки.Добавить(ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из УдаляемыеСтроки Цикл
		Если СоставУпаковок <> Неопределено Тогда
			НайденныйСтроки = СоставУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки));
			Для Каждого СтрокаСостава Из НайденныйСтроки Цикл
				СоставУпаковок.Удалить(СтрокаСостава);
			КонецЦикла;
		КонецЕсли;
		ТабличнаяЧасть.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	Возврат УдаляемыеСтроки.Количество() > 0;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ВводСерийПоПараметрам

&НаКлиенте
Процедура Подключаемый_ВводСерийПоПараметрамПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаПараметрыВводаСерий",
		"ТолькоПросмотр",
		НЕ Объект.ор_ВводСерийПоПараметрам);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ЗапасыСерияПроизводителя",
		"Видимость",
		Объект.ор_ВводСерийПоПараметрам);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ЗапасыСрокГодности",
		"Видимость",
		Объект.ор_ВводСерийПоПараметрам);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ЗапасыХарактеристика",
		"ПропускатьПриВводе",
		Объект.ор_ВводСерийПоПараметрам);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоматическиФормироватьШтрихкодСерииПриСозданииПриИзменении(Элемент)
	
	Если Объект.ор_АвтоматическиФормироватьШтрихкодСерииПриСоздании Тогда
		Объект.ор_ЗапрашиватьШтрихкодСерииПриСоздании = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗапрашиватьШтрихкодСерииПриСозданииПриИзменении(Элемент)
	
	Если Объект.ор_ЗапрашиватьШтрихкодСерииПриСоздании Тогда
		Объект.ор_АвтоматическиФормироватьШтрихкодСерииПриСоздании = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗапасыСерияПроизводителяПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Запасы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура)
		И ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности)
		И ЗначениеЗаполнено(ТекущаяСтрока.СерияПроизводителя) Тогда
		ВыполнитьВводСерииПоПараметрам(ТекущаяСтрока);
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.СерияПроизводителя) Тогда
		ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		ЗапасыХарактеристикаПриИзменении(Элементы.ЗапасыХарактеристика);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗапасыСрокГодностиПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Запасы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура)
		И ЗначениеЗаполнено(ТекущаяСтрока.СерияПроизводителя)
		И ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности) Тогда
		ВыполнитьВводСерииПоПараметрам(ТекущаяСтрока);
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности) Тогда
		ТекущаяСтрока.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		ЗапасыХарактеристикаПриИзменении(Элементы.ЗапасыХарактеристика);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВводСерииПоПараметрам(ТекущаяСтрока)
	
	Если НЕ (Объект.ор_ВводСерийПоПараметрам
		И ТекущаяСтрока.ИспользоватьХарактеристики И ТекущаяСтрока.ИспользуютсяСерииПроизводителя) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ор_ВсегдаФормироватьНовыеСерии Тогда
		
		// Создаем новую серию
		Если Объект.ор_ЗапрашиватьШтрихкодСерииПриСоздании Тогда
			ОбработчикОповещения = Новый ОписаниеОповещения("ОкончаниеВводаШКСерии", ЭтотОбъект);
			Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
			ОткрытьФорму("ОбщаяФорма.ор_ФормаВводаШтрихкодаСерии",,,,,, ОбработчикОповещения, Режим);
		Иначе
			СоздатьНовуюСерию(ТекущаяСтрока);
			ЗапасыХарактеристикаПриИзменении(Элементы.ЗапасыХарактеристика);
		КонецЕсли;
		
	Иначе
		// Пытаемся найти существующую серию по параметрам
		НайденнаяСерия = ор_ОбщегоНазначенияСервер.НайтиСериюПоПараметрам(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.СерияПроизводителя, ТекущаяСтрока.СрокГодности);
		
		Если ЗначениеЗаполнено(НайденнаяСерия) Тогда
			ТекущаяСтрока.Характеристика = НайденнаяСерия;
			ЗапасыХарактеристикаПриИзменении(Элементы.ЗапасыХарактеристика);
		Иначе
			Если Объект.ор_ЗапрашиватьШтрихкодСерииПриСоздании Тогда
				ОбработчикОповещения = Новый ОписаниеОповещения("ОкончаниеВводаШКСерии", ЭтотОбъект);
				Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
				ОткрытьФорму("ОбщаяФорма.ор_ФормаВводаШтрихкодаСерии",,,,,, ОбработчикОповещения, Режим);
			Иначе 
				СоздатьНовуюСерию(ТекущаяСтрока);
				ЗапасыХарактеристикаПриИзменении(Элементы.ЗапасыХарактеристика);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовуюСерию(ТекущаяСтрока, ЗначениеШК = "")
	
	НоваяСерия = ор_ОбщегоНазначенияСервер.СоздатьСериюПоПараметрам(ТекущаяСтрока.Номенклатура,
		ТекущаяСтрока.СерияПроизводителя,
		ТекущаяСтрока.СрокГодности,
		Объект.ор_АвтоматическиФормироватьШтрихкодСерииПриСоздании,
		ЗначениеШК);
		
	ТекущаяСтрока.Характеристика = НоваяСерия;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВводаШКСерии(ЗначениеШК, ДополнительныеПараметры) Экспорт 
	
	ТекущаяСтрока = Элементы.Запасы.ТекущиеДанные;
	
	Если ЗначениеШК <> Неопределено Тогда
		СоздатьНовуюСерию(ТекущаяСтрока, ЗначениеШК);
	Иначе
		СоздатьНовуюСерию(ТекущаяСтрока);
	КонецЕсли;
	ЗапасыХарактеристикаПриИзменении(Элементы.ЗапасыХарактеристика);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкиСерииИСрокаГодности()
	
	Для Каждого СтрокаТЧ Из Объект.Запасы Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
			СтрокаТЧ.СрокГодности       = СтрокаТЧ.Характеристика.ор_СрокГодности;
			СтрокаТЧ.СерияПроизводителя = СтрокаТЧ.Характеристика.ор_СерияПроизводителя;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПризнакИспользованияСерийПроизводителяВТаблице()
	
	Если Объект.Запасы.Количество() = 0
		ИЛИ НЕ ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура КАК Справочник.Номенклатура).ИспользоватьХарактеристики
	|			ИЛИ ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура КАК Справочник.Номенклатура).КатегорияНоменклатуры.ИспользоватьХарактеристики)
	|			И ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура КАК Справочник.Номенклатура).КатегорияНоменклатуры.ор_ВестиСерийныйУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИспользуютсяСерииПроизводителя
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", Объект.Запасы.Выгрузить(,"НомерСтроки,Номенклатура"));
	
	ТаблицаПризнаков = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТабл из Объект.Запасы Цикл
		
		СтрокаХарактеристик = ТаблицаПризнаков[СтрТабл.НомерСтроки-1];
		
		СтрТабл.ИспользуютсяСерииПроизводителя = СтрокаХарактеристик.ИспользуютсяСерииПроизводителя;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВедетсяУчетСерий(Номенклатура)
	Возврат Номенклатура.КатегорияНоменклатуры.ор_ВестиСерийныйУчет;
КонецФункции

&НаСервере
Функция ПолучитьСериюИСрокГодностиДляХарактеристики(Характеристика, Номенклатура, ХарактеристикиИспользуются)
	
	СтруктураДанных = Новый Структура;
	Если ЗначениеЗаполнено(Характеристика) Тогда 
		СтруктураДанных.Вставить("СрокГодности", Характеристика.ор_СрокГодности);
		СтруктураДанных.Вставить("СерияПроизводителя", Характеристика.ор_СерияПроизводителя);
		СтруктураДанных.Вставить("ИспользуютсяСерииПроизводителя", ХарактеристикиИспользуются И Номенклатура.КатегорияНоменклатуры.ор_ВестиСерийныйУчет);
	Иначе
		СтруктураДанных.Вставить("СрокГодности", Дата("00010101000000"));
		СтруктураДанных.Вставить("СерияПроизводителя", "");
		СтруктураДанных.Вставить("ИспользуютсяСерииПроизводителя", ХарактеристикиИспользуются И Номенклатура.КатегорияНоменклатуры.ор_ВестиСерийныйУчет);
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

#КонецОбласти

#КонецОбласти

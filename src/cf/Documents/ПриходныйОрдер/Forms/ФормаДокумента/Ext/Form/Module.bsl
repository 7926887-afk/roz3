	// + ор интеграция МДЛП
	ор_ИнтеграцияМДЛП.ПолучитьСлужебныеРеквизитыМДЛП(СтруктураДанные);
	// - ор интеграция МДЛП
	
	Возврат СтруктураДанные;
	
КонецФункции


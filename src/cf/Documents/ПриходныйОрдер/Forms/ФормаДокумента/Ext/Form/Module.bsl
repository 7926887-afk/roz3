Процедура УказатьНомераУпаковок()
	
	ТекущиеДанныеИдентификатор = Элементы.Запасы.ТекущиеДанные.ПолучитьИдентификатор();
	ПараметрыФормыУказания = ПараметрыФормыНомеровУпаковок(ТекущиеДанныеИдентификатор);
	
	ОбработчикУказанияСерий = Новый ОписаниеОповещения("ОбработатьУказаниеНомеровУпаковок", ЭтотОбъект, ПараметрыФормыУказания);
	РежимБлокировки = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	
	ОткрытьФорму(ПараметрыФормыУказания.ИмяФормы, ПараметрыФормыУказания, ЭтаФорма,,,, ОбработчикУказанияСерий, РежимБлокировки);
	
КонецПроцедуры


	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаРеквизитыЧекаККМ = РезультатЗапроса[0].Выбрать();
	
	Пока ВыборкаРеквизитыЧекаККМ.Следующий() Цикл
		
		
		ЗаполнитьЗначенияСвойств(ДокументОбъектЗаказа, ВыборкаРеквизитыЧекаККМ);
		ДокументОбъектЗаказа.ВидОперации 					= Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
		ДокументОбъектЗаказа.ВидЗаказа 						= Справочники.ВидыЗаказовПокупателей.Основной;
		ДокументОбъектЗаказа.Дата 							= ВыборкаРеквизитыЧекаККМ.Дата - 1;
		
		Если ВыборкаРеквизитыЧекаККМ.ОперацияСДенежнымиСредствами Тогда
			ДокументОбъектЗаказа.СтруктурнаяЕдиницаРезерв = ВыборкаРеквизитыЧекаККМ.СтруктурнаяЕдиница;
		Иначе
			ДокументОбъектЗаказа.СтруктурнаяЕдиницаПродажи = ВыборкаРеквизитыЧекаККМ.СтруктурнаяЕдиница;
			ДокументОбъектЗаказа.ДатаОтгрузки = ВыборкаРеквизитыЧекаККМ.Дата
		КонецЕсли;
		
	КонецЦикла;
	
	// Заполнение табличныч частей созданного заказа.
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[1].Выгрузить(),
													ДокументОбъектЗаказа.Запасы);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[2].Выгрузить(),
													ДокументОбъектЗаказа.Предоплата);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[3].Выгрузить(),
													ДокументОбъектЗаказа.СкидкиНаценки);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[4].Выгрузить(),
													ДокументОбъектЗаказа.СерииНоменклатуры);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[5].Выгрузить(),
													ДокументОбъектЗаказа.ДобавленныеНаборы);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[6].Выгрузить(),
													ДокументОбъектЗаказа.БонусныеБаллыКНачислению);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[7].Выгрузить(),
													ДокументОбъектЗаказа.Подарки);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса[8].Выгрузить(),
													ДокументОбъектЗаказа.СерииПодарков);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСозданиеЗаказаНаОснованииЧека(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.СсылкаДокументаЗаказа.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьСозданиеЗаказаНаОснованииЧекаНаСервере(ДополнительныеПараметры.СсылкаЧекККМ,
														ДополнительныеПараметры.СсылкаДокументаЗаказа);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьСозданиеЗаказаНаОснованииЧекаНаСервере(СсылкаЧекККМ, СсылкаЗаказ)
	
	ЧекККМОбъект = СсылкаЧекККМ.ПолучитьОбъект();
	ЧекККМОбъект.ЕстьЗаказы = Истина;
	ЧекККМОбъект.Заказ = СсылкаЗаказ;
	ЧекККМОбъект.Контрагент = СсылкаЗаказ.Контрагент;
	
	Попытка
		ЧекККМОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Нстр("ru = 'Не удалось провести выбранный чек после создания заказа.'");
		Сообщение.Сообщить();
	КонецПопытки
	
КонецПроцедуры


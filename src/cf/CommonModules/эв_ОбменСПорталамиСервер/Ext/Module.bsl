Функция АктивныеИсточникиПортала(Портал, ТолькоСоСкладомИВидомЦен)

	Если Не ЗначениеЗаполнено(Портал) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Источники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.эв_ИсточникиЗаказов КАК Источники
		|ГДЕ
		|	Источники.Активный
		|	И НЕ Источники.ПометкаУдаления
		|	И Источники.Вид.Портал = &Портал
		|	И (&БезОтбораРеквизитов
		|		ИЛИ (Источники.Склад <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
		|			И Источники.ВидЦен <> ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Источники.Код";
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("БезОтбораРеквизитов", Не ТолькоСоСкладомИВидомЦен);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция ПакетАптеки(ДанныеАптеки, Удалить)

	Пакет = Новый Структура("list", Новый Массив);
	Склад = ЗначениеСвойства(ДанныеАптеки, "Склад");
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Пакет;
	КонецЕсли;

	ОГРН = "";
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "Организация");
	Если ЗначениеЗаполнено(Организация) Тогда
		ОГРН = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ОГРН"));
	КонецЕсли;

	Аптека = Новый Структура;
	Аптека.Вставить("id",        XMLСтрока(Склад));
	Аптека.Вставить("region",    ЗначениеСвойства(ДанныеАптеки, "Регион", ""));
	Аптека.Вставить("city",      ЗначениеСвойства(ДанныеАптеки, "Город", ""));
	Аптека.Вставить("address",   ЗначениеСвойства(ДанныеАптеки, "Адрес", ""));
	Аптека.Вставить("brand",     "ЭВАЛАР");
	Аптека.Вставить("latitude",  ЗначениеСвойства(ДанныеАптеки, "Широта", 0));
	Аптека.Вставить("longitude", ЗначениеСвойства(ДанныеАптеки, "Долгота", 0));
	Аптека.Вставить("phone",     ЗначениеСвойства(ДанныеАптеки, "Телефон", ""));
	Аптека.Вставить("schedule",  ЗначениеСвойства(ДанныеАптеки, "ГрафикРаботы", ""));
	Аптека.Вставить("ogrn",      ОГРН);
	Аптека.Вставить("email",     ЗначениеСвойства(ДанныеАптеки, "Почта", ""));
	Аптека.Вставить("is_deleted", Удалить = Истина);
	Пакет.list.Добавить(Аптека);

	Возврат Пакет;

КонецФункции

Функция ТекстСообщенияОтвета(РезультатHTTP)

	Если РезультатHTTP = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Json = РезультатHTTP.Json;
	Сообщение = Неопределено;
	Если ТипЗнч(Json) = Тип("Структура") И Json.Свойство("message") Тогда
		Сообщение = Json.message;
	ИначеЕсли ТипЗнч(Json) = Тип("Соответствие") Тогда
		Сообщение = Json.Получить("message");
	КонецЕсли;

	Если Сообщение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Сообщение));

КонецФункции

Процедура СообщитьСписокСтатусаАптеки(РезультатHTTP)

	Список = Неопределено;
	Json = РезультатHTTP.Json;
	Если ТипЗнч(Json) = Тип("Структура") И Json.Свойство("list") Тогда
		Список = Json.list;
	ИначеЕсли ТипЗнч(Json) = Тип("Соответствие") Тогда
		Список = Json.Получить("list");
	КонецЕсли;

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементСписка Из Список Цикл
		Если ТипЗнч(ЭлементСписка) <> Тип("Структура") И ТипЗнч(ЭлементСписка) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		СтрокиСтатуса = Новый Массив;
		Для Каждого Поле Из ЭлементСписка Цикл
			СтрокиСтатуса.Добавить(Строка(Поле.Ключ) + " = " + Строка(Поле.Значение));
		КонецЦикла;
		ОбщегоНазначения.СообщитьПользователю(СтрСоединить(СтрокиСтатуса, Символы.ПС));
	КонецЦикла;

КонецПроцедуры

Функция ЗаписатьКаталогДБФВХранилище(Склад, АдресХранилища)

	ТаблицаКаталога = ТаблицаКаталогаАСНА(Склад);
	ИмяФайла = ПолучитьИмяВременногоФайла("dbf");
	УдалитьФайлы(ИмяФайла);

	ФайлДБФ = Новый XBase;
	ФайлДБФ.Кодировка = КодировкаXBase.ANSI;
	ФайлДБФ.Поля.Добавить("ID", "S", 36);
	ФайлДБФ.Поля.Добавить("Name", "S", 100);
	ФайлДБФ.Поля.Добавить("Producer", "S", 150);
	ФайлДБФ.Поля.Добавить("Country", "S", 60);
	ФайлДБФ.Поля.Добавить("EAN", "S", 150);

	Попытка
		ФайлДБФ.СоздатьФайл(ИмяФайла);
		Штрихкоды = ШтрихкодыКаталогаАСНА(ТаблицаКаталога);
		Для Каждого СтрокаКаталога Из ТаблицаКаталога Цикл
			Производитель = СокрЛП(СтрокаКаталога.Производитель);
			ШтрихкодыПозиции = Штрихкоды.Получить(СтрокаКаталога.Номенклатура);
			Если ШтрихкодыПозиции = Неопределено Тогда
				ШтрихкодыПозиции = Новый Массив;
			КонецЕсли;
			Если ПустаяСтрока(Производитель) Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
					"Позиция %1 пропущена: не указан производитель.", СтрокаКаталога.Наименование));
				Продолжить;
			КонецЕсли;
			Если ШтрихкодыПозиции.Количество() = 0 Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
					"Позиция %1 пропущена: не указан штрихкод.", СтрокаКаталога.Наименование));
				Продолжить;
			КонецЕсли;

			ФайлДБФ.Добавить();
			ФайлДБФ.ID = Лев(XMLСтрока(СтрокаКаталога.Номенклатура), 36);
			ФайлДБФ.Name = Лев(СокрЛП(СтрокаКаталога.Наименование), 100);
			ФайлДБФ.Producer = Лев(Производитель, 150);
			ФайлДБФ.Country = Лев(СокрЛП(СтрокаКаталога.Страна), 60);
			ФайлДБФ.EAN = Лев(СтрСоединить(ШтрихкодыПозиции, ","), 150);
			ФайлДБФ.Записать();
		КонецЦикла;
		ФайлДБФ.ЗакрытьФайл();
		ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), АдресХранилища);
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Склад, ОписаниеОшибки());
		Попытка
			ФайлДБФ.ЗакрытьФайл();
		Исключение
		КонецПопытки;
		УдалитьФайлы(ИмяФайла);
		Возврат Ложь;
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);
	Возврат Истина;

КонецФункции

Функция ТаблицаКаталогаАСНА(Склад)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(ЕСТЬNULL(Остатки.Номенклатура.Наименование, """")) КАК Наименование,
		|	МАКСИМУМ(ЕСТЬNULL(Остатки.Номенклатура.ор_Производитель.Наименование, """")) КАК Производитель,
		|	МАКСИМУМ(ЕСТЬNULL(Остатки.Номенклатура.СтранаПроисхождения.Наименование, """")) КАК Страна
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, СтруктурнаяЕдиница = &Склад) КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура";
	Запрос.УстановитьПараметр("Склад", Склад);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ШтрихкодыКаталогаАСНА(ТаблицаКаталога)

	Результат = Новый Соответствие;
	Если ТаблицаКаталога.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Штрихкоды.Номенклатура КАК Номенклатура,
		|	Штрихкоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Номенклатура В (&Номенклатура)
		|	И Штрихкоды.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|	И (ДЛИНАСТРОКИ(Штрихкоды.Штрихкод) = 12
		|		ИЛИ ДЛИНАСТРОКИ(Штрихкоды.Штрихкод) = 13)";
	Запрос.УстановитьПараметр("Номенклатура", ТаблицаКаталога.ВыгрузитьКолонку("Номенклатура"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Штрихкод = СокрЛП(Выборка.Штрихкод);
		Если СтрДлина(Штрихкод) <> 12 И СтрДлина(Штрихкод) <> 13 Тогда
			Продолжить;
		КонецЕсли;
		Список = Результат.Получить(Выборка.Номенклатура);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Выборка.Номенклатура, Список);
		КонецЕсли;
		Если Список.Найти(Штрихкод) = Неопределено Тогда
			Список.Добавить(Штрихкод);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СостояниеПоКодуПортала(Источник, КодПортала) Экспорт

	Результат = Новый Структура("ВидСтатуса, ПричинаОтмены",
		Справочники.СостоянияЗаказовПокупателей.ПустаяСсылка(),
		Справочники.ПричиныОтменыЗаказа.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Коды.ВидСтатуса КАК ВидСтатуса,
		|	Коды.ПричинаОтмены КАК ПричинаОтмены
		|ИЗ
		|	РегистрСведений.эв_КодыСтатусовПорталов КАК Коды
		|ГДЕ
		|	Коды.ИсточникЗаказов = &ИсточникЗаказов
		|	И Коды.КодПортала = &КодПортала
		|	И Коды.Используется";
	Запрос.УстановитьПараметр("ИсточникЗаказов", Источник);
	Запрос.УстановитьПараметр("КодПортала", КодПортала);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ВидСтатуса = Выборка.ВидСтатуса;
		Результат.ПричинаОтмены = Выборка.ПричинаОтмены;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ИсточникЗаказовПоВидуЗаказа(ВидЗаказаИсточника) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидЗаказаИсточника) Тогда
		Возврат Справочники.эв_ИсточникиЗаказов.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Источники.Ссылка КАК ИсточникЗаказов
		|ИЗ
		|	Справочник.эв_ИсточникиЗаказов КАК Источники
		|ГДЕ
		|	Источники.Вид = &ВидЗаказа
		|	И Источники.Активный
		|	И НЕ Источники.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Источники.Код";
	Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказаИсточника);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИсточникЗаказов;
	КонецЕсли;
	
	Возврат Справочники.эв_ИсточникиЗаказов.ПустаяСсылка();
	
КонецФункции


#КонецОбласти

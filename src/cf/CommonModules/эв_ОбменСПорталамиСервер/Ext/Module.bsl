Процедура ЗаписатьЗаказПокупателяССайта(ЗаказПокупателя, ДанныеЗаказа)

	МенеджерЗаписи = РегистрыСведений.ЗаказыПокупателейССайта.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
	МенеджерЗаписи.НомерЗаказаНаСайте = ДанныеЗаказа.НомерНаСайте;
	МенеджерЗаписи.ДатаЗаказаНаСайте = ДанныеЗаказа.Дата;
	ОплаченНаПортале = Ложь;
	Если ДанныеЗаказа.Свойство("ОплаченНаПортале") И ДанныеЗаказа.ОплаченНаПортале = Истина Тогда
		ОплаченНаПортале = Истина;
	КонецЕсли;
	МенеджерЗаписи.эв_ОплаченНаПортале = ОплаченНаПортале;
	МенеджерЗаписи.эв_ИсходныйПакет = Новый ХранилищеЗначения(ДанныеЗаказа.ИсходныйПакетJSON, Новый СжатиеДанных(9));
	ИдентификаторНаПортале = "";
	Если ДанныеЗаказа.Свойство("ИдентификаторНаПортале") И ЗначениеЗаполнено(ДанныеЗаказа.ИдентификаторНаПортале) Тогда
		ИдентификаторНаПортале = ДанныеЗаказа.ИдентификаторНаПортале;
	КонецЕсли;
	МенеджерЗаписи.Идентификатор = ИдентификаторНаПортале;
	МенеджерЗаписи.Записать();


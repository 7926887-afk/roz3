Функция ЗначениеСвойства(Структура, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)

	Если ТипЗнч(Структура) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Не Структура.Свойство(ИмяСвойства) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Структура[ИмяСвойства] = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Структура[ИмяСвойства];


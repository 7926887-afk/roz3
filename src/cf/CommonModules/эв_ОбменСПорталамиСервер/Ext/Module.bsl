Процедура ЗаписатьЛогHTTP(ПараметрыЗапроса, Результат, Тело)

	Источник = ЗначениеСвойства(ПараметрыЗапроса, "ИсточникЗаказов", Справочники.эв_ИсточникиЗаказов.ПустаяСсылка());
	ЗаказПокупателя = ЗначениеСвойства(ПараметрыЗапроса, "ЗаказПокупателя", Документы.ЗаказПокупателя.ПустаяСсылка());

	АдресДляЛога = ЗначениеСвойства(Результат, "АдресФакт", "");
	Если Не ЗначениеЗаполнено(АдресДляЛога) Тогда
		АдресДляЛога = ЗначениеСвойства(ПараметрыЗапроса, "Адрес", "");
	КонецЕсли;
	АдресДляЛога = МаскироватьСекретыВАдресе(АдресДляЛога, ПараметрыЗапроса);

	ТекстЗапроса = "";
	Если Тело <> Неопределено Тогда
		Попытка
			ТекстЗапроса = МаскироватьСекретыВТеле(КоннекторHTTP.ОбъектВJson(Тело), ПараметрыЗапроса);
		Исключение
			ТекстЗапроса = Строка(Тело);
		КонецПопытки;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.эв_ЛогиHTTPПорталов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.Идентификатор = Новый УникальныйИдентификатор;
	МенеджерЗаписи.ИсточникЗаказов = Источник;
	МенеджерЗаписи.Контур = Лев(ЗначениеСвойства(ПараметрыЗапроса, "Контур", ""), 20);
	МенеджерЗаписи.Метод = Лев(ВРег(ЗначениеСвойства(ПараметрыЗапроса, "Метод", "")), 10);
	МенеджерЗаписи.Адрес = Лев(АдресДляЛога, 500);
	МенеджерЗаписи.КодСостояния = Результат.КодСостояния;
	МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
	МенеджерЗаписи.Успех = Результат.Успех;
	МенеджерЗаписи.ДлительностьМс = Результат.ДлительностьМс;
	МенеджерЗаписи.ТекстОшибки = Результат.ТекстОшибки;
	МенеджерЗаписи.ТелоЗапроса = Новый ХранилищеЗначения(ТекстЗапроса, Новый СжатиеДанных(9));
	МенеджерЗаписи.ТелоОтвета = Новый ХранилищеЗначения(Результат.ТекстОтвета, Новый СжатиеДанных(9));
	МенеджерЗаписи.Записать();


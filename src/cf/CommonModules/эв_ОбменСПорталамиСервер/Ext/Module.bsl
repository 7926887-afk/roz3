Функция НайтиИлиСоздатьКонтрагентаПортала(ДанныеЗаказа)

	Контрагент = Неопределено;
	Если ЗначениеЗаполнено(ДанныеЗаказа.Телефон) Тогда
		Контрагент = КонтактнаяИнформацияУНФ.КонтрагентПоНомеруТелефона(ДанныеЗаказа.Телефон, Истина, Ложь, Ложь);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(ДанныеЗаказа.Почта) Тогда
		Контрагент = КонтактнаяИнформацияУНФ.КонтрагентПоАдресуЭП(ДанныеЗаказа.Почта, Истина, Ложь);
	КонецЕсли;
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Контрагент;
	КонецЕсли;

	ФИО = СокрЛП(СтрШаблон("%1 %2 %3", ДанныеЗаказа.Фамилия, ДанныеЗаказа.Имя, ДанныеЗаказа.Отчество));
	Если Не ЗначениеЗаполнено(ФИО) Тогда
		ФИО = "Покупатель портала";
	КонецЕсли;

	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрагентОбъект.Наименование = ФИО;
	КонтрагентОбъект.НаименованиеПолное = ФИО;
	КонтрагентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
	КонтрагентОбъект.Покупатель = Истина;
	КонтрагентОбъект.ВестиРасчетыПоДоговорам = Ложь;
	КонтрагентОбъект.ВестиРасчетыПоДокументам = Ложь;
	КонтрагентОбъект.ВестиРасчетыПоЗаказам = Истина;
	КонтрагентОбъект.ВестиУчетОплатыПоСчетам = Истина;
	КонтрагентОбъект.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Управленческий.РасчетыСПокупателями;
	КонтрагентОбъект.СчетУчетаАвансовПокупателя = ПланыСчетов.Управленческий.РасчетыПоАвансамПолученным;
	КонтрагентОбъект.СчетУчетаРасчетовСПоставщиком = ПланыСчетов.Управленческий.РасчетыСПоставщиками;
	КонтрагентОбъект.СчетУчетаАвансовПоставщику = ПланыСчетов.Управленческий.РасчетыПоАвансамВыданным;

	Если ЗначениеЗаполнено(ДанныеЗаказа.Телефон) Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(КонтрагентОбъект, ДанныеЗаказа.Телефон,
			Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеЗаказа.Почта) Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(КонтрагентОбъект, ДанныеЗаказа.Почта,
			Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
	КонецЕсли;

	КонтрагентОбъект.Записать();
	Возврат КонтрагентОбъект.Ссылка;

КонецФункции

Процедура ЗаполнитьХарактеристикиЗаказаПоОстаткам(ДанныеЗаказа, Склад)

	Если Не ЗначениеЗаполнено(Склад)
		Или ТипЗнч(ДанныеЗаказа) <> Тип("Структура")
		Или Не ДанныеЗаказа.Свойство("Товары")
		Или ТипЗнч(ДанныеЗаказа.Товары) <> Тип("Массив")
		Или ДанныеЗаказа.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НоменклатураЗаказа = Новый Массив;
	Для Каждого СтрокаТовара Из ДанныеЗаказа.Товары Цикл
		Если ТипЗнч(СтрокаТовара) = Тип("Структура") И ЗначениеЗаполнено(ЗначениеСвойства(СтрокаТовара, "Номенклатура")) Тогда
			НоменклатураЗаказа.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если НоменклатураЗаказа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОстаткиПоТоварам = ОстаткиПоНоменклатуре(ОстаткиНоменклатурыДляЗаказа(Склад, НоменклатураЗаказа));
	ЗарезервироватьУказанныеХарактеристики(ДанныеЗаказа.Товары, ОстаткиПоТоварам);

	НовыеТовары = Новый Массив;
	Для Каждого СтрокаТовара Из ДанныеЗаказа.Товары Цикл

		ОстаткиТовара = Неопределено;
		Если ТипЗнч(СтрокаТовара) = Тип("Структура") Тогда
			ОстаткиТовара = ОстаткиПоТоварам.Получить(ЗначениеСвойства(СтрокаТовара, "Номенклатура"));
		КонецЕсли;

		СтрокиРазложения = СтрокиТовараПоОстаткам(СтрокаТовара, ДанныеЗаказа, ОстаткиТовара);
		Если СтрокиРазложения = Неопределено Тогда
			НовыеТовары.Добавить(СтрокаТовара);
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаРазложения Из СтрокиРазложения Цикл
			НовыеТовары.Добавить(СтрокаРазложения);
		КонецЦикла;

	КонецЦикла;

	ДанныеЗаказа.Товары = НовыеТовары;

КонецПроцедуры

Функция ОстаткиНоменклатурыДляЗаказа(Склад, Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Склад
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
		|			,
		|			СтруктурнаяЕдиница = &Склад
		|				И Номенклатура В (&Номенклатура)) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура,
		|	Остатки.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Резервы.Номенклатура КАК Номенклатура,
		|	Резервы.Характеристика КАК Характеристика,
		|	СУММА(Резервы.КоличествоОстаток) КАК РезервОстаток
		|ПОМЕСТИТЬ ВТ_Резервы
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(
		|			,
		|			СтруктурнаяЕдиница = &Склад
		|				И Номенклатура В (&Номенклатура)
		|				И ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Резервы
		|
		|СГРУППИРОВАТЬ ПО
		|	Резервы.Номенклатура,
		|	Резервы.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Склад.Номенклатура КАК Номенклатура,
		|	ВТ_Склад.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0) < 0
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0)
		|	КОНЕЦ КАК ДоступныйОстаток,
		|	ЕСТЬNULL(ВТ_Склад.Характеристика.ор_СерияПроизводителя, """") КАК Серия,
		|	ВТ_Склад.Характеристика.ор_СрокГодности КАК СрокГодности
		|ИЗ
		|	ВТ_Склад КАК ВТ_Склад
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Резервы КАК ВТ_Резервы
		|		ПО ВТ_Склад.Номенклатура = ВТ_Резервы.Номенклатура
		|			И ВТ_Склад.Характеристика = ВТ_Резервы.Характеристика
		|ГДЕ
		|	ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0) > 0
		|	И ВТ_Склад.Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ОстаткиПоНоменклатуре(ТаблицаОстатков)

	ТаблицаОстатков.Колонки.Добавить("ПорядокСрока", Новый ОписаниеТипов("Дата"));
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		Если ЗначениеЗаполнено(СтрокаОстатка.СрокГодности) Тогда
			СтрокаОстатка.ПорядокСрока = СтрокаОстатка.СрокГодности;
		Иначе
			СтрокаОстатка.ПорядокСрока = Дата(3999, 12, 31);
		КонецЕсли;
	КонецЦикла;
	ТаблицаОстатков.Сортировать("Номенклатура, ПорядокСрока");

	ОстаткиПоТоварам = Новый Соответствие;
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл

		ОстаткиТовара = ОстаткиПоТоварам.Получить(СтрокаОстатка.Номенклатура);
		Если ОстаткиТовара = Неопределено Тогда
			ОстаткиТовара = Новый Массив;
			ОстаткиПоТоварам.Вставить(СтрокаОстатка.Номенклатура, ОстаткиТовара);
		КонецЕсли;

		Остаток = Новый Структура;
		Остаток.Вставить("Характеристика", СтрокаОстатка.Характеристика);
		Остаток.Вставить("ДоступныйОстаток", СтрокаОстатка.ДоступныйОстаток);
		Остаток.Вставить("СерияКлюч", ВРег(СокрЛП(СтрокаОстатка.Серия)));
		ОстаткиТовара.Добавить(Остаток);

	КонецЦикла;

	Возврат ОстаткиПоТоварам;

КонецФункции

Процедура ЗарезервироватьУказанныеХарактеристики(Товары, ОстаткиПоТоварам)

	Для Каждого СтрокаТовара Из Товары Цикл

		Если ТипЗнч(СтрокаТовара) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Характеристика = ЗначениеСвойства(СтрокаТовара, "Характеристика");
		Если Не ЗначениеЗаполнено(Характеристика) Или СтрокаТовара.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		ОстаткиТовара = ОстаткиПоТоварам.Получить(СтрокаТовара.Номенклатура);
		Если ОстаткиТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Остаток Из ОстаткиТовара Цикл
			Если Остаток.Характеристика = Характеристика Тогда
				Остаток.ДоступныйОстаток = Макс(0, Остаток.ДоступныйОстаток - СтрокаТовара.Количество);
				Прервать;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Функция СтрокиТовараПоОстаткам(СтрокаТовара, ДанныеЗаказа, ОстаткиТовара)

	Если ТипЗнч(СтрокаТовара) <> Тип("Структура")
		Или ОстаткиТовара = Неопределено
		Или Не ЗначениеЗаполнено(ЗначениеСвойства(СтрокаТовара, "Номенклатура"))
		Или ЗначениеЗаполнено(ЗначениеСвойства(СтрокаТовара, "Характеристика"))
		Или СтрокаТовара.Количество <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	СерияЗаказа = ВРег(СокрЛП(СерияСтрокиЗаказа(СтрокаТовара, ДанныеЗаказа)));
	КРаспределению = СтрокаТовара.Количество;
	Распределение = Новый Массив;

	Если ЗначениеЗаполнено(СерияЗаказа) Тогда
		КРаспределению = ПодобратьПоОстаткам(ОстаткиТовара, СерияЗаказа, Истина, КРаспределению, Распределение);
	КонецЕсли;
	Если КРаспределению > 0 Тогда
		КРаспределению = ПодобратьПоОстаткам(ОстаткиТовара, СерияЗаказа, Ложь, КРаспределению, Распределение);
	КонецЕсли;

	Если Распределение.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КоличествоПредыдущих = 0;
	ПоследнийИндекс = Распределение.ВГраница();
	Для Индекс = 0 По ПоследнийИндекс Цикл
		Если Индекс = ПоследнийИндекс Тогда
			// Остаток количества остаётся на последней характеристике: сумма разреза равна строке заказа.
			Распределение[Индекс].Количество = СтрокаТовара.Количество - КоличествоПредыдущих;
		Иначе
			КоличествоПредыдущих = КоличествоПредыдущих + Распределение[Индекс].Количество;
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Для Каждого Часть Из Распределение Цикл
		НоваяСтрока = СкопироватьСтрокуТовара(СтрокаТовара);
		НоваяСтрока.Характеристика = Часть.Характеристика;
		НоваяСтрока.Количество = Часть.Количество;
		Строки.Добавить(НоваяСтрока);
	КонецЦикла;

	Возврат Строки;

КонецФункции

Функция СерияСтрокиЗаказа(СтрокаТовара, ДанныеЗаказа)

	Серия = СокрЛП(Строка(ЗначениеСвойства(СтрокаТовара, "Серия", "")));
	Если ЗначениеЗаполнено(Серия) Тогда
		Возврат Серия;
	КонецЕсли;

	Возврат СокрЛП(Строка(ЗначениеСвойства(ДанныеЗаказа, "Серия", "")));

КонецФункции

Функция ПодобратьПоОстаткам(ОстаткиТовара, СерияЗаказа, ТолькоСерия, КРаспределению, Распределение)

	Для Каждого Остаток Из ОстаткиТовара Цикл

		Если КРаспределению <= 0 Тогда
			Прервать;
		КонецЕсли;
		Если Остаток.ДоступныйОстаток <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СерияСовпала = ЗначениеЗаполнено(СерияЗаказа) И Остаток.СерияКлюч = СерияЗаказа;
		Если ТолькоСерия <> СерияСовпала Тогда
			Продолжить;
		КонецЕсли;

		Взять = Мин(КРаспределению, Остаток.ДоступныйОстаток);
		Остаток.ДоступныйОстаток = Остаток.ДоступныйОстаток - Взять;
		Распределение.Добавить(Новый Структура("Характеристика, Количество", Остаток.Характеристика, Взять));
		КРаспределению = КРаспределению - Взять;

	КонецЦикла;

	Возврат КРаспределению;

КонецФункции

Функция СкопироватьСтрокуТовара(СтрокаТовара)

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из СтрокаТовара Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Возврат Копия;

КонецФункции

Процедура ЗаполнитьСуммыНДССтроки(СтрокаЗапасы, СуммаВключаетНДС)

	СтавкаЧисло = 0;
	Если ЗначениеЗаполнено(СтрокаЗапасы.СтавкаНДС) Тогда
		СтавкаЧисло = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЗапасы.СтавкаНДС, "Ставка");
		Если СтавкаЧисло = Неопределено Тогда
			СтавкаЧисло = 0;
		КонецЕсли;
	КонецЕсли;

	Если СуммаВключаетНДС Тогда
		СтрокаЗапасы.СуммаНДС = СтрокаЗапасы.Сумма - СтрокаЗапасы.Сумма * 100 / (100 + СтавкаЧисло);
		СтрокаЗапасы.Всего = СтрокаЗапасы.Сумма;
	Иначе
		СтрокаЗапасы.СуммаНДС = СтрокаЗапасы.Сумма * СтавкаЧисло / 100;
		СтрокаЗапасы.Всего = СтрокаЗапасы.Сумма + СтрокаЗапасы.СуммаНДС;
	КонецЕсли;

КонецПроцедуры

Функция ОчередностьСтатусовКорректна(ЗаказПокупателя, Источник, НовыйСтатус)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	История.СтатусЗаказа КАК СтатусЗаказа
		|ИЗ
		|	РегистрСведений.эв_ИсторияСтатусовЗаказов.СрезПоследних(, ЗаказПокупателя = &ЗаказПокупателя) КАК История";  
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.СтатусЗаказа) Тогда
		Возврат Истина;
	КонецЕсли;

	ТекущийСтатус = Выборка.СтатусЗаказа;
	Если ТекущийСтатус = НовыйСтатус Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "Вид");
	ПорядокТекущего = НомерСостоянияВВидеЗаказа(ВидЗаказа, ТекущийСтатус);
	ПорядокНового = НомерСостоянияВВидеЗаказа(ВидЗаказа, НовыйСтатус);
	Если ПорядокТекущего = 0 Или ПорядокНового = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПорядокНового >= ПорядокТекущего;

КонецФункции

Функция НомерСостоянияВВидеЗаказа(ВидЗаказа, Состояние)

	Если Не ЗначениеЗаполнено(ВидЗаказа) Или Не ЗначениеЗаполнено(Состояние) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПорядокСостояний.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ПорядокСостояний
		|ГДЕ
		|	ПорядокСостояний.Ссылка = &ВидЗаказа
		|	И ПорядокСостояний.Состояние = &Состояние";
	Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказа);
	Запрос.УстановитьПараметр("Состояние", Состояние);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НомерСтроки;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция СостояниеОтменыЗаказа() Экспорт

	Возврат Справочники.СостоянияЗаказовПокупателей.Завершен;


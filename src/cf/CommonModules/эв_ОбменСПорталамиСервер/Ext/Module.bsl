	Пароль = ЗначениеСвойства(ПараметрыЗапроса, "ПарольДляМаскировки", "");
	Если ЗначениеЗаполнено(Пароль) Тогда
		РезультатАдрес = СтрЗаменить(РезультатАдрес, Пароль, "***");
		Попытка
			РезультатАдрес = СтрЗаменить(РезультатАдрес, КодироватьСтроку(Пароль, СпособКодированияСтроки.КодировкаURL), "***");
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат РезультатАдрес;


		РезультатТекст = СтрЗаменить(РезультатТекст, ПарольФТП, "***");
		Попытка
			РезультатТекст = СтрЗаменить(РезультатТекст, КодироватьСтроку(ПарольФТП, СпособКодированияСтроки.КодировкаURL), "***");
		Исключение
		КонецПопытки;

	СтрокаИд = СокрЛП(Строка(ИдПозиции));
	Попытка
		УникальныйИд = Новый УникальныйИдентификатор(СтрокаИд);
		СсылкаНоменклатуры = Справочники.Номенклатура.ПолучитьСсылку(УникальныйИд);
		Если ОбщегоНазначения.СсылкаСуществует(СсылкаНоменклатуры) Тогда
			Возврат СсылкаНоменклатуры;
		КонецЕсли;
	Исключение
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;

	Возврат Справочники.Номенклатура.ПустаяСсылка();


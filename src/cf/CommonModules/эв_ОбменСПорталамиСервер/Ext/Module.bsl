Процедура ЗаписатьОшибкуОчередиУстановкиСтатуса(ЗаказПокупателя, СтатусЗаказа, КоличествоПопыток, ТекстОшибки)

	НачатьТранзакцию();
	Попытка
		МенеджерЗаписи = РегистрыСведений.эв_ОчередьУстановккиСтатусовЗаказов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
		МенеджерЗаписи.СтатусЗаказа = СтатусЗаказа;
		МенеджерЗаписи.СтатусОтправки = Перечисления.эв_ВидыСтатусовОчередиЗаказов.Ошибка;
		МенеджерЗаписи.КоличествоПопыток = КоличествоПопыток;
		МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
		МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
		МенеджерЗаписи.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибкуОбмена(ЗаказПокупателя, "Установка статуса заказа", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ТекущийСтатусЗаказа(ЗаказПокупателя) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат Справочники.СостоянияЗаказовПокупателей.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.СтатусЗаказа КАК СтатусЗаказа
		|ИЗ
		|	РегистрСведений.эв_ОчередьОтправкиСтатусовЗаказов КАК Очередь
		|ГДЕ
		|	Очередь.ЗаказПокупателя = &ЗаказПокупателя
		|	И Очередь.СтатусЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтатусЗаказа;
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	История.СтатусЗаказа КАК СтатусЗаказа
		|ИЗ
		|	РегистрСведений.эв_ИсторияСтатусовЗаказов.СрезПоследних(, ЗаказПокупателя = &ЗаказПокупателя) КАК История";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтатусЗаказа;
	КонецЕсли;

	Возврат Справочники.СостоянияЗаказовПокупателей.ПустаяСсылка();

КонецФункции


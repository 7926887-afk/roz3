
#Область ПрограммныйИнтерфейс

Процедура ВыполнитьИнкрементальныйОбмен() Экспорт

	Если Не Константы.эв_ОбменСПорталамиВключен.Получить() Тогда
		Возврат;
	КонецЕсли;

	Источники = АктивныеИсточникиЗаказов();
	Для Каждого Источник Из Источники Цикл

		НастройкиAPI = НастройкиAPIИсточника(Источник);
		ИмяМодуля = ИмяМодуляОбмена(НастройкиAPI);
		Если Не ЗначениеЗаполнено(ИмяМодуля) Тогда
			Продолжить;
		КонецЕсли;
        
		Попытка
			ВыполнитьЗагрузкуЗаказовИсточника(Источник, НастройкиAPI, ИмяМодуля);
		Исключение
			ЗаписатьОшибкуОбмена(Источник, "Загрузка заказов", ОписаниеОшибки());
		КонецПопытки;
        
		Попытка
			//ВыполнитьВыгрузкуОстатковИсточника(Источник, НастройкиAPI, ИмяМодуля, Ложь);
		Исключение
			ЗаписатьОшибкуОбмена(Источник, "Инкрементальная выгрузка остатков", ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры


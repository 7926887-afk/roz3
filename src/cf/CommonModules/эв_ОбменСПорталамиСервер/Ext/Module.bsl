Функция ДатаISOСмещением(ДатаЗначение) Экспорт

	ЛокальнаяДата = ДатаЗначение;
	УниверсальнаяДата = УниверсальноеВремя(ЛокальнаяДата);
	СмещениеСекунд = ЛокальнаяДата - УниверсальнаяДата;
	ЗнакСмещения = ?(СмещениеСекунд >= 0, "+", "-");
	АбсСмещение = Макс(СмещениеСекунд, -СмещениеСекунд);
	ЧасыСмещения = Цел(АбсСмещение / 3600);
	МинутыСмещения = Цел((АбсСмещение - ЧасыСмещения * 3600) / 60);

	Возврат Формат(ЛокальнаяДата, "ДФ=yyyy-MM-ddTHH:mm:ss")
		+ ЗнакСмещения
		+ Формат(ЧасыСмещения, "ЧЦ=2; ЧВН=; ЧН=00; ЧГ=")
		+ ":"
		+ Формат(МинутыСмещения, "ЧЦ=2; ЧВН=; ЧН=00; ЧГ=");


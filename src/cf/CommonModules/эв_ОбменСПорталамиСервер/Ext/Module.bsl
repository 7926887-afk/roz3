Функция ПричинаОтменыЗавершения(ВидСтатуса, ЗаказПокупателя)

	Если ВидСтатуса <> Справочники.СостоянияЗаказовПокупателей.Завершен
		Или Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат Справочники.ПричиныОтменыЗаказа.ПустаяСсылка();
	КонецЕсли;

	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗаказПокупателя, "ВариантЗавершения, ПричинаОтмены");
	Если РеквизитыЗаказа.ВариантЗавершения <> Перечисления.ВариантыЗавершенияЗаказа.Отменен Тогда
		Возврат Справочники.ПричиныОтменыЗаказа.ПустаяСсылка();
	КонецЕсли;

	Возврат РеквизитыЗаказа.ПричинаОтмены;


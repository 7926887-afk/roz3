Функция ИмяМодуляОбмена(НастройкиAPI)

	Портал = Неопределено;
	НастройкиAPI.Свойство("Портал", Портал);
	Если ЗначениеЗаполнено(Портал) Тогда
		Если Портал = Перечисления.эв_ВидыИсточниковЗаказа.АптекаМос
			И эв_ОбменСПорталамиАптекаМос.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
			Возврат "АптекаМос";
		ИначеЕсли Портал = Перечисления.эв_ВидыИсточниковЗаказа.Асна
			И эв_ОбменСПорталамиАсна.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
			Возврат "Асна";
		ИначеЕсли Портал = Перечисления.эв_ВидыИсточниковЗаказа.МегаАптека
			И эв_ОбменСПорталамиМегааптека.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
			Возврат "Мегааптека";
		ИначеЕсли Портал = Перечисления.эв_ВидыИсточниковЗаказа.Ютека
			И эв_ОбменСПорталамиЮтека.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
			Возврат "Ютека";
		ИначеЕсли Портал = Перечисления.эв_ВидыИсточниковЗаказа.Эвалар
			И эв_ОбменСПорталамиЭвалар.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
			Возврат "Эвалар";
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если эв_ОбменСПорталамиАптекаМос.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Возврат "АптекаМос";
	КонецЕсли;
	Если эв_ОбменСПорталамиМегааптека.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Возврат "Мегааптека";
	КонецЕсли;
	Если эв_ОбменСПорталамиЮтека.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Возврат "Ютека";
	КонецЕсли;
	Если эв_ОбменСПорталамиАсна.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Возврат "Асна";
	КонецЕсли;
	Если эв_ОбменСПорталамиЭвалар.ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Возврат "Эвалар";
	КонецЕсли;

	Возврат "";

КонецФункции


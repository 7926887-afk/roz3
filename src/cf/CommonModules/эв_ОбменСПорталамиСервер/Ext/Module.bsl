Функция СформироватьКаталогДБФАСНА(АдресХранилища) Экспорт

	Источники = АктивныеИсточникиПортала(Перечисления.эв_ВидыИсточниковЗаказа.Асна, Ложь);
	ЕстьСклад = Ложь;

	Для Каждого Источник Из Источники Цикл

		НастройкиAPI = НастройкиAPIИсточника(Источник);
		Если Не ЗначениеЗаполнено(НастройкиAPI.Склад) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьСклад = Истина;
		Если ПустаяСтрока(СокрЛП(НастройкиAPI.ЛогинФТП))
			Или ПустаяСтрока(СокрЛП(НастройкиAPI.ПарольФТП))
			Или ПустаяСтрока(СокрЛП(НастройкиAPI.АдресФТП)) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗаписатьКаталогДБФВХранилище(НастройкиAPI.Склад, АдресХранилища) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ПараметрыФТП = Новый Структура;
		ПараметрыФТП.Вставить("ЛогинФТП", СокрЛП(НастройкиAPI.ЛогинФТП));
		ПараметрыФТП.Вставить("ПарольФТП", СокрЛП(НастройкиAPI.ПарольФТП));
		ПараметрыФТП.Вставить("АдресФТП", СокрЛП(НастройкиAPI.АдресФТП));
		Возврат ПараметрыФТП;

	КонецЦикла;

	Если ЕстьСклад Тогда
		ОбщегоНазначения.СообщитьПользователю("Настройки API не указаны!");
		Возврат Неопределено;
	КонецЕсли;

	Возврат "";

КонецФункции


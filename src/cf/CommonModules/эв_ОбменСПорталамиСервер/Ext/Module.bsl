Функция ДатаОкончанияРезерваИсточника(Источник)

	СрокХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "СрокХраненияРезерва");
	Если Не ЗначениеЗаполнено(СрокХранения) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Возврат КонецДня(ТекущаяДатаСеанса() + СрокХранения * 86400);

КонецФункции

Процедура ПоставитьЗаказВОчередьУстановкиСтатуса(ЗаказПокупателя, СтатусЗаказа)

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Или Не ЗначениеЗаполнено(СтатусЗаказа) Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.эв_ОчередьУстановккиСтатусовЗаказов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
	МенеджерЗаписи.СтатусЗаказа = СтатусЗаказа;
	МенеджерЗаписи.СтатусОтправки = Перечисления.эв_ВидыСтатусовОчередиЗаказов.КПередаче;
	МенеджерЗаписи.КоличествоПопыток = 0;
	МенеджерЗаписи.ТекстОшибки = "";
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();

КонецПроцедуры

Процедура УстановитьСтатусЗаказаИзОчереди(ЗаказПокупателя, СтатусЗаказа, КоличествоПопыток)

	НачатьТранзакцию();
	Попытка
		УстановитьСостояниеЗаказа(ЗаказПокупателя, СтатусЗаказа);
		УдалитьЗаписьОчередиУстановкиСтатуса(ЗаказПокупателя);
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
		ЗаписатьОшибкуОчередиУстановкиСтатуса(ЗаказПокупателя, СтатусЗаказа, КоличествоПопыток + 1, ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

Процедура УстановитьСостояниеЗаказа(ЗаказПокупателя, СтатусЗаказа)

	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗаказПокупателя, "СостояниеЗаказа, ВариантЗавершения, Проведен, ПометкаУдаления");

	Если РеквизитыЗаказа.ПометкаУдаления Тогда
		ВызватьИсключение НСтр("ru = 'Заказ помечен на удаление.'");
	КонецЕсли;

	ВариантВыполнен = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
	Если ПереходКСтатусуВыполненЗапрещен(ЗаказПокупателя, СтатусЗаказа, ВариантВыполнен) Тогда
		Возврат;
	КонецЕсли;

	Если РеквизитыЗаказа.СостояниеЗаказа = СтатусЗаказа
		И РеквизитыЗаказа.ВариантЗавершения = ВариантВыполнен Тогда
		Возврат;
	КонецЕсли;

	ЗаказОбъект = ЗаказПокупателя.ПолучитьОбъект();
	ЗаказОбъект.СостояниеЗаказа = СтатусЗаказа;
	Если СтатусЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
		ЗаказОбъект.ВариантЗавершения = ВариантВыполнен;
	КонецЕсли;

	Если РеквизитыЗаказа.Проведен Тогда
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьЗаписьОчередиУстановкиСтатуса(ЗаказПокупателя) Экспорт


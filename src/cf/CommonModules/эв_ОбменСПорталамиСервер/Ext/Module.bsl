Функция СоздатьЗаказПортала(Источник, НастройкиAPI, ДанныеЗаказа) Экспорт

	ДокументОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
	ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ДанныеЗаказа.Дата), ДанныеЗаказа.Дата, ТекущаяДатаСеанса());
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
	ДокументОбъект.ВидЗаказа = НастройкиAPI.Вид;
	ДокументОбъект.СостояниеЗаказа = СостояниеНовыйЗаказа(НастройкиAPI.Вид);
	ДокументОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиAPI.Склад, "Организация");
	ДокументОбъект.СтруктурнаяЕдиницаРезерв = НастройкиAPI.Склад;
	ДокументОбъект.ВидЦен = НастройкиAPI.ВидЦен;
	ДокументОбъект.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	ДокументОбъект.Курс = 1;
	ДокументОбъект.Кратность = 1;
	ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
	ДокументОбъект.СуммаВключаетНДС = Истина;
	ДокументОбъект.Комментарий = ДанныеЗаказа.Комментарий;
	ДокументОбъект.Телефон = ДанныеЗаказа.Телефон;
	ДокументОбъект.АдресЭП = ДанныеЗаказа.Почта;

	ДокументОбъект.Контрагент = НайтиИлиСоздатьКонтрагентаПортала(ДанныеЗаказа);
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		ДокументОбъект.Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(ДокументОбъект.Контрагент);
	КонецЕсли;

	Для Каждого СтрокаТовара Из ДанныеЗаказа.Товары Цикл

		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаЗапасы = ДокументОбъект.Запасы.Добавить();
		СтрокаЗапасы.Номенклатура = СтрокаТовара.Номенклатура;
		СтрокаЗапасы.Характеристика = СтрокаТовара.Характеристика;
		СтрокаЗапасы.Количество = СтрокаТовара.Количество;
		СтрокаЗапасы.Цена = СтрокаТовара.Цена;
		СтрокаЗапасы.Сумма = СтрокаЗапасы.Количество * СтрокаЗапасы.Цена;
		СтрокаЗапасы.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовара.Номенклатура, "ЕдиницаИзмерения");
		СтрокаЗапасы.СтруктурнаяЕдиницаРезерв = НастройкиAPI.Склад;
		СтрокаЗапасы.Резерв = СтрокаЗапасы.Количество;
		СтрокаЗапасы.эв_ИдентификаторПозицииПортала = СтрокаТовара.ИдПозиции;

		ВидСтавкиНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовара.Номенклатура, "ВидСтавкиНДС");
		СтрокаЗапасы.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(ВидСтавкиНДС, ДокументОбъект.Дата);
		ЗаполнитьСуммыНДССтроки(СтрокаЗапасы, ДокументОбъект.СуммаВключаетНДС);

	КонецЦикла;

	ДокументОбъект.СуммаДокумента = ДокументОбъект.Запасы.Итог("Всего");
	Если ДокументОбъект.СуммаДокумента = 0 Тогда
		ДокументОбъект.СуммаДокумента = ДокументОбъект.Запасы.Итог("Сумма");
	КонецЕсли;

	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();

	ЗаписатьЗаказПокупателяССайта(ДокументОбъект.Ссылка, ДанныеЗаказа);

	ДокументОбъект.ОбменДанными.Загрузка = Ложь;
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписатьОшибкуОбмена(Источник, "Проведение заказа " + ДанныеЗаказа.НомерНаСайте, ОписаниеОшибки());
	КонецПопытки;

	Возврат ДокументОбъект.Ссылка;

КонецФункции

Процедура ПоставитьЗаказВОчередьСтатусов(ЗаказПокупателя, Источник, СтатусЗаказа, ДатаОкончанияРезерва = Неопределено, ПроверятьОчередность = Истина) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Или Не ЗначениеЗаполнено(СтатусЗаказа) Тогда
		Возврат;
	КонецЕсли;

	Если ПроверятьОчередность И Не ОчередностьСтатусовКорректна(ЗаказПокупателя, Источник, СтатусЗаказа) Тогда
		Возврат;
	КонецЕсли;

	ДатаРезерва = ДатаОкончанияРезерва;
	Если ДатаРезерва = Неопределено Тогда
		ДатаРезерва = ДатаОкончанияРезерваИсточника(Источник);
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.эв_ОчередьОтправкиСтатусовЗаказов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
	МенеджерЗаписи.ИсточникЗаказов = Источник;
	МенеджерЗаписи.СтатусЗаказа = СтатусЗаказа;
	МенеджерЗаписи.СтатусОтправки = Перечисления.эв_ВидыСтатусовОчередиЗаказов.КПередаче;
	МенеджерЗаписи.КоличествоПопыток = 0;
	МенеджерЗаписи.ТекстОшибки = "";
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДатаОкончанияРезерва = ДатаРезерва;
	МенеджерЗаписи.Записать();

КонецПроцедуры

Процедура ОбновитьСнимокОстатков(Источник, ТаблицаОстатков, ПолнаяВыгрузка) Экспорт

	ДатаОбновления = ТекущаяДатаСеанса();

	Если ПолнаяВыгрузка Тогда
		Набор = РегистрыСведений.эв_ВыгруженныеОстаткиПорталов.СоздатьНаборЗаписей();
		Набор.Отбор.ИсточникЗаказов.Установить(Источник);
		Набор.Записать();
	КонецЕсли;

	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл

		МенеджерЗаписи = РегистрыСведений.эв_ВыгруженныеОстаткиПорталов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИсточникЗаказов = Источник;
		МенеджерЗаписи.Номенклатура = СтрокаОстатка.Номенклатура;
		МенеджерЗаписи.Характеристика = СтрокаОстатка.Характеристика;

		Если СтрокаОстатка.ДоступныйОстаток <= 0 Тогда
			МенеджерЗаписи.Удалить();
			Продолжить;
		КонецЕсли;

		МенеджерЗаписи.Цена = СтрокаОстатка.Цена;
		МенеджерЗаписи.ДоступныйОстаток = СтрокаОстатка.ДоступныйОстаток;
		МенеджерЗаписи.ДатаОбновления = ДатаОбновления;
		МенеджерЗаписи.Записать();

	КонецЦикла;


Процедура ВыполнитьОбработкуОчередиУстановкиСтатусов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.ЗаказПокупателя КАК ЗаказПокупателя,
		|	Очередь.СтатусЗаказа КАК СтатусЗаказа,
		|	Очередь.КоличествоПопыток КАК КоличествоПопыток
		|ИЗ
		|	РегистрСведений.эв_ОчередьУстановккиСтатусовЗаказов КАК Очередь
		|ГДЕ
		|	Очередь.СтатусОтправки В (ЗНАЧЕНИЕ(Перечисление.эв_ВидыСтатусовОчередиЗаказов.КПередаче), ЗНАЧЕНИЕ(Перечисление.эв_ВидыСтатусовОчередиЗаказов.Ошибка))
		|	И Очередь.КоличествоПопыток < 20";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УстановитьСтатусЗаказаИзОчереди(Выборка.ЗаказПокупателя, Выборка.СтатусЗаказа, Выборка.КоличествоПопыток);
	КонецЦикла;

КонецПроцедуры

Функция ПереходКСтатусуВыполненЗапрещен(ЗаказПокупателя, НовыйСтатус, НовыйВариантЗавершения = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Или Не ЗначениеЗаполнено(НовыйСтатус) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НовыйВариантЗавершения = Неопределено Тогда
		НовыйВариантЗавершения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказПокупателя, "ВариантЗавершения");
	КонецЕсли;

	Если Не ЭтоСтатусВыполнен(НовыйСтатус, НовыйВариантЗавершения) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЭтоСтатусОтмененЗаказа(ЗаказПокупателя);

КонецФункции

Функция ТоварКатегорииСерийный(Номенклатура, КэшКатегорийМДЛП) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	Признак = КэшКатегорийМДЛП.Получить(Номенклатура);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;

	Категория = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КатегорияНоменклатуры");
	УчетМаркируемыхТоваров = Ложь;
	Если ЗначениеЗаполнено(Категория) Тогда
		УчетМаркируемыхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Категория, "ор_УчетМаркируемыхТоваров");
	КонецЕсли;
	Признак = УчетМаркируемыхТоваров = Истина;
	КэшКатегорийМДЛП.Вставить(Номенклатура, Признак);
	Возврат Признак;

КонецФункции

Функция КэшКатегорийМаркированныхТоваров() Экспорт

	КэшКатегорийИСМП = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОписаниеНоменклатурыИС.Номенклатура КАК Категория
		|ИЗ
		|	РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ОписаниеНоменклатурыИС.Номенклатура) = ТИП(Справочник.КатегорииНоменклатуры)
		|	И НЕ ОписаниеНоменклатурыИС.КлючВидовПродукции = &ПустойКлючВидовПродукции";
	Запрос.УстановитьПараметр("ПустойКлючВидовПродукции", Справочники.КлючиВидовПродукцииИС.ПустаяСсылка());

	ВыборкаКатегории = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКатегории.Следующий() Цикл
		КэшКатегорийИСМП.Вставить(ВыборкаКатегории.Категория, Истина);
	КонецЦикла;

	Возврат КэшКатегорийИСМП;

КонецФункции

Функция ТоварКатегорииМаркированный(Номенклатура, КэшКатегорийИСМП) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	Категория = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КатегорияНоменклатуры");
	Если ЗначениеЗаполнено(Категория) Тогда
		Признак = КэшКатегорийИСМП.Получить(Категория);
		Если Признак = Неопределено Тогда
			Признак = Ложь;
		КонецЕсли;
		Возврат Признак;
	КонецЕсли;

	Возврат Ложь;


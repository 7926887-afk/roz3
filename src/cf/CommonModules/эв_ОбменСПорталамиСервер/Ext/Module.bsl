Функция ПорталВидаЗаказа(Вид)

	Если Не ЗначениеЗаполнено(Вид) Тогда
		Возврат Перечисления.эв_ВидыИсточниковЗаказа.ПустаяСсылка();
	КонецЕсли;

	Портал = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Вид, "Портал");
	Если Не ЗначениеЗаполнено(Портал) Тогда
		Возврат Перечисления.эв_ВидыИсточниковЗаказа.ПустаяСсылка();
	КонецЕсли;

	Возврат Портал;


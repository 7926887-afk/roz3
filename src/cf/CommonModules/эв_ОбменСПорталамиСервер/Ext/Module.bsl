Функция ДатаISOСмещением(ДатаЗначение) Экспорт

	ЛокальнаяДата = ДатаЗначение;
	УниверсальнаяДата = УниверсальноеВремя(ЛокальнаяДата);
	СмещениеСекунд = ЛокальнаяДата - УниверсальнаяДата;
	ЗнакСмещения = ?(СмещениеСекунд >= 0, "+", "-");
	АбсСмещение = Макс(СмещениеСекунд, -СмещениеСекунд);
	ЧасыСмещения = Цел(АбсСмещение / 3600);
	МинутыСмещения = Цел((АбсСмещение - ЧасыСмещения * 3600) / 60);

	Возврат Формат(ЛокальнаяДата, "ДФ=yyyy-MM-ddTHH:mm:ss")
		+ ЗнакСмещения
		+ Формат(ЧасыСмещения, "ЧЦ=2; ЧВН=; ЧН=00; ЧГ=")
		+ ":"
		+ Формат(МинутыСмещения, "ЧЦ=2; ЧВН=; ЧН=00; ЧГ=");

КонецФункции

Функция НоменклатураПоИдентификаторуПортала(ИдПозиции) Экспорт

	Если Не ЗначениеЗаполнено(ИдПозиции) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	СтрокаИд = СокрЛП(Строка(ИдПозиции));
	Попытка
		УникальныйИд = Новый УникальныйИдентификатор(СтрокаИд);
		СсылкаНоменклатуры = Справочники.Номенклатура.ПолучитьСсылку(УникальныйИд);
		Если ОбщегоНазначения.СсылкаСуществует(СсылкаНоменклатуры) Тогда
			Возврат СсылкаНоменклатуры;
		КонецЕсли;
	Исключение
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;

	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

Функция ПолучитьПараметрыПодключенияКПорталу(Вид, Активный) Экспорт

	НастройкиВыгрузки = Новый Массив;
	Если Не ЗначениеЗаполнено(Вид) Тогда
		Возврат НастройкиВыгрузки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Источники.Ссылка КАК ИсточникЗаказов,
		|	ЕСТЬNULL(Настройки.Адрес, """") КАК Адрес,
		|	ЕСТЬNULL(Настройки.auth_token, """") КАК auth_token,
		|	ЕСТЬNULL(Настройки.merchant, """") КАК merchant,
		|	ЕСТЬNULL(Настройки.ЛогинФТП, """") КАК ЛогинФТП,
		|	ЕСТЬNULL(Настройки.ПарольФТП, """") КАК ПарольФТП,
		|	ЕСТЬNULL(Настройки.АдресФТП, """") КАК АдресФТП
		|ИЗ
		|	Справочник.эв_ИсточникиЗаказов КАК Источники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.эв_НастройкиAPIИсточникаЗаказов КАК Настройки
		|		ПО Источники.Ссылка = Настройки.ИсточникЗаказов
		|ГДЕ
		|	Источники.Вид = &Вид
		|	И Источники.Активный = &Активный
		|	И НЕ Источники.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Источники.Код";
	Запрос.УстановитьПараметр("Вид", Вид);
	Запрос.УстановитьПараметр("Активный", Активный);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Настройка = Новый Структура;
		Настройка.Вставить("ИсточникЗаказов", Выборка.ИсточникЗаказов);
		Настройка.Вставить("Адрес", СокрЛП(Выборка.Адрес));
		Настройка.Вставить("auth_token", СокрЛП(Выборка.auth_token));
		Настройка.Вставить("merchant", СокрЛП(Выборка.merchant));
		Настройка.Вставить("ЛогинФТП", СокрЛП(Выборка.ЛогинФТП));
		Настройка.Вставить("ПарольФТП", СокрЛП(Выборка.ПарольФТП));
		Настройка.Вставить("АдресФТП", СокрЛП(Выборка.АдресФТП));
		НастройкиВыгрузки.Добавить(Настройка);
	КонецЦикла;

	Возврат НастройкиВыгрузки;

КонецФункции

Функция ОтправитьАптекуВСервис(ДанныеАптеки, Удалить) Экспорт

	РезультатКоманды = Новый Структура("УстановитьАктивный, Активный", Ложь, Ложь);
	Если ТипЗнч(ДанныеАптеки) <> Тип("Структура") Тогда
		Возврат РезультатКоманды;
	КонецЕсли;

	Портал = ПорталВидаЗаказа(ЗначениеСвойства(ДанныеАптеки, "Вид"));
	ЭтоМегаАптека = Портал = Перечисления.эв_ВидыИсточниковЗаказа.МегаАптека;
	ЭтоЮтека = Портал = Перечисления.эв_ВидыИсточниковЗаказа.Ютека;
	Если Не ЭтоМегаАптека И Не ЭтоЮтека Тогда
		Возврат РезультатКоманды;
	КонецЕсли;

	Пакет = ПакетАптеки(ДанныеАптеки, Удалить);
	Если Пакет.list.Количество() = 0 Тогда
		Возврат РезультатКоманды;
	КонецЕсли;

	НастройкиВыгрузки = ПолучитьПараметрыПодключенияКПорталу(
		ЗначениеСвойства(ДанныеАптеки, "Вид"),
		ЗначениеСвойства(ДанныеАптеки, "Активный", Ложь));

	Для Каждого Источник Из НастройкиВыгрузки Цикл

		Если ПустаяСтрока(Источник.Адрес) Или ПустаяСтрока(Источник.auth_token) Или ПустаяСтрока(Источник.merchant) Тогда
			ОбщегоНазначения.СообщитьПользователю("Настройки API не указаны!");
			Продолжить;
		КонецЕсли;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		Если ЭтоМегаАптека Тогда
			Заголовки.Вставить("merchant-code", Источник.merchant);
			Заголовки.Вставить("auth-token", Источник.auth_token);
			Метод = "POST";
			АдресЗапроса = БазовыйАдресAPI(Источник) + "/stores";
		Иначе
			Заголовки.Вставить("auth_token", Источник.auth_token);
			Метод = "PUT";
			АдресЗапроса = БазовыйАдресAPI(Источник) + "/stores?mc="
				+ КодироватьСтроку(Источник.merchant, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("ИсточникЗаказов", Источник.ИсточникЗаказов);
		ПараметрыЗапроса.Вставить("Метод", Метод);
		ПараметрыЗапроса.Вставить("Адрес", АдресЗапроса);
		ПараметрыЗапроса.Вставить("Контур", "stores");
		ПараметрыЗапроса.Вставить("Заголовки", Заголовки);
		ПараметрыЗапроса.Вставить("Тело", Пакет);

		РезультатHTTP = Неопределено;
		Попытка
			РезультатHTTP = ВыполнитьЗапросHTTP(ПараметрыЗапроса);
		Исключение
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки аптеки в %1", Источник.Адрес),
				УровеньЖурналаРегистрации.Ошибка, , Источник.ИсточникЗаказов, ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если РезультатHTTP = Неопределено Или РезультатHTTP.КодСостояния = 0 Тогда
			ТекстОшибки = ?(РезультатHTTP = Неопределено, "Нет ответа", РезультатHTTP.ТекстОшибки);
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки аптеки в %1", Источник.Адрес),
				УровеньЖурналаРегистрации.Ошибка, , Источник.ИсточникЗаказов, ТекстОшибки);
			Продолжить;
		КонецЕсли;

		ТекстСообщения = ТекстСообщенияОтвета(РезультатHTTP);
		Если РезультатHTTP.КодСостояния = 200 Тогда
			ОбщегоНазначения.СообщитьПользователю("Данные в сервисе актуализированы!");
			РезультатКоманды.УстановитьАктивный = Истина;
			РезультатКоманды.Активный = Истина;
		Иначе
			РезультатКоманды.УстановитьАктивный = Истина;
			РезультатКоманды.Активный = Ложь;
			ТекстЖурнала = ?(ЗначениеЗаполнено(ТекстСообщения), ТекстСообщения, РезультатHTTP.ТекстОшибки);
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки аптеки в %1", Источник.Адрес),
				УровеньЖурналаРегистрации.Ошибка, , Источник.ИсточникЗаказов, ТекстЖурнала);
		КонецЕсли;

		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Если ЭтоЮтека Тогда
				Возврат РезультатКоманды;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат РезультатКоманды;

КонецФункции

Процедура ПроверитьСтатусАптеки(ДанныеАптеки) Экспорт

	Если ТипЗнч(ДанныеАптеки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Портал = ПорталВидаЗаказа(ЗначениеСвойства(ДанныеАптеки, "Вид"));
	Если Портал <> Перечисления.эв_ВидыИсточниковЗаказа.МегаАптека 
		И Портал <> Перечисления.эв_ВидыИсточниковЗаказа.Ютека Тогда
		Возврат;
	КонецЕсли;

	НастройкиВыгрузки = ПолучитьПараметрыПодключенияКПорталу(
		ЗначениеСвойства(ДанныеАптеки, "Вид"),
		ЗначениеСвойства(ДанныеАптеки, "Активный", Ложь));

	Для Каждого Источник Из НастройкиВыгрузки Цикл

		Если ПустаяСтрока(Источник.Адрес) Или ПустаяСтрока(Источник.auth_token) Или ПустаяСтрока(Источник.merchant) Тогда
			ОбщегоНазначения.СообщитьПользователю("Настройки API не указаны!");
			Продолжить;
		КонецЕсли;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		Заголовки.Вставить("merchant-code", Источник.merchant);
		Заголовки.Вставить("auth-token", Источник.auth_token);

		ПараметрыURL = Новый Структура;
		ПараметрыURL.Вставить("store_id", XMLСтрока(ЗначениеСвойства(ДанныеАптеки, "Склад")));

		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("ИсточникЗаказов", Источник.ИсточникЗаказов);
		ПараметрыЗапроса.Вставить("Метод", "GET");
		ПараметрыЗапроса.Вставить("Адрес", БазовыйАдресAPI(Источник) + "/stores");
		ПараметрыЗапроса.Вставить("Контур", "stores");
		ПараметрыЗапроса.Вставить("Заголовки", Заголовки);
		ПараметрыЗапроса.Вставить("ПараметрыURL", ПараметрыURL);

		РезультатHTTP = Неопределено;
		Попытка
			РезультатHTTP = ВыполнитьЗапросHTTP(ПараметрыЗапроса);
		Исключение
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка получения статуса аптеки в %1", Источник.Адрес),
				УровеньЖурналаРегистрации.Ошибка, , Источник.ИсточникЗаказов, ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если РезультатHTTP = Неопределено Или РезультатHTTP.КодСостояния = 0 Тогда
			ТекстОшибки = ?(РезультатHTTP = Неопределено, "Нет ответа", РезультатHTTP.ТекстОшибки);
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка получения статуса аптеки в %1", Источник.Адрес),
				УровеньЖурналаРегистрации.Ошибка, , Источник.ИсточникЗаказов, ТекстОшибки);
			Продолжить;
		КонецЕсли;

		Если РезультатHTTP.КодСостояния = 200 Тогда
			СообщитьСписокСтатусаАптеки(РезультатHTTP);
		Иначе
			ТекстСообщения = ТекстСообщенияОтвета(РезультатHTTP);
			ТекстЖурнала = ?(ЗначениеЗаполнено(ТекстСообщения), ТекстСообщения, РезультатHTTP.ТекстОшибки);
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка получения статуса аптеки в %1", Источник.Адрес),
				УровеньЖурналаРегистрации.Ошибка, , Источник.ИсточникЗаказов, ТекстЖурнала);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьСвязкиАСНА() Экспорт

	Источники = АктивныеИсточникиПортала(Перечисления.эв_ВидыИсточниковЗаказа.Асна, Ложь);

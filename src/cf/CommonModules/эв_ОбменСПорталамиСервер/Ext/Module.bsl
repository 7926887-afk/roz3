	Если Не Константы.эв_ОбменСПорталамиВключен.Получить() Тогда
		Возврат;
	КонецЕсли;

	Источники = АктивныеИсточникиЗаказов();
	Для Каждого Источник Из Источники Цикл

		НастройкиAPI = НастройкиAPIИсточника(Источник);
		ИмяМодуля = ИмяМодуляОбмена(НастройкиAPI);
		Если Не ЗначениеЗаполнено(ИмяМодуля) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ВыполнитьВыгрузкуОстатковИсточника(Источник, НастройкиAPI, ИмяМодуля, Истина);
		Исключение
			ЗаписатьОшибкуОбмена(Источник, "Полная выгрузка остатков", ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ВыполнитьОбработкуОчередиСтатусов() Экспорт

	Если Не Константы.эв_ОбменСПорталамиВключен.Получить() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.ЗаказПокупателя КАК ЗаказПокупателя,
		|	Очередь.ИсточникЗаказов КАК ИсточникЗаказов,
		|	Очередь.СтатусЗаказа КАК СтатусЗаказа,
		|	Очередь.СтатусОтправки КАК СтатусОтправки,
		|	Очередь.КоличествоПопыток КАК КоличествоПопыток,
		|	Очередь.ТекстОшибки КАК ТекстОшибки,
		|	Очередь.Дата КАК Дата,
		|	Очередь.ДатаОкончанияРезерва КАК ДатаОкончанияРезерва
		|ИЗ
		|	РегистрСведений.эв_ОчередьОтправкиСтатусовЗаказов КАК Очередь
		|ГДЕ
		|	Очередь.СтатусОтправки В (ЗНАЧЕНИЕ(Перечисление.эв_ВидыСтатусовОчередиЗаказов.КПередаче), ЗНАЧЕНИЕ(Перечисление.эв_ВидыСтатусовОчередиЗаказов.Ошибка))
		|	И Очередь.КоличествоПопыток < 20";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НастройкиAPI = НастройкиAPIИсточника(Выборка.ИсточникЗаказов);
		ИмяМодуля = ИмяМодуляОбмена(НастройкиAPI);
		Если Не ЗначениеЗаполнено(ИмяМодуля) Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыОчереди = Новый Структура;
		ПараметрыОчереди.Вставить("ЗаказПокупателя", Выборка.ЗаказПокупателя);
		ПараметрыОчереди.Вставить("ИсточникЗаказов", Выборка.ИсточникЗаказов);
		ПараметрыОчереди.Вставить("СтатусЗаказа", Выборка.СтатусЗаказа);
		ПараметрыОчереди.Вставить("ДатаОкончанияРезерва", Выборка.ДатаОкончанияРезерва);
		ПараметрыОчереди.Вставить("КоличествоПопыток", Выборка.КоличествоПопыток);

		РезультатОтправки = Неопределено;
		Попытка
			РезультатОтправки = ВыполнитьОтправкуСтатусаИсточника(ПараметрыОчереди, НастройкиAPI, ИмяМодуля);
		Исключение
			РезультатОтправки = Новый Структура("Успех, ТекстОшибки", Ложь, ОписаниеОшибки());
		КонецПопытки;

		Если РезультатОтправки = Неопределено Тогда
			РезультатОтправки = Новый Структура("Успех, ТекстОшибки", Ложь, "Модуль обмена не вернул результат");
		КонецЕсли;

		Если РезультатОтправки.Успех Тогда
			УдалитьЗаписьОчередиСтатусов(Выборка.ЗаказПокупателя);
			ЗаписатьИсториюСтатуса(Выборка.ЗаказПокупателя, Выборка.СтатусЗаказа, Выборка.ДатаОкончанияРезерва);
		Иначе
			ОбновитьОшибкуОчередиСтатусов(Выборка.ЗаказПокупателя, Выборка.ИсточникЗаказов,
				Выборка.СтатусЗаказа, Выборка.ДатаОкончанияРезерва, Выборка.КоличествоПопыток + 1,
				РезультатОтправки.ТекстОшибки);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура СнятьПросроченныеРезервы() Экспорт

	Если Не Константы.эв_ОбменСПорталамиВключен.Получить() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	История.ЗаказПокупателя КАК ЗаказПокупателя,
		|	История.СтатусЗаказа КАК СтатусЗаказа,
		|	История.ДатаОкончанияРезерва КАК ДатаОкончанияРезерва
		|ПОМЕСТИТЬ ВТ_Кандидаты
		|ИЗ
		|	РегистрСведений.эв_ИсторияСтатусовЗаказов.СрезПоследних КАК История
		|ГДЕ
		|	История.ДатаОкончанияРезерва > ДАТАВРЕМЯ(1, 1, 1)
		|	И История.ДатаОкончанияРезерва < &ТекущаяДата
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Очередь.ЗаказПокупателя,
		|	Очередь.СтатусЗаказа,
		|	Очередь.ДатаОкончанияРезерва
		|ИЗ
		|	РегистрСведений.эв_ОчередьОтправкиСтатусовЗаказов КАК Очередь
		|ГДЕ
		|	Очередь.ДатаОкончанияРезерва > ДАТАВРЕМЯ(1, 1, 1)
		|	И Очередь.ДатаОкончанияРезерва < &ТекущаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Кандидаты.ЗаказПокупателя КАК ЗаказПокупателя,
		|	Источники.Ссылка КАК ИсточникЗаказов,
		|	Источники.Вид КАК ВидЗаказа
		|ИЗ
		|	ВТ_Кандидаты КАК ВТ_Кандидаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
		|		ПО ВТ_Кандидаты.ЗаказПокупателя = Заказы.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.эв_ИсточникиЗаказов КАК Источники
		|		ПО Заказы.ВидЗаказа = Источники.Вид
		|ГДЕ
		|	Источники.Активный
		|	И НЕ Источники.ПометкаУдаления
		|	И Заказы.Проведен
		|	И Заказы.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПричинаОтмены = Справочники.ПричиныОтменыЗаказа.ОтмененРезерв;

		Попытка
			эв_ОбменСПорталамиСервер.ОтменитьЗаказПортала(Выборка.ЗаказПокупателя, Выборка.ИсточникЗаказов, ПричинаОтмены, "Завершен срок хранения резерва");
		Исключение
			ЗаписатьОшибкуОбмена(Выборка.ИсточникЗаказов, "Снятие просроченного резерва", ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		СтатусОтмены = СостояниеОтменыЗаказа();
		Если ЗначениеЗаполнено(СтатусОтмены) Тогда
			ПоставитьЗаказВОчередьСтатусов(Выборка.ЗаказПокупателя, Выборка.ИсточникЗаказов, СтатусОтмены, Дата(1, 1, 1), Ложь);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ВыполнитьЗапросHTTP(ПараметрыЗапроса) Экспорт

	Результат = НовыйРезультатHTTP();
	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
		Результат.ТекстОшибки = "Не заданы параметры HTTP-запроса";
		Возврат Результат;
	КонецЕсли;

	Метод = ВРег(СокрЛП(ЗначениеСвойства(ПараметрыЗапроса, "Метод", "GET")));
	Адрес = СокрЛП(ЗначениеСвойства(ПараметрыЗапроса, "Адрес", ""));
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Результат.ТекстОшибки = "Не задан адрес HTTP-запроса";
		Возврат Результат;
	КонецЕсли;

	ДополнительныеПараметры = КоннекторHTTP.НовыеПараметры();
	Заголовки = ЗначениеСвойства(ПараметрыЗапроса, "Заголовки", Неопределено);
	Если ТипЗнч(Заголовки) = Тип("Соответствие") Тогда
		ДополнительныеПараметры.Заголовки = Заголовки;
	КонецЕсли;

	ПараметрыURL = ЗначениеСвойства(ПараметрыЗапроса, "ПараметрыURL", Неопределено);
	Если ПараметрыURL <> Неопределено Тогда
		ДополнительныеПараметры.ПараметрыЗапроса = ПараметрыURL;
	КонецЕсли;

	Таймаут = ЗначениеСвойства(ПараметрыЗапроса, "Таймаут", Неопределено);
	Если ТипЗнч(Таймаут) = Тип("Число") И Таймаут > 0 Тогда
		ДополнительныеПараметры.Таймаут = Таймаут;
	КонецЕсли;

	Тело = ЗначениеСвойства(ПараметрыЗапроса, "Тело", Неопределено);
	Данные = ЗначениеСвойства(ПараметрыЗапроса, "Данные", Неопределено);
	Если Данные <> Неопределено Тогда
		ДополнительныеПараметры.Данные = Данные;
	ИначеЕсли Тело <> Неопределено Тогда
		ДополнительныеПараметры.Json = Тело;
		Если ДополнительныеПараметры.Заголовки.Получить("Content-Type") = Неопределено Тогда
			ДополнительныеПараметры.Заголовки.Вставить("Content-Type", "application/json");
		КонецЕсли;
	КонецЕсли;

	ТелоЛога = Тело;
	Если ТелоЛога = Неопределено Тогда
		ТелоЛога = Данные;
	КонецЕсли;

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОтветHTTP = Неопределено;
	Попытка
		ОтветHTTP = КоннекторHTTP.ВызватьМетод(Метод, Адрес, ДополнительныеПараметры);
	Исключение
		Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписатьЛогHTTP(ПараметрыЗапроса, Результат, ТелоЛога);
		Возврат Результат;
	КонецПопытки;

	Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
	Если ОтветHTTP = Неопределено Тогда
		Результат.ТекстОшибки = "Пустой ответ HTTP";
		ЗаписатьЛогHTTP(ПараметрыЗапроса, Результат, ТелоЛога);
		Возврат Результат;
	КонецЕсли;

	Результат.КодСостояния = ОтветHTTP.КодСостояния;
	Результат.АдресФакт = ОтветHTTP.URL;
	Попытка
		Результат.ТекстОтвета = КоннекторHTTP.КакТекст(ОтветHTTP);
	Исключение
		Результат.ТекстОтвета = "";
	КонецПопытки;

	Если ЗначениеЗаполнено(Результат.ТекстОтвета) Тогда
		Попытка
			Результат.Json = КоннекторHTTP.КакJson(ОтветHTTP);
		Исключение
			Результат.Json = Неопределено;
		КонецПопытки;
	КонецЕсли;

	КодыУспеха = ЗначениеСвойства(ПараметрыЗапроса, "КодыУспеха", Неопределено);
	Если ТипЗнч(КодыУспеха) <> Тип("Массив") Или КодыУспеха.Количество() = 0 Тогда
		Результат.Успех = (Результат.КодСостояния = 200);
	Иначе
		Результат.Успех = КодыУспеха.Найти(Результат.КодСостояния) <> Неопределено;
	КонецЕсли;
	Если Не Результат.Успех Тогда
		Результат.ТекстОшибки = СтрШаблон("HTTP %1. %2", Формат(Результат.КодСостояния, "ЧГ="), Лев(Результат.ТекстОтвета, 1000));
	КонецЕсли;

	ЗаписатьЛогHTTP(ПараметрыЗапроса, Результат, ТелоЛога);
	Возврат Результат;

КонецФункции

Процедура ОчиститьЛогиHTTP(СтаршеДней = 0) Экспорт

	КоличествоДней = СтаршеДней;
	Если КоличествоДней <= 0 Тогда
		КоличествоДней = 30;
	КонецЕсли;

	Граница = ТекущаяДатаСеанса() - КоличествоДней * 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Логи.Период КАК Период,
		|	Логи.Идентификатор КАК Идентификатор,
		|	Логи.ИсточникЗаказов КАК ИсточникЗаказов
		|ИЗ
		|	РегистрСведений.эв_ЛогиHTTPПорталов КАК Логи
		|ГДЕ
		|	Логи.Период < &Граница";
	Запрос.УстановитьПараметр("Граница", Граница);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.эв_ЛогиHTTPПорталов.СоздатьНаборЗаписей();
		Набор.Отбор.Период.Установить(Выборка.Период);
		Набор.Отбор.Идентификатор.Установить(Выборка.Идентификатор);
		Набор.Отбор.ИсточникЗаказов.Установить(Выборка.ИсточникЗаказов);
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

Функция НастройкиAPIИсточника(Источник) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Адрес", "");
	Настройки.Вставить("auth_token", "");
	Настройки.Вставить("merchant", "");
	Настройки.Вставить("Логин", "");
	Настройки.Вставить("Пароль", "");
	Настройки.Вставить("АдресФТП", "");
	Настройки.Вставить("ЛогинФТП", "");
	Настройки.Вставить("ПарольФТП", "");
	Настройки.Вставить("Склад", Неопределено);
	Настройки.Вставить("ВидЦен", Неопределено);
	Настройки.Вставить("Вид", Неопределено);
	Настройки.Вставить("Портал", Перечисления.эв_ВидыИсточниковЗаказа.ПустаяСсылка());
	Настройки.Вставить("СрокХраненияРезерва", 0);
	Настройки.Вставить("ИсточникЗаказов", Источник);

	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат Настройки;
	КонецЕсли;

	РеквизитыИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Склад, ВидЦен, Вид, СрокХраненияРезерва");
	ЗаполнитьЗначенияСвойств(Настройки, РеквизитыИсточника);
	Если ЗначениеЗаполнено(Настройки.Вид) Тогда
		Настройки.Портал = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройки.Вид, "Портал");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Адрес КАК Адрес,
		|	Настройки.auth_token КАК auth_token,
		|	Настройки.merchant КАК merchant,
		|	Настройки.Логин КАК Логин,
		|	Настройки.Пароль КАК Пароль,
		|	Настройки.АдресФТП КАК АдресФТП,
		|	Настройки.ЛогинФТП КАК ЛогинФТП,
		|	Настройки.ПарольФТП КАК ПарольФТП
		|ИЗ
		|	РегистрСведений.эв_НастройкиAPIИсточникаЗаказов КАК Настройки
		|ГДЕ
		|	Настройки.ИсточникЗаказов = &ИсточникЗаказов";
	Запрос.УстановитьПараметр("ИсточникЗаказов", Источник);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Выборка);
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция БазовыйАдресAPI(НастройкиAPI) Экспорт

	Адрес = СокрЛП(НастройкиAPI.Адрес);
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	Если СтрНачинаетсяС(НРег(Адрес), "http://") Или СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Возврат Адрес;
	КонецЕсли;

	Возврат "https://" + Адрес;


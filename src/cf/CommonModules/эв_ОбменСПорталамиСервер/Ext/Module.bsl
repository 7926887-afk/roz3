		Возврат эв_ОбменСПорталамиМегааптека.ОтправитьСтатус(ПараметрыОчереди, НастройкиAPI);
	ИначеЕсли ИмяМодуля = "Ютека" Тогда
		Возврат эв_ОбменСПорталамиЮтека.ОтправитьСтатус(ПараметрыОчереди, НастройкиAPI);
	ИначеЕсли ИмяМодуля = "Асна" Тогда
		Возврат эв_ОбменСПорталамиАсна.ОтправитьСтатус(ПараметрыОчереди, НастройкиAPI);
	ИначеЕсли ИмяМодуля = "Эвалар" Тогда
		Возврат эв_ОбменСПорталамиЭвалар.ОтправитьСтатус(ПараметрыОчереди, НастройкиAPI);
	КонецЕсли;

	Возврат Новый Структура("Успех, ТекстОшибки", Ложь, "Не найден модуль обмена");


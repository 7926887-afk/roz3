#Область ПрограммныйИнтерфейс

// Отправляет зарегистрированный набор остатков в RabbitMQ и снимает регистрацию после подтверждения брокера.
//
// Параметры:
//  ДанныеИБ - РегистрСведенийНаборЗаписей.ОстаткиТоваров - выгружаемый набор.
//  КомпонентыОбмена - Структура - компоненты универсального обмена.
//
Процедура ВыгрузитьЗарегистрированныеОстатки(ДанныеИБ, КомпонентыОбмена) Экспорт
	
	Если ТипЗнч(ДанныеИБ) <> Тип("РегистрСведенийНаборЗаписей.ОстаткиТоваров") Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьЗарегистрированныйОбъект(ДанныеИБ, КомпонентыОбмена, ИмяОбъектаОстаткиТоваров());
	
КонецПроцедуры

// Отправляет зарегистрированный документ ставок бонусов первостольника в RabbitMQ
// с фильтром по структурной единице из ТЧ ОбъектыМетаданных справочника эв_ОчередиPinkRabbitMQ.
//
// Параметры:
//  ДанныеИБ - ДокументОбъект.эв_СтавкиБонусовПервостольника, ДокументСсылка.эв_СтавкиБонусовПервостольника - выгружаемый документ.
//  КомпонентыОбмена - Структура - компоненты универсального обмена.
//
Процедура ВыгрузитьЗарегистрированныеСтавкиБонусовПервостольника(ДанныеИБ, КомпонентыОбмена) Экспорт
	
	ДокументОбъект = ДокументСтавокБонусов(ДанныеИБ);
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьЗарегистрированныйОбъект(ДокументОбъект, КомпонентыОбмена, ИмяОбъектаСтавкиБонусовПервостольника());
	
КонецПроцедуры

// Читает очереди с признаком Загрузка и записывает сообщения по виду объекта в каждом сообщении.
// Запуск вручную на сервере: эв_ОбменЧерезБрокера.ЗагрузитьОбъекты().
//
// Параметры:
//  Очередь - СправочникСсылка.эв_ОчередиPinkRabbitMQ - очередь загрузки. Необязательный.
//
Процедура ЗагрузитьОбъекты(Очередь = Неопределено) Экспорт
	
	Результат = Новый Структура("Очередей, Прочитано, Записано, Ошибок", 0, 0, 0, 0);
	Выборка = ОчередиЗагрузки(Очередь);
	
	Пока Выборка.Следующий() Цикл
		Результат.Очередей = Результат.Очередей + 1;
		ЗагрузитьОчередь(Выборка, Результат);
	КонецЦикла;
	
	Текст = СтрШаблон(
		НСтр("ru = 'Загрузка из RabbitMQ: очередей %1, прочитано %2, записано %3, ошибок %4'"),
		Результат.Очередей,
		Результат.Прочитано,
		Результат.Записано,
		Результат.Ошибок);
	Сообщить(Текст);
	ЗаписатьСобытие(Текст, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

// Закрывает соединения с брокером, открытые при выгрузке.
Процедура ЗакрытьСоединения() Экспорт
	
	Соединения = эв_ОбменЧерезБрокераПовтИсп.Соединения();
	Для Каждого Элемент Из Соединения Цикл
		Попытка
			Элемент.Значение.ЗавершитьСоединение();
		Исключение
		КонецПопытки;
	КонецЦикла;
	Соединения.Очистить();
	
	Пропуски = эв_ОбменЧерезБрокераПовтИсп.Пропуски();
	Если Пропуски.Количество > 0 Тогда
		ЗаписатьСобытие(
			СтрШаблон(
				НСтр("ru = 'Выгрузка через брокера пропущена для %1 объектов: объект не найден в табличной части ОбъектыМетаданных либо не подошел по магазину. Регистрация в плане обмена сохранена.'"),
				Пропуски.Количество),
			УровеньЖурналаРегистрации.Предупреждение);
		Пропуски.Количество = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыгрузитьЗарегистрированныйОбъект(ДанныеИБ, КомпонентыОбмена, ИмяОбъекта)
	
	Узел = УзелОбмена(КомпонентыОбмена);
	
	Попытка
		Маршруты = МаршрутыВыгрузки(Узел, ДанныеИБ, ИмяОбъекта);
		Если Маршруты.Количество() = 0 Тогда
			УдалитьРегистрациюОбъекта(Узел, ДанныеИБ);
			Возврат;
		КонецЕсли;
		
		Ошибки = Новый Массив;
		Для Каждого Маршрут Из Маршруты Цикл
			ОтправитьМаршрут(Маршрут, ДанныеИБ, ИмяОбъекта, Ошибки);
		КонецЦикла;
		
		Если Ошибки.Количество() = 0 И Не ВсеДанныеОтправлены(ДанныеИБ, Маршруты, ИмяОбъекта) Тогда
			ЗапомнитьПропуск();
			СохранитьРегистрациюОбъекта(Узел, ДанныеИБ);
			Возврат;
		КонецЕсли;
		
		Если Ошибки.Количество() = 0 Тогда
			УдалитьРегистрациюОбъекта(Узел, ДанныеИБ);
		Иначе
			СохранитьРегистрациюОбъекта(Узел, ДанныеИБ);
			ЗаписатьСобытие(СтрСоединить(Ошибки, Символы.ПС), УровеньЖурналаРегистрации.Ошибка, МетаданныеОбъектаПоИмени(ИмяОбъекта));
		КонецЕсли;
	Исключение
		СохранитьРегистрациюОбъекта(Узел, ДанныеИБ);
		ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка, МетаданныеОбъектаПоИмени(ИмяОбъекта));
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтправитьМаршрут(Маршрут, ДанныеИБ, ИмяОбъекта, Ошибки)
	
	Компонента = СоединениеБрокера(Маршрут);
	Если Компонента = Неопределено Тогда
		Ошибки.Добавить(ТекстОшибкиМаршрута(Маршрут, НСтр("ru = 'нет соединения с RabbitMQ'")));
		Возврат;
	КонецЕсли;
	
	Компонента.ТочкаОбмена = Маршрут.ТочкаОбмена;
	ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	ИдентификаторСобытия = Строка(Новый УникальныйИдентификатор);
	РезультатОтправки = Компонента.ОтправитьСообщение(
		ТекстСообщенияОбъекта(ДанныеИБ, Маршрут.Магазин, ИмяОбъекта),
		Маршрут.КлючМаршрутизации,
		ИдентификаторСообщения,
		ИдентификаторСобытия);
	Если РезультатОтправки.Успешно Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьСоединениеМаршрута(Маршрут);
	Ошибки.Добавить(ТекстОшибкиМаршрута(Маршрут, РезультатОтправки.ТекстОшибки));
	
КонецПроцедуры

Функция МаршрутыВыгрузки(Узел, ДанныеИБ, ИмяОбъекта)
	
	КешМаршрутов = эв_ОбменЧерезБрокераПовтИсп.Маршруты();
	КлючКеша = Строка(Узел);
	ВсеМаршруты = КешМаршрутов.Получить(КлючКеша);
	Если ВсеМаршруты = Неопределено Тогда
		ВсеМаршруты = ПрочитатьМаршрутыВыгрузки(Узел);
		КешМаршрутов.Вставить(КлючКеша, ВсеМаршруты);
	КонецЕсли;
	
	Маршруты = Новый Массив;
	Для Каждого Маршрут Из ВсеМаршруты Цикл
		Если Не ИменаОбъектовСовпадают(Маршрут.ОбъектМетаданных, ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Если МаршрутПодходит(ДанныеИБ, Маршрут.Магазин, ИмяОбъекта) Тогда
			Маршруты.Добавить(Маршрут);
		КонецЕсли;
	КонецЦикла;
	Возврат Маршруты;
	
КонецФункции

Функция ПрочитатьМаршрутыВыгрузки(Узел)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очереди.Ссылка КАК Очередь,
	|	Очереди.Адрес КАК Адрес,
	|	Очереди.Порт КАК Порт,
	|	Очереди.Логин КАК Логин,
	|	Очереди.Пароль КАК Пароль,
	|	Очереди.ВиртуальныйХост КАК ВиртуальныйХост,
	|	Очереди.ТочкаОбмена КАК ТочкаОбменаОчереди,
	|	Очереди.routing_key КАК КлючМаршрутизацииОчереди,
	|	Очереди.Узел КАК Узел,
	|	Объекты.ОбъектМетаданных КАК ОбъектМетаданных,
	|	Объекты.Магазин КАК Магазин,
	|	Объекты.ТочкаОбмена КАК ТочкаОбмена,
	|	Объекты.routing_key КАК КлючМаршрутизации
	|ИЗ
	|	Справочник.эв_ОчередиPinkRabbitMQ.ОбъектыМетаданных КАК Объекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.эв_ОчередиPinkRabbitMQ КАК Очереди
	|		ПО Объекты.Ссылка = Очереди.Ссылка
	|ГДЕ
	|	НЕ Очереди.ПометкаУдаления
	|	И Очереди.Выгрузка";
	
	Маршруты = Новый Массив;
	УжеДобавленные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Узел) И Выборка.Узел <> Узел Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОбъекта = НормализованноеИмяОбъекта(Выборка.ОбъектМетаданных);
		Если Не ЭтоПоддерживаемыйОбъектОбмена(ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		ТочкаОбмена = СокрЛП(Выборка.ТочкаОбмена);
		Если ПустаяСтрока(ТочкаОбмена) Тогда
			ТочкаОбмена = СокрЛП(Выборка.ТочкаОбменаОчереди);
		КонецЕсли;
		КлючМаршрутизации = СокрЛП(Выборка.КлючМаршрутизации);
		Если ПустаяСтрока(КлючМаршрутизации) Тогда
			КлючМаршрутизации = СокрЛП(Выборка.КлючМаршрутизацииОчереди);
		КонецЕсли;
		Если ПустаяСтрока(ТочкаОбмена) Или ПустаяСтрока(КлючМаршрутизации) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючМаршрута = СтрШаблон("%1|%2|%3|%4|%5", Выборка.Очередь, ИмяОбъекта, ТочкаОбмена, КлючМаршрутизации, Выборка.Магазин);
		Если УжеДобавленные.Получить(КлючМаршрута) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавленные.Вставить(КлючМаршрута, Истина);
		
		Маршрут = Новый Структура;
		Маршрут.Вставить("Очередь", Выборка.Очередь);
		Маршрут.Вставить("Адрес", СокрЛП(Выборка.Адрес));
		Маршрут.Вставить("Порт", Выборка.Порт);
		Маршрут.Вставить("Логин", СокрЛП(Выборка.Логин));
		Маршрут.Вставить("Пароль", Выборка.Пароль);
		Маршрут.Вставить("ВиртуальныйХост", СокрЛП(Выборка.ВиртуальныйХост));
		Маршрут.Вставить("ТочкаОбмена", ТочкаОбмена);
		Маршрут.Вставить("КлючМаршрутизации", КлючМаршрутизации);
		Маршрут.Вставить("Магазин", Выборка.Магазин);
		Маршрут.Вставить("ОбъектМетаданных", ИмяОбъекта);
		Маршруты.Добавить(Маршрут);
	КонецЦикла;
	
	Возврат Маршруты;
	
КонецФункции

Функция ВсеДанныеОтправлены(ДанныеИБ, Маршруты, ИмяОбъекта)
	
	Если ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаОстаткиТоваров()) Тогда
		Возврат ВсеЗаписиОстатковОтправлены(ДанныеИБ, Маршруты);
	КонецЕсли;
	
	Возврат ВсеСтрокиСтавокОтправлены(ДанныеИБ, Маршруты);
	
КонецФункции

Функция ВсеЗаписиОстатковОтправлены(ДанныеИБ, Маршруты)
	
	Магазины = Новый Соответствие;
	Для Каждого Маршрут Из Маршруты Цикл
		Если Не ЗначениеЗаполнено(Маршрут.Магазин) Тогда
			Возврат Истина;
		КонецЕсли;
		Магазины.Вставить(Маршрут.Магазин, Истина);
	КонецЦикла;
	
	Для Каждого ЗаписьРегистра Из ДанныеИБ Цикл
		Если Магазины.Получить(ЗаписьРегистра.СтруктурнаяЕдиница) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ВсеСтрокиСтавокОтправлены(ДанныеИБ, Маршруты)
	
	Магазины = Новый Соответствие;
	Для Каждого Маршрут Из Маршруты Цикл
		Если Не ЗначениеЗаполнено(Маршрут.Магазин) Тогда
			Возврат Истина;
		КонецЕсли;
		Магазины.Вставить(Маршрут.Магазин, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из ДанныеИБ.СтавкиБонусов Цикл
		Если Магазины.Получить(СтрокаТЧ.СтруктурнаяЕдиница) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция МаршрутПодходит(ДанныеИБ, Магазин, ИмяОбъекта)
	
	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаОстаткиТоваров()) Тогда
		Возврат МаршрутПодходитОстаткам(ДанныеИБ, Магазин);
	КонецЕсли;
	
	Возврат МаршрутПодходитСтавкамБонусов(ДанныеИБ, Магазин);
	
КонецФункции

Функция МаршрутПодходитОстаткам(ДанныеИБ, Магазин)
	
	ОтборМагазина = ДанныеИБ.Отбор.СтруктурнаяЕдиница;
	Если ОтборМагазина.Использование Тогда
		Возврат ОтборМагазина.Значение = Магазин;
	КонецЕсли;
	
	Если ДанныеИБ.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ЗаписьРегистра Из ДанныеИБ Цикл
		Если ЗаписьРегистра.СтруктурнаяЕдиница = Магазин Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция МаршрутПодходитСтавкамБонусов(ДанныеИБ, Магазин)
	
	Если ДанныеИБ.СтавкиБонусов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из ДанныеИБ.СтавкиБонусов Цикл
		Если СтрокаТЧ.СтруктурнаяЕдиница = Магазин Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТекстСообщенияОбъекта(ДанныеИБ, Магазин, ИмяОбъекта)
	
	Если ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаОстаткиТоваров()) Тогда
		Возврат ТекстСообщенияОстатков(ДанныеИБ, Магазин);
	КонецЕсли;
	
	Возврат ТекстСообщенияСтавокБонусов(ДанныеИБ, Магазин);
	
КонецФункции

Функция ТекстСообщенияОстатков(ДанныеИБ, Магазин)
	
	Данные = Новый Структура;
	Данные.Вставить("ОбъектМетаданных", ИмяОбъектаОстаткиТоваров());
	Данные.Вставить("Отбор", ОписаниеОтбораОстатков(ДанныеИБ, Магазин));
	Данные.Вставить("Записи", ОписаниеЗаписейОстатков(ДанныеИБ, Магазин));
	
	Возврат ЗаписатьДанныеВJSON(Данные);
	
КонецФункции

Функция ТекстСообщенияСтавокБонусов(ДанныеИБ, Магазин)
	
	Данные = Новый Структура;
	Данные.Вставить("ОбъектМетаданных", ИмяОбъектаСтавкиБонусовПервостольника());
	Данные.Вставить("УИД", Строка(ДанныеИБ.Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Номер", ДанныеИБ.Номер);
	Данные.Вставить("Дата", XMLСтрока(ДанныеИБ.Дата));
	Данные.Вставить("Проведен", ДанныеИБ.Проведен);
	Данные.Вставить("ПометкаУдаления", ДанныеИБ.ПометкаУдаления);
	Данные.Вставить("ДатаОкончания", XMLСтрока(ДанныеИБ.ДатаОкончания));
	Данные.Вставить("Комментарий", ДанныеИБ.Комментарий);
	Данные.Вставить("Ответственный", ОписаниеСсылки(ДанныеИБ.Ответственный));
	Данные.Вставить("Магазин", ОписаниеСсылки(Магазин));
	Данные.Вставить("СтавкиБонусов", ОписаниеСтрокСтавокБонусов(ДанныеИБ, Магазин));
	
	Возврат ЗаписатьДанныеВJSON(Данные);
	
КонецФункции

Функция ЗаписатьДанныеВJSON(Данные)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ОписаниеОтбораОстатков(ДанныеИБ, Магазин)
	
	Отбор = Новый Структура;
	Для Каждого ЭлементОтбора Из ДанныеИБ.Отбор Цикл
		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		Отбор.Вставить(ЭлементОтбора.Имя, ОписаниеСсылки(ЭлементОтбора.Значение));
	КонецЦикла;
	Если ЗначениеЗаполнено(Магазин) И Не Отбор.Свойство("СтруктурнаяЕдиница") Тогда
		Отбор.Вставить("СтруктурнаяЕдиница", ОписаниеСсылки(Магазин));
	КонецЕсли;
	Возврат Отбор;
	
КонецФункции

Функция ОписаниеЗаписейОстатков(ДанныеИБ, Магазин)
	
	Записи = Новый Массив;
	Для Каждого ЗаписьРегистра Из ДанныеИБ Цикл
		Если ЗначениеЗаполнено(Магазин) И ЗаписьРегистра.СтруктурнаяЕдиница <> Магазин Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("Организация", ОписаниеСсылки(ЗаписьРегистра.Организация));
		Описание.Вставить("СтруктурнаяЕдиница", ОписаниеСсылки(ЗаписьРегистра.СтруктурнаяЕдиница));
		Описание.Вставить("Номенклатура", ОписаниеСсылки(ЗаписьРегистра.Номенклатура));
		Описание.Вставить("Характеристика", ОписаниеСсылки(ЗаписьРегистра.Характеристика));
		Описание.Вставить("Партия", ОписаниеСсылки(ЗаписьРегистра.Партия));
		Описание.Вставить("Количество", ЗаписьРегистра.Количество);
		Описание.Вставить("Резерв", ЗаписьРегистра.Резерв);
		Описание.Вставить("Цена", ЗаписьРегистра.Цена);
		Записи.Добавить(Описание);
	КонецЦикла;
	Возврат Записи;
	
КонецФункции

Функция ОписаниеСтрокСтавокБонусов(ДанныеИБ, Магазин)
	
	Строки = Новый Массив;
	Для Каждого СтрокаТЧ Из ДанныеИБ.СтавкиБонусов Цикл
		Если ЗначениеЗаполнено(Магазин) И СтрокаТЧ.СтруктурнаяЕдиница <> Магазин Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("СтруктурнаяЕдиница", ОписаниеСсылки(СтрокаТЧ.СтруктурнаяЕдиница));
		Описание.Вставить("ЦеноваяГруппа", ОписаниеСсылки(СтрокаТЧ.ЦеноваяГруппа));
		Описание.Вставить("Номенклатура", ОписаниеСсылки(СтрокаТЧ.Номенклатура));
		Описание.Вставить("ПроцентИБ", СтрокаТЧ.ПроцентИБ);
		Описание.Вставить("ПроцентКБ", СтрокаТЧ.ПроцентКБ);
		Описание.Вставить("СуммаИБ", СтрокаТЧ.СуммаИБ);
		Описание.Вставить("СуммаКБ", СтрокаТЧ.СуммаКБ);
		Описание.Вставить("ДатаОкончания", XMLСтрока(СтрокаТЧ.ДатаОкончания));
		Описание.Вставить("Производитель", ОписаниеСсылки(СтрокаТЧ.Производитель));
		Описание.Вставить("Специализация", ОписаниеСсылки(СтрокаТЧ.Специализация));
		Описание.Вставить("ПризнакОтбора", СтрокаТЧ.ПризнакОтбора);
		Строки.Добавить(Описание);
	КонецЦикла;
	Возврат Строки;
	
КонецФункции

Функция ОписаниеСсылки(Ссылка)
	
	Описание = Новый Структура("Тип, УИД", "", "");
	Если Ссылка = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Описание;
	КонецЕсли;
	
	Описание.Тип = Ссылка.Метаданные().ПолноеИмя();
	Описание.УИД = Строка(Ссылка.УникальныйИдентификатор());
	Возврат Описание;
	
КонецФункции

Функция СоединениеБрокера(Маршрут)
	
	Соединения = эв_ОбменЧерезБрокераПовтИсп.Соединения();
	Ключ = КлючСоединения(Маршрут);
	Компонента = Соединения.Получить(Ключ);
	Если Компонента <> Неопределено Тогда
		Возврат Компонента;
	КонецЕсли;
	
	Попытка
		Компонента = НовоеСоединение(Маршрут);
	Исключение
		ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		Возврат Неопределено;
	КонецПопытки;
	
	Соединения.Вставить(Ключ, Компонента);
	Возврат Компонента;
	
КонецФункции

Процедура ЗакрытьСоединениеМаршрута(Маршрут)
	
	Соединения = эв_ОбменЧерезБрокераПовтИсп.Соединения();
	Ключ = КлючСоединения(Маршрут);
	Компонента = Соединения.Получить(Ключ);
	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Компонента.ЗавершитьСоединение();
	Исключение
	КонецПопытки;
	Соединения.Удалить(Ключ);
	
КонецПроцедуры

Функция НовоеСоединение(ПараметрыОчереди)
	
	Компонента = Обработки.эв_КомпонентаRabbitMQ.Создать();
	Компонента.Адрес = СокрЛП(ПараметрыОчереди.Адрес);
	Компонента.Порт = ПараметрыОчереди.Порт;
	Компонента.Пользователь = СокрЛП(ПараметрыОчереди.Логин);
	Компонента.Пароль = ПараметрыОчереди.Пароль;
	Компонента.ВиртуальныйХост = СокрЛП(ПараметрыОчереди.ВиртуальныйХост);
	Компонента.УстановитьСоединение();
	Возврат Компонента;
	
КонецФункции

Функция КлючСоединения(Маршрут)
	
	Возврат СтрШаблон("%1|%2|%3|%4|%5", Маршрут.Адрес, Маршрут.Порт, Маршрут.Логин, Маршрут.ВиртуальныйХост, Маршрут.Пароль);
	
КонецФункции

Функция ОчередиЗагрузки(Очередь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очереди.Ссылка КАК Ссылка,
	|	Очереди.Адрес КАК Адрес,
	|	Очереди.Порт КАК Порт,
	|	Очереди.Логин КАК Логин,
	|	Очереди.Пароль КАК Пароль,
	|	Очереди.ВиртуальныйХост КАК ВиртуальныйХост,
	|	Очереди.ИмяОчереди КАК ИмяОчереди
	|ИЗ
	|	Справочник.эв_ОчередиPinkRabbitMQ КАК Очереди
	|ГДЕ
	|	НЕ Очереди.ПометкаУдаления
	|	И Очереди.Загрузка
	|	И (&ВсеОчереди
	|		ИЛИ Очереди.Ссылка = &Очередь)";
	Запрос.УстановитьПараметр("ВсеОчереди", Не ЗначениеЗаполнено(Очередь));
	Запрос.УстановитьПараметр("Очередь", ?(ЗначениеЗаполнено(Очередь), Очередь, Справочники.эв_ОчередиPinkRabbitMQ.ПустаяСсылка()));
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ЗагрузитьОчередь(СтрокаОчереди, Результат)
	
	ИмяОчереди = СокрЛП(СтрокаОчереди.ИмяОчереди);
	Если ПустаяСтрока(ИмяОчереди) Тогда
		Результат.Ошибок = Результат.Ошибок + 1;
		ЗаписатьСобытие(
			СтрШаблон(НСтр("ru = 'Не заполнено имя очереди %1'"), СтрокаОчереди.Ссылка),
			УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;
	
	Компонента = Неопределено;
	Потребитель = "";
	Попытка
		Компонента = НовоеСоединение(СтрокаОчереди);
		Потребитель = Компонента.НачатьЧтение(ИмяОчереди);
		Пока Истина Цикл
			Сообщение = Компонента.ПрочитатьСообщение(Потребитель, 1000);
			Если Сообщение = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			Результат.Прочитано = Результат.Прочитано + 1;
			Попытка
				ЗаписатьСообщениеБрокера(Сообщение.ТекстСообщения);
				Если Не Компонента.ПодтвердитьСообщение(Сообщение.ТегСообщения) Тогда
					ВызватьИсключение НСтр("ru = 'RabbitMQ не подтвердил обработку сообщения'");
				КонецЕсли;
				Результат.Записано = Результат.Записано + 1;
			Исключение
				Результат.Ошибок = Результат.Ошибок + 1;
				ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
				Прервать;
			КонецПопытки;
		КонецЦикла;
	Исключение
		Результат.Ошибок = Результат.Ошибок + 1;
		ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	Если Компонента <> Неопределено Тогда
		Если ЗначениеЗаполнено(Потребитель) Тогда
			Компонента.ЗакончитьЧтение(Потребитель);
		КонецЕсли;
		Компонента.ЗавершитьСоединение();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьСообщениеБрокера(ТекстСообщения)
	
	Данные = ПрочитатьСообщениеБрокера(ТекстСообщения);
	ИмяОбъекта = ИмяОбъектаСообщения(Данные);
	
	Если Не ЗначениеЗаполнено(ИмяОбъекта) Или ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаОстаткиТоваров()) Тогда
		ЗаписатьДанныеОстатков(Данные);
	ИначеЕсли ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаСтавкиБонусовПервостольника()) Тогда
		ЗаписатьДанныеСтавокБонусов(Данные);
	Иначе
		ВызватьИсключение НСтр("ru = 'Сообщение относится к другому объекту метаданных'");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьДанныеОстатков(Данные)
	
	Записи = Неопределено;
	Если Не Данные.Свойство("Записи", Записи) Или ТипЗнч(Записи) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'В сообщении нет массива записей'");
	КонецЕсли;
	
	Отбор = Неопределено;
	Данные.Свойство("Отбор", Отбор);
	ЕстьОтбор = ТипЗнч(Отбор) = Тип("Структура") И Отбор.Количество() > 0;
	
	НачатьТранзакцию();
	Попытка
		Если ЕстьОтбор Тогда
			ЗаписатьНаборОстатков(Отбор, Записи);
		Иначе
			ЗаписатьЗаписиОстатков(Записи);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьДанныеСтавокБонусов(Данные)
	
	УИД = СокрЛП(Строка(ЗначениеОписания(Данные, "УИД")));
	Если ЭтоПустойУникальныйИдентификатор(УИД) Тогда
		ВызватьИсключение НСтр("ru = 'В сообщении ставок бонусов не заполнен УИД документа'");
	КонецЕсли;
	
	Ссылка = XMLЗначение(Тип("ДокументСсылка.эв_СтавкиБонусовПервостольника"), УИД);
	Магазин = СсылкаИзОписания(ЗначениеОписания(Данные, "Магазин"), "СтруктурнаяЕдиница");
	ПометкаУдаления = БулевоОписания(Данные, "ПометкаУдаления");
	Проведен = БулевоОписания(Данные, "Проведен");
	
	НачатьТранзакцию();
	Попытка
		Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			ДокументОбъект = Ссылка.ПолучитьОбъект();
		Иначе
			ДокументОбъект = Документы.эв_СтавкиБонусовПервостольника.СоздатьДокумент();
			ДокументОбъект.УстановитьСсылкуНового(Ссылка);
		КонецЕсли;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		Если ПометкаУдаления И Не ЗначениеЗаполнено(Магазин) Тогда
			ДокументОбъект.ПометкаУдаления = Истина;
			ДокументОбъект.Проведен = Ложь;
			ДокументОбъект.Записать();
			ЗаписатьДвиженияСтавокБонусов(ДокументОбъект, Ложь);
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		
		ДокументОбъект.ПометкаУдаления = ПометкаУдаления;
		ДокументОбъект.Номер = СтрокаОписания(Данные, "Номер");
		ДокументОбъект.Дата = ДатаОписания(Данные, "Дата");
		ДокументОбъект.ДатаОкончания = ДатаОписания(Данные, "ДатаОкончания");
		ДокументОбъект.Комментарий = СтрокаОписания(Данные, "Комментарий");
		ДокументОбъект.Ответственный = СсылкаИзОписания(ЗначениеОписания(Данные, "Ответственный"), "Ответственный");
		
		СтрокиСообщения = ЗначениеОписания(Данные, "СтавкиБонусов");
		Если ТипЗнч(СтрокиСообщения) <> Тип("Массив") Тогда
			ВызватьИсключение НСтр("ru = 'В сообщении ставок бонусов нет массива СтавкиБонусов'");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Магазин) Тогда
			Индекс = ДокументОбъект.СтавкиБонусов.Количество() - 1;
			Пока Индекс >= 0 Цикл
				Если ДокументОбъект.СтавкиБонусов[Индекс].СтруктурнаяЕдиница = Магазин Тогда
					ДокументОбъект.СтавкиБонусов.Удалить(Индекс);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		Иначе
			ДокументОбъект.СтавкиБонусов.Очистить();
		КонецЕсли;
		
		Для Каждого ОписаниеСтроки Из СтрокиСообщения Цикл
			СтрокаТЧ = ДокументОбъект.СтавкиБонусов.Добавить();
			ЗаполнитьСтрокуСтавокБонусов(СтрокаТЧ, ОписаниеСтроки);
		КонецЦикла;
		
		ДокументОбъект.Проведен = Проведен И Не ПометкаУдаления;
		ДокументОбъект.Записать();
		ЗаписатьДвиженияСтавокБонусов(ДокументОбъект, ДокументОбъект.Проведен);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуСтавокБонусов(СтрокаТЧ, ОписаниеСтроки)
	
	СтрокаТЧ.СтруктурнаяЕдиница = СсылкаИзОписания(ЗначениеОписания(ОписаниеСтроки, "СтруктурнаяЕдиница"), "СтруктурнаяЕдиница");
	СтрокаТЧ.ЦеноваяГруппа = СсылкаИзОписания(ЗначениеОписания(ОписаниеСтроки, "ЦеноваяГруппа"), "ЦеноваяГруппа");
	СтрокаТЧ.Номенклатура = СсылкаИзОписания(ЗначениеОписания(ОписаниеСтроки, "Номенклатура"), "Номенклатура");
	СтрокаТЧ.ПроцентИБ = ЧислоОписания(ОписаниеСтроки, "ПроцентИБ");
	СтрокаТЧ.ПроцентКБ = ЧислоОписания(ОписаниеСтроки, "ПроцентКБ");
	СтрокаТЧ.СуммаИБ = ЧислоОписания(ОписаниеСтроки, "СуммаИБ");
	СтрокаТЧ.СуммаКБ = ЧислоОписания(ОписаниеСтроки, "СуммаКБ");
	СтрокаТЧ.ДатаОкончания = ДатаОписания(ОписаниеСтроки, "ДатаОкончания");
	СтрокаТЧ.Производитель = СсылкаИзОписания(ЗначениеОписания(ОписаниеСтроки, "Производитель"), "Производитель");
	СтрокаТЧ.Специализация = СсылкаИзОписания(ЗначениеОписания(ОписаниеСтроки, "Специализация"), "Специализация");
	СтрокаТЧ.ПризнакОтбора = СтрокаОписания(ОписаниеСтроки, "ПризнакОтбора");
	
КонецПроцедуры

Процедура ЗаписатьДвиженияСтавокБонусов(ДокументОбъект, ЗаписыватьДвижения)
	
	Набор = РегистрыСведений.эв_СтавкиБонусовПервостольника.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
	Набор.ОбменДанными.Загрузка = Истина;
	
	Если ЗаписыватьДвижения Тогда
		Для Каждого СтрокаТЧ Из ДокументОбъект.СтавкиБонусов Цикл
			Движение = Набор.Добавить();
			Движение.Период = ДокументОбъект.Дата;
			Движение.СтруктурнаяЕдиница = СтрокаТЧ.СтруктурнаяЕдиница;
			Движение.ЦеноваяГруппа = СтрокаТЧ.ЦеноваяГруппа;
			Движение.Номенклатура = СтрокаТЧ.Номенклатура;
			Движение.ПроцентИБ = СтрокаТЧ.ПроцентИБ;
			Движение.ПроцентКБ = СтрокаТЧ.ПроцентКБ;
			Движение.СуммаИБ = СтрокаТЧ.СуммаИБ;
			Движение.СуммаКБ = СтрокаТЧ.СуммаКБ;
			Движение.ДатаОкончания = ?(СтрокаТЧ.ДатаОкончания = '00010101', ДокументОбъект.ДатаОкончания, СтрокаТЧ.ДатаОкончания);
			Движение.Автор = ДокументОбъект.Ответственный;
		КонецЦикла;
	КонецЕсли;
	
	Набор.Записать();
	
КонецПроцедуры

Процедура ЗаписатьНаборОстатков(Отбор, Записи)
	
	Набор = РегистрыСведений.ОстаткиТоваров.СоздатьНаборЗаписей();
	Набор.ОбменДанными.Загрузка = Истина;
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Набор.Отбор[ЭлементОтбора.Ключ].Установить(СсылкаИзОписания(ЭлементОтбора.Значение, ЭлементОтбора.Ключ));
	КонецЦикла;
	
	Для Каждого ОписаниеЗаписи Из Записи Цикл
		ЗаполнитьЗаписьОстатков(Набор.Добавить(), ОписаниеЗаписи);
	КонецЦикла;
	Набор.Записать();
	
КонецПроцедуры

Процедура ЗаписатьЗаписиОстатков(Записи)
	
	Для Каждого ОписаниеЗаписи Из Записи Цикл
		МенеджерЗаписи = РегистрыСведений.ОстаткиТоваров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ОбменДанными.Загрузка = Истина;
		ЗаполнитьЗаписьОстатков(МенеджерЗаписи, ОписаниеЗаписи);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗаписьОстатков(ЗаписьРегистра, ОписаниеЗаписи)
	
	ЗаписьРегистра.Организация = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Организация"), "Организация");
	ЗаписьРегистра.СтруктурнаяЕдиница = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "СтруктурнаяЕдиница"), "СтруктурнаяЕдиница");
	ЗаписьРегистра.Номенклатура = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Номенклатура"), "Номенклатура");
	ЗаписьРегистра.Характеристика = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Характеристика"), "Характеристика");
	ЗаписьРегистра.Партия = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Партия"), "Партия");
	ЗаписьРегистра.Количество = ЧислоОписания(ОписаниеЗаписи, "Количество");
	ЗаписьРегистра.Резерв = ЧислоОписания(ОписаниеЗаписи, "Резерв");
	ЗаписьРегистра.Цена = ЧислоОписания(ОписаниеЗаписи, "Цена");
	
КонецПроцедуры

Функция СсылкаИзОписания(Описание, ИмяПоля)
	
	ТипМетаданных = ТипМетаданныхПоля(ИмяПоля);
	УИД = "";
	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		Если Описание.Свойство("Тип") И ЗначениеЗаполнено(Описание.Тип) Тогда
			ТипМетаданных = СокрЛП(Описание.Тип);
		КонецЕсли;
		Если Описание.Свойство("УИД") Тогда
			УИД = СокрЛП(Строка(Описание.УИД));
		КонецЕсли;
	ИначеЕсли ТипЗнч(Описание) = Тип("Строка") Тогда
		УИД = СокрЛП(Описание);
	КонецЕсли;
	
	ИмяСправочника = ИмяСправочникаПоТипу(ТипМетаданных);
	Если ПустаяСтрока(ИмяСправочника) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестное поле сообщения: %1'"), ИмяПоля);
	КонецЕсли;
	Если ЭтоПустойУникальныйИдентификатор(УИД) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = XMLЗначение(Тип("СправочникСсылка." + ИмяСправочника), УИД);
	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдена ссылка %1 %2'"), ТипМетаданных, УИД);
	КонецЕсли;
	Возврат Ссылка;
	
КонецФункции

Функция ТипМетаданныхПоля(ИмяПоля)
	
	ТипыПолей = Новый Соответствие;
	ТипыПолей.Вставить("Организация", "Справочник.Организации");
	ТипыПолей.Вставить("СтруктурнаяЕдиница", "Справочник.СтруктурныеЕдиницы");
	ТипыПолей.Вставить("Номенклатура", "Справочник.Номенклатура");
	ТипыПолей.Вставить("Характеристика", "Справочник.ХарактеристикиНоменклатуры");
	ТипыПолей.Вставить("Партия", "Справочник.ПартииНоменклатуры");
	ТипыПолей.Вставить("Ответственный", "Справочник.Сотрудники");
	ТипыПолей.Вставить("ЦеноваяГруппа", "Справочник.ЦеновыеГруппы");
	ТипыПолей.Вставить("Производитель", "Справочник.Контрагенты");
	ТипыПолей.Вставить("Специализация", "Справочник.Номенклатура");
	
	ТипМетаданных = ТипыПолей.Получить(ИмяПоля);
	Если ТипМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТипМетаданных;
	
КонецФункции

Функция ИмяСправочникаПоТипу(ТипМетаданных)
	
	Части = СтрРазделить(СокрЛП(ТипМетаданных), ".", Ложь);
	Если Части.Количество() = 2 Тогда
		Возврат Части[1];
	КонецЕсли;
	Возврат СокрЛП(ТипМетаданных);
	
КонецФункции

Функция ЗначениеОписания(ОписаниеЗаписи, ИмяПоля)
	
	Значение = Неопределено;
	Если ТипЗнч(ОписаниеЗаписи) = Тип("Структура") Тогда
		ОписаниеЗаписи.Свойство(ИмяПоля, Значение);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

Функция ЧислоОписания(ОписаниеЗаписи, ИмяПоля)
	
	Значение = ЗначениеОписания(ОписаниеЗаписи, ИмяПоля);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Значение);
	
КонецФункции

Функция СтрокаОписания(ОписаниеЗаписи, ИмяПоля)
	
	Значение = ЗначениеОписания(ОписаниеЗаписи, ИмяПоля);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции

Функция БулевоОписания(ОписаниеЗаписи, ИмяПоля)
	
	Значение = ЗначениеОписания(ОписаниеЗаписи, ИмяПоля);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Булево(Значение);
	
КонецФункции

Функция ДатаОписания(ОписаниеЗаписи, ИмяПоля)
	
	Значение = ЗначениеОписания(ОписаниеЗаписи, ИмяПоля);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат XMLЗначение(Тип("Дата"), Строка(Значение));
	
КонецФункции

Функция ЭтоПустойУникальныйИдентификатор(УИД)
	
	СтрокаУИД = СокрЛП(Строка(УИД));
	Возврат ПустаяСтрока(СтрокаУИД) Или СтрокаУИД = "00000000-0000-0000-0000-000000000000";
	
КонецФункции

Функция ДокументСтавокБонусов(ДанныеИБ)
	
	Если ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.эв_СтавкиБонусовПервостольника") Тогда
		Возврат ДанныеИБ;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеИБ) = Тип("ДокументСсылка.эв_СтавкиБонусовПервостольника") Тогда
		Если Не ОбщегоНазначения.СсылкаСуществует(ДанныеИБ) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ДанныеИБ.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИмяОбъектаОстаткиТоваров()
	
	Возврат "РегистрСведений.ОстаткиТоваров";
	
КонецФункции

Функция ИмяОбъектаСтавкиБонусовПервостольника()
	
	Возврат "Документ.эв_СтавкиБонусовПервостольника";
	
КонецФункции

Функция ЭтоПоддерживаемыйОбъектОбмена(ИмяОбъекта)
	
	Возврат ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаОстаткиТоваров())
		Или ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаСтавкиБонусовПервостольника());
	
КонецФункции

Функция ИменаОбъектовСовпадают(ИмяОбъекта1, ИмяОбъекта2)
	
	Возврат НормализованноеИмяОбъекта(ИмяОбъекта1) = НормализованноеИмяОбъекта(ИмяОбъекта2);
	
КонецФункции

Функция НормализованноеИмяОбъекта(ИмяОбъекта)
	
	Имя = ВРег(СокрЛП(Строка(ИмяОбъекта)));
	Если Имя = "ОСТАТКИТОВАРОВ" Тогда
		Возврат ВРег(ИмяОбъектаОстаткиТоваров());
	КонецЕсли;
	Если Имя = "ЭВ_СТАВКИБОНУСОВПЕРВОСТОЛЬНИКА" Тогда
		Возврат ВРег(ИмяОбъектаСтавкиБонусовПервостольника());
	КонецЕсли;
	Возврат Имя;
	
КонецФункции

Функция МетаданныеОбъектаПоИмени(ИмяОбъекта)
	
	Если ИменаОбъектовСовпадают(ИмяОбъекта, ИмяОбъектаСтавкиБонусовПервостольника()) Тогда
		Возврат Метаданные.Документы.эв_СтавкиБонусовПервостольника;
	КонецЕсли;
	
	Возврат Метаданные.РегистрыСведений.ОстаткиТоваров;
	
КонецФункции

Функция УзелОбмена(КомпонентыОбмена)
	
	Узел = Неопределено;
	Если ТипЗнч(КомпонентыОбмена) = Тип("Структура") Тогда
		КомпонентыОбмена.Свойство("УзелКорреспондента", Узел);
	КонецЕсли;
	Возврат Узел;
	
КонецФункции

Функция ДанныеРегистрации(ДанныеИБ)
	
	Если ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.эв_СтавкиБонусовПервостольника") Тогда
		Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
			Возврат ДанныеИБ.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДанныеИБ;
	
КонецФункции

Процедура УдалитьРегистрациюОбъекта(Узел, ДанныеИБ)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел, ДанныеРегистрации(ДанныеИБ));
	
КонецПроцедуры

Процедура СохранитьРегистрациюОбъекта(Узел, ДанныеИБ)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;
	Данные = ДанныеРегистрации(ДанныеИБ);
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Данные);
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, Данные);
	
КонецПроцедуры

Процедура ЗапомнитьПропуск()
	
	Пропуски = эв_ОбменЧерезБрокераПовтИсп.Пропуски();
	Пропуски.Количество = Пропуски.Количество + 1;
	
КонецПроцедуры

Функция ТекстОшибкиМаршрута(Маршрут, ТекстОшибки)
	
	Возврат СтрШаблон(
		НСтр("ru = 'Очередь %1, точка обмена %2, routing key %3: %4'"),
		Маршрут.Очередь,
		Маршрут.ТочкаОбмена,
		Маршрут.КлючМаршрутизации,
		ТекстОшибки);
	
КонецФункции

Процедура ЗаписатьСобытие(Текст, Уровень, ОбъектМетаданных = Неопределено)
	
	Если ОбъектМетаданных = Неопределено Тогда
		ОбъектМетаданных = Метаданные.РегистрыСведений.ОстаткиТоваров;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Обмен через брокера'", ОбщегоНазначения.КодОсновногоЯзыка()),
		Уровень,
		ОбъектМетаданных,
		,
		Текст);
	
КонецПроцедуры

Функция ПрочитатьСообщениеБрокера(ТекстСообщения)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстСообщения);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Сообщение брокера не является объектом JSON'");
	КонецЕсли;
	Возврат Данные;

КонецФункции

Функция ИмяОбъектаСообщения(Данные)

	ИмяОбъекта = "";
	Если Данные.Свойство("ОбъектМетаданных") И ЗначениеЗаполнено(Данные.ОбъектМетаданных) Тогда
		ИмяОбъекта = Данные.ОбъектМетаданных;
	КонецЕсли;
	Возврат ИмяОбъекта;

КонецФункции

#КонецОбласти

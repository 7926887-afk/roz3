#Область ПрограммныйИнтерфейс

// Отправляет зарегистрированный набор остатков в RabbitMQ и снимает регистрацию после подтверждения брокера.
//
// Параметры:
//  ДанныеИБ - РегистрСведенийНаборЗаписей.ОстаткиТоваров - выгружаемый набор.
//  КомпонентыОбмена - Структура - компоненты универсального обмена.
//
Процедура ВыгрузитьЗарегистрированныеОстатки(ДанныеИБ, КомпонентыОбмена) Экспорт
	
	Если ТипЗнч(ДанныеИБ) <> Тип("РегистрСведенийНаборЗаписей.ОстаткиТоваров") Тогда
		Возврат;
	КонецЕсли;
	
	Узел = УзелОбмена(КомпонентыОбмена);
	
	Попытка
		Маршруты = МаршрутыВыгрузки(Узел, ДанныеИБ);
		Если Маршруты.Количество() = 0 Тогда
			//ЗапомнитьПропуск();
			//СохранитьРегистрациюОстатков(Узел, ДанныеИБ);
			УдалитьРегистрациюОстатков(Узел, ДанныеИБ);
			Возврат;
		КонецЕсли;
		
		Ошибки = Новый Массив;
		Для Каждого Маршрут Из Маршруты Цикл
			ОтправитьМаршрут(Маршрут, ДанныеИБ, Ошибки);
		КонецЦикла;
		
		Если Ошибки.Количество() = 0 И Не ВсеЗаписиОтправлены(ДанныеИБ, Маршруты) Тогда
			ЗапомнитьПропуск();
			СохранитьРегистрациюОстатков(Узел, ДанныеИБ);
			Возврат;
		КонецЕсли;
		
		Если Ошибки.Количество() = 0 Тогда
			УдалитьРегистрациюОстатков(Узел, ДанныеИБ);
		Иначе
			СохранитьРегистрациюОстатков(Узел, ДанныеИБ);
			ЗаписатьСобытие(СтрСоединить(Ошибки, Символы.ПС), УровеньЖурналаРегистрации.Ошибка);
		КонецЕсли;
	Исключение
		СохранитьРегистрациюОстатков(Узел, ДанныеИБ);
		ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
КонецПроцедуры

// Отправляет зарегистрированную автоматическую скидку в RabbitMQ.
// Элемент выгружается, если получатель в ПолучателиСкидкиСклады совпадает с магазином маршрута,
// и в сообщении остаётся только этот получатель. Группа выгружается на каждый такой магазин.
// Без совпадения регистрация снимается.
//
// Параметры:
//  ДанныеИБ - СправочникОбъект.АвтоматическиеСкидки - выгружаемая скидка.
//  КомпонентыОбмена - Структура - компоненты универсального обмена.
//
Процедура ВыгрузитьЗарегистрированныеАвтоматическиеСкидки(ДанныеИБ, КомпонентыОбмена) Экспорт
	
	Если ТипЗнч(ДанныеИБ) <> Тип("СправочникОбъект.АвтоматическиеСкидки") Тогда
		Возврат;
	КонецЕсли;
	
	Узел = УзелОбмена(КомпонентыОбмена);
	
	Попытка
		Маршруты = МаршрутыВыгрузки(Узел, ДанныеИБ);
		Если Маршруты.Количество() = 0 Тогда
			УдалитьРегистрациюОстатков(Узел, ДанныеИБ);
			Возврат;
		КонецЕсли;
		
		Ошибки = Новый Массив;
		Для Каждого Маршрут Из Маршруты Цикл
			ОтправитьМаршрут(Маршрут, ДанныеИБ, Ошибки);
		КонецЦикла;
		
		Если Ошибки.Количество() = 0 Тогда
			УдалитьРегистрациюОстатков(Узел, ДанныеИБ);
		Иначе
			СохранитьРегистрациюОстатков(Узел, ДанныеИБ);
			ЗаписатьСобытие(СтрСоединить(Ошибки, Символы.ПС), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.АвтоматическиеСкидки);
		КонецЕсли;
	Исключение
		СохранитьРегистрациюОстатков(Узел, ДанныеИБ);
		ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.АвтоматическиеСкидки);
	КонецПопытки;
	
КонецПроцедуры

// Читает очереди с признаком Загрузка и записывает полученные сообщения в регистр ОстаткиТоваров.
// Запуск вручную на сервере: эв_ОбменЧерезБрокера.ЗагрузитьОстаткиТоваров().
//
// Параметры:
//  Очередь - СправочникСсылка.эв_ОчередиPinkRabbitMQ - очередь загрузки. Необязательный.
//
Процедура ЗагрузитьОстаткиТоваров(Очередь = Неопределено) Экспорт
	
	Результат = Новый Структура("Очередей, Прочитано, Записано, Ошибок", 0, 0, 0, 0);
	Выборка = ОчередиЗагрузки(Очередь);
	
	Пока Выборка.Следующий() Цикл
		Результат.Очередей = Результат.Очередей + 1;
		ЗагрузитьОчередь(Выборка, Результат);
	КонецЦикла;
	
	Текст = СтрШаблон(
		НСтр("ru = 'Загрузка из RabbitMQ: очередей %1, прочитано %2, записано %3, ошибок %4'"),
		Результат.Очередей,
		Результат.Прочитано,
		Результат.Записано,
		Результат.Ошибок);
	Сообщить(Текст);
	ЗаписатьСобытие(Текст, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

// Читает очереди с признаком Загрузка и записывает сообщения автоматических скидок.
// Запуск вручную на сервере: эв_ОбменЧерезБрокера.ЗагрузитьАвтоматическиеСкидки().
//
// Параметры:
//  Очередь - СправочникСсылка.эв_ОчередиPinkRabbitMQ - очередь загрузки. Необязательный.
//
Процедура ЗагрузитьАвтоматическиеСкидки(Очередь = Неопределено) Экспорт
	
	ЗагрузитьОстаткиТоваров(Очередь);
	
КонецПроцедуры

// Закрывает соединения с брокером, открытые при выгрузке.
Процедура ЗакрытьСоединения() Экспорт
	
	Соединения = эв_ОбменЧерезБрокераПовтИсп.Соединения();
	Для Каждого Элемент Из Соединения Цикл
		Попытка
			Элемент.Значение.ЗавершитьСоединение();
		Исключение
		КонецПопытки;
	КонецЦикла;
	Соединения.Очистить();
	
	Пропуски = эв_ОбменЧерезБрокераПовтИсп.Пропуски();
	Если Пропуски.Количество > 0 Тогда
		ЗаписатьСобытие(
			СтрШаблон(
				НСтр("ru = 'Выгрузка регистра ОстаткиТоваров пропущена для %1 наборов: объект не найден в табличной части ОбъектыМетаданных либо не подошел по магазину. Регистрация в плане обмена сохранена.'"),
				Пропуски.Количество),
			УровеньЖурналаРегистрации.Предупреждение);
		Пропуски.Количество = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьМаршрут(Маршрут, ДанныеИБ, Ошибки)
	
	Компонента = СоединениеБрокера(Маршрут);
	Если Компонента = Неопределено Тогда
		Ошибки.Добавить(ТекстОшибкиМаршрута(Маршрут, НСтр("ru = 'нет соединения с RabbitMQ'")));
		Возврат;
	КонецЕсли;
	
	Компонента.ТочкаОбмена = Маршрут.ТочкаОбмена;
	ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	ИдентификаторСобытия = Строка(Новый УникальныйИдентификатор);
	РезультатОтправки = Компонента.ОтправитьСообщение(
		ТекстСообщенияВыгрузки(ДанныеИБ, Маршрут.Магазин),
		Маршрут.КлючМаршрутизации,
		ИдентификаторСообщения,
		ИдентификаторСобытия);
	Если РезультатОтправки.Успешно Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьСоединениеМаршрута(Маршрут);
	Ошибки.Добавить(ТекстОшибкиМаршрута(Маршрут, РезультатОтправки.ТекстОшибки));
	
КонецПроцедуры

Функция МаршрутыВыгрузки(Узел, ДанныеИБ)
	
	ИмяОбъекта = ИмяОбъектаВыгрузки(ДанныеИБ);
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	КешМаршрутов = эв_ОбменЧерезБрокераПовтИсп.Маршруты();
	КлючКеша = Строка(Узел) + "|" + ИмяОбъекта;
	ВсеМаршруты = КешМаршрутов.Получить(КлючКеша);
	Если ВсеМаршруты = Неопределено Тогда
		ВсеМаршруты = ПрочитатьМаршрутыВыгрузки(Узел, ИмяОбъекта);
		КешМаршрутов.Вставить(КлючКеша, ВсеМаршруты);
	КонецЕсли;
	
	Маршруты = Новый Массив;
	Для Каждого Маршрут Из ВсеМаршруты Цикл
		Если МаршрутПодходит(ДанныеИБ, Маршрут.Магазин) Тогда
			Маршруты.Добавить(Маршрут);
		КонецЕсли;
	КонецЦикла;
	Возврат Маршруты;
	
КонецФункции

Функция ПрочитатьМаршрутыВыгрузки(Узел, ИмяОбъекта)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очереди.Ссылка КАК Очередь,
	|	Очереди.Адрес КАК Адрес,
	|	Очереди.Порт КАК Порт,
	|	Очереди.Логин КАК Логин,
	|	Очереди.Пароль КАК Пароль,
	|	Очереди.ВиртуальныйХост КАК ВиртуальныйХост,
	|	Очереди.ТочкаОбмена КАК ТочкаОбменаОчереди,
	|	Очереди.routing_key КАК КлючМаршрутизацииОчереди,
	|	Очереди.Узел КАК Узел,
	|	Объекты.ОбъектМетаданных КАК ОбъектМетаданных,
	|	Объекты.Магазин КАК Магазин,
	|	Объекты.ТочкаОбмена КАК ТочкаОбмена,
	|	Объекты.routing_key КАК КлючМаршрутизации
	|ИЗ
	|	Справочник.эв_ОчередиPinkRabbitMQ.ОбъектыМетаданных КАК Объекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.эв_ОчередиPinkRabbitMQ КАК Очереди
	|		ПО Объекты.Ссылка = Очереди.Ссылка
	|ГДЕ
	|	НЕ Очереди.ПометкаУдаления
	|	И Очереди.Выгрузка";
	
	Маршруты = Новый Массив;
	УжеДобавленные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Узел) И Выборка.Узел <> Узел Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоВыгружаемыйОбъект(Выборка.ОбъектМетаданных, ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		ТочкаОбмена = СокрЛП(Выборка.ТочкаОбмена);
		Если ПустаяСтрока(ТочкаОбмена) Тогда
			ТочкаОбмена = СокрЛП(Выборка.ТочкаОбменаОчереди);
		КонецЕсли;
		КлючМаршрутизации = СокрЛП(Выборка.КлючМаршрутизации);
		Если ПустаяСтрока(КлючМаршрутизации) Тогда
			КлючМаршрутизации = СокрЛП(Выборка.КлючМаршрутизацииОчереди);
		КонецЕсли;
		Если ПустаяСтрока(ТочкаОбмена) Или ПустаяСтрока(КлючМаршрутизации) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючМаршрута = СтрШаблон("%1|%2|%3|%4", Выборка.Очередь, ТочкаОбмена, КлючМаршрутизации, Выборка.Магазин);
		Если УжеДобавленные.Получить(КлючМаршрута) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавленные.Вставить(КлючМаршрута, Истина);
		
		Маршрут = Новый Структура;
		Маршрут.Вставить("Очередь", Выборка.Очередь);
		Маршрут.Вставить("Адрес", СокрЛП(Выборка.Адрес));
		Маршрут.Вставить("Порт", Выборка.Порт);
		Маршрут.Вставить("Логин", СокрЛП(Выборка.Логин));
		Маршрут.Вставить("Пароль", Выборка.Пароль);
		Маршрут.Вставить("ВиртуальныйХост", СокрЛП(Выборка.ВиртуальныйХост));
		Маршрут.Вставить("ТочкаОбмена", ТочкаОбмена);
		Маршрут.Вставить("КлючМаршрутизации", КлючМаршрутизации);
		Маршрут.Вставить("Магазин", Выборка.Магазин);
		Маршруты.Добавить(Маршрут);
	КонецЦикла;
	
	Возврат Маршруты;
	
КонецФункции

Функция ВсеЗаписиОтправлены(ДанныеИБ, Маршруты)
	
	Магазины = Новый Соответствие;
	Для Каждого Маршрут Из Маршруты Цикл
		Если Не ЗначениеЗаполнено(Маршрут.Магазин) Тогда
			Возврат Истина;
		КонецЕсли;
		Магазины.Вставить(Маршрут.Магазин, Истина);
	КонецЦикла;
	
	Для Каждого ЗаписьРегистра Из ДанныеИБ Цикл
		Если Магазины.Получить(ЗаписьРегистра.СтруктурнаяЕдиница) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция МаршрутПодходит(ДанныеИБ, Магазин)
	
	Если ТипЗнч(ДанныеИБ) = Тип("СправочникОбъект.АвтоматическиеСкидки") Тогда
		Возврат МаршрутПодходитДляСкидки(ДанныеИБ, Магазин);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ОтборМагазина = ДанныеИБ.Отбор.СтруктурнаяЕдиница;
	Если ОтборМагазина.Использование Тогда
		Возврат ОтборМагазина.Значение = Магазин;
	КонецЕсли;
	
	Если ДанныеИБ.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ЗаписьРегистра Из ДанныеИБ Цикл
		Если ЗаписьРегистра.СтруктурнаяЕдиница = Магазин Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТекстСообщенияОстатков(ДанныеИБ, Магазин)
	
	Данные = Новый Структура;
	Данные.Вставить("ОбъектМетаданных", "РегистрСведений.ОстаткиТоваров");
	Данные.Вставить("Отбор", ОписаниеОтбора(ДанныеИБ, Магазин));
	Данные.Вставить("Записи", ОписаниеЗаписей(ДанныеИБ, Магазин));
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ОписаниеОтбора(ДанныеИБ, Магазин)
	
	Отбор = Новый Структура;
	Для Каждого ЭлементОтбора Из ДанныеИБ.Отбор Цикл
		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		Отбор.Вставить(ЭлементОтбора.Имя, ОписаниеСсылки(ЭлементОтбора.Значение));
	КонецЦикла;
	Если ЗначениеЗаполнено(Магазин) И Не Отбор.Свойство("СтруктурнаяЕдиница") Тогда
		Отбор.Вставить("СтруктурнаяЕдиница", ОписаниеСсылки(Магазин));
	КонецЕсли;
	Возврат Отбор;
	
КонецФункции

Функция ОписаниеЗаписей(ДанныеИБ, Магазин)
	
	Записи = Новый Массив;
	Для Каждого ЗаписьРегистра Из ДанныеИБ Цикл
		Если ЗначениеЗаполнено(Магазин) И ЗаписьРегистра.СтруктурнаяЕдиница <> Магазин Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("Организация", ОписаниеСсылки(ЗаписьРегистра.Организация));
		Описание.Вставить("СтруктурнаяЕдиница", ОписаниеСсылки(ЗаписьРегистра.СтруктурнаяЕдиница));
		Описание.Вставить("Номенклатура", ОписаниеСсылки(ЗаписьРегистра.Номенклатура));
		Описание.Вставить("Характеристика", ОписаниеСсылки(ЗаписьРегистра.Характеристика));
		Описание.Вставить("Партия", ОписаниеСсылки(ЗаписьРегистра.Партия));
		Описание.Вставить("Количество", ЗаписьРегистра.Количество);
		Описание.Вставить("Резерв", ЗаписьРегистра.Резерв);
		Описание.Вставить("Цена", ЗаписьРегистра.Цена);
		Записи.Добавить(Описание);
	КонецЦикла;
	Возврат Записи;
	
КонецФункции

Функция ОписаниеСсылки(Ссылка)
	
	Описание = Новый Структура("Тип, УИД", "", "");
	Если Ссылка = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	
	Описание.Тип = Ссылка.Метаданные().ПолноеИмя();
	Описание.УИД = Строка(Ссылка.УникальныйИдентификатор());
	Возврат Описание;
	
КонецФункции

Функция СоединениеБрокера(Маршрут)
	
	Соединения = эв_ОбменЧерезБрокераПовтИсп.Соединения();
	Ключ = КлючСоединения(Маршрут);
	Компонента = Соединения.Получить(Ключ);
	Если Компонента <> Неопределено Тогда
		Возврат Компонента;
	КонецЕсли;
	
	Попытка
		Компонента = НовоеСоединение(Маршрут);
	Исключение
		ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		Возврат Неопределено;
	КонецПопытки;
	
	Соединения.Вставить(Ключ, Компонента);
	Возврат Компонента;
	
КонецФункции

Процедура ЗакрытьСоединениеМаршрута(Маршрут)
	
	Соединения = эв_ОбменЧерезБрокераПовтИсп.Соединения();
	Ключ = КлючСоединения(Маршрут);
	Компонента = Соединения.Получить(Ключ);
	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Компонента.ЗавершитьСоединение();
	Исключение
	КонецПопытки;
	Соединения.Удалить(Ключ);
	
КонецПроцедуры

Функция НовоеСоединение(ПараметрыОчереди)
	
	Компонента = Обработки.эв_КомпонентаRabbitMQ.Создать();
	Компонента.Адрес = СокрЛП(ПараметрыОчереди.Адрес);
	Компонента.Порт = ПараметрыОчереди.Порт;
	Компонента.Пользователь = СокрЛП(ПараметрыОчереди.Логин);
	Компонента.Пароль = ПараметрыОчереди.Пароль;
	Компонента.ВиртуальныйХост = СокрЛП(ПараметрыОчереди.ВиртуальныйХост);
	Компонента.УстановитьСоединение();
	Возврат Компонента;
	
КонецФункции

Функция КлючСоединения(Маршрут)
	
	Возврат СтрШаблон("%1|%2|%3|%4|%5", Маршрут.Адрес, Маршрут.Порт, Маршрут.Логин, Маршрут.ВиртуальныйХост, Маршрут.Пароль);
	
КонецФункции

Функция ОчередиЗагрузки(Очередь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очереди.Ссылка КАК Ссылка,
	|	Очереди.Адрес КАК Адрес,
	|	Очереди.Порт КАК Порт,
	|	Очереди.Логин КАК Логин,
	|	Очереди.Пароль КАК Пароль,
	|	Очереди.ВиртуальныйХост КАК ВиртуальныйХост,
	|	Очереди.ИмяОчереди КАК ИмяОчереди
	|ИЗ
	|	Справочник.эв_ОчередиPinkRabbitMQ КАК Очереди
	|ГДЕ
	|	НЕ Очереди.ПометкаУдаления
	|	И Очереди.Загрузка
	|	И (&ВсеОчереди
	|		ИЛИ Очереди.Ссылка = &Очередь)";
	Запрос.УстановитьПараметр("ВсеОчереди", Не ЗначениеЗаполнено(Очередь));
	Запрос.УстановитьПараметр("Очередь", ?(ЗначениеЗаполнено(Очередь), Очередь, Справочники.эв_ОчередиPinkRabbitMQ.ПустаяСсылка()));
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ЗагрузитьОчередь(СтрокаОчереди, Результат)
	
	ИмяОчереди = СокрЛП(СтрокаОчереди.ИмяОчереди);
	Если ПустаяСтрока(ИмяОчереди) Тогда
		Результат.Ошибок = Результат.Ошибок + 1;
		ЗаписатьСобытие(
			СтрШаблон(НСтр("ru = 'Не заполнено имя очереди %1'"), СтрокаОчереди.Ссылка),
			УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;
	
	Компонента = Неопределено;
	Потребитель = "";
	Попытка
		Компонента = НовоеСоединение(СтрокаОчереди);
		Потребитель = Компонента.НачатьЧтение(ИмяОчереди);
		Пока Истина Цикл
			Сообщение = Компонента.ПрочитатьСообщение(Потребитель, 1000);
			Если Сообщение = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			Результат.Прочитано = Результат.Прочитано + 1;
			Попытка
				ЗаписатьСообщениеБрокера(Сообщение.ТекстСообщения);
				Если Не Компонента.ПодтвердитьСообщение(Сообщение.ТегСообщения) Тогда
					ВызватьИсключение НСтр("ru = 'RabbitMQ не подтвердил обработку сообщения'");
				КонецЕсли;
				Результат.Записано = Результат.Записано + 1;
			Исключение
				Результат.Ошибок = Результат.Ошибок + 1;
				ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
				Прервать;
			КонецПопытки;
		КонецЦикла;
	Исключение
		Результат.Ошибок = Результат.Ошибок + 1;
		ЗаписатьСобытие(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	Если Компонента <> Неопределено Тогда
		Если ЗначениеЗаполнено(Потребитель) Тогда
			Компонента.ЗакончитьЧтение(Потребитель);
		КонецЕсли;
		Компонента.ЗавершитьСоединение();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьСообщениеБрокера(ТекстСообщения)
	
	Данные = ПрочитатьСообщениеБрокера(ТекстСообщения);
	ИмяОбъекта = ИмяОбъектаСообщения(Данные);
	Если ЭтоАвтоматическиеСкидки(ИмяОбъекта) Тогда
		ЗаписатьДанныеАвтоматическойСкидки(Данные);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяОбъекта) И Не ЭтоОстаткиТоваров(ИмяОбъекта) Тогда
		ВызватьИсключение НСтр("ru = 'Сообщение относится к другому объекту метаданных'");
	КонецЕсли;
	ЗаписатьДанныеОстатков(Данные);
	
КонецПроцедуры

Процедура ЗаписатьДанныеОстатков(Данные)
	
	Записи = Неопределено;
	Если Не Данные.Свойство("Записи", Записи) Или ТипЗнч(Записи) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'В сообщении нет массива записей'");
	КонецЕсли;
	
	Отбор = Неопределено;
	Данные.Свойство("Отбор", Отбор);
	ЕстьОтбор = ТипЗнч(Отбор) = Тип("Структура") И Отбор.Количество() > 0;
	
	НачатьТранзакцию();
	Попытка
		Если ЕстьОтбор Тогда
			ЗаписатьНаборОстатков(Отбор, Записи);
		Иначе
			ЗаписатьЗаписиОстатков(Записи);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьНаборОстатков(Отбор, Записи)
	
	Набор = РегистрыСведений.ОстаткиТоваров.СоздатьНаборЗаписей();
	Набор.ОбменДанными.Загрузка = Истина;
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Набор.Отбор[ЭлементОтбора.Ключ].Установить(СсылкаИзОписания(ЭлементОтбора.Значение, ЭлементОтбора.Ключ));
	КонецЦикла;
	
	Для Каждого ОписаниеЗаписи Из Записи Цикл
		ЗаполнитьЗаписьОстатков(Набор.Добавить(), ОписаниеЗаписи);
	КонецЦикла;
	Набор.Записать();
	
КонецПроцедуры

Процедура ЗаписатьЗаписиОстатков(Записи)
	
	Для Каждого ОписаниеЗаписи Из Записи Цикл
		МенеджерЗаписи = РегистрыСведений.ОстаткиТоваров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ОбменДанными.Загрузка = Истина;
		ЗаполнитьЗаписьОстатков(МенеджерЗаписи, ОписаниеЗаписи);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗаписьОстатков(ЗаписьРегистра, ОписаниеЗаписи)
	
	ЗаписьРегистра.Организация = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Организация"), "Организация");
	ЗаписьРегистра.СтруктурнаяЕдиница = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "СтруктурнаяЕдиница"), "СтруктурнаяЕдиница");
	ЗаписьРегистра.Номенклатура = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Номенклатура"), "Номенклатура");
	ЗаписьРегистра.Характеристика = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Характеристика"), "Характеристика");
	ЗаписьРегистра.Партия = СсылкаИзОписания(ЗначениеОписания(ОписаниеЗаписи, "Партия"), "Партия");
	ЗаписьРегистра.Количество = ЧислоОписания(ОписаниеЗаписи, "Количество");
	ЗаписьРегистра.Резерв = ЧислоОписания(ОписаниеЗаписи, "Резерв");
	ЗаписьРегистра.Цена = ЧислоОписания(ОписаниеЗаписи, "Цена");
	
КонецПроцедуры

Функция СсылкаИзОписания(Описание, ИмяПоля)
	
	ТипМетаданных = ТипМетаданныхПоля(ИмяПоля);
	УИД = "";
	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		Если Описание.Свойство("Тип") И ЗначениеЗаполнено(Описание.Тип) Тогда
			ТипМетаданных = СокрЛП(Описание.Тип);
		КонецЕсли;
		Если Описание.Свойство("УИД") Тогда
			УИД = СокрЛП(Строка(Описание.УИД));
		КонецЕсли;
	ИначеЕсли ТипЗнч(Описание) = Тип("Строка") Тогда
		УИД = СокрЛП(Описание);
	КонецЕсли;
	
	ИмяСправочника = ИмяСправочникаПоТипу(ТипМетаданных);
	Если ПустаяСтрока(ИмяСправочника) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестное поле сообщения остатков: %1'"), ИмяПоля);
	КонецЕсли;
	Если ЭтоПустойУникальныйИдентификатор(УИД) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = XMLЗначение(Тип("СправочникСсылка." + ИмяСправочника), УИД);
	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдена ссылка %1 %2'"), ТипМетаданных, УИД);
	КонецЕсли;
	Возврат Ссылка;
	
КонецФункции

Функция ТипМетаданныхПоля(ИмяПоля)
	
	ТипыПолей = Новый Соответствие;
	ТипыПолей.Вставить("Организация", "Справочник.Организации");
	ТипыПолей.Вставить("СтруктурнаяЕдиница", "Справочник.СтруктурныеЕдиницы");
	ТипыПолей.Вставить("Номенклатура", "Справочник.Номенклатура");
	ТипыПолей.Вставить("Характеристика", "Справочник.ХарактеристикиНоменклатуры");
	ТипыПолей.Вставить("Партия", "Справочник.ПартииНоменклатуры");
	
	ТипМетаданных = ТипыПолей.Получить(ИмяПоля);
	Если ТипМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТипМетаданных;
	
КонецФункции

Функция ИмяСправочникаПоТипу(ТипМетаданных)
	
	Части = СтрРазделить(СокрЛП(ТипМетаданных), ".", Ложь);
	Если Части.Количество() = 2 Тогда
		Возврат Части[1];
	КонецЕсли;
	Возврат СокрЛП(ТипМетаданных);
	
КонецФункции

Функция ЗначениеОписания(ОписаниеЗаписи, ИмяПоля)
	
	Значение = Неопределено;
	Если ТипЗнч(ОписаниеЗаписи) = Тип("Структура") Тогда
		ОписаниеЗаписи.Свойство(ИмяПоля, Значение);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

Функция ЧислоОписания(ОписаниеЗаписи, ИмяПоля)
	
	Значение = ЗначениеОписания(ОписаниеЗаписи, ИмяПоля);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Значение);
	
КонецФункции

Функция ЭтоПустойУникальныйИдентификатор(УИД)
	
	СтрокаУИД = СокрЛП(Строка(УИД));
	Возврат ПустаяСтрока(СтрокаУИД) Или СтрокаУИД = "00000000-0000-0000-0000-000000000000";
	
КонецФункции

Функция ЭтоОстаткиТоваров(ИмяОбъекта)
	
	Имя = ВРег(СокрЛП(Строка(ИмяОбъекта)));
	Возврат Имя = "РЕГИСТРСВЕДЕНИЙ.ОСТАТКИТОВАРОВ" Или Имя = "ОСТАТКИТОВАРОВ";
	
КонецФункции

Функция ЭтоАвтоматическиеСкидки(ИмяОбъекта)
	
	Имя = ВРег(СокрЛП(Строка(ИмяОбъекта)));
	Возврат Имя = "СПРАВОЧНИК.АВТОМАТИЧЕСКИЕСКИДКИ" Или Имя = "АВТОМАТИЧЕСКИЕСКИДКИ";
	
КонецФункции

Функция УзелОбмена(КомпонентыОбмена)
	
	Узел = Неопределено;
	Если ТипЗнч(КомпонентыОбмена) = Тип("Структура") Тогда
		КомпонентыОбмена.Свойство("УзелКорреспондента", Узел);
	КонецЕсли;
	Возврат Узел;
	
КонецФункции

Процедура УдалитьРегистрациюОстатков(Узел, ДанныеИБ)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел, ДанныеИБ);
	
КонецПроцедуры

Процедура СохранитьРегистрациюОстатков(Узел, ДанныеИБ)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел, ДанныеИБ);
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, ДанныеИБ);
	
КонецПроцедуры

Процедура ЗапомнитьПропуск()
	
	Пропуски = эв_ОбменЧерезБрокераПовтИсп.Пропуски();
	Пропуски.Количество = Пропуски.Количество + 1;
	
КонецПроцедуры

Функция ТекстОшибкиМаршрута(Маршрут, ТекстОшибки)
	
	Возврат СтрШаблон(
		НСтр("ru = 'Очередь %1, точка обмена %2, routing key %3: %4'"),
		Маршрут.Очередь,
		Маршрут.ТочкаОбмена,
		Маршрут.КлючМаршрутизации,
		ТекстОшибки);
	
КонецФункции

Процедура ЗаписатьСобытие(Текст, Уровень, ОбъектМетаданных = Неопределено)
	
	Если ОбъектМетаданных = Неопределено Тогда
		ОбъектМетаданных = Метаданные.РегистрыСведений.ОстаткиТоваров;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Обмен через брокера'", ОбщегоНазначения.КодОсновногоЯзыка()),
		Уровень,
		ОбъектМетаданных,
		,
		Текст);
	
КонецПроцедуры

Функция ТекстСообщенияВыгрузки(ДанныеИБ, Магазин)
	
	Если ТипЗнч(ДанныеИБ) = Тип("СправочникОбъект.АвтоматическиеСкидки") Тогда
		Возврат ТекстСообщенияАвтоматическойСкидки(ДанныеИБ, Магазин);
	КонецЕсли;
	Возврат ТекстСообщенияОстатков(ДанныеИБ, Магазин);
	
КонецФункции

Функция ТекстСообщенияАвтоматическойСкидки(ДанныеИБ, Магазин)
	
	УжеДобавленные = Новый Соответствие;
	УжеДобавленные.Вставить(КлючСсылки(ДанныеИБ.Ссылка), Истина);
	Ссылки = Новый Массив;
	Описание = ОписаниеОбъектаСправочника(ДанныеИБ, Магазин, Ссылки);
	СвязанныеОбъекты = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		ПоместитьСвязанныйОбъект(Ссылка, Магазин, УжеДобавленные, СвязанныеОбъекты);
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("ОбъектМетаданных", "Справочник.АвтоматическиеСкидки");
	Данные.Вставить("Объект", Описание);
	Данные.Вставить("СвязанныеОбъекты", СвязанныеОбъекты);
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция МаршрутПодходитДляСкидки(Объект, Магазин)
	
	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Объект.ЭтоГруппа Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого СтрокаПолучателя Из Объект.ПолучателиСкидкиСклады Цикл
		Если СтрокаПолучателя.Получатель = Магазин Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция ИмяОбъектаВыгрузки(ДанныеИБ)
	
	ТипДанных = ТипЗнч(ДанныеИБ);
	Если ТипДанных = Тип("РегистрСведенийНаборЗаписей.ОстаткиТоваров") Тогда
		Возврат "РегистрСведений.ОстаткиТоваров";
	ИначеЕсли ТипДанных = Тип("СправочникОбъект.АвтоматическиеСкидки") Тогда
		Возврат "Справочник.АвтоматическиеСкидки";
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ЭтоВыгружаемыйОбъект(ИмяВТаблице, ИмяОбъекта)
	
	Имя = ВРег(СокрЛП(Строка(ИмяВТаблице)));
	Возврат Имя = ВРег(ИмяОбъекта) Или Имя = ВРег(ИмяСправочникаПоТипу(ИмяОбъекта));
	
КонецФункции

Функция ПрочитатьСообщениеБрокера(ТекстСообщения)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстСообщения);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Сообщение брокера не является объектом JSON'");
	КонецЕсли;
	Возврат Данные;
	
КонецФункции

Функция ИмяОбъектаСообщения(Данные)
	
	ИмяОбъекта = "";
	Если Данные.Свойство("ОбъектМетаданных") И ЗначениеЗаполнено(Данные.ОбъектМетаданных) Тогда
		ИмяОбъекта = Данные.ОбъектМетаданных;
	КонецЕсли;
	Возврат ИмяОбъекта;
	
КонецФункции

Процедура ЗаписатьДанныеАвтоматическойСкидки(Данные)
	
	Объект = Неопределено;
	Если Не Данные.Свойство("Объект", Объект) Или ТипЗнч(Объект) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В сообщении нет объекта автоматической скидки'");
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		СвязанныеОбъекты = Неопределено;
		Если Данные.Свойство("СвязанныеОбъекты", СвязанныеОбъекты) И ТипЗнч(СвязанныеОбъекты) = Тип("Массив") Тогда
			Для Каждого Описание Из СвязанныеОбъекты Цикл
				ЗаписатьОбъектСправочника(Описание);
			КонецЦикла;
		КонецЕсли;
		ЗаписатьОбъектСправочника(Объект);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПоместитьСвязанныйОбъект(Ссылка, Магазин, УжеДобавленные, СвязанныеОбъекты)
	
	Если Не ЗначениеЗаполнено(Ссылка) Или Не ЭтоСсылочноеЗначение(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтоСвязанныйСправочникСкидки(Ссылка.Метаданные().ПолноеИмя()) Тогда
		Возврат;
	КонецЕсли;
	
	Ключ = КлючСсылки(Ссылка);
	Если УжеДобавленные.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Ссылка.Метаданные().ПолноеИмя() = "Справочник.АвтоматическиеСкидки"
		И Не Объект.ЭтоГруппа
		И Не МаршрутПодходитДляСкидки(Объект, Магазин) Тогда
		Возврат;
	КонецЕсли;
	УжеДобавленные.Вставить(Ключ, Истина);
	
	Ссылки = Новый Массив;
	Описание = ОписаниеОбъектаСправочника(Объект, Магазин, Ссылки);
	Для Каждого СвязаннаяСсылка Из Ссылки Цикл
		ПоместитьСвязанныйОбъект(СвязаннаяСсылка, Магазин, УжеДобавленные, СвязанныеОбъекты);
	КонецЦикла;
	СвязанныеОбъекты.Добавить(Описание);
	
КонецПроцедуры

Функция ОписаниеОбъектаСправочника(Объект, Магазин, Ссылки)
	
	МетаданныеОбъекта = Объект.Метаданные();
	ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
	Группа = ЭтоГруппаСправочника(Объект);
	
	Описание = Новый Структура;
	Описание.Вставить("ОбъектМетаданных", ПолноеИмя);
	Описание.Вставить("УИД", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("ПометкаУдаления", Объект.ПометкаУдаления);
	Описание.Вставить("Код", Объект.Код);
	Описание.Вставить("Наименование", Объект.Наименование);
	Если МетаданныеОбъекта.Иерархический Тогда
		Описание.Вставить("Родитель", ОписаниеЗначения(Объект.Родитель, Ссылки));
	КонецЕсли;
	Если ИерархияГрупп(МетаданныеОбъекта) Тогда
		Описание.Вставить("ЭтоГруппа", Группа);
	КонецЕсли;
	Если МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
		Описание.Вставить("Владелец", ОписаниеЗначения(Объект.Владелец, Ссылки));
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Если Не РеквизитДоступен(Группа, Реквизит.Использование) Тогда
			Продолжить;
		КонецЕсли;
		Реквизиты.Вставить(Реквизит.Имя, ОписаниеЗначения(Объект[Реквизит.Имя], Ссылки));
	КонецЦикла;
	Описание.Вставить("Реквизиты", Реквизиты);
	
	ТабличныеЧасти = Новый Структура;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Если Не РеквизитДоступен(Группа, ТабличнаяЧасть.Использование) Тогда
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Для Каждого СтрокаТаблицы Из Объект[ТабличнаяЧасть.Имя] Цикл
			Если ПолноеИмя = "Справочник.АвтоматическиеСкидки"
				И ТабличнаяЧасть.Имя = "ПолучателиСкидкиСклады"
				И ЗначениеЗаполнено(Магазин)
				И СтрокаТаблицы.Получатель <> Магазин Тогда
				Продолжить;
			КонецЕсли;
			ОписаниеСтроки = Новый Структура;
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				ОписаниеСтроки.Вставить(Реквизит.Имя, ОписаниеЗначения(СтрокаТаблицы[Реквизит.Имя], Ссылки));
			КонецЦикла;
			Строки.Добавить(ОписаниеСтроки);
		КонецЦикла;
		ТабличныеЧасти.Вставить(ТабличнаяЧасть.Имя, Строки);
	КонецЦикла;
	Описание.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	
	ИмяРегистра = ИмяРегистраСостава(ПолноеИмя);
	Если Не ПустаяСтрока(ИмяРегистра) Тогда
		Описание.Вставить("ИмяРегистраСостава", "РегистрСведений." + ИмяРегистра);
		Описание.Вставить("Состав", ОписаниеСоставаРегистра(ИмяРегистра, Объект.Ссылка, Ссылки));
	КонецЕсли;
	Возврат Описание;
	
КонецФункции

Процедура ЗаписатьОбъектСправочника(Описание)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Описание объекта скидки повреждено'");
	КонецЕсли;
	
	ПолноеИмя = "";
	Описание.Свойство("ОбъектМетаданных", ПолноеИмя);
	ИмяСправочника = ИмяСправочникаПоТипу(ПолноеИмя);
	Если ПустаяСтрока(ИмяСправочника) Или Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный справочник сообщения: %1'"), ПолноеИмя);
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.Справочники[ИмяСправочника];
	Ссылка = СсылкаПоОписанию(Новый Структура("Тип, УИД", ПолноеИмя, ЗначениеОписания(Описание, "УИД")), Ложь);
	Группа = ИерархияГрупп(МетаданныеОбъекта) И Описание.Свойство("ЭтоГруппа") И Описание.ЭтоГруппа = Истина;
	
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если ЭтоГруппаСправочника(Объект) <> Группа Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Нельзя заменить группу и элемент %1 %2'"), ПолноеИмя, ЗначениеОписания(Описание, "УИД"));
		КонецЕсли;
	Иначе
		Если Группа Тогда
			Объект = Справочники[ИмяСправочника].СоздатьГруппу();
		Иначе
			Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
		КонецЕсли;
		Объект.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;
	
	Объект.ПометкаУдаления = Описание.Свойство("ПометкаУдаления") И Описание.ПометкаУдаления = Истина;
	Объект.Код = СтрокаЗначения(ЗначениеОписания(Описание, "Код"));
	Объект.Наименование = СтрокаЗначения(ЗначениеОписания(Описание, "Наименование"));
	Если МетаданныеОбъекта.Иерархический И Описание.Свойство("Родитель") Тогда
		Объект.Родитель = СсылкаПоОписанию(Описание.Родитель);
	КонецЕсли;
	Если МетаданныеОбъекта.Владельцы.Количество() > 0 И Описание.Свойство("Владелец") Тогда
		Объект.Владелец = СсылкаПоОписанию(Описание.Владелец);
	КонецЕсли;
	
	Реквизиты = Неопределено;
	Если Описание.Свойство("Реквизиты", Реквизиты) И ТипЗнч(Реквизиты) = Тип("Структура") Тогда
		Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
			Если Не РеквизитДоступен(Группа, Реквизит.Использование) Тогда
				Продолжить;
			КонецЕсли;
			Если Реквизиты.Свойство(Реквизит.Имя) Тогда
				Объект[Реквизит.Имя] = ЗначениеИзОписания(Реквизиты[Реквизит.Имя]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТабличныеЧасти = Неопределено;
	Если Описание.Свойство("ТабличныеЧасти", ТабличныеЧасти) И ТипЗнч(ТабличныеЧасти) = Тип("Структура") Тогда
		Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
			Если Не РеквизитДоступен(Группа, ТабличнаяЧасть.Использование) Тогда
				Продолжить;
			КонецЕсли;
			Строки = Неопределено;
			Если Не ТабличныеЧасти.Свойство(ТабличнаяЧасть.Имя, Строки) Или ТипЗнч(Строки) <> Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;
			Объект[ТабличнаяЧасть.Имя].Очистить();
			Для Каждого ОписаниеСтроки Из Строки Цикл
				СтрокаТаблицы = Объект[ТабличнаяЧасть.Имя].Добавить();
				Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
					Если ТипЗнч(ОписаниеСтроки) = Тип("Структура") И ОписаниеСтроки.Свойство(Реквизит.Имя) Тогда
						СтрокаТаблицы[Реквизит.Имя] = ЗначениеИзОписания(ОписаниеСтроки[Реквизит.Имя]);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ЭтоСкидка = ПолноеИмя = "Справочник.АвтоматическиеСкидки";
	Объект.ОбменДанными.Загрузка = Не ЭтоСкидка;
	Объект.Записать();
	Если ЭтоСкидка Тогда
		СнятьРегистрациюСправочника(Объект.Ссылка);
	КонецЕсли;
	
	ИмяРегистра = ИмяРегистраСостава(ПолноеИмя);
	Состав = Неопределено;
	Если Не ПустаяСтрока(ИмяРегистра) И Описание.Свойство("Состав", Состав) И ТипЗнч(Состав) = Тип("Массив") Тогда
		ЗаписатьСоставРегистра(ИмяРегистра, Объект.Ссылка, Состав);
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеЗначения(Значение, Ссылки)
	
	Если Значение = Неопределено Тогда
		Возврат Новый Структура("Тип", "Пусто");
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Новый Структура("Тип, Значение", "Дата", XMLСтрока(Значение));
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат Новый Структура("Тип, Данные", "ХранилищеЗначения", ЗначениеВСтрокуВнутр(Значение));
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Новый Структура("Тип, Значение", "УникальныйИдентификатор", Строка(Значение));
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		ИмяЗначения = "";
		Если ЗначениеЗаполнено(Значение) Тогда
			ИмяЗначения = XMLСтрока(Значение);
		КонецЕсли;
		Возврат Новый Структура("Тип, Значение", Значение.Метаданные().ПолноеИмя(), ИмяЗначения);
	ИначеЕсли ЭтоСсылочноеЗначение(Значение) Тогда
		Если ЗначениеЗаполнено(Значение) И Ссылки <> Неопределено Тогда
			Ссылки.Добавить(Значение);
		КонецЕсли;
		Возврат ОписаниеСсылки(Значение);
	КонецЕсли;
	
	Возврат Новый Структура("Тип, Данные", "Внутр", ЗначениеВСтрокуВнутр(Значение));
	
КонецФункции

Функция ЗначениеИзОписания(Описание)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Или Не Описание.Свойство("Тип") Тогда
		Возврат Описание;
	КонецЕсли;
	
	ТипЗначения = СокрЛП(Описание.Тип);
	Если ТипЗначения = "Пусто" Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = "Дата" Тогда
		Если Не Описание.Свойство("Значение") Или Не ЗначениеЗаполнено(Описание.Значение) Тогда
			Возврат Дата(1, 1, 1);
		КонецЕсли;
		Возврат XMLЗначение(Тип("Дата"), Описание.Значение);
	ИначеЕсли ТипЗначения = "ХранилищеЗначения" Или ТипЗначения = "Внутр" Тогда
		Возврат ЗначениеИзСтрокиВнутр(Описание.Данные);
	ИначеЕсли ТипЗначения = "УникальныйИдентификатор" Тогда
		Возврат Новый УникальныйИдентификатор(Описание.Значение);
	ИначеЕсли СтрНачинаетсяС(ТипЗначения, "Перечисление.") Тогда
		Имя = ИмяСправочникаПоТипу(ТипЗначения);
		Если Не Описание.Свойство("Значение") Или Не ЗначениеЗаполнено(Описание.Значение) Тогда
			Возврат Перечисления[Имя].ПустаяСсылка();
		КонецЕсли;
		Возврат XMLЗначение(Тип("ПеречислениеСсылка." + Имя), Описание.Значение);
	КонецЕсли;
	
	Ссылка = СсылкаПоОписанию(Описание, Ложь);
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.АвтоматическиеСкидки")
		И ЗначениеЗаполнено(Ссылка)
		И Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Справочники.АвтоматическиеСкидки.ПустаяСсылка();
	КонецЕсли;
	Если ЗначениеЗаполнено(Ссылка) И Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдена ссылка %1 %2'"), ТипЗначения, Описание.УИД);
	КонецЕсли;
	Возврат Ссылка;
	
КонецФункции

Функция СсылкаПоОписанию(Описание, ТребоватьСуществование = Истина)
	
	ТипМетаданных = "";
	УИД = "";
	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		Если Описание.Свойство("Тип") И ЗначениеЗаполнено(Описание.Тип) Тогда
			ТипМетаданных = СокрЛП(Описание.Тип);
		КонецЕсли;
		Если Описание.Свойство("УИД") Тогда
			УИД = СокрЛП(Строка(Описание.УИД));
		КонецЕсли;
	ИначеЕсли ТипЗнч(Описание) = Тип("Строка") Тогда
		УИД = СокрЛП(Описание);
	КонецЕсли;
	
	Если ПустаяСтрока(ТипМетаданных) Тогда
		ВызватьИсключение НСтр("ru = 'В описании ссылки не указан тип'");
	КонецЕсли;
	Если ЭтоПустойУникальныйИдентификатор(УИД) Тогда
		Возврат МенеджерПоТипу(ТипМетаданных).ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = XMLЗначение(ТипСсылкиПоИмени(ТипМетаданных), УИД);
	Если ТребоватьСуществование И Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдена ссылка %1 %2'"), ТипМетаданных, УИД);
	КонецЕсли;
	Возврат Ссылка;
	
КонецФункции

Функция МенеджерПоТипу(ТипМетаданных)
	
	Части = СтрРазделить(СокрЛП(ТипМетаданных), ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный тип ссылки %1'"), ТипМетаданных);
	КонецЕсли;
	
	Если Части[0] = "Справочник" Тогда
		Возврат Справочники[Части[1]];
	ИначеЕсли Части[0] = "Документ" Тогда
		Возврат Документы[Части[1]];
	ИначеЕсли Части[0] = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Части[1]];
	ИначеЕсли Части[0] = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Части[1]];
	ИначеЕсли Части[0] = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Части[1]];
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный тип ссылки %1'"), ТипМетаданных);
	
КонецФункции

Функция ТипСсылкиПоИмени(ТипМетаданных)
	
	Части = СтрРазделить(СокрЛП(ТипМетаданных), ".", Ложь);
	Префиксы = Новый Соответствие;
	Префиксы.Вставить("Справочник", "СправочникСсылка.");
	Префиксы.Вставить("Документ", "ДокументСсылка.");
	Префиксы.Вставить("ПланСчетов", "ПланСчетовСсылка.");
	Префиксы.Вставить("ПланВидовХарактеристик", "ПланВидовХарактеристикСсылка.");
	Префиксы.Вставить("ПланВидовРасчета", "ПланВидовРасчетаСсылка.");
	Префикс = Префиксы.Получить(Части[0]);
	Если Префикс = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный тип ссылки %1'"), ТипМетаданных);
	КонецЕсли;
	Возврат Тип(Префикс + Части[1]);
	
КонецФункции

Функция ЭтоСсылочноеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения);
	
КонецФункции

Функция ЭтоСвязанныйСправочникСкидки(ПолноеИмя)
	
	Возврат ПолноеИмя = "Справочник.АвтоматическиеСкидки"
		Или ПолноеИмя = "Справочник.УсловияПредоставленияСкидокНаценок"
		Или ПолноеИмя = "Справочник.СегментыНоменклатуры"
		Или ПолноеИмя = "Справочник.СегментыКонтрагентов"
		Или ПолноеИмя = "Справочник.ЦеновыеГруппы"
		Или ПолноеИмя = "Справочник.ШаблоныГенерацииПромокодов"
		Или ПолноеИмя = "Справочник.ВидыДисконтныхКарт"
		Или ПолноеИмя = "Справочник.ор_ПрефиксыДиапазоновКарт";
	
КонецФункции

Функция ЭтоГруппаСправочника(Объект)
	
	Если Не ИерархияГрупп(Объект.Метаданные()) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Объект.ЭтоГруппа;
	
КонецФункции

Функция ИерархияГрупп(МетаданныеОбъекта)
	
	Возврат МетаданныеОбъекта.Иерархический
		И МетаданныеОбъекта.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	
КонецФункции

Функция РеквизитДоступен(Группа, Использование)
	
	Если Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппыИЭлемента Тогда
		Возврат Истина;
	ИначеЕсли Группа Тогда
		Возврат Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы;
	КонецЕсли;
	Возврат Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента;
	
КонецФункции

Функция ИмяРегистраСостава(ПолноеИмя)
	
	Если ПолноеИмя = "Справочник.СегментыНоменклатуры" Тогда
		Возврат "СоставСегментаНоменклатуры";
	ИначеЕсли ПолноеИмя = "Справочник.СегментыКонтрагентов" Тогда
		Возврат "СоставСегментаКонтрагентов";
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ОписаниеСоставаРегистра(ИмяРегистра, Сегмент, Ссылки)
	
	ИменаПолей = ИменаПолейРегистра(Метаданные.РегистрыСведений[ИмяРегистра]);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ " + СтрСоединить(ИменаПолей, ", ")
		+ " ИЗ РегистрСведений." + ИмяРегистра + " ГДЕ Сегмент = &Сегмент";
	Запрос.УстановитьПараметр("Сегмент", Сегмент);
	
	Записи = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОписаниеЗаписи = Новый Структура;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			ОписаниеЗаписи.Вставить(ИмяПоля, ОписаниеЗначения(Выборка[ИмяПоля], Ссылки));
		КонецЦикла;
		Записи.Добавить(ОписаниеЗаписи);
	КонецЦикла;
	Возврат Записи;
	
КонецФункции

Процедура ЗаписатьСоставРегистра(ИмяРегистра, Сегмент, Состав)
	
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	ИменаПолей = ИменаПолейРегистра(МетаданныеРегистра);
	Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Набор.Отбор.Сегмент.Установить(Сегмент);
	Набор.ОбменДанными.Загрузка = Истина;
	Для Каждого ОписаниеЗаписи Из Состав Цикл
		Запись = Набор.Добавить();
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Если ТипЗнч(ОписаниеЗаписи) = Тип("Структура") И ОписаниеЗаписи.Свойство(ИмяПоля) Тогда
				Запись[ИмяПоля] = ЗначениеИзОписания(ОписаниеЗаписи[ИмяПоля]);
			КонецЕсли;
		КонецЦикла;
		Запись.Сегмент = Сегмент;
	КонецЦикла;
	Набор.Записать();
	
КонецПроцедуры

Функция ИменаПолейРегистра(МетаданныеРегистра)
	
	Имена = Новый Массив;
	Для Каждого Поле Из МетаданныеРегистра.Измерения Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

Процедура СнятьРегистрациюСправочника(Ссылка)
	
	ЭтотУзел = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.ЭтотУзел();
	Выборка = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка = ЭтотУзел Тогда
			Продолжить;
		КонецЕсли;
		ПланыОбмена.УдалитьРегистрациюИзменений(Выборка.Ссылка, Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Функция КлючСсылки(Ссылка)
	
	Возврат Ссылка.Метаданные().ПолноеИмя() + "|" + Строка(Ссылка.УникальныйИдентификатор());
	
КонецФункции

Функция СтрокаЗначения(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции

#КонецОбласти

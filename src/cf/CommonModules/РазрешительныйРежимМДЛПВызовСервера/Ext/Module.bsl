#Область АварийныйРежим

// Включает аварийный режим на определенное пользователем время;
// Аварийный режим подразумевает полное отключение запросов к ГИС МТ и розничную продажу
// отслеживаемых товарных групп без проверок разрешительного режима.
//
// Параметры:
//  СрокДействияВЧасах - Число - Срок включения аварийного режима в часах
//
Процедура ВключитьАварийныйРежимРазрешительнойСистемы(СрокДействияВЧасах = 0) Экспорт
	// ор ++
	УстановитьПривилегированныйРежим(Истина);
	// ор --
	
	Настройки = РазрешительныйРежимМДЛПКлиентСервер.НастройкиРазрешительногоРежима();
	
	УниверсальнаяДатаТекущая = ТекущаяУниверсальнаяДата();
	
	Если СрокДействияВЧасах = 0 И ЗначениеЗаполнено(Настройки.ЧастотаОбновленияCDNПлощадок) Тогда
		СрокДействияВЧасах = Настройки.ЧастотаОбновленияCDNПлощадок;
	ИначеЕсли СрокДействияВЧасах = 0 Тогда
		// пока нет особых рекомендаций, аварийный режим включается на сутки
		СрокДействияВЧасах = 24;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройки.АварийноеОтключенияРазрешительногоРежимаДоУниверсальнаяДата)
		И УниверсальнаяДатаТекущая < Настройки.АварийноеОтключенияРазрешительногоРежимаДоУниверсальнаяДата Тогда
		
		ДатаОкончанияАварийногоРежима = Настройки.АварийноеОтключенияРазрешительногоРежимаДоУниверсальнаяДата + СрокДействияВЧасах * 3600;
		
	Иначе
		ДатаОкончанияАварийногоРежима = УниверсальнаяДатаТекущая + СрокДействияВЧасах * 3600;
	КонецЕсли;
	
	Настройки.АварийноеОтключенияРазрешительногоРежимаДоУниверсальнаяДата = ДатаОкончанияАварийногоРежима;
	
	РазрешительныйРежимМДЛП.УстановитьНастройкиРазрешительногоРежима(Настройки);
	
	// ор ++
	ОбновитьПовторноИспользуемыеЗначения();
	УстановитьПривилегированныйРежим(Ложь);
	// ор --
КонецПроцедуры

// Отключает действие аварийного режима.
// Действие разрешительного режима возобновляется в штатном режиме.
//
Процедура ОтключитьАварийныйРежимРазрешительнойСистемы() Экспорт
	// ор ++
	УстановитьПривилегированныйРежим(Истина);
	// ор --
	
	Настройки = РазрешительныйРежимМДЛПКлиентСервер.НастройкиРазрешительногоРежима();
	
	Настройки.АварийноеОтключенияРазрешительногоРежимаДоУниверсальнаяДата = Дата(1, 1, 1);
	
	РазрешительныйРежимМДЛП.УстановитьНастройкиРазрешительногоРежима(Настройки);
	
	// ор ++
	ОбновитьПовторноИспользуемыеЗначения();
	УстановитьПривилегированныйРежим(Ложь);
	// ор --
КонецПроцедуры

#КонецОбласти // АварийныйРежим

#Область CDNПлощадки

Функция СортированнаяТаблицаCDNПлощадок() Экспорт
	
	Возврат РегистрыСведений.СостоянияCDNПлощадокМДЛП.СортированнаяТаблицаCDNПлощадок();
	
КонецФункции

Процедура ДобавитьCDNПлощадкиСОшибкамиОбменаВПараметрыСеанса(АдресПлощадки, МассивПлощадокКБлокировке, ЭтоОшибкаОтвета = Истина, ЭтоОтсутствиеОтвета = Ложь, ПлощадкаУжеДобавлена = Ложь) Экспорт
	
	ПлощадкиСОшибкамиОбмена = ПараметрыСеанса.CDNПлощадкиСОшибкамиОбменаМДЛП.Получить();
	
	Если ПлощадкиСОшибкамиОбмена = Неопределено Тогда
		
		ПлощадкиСОшибкамиОбмена = Новый Структура;
		ПлощадкиСОшибкамиОбмена.Вставить("ОшибкиПлощадки",      Новый Соответствие);
		ПлощадкиСОшибкамиОбмена.Вставить("НетОтветаПоПлощадке", Новый Соответствие);
		
	ИначеЕсли ТипЗнч(ПлощадкиСОшибкамиОбмена) = Тип("Массив") Тогда
		
		// Обратная совместимость - до изменения методических рекомендаций 15.11.2024 в площадках с ошибками обмена
		// был массив с площадками первых ошибок 500.
		ТекущийСписок = ОбщегоНазначения.СкопироватьРекурсивно(ПлощадкиСОшибкамиОбмена);
		
		ПлощадкиСОшибкамиОбмена = Новый Структура;
		ПлощадкиСОшибкамиОбмена.Вставить("ОшибкиПлощадки",      Новый Соответствие);
		ПлощадкиСОшибкамиОбмена.Вставить("НетОтветаПоПлощадке", Новый Соответствие);
		
		Для Каждого ТекущаяОшибочнаяПлощадка Из ТекущийСписок Цикл
			КоличествоОшибокПоПлощадке = 1;
			ПлощадкиСОшибкамиОбмена.ОшибкиПлощадки.Вставить(ТекущаяОшибочнаяПлощадка, КоличествоОшибокПоПлощадке);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтоОшибкаОтвета Тогда
		
		КоличествоОшибокПоПлощадке = ПлощадкиСОшибкамиОбмена.ОшибкиПлощадки.Получить(АдресПлощадки);
		Если КоличествоОшибокПоПлощадке = Неопределено Тогда
			
			// Первая ошибка 5хх или 429 по площадке.
			КоличествоОшибокПоПлощадке = 1;
			ПлощадкиСОшибкамиОбмена.ОшибкиПлощадки.Вставить(АдресПлощадки, КоличествоОшибокПоПлощадке);
			
		Иначе
			
			// Повторное получение ошибок по площадке.
			КоличествоОшибокПоПлощадке = КоличествоОшибокПоПлощадке + 1;
			ПлощадкиСОшибкамиОбмена.ОшибкиПлощадки.Вставить(АдресПлощадки, КоличествоОшибокПоПлощадке);
			
		КонецЕсли;
		
		МаксимальноеКоличествоОшибокПоПлощадкеДляБлокировки = 2;
		Если КоличествоОшибокПоПлощадке >= МаксимальноеКоличествоОшибокПоПлощадкеДляБлокировки Тогда
			
			МассивПлощадокКБлокировке.Добавить(АдресПлощадки);
			
			ПлощадкаУжеДобавлена = Истина;
			
		КонецЕсли;
		
	ИначеЕсли ЭтоОтсутствиеОтвета Тогда
		
		КоличествоТаймаутовПоПлощадке = ПлощадкиСОшибкамиОбмена.НетОтветаПоПлощадке.Получить(АдресПлощадки);
		Если КоличествоТаймаутовПоПлощадке = Неопределено Тогда
			
			// Первый таймаут по площадке.
			КоличествоТаймаутовПоПлощадке = 1;
			ПлощадкиСОшибкамиОбмена.НетОтветаПоПлощадке.Вставить(АдресПлощадки, КоличествоТаймаутовПоПлощадке);
			
		Иначе
			
			// Повторное получение таймаута по площадке.
			КоличествоТаймаутовПоПлощадке = КоличествоТаймаутовПоПлощадке + 1;
			ПлощадкиСОшибкамиОбмена.НетОтветаПоПлощадке.Вставить(АдресПлощадки, КоличествоТаймаутовПоПлощадке);
			
		КонецЕсли;
		
		МаксимальноеКоличествоТаймаутовПоПлощадкеДляБлокировки = 3;
		Если КоличествоТаймаутовПоПлощадке >= МаксимальноеКоличествоТаймаутовПоПлощадкеДляБлокировки Тогда
			
			МассивПлощадокКБлокировке.Добавить(АдресПлощадки);
			
			ПлощадкаУжеДобавлена = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыСеанса.CDNПлощадкиСОшибкамиОбменаМДЛП = Новый ХранилищеЗначения(ПлощадкиСОшибкамиОбмена);
	
КонецПроцедуры

Процедура ПеренестиCDNПлощадкиСОшибкамиИзПараметровСеансаВРегистр(МассивПлощадокКБлокировке) Экспорт
	
	РегистрыСведений.СостоянияCDNПлощадокМДЛП.ЗаблокироватьСписокПлощадок(МассивПлощадокКБлокировке);
	
	// Все блокировки перенесены в регистр, надо убрать заблокированные площадки из массива Параметра сеанса
	ПлощадкиСОшибкамиОбмена = ПараметрыСеанса.CDNПлощадкиСОшибкамиОбменаМДЛП.Получить();
	
	Для Каждого ПлощадкаСОшибками Из ПлощадкиСОшибкамиОбмена.ОшибкиПлощадки Цикл
		
		Если МассивПлощадокКБлокировке.Найти(ПлощадкаСОшибками.Ключ) <> Неопределено Тогда
			ПлощадкиСОшибкамиОбмена.ОшибкиПлощадки.Удалить(ПлощадкаСОшибками.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ПлощадкаСТаймаутами Из ПлощадкиСОшибкамиОбмена.НетОтветаПоПлощадке Цикл
		
		Если МассивПлощадокКБлокировке.Найти(ПлощадкаСТаймаутами.Ключ) <> Неопределено Тогда
			ПлощадкиСОшибкамиОбмена.НетОтветаПоПлощадке.Удалить(ПлощадкаСТаймаутами.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыСеанса.CDNПлощадкиСОшибкамиОбменаМДЛП = Новый ХранилищеЗначения(ПлощадкиСОшибкамиОбмена);
	
КонецПроцедуры

#КонецОбласти // CDNПлощадки

#Область ЛокальныйМодульЧЗ

Функция СортированнаяТаблицаЛокальныхМодулейЧестныйЗнак(Организация, РабочееМесто = Неопределено) Экспорт
	
	Возврат РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП.СортированнаяТаблицаЛокальныхМодулейЧестныйЗнак(Организация, РабочееМесто);
	
КонецФункции

// Настройки основного подключения локальному модулю честный знак по ККТ.
//
// Параметры:
//  ПодключаемоеОборудованиеККТ - СправочникСсылка.ПодключаемоеОборудование - ссылка на ККТ
//
// Возвращаемое значение:
//  Структура:
//   * НастроеноПодключение - Булево - Истина, если настроено подключение к ЛМ ЧЗ
//   * Настройки - см. НастройкиПодключенияЛокальныхМодулейМДЛП.КонструкторПодключенияЛокальногоМодуляЧестныйЗнак
//
Функция НастройкиОсновногоПодключенияЛокальномуМодулюЧестныйЗнакПоККТ(ПодключаемоеОборудованиеККТ) Экспорт
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПодключаемоеОборудованиеККТ, "Организация, РабочееМесто");
	
	Возврат НастройкиОсновногоПодключенияЛокальномуМодулюЧестныйЗнакПоОрганизацииРабочемуМесту(Реквизиты.Организация, Реквизиты.РабочееМесто);
	
КонецФункции

// Возвращает наиболее приоритетную настройку подключения по ТС ПИоТу.
// Параметры:
//  Организация  - ОпределяемыйТип.ОрганизацияБПО, СправочникСсылка.ОрганизацииМДЛП - организация для отправки запроса в ЛМ.
//  РабочееМесто - СправочникСсылка.РабочиеМеста - рабочее место для получения запроса.
// 
// Возвращаемое значение:
//  Структура:
//  * НастроеноПодключение - Булево - Истина, если настроено подключение к ЛМ ЧЗ
//  * Настройки - см. НастройкиПодключенияЛокальныхМодулейМДЛП.КонструкторПодключенияЛокальногоМодуляЧестныйЗнак
//
Функция НастройкиОсновногоПодключенияЛокальномуМодулюЧестныйЗнакПоОрганизацииРабочемуМесту(Организация, РабочееМесто = Неопределено) Экспорт
	
	ТипОрганизацииБПО = Метаданные.ОпределяемыеТипы.ОрганизацияБПО.Тип;
	Если ТипОрганизацииБПО.СодержитТип(ТипЗнч(Организация)) Тогда
		ОрганизацияМДЛП = ИнтеграцияМДЛПВызовСервера.ОрганизацияМДЛППоОрганизации(Организация);
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.ОрганизацииМДЛП") Тогда
		ОрганизацияМДЛП = Организация;
	Иначе
		ОрганизацияМДЛП = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОрганизацияМДЛП) Тогда
		ТекстОшибки = НСтр("ru = 'Не установлено однозначное соответствие организации ""%1"" в настройках соответсвий субъектов обращения для ИС МДЛП.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Организация);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП.НастройкиОсновногоПодключенияЛокальномуМодулюЧестныйЗнакПоОрганизацииРабочемуМесту(ОрганизацияМДЛП, РабочееМесто);
	
КонецФункции

// Зафиксировать факт продажи/возврата марок из списка в локальной базе Локального модуля Честный знак.
//
// Параметры:
//  ДанныеКодовМаркировки - Массив Из Строка - массив нормализованных кодов для записи в ЛМ ЧЗ
//  Операция - Строка - признак пробития чека возврата или продажи
//  НастройкиПодключенияЛокальногоМодуля - см. НастройкиПодключенияЛокальныхМодулейМДЛП.КонструкторПодключенияЛокальногоМодуляЧестныйЗнак
//
Процедура ЗафиксироватьФактПродажиВозвратаКодовМаркировки(ДанныеКодовМаркировки, Операция, НастройкиПодключенияЛокальногоМодуля) Экспорт
	
	РезультатФиксацииПродажи = РазрешительныйРежимМДЛПКлиентСервер.ЗафиксироватьФактПродажиВозвратаКодовМаркировки(ДанныеКодовМаркировки, Операция, НастройкиПодключенияЛокальногоМодуля);
	ТекстОшибки              = "";
	
	Если РезультатФиксацииПродажи.НезавершеннаяНастройкаЛМ Тогда
		
		ТекстОшибки = НСтр("ru = 'Настройка по Локальному модулю Честный знак не завершена.
			|Невозможно зафиксировать локально факт продажи/возврата марок.'");
		
	ИначеЕсли РезультатФиксацииПродажи.НекорректныеДанныеАвторизации Тогда
		
		ТекстОшибки = НСтр("ru = 'Некорректные данные авторизации в настройке Локального модуля Честный знак.
			|Невозможно зафиксировать локально факт продажи/возврата марок.'");
		
	ИначеЕсли РезультатФиксацииПродажи.ОтсутствиеСинхронизацииЛМ Тогда
		
		ТекстОшибки = НСтр("ru = 'Статус Локального модуля Честный знак - ошибка синхронизации.
			|Невозможно зафиксировать локально факт продажи/возврата марок.'");
		
	ИначеЕсли ЗначениеЗаполнено(РезультатФиксацииПродажи.ТекстОшибки) Тогда
		
		ТекстОшибки = РезультатФиксацииПродажи.ТекстОшибки;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		
		ИмяСобытия = НСтр("ru = 'Локальная фиксация факта продажи/возврата марок'", ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП,, ТекстОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ЛокальныйМодульЧЗ


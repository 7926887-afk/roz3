#Область Логирование

Функция ЗаписатьВЛогОтветРазрешительногоРежимаГИСМТ(АдресСервера, КодОшибки, ПолныйКодМаркировки, ТекстОтвета, ТекстЗапроса, ДатаПолученияЗапроса = Неопределено, ИдентификаторЗапросаРазрешения = "") Экспорт
	
	ПараметрыЗаписиВЛог = ПараметрыЗаписиОперацииПроверкиКМ();
	
	Если ДатаПолученияЗапроса = Неопределено Тогда
		ДатаПолученияЗапроса = ТекущаяУниверсальнаяДата();
	КонецЕсли;
	
	ПараметрыЗаписиВЛог.АдресСервераЗапросаРазрешения  = АдресСервера;
	ПараметрыЗаписиВЛог.ИдентификаторЗапросаРазрешения = ИдентификаторЗапросаРазрешения;
	ПараметрыЗаписиВЛог.ВремяЗапросаРазрешения         = ДатаПолученияЗапроса;
	ПараметрыЗаписиВЛог.ЗапросРазрешенияПродажиКМ      = Истина;
	ПараметрыЗаписиВЛог.КодОтветаРазрешения            = КодОшибки;
	ПараметрыЗаписиВЛог.КонтрольнаяМарка               = СтрЗаменить(ПолныйКодМаркировки, Символ(29), "'GS'");
	ПараметрыЗаписиВЛог.РезультатЗапросаРазрешения     = ТекстОтвета;
	ПараметрыЗаписиВЛог.ТекстЗапросаРазрешения         = ТекстЗапроса;
	
	Возврат ПараметрыЗаписиВЛог;
	
КонецФункции

Функция ПараметрыЗаписиОперацииПроверкиКМ()
	
	Если КонтрольКодовМаркировкиМДЛПКлиентСерверПовтИсп.ВерсияБПОПоддерживаетПроверкуКМЕдинымМетодом() Тогда
		
		МодульМенеджерОборудованияМаркировка = ОбщегоНазначения.ОбщийМодуль("МенеджерОборудованияМаркировка");
		Результат = МодульМенеджерОборудованияМаркировка.ПараметрыЗаписиОперацииПроверкиКМ();
		
	Иначе
		
		Результат = Новый Структура;
		Результат.Вставить("Наименование",                   "");
		Результат.Вставить("КонтрольнаяМарка",               "");
		Результат.Вставить("ЗапросРазрешенияПродажиКМ",      Истина);
		Результат.Вставить("АдресСервераЗапросаРазрешения",  "");
		Результат.Вставить("ТекстЗапросаРазрешения",         "");
		Результат.Вставить("КодОтветаРазрешения",            "");
		Результат.Вставить("РезультатЗапросаРазрешения",     "");
		Результат.Вставить("ИдентификаторЗапросаРазрешения", "");
		Результат.Вставить("ВремяЗапросаРазрешения",         Неопределено);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЛогироватьРезультатыОперацийПроверкиКМ(ДанныеДляЛогирования) Экспорт
	
	Если КонтрольКодовМаркировкиМДЛПКлиентСерверПовтИсп.ВерсияБПОПоддерживаетПроверкуКМЕдинымМетодом() Тогда
		
		Для Каждого ДанныеПоКМ Из ДанныеДляЛогирования Цикл
			
			МодульМенеджерОборудованияМаркировка = ОбщегоНазначения.ОбщийМодуль("МенеджерОборудованияМаркировка");
			МодульМенеджерОборудованияМаркировка.ДобавитьЗаписьВЖурналОперацийПроверкиКМ(ДанныеПоКМ);
			
		КонецЦикла;
		
	Иначе
		
		ШаблонИнформацииПоКМ = 
			НСтр("ru = 'Код ответа: [КодОтветаРазрешения]
				|Адрес сервера: [АдресСервераЗапросаРазрешения]
				|Текст запроса: [ТекстЗапросаРазрешения]
				|Текст ответа: [РезультатЗапросаРазрешения]
				|Идентификатор запроса: [ИдентификаторЗапросаРазрешения]
				|Время запроса: [ВремяЗапросаРазрешения]'");
		
		Для Каждого ДанныеПоКМ Из ДанныеДляЛогирования Цикл
			
			ТекстИнформацииПоКМ = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонИнформацииПоКМ, ДанныеПоКМ);
			
			КонтрольКодовМаркировкиМДЛПВызовСервера.ЗаписатьСобытиеВЖурналРегистрации(ТекстИнформацииПоКМ, СобытиеЖурналаРегистрацииПроверкиКМ());
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СобытиеЖурналаРегистрацииПроверкиКМ()
	
	Возврат НСтр("ru = 'Разрешительный режим.Операция проверки КМ'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

#КонецОбласти // Логирование

#Область Прочее

Функция ПолучитьНомерФискальногоНакопителяУстройства(ИдентификаторУстройства) Экспорт
	
	Если Не ОбщегоНазначенияБПО.ИспользуетсяЧекопечатающиеУстройства() Тогда
		Возврат "";
	КонецЕсли;
	
	МодульОборудованиеЧекопечатающиеУстройства = ОбщегоНазначения.ОбщийМодуль("ОборудованиеЧекопечатающиеУстройства");
	
	ПараметрыРегистрации = МодульОборудованиеЧекопечатающиеУстройства.ПараметрыРегистрацииУстройства(ИдентификаторУстройства);
	
	НомерФискальногоНакопителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыРегистрации, "ЗаводскойНомерФН");
	
	Если Не ЗначениеЗаполнено(НомерФискальногоНакопителя) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НомерФискальногоНакопителя;
	
КонецФункции

#КонецОбласти // Прочее

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

#Область ПрограммныйИнтерфейс

// Точка входа из РМК (ОплатитьКартойЗавершение / режим 4353).
// Сценарий продажи: РегистрацияЧека → выбор суммы → СписаниеБонусов → ОплатаПлатежнойкартойОстаток → ПодтверждениеЧека.
// По завершении в ДополнительныеПараметры (ПараметрыВыполнениеКоманды) и РезультатВыполнения
// записываются: СуммаСписанияСпасибо, НомерЧекаВСистемеСпасибо, ТекстСлипЧека, RRN.
//
Процедура ЗапросВБонусныйПроцессинг(РезультатВыполнения, ПараметрыВыполнениеКоманды) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда
	    Возврат;
	КонецЕсли;  
	
	НачатьСборЛоговСпасибо();
	
	ВидОперации = ПараметрыВыполнениеКоманды.Команда;
	
	ЭтоВозвратИлиОтмена = (ВидОперации = "AuthorizeVoid" Или ВидОперации = "AuthorizeRefund");
	
	Если ЭтоВозвратИлиОтмена Тогда
		ИдентификаторУстройства = ПараметрыВыполнениеКоманды.ЭквайринговыйТерминалВыполненияОперации;
	Иначе
		ИдентификаторУстройства = ПараметрыВыполнениеКоманды.ДанныеТерминала.ЭквайринговыйТерминал;
	КонецЕсли;
	
	ПараметрыТерминалаСпасибо = эвСберСпасибоСерверКеш.ПолучитьПараметрыТерминалаСпасибо(ИдентификаторУстройства);
	Если Не ПараметрыТерминалаКорректны(ПараметрыТерминалаСпасибо) Тогда
		ВывестиТекстОшибкиСпасибо(
			"Не указаны параметры СберСпасибо терминала: " + ИдентификаторУстройства,
			"ОплатаПлатежнойкартойОстаток",
			,
			"Попытка полной оплаты чека");
		Возврат;
	КонецЕсли;
	
	ДанныеКарты = ПолучитьДанныеКарты(ПараметрыТерминалаСпасибо.P_DistribPath + "\e");
	Хеш = ДанныеКарты.Хеш;
	НомерКарты = ДанныеКарты.НомерКарты;
	
	МаксимальнаяСуммаСкидки = 0;
	Если ВидОперации = "AuthorizeSales" И ПараметрыВыполнениеКоманды.Свойство("МаксСуммаОплатыСпасибо") Тогда
		
		МаксимальнаяСуммаСкидки = ПараметрыВыполнениеКоманды.МаксСуммаОплатыСпасибо;
		
		Если СтрДлина(Хеш) <> 40 Тогда
			ВывестиТекстОшибкиСпасибо(
				"Ошибка чтения ХЕШ карты (файл e): " + Хеш,
				"ОплатаПлатежнойкартойОстаток",
				,
				"Попытка полной оплаты чека");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыСписанияБонусов = НовыеПараметрыСписанияБонусов(
		ПараметрыВыполнениеКоманды,
		РезультатВыполнения,
		ПараметрыТерминалаСпасибо,
		МаксимальнаяСуммаСкидки,
		НомерКарты,
		Хеш,
		ВидОперации,
		ИдентификаторУстройства,
		ЭтоВозвратИлиОтмена);
	
	Если ВидОперации = "AuthorizeSales" Тогда
		ОбработатьПродажуAuthorizeSales(ПараметрыСписанияБонусов);
	ИначеЕсли ЭтоВозвратИлиОтмена Тогда
		ОбработатьВозвратИлиОтмену(ПараметрыСписанияБонусов);
	КонецЕсли;
	
КонецПроцедуры

// Вызов из МенеджерОборудованияСлужебныйКлиент.ОбработатьРезультат при AuthorizeRefund:
// обмен с процессингом и дополнение ТекстСлипЧека до печати. В РМК не возвращаемся.
//
Функция ОбработатьВозвратДоПечатиСлипа(Контекст, Команда, РезультатОперации) Экспорт
	
	Если Команда <> "AuthorizeRefund" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(РезультатОперации) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыВыполнениеКоманды = ПараметрыСпасибоВозвратаИзКонтекста(Контекст, РезультатОперации, Команда);
	
	ИдентификаторПС = "";
	Если ПараметрыВыполнениеКоманды.Свойство("ИдентификаторПС") Тогда
		ИдентификаторПС = ПараметрыВыполнениеКоманды.ИдентификаторПС;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИдентификаторПС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗапросВБонусныйПроцессинг(РезультатОперации, ПараметрыВыполнениеКоманды);
	
	Возврат Истина;
	
КонецФункции


Процедура ПолучитьРазмерБонусовКСписаниюОкончание(Результат, ПараметрыСписанияБонусов) Экспорт
	
	Если Результат = Неопределено Тогда
		Результат = Новый Структура("СуммаСписания, ОтменаСписания", 0, Истина);
	КонецЕсли;
	
	СуммаОперацииСпасибоПлан = 0;
	Если Результат.Свойство("СуммаСписания") Тогда
		СуммаОперацииСпасибоПлан = Результат.СуммаСписания;
	КонецЕсли;
	
	ПараметрыСписанияБонусов.Вставить("СуммаОперацииСпасибоПлан", СуммаОперацииСпасибоПлан);
	
	Если ЗапросВБонусныйПроцессингОкончание(ПараметрыСписанияБонусов) Тогда
		ВернутьсяВОплатуРМК(ПараметрыСписанияБонусов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиТекстОшибкиСпасибо(ТекстОшибки, ВидДействия, ПараметрыСписанияБонусов = Неопределено, ЗаголовокОкна = "") Экспорт
	
	Если ПараметрыСписанияБонусов = Неопределено Тогда
		СброситьЛогиСпасибоВФоне();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстОшибки", ТекстОшибки);
	ПараметрыФормы.Вставить("ВидДействия", ВидДействия);
	ПараметрыФормы.Вставить("ЗаголовокОкна", ЗаголовокОкна);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтработатьОшибкуСпасибо", ЭтотОбъект, ПараметрыСписанияБонусов);
	ОткрытьФорму(
		"ОбщаяФорма.эвФормаВыводаОперацийОтказаСпасибо",
		ПараметрыФормы,
		,
		Новый УникальныйИдентификатор,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

Процедура ОтработатьОшибкуСпасибо(Результат, ПараметрыСписанияБонусов) Экспорт
	
	ВидДействия = "";
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("ВидДействия") Тогда
		ВидДействия = Результат.ВидДействия;
	КонецЕсли;
	
	Если ВидДействия = "ОплатаПлатежнойкартойОстаток"
		Или ВидДействия = "ОплатаПлатежнойкартойСПодтверждением" Тогда
		
		Если ВидДействия = "ОплатаПлатежнойкартойСПодтверждением" Тогда
			ПараметрыСписанияБонусов.Вставить("РегистрацияЧекаСПодтверждением", Истина);
		КонецЕсли;
		
		Если ПродолжитьОплатуКартой(ПараметрыСписанияБонусов) Тогда
			ВернутьсяВОплатуРМК(ПараметрыСписанияБонусов);
		КонецЕсли;
		
	ИначеЕсли ВидДействия = "ОтменаЧекаВПроцессинге" Тогда
		
		ОтменаЧекаВПроцессинге(ПараметрыСписанияБонусов);
		ВернутьсяВОплатуРМК(ПараметрыСписанияБонусов);
		
	ИначеЕсли ВидДействия = "ОтменаЧекаВБазе" Тогда
		
		ПараметрыСписанияБонусов.ОписаниеОшибки = "Отказ от покупки, отмена чека!";
		ВернутьсяВОплатуРМК(ПараметрыСписанияБонусов);
		
	ИначеЕсли ВидДействия = "ВОчередьДляВозвратаБонусов" Тогда
		
		ВозвратЧекаВПроцессинге(ПараметрыСписанияБонусов);
		СброситьЛогиСпасибоВФоне();
		
	ИначеЕсли ПараметрыСписанияБонусов <> Неопределено Тогда
		
		Если ПродолжитьОплатуКартой(ПараметрыСписанияБонусов) Тогда
			ВернутьсяВОплатуРМК(ПараметрыСписанияБонусов);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Пробное соединение с процессингом Спасибо (как команда формы справочника параметров терминала).
// ПараметрыПроверки: АдресПроцессинга, АдресСертификата, ПарольСертификата, networks, partners.
//
Функция ПроверитьДоступКПроцессингу(ПараметрыПроверки) Экспорт
    
    РезультатПроверки = Новый Структура("Успех, ТекстСообщения", Ложь, "");
    
    Если ТипЗнч(ПараметрыПроверки) <> Тип("Структура") Тогда
        РезультатПроверки.ТекстСообщения = НСтр("ru = 'Не указаны параметры подключения к процессингу.'");
        Возврат РезультатПроверки;
    КонецЕсли;
    
    АдресПроцессинга = "";
    ПараметрыПроверки.Свойство("АдресПроцессинга", АдресПроцессинга);
    Если Не ЗначениеЗаполнено(АдресПроцессинга) Тогда
        РезультатПроверки.ТекстСообщения = НСтр("ru = 'Не заполнен адрес процессинга.'");
        Возврат РезультатПроверки;
    КонецЕсли;
    
    АдресСертификата = Неопределено;
    ПараметрыПроверки.Свойство("АдресСертификата", АдресСертификата);
    Если Не ЭтоАдресВременногоХранилища(АдресСертификата) Тогда
        РезультатПроверки.ТекстСообщения = НСтр("ru = 'Файл сертификата не указан. Выберите .pfx или запишите элемент.'");
        Возврат РезультатПроверки;
    КонецЕсли;
    
    ИмяФайлаСертификата = "";
    Соединение = Неопределено;
    
    Попытка
        
        ИмяФайлаСертификата = ПолучитьИмяВременногоФайла("pfx");
        ДвоичныеДанныеСертификата = ПолучитьИзВременногоХранилища(АдресСертификата);
        Если ДвоичныеДанныеСертификата = Неопределено Тогда
            ВызватьИсключение НСтр("ru = 'Не удалось получить двоичные данные сертификата из временного хранилища.'");
        КонецЕсли;
        ДвоичныеДанныеСертификата.Записать(ИмяФайлаСертификата);
        
        ПарольСертификата = "";
        ПараметрыПроверки.Свойство("ПарольСертификата", ПарольСертификата);
        
        СертификатКлиента = Новый СертификатКлиентаФайл(ИмяФайлаСертификата, ПарольСертификата);
        ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКлиента, Неопределено);
        
        Соединение = Новый HTTPСоединение(АдресПроцессинга,,,,,, ЗащищенноеСоединение);
        
        РесурсПроверки = РесурсДляПроверкиДоступаКПроцессингу(ПараметрыПроверки);
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        HTTPЗапрос = Новый HTTPЗапрос(РесурсПроверки, Заголовки);
        
        Ответ = Соединение.ВызватьHTTPМетод("GET", HTTPЗапрос);
        
        Попытка
       	 
       	 	РезультатПроверки.Успех = Ответ.КодСостояния < 400 ИЛИ Ответ.КодСостояния >= 500;
		
	        РезультатПроверки.ТекстСообщения = СтрШаблон(
	            НСтр("ru = 'Подключение к процессингу успешно.
	                |Адрес: %1
	                |Ресурс: %2
	                |HTTP-код: %3'"),
	            АдресПроцессинга,
	            РесурсПроверки,
	            Ответ.КодСостояния);
		
		Исключение
		
	        РезультатПроверки.ТекстСообщения = НСтр("ru = 'Ошибка соединения с процессингом Спасибо'")
	            + Символы.ПС
	            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
 		КонецПопытки;
       
    Исключение
        
        РезультатПроверки.Успех = Ложь;
        РезультатПроверки.ТекстСообщения = НСтр("ru = 'Ошибка соединения с процессингом Спасибо'")
            + Символы.ПС
            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        
    КонецПопытки;
    
    Соединение = Неопределено;
    Если ЗначениеЗаполнено(ИмяФайлаСертификата) Тогда
        Попытка
            УдалитьФайлы(ИмяФайлаСертификата);
        Исключение
            // Файл мог быть занят ОС — не мешает результату проверки.
        КонецПопытки;
    КонецЕсли;
    
    Возврат РезультатПроверки;
    
КонецФункции

Процедура ОбновитьНадписьДоступностиОплатыБонусами(Форма, СвязьУстановлена) Экспорт
    
    ИндикаторСпасибо = Форма.Элементы.Найти("НадписьДоступнаОплатаБонусамиСпасибо");
    Если ИндикаторСпасибо = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если СвязьУстановлена Тогда
        ИндикаторСпасибо.Картинка = БиблиотекаКартинок.ЗеленыйШар;
        ИндикаторСпасибо.Подсказка = НСтр("ru = 'Доступна оплата бонусами'");
    Иначе
        ИндикаторСпасибо.Картинка = БиблиотекаКартинок.КрасныйШар;
        ИндикаторСпасибо.Подсказка = НСтр("ru = 'Не доступно'");
    КонецЕсли;
    
КонецПроцедуры

Процедура ПроверитьСвязьСПроцессингомНаФормеРМК(Форма) Экспорт
    
    Если Не Форма.Доступность Тогда
        Возврат;
    КонецЕсли;
    
    ПараметрыПроверки = эвСберСпасибоСервер.эв_ПолучитьПараметрыПроверкиДоступаКПроцессингуПоКассеККМ(
        Форма.Объект.КассаККМ,
        Форма.УникальныйИдентификатор);
    РезультатПроверки = ПроверитьДоступКПроцессингу(ПараметрыПроверки);
    ОбновитьНадписьДоступностиОплатыБонусами(Форма, РезультатПроверки.Успех);
    
КонецПроцедуры

#КонецОбласти

#Область СценарийПродажи

Процедура ОбработатьПродажуAuthorizeSales(ПараметрыСписанияБонусов)
	
	// resetHold=Истина до успешного списания; после успешного bonusSpend станет Ложь.
	ПараметрыСписанияБонусов.Вставить("resetHold", Истина);
	ПараметрыСписанияБонусов.Вставить("СуммаОперацииСпасибо", 0);
	ПараметрыСписанияБонусов.Вставить("ТекстСлипЧека", "");
	
	РезультатРегистрации = РегистрацияЧека(ПараметрыСписанияБонусов);
	
	Если ЗначениеЗаполнено(РезультатРегистрации.НомерЧекаВСистемеСпасибо) Тогда
		ПараметрыСписанияБонусов.Вставить("НомерЧекаВСистемеСпасибо", РезультатРегистрации.НомерЧекаВСистемеСпасибо);
	КонецЕсли;
	
	Если ЕстьТекстОшибки(РезультатРегистрации) Тогда
		ВывестиТекстОшибкиСпасибо(
			РезультатРегистрации.ТекстОшибки,
			"ОплатаПлатежнойкартойСПодтверждением",
			ПараметрыСписанияБонусов);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыСписанияБонусов.МаксимальнаяСуммаСкидки > 0 Тогда
		ОткрытьВыборСуммыСписания(РезультатРегистрации, ПараметрыСписанияБонусов);
	Иначе
		// Списание недоступно локально — только начисление после оплаты остатка.
		ПолучитьРазмерБонусовКСписаниюОкончание(
			Новый Структура("СуммаСписания, ОтменаСписания", 0, Ложь),
			ПараметрыСписанияБонусов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьВыборСуммыСписания(РезультатРегистрации, ПараметрыСписанияБонусов)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НомерКарты", РезультатРегистрации.НомерКарты);
	ПараметрыФормы.Вставить("МинимальнаяСумма", РезультатРегистрации.МинимальнаяСумма);
	ПараметрыФормы.Вставить("МаксимальнаяСумма", РезультатРегистрации.МаксимальнаяСумма);
	ПараметрыФормы.Вставить("МаксимальнаяСуммаСкидки", РезультатРегистрации.МаксимальнаяСуммаСкидки);
	
	ВладелецФормы = Неопределено;
	Если ПараметрыСписанияБонусов.Свойство("ФормаВладелец") Тогда
		ВладелецФормы = ПараметрыСписанияБонусов.ФормаВладелец;
	КонецЕсли;
	
	Если ВладелецФормы <> Неопределено Тогда
		ВладелецФормы.эв_ОткрытьФормуСписанияБонусовСпасибо(ПараметрыФормы, ПараметрыСписанияБонусов);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьРазмерБонусовКСписаниюОкончание",
		ЭтотОбъект,
		ПараметрыСписанияБонусов);
	ОткрытьФорму(
		"ОбщаяФорма.эвСписаниеБонусовСпасибо",
		ПараметрыФормы,
		,
		Новый УникальныйИдентификатор,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

// Возвращает Истина, если сценарий дошёл до возврата в РМК (без ожидания формы ошибки).
//
Функция ЗапросВБонусныйПроцессингОкончание(ПараметрыСписанияБонусов) Экспорт
	
	Если ПараметрыСписанияБонусов.СуммаОперацииСпасибоПлан = 0 Тогда
		
		ПараметрыСписанияБонусов.Вставить("СуммаОперацииСпасибо", 0);
		ПараметрыСписанияБонусов.Вставить("ТекстСлипЧека", "");
		
	Иначе
		
		СписаниеБонусовРезультат = СписаниеБонусов(ПараметрыСписанияБонусов);
		
		Если ЕстьТекстОшибки(СписаниеБонусовРезультат) Тогда
			ПараметрыСписанияБонусов.Вставить("СуммаОперацииСпасибо", 0);
			ПараметрыСписанияБонусов.Вставить("ТекстСлипЧека", "");
			// resetHold остаётся Истина — hold при подтверждении будет сброшен.
			ВывестиТекстОшибкиСпасибо(
				СписаниеБонусовРезультат.ТекстОшибки,
				"ОплатаПлатежнойкартойОстаток",
				ПараметрыСписанияБонусов);
			Возврат Ложь;
		КонецЕсли;
		
		ПараметрыСписанияБонусов.Вставить("СуммаОперацииСпасибо", СписаниеБонусовРезультат.СуммаОперацииСпасибо);
		ПараметрыСписанияБонусов.Вставить("ТекстСлипЧека", СписаниеБонусовРезультат.ТекстСлипЧека);
		ПараметрыСписанияБонусов.СуммаОперации =
			ПараметрыСписанияБонусов.СуммаОперации - СписаниеБонусовРезультат.СуммаОперацииСпасибо;
		
	КонецЕсли;
	
	Возврат ПродолжитьОплатуКартой(ПараметрыСписанияБонусов);
	
КонецФункции

// Оплата остатка на терминале + confirmation (начисление). Истина — можно возвращаться в РМК.
//
Функция ПродолжитьОплатуКартой(ПараметрыСписанияБонусов)
	
	РезультатОплаты = ОплатаПлатежнойкартойОстаток(ПараметрыСписанияБонусов);
	
	Если ЕстьТекстОшибки(РезультатОплаты) Тогда
		
		ПараметрыСписанияБонусов.ОписаниеОшибки = РезультатОплаты.ТекстОшибки;
		
		ВывестиТекстОшибкиСпасибо(
			РезультатОплаты.ТекстОшибки,
			"ОтменаЧекаВПроцессинге",
			ПараметрыСписанияБонусов,
			"Продолжение операции невозможно!");
		Возврат Ложь;
	Иначе
	КонецЕсли;
	
	Если ПараметрыСписанияБонусов.Свойство("РегистрацияЧекаСПодтверждением")
		И ПараметрыСписанияБонусов.РегистрацияЧекаСПодтверждением Тогда
		РегистрацияЧека(ПараметрыСписанияБонусов, "PUT");
	Иначе
		ПодтверждениеЧека(ПараметрыСписанияБонусов);
	КонецЕсли;
	
	СобратьТекстСлипЧека(ПараметрыСписанияБонусов);
	Возврат Истина;
	
КонецФункции

Процедура СобратьТекстСлипЧека(ПараметрыСписанияБонусов)
	
	Если Не ПараметрыСписанияБонусов.Свойство("ТекстСлипЧекаОплаты") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСпасибо = "";
	Если ПараметрыСписанияБонусов.Свойство("ТекстСлипЧека") Тогда
		ТекстСпасибо = ПараметрыСписанияБонусов.ТекстСлипЧека;
	КонецЕсли;
	
	//2 слипа
	ЧастиСлипа = Новый Массив;
	ЧастиСлипа.Добавить(ПараметрыСписанияБонусов.ТекстСлипЧекаОплаты);
	ЧастиСлипа.Добавить("БОНУСЫ СПАСИБО");
	ЧастиСлипа.Добавить(ТекстСпасибо);
	ЧастиСлипа.Добавить("================================");
	
	ПараметрыСписанияБонусов.ТекстСлипЧекаОплаты = СтрСоединить(ЧастиСлипа, Символы.ПС);
	
КонецПроцедуры

#КонецОбласти

#Область ВозвратВРМК

// Записывает итоги Спасибо в ДополнительныеПараметры и РезультатВыполнения,
// затем продолжает типовую оплату в ФормаРМК.ОплатитьКартойЗавершение.
//
Процедура ВернутьсяВОплатуРМК(ПараметрыСписанияБонусов)
    
    СброситьЛогиСпасибоВФоне();
    
    РезультатВыполнения        = ИзвлечьРезультатВыполнения(ПараметрыСписанияБонусов);
    ПараметрыВыполненияКоманды = ИзвлечьПараметрыВыполненияКоманды(ПараметрыСписанияБонусов);
    
    ДанныеТерминала = Неопределено;
    Если ПараметрыВыполненияКоманды.Свойство("ДанныеТерминала") Тогда
        ДанныеТерминала = ПараметрыВыполненияКоманды.ДанныеТерминала;
    КонецЕсли;
    
    ВидОплаты = Неопределено;
    Если ПараметрыВыполненияКоманды.Свойство("ВидОплаты") Тогда
        ВидОплаты = ПараметрыВыполненияКоманды.ВидОплаты;
    КонецЕсли;
   
    ДополнительныеПараметры = Новый Структура;   
    ДополнительныеПараметры.Вставить("ДанныеТерминала", ДанныеТерминала);
    ДополнительныеПараметры.Вставить("ВидОплаты", ВидОплаты);
    
    ОписаниеОшибки = "";
    Если ПараметрыСписанияБонусов.Свойство("ОписаниеОшибки") Тогда
        ОписаниеОшибки = ПараметрыСписанияБонусов.ОписаниеОшибки;
    КонецЕсли;

    ТекстСлипЧека = "";
    Если ПараметрыСписанияБонусов.Свойство("ТекстСлипЧекаОплаты") Тогда
        ТекстСлипЧека = ПараметрыСписанияБонусов.ТекстСлипЧекаОплаты;
    КонецЕсли;
    
    НомерЧекаВСистемеСпасибо = "";
    Если ПараметрыСписанияБонусов.Свойство("НомерЧекаВСистемеСпасибо") Тогда
        НомерЧекаВСистемеСпасибо = ПараметрыСписанияБонусов.НомерЧекаВСистемеСпасибо;
    КонецЕсли;
    
    СуммаОперацииСпасибо = 0;
    Если ПараметрыСписанияБонусов.Свойство("СуммаОперацииСпасибо") Тогда
        СуммаОперацииСпасибо = ПараметрыСписанияБонусов.СуммаОперацииСпасибо;
    КонецЕсли;
    
    СуммаОперации = 0;
    Если ПараметрыСписанияБонусов.Свойство("СуммаОперации") Тогда
        СуммаОперации = ПараметрыСписанияБонусов.СуммаОперации;
    КонецЕсли;
    
    RRN = "";
    Если ПараметрыСписанияБонусов.Свойство("RRN") Тогда
        RRN = ПараметрыСписанияБонусов.RRN;
    КонецЕсли;
    
    РезультатВыполнения.ТекстСлипЧека = ТекстСлипЧека;
    РезультатВыполнения.ОписаниеОшибки = ОписаниеОшибки;
    
    Если ОписаниеОшибки = "" Тогда
	    РезультатВыполнения.Результат = Истина;
	КонецЕсли;                                 
	
    РезультатВыполнения.Вставить("СуммаОперации", СуммаОперации);
    РезультатВыполнения.Вставить("СуммаОперацииСпасибо", СуммаОперацииСпасибо);
    РезультатВыполнения.Вставить("ТекстСлипЧека", ТекстСлипЧека);
    РезультатВыполнения.Вставить("НомерЧекаВСистемеСпасибо", НомерЧекаВСистемеСпасибо);
    РезультатВыполнения.Вставить("RRN", RRN);
    
    //Если ЕстьСвойство(РезультатВыполнения, "НомерКарты") Тогда
    //    СтрокаОплаты.НомерПлатежнойКарты = РезультатВыполнения.НомерКарты;
    //КонецЕсли;
    //Если ЕстьСвойство(РезультатВыполнения, "НомерЧекаЭТ") Тогда
    //    СтрокаОплаты.НомерЧекаЭТ = РезультатВыполнения.НомерЧекаЭТ;
    //КонецЕсли;
    //Если ЕстьСвойство(РезультатВыполнения, "СсылочныйНомер") Тогда
    //    СтрокаОплаты.СсылочныйНомер = РезультатВыполнения.СсылочныйНомер;
    //КонецЕсли;
    //Если ЕстьСвойство(РезультатВыполнения, "ВидОплатыНаТерминалеКод") Тогда
    //    СтрокаОплаты.КодСпособаОплатыЭТ = Число(РезультатВыполнения.ВидОплатыНаТерминалеКод);
    //КонецЕсли;

    ФормаРМК = Неопределено;
    Если ПараметрыСписанияБонусов.Свойство("ФормаВладелец") Тогда
        ФормаРМК = ПараметрыСписанияБонусов.ФормаВладелец;
    КонецЕсли;
    
    Если ФормаРМК = Неопределено Тогда
        ВызватьИсключение НСтр("ru = 'Не передана форма РМК для завершения оплаты после Спасибо.'");
    КонецЕсли;
    
    ФормаРМК.эв_ОплатитьКартойЗавершениеПослеСпасибо(РезультатВыполнения, ДополнительныеПараметры);
    
КонецПроцедуры

Функция ИзвлечьПараметрыВыполненияКоманды(ПараметрыСписанияБонусов)
	
	Если ПараметрыСписанияБонусов.Свойство("ПараметрыВыполнениеКоманды") Тогда
		ПараметрыВыполнениеКоманды = ПараметрыСписанияБонусов.ПараметрыВыполнениеКоманды;
		ПараметрыСписанияБонусов.Удалить("ПараметрыВыполнениеКоманды");
		Возврат ПараметрыВыполнениеКоманды;
	КонецЕсли;
	
	Возврат Новый Структура;
	
КонецФункции

Функция ИзвлечьРезультатВыполнения(ПараметрыСписанияБонусов)
	
	Если ПараметрыСписанияБонусов.Свойство("РезультатВыполнения") Тогда
		РезультатВыполнения = ПараметрыСписанияБонусов.РезультатВыполнения;
		ПараметрыСписанияБонусов.Удалить("РезультатВыполнения");
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	Возврат Новый Структура;
	
КонецФункции

#КонецОбласти

#Область ВозвратИОтмена

Процедура ОбработатьВозвратИлиОтмену(ПараметрыСписанияБонусов)
	
	Если Не ЗначениеЗаполнено(ПараметрыСписанияБонусов.НомерЧекаВСистемеСпасибо) Тогда
		Возврат;
	КонецЕсли;
	
	ВозвратЧекаВПроцессинге(ПараметрыСписанияБонусов);
	
	ТекстСпасибо = "";
	Если ПараметрыСписанияБонусов.Свойство("ТекстСлипЧека") Тогда
		ТекстСпасибо = ПараметрыСписанияБонусов.ТекстСлипЧека;
	КонецЕсли;
	
	//2 слипа
	ЧастиСлипа = Новый Массив;
	ЧастиСлипа.Добавить(СокрЛП(ПараметрыСписанияБонусов.РезультатВыполнения.ТекстСлипЧека));
	ЧастиСлипа.Добавить("БОНУСЫ СПАСИБО");
	ЧастиСлипа.Добавить(ТекстСпасибо);
	ЧастиСлипа.Добавить("================================");
	
    СброситьЛогиСпасибоВФоне();

	ТекстСлипЧека = СтрСоединить(ЧастиСлипа, Символы.ПС);
	
    РезультатВыполнения        = ИзвлечьРезультатВыполнения(ПараметрыСписанияБонусов);
    ПараметрыВыполненияКоманды = ИзвлечьПараметрыВыполненияКоманды(ПараметрыСписанияБонусов);
    
    РезультатВыполнения.ТекстСлипЧека = ТекстСлипЧека;
    
КонецПроцедуры

Процедура ОтменаЧекаВПроцессинге(ПараметрыСписанияБонусов)
	
	ОтменаЧека(ПараметрыСписанияБонусов);
	
	ПараметрыСписанияБонусов.ТекстСлипЧека = ПараметрыСписанияБонусов.ТекстСлипЧека;
	
КонецПроцедуры

Процедура ВозвратЧекаВПроцессинге(ПараметрыСписанияБонусов)
	
	ВозвратЧекаРезультат = ВозвратТоваровПоЧеку(ПараметрыСписанияБонусов);
	ПараметрыСписанияБонусов.ТекстСлипЧека = ВозвратЧекаРезультат.ТекстСлипЧека;
	
КонецПроцедуры

Функция ПараметрыСпасибоВозвратаИзКонтекста(Контекст, РезультатОперации, Команда)
	
	ПараметрыВыполнениеКоманды = Новый Структура;
	
	Если ТипЗнч(Контекст.ДополнительныеПараметры) = Тип("Структура") Тогда
		Для Каждого КлючЗначение Из Контекст.ДополнительныеПараметры Цикл
			ПараметрыВыполнениеКоманды.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыВыполнениеКоманды.Вставить("Команда", Команда);
	
	СуммаОперацииЗаполнена = ПараметрыВыполнениеКоманды.Свойство("СуммаОперации")
		И ЗначениеЗаполнено(ПараметрыВыполнениеКоманды.СуммаОперации);
	Если Не СуммаОперацииЗаполнена Тогда
		Если РезультатОперации.Свойство("СуммаОперации") Тогда
			ПараметрыВыполнениеКоманды.Вставить("СуммаОперации", РезультатОперации.СуммаОперации);
		ИначеЕсли ТипЗнч(Контекст.ДанныеОперации) = Тип("Структура")
			И Контекст.ДанныеОперации.Свойство("СуммаОперации") Тогда
			ПараметрыВыполнениеКоманды.Вставить("СуммаОперации", Контекст.ДанныеОперации.СуммаОперации);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПараметрыВыполнениеКоманды;
	
КонецФункции


#КонецОбласти

#Область КонтекстИПроверки

Функция НовыеПараметрыСписанияБонусов(ПараметрыВыполнениеКоманды, РезультатВыполнения, ПараметрыТерминалаСпасибо, МаксимальнаяСуммаСкидки,  НомерКарты, Хеш, ВидОперации, ИдентификаторУстройства, ЭтоВозвратИлиОтмена)
	
	ПараметрыСписанияБонусов = Новый Структура;
	ПараметрыСписанияБонусов.Вставить("РезультатВыполнения",        РезультатВыполнения);
	ПараметрыСписанияБонусов.Вставить("ПараметрыВыполнениеКоманды", ПараметрыВыполнениеКоманды);
	ПараметрыСписанияБонусов.Вставить("СуммаОперации",              ?(ВидОперации = "AuthorizeSales", ПараметрыВыполнениеКоманды.СуммаОперации, РезультатВыполнения.СуммаОперации));
	ПараметрыСписанияБонусов.Вставить("МаксимальнаяСуммаСкидки",    МаксимальнаяСуммаСкидки);
	ПараметрыСписанияБонусов.Вставить("АдресПроцессинга",           ПараметрыТерминалаСпасибо.АдресПроцессинга);
	ПараметрыСписанияБонусов.Вставить("networks",                   ПараметрыТерминалаСпасибо.networks);
	ПараметрыСписанияБонусов.Вставить("partners",                   ПараметрыТерминалаСпасибо.partners);
	ПараметрыСписанияБонусов.Вставить("НомерТерминала",             ПараметрыТерминалаСпасибо.НомерТерминала);
	ПараметрыСписанияБонусов.Вставить("servicePointExtId",          ПараметрыТерминалаСпасибо.servicePointExtId);
	ПараметрыСписанияБонусов.Вставить("АдресСертификата",           ПараметрыТерминалаСпасибо.АдресСертификата);
	ПараметрыСписанияБонусов.Вставить("ПарольСертификата",          ПараметрыТерминалаСпасибо.ПарольСертификата);
	ПараметрыСписанияБонусов.Вставить("НомерКарты",                 НомерКарты);
	ПараметрыСписанияБонусов.Вставить("Хеш",                        Хеш);
	ПараметрыСписанияБонусов.Вставить("ВидОперации",                ВидОперации);
	ПараметрыСписанияБонусов.Вставить("RRN",                        "");              
	ПараметрыСписанияБонусов.Вставить("ИдентификаторУстройства",    ИдентификаторУстройства);  
	ПараметрыСписанияБонусов.Вставить("ТекстСлипЧека",              "");  
	ПараметрыСписанияБонусов.Вставить("P_DistribPath",              ПараметрыТерминалаСпасибо.P_DistribPath);
	ПараметрыСписанияБонусов.Вставить("ОписаниеОшибки",             "");
	
	Если ПараметрыВыполнениеКоманды.Свойство("ФормаВладелец") Тогда
		ПараметрыСписанияБонусов.Вставить("ФормаВладелец", ПараметрыВыполнениеКоманды.ФормаВладелец);
		ПараметрыВыполнениеКоманды.Удалить("ФормаВладелец");
	КонецЕсли;
	
	Если ВидОперации = "AuthorizeSales" Тогда
		
		СуммаБонусовВозврата = 0;
		
	ИНаче
		
		СуммаБонусовВозврата = ПараметрыВыполнениеКоманды.СуммаБонусовВозврата;
		
		Позиция = Найти(ПараметрыВыполнениеКоманды.ИдентификаторПС, "/");
		Если Позиция > 0 Тогда
			НомерЧекаВСистемеСпасибо = Лев(ПараметрыВыполнениеКоманды.ИдентификаторПС, Позиция - 1);
		Иначе
			НомерЧекаВСистемеСпасибо = ""; 
		КонецЕсли;
		
		ПараметрыСписанияБонусов.Вставить("НомерЧекаВСистемеСпасибо", НомерЧекаВСистемеСпасибо);
		ПараметрыСписанияБонусов.Вставить("СуммаОперацииСпасибо",     СуммаБонусовВозврата);
		
		ПараметрыВыполнениеКоманды.Удалить("ИдентификаторПС");
		//ПараметрыВыполнениеКоманды.Удалить("СуммаБонусовВозврата");
		
	КонецЕсли;
		
	Если НЕ ПараметрыТерминалаСпасибо.ОднаФиктивнаяПозиция Тогда
	
		ПараметрыСписанияБонусов.Вставить("Корзина", 
			СформироватьКорзинуКлиент(ПараметрыВыполнениеКоманды.Корзина, 
									  ПараметрыТерминалаСпасибо.МаксимальныйПроцентОплатыБонусами, СуммаБонусовВозврата, ЭтоВозвратИлиОтмена));
	
	КонецЕсли;
	
	Возврат ПараметрыСписанияБонусов;
	
КонецФункции

Функция ПараметрыТерминалаКорректны(ПараметрыТерминалаСпасибо)
	
	Если ПараметрыТерминалаСпасибо = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбязательныеПоля = СтрРазделить(
		"АдресПроцессинга,networks,partners,НомерТерминала,servicePointExtId,АдресСертификата",
		",");
	
	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		Если Не ПараметрыТерминалаСпасибо.Свойство(ИмяПоля)
			Или Не ЗначениеЗаполнено(ПараметрыТерминалаСпасибо[ИмяПоля]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПараметрыТерминалаСпасибо.Свойство("ПарольСертификата") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЕстьТекстОшибки(СтруктураОтвета)
	
	Возврат СтруктураОтвета.Свойство("ТекстОшибки") И СтрДлина(СтруктураОтвета.ТекстОшибки) > 0;
	
КонецФункции

#КонецОбласти
 
#Область КомандыПроцессинга

Функция РегистрацияЧека(ПараметрыСписанияБонусов, КомандаHTTP = "POST") Экспорт
	
	СтруктураОтвета = СтруктураОтвета();

	// 1. Регистрация чека (purchases) - корзина, хэш, сумма покупки
	//Метод позволяет зарегистрировать чек продажи. В случае успеха, возвращает http status CREATED (201)
	
	Если ПараметрыСписанияБонусов.Свойство("Корзина") Тогда
		МассивСтруктурЧека = ПараметрыСписанияБонусов.Корзина;
	Иначе	
		МассивСтруктурЧека = ВернутьСтруктуруЧекаСФиктивнойПозицией(ПараметрыСписанияБонусов.СуммаОперации);
	КонецЕсли;
	
	Ресурс  = СтрШаблон("/networks/%1/partners/%2/purchases/", ПараметрыСписанияБонусов.networks, ПараметрыСписанияБонусов.partners);
	
	identity = Новый Структура;
	identity.Вставить("type", "HASH");
	identity.Вставить("id",   ПараметрыСписанияБонусов.Хеш);
	
	attributes = Новый Массив;
	attribut = Новый Структура("name,value");
	attribut.name  = "PAN4";
	attribut.value = ПараметрыСписанияБонусов.НомерКарты;
	attributes.Добавить(attribut);
	
	
	Данные = Новый Структура;
	Данные.Вставить("externalId",        СтрЗаменить(Новый УникальныйИдентификатор(),"-",""));
	Данные.Вставить("servicePointExtId", ПараметрыСписанияБонусов.servicePointExtId);			
	Данные.Вставить("terminal",          ПараметрыСписанияБонусов.НомерТерминала);			
	Данные.Вставить("productPositions",  МассивСтруктурЧека);			
	Данные.Вставить("purchaseDate",      СокрлП(Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс""")+"+03:00"));			
	Данные.Вставить("currency",          "810");			
	Данные.Вставить("identity",          identity);			
	
	Если КомандаHTTP = "PUT" Тогда 
		СтруктураВидовОплат = Новый Структура;
		СтруктураВидовОплат.Вставить("bankCardAmount", ПараметрыСписанияБонусов.СуммаОперации);
		Данные.Вставить("payments",  СтруктураВидовОплат);
		
		attribut = Новый Структура("name,value");
		attribut.name  = "RRN";
		attribut.value = ПараметрыСписанияБонусов.RRN;
		attributes.Добавить(attribut);

	КонецЕсли;
	
	Данные.Вставить("attributes",        attributes);			
	
	Ответ  = ОтправитьHTTPзапрос(ПараметрыСписанияБонусов, Ресурс, Данные, КомандаHTTP);	
	
	КодСостояния = Ответ.КодСостояния;  
	
	//КодСостояния = ?(КомандаHTTP = "POST",404,КодСостояния); // Для эмуляции ошибки 6.1
	
	Если (КодСостояния = 201 ИЛИ КодСостояния = 200) Тогда
		
		Если Ответ.Свойство("status") И Ответ.status = "NEW" Тогда
		    // Регистрация
			СтруктураОтвета.status = Ответ.status;   
			
			СтруктураОтвета.Вставить("НомерЧекаВСистемеСпасибо", СтрЗаменить(Ответ.receiptId, Символы.НПП,""));
			
			ПричинаЗапретаСписанияБаллов = Ответ.bonusSpendForbidden;
			
			//ПричинаЗапретаСписанияБаллов = "IDENTITY_RESTRICTION";  // Тест 2.2
			
			Если ПричинаЗапретаСписанияБаллов = "IDENTITY_RESTRICTION" ИЛИ 
				ПричинаЗапретаСписанияБаллов = "IDENTITY_STATE_RESTRICTION" ИЛИ
				ПричинаЗапретаСписанияБаллов = "RULES_RESTRICTION" Тогда
				
				// Списание не возможно, сообщаем и переходим к полной оплате, если согласен         currency (не может быть пусто); identity (должно быть задано)
				СтруктураОтвета.ТекстОшибки = "2.2 Запрет списания бонусов Спасибо " + ПричинаЗапретаСписанияБаллов;
				СтруктураОтвета.ВидДействия = "ОплатаПлатежнойкартойОстаток"; 
				
			Иначе
				
				СтруктураОтвета.МинимальнаяСумма        = Ответ.minBonusDiscount;
				СтруктураОтвета.МаксимальнаяСумма       = Ответ.maxBonusDiscount;
				СтруктураОтвета.НомерКарты              = ПараметрыСписанияБонусов.НомерКарты;
				СтруктураОтвета.МаксимальнаяСуммаСкидки = ПараметрыСписанияБонусов.МаксимальнаяСуммаСкидки;
				
			КонецЕсли;
			
		ИначеЕсли Ответ.Свойство("status") И Ответ.status = "CLD" Тогда	
			
			СтруктураОтвета.status = Ответ.status;

			СтруктураОтвета.СуммаОперацииСПАСИБО = 0; 

		ИНаче
			СтруктураОтвета.ТекстОшибки = "2.2 Запрет списания бонусов Спасибо";
			СтруктураОтвета.ВидДействия = ?(КомандаHTTP = "POST","ОплатаПлатежнойкартойОстаток","ВОчередьДляНачисленияБонусов"); 
		КонецЕсли;
		
	Иначе 
		
		Если НЕ КодСостояния = 201 Тогда       
			
			errorCode = "";
			
			СтруктураОтвета.ТекстОшибки = "6.1 Ошибка связи с процессингом Спасибо";
			
			СтруктураОтвета.ВидДействия = ?(КомандаHTTP = "POST","ОплатаПлатежнойкартойОстаток","ВОчередьДляНачисленияБонусов");
			
			Если Ответ.Свойство("errorCode") Тогда 
				errorCode = СокрЛП(Ответ.errorCode);
				СтруктураОтвета.ТекстОшибки = СтруктураОтвета.ТекстОшибки + ": " + errorCode + ", " + Ответ.message;
			КонецЕсли;    
			
			Если КомандаHTTP = "PUT" Тогда
				Если (КодСостояния = 500 ИЛИ КодСостояния = 503 ИЛИ КодСостояния = 422) И 
					(errorCode = "IDENTITY_NOT_FOUND" ИЛИ errorCode = "CARD_NOT_FOUND" ИЛИ errorCode = "REG_ID_IS_BUSY") Тогда
					
					// Таблица 2. Основные параметры - подключение к API Бонусный процессинг АО "ЦПЛ" из ТЗ
					// ставим в очередь регистрацию с подтверждением
					
					ПараметрыОчереди = Новый Структура;
					ПараметрыОчереди.Вставить("end_point",   ПараметрыСписанияБонусов.АдресПроцессинга);
					ПараметрыОчереди.Вставить("service",     Ресурс);
					ПараметрыОчереди.Вставить("metod",       "PUT");
					ПараметрыОчереди.Вставить("body",        Данные);
					ПараметрыОчереди.Вставить("Терминал",    ПараметрыСписанияБонусов.ИдентификаторУстройства);
					ПараметрыОчереди.Вставить("http_status", "400");
					ПараметрыОчереди.Вставить("ТекстОшибки", Строка(КодСостояния) + ": " + СтруктураОтвета.ТекстОшибки);
					
					эвСберСпасибоСервер.СохранитьЗапросВОчереди(ПараметрыОчереди);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции
Функция СписаниеБонусов(ПараметрыСписанияБонусов) Экспорт 
	
	// 3. Списание бонусов (bonusSpend) – скидка бонусами
	СтруктураОтвета = СтруктураОтвета();
	
	Ресурс  = СтрШаблон("/networks/%1/partners/%2/purchases/%3/bonusSpend", 
		ПараметрыСписанияБонусов.networks, 
		ПараметрыСписанияБонусов.partners, 
		ПараметрыСписанияБонусов.НомерЧекаВСистемеСпасибо);
	
	Данные = Новый Структура;
	Данные.Вставить("desiredDiscountAmount",  ПараметрыСписанияБонусов.СуммаОперацииСпасибоПлан);			
	Данные.Вставить("holdDate",               СокрлП(Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс""")+"+03:00"));			

	Ответ  = ОтправитьHTTPзапрос(ПараметрыСписанияБонусов, Ресурс, Данные, "PUT");	
	
	КодСостояния = Ответ.КодСостояния;
	
	//КодСостояния = 404;  // Эмуляция ошибки 6.2
	
	Если Ответ.Свойство("message") Тогда
		// Ошибка может прийти и при HTTP 200
		СтруктураОтвета.ТекстОшибки = "6.2 Ошибка связи с процессингом Спасибо " + СокрЛП(Ответ.message);
		СтруктураОтвета.ВидДействия = "ОплатаПлатежнойкартойОстаток";

	ИначеЕсли КодСостояния = 200 Тогда
		ТекстСлипЧека = "";
		Если Ответ.Свойство("bonusChange") Тогда
			СтруктураОтвета.СуммаОперацииСпасибо = -Ответ.bonusChange.active;
			ТекстСлипЧека = СтрШаблон("Списано %1 %2Спасибо%2",  Формат(-Ответ.bonusChange.active, "ЧЦ=10; ЧДЦ=2"), Символ(34));
		КонецЕсли;
		СтруктураОтвета.ТекстСлипЧека = ТекстСлипЧека;
		ПараметрыСписанияБонусов.resetHold = Ложь;

	ИначеЕсли Ответ.Свойство("error") Тогда
		СтруктураОтвета.ТекстОшибки = "6.2 Ошибка связи с процессингом Спасибо " + СокрЛП(Ответ.error);
		СтруктураОтвета.ВидДействия = "ОплатаПлатежнойкартойОстаток";
	Иначе
		СтруктураОтвета.ТекстОшибки = "6.2 Ошибка связи с процессингом Спасибо";
		СтруктураОтвета.ВидДействия = "ОплатаПлатежнойкартойОстаток";
	КонецЕсли;		
	
	Возврат СтруктураОтвета;
	
КонецФункции
Функция ПодтверждениеЧека(ПараметрыСписанияБонусов) Экспорт
	
	СтруктураОтвета = СтруктураОтвета();
	
	//Подтверждение чека (confirmation) - сумма по карте (остаток после списания скидки)
	//Метод позволяет закрыть чек с проведением операции по начислению бонусов.
	
	// Подтверждение чека
	//PUT %URL%/networks/{networkId}/partners/{partnerId}/purchases/{receiptId}/confirmation
	
	Ресурс  = СтрШаблон("/networks/%1/partners/%2/purchases/%3/confirmation", ПараметрыСписанияБонусов.networks, ПараметрыСписанияБонусов.partners, ПараметрыСписанияБонусов.НомерЧекаВСистемеСпасибо);
	
	payments = Новый Структура;
	payments.Вставить("cashAmount",           0);
	payments.Вставить("bankCardAmount",       ПараметрыСписанияБонусов.СуммаОперации);
	payments.Вставить("foreignBankCardAmount",0);
	payments.Вставить("giftCardAmount",       0);
	payments.Вставить("creditAmount",         0);
	payments.Вставить("otherAmount",          0);
	
	Данные = Новый Структура;
	Данные.Вставить("confirmDate",             СокрлП(Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс""")+"+03:00"));			
	Данные.Вставить("payments",                payments);			
	Данные.Вставить("resetHold",               ПараметрыСписанияБонусов.resetHold);	//Ставится в Истину при ошибке 6.2 Ошибка связи при списании		
	
	attributes = Новый Массив;
	attribut = Новый Структура("name,value");
	attribut.name  = "RRN";
	attribut.value = ПараметрыСписанияБонусов.RRN;
	attributes.Добавить(attribut);
	Данные.Вставить("attributes",        attributes);			
	
	Ответ  = ОтправитьHTTPзапрос(ПараметрыСписанияБонусов, Ресурс, Данные, "PUT");	
	
	КодСостояния = Ответ.КодСостояния;
	
	//КодСостояния = 404;  // Эмуляция ошибки 6.3
	
	Если КодСостояния = 200 Тогда
		//	// Продолжить оплату оставшейся суммы чека, распределение скидки по товарам, фискализация
		
		Если Ответ.Свойство("bonusChange") Тогда  
			
			СлипНачисления = СтрШаблон("Начислено %1 %2Спасибо%2",  Формат(Ответ.bonusChange.active, "ЧЦ=10; ЧДЦ=2"), Символ(34));

			ПараметрыСписанияБонусов.ТекстСлипЧека = ПараметрыСписанияБонусов.ТекстСлипЧека 
			+  Символы.ПС + СлипНачисления;  
			
		КонецЕсли;
		
	ИначеЕсли Ответ.Свойство("error") Тогда
		// Предлагаем оплатить полностью или отказаться от покупки       
		СтруктураОтвета.ТекстОшибки = "6.3 Постановка запроса в очередь " + Строка(Ответ.error);
		
	ИначеЕсли Ответ.Свойство("message") Тогда
		// Предлагаем оплатить полностью или отказаться от покупки       
		СтруктураОтвета.ТекстОшибки = "6.3 Постановка запроса в очередь " + Строка(Ответ.message);
	Иначе
		СтруктураОтвета.ТекстОшибки = "6.3 Постановка запроса в очередь";
	КонецЕсли;		
	
	Если СтруктураОтвета.Свойство("ТекстОшибки") И СтрДлина(СтруктураОтвета.ТекстОшибки) > 0 Тогда
		
		ПараметрыОчереди = Новый Структура;
		ПараметрыОчереди.Вставить("end_point",   ПараметрыСписанияБонусов.АдресПроцессинга);
		ПараметрыОчереди.Вставить("service",     Ресурс);
		ПараметрыОчереди.Вставить("metod",       "PUT");
		ПараметрыОчереди.Вставить("body",        Данные);
		ПараметрыОчереди.Вставить("Терминал",    ПараметрыСписанияБонусов.ИдентификаторУстройства);
		ПараметрыОчереди.Вставить("http_status", "400");
		//ПараметрыОчереди.Вставить("Заголовки",   Заголовки);
		ПараметрыОчереди.Вставить("ТекстОшибки", Строка(КодСостояния) + ": " + СтруктураОтвета.ТекстОшибки);		
		
		эвСберСпасибоСервер.СохранитьЗапросВОчереди(ПараметрыОчереди);
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ОтменаЧека(ПараметрыСписанияБонусов) Экспорт
	//Отмена чека (cancelation)
	//Метод позволяет перевести статус чека в значение "Отменен". Если в рамках чека были списаны бонусы - они будут возвращены.
	
	СтруктураОтвета = СтруктураОтвета();

	// Отменяем введенное значение бонусов
	//PUT %URL%/networks/{networkId}/partners/{partnerId}/purchases/{receiptId}/cancelation
	
	Ресурс  = СтрШаблон("/networks/%1/partners/%2/purchases/%3/cancelation", ПараметрыСписанияБонусов.networks, ПараметрыСписанияБонусов.partners, ПараметрыСписанияБонусов.НомерЧекаВСистемеСпасибо);
	
	Ответ  = ОтправитьHTTPзапрос(ПараметрыСписанияБонусов, Ресурс, Неопределено, "PUT");	
	
	Результат = Ложь;
	Если Строка(Ответ.КодСостояния) = "200" Тогда
        // Отменили, ничего не требуется
		ПараметрыСписанияБонусов.СуммаОперации = ПараметрыСписанияБонусов.СуммаОперацииСпасибо + ПараметрыСписанияБонусов.СуммаОперации;
		ПараметрыСписанияБонусов.СуммаОперацииСпасибо = 0;
	Иначе
		// Ставим задачу в очередь
		СтруктураОтвета.ТекстОшибки = "3.1 Отмена чека " + ?(Ответ.Свойство("message"),СокрЛП(Ответ.message),""); 
		
		ПараметрыОчереди = Новый Структура;
		ПараметрыОчереди.Вставить("end_point",   ПараметрыСписанияБонусов.АдресПроцессинга);
		ПараметрыОчереди.Вставить("service",     Ресурс);
		ПараметрыОчереди.Вставить("metod",       "PUT");
		ПараметрыОчереди.Вставить("body",        "");
		ПараметрыОчереди.Вставить("Терминал",    ПараметрыСписанияБонусов.ИдентификаторУстройства);
		ПараметрыОчереди.Вставить("http_status", "400");
		//ПараметрыОчереди.Вставить("Заголовки",   Заголовки);
		ПараметрыОчереди.Вставить("ТекстОшибки", Строка(Ответ.КодСостояния) + ": " + СтруктураОтвета.ТекстОшибки);	
		
		эвСберСпасибоСервер.СохранитьЗапросВОчереди(ПараметрыОчереди);

	КонецЕсли;		
	
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ВозвратТоваровПоЧеку(ПараметрыСписанияБонусов) Экспорт
	
	//Возврат товаров по чеку (refunds)
	//Метод позвляет вернуть товары по чеку с проведением бонусной операции по возврату начисленных и списанных бонусов.
	//pcBonusDiscount - сумма бонусов к возврату, bankCardAmount - сумма возврата, равная сумме продажи.
	СтруктураОтвета = СтруктураОтвета();

	Если ПараметрыСписанияБонусов.Свойство("Корзина") Тогда
		МассивСтруктурЧека = ПараметрыСписанияБонусов.Корзина;
	Иначе	
		МассивСтруктурЧека = ВернутьСтруктуруЧекаСФиктивнойПозицией(ПараметрыСписанияБонусов.СуммаОперации, ПараметрыСписанияБонусов.СуммаОперацииСпасибо);
	КонецЕсли;

	Ресурс  = СтрШаблон("/networks/%1/partners/%2/purchases/%3/refunds", ПараметрыСписанияБонусов.networks, ПараметрыСписанияБонусов.partners, ПараметрыСписанияБонусов.НомерЧекаВСистемеСпасибо);
	
	Данные = Новый Структура;
	Данные.Вставить("externalId",        СтрЗаменить(Новый УникальныйИдентификатор(),"-",""));
	Данные.Вставить("servicePointExtId", ПараметрыСписанияБонусов.servicePointExtId);			
	Данные.Вставить("terminal",          ПараметрыСписанияБонусов.НомерТерминала);			
	Данные.Вставить("productPositions",  МассивСтруктурЧека);			
	Данные.Вставить("refundDate",        СокрлП(Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс""")+"+03:00"));			
	
	СтруктураВидовОплат = Новый Структура;
	СтруктураВидовОплат.Вставить("bankCardAmount", ПараметрыСписанияБонусов.СуммаОперации);
	Данные.Вставить("payments",  СтруктураВидовОплат);			
	
	attributes = Новый Массив;

	attribut = Новый Структура("name,value");
	attribut.name  = "PAN4";
	attribut.value = ПараметрыСписанияБонусов.НомерКарты;
	attributes.Добавить(attribut);
	
    RRN = ВернутьRRNизФайлаР(ПараметрыСписанияБонусов.P_DistribPath);

	attribut = Новый Структура("name,value");
	attribut.name  = "RRN";
	attribut.value = RRN;
	attributes.Добавить(attribut);
	
	Данные.Вставить("attributes",  attributes);			
	
	Ответ  = ОтправитьHTTPзапрос(ПараметрыСписанияБонусов, Ресурс, Данные, "PUT");	
	
	Если Ответ.КодСостояния = 200 Тогда    
		
		Если Ответ.Свойство("receiptMessage") Тогда 
			ТекстСлипЧека = СтрШаблон("Возвращено %1 %2Спасибо%2", ПараметрыСписанияБонусов.СуммаОперацииСпасибо, Символ(34)) + Символы.ПС;
			receiptMessage = Ответ.receiptMessage;
			Для к=1 По СтрЧислоСтрок(receiptMessage)-2 Цикл
				СтрокаСлипа = СтрПолучитьСтроку(receiptMessage, к);
				Если СтрНайти(нрег(СтрокаСлипа), "списано") > 0 Тогда
				     ТекстСлипЧека = ТекстСлипЧека + СтрокаСлипа;
					 Прервать;
				КонецЕсли;
				//ТекстСлипЧека = ТекстСлипЧека + СтрПолучитьСтроку(receiptMessage, к) + ?(к = СтрЧислоСтрок(receiptMessage)-2, "", Символы.ПС);
			КонецЦикла;
			СтруктураОтвета.ТекстСлипЧека = ТекстСлипЧека; 
		КонецЕсли;
		Если Ответ.Свойство("pcBonusDiscount") Тогда
			СтруктураОтвета.СуммаОперацииСпасибо = Ответ.creditedBonus; 
		КонецЕсли;
	ИначеЕсли Ответ.Свойство("errorCode") Тогда
		СтруктураОтвета.ТекстОшибки = Ответ.errorCode;
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("ТекстОшибки") И СтрДлина(СтруктураОтвета.ТекстОшибки) > 0 Тогда
		
		ПараметрыОчереди = Новый Структура;
		ПараметрыОчереди.Вставить("end_point",   ПараметрыСписанияБонусов.АдресПроцессинга);
		ПараметрыОчереди.Вставить("service",     Ресурс);
		ПараметрыОчереди.Вставить("metod",       "PUT");
		ПараметрыОчереди.Вставить("body",        Данные);
		ПараметрыОчереди.Вставить("Терминал",    ПараметрыСписанияБонусов.ИдентификаторУстройства);
		ПараметрыОчереди.Вставить("http_status", "400");
		//ПараметрыОчереди.Вставить("Заголовки",   Заголовки);
		ПараметрыОчереди.Вставить("ТекстОшибки", Строка(Ответ.КодСостояния) + ": " + СтруктураОтвета.ТекстОшибки + ", " + Ответ.message);
		
		эвСберСпасибоСервер.СохранитьЗапросВОчереди(ПараметрыОчереди);
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции
Функция ОплатаПлатежнойкартойОстаток(ПараметрыСписанияБонусов) Экспорт
	
	СтруктураОтвета = СтруктураОтвета();

	// Проводим по терминалу Сумму оплаты - бонусы. 
   // Получаем слип терминала + слип спасибо.
   // Возвращаемся в логику оплаты в форму сложной оплаты.
   
   СуммаОперацииОстаток = ПараметрыСписанияБонусов.СуммаОперации;   
   
   // Проводим по терминалу остаток с передачей хэша карты
   ///////////////////////////////////////////////////////////////////////////////
   
   // Сумма на терминал передается в копейках
   Если Цел(СуммаОперацииОстаток) = СуммаОперацииОстаток Тогда
   		Сумма = СтрЗаменить(Цел(СуммаОперацииОстаток), Символы.НПП, "")+"00";
   ИНаче
   		Сумма = СтрЗаменить(СуммаОперацииОстаток * 100, Символы.НПП, "");
   КонецЕсли;
   
   Попытка
   
   	ЗапуститьПриложение(ПараметрыСписанияБонусов.P_DistribPath + "\sb_pilot.exe 1 "+ Сумма + " 0 " + ПараметрыСписанияБонусов.Хеш, 
  					   ПараметрыСписанияБонусов.P_DistribPath, 
   					   Истина);
   
	Исключение
   КонецПопытки;

   РезультатОплаты = "";
   ЛогОплаты = ""; 
   Путь = ПараметрыСписанияБонусов.P_DistribPath+"\e";
   ФайлЛога = Новый Файл(Путь);
   Если ФайлЛога.Существует() Тогда
	   Текст =  Новый ТекстовыйДокумент;
	   Текст.Прочитать(Путь, КодировкаТекста.OEM); 
	   Если Текст.КоличествоСтрок() > 0 Тогда
		   ЛогОплаты       = Текст.ПолучитьСтроку(1);
		   РезультатОплаты = Лев(ЛогОплаты,1); 
	   КонецЕсли;
   КонецЕсли;
   
   //РезультатОплаты = "Завершение оплаты чека - отказ";  // для эмуляции ошибки
   
   // Запускаем обработчик после типовой операции оплаты по терминалу
   Если РезультатОплаты = "0" Тогда
	   
	   СлипОплаты = "";
 	   Путь = ПараметрыСписанияБонусов.P_DistribPath+"\p";
	   ФайлЛога = Новый Файл(Путь);
	   Если ФайлЛога.Существует() Тогда
		   Текст =  Новый ТекстовыйДокумент;
		   Текст.Прочитать(Путь, КодировкаТекста.OEM);  
		   // Отрезаем все правее разделителя, Сбер стал присылать непонятные символы отреза, 1С виснет.
		   Для к = 1 По 16 Цикл  
			   СтрокаСлипа = Текст.ПолучитьСтроку(к);
			   Если СтрНайти(СтрокаСлипа, "================================")>0 Тогда
			       СтрокаСлипа = "================================";
			   КонецЕсли;
			   СлипОплаты = СлипОплаты + СтрокаСлипа;
			   Если НЕ к = 16 Тогда
			   	  СлипОплаты = СлипОплаты + Символы.ПС;
			   КонецЕсли;
		   КонецЦикла;
		   
	   КонецЕсли; 
	   ПараметрыСписанияБонусов.Вставить("ТекстСлипЧекаОплаты", СлипОплаты);
	   
	   СтруктураОтвета.ВидДействия = 0;
	   
	   RRN = ВернутьRRNизФайлаР(ПараметрыСписанияБонусов.P_DistribPath);
	   ПараметрыСписанияБонусов.RRN = RRN;
	   
   Иначе
	   
	   СтруктураОтвета.ТекстОшибки = СтрШаблон("3. Отмена чека. Ошибка оплаты на терминале. %1%2", Символы.ПС, ЛогОплаты);
	   
	   Возврат СтруктураОтвета;
	   
   КонецЕсли;
 
   Возврат СтруктураОтвета;
   
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РесурсДляПроверкиДоступаКПроцессингу(ПараметрыПроверки)
    
    Networks = "";
    Partners = "";
    ПараметрыПроверки.Свойство("networks", Networks);
    ПараметрыПроверки.Свойство("partners", Partners);
    
    Если ЗначениеЗаполнено(Networks) И ЗначениеЗаполнено(Partners) Тогда
        Возврат СтрШаблон("/networks/%1/partners/%2/", Networks, Partners);
    КонецЕсли;
    
    Возврат "/";
    
КонецФункции

Функция ВернутьRRNизФайлаР(P_DistribPath)

	RRN = "";
	Путь = P_DistribPath+"\p";
	ФайлЛога = Новый Файл(Путь);
	Если ФайлЛога.Существует() Тогда
		Текст =  Новый ТекстовыйДокумент;
		Текст.Прочитать(Путь, КодировкаТекста.OEM); 
   		НачСтрока = 1;
		КонСтрока = Текст.КоличествоСтрок();
		Для От = НачСтрока По КонСтрока Цикл   
			
			СтрокаР = Текст.ПолучитьСтроку(От);

			Если СтрНайти(СтрокаР,"RRN") > 0 Тогда
			    RRN = Прав(СокрЛП(СтрокаР),12);
			КонецЕсли; 
			
		Конеццикла;
		
	КонецЕсли; 
	
	Возврат RRN;

КонецФункции // ()

Функция ВернутьСтруктуруЧекаСФиктивнойПозицией(СуммаОперации, СуммаОперацииСПАСИБО = 0)
	
	// Используем подменный товар, т.к. сложные условия максимальной скидки рассчитываьтся локально
	
	МассивСтрокТовара = Новый Массив;
	
	СтруктураТовара = Новый Структура;
	СтруктураТовара.Вставить("position",  1);
	СтруктураТовара.Вставить("code",      "fictive");
	СтруктураТовара.Вставить("quantity",  СуммаОперации+СуммаОперацииСПАСИБО);
	СтруктураТовара.Вставить("basePrice", 1);
	СтруктураТовара.Вставить("minPrice",  0);

	Если СуммаОперацииСПАСИБО > 0 Тогда
	
		СтруктураТовара.Вставить("pcBonusDiscount",  СуммаОперацииСПАСИБО);
	
	КонецЕсли; 
	
	МассивСтрокТовара.Добавить(СтруктураТовара);
	
	Возврат МассивСтрокТовара;

КонецФункции // ()

Функция СформироватьКорзинуКлиент(Товары, МаксимальныйПроцентОплатыБонусами, СуммаБонусовВозврата = 0, ЭтоВозврат)

	КорзинаТоваров = Новый Массив;
	СуммыСтрок = Новый Массив;
	ОбщаяСуммаКорзины = 0;
	
	Для каждого Стр Из Товары Цикл
	
		Если Стр.эвНеВходитВАссортиментСберСпасибо Тогда
			Продолжить;	   	
		КонецЕсли;
		
		СуммаСтроки = Стр.Количество * Стр.Цена;
		
		СтруктураТовара = Новый Структура;
		СтруктураТовара.Вставить("position",  ?(ЭтоВозврат, Стр.КлючСвязиЧекаПродажи, Стр.НомерСтроки));
		СтруктураТовара.Вставить("code",      Строка(Стр.Номенклатура.УникальныйИдентификатор()));
		СтруктураТовара.Вставить("quantity",  Стр.Количество);
		СтруктураТовара.Вставить("basePrice", Стр.Цена);
		СтруктураТовара.Вставить("minPrice",  Цел(Стр.Цена * МаксимальныйПроцентОплатыБонусами / 100));
		
		КорзинаТоваров.Добавить(СтруктураТовара);
		СуммыСтрок.Добавить(СуммаСтроки);
		ОбщаяСуммаКорзины = ОбщаяСуммаКорзины + СуммаСтроки;
		
	КонецЦикла;
	
	Если СуммаБонусовВозврата > 0 И ОбщаяСуммаКорзины > 0 Тогда
		
		ОстатокБонусов = СуммаБонусовВозврата;
		КоличествоСтрок = КорзинаТоваров.Количество();
		
		Для Индекс = 0 По КоличествоСтрок - 1 Цикл
			
			Если Индекс = КоличествоСтрок - 1 Тогда
				БонусыСтроки = ОстатокБонусов;
			Иначе
				БонусыСтроки = Окр(СуммаБонусовВозврата * СуммыСтрок[Индекс] / ОбщаяСуммаКорзины, 2);
			КонецЕсли;
			
			КорзинаТоваров[Индекс].Вставить("pcBonusDiscount", БонусыСтроки);
			ОстатокБонусов = ОстатокБонусов - БонусыСтроки;
			
		КонецЦикла;
		
	КонецЕсли;
	
    Возврат КорзинаТоваров;
	
КонецФункции // ()

Функция ПолучитьДанныеКарты(Путь) Экспорт
	
	ДанныеКарты = Новый Структура("Хеш, НомерКарты");
	
	Если Прав(Путь,1) = "e" Тогда
		
		ФайлЛога = Новый Файл(Путь);
		Если ФайлЛога.Существует() Тогда
			Текст =  Новый ТекстовыйДокумент;
			Текст.Прочитать(Путь, КодировкаТекста.OEM); 
			Если Текст.КоличествоСтрок() > 0 Тогда
				ДанныеКарты.Хеш        = Текст.ПолучитьСтроку(11); 
				ДанныеКарты.НомерКарты = Текст.ПолучитьСтроку(2);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеКарты;

КонецФункции          

Функция РазобратьJSON(Данные)
	
	Структура = Новый Структура;
	
	Свойство = Неопределено;
    Значение = Неопределено;
	
	ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(Данные);
	
	Пока ЧтениеJson.Прочитать() Цикл
        ТипJson = ЧтениеJson.ТипТекущегоЗначения;
        Если ТипJSON = ТипЗначенияJSON.Число Или ТипJson = ТипЗначенияJSON.Строка Или
            ТипJson = ТипЗначенияJSON.Булево Или ТипJson = ТипЗначенияJSON.Null Тогда
            Значение = ЧтениеJson.ТекущееЗначение;
            Структура.Вставить(Свойство, Значение);
        ИначеЕсли ТипJson = ТипЗначенияJSON.ИмяСвойства Тогда 
            Свойство = ЧтениеJson.ТекущееЗначение;
        КонецЕсли;
	КонецЦикла; 
	
    Возврат Структура; 
	
КонецФункции

Функция СтруктураОтвета()

	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("КодСостояния",0);
	СтруктураОтвета.Вставить("status","");
	СтруктураОтвета.Вставить("НомерЧекаВСистемеСпасибо","");
	СтруктураОтвета.Вставить("ВидДействия","");
	СтруктураОтвета.Вставить("СуммаОперацииСпасибо",0);
	СтруктураОтвета.Вставить("СуммаОперации",0);
	СтруктураОтвета.Вставить("МинимальнаяСумма",0);
	СтруктураОтвета.Вставить("МаксимальнаяСумма",0);
	СтруктураОтвета.Вставить("НомерКарты","");
	СтруктураОтвета.Вставить("МаксимальнаяСуммаСкидки",0);
	СтруктураОтвета.Вставить("ТекстОшибки","");
	СтруктураОтвета.Вставить("ТекстСлипЧека","");
	СтруктураОтвета.Вставить("resetHold", Ложь);

    Возврат СтруктураОтвета;
	
КонецФункции

// HTTP к процессингу Спасибо выполняется на клиенте (касса / тонкий клиент),
// без серверного вызова //
Функция ОтправитьHTTPзапрос(ПараметрыБонусовСпасибо, Ресурс, Данные = Неопределено, Метод = "POST")
	
	Соединение = СоединитьсяСПроцессингом(ПараметрыБонусовСпасибо);
	Если Соединение = Неопределено Тогда
		ЗаписатьЛогСпасибо(
			НСтр("ru = 'Не удалось установить соединение с процессингом Спасибо'")
				+ Символы.ПС
				+ "Ресурс: "
				+ Ресурс,
			Истина);
		Возврат Новый Структура("КодСостояния", 400);
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	HTTPЗапрос = Новый HTTPЗапрос(Ресурс, Заголовки);
	ТелоЗапроса = "";
	
	Если Данные <> Неопределено Тогда
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Данные);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	КонецЕсли;
	
	Попытка
		Если Метод = "POST" Тогда
			Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ИначеЕсли Метод = "PUT" Тогда
			Ответ = Соединение.ВызватьHTTPМетод("PUT", HTTPЗапрос);
		Иначе
			Возврат Новый Структура("КодСостояния, error", 400, "Не известный метод");
		КонецЕсли;
	Исключение
		ТекстОшибки = "Ошибка отправки " + Метод + "-запроса к серверу Спасибо"
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьЛогСпасибо(ТекстОшибки, Истина);
		Возврат Новый Структура("error, КодСостояния", ТекстОшибки, 404);
	КонецПопытки;
	
	ТекстСообщения = "";
	Попытка
		ТекстСообщения = Ответ.ПолучитьТелоКакСтроку();
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
			СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON, Ложь);
			СтруктураОтвета.Вставить("КодСостояния", Ответ.КодСостояния);
		Иначе
			ТекстСообщения = "Ок";
		    СтруктураОтвета = Новый Структура("КодСостояния", Ответ.КодСостояния);
		КонецЕсли;
	Исключение
		СтруктураОтвета = Новый Структура(
			"error, КодСостояния",
			"Ошибка разбора ответа сервера процессинга",
			Ответ.КодСостояния);
		ЗаписатьЛогСпасибо(
			СтруктураОтвета.error + Символы.ПС + ТекстСообщения,
			Истина);
		Возврат СтруктураОтвета;
	КонецПопытки;
	
	ЗаписатьЛогHTTPСпасибо(Метод, Ресурс, ТелоЗапроса, ТекстСообщения);
	
	Возврат СтруктураОтвета;
	
КонецФункции

Функция СоединитьсяСПроцессингом(ПараметрыБонусовСпасибо)
	
	Если ТипЗнч(ПараметрыБонусовСпасибо) <> Тип("Структура")
		Или Не ПараметрыБонусовСпасибо.Свойство("АдресПроцессинга")
		Или Не ЗначениеЗаполнено(ПараметрыБонусовСпасибо.АдресПроцессинга) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ПараметрыБонусовСпасибо.Свойство("АдресСертификата")
		Или Не ЭтоАдресВременногоХранилища(ПараметрыБонусовСпасибо.АдресСертификата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("pfx");
	ДД = ПолучитьИзВременногоХранилища(ПараметрыБонусовСпасибо.АдресСертификата);
	
	Попытка
		ДД.Записать(ИмяФайла);
	Исключение
		ЗаписатьЛогСпасибо(
			НСтр("ru = 'Ошибка получения сертификата из двоичных данных'")
				+ Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Истина);
		Возврат Неопределено;
	КонецПопытки;
	
	СертификатКлиента = Новый СертификатКлиентаФайл(ИмяФайла, ПараметрыБонусовСпасибо.ПарольСертификата);
	ssl = Новый ЗащищенноеСоединениеOpenSSL(СертификатКлиента, Неопределено);
	
	Попытка
		Возврат Новый HTTPСоединение(ПараметрыБонусовСпасибо.АдресПроцессинга,,,,,, ssl);
	Исключение
		ЗаписатьЛогСпасибо(
			НСтр("ru = 'Ошибка соединения с сервером Спасибо'")
				+ Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Истина);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура ЗаписатьЛогHTTPСпасибо(Метод, Ресурс, ТелоЗапроса, ТекстОтвета, ЭтоОшибка = Ложь)
	
	ЧастиЛога = Новый Массив;
	ЧастиЛога.Добавить("====================== Операция: " + Метод + " " + Ресурс + " ======================");
	ЧастиЛога.Добавить("Точное время начала выполнения операции: " + XMLСтрока(ТекущаяДата()));
	ЧастиЛога.Добавить("");
	ЧастиЛога.Добавить("Метод: " + Метод + " " + Ресурс);
	ЧастиЛога.Добавить("");
	ЧастиЛога.Добавить("Запрос: ");
	ЧастиЛога.Добавить(СтрЗаменить(ТелоЗапроса, Символы.ПС, ""));
	ЧастиЛога.Добавить("");
	ЧастиЛога.Добавить("Ответ: ");
	ЧастиЛога.Добавить(ТекстОтвета);
	ЧастиЛога.Добавить("");
	ЧастиЛога.Добавить(СтрШаблон("Комментарий: %1", ?(ЭтоОшибка, "Ошибка", "Успешно")));
	
	ЗаписатьЛогСпасибо(СтрСоединить(ЧастиЛога, Символы.ПС), ЭтоОшибка);
	
КонецПроцедуры

Процедура НачатьСборЛоговСпасибо()
	
	ПараметрыПриложения.Вставить(КлючБуфераЛоговСпасибо(), Новый Массив);
	
КонецПроцедуры

Процедура ЗаписатьЛогСпасибо(ТекстСообщения, ЭтоОшибка = Ложь)
	
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Буфер = ПараметрыПриложения[КлючБуфераЛоговСпасибо()];
	Если Буфер = Неопределено Тогда
		Буфер = Новый Массив;
		ПараметрыПриложения.Вставить(КлючБуфераЛоговСпасибо(), Буфер);
	КонецЕсли;
	
	ЭлементЛога = Новый Структура;
	ЭлементЛога.Вставить("ДатаОперации", ТекущаяДата());
	ЭлементЛога.Вставить("Идентификатор", Новый УникальныйИдентификатор);
	ЭлементЛога.Вставить("ЭтоОшибка", ЭтоОшибка);
	ЭлементЛога.Вставить("Сообщение", ТекстСообщения);
	
	Буфер.Добавить(ЭлементЛога);
	
КонецПроцедуры

Процедура СброситьЛогиСпасибоВФоне()
	
	Буфер = ПараметрыПриложения[КлючБуфераЛоговСпасибо()];
	Если Буфер = Неопределено Или Буфер.Количество() = 0 Тогда
		ПараметрыПриложения.Вставить(КлючБуфераЛоговСпасибо(), Новый Массив);
		Возврат;
	КонецЕсли;
	
	МассивЛогов = Новый Массив;
	Для Каждого ЭлементЛога Из Буфер Цикл
		МассивЛогов.Добавить(ЭлементЛога);
	КонецЦикла;
	
	ПараметрыПриложения.Вставить(КлючБуфераЛоговСпасибо(), Новый Массив);
	эвСберСпасибоСервер.ЗапуститьЗаписьЛоговСпасибоВФоне(МассивЛогов);
	
КонецПроцедуры

Функция КлючБуфераЛоговСпасибо()
	
	Возврат "эвСберСпасибо.БуферЛогов";
	
КонецФункции

#КонецОбласти

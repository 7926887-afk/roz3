Функция ПодтвердитьЗаказ(Источник, НастройкиAPI, НомерНаСайте, ЗаказПокупателя)

	ТелоЗапроса = Новый Структура("id", НомерНаСайте);
	АдресЗапроса = ХостЗаказов(НастройкиAPI.Адрес) + "/local/tools/1c_exchange/as_order_sent.php";
	РезультатHTTP = ВыполнитьЗапросСайта(Источник, НастройкиAPI, АдресЗапроса, ТелоЗапроса, "orderSent", 12, ЗаказПокупателя);
	Если ОтветСайтаПринят(РезультатHTTP) Тогда
		Возврат Истина;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Ошибка, , Источник,
		СтрШаблон("Не подтвержден заказ %1. %2", НомерНаСайте, РезультатHTTP.ТекстОшибки));
	Возврат Ложь;


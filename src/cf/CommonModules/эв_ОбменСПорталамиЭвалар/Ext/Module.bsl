Процедура ПоставитьЗаказНовыйВОчередь(ЗаказПокупателя, Источник, НастройкиAPI)

	СтатусНовый = эв_ОбменСПорталамиСервер.СостояниеНовыйЗаказа(НастройкиAPI.Вид);
	Если ЗначениеЗаполнено(СтатусНовый) Тогда
		эв_ОбменСПорталамиСервер.ПоставитьЗаказВОчередьСтатусов(ЗаказПокупателя, Источник, СтатусНовый, , Истина);
	КонецЕсли;


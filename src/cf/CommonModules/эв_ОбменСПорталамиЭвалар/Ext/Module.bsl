Функция ИмяХоста(Адрес)

	Текст = СокрЛП(Адрес);
	НРегТекст = НРег(Текст);
	Если СтрНачинаетсяС(НРегТекст, "https://") Тогда
		Текст = Сред(Текст, 9);
	ИначеЕсли СтрНачинаетсяС(НРегТекст, "http://") Тогда
		Текст = Сред(Текст, 8);
	КонецЕсли;

	ПозицияСлеша = СтрНайти(Текст, "/");
	Если ПозицияСлеша > 1 Тогда
		Текст = Лев(Текст, ПозицияСлеша - 1);
	КонецЕсли;

	Возврат Текст;


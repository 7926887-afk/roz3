
#Область ПрограммныйИнтерфейс

Функция ВыгрузитьОстатки(Источник, НастройкиAPI, ПолнаяВыгрузка) Экспорт

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не заполнены настройки API Эвалар");
		Возврат Ложь;
	КонецЕсли;

	Если Не ПолеЗаполнено(НастройкиAPI, "Логин") Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не заполнен SecureToken микросервиса остатков");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиAPI.Склад) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"У источника заказов не заполнен склад");
		Возврат Ложь;
	КонецЕсли;

	ТаблицаОстатков = ПолучитьОстаткиЦены(Источник, НастройкиAPI, ПолнаяВыгрузка);
	ТаблицаКОтправке = ТаблицаОстатков.СкопироватьКолонки();
	ТаблицаКОтправке.Колонки.Добавить("Характеристика");
	МассивОстатков = Новый Массив;
	МассивЦен = Новый Массив;
	СобратьПакеты(ТаблицаОстатков, ТаблицаКОтправке, МассивОстатков, МассивЦен);
	Если МассивОстатков.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИдентификаторКаталога = ИдентификаторКаталога(НастройкиAPI);
	АдресОстатков = ХостМикросервиса(НастройкиAPI.Адрес) + "/amount/"
		+ КодироватьСтроку(ИдентификаторКаталога, СпособКодированияСтроки.КодировкаURL);
	Если Не ОтправитьПорции(Источник, НастройкиAPI, АдресОстатков, МассивОстатков, "amount") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если МассивЦен.Количество() > 0 Тогда
		АдресЦен = ХостМикросервиса(НастройкиAPI.Адрес) + "/price/"
			+ КодироватьСтроку(ИдентификаторКаталога, СпособКодированияСтроки.КодировкаURL);
		Если Не ОтправитьПорции(Источник, НастройкиAPI, АдресЦен, МассивЦен, "price") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	эв_ОбменСПорталамиСервер.ОбновитьСнимокОстатков(Источник, ТаблицаКОтправке, ПолнаяВыгрузка);
	Возврат Истина;

КонецФункции

Функция ЗагрузитьЗаказы(Источник, НастройкиAPI) Экспорт

	ТаблицаЗагруженных = НоваяТаблицаЗагруженныхЗаказов();

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не заполнены настройки API Эвалар");
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("city", "moscow");
	ТелоЗапроса.Вставить("micro_point_id", ИдентификаторКаталога(НастройкиAPI));

	АдресЗапроса = ХостЗаказов(НастройкиAPI.Адрес) + "/local/tools/1c_exchange/as_order_exchange.php";
	РезультатHTTP = ВыполнитьЗапросСайта(Источник, НастройкиAPI, АдресЗапроса, ТелоЗапроса, "orders", 12);
	Если Не РезультатHTTP.Успех Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Ошибка, , Источник,
			РезультатHTTP.ТекстОшибки);
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	Если ТипЗнч(РезультатHTTP.Json) <> Тип("Массив") Или РезультатHTTP.Json.Количество() = 0 Тогда
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	НовыеЗаказы = Новый Массив;
	ЗагрузитьЗаказыИзJSON(Источник, НастройкиAPI, РезультатHTTP.Json, ТаблицаЗагруженных, НовыеЗаказы);

	ДанныеКомплектуется = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "6");
	СостояниеЗаказа = ДанныеКомплектуется.ВидСтатуса;
	Если ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		эв_ОбменСПорталамиСервер.ПоставитьЗаказыВОчередьУстановкиСтатусаКомплектуется(НовыеЗаказы, СостояниеЗаказа);
	ИначеЕсли НовыеЗаказы.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не найден код статуса 6 в регистре кодов статусов портала");
	КонецЕсли;

	Возврат ТаблицаЗагруженных;

КонецФункции

Функция ОтправитьСтатус(ПараметрыОчереди, НастройкиAPI) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Результат.ТекстОшибки = "Не заполнены настройки API Эвалар";
		Возврат Результат;
	КонецЕсли;

	КодСтатуса = ВРег(СокрЛП(эв_ОбменСПорталамиСервер.КодСтатусаПортала(
		ПараметрыОчереди.ИсточникЗаказов, ПараметрыОчереди.СтатусЗаказа, ПараметрыОчереди.ЗаказПокупателя)));
	КодЧислом = ЧислоИзJSON(КодСтатуса);
	Если КодЧислом = 8 Или КодЧислом = 9 Или КодЧислом = 10 Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	СостояниеНовый = эв_ОбменСПорталамиСервер.СостояниеНовыйЗаказа(НастройкиAPI.Вид);
	ЭтоПодтверждение = КодСтатуса = "N" Или КодЧислом = 1 Или ПараметрыОчереди.СтатусЗаказа = СостояниеНовый;
	Если Не ЗначениеЗаполнено(КодСтатуса) И Не ЭтоПодтверждение Тогда
		Результат.ТекстОшибки = "Не задан код статуса портала для состояния заказа";
		Возврат Результат;
	КонецЕсли;

	НомерНаСайте = СокрЛП(эв_ОбменСПорталамиСервер.НомерЗаказаНаСайте(ПараметрыОчереди.ЗаказПокупателя));
	Если Не ЗначениеЗаполнено(НомерНаСайте) Тогда
		Результат.ТекстОшибки = "Не найден номер заказа на сайте";
		Возврат Результат;
	КонецЕсли;

	Если ЭтоПодтверждение Тогда
		Успех = ПодтвердитьЗаказ(ПараметрыОчереди.ИсточникЗаказов, НастройкиAPI, НомерНаСайте, ПараметрыОчереди.ЗаказПокупателя);
		Результат.Успех = Успех;
		Если Не Успех Тогда
			Результат.ТекстОшибки = "Сайт не подтвердил получение заказа";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ТекстСтатуса = СокрЛП(Строка(ПараметрыОчереди.СтатусЗаказа));
	ДатаРезерва = Неопределено;
	ПозицииСборки = Неопределено;
	ВариантЗавершения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ПараметрыОчереди.ЗаказПокупателя, "ВариантЗавершения");
	Если ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен Тогда
		Заметки = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ПараметрыОчереди.ЗаказПокупателя, "Заметки")));
		Если ЗначениеЗаполнено(Заметки) Тогда
			ТекстСтатуса = Заметки;
		КонецЕсли;
	ИначеЕсли КодЧислом = 5 Тогда
		ДатаРезерва = ПараметрыОчереди.ДатаОкончанияРезерва;
		Если ЗначениеЗаполнено(ДатаРезерва) Тогда
			ТекстСтатуса = СокрЛП(ТекстСтатуса + " до " + Формат(ДатаРезерва, "ДФ=dd.MM.yyyy HH:mm"));
		КонецЕсли;
	ИначеЕсли КодЧислом = 7 Тогда
		ПозицииСборки = ПозицииФактическойСборки(ПараметрыОчереди.ЗаказПокупателя);
	КонецЕсли;

	РезультатHTTP = ОтправитьСтатусСайта(ПараметрыОчереди.ИсточникЗаказов, НастройкиAPI, НомерНаСайте, КодСтатуса,
		ТекстСтатуса, ПараметрыОчереди.ЗаказПокупателя, ДатаРезерва, ПозицииСборки);
	Результат.Успех = ОтветСайтаПринят(РезультатHTTP);
	Если Не Результат.Успех Тогда
		Результат.ТекстОшибки = РезультатHTTP.ТекстОшибки;
		Если Не ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
			Результат.ТекстОшибки = "Сайт не принял статус заказа";
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ДанныеПодключенияКорректны(НастройкиAPI) Экспорт

	Если ТипЗнч(НастройкиAPI) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПолеЗаполнено(НастройкиAPI, "Адрес")
		И ПолеЗаполнено(НастройкиAPI, "auth_token")
		И ПолеЗаполнено(НастройкиAPI, "merchant")
		И ПолеЗаполнено(НастройкиAPI, "Логин");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапросСайта(Источник, НастройкиAPI, Адрес, Тело, Контур, Таймаут, ЗаказПокупателя = Неопределено)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + СокрЛП(НастройкиAPI.auth_token));

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ИсточникЗаказов", Источник);
	ПараметрыЗапроса.Вставить("Метод", "POST");
	ПараметрыЗапроса.Вставить("Адрес", Адрес);
	ПараметрыЗапроса.Вставить("Контур", Контур);
	ПараметрыЗапроса.Вставить("Заголовки", Заголовки);
	ПараметрыЗапроса.Вставить("Тело", Тело);
	ПараметрыЗапроса.Вставить("Таймаут", Таймаут);
	ПараметрыЗапроса.Вставить("ПарольДляМаскировки", НастройкиAPI.auth_token);
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ПараметрыЗапроса.Вставить("ЗаказПокупателя", ЗаказПокупателя);
	КонецЕсли;

	Возврат эв_ОбменСПорталамиСервер.ВыполнитьЗапросHTTP(ПараметрыЗапроса);

КонецФункции

Функция ВыполнитьЗапросМикросервиса(Источник, НастройкиAPI, Адрес, Тело, Контур)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("SecureToken", СокрЛП(НастройкиAPI.Пароль));

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ИсточникЗаказов", Источник);
	ПараметрыЗапроса.Вставить("Метод", "POST");
	ПараметрыЗапроса.Вставить("Адрес", Адрес);
	ПараметрыЗапроса.Вставить("Контур", Контур);
	ПараметрыЗапроса.Вставить("Заголовки", Заголовки);
	ПараметрыЗапроса.Вставить("Тело", Тело);
	ПараметрыЗапроса.Вставить("Таймаут", 120);
	ПараметрыЗапроса.Вставить("ПарольДляМаскировки", НастройкиAPI.Пароль);

	Возврат эв_ОбменСПорталамиСервер.ВыполнитьЗапросHTTP(ПараметрыЗапроса);

КонецФункции

Функция ОтправитьПорции(Источник, НастройкиAPI, Адрес, МассивЭлементов, Контур)

	РазмерПорции = 10;
	Индекс = 0;
	Пока Индекс < МассивЭлементов.Количество() Цикл
		Порция = Новый Массив;
		Пока Порция.Количество() < РазмерПорции И Индекс < МассивЭлементов.Количество() Цикл
			Порция.Добавить(МассивЭлементов[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;

		РезультатHTTP = ВыполнитьЗапросМикросервиса(Источник, НастройкиAPI, Адрес, Порция, Контур);
		Если Не РезультатHTTP.Успех Тогда
			ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Ошибка, , Источник,
				РезультатHTTP.ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПолучитьОстаткиЦены(Источник, НастройкиAPI, ПолнаяВыгрузка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Склад
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, СтруктурнаяЕдиница = &Склад) КАК Остатки
		|ГДЕ
		|	Остатки.Характеристика.ор_СрокГодности > &ГраницаСрока
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура,
		|	Остатки.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Резервы.Номенклатура КАК Номенклатура,
		|	Резервы.Характеристика КАК Характеристика,
		|	СУММА(Резервы.КоличествоОстаток) КАК РезервОстаток
		|ПОМЕСТИТЬ ВТ_Резервы
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(
		|			,
		|			СтруктурнаяЕдиница = &Склад
		|				И ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Резервы
		|
		|СГРУППИРОВАТЬ ПО
		|	Резервы.Номенклатура,
		|	Резервы.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Склад.Номенклатура КАК Номенклатура,
		|	СУММА(ВЫБОР
		|			КОГДА ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0) < 1
		|				ТОГДА 0
		|			ИНАЧЕ ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0)
		|		КОНЕЦ) КАК ДоступныйОстаток
		|ПОМЕСТИТЬ ВТ_Учет
		|ИЗ
		|	ВТ_Склад КАК ВТ_Склад
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Резервы КАК ВТ_Резервы
		|		ПО ВТ_Склад.Номенклатура = ВТ_Резервы.Номенклатура
		|			И ВТ_Склад.Характеристика = ВТ_Резервы.Характеристика
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Склад.Номенклатура
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЫБОР
		|			КОГДА ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0) < 1
		|				ТОГДА 0
		|			ИНАЧЕ ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0)
		|		КОНЕЦ) >= 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Снимок.Номенклатура КАК Номенклатура,
		|	СУММА(Снимок.ДоступныйОстаток) КАК ДоступныйОстаток,
		|	МАКСИМУМ(Снимок.Цена) КАК Цена
		|ПОМЕСТИТЬ ВТ_Снимок
		|ИЗ
		|	РегистрСведений.эв_ВыгруженныеОстаткиПорталов КАК Снимок
		|ГДЕ
		|	Снимок.ИсточникЗаказов = &Источник
		|
		|СГРУППИРОВАТЬ ПО
		|	Снимок.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(Цены.Цена) КАК Цена
		|ПОМЕСТИТЬ ВТ_ИнтернетЦена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И ВидЦен.Наименование = ""Интернет цена (Сокол)"") КАК Цены
		|
		|СГРУППИРОВАТЬ ПО
		|	Цены.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(Цены.Цена) КАК Цена
		|ПОМЕСТИТЬ ВТ_ЦенаБезХарактеристики
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			ВидЦен = &ВидЦен
		|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены
		|
		|СГРУППИРОВАТЬ ПО
		|	Цены.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	МИНИМУМ(Цены.Цена) КАК Цена
		|ПОМЕСТИТЬ ВТ_МинимальнаяЦена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦен = &ВидЦен) КАК Цены
		|ГДЕ
		|	Цены.Цена > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	Цены.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_Учет.Номенклатура, ВТ_Снимок.Номенклатура) КАК Номенклатура,
		|	ЕСТЬNULL(ВТ_Учет.ДоступныйОстаток, 0) КАК ДоступныйОстаток,
		|	ЕСТЬNULL(ВТ_Снимок.Цена, 0) КАК ЦенаСнимка
		|ПОМЕСТИТЬ ВТ_Ключи
		|ИЗ
		|	ВТ_Учет КАК ВТ_Учет
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Снимок КАК ВТ_Снимок
		|		ПО ВТ_Учет.Номенклатура = ВТ_Снимок.Номенклатура
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ПолнаяВыгрузка
		|				ТОГДА ИСТИНА
		|			КОГДА ВТ_Учет.Номенклатура ЕСТЬ NULL
		|				ТОГДА ЕСТЬNULL(ВТ_Снимок.ДоступныйОстаток, 0) > 0
		|			КОГДА ВТ_Снимок.Номенклатура ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЕСТЬNULL(ВТ_Учет.ДоступныйОстаток, 0) <> ЕСТЬNULL(ВТ_Снимок.ДоступныйОстаток, 0)
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Ключи.Номенклатура КАК Номенклатура,
		|	ВТ_Ключи.ДоступныйОстаток КАК ДоступныйОстаток,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ИнтернетЦена.Цена, 0) > 0
		|			ТОГДА ВТ_ИнтернетЦена.Цена
		|		КОГДА ВРЕГ(ЕСТЬNULL(ВТ_Ключи.Номенклатура.ЦеноваяГруппа.Наименование, """")) = ""ЭВАЛАР""
		|				И ЕСТЬNULL(ВТ_ЦенаБезХарактеристики.Цена, 0) > 0
		|			ТОГДА ВТ_ЦенаБезХарактеристики.Цена
		|		ИНАЧЕ ЕСТЬNULL(ВТ_МинимальнаяЦена.Цена, ВТ_Ключи.ЦенаСнимка)
		|	КОНЕЦ КАК Цена,
		|	ВТ_Ключи.Номенклатура.ВидСтавкиНДС КАК ВидСтавкиНДС
		|ИЗ
		|	ВТ_Ключи КАК ВТ_Ключи
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнтернетЦена КАК ВТ_ИнтернетЦена
		|		ПО ВТ_Ключи.Номенклатура = ВТ_ИнтернетЦена.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦенаБезХарактеристики КАК ВТ_ЦенаБезХарактеристики
		|		ПО ВТ_Ключи.Номенклатура = ВТ_ЦенаБезХарактеристики.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МинимальнаяЦена КАК ВТ_МинимальнаяЦена
		|		ПО ВТ_Ключи.Номенклатура = ВТ_МинимальнаяЦена.Номенклатура";

	Запрос.УстановитьПараметр("Склад", НастройкиAPI.Склад);
	Запрос.УстановитьПараметр("ВидЦен", НастройкиAPI.ВидЦен);
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("ПолнаяВыгрузка", ПолнаяВыгрузка);
	Запрос.УстановитьПараметр("ГраницаСрока", КонецДня(ТекущаяДатаСеанса()) + 86400);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура СобратьПакеты(ТаблицаОстатков, ТаблицаКОтправке, МассивОстатков, МассивЦен)

	СтавкиНДС = Новый Соответствие;
	ПустаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл

		Количество = Цел(СтрокаОстатка.ДоступныйОстаток);
		Если Количество < 0 Тогда
			Количество = 0;
		КонецЕсли;
		Если (Не ЗначениеЗаполнено(СтрокаОстатка.Цена) Или СтрокаОстатка.Цена = 0) И Количество > 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаКОтправке = ТаблицаКОтправке.Добавить();
		СтрокаКОтправке.Номенклатура = СтрокаОстатка.Номенклатура;
		СтрокаКОтправке.Характеристика = ПустаяХарактеристика;
		СтрокаКОтправке.Цена = ?(ЗначениеЗаполнено(СтрокаОстатка.Цена), СтрокаОстатка.Цена, 0);
		СтрокаКОтправке.ДоступныйОстаток = Количество;

		ИдентификаторТовара = XMLСтрока(СтрокаОстатка.Номенклатура);
		ПозицияОстатка = Новый Структура;
		ПозицияОстатка.Вставить("product", ИдентификаторТовара);
		ПозицияОстатка.Вставить("amount", Количество);
		МассивОстатков.Добавить(ПозицияОстатка);

		Если СтрокаКОтправке.Цена > 0 Тогда
			ПозицияЦены = Новый Структура;
			ПозицияЦены.Вставить("product", ИдентификаторТовара);
			ПозицияЦены.Вставить("price", СтрокаКОтправке.Цена);
			ПозицияЦены.Вставить("vat_percentage", СтавкаНДСДляВыгрузки(СтрокаОстатка.ВидСтавкиНДС, СтавкиНДС));
			МассивЦен.Добавить(ПозицияЦены);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция СтавкаНДСДляВыгрузки(ВидСтавкиНДС, СтавкиНДС)

	Если Не ЗначениеЗаполнено(ВидСтавкиНДС) Или ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.БезНДС Тогда
		Возврат -1;
	КонецЕсли;

	СохраненнаяСтавка = СтавкиНДС.Получить(ВидСтавкиНДС);
	Если СохраненнаяСтавка <> Неопределено Тогда
		Возврат СохраненнаяСтавка;
	КонецЕсли;

	СтавкаСсылка = Справочники.СтавкиНДС.СтавкаНДС(ВидСтавкиНДС, ТекущаяДатаСеанса());
	ЗначениеСтавки = -1;
	Если ЗначениеЗаполнено(СтавкаСсылка) Тогда
		РеквизитыСтавки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтавкаСсылка, "НеОблагается, Ставка");
		Если РеквизитыСтавки.НеОблагается <> Истина И ЗначениеЗаполнено(РеквизитыСтавки.Ставка) Тогда
			ЗначениеСтавки = РеквизитыСтавки.Ставка;
		КонецЕсли;
	КонецЕсли;

	СтавкиНДС.Вставить(ВидСтавкиНДС, ЗначениеСтавки);
	Возврат ЗначениеСтавки;

КонецФункции

Процедура ЗагрузитьЗаказыИзJSON(Источник, НастройкиAPI, СписокЗаказов, ТаблицаЗагруженных, НовыеЗаказы)

	ДанныеОтмены = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "FO");

	Для Каждого ЗаказПортала Из СписокЗаказов Цикл

		СтатусСайта = ВРег(СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ЗначениеПоляJSON(ЗаказПортала, "status"), "id"))));
		НомерНаСайте = НомерЗаказаСайта(ЗначениеПоляJSON(ЗаказПортала, "id"));
		Если Не ЗначениеЗаполнено(НомерНаСайте) Тогда
			Продолжить;
		КонецЕсли;

		ЗаказОтменен = БулевоИзJSON(ЗначениеПоляJSON(ЗаказПортала, "isCanceled"))
			Или СтатусСайта = "FO";
		СуществующийЗаказ = эв_ОбменСПорталамиСервер.НайтиЗаказПоНомеруНаСайте(НомерНаСайте, Источник);

		Если ЗначениеЗаполнено(СуществующийЗаказ) Тогда
			Если ЗаказОтменен Тогда
				ПрименитьСтатусПортала(СуществующийЗаказ, Источник, ДанныеОтменыСайта(Источник, СтатусСайта, ДанныеОтмены), Истина);
			ИначеЕсли СтатусСайта <> "N" И СтатусСайта <> "ER" И ЗначениеЗаполнено(СтатусСайта) Тогда
				ДанныеСтатуса = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, СтатусСайта);
				Если ЗначениеЗаполнено(ДанныеСтатуса.ВидСтатуса) Тогда
					ПрименитьСтатусПортала(СуществующийЗаказ, Источник, ДанныеСтатуса,
						ЗначениеЗаполнено(ДанныеСтатуса.ПричинаОтмены));
				КонецЕсли;
			КонецЕсли;
			ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, СуществующийЗаказ, НомерНаСайте, Ложь);
			Если СтатусСайта = "N" Или ЗаказОтменен Тогда
				ПодтвердитьЗаказ(Источник, НастройкиAPI, НомерНаСайте, СуществующийЗаказ);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ЗаказОтменен Тогда
			ПодтвердитьЗаказ(Источник, НастройкиAPI, НомерНаСайте, Неопределено);
			Продолжить;
		КонецЕсли;

		Если СтатусСайта <> "N" Тогда
			Продолжить;
		КонецЕсли;

		ЕстьОшибки = Ложь;
		ДанныеЗаказа = РазобратьЗаказ(ЗаказПортала, НомерНаСайте, ЕстьОшибки);
		Попытка
			ЗаказСсылка = эв_ОбменСПорталамиСервер.СоздатьЗаказПортала(Источник, НастройкиAPI, ДанныеЗаказа);
		Исключение
			ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Ошибка, , Источник,
				СтрШаблон("Ошибка создания заказа %1: %2", НомерНаСайте, ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;

		Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДанныеЗаказа.ОплаченНаПортале Тогда
			СоздатьОплатуКартойПоЗаказу(ЗаказСсылка, Источник, НастройкиAPI, ДанныеЗаказа, ЕстьОшибки);
		КонецЕсли;

		ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, ЗаказСсылка, НомерНаСайте, Истина);
		Если ЕстьОшибки Тогда
			ОтправитьСтатусСайта(Источник, НастройкиAPI, НомерНаСайте, "ER", "Не сопоставлена номенклатура", ЗаказСсылка);
		КонецЕсли;

		Если Не ПодтвердитьЗаказ(Источник, НастройкиAPI, НомерНаСайте, ЗаказСсылка) Тогда
			ПоставитьЗаказНовыйВОчередь(ЗаказСсылка, Источник, НастройкиAPI);
		КонецЕсли;

		Если Не ЕстьОшибки Тогда
			НовыеЗаказы.Добавить(Новый Структура("ЗаказПокупателя, Идентификатор", ЗаказСсылка, НомерНаСайте));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура СоздатьОплатуКартойПоЗаказу(ЗаказПокупателя, Источник, НастройкиAPI, ДанныеЗаказа, ЕстьОшибки)

	СуммаЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказПокупателя, "СуммаДокумента");
	Если Не ЗначениеЗаполнено(СуммаЗаказа) Или СуммаЗаказа <= 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			СтрШаблон("Оплаченный заказ %1 не содержит суммы, документ оплаты не создан", ДанныеЗаказа.НомерНаСайте));
		Возврат;
	КонецЕсли;

	Терминал = ТерминалОплатыИсточника(Источник, НастройкиAPI);
	Если Не ЗначениеЗаполнено(Терминал) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			СтрШаблон("Не заполнен эквайринговый терминал источника (ресурс ЭквайринговыйТерминал регистра эв_НастройкиAPIИсточникаЗаказов). Оплата заказа %1 не создана",
				ДанныеЗаказа.НомерНаСайте));
		Возврат;
	КонецЕсли;

	Если ЕстьОшибки Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			СтрШаблон("Заказ %1 оплачен на портале, номенклатура сопоставлена не полностью. Оплата создается на сумму загруженных строк",
				ДанныеЗаказа.НомерНаСайте));
	КонецЕсли;

	ДокументОплаты = Документы.ОперацияПоПлатежнымКартам.СоздатьДокумент();
	ДокументОплаты.Дата = ?(ЗначениеЗаполнено(ДанныеЗаказа.Дата), ДанныеЗаказа.Дата, ТекущаяДатаСеанса());

	Попытка
		ДокументОплаты.Заполнить(ЗаказПокупателя);
		ЗаполнитьШапкуОплатыКартой(ДокументОплаты, ЗаказПокупателя, ДанныеЗаказа, Терминал);
		ДополнитьРасшифровкуОплаты(ДокументОплаты, ЗаказПокупателя, СуммаЗаказа);
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Ошибка, , Источник,
			СтрШаблон("Ошибка заполнения оплаты заказа %1: %2", ДанныеЗаказа.НомерНаСайте, ОписаниеОшибки()));
		Возврат;
	КонецПопытки;

	Попытка
		ДокументОплаты.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ТекстОшибкиЗаписи();
		Попытка
			ДокументОплаты.Записать(РежимЗаписиДокумента.Запись);
			ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Предупреждение, , Источник,
				СтрШаблон("Оплата заказа %1 записана без проведения: %2", ДанныеЗаказа.НомерНаСайте, ТекстОшибки));
		Исключение
			ЗаписьЖурналаРегистрации("Обмен с порталами.Эвалар", УровеньЖурналаРегистрации.Ошибка, , Источник,
				СтрШаблон("Ошибка записи оплаты заказа %1: %2", ДанныеЗаказа.НомерНаСайте, ТекстОшибкиЗаписи()));
			Возврат;
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьШапкуОплатыКартой(ДокументОплаты, ЗаказПокупателя, ДанныеЗаказа, Терминал)

	ДокументОплаты.ВидОперации = Перечисления.ВидыОперацийЭквайринга.ПоступлениеОплатыОтПокупателя;
	ДокументОплаты.СпособОплаты = Перечисления.СпособыОплатыЭквайринг.ОплатаОнлайн;
	ДокументОплаты.ХозяйственнаяОперация = Справочники.ХозяйственныеОперации.ПоступлениеОплатыОтПокупателя;
	ДокументОплаты.Статья = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей;
	ДокументОплаты.ЭквайринговыйТерминал = Терминал;
	ДокументОплаты.ДокументОснование = ЗаказПокупателя;
	ДокументОплаты.Статус = Перечисления.СтатусыЧековККМ.ЧекНеПробит;
	ДокументОплаты.ПоложениеСтатьи = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
    ДокументОплаты.РасчетВИнтернете = Истина;
	
	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказПокупателя,
		"Организация, Контрагент, Телефон, АдресЭП, КонтактныйТелефон, ПочтаПолучателя, Комментарий, Автор, НалогообложениеНДС");
	Если Не ЗначениеЗаполнено(ДокументОплаты.Организация) Тогда
		ДокументОплаты.Организация = РеквизитыЗаказа.Организация;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОплаты.Контрагент) Тогда
		ДокументОплаты.Контрагент = РеквизитыЗаказа.Контрагент;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОплаты.НалогообложениеНДС) Тогда
		ДокументОплаты.НалогообложениеНДС = РеквизитыЗаказа.НалогообложениеНДС;
	КонецЕсли;

	ДокументОплаты.Телефон = ?(ЗначениеЗаполнено(РеквизитыЗаказа.Телефон), РеквизитыЗаказа.Телефон, РеквизитыЗаказа.КонтактныйТелефон);
	ДокументОплаты.АдресЭП = ?(ЗначениеЗаполнено(РеквизитыЗаказа.АдресЭП), РеквизитыЗаказа.АдресЭП, РеквизитыЗаказа.ПочтаПолучателя);
	Если Не ЗначениеЗаполнено(ДокументОплаты.Автор) Тогда
		ДокументОплаты.Автор = ?(ЗначениеЗаполнено(РеквизитыЗаказа.Автор), РеквизитыЗаказа.Автор, Пользователи.ТекущийПользователь());
	КонецЕсли;

	ТекстКомментария = СтрШаблон("Оплата картой. Заказ на сайте %1", ДанныеЗаказа.НомерНаСайте);
	Если ЗначениеЗаполнено(РеквизитыЗаказа.Комментарий) Тогда
		ТекстКомментария = ТекстКомментария + ". " + РеквизитыЗаказа.Комментарий;
	КонецЕсли;
	ДокументОплаты.Комментарий = ТекстКомментария;

	ЗаполнитьРеквизитыТерминала(ДокументОплаты, Терминал);

	Если Не ЗначениеЗаполнено(ДокументОплаты.ВалютаДенежныхСредств) Тогда
		ДокументОплаты.ВалютаДенежныхСредств = Константы.НациональнаяВалюта.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОплаты.Курс) Тогда
		ДокументОплаты.Курс = 1;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОплаты.Кратность) Тогда
		ДокументОплаты.Кратность = 1;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыТерминала(ДокументОплаты, Терминал)

	РеквизитыТерминала = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Терминал, "БанковскийСчетЭквайринг, Касса");
	ВалютаДоЗамены = ДокументОплаты.ВалютаДенежныхСредств;

	ДокументОплаты.БанковскийСчет = РеквизитыТерминала.БанковскийСчетЭквайринг;
	Если ЗначениеЗаполнено(ДокументОплаты.БанковскийСчет) Тогда
		ВалютаСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОплаты.БанковскийСчет, "ВалютаДенежныхСредств");
		Если ЗначениеЗаполнено(ВалютаСчета) Тогда
			ДокументОплаты.ВалютаДенежныхСредств = ВалютаСчета;
		КонецЕсли;
	КонецЕсли;

	КассаТерминала = РеквизитыТерминала.Касса;
	Если ТипЗнч(КассаТерминала) = Тип("СправочникСсылка.КассыККМ") Тогда
		ДокументОплаты.КассаККМ = КассаТерминала;
	ИначеЕсли ТипЗнч(КассаТерминала) = Тип("СправочникСсылка.Кассы") Тогда
		ДокументОплаты.Касса = КассаТерминала;
	КонецЕсли;

	ВидыКарт = Справочники.СпособыОплаты.ВидыПлатежныхКартИПроцентыКомиссии(Терминал);
	Если ВидыКарт.Количество() = 1 Тогда
		ДокументОплаты.ВидПлатежнойКарты = ВидыКарт[0].ВидПлатежнойКарты;
	КонецЕсли;

	Если ЗначениеЗаполнено(ВалютаДоЗамены)
		И ЗначениеЗаполнено(ДокументОплаты.ВалютаДенежныхСредств)
		И ВалютаДоЗамены <> ДокументОплаты.ВалютаДенежныхСредств
		И ДокументОплаты.ВалютаДенежныхСредств = Константы.НациональнаяВалюта.Получить() Тогда
		Для Каждого СтрокаОплаты Из ДокументОплаты.РасшифровкаПлатежа Цикл
			СтрокаОплаты.СуммаПлатежа = СтрокаОплаты.СуммаРасчетов;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьРасшифровкуОплаты(ДокументОплаты, ЗаказПокупателя, СуммаЗаказа)

	Если ДокументОплаты.РасшифровкаПлатежа.Количество() = 0 Тогда
		СтрокаОплаты = ДокументОплаты.РасшифровкаПлатежа.Добавить();
		СтрокаОплаты.Заказ = ЗаказПокупателя;
		СтрокаОплаты.СчетНаОплату = ЗаказПокупателя;
		СтрокаОплаты.ПризнакАванса = Истина;
		СтрокаОплаты.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
		СтрокаОплаты.СуммаПлатежа = СуммаЗаказа;
		СтрокаОплаты.СуммаРасчетов = СуммаЗаказа;
		СтрокаОплаты.Курс = 1;
		СтрокаОплаты.Кратность = 1;
		СтрокаОплаты.СтавкаНДС = СтавкаНДСЗаказа(ЗаказПокупателя);
		ЗаполнитьСуммуНДСОплаты(СтрокаОплаты);
	КонецЕсли;

	ВестиРасчетыПоЗаказам = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОплаты.Контрагент, "ВестиРасчетыПоЗаказам") = Истина;
	Для Каждого СтрокаОплаты Из ДокументОплаты.РасшифровкаПлатежа Цикл
		СтрокаОплаты.ПризнакАванса = Истина;
		СтрокаОплаты.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
		Если Не ЗначениеЗаполнено(СтрокаОплаты.Курс) Тогда
			СтрокаОплаты.Курс = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаОплаты.Кратность) Тогда
			СтрокаОплаты.Кратность = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаОплаты.Заказ) И ВестиРасчетыПоЗаказам Тогда
			СтрокаОплаты.Заказ = ЗаказПокупателя;
		КонецЕсли;
	КонецЦикла;

	Если ДокументОплаты.РасшифровкаПлатежа.Итог("СуммаПлатежа") = 0 И СуммаЗаказа > 0 Тогда
		ДокументОплаты.РасшифровкаПлатежа[0].СуммаПлатежа = СуммаЗаказа;
		ДокументОплаты.РасшифровкаПлатежа[0].СуммаРасчетов = СуммаЗаказа;
		ЗаполнитьСуммуНДСОплаты(ДокументОплаты.РасшифровкаПлатежа[0]);
	КонецЕсли;

	ДокументОплаты.СуммаДокумента = ДокументОплаты.РасшифровкаПлатежа.Итог("СуммаПлатежа");
	ДокументОплаты.СуммаУчета = ДокументОплаты.СуммаДокумента;

	Если ЗначениеЗаполнено(ДокументОплаты.ВидПлатежнойКарты) Тогда
		ЭквайринговыеОперацииСервер.ЗаполнитьПоляКомиссии(ДокументОплаты);
	КонецЕсли;

КонецПроцедуры

Функция СтавкаНДСЗаказа(ЗаказПокупателя)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запасы.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.ЗаказПокупателя.Запасы КАК Запасы
		|ГДЕ
		|	Запасы.Ссылка = &ЗаказПокупателя
		|	И Запасы.СтавкаНДС <> ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтавкаНДС;
	КонецЕсли;

	Возврат Справочники.СтавкиНДС.ПустаяСсылка();

КонецФункции

Процедура ЗаполнитьСуммуНДСОплаты(СтрокаОплаты)

	СтавкаЧисло = 0;
	Если ЗначениеЗаполнено(СтрокаОплаты.СтавкаНДС) Тогда
		СтавкаЧисло = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОплаты.СтавкаНДС, "Ставка");
		Если СтавкаЧисло = Неопределено Тогда
			СтавкаЧисло = 0;
		КонецЕсли;
	КонецЕсли;

	Если СтавкаЧисло = 0 Тогда
		СтрокаОплаты.СуммаНДС = 0;
		Возврат;
	КонецЕсли;

	СтрокаОплаты.СуммаНДС = Окр(СтрокаОплаты.СуммаПлатежа - СтрокаОплаты.СуммаПлатежа * 100 / (100 + СтавкаЧисло), 2);

КонецПроцедуры

Функция ТерминалОплатыИсточника(Источник, НастройкиAPI)

	Терминал = Неопределено;
	Если ТипЗнч(НастройкиAPI) = Тип("Структура")
		И НастройкиAPI.Свойство("ЭквайринговыйТерминал", Терминал)
		И ЗначениеЗаполнено(Терминал) Тогда
		Возврат Терминал;
	КонецЕсли;

	ИмяРесурса = "ЭквайринговыйТерминал";
	Если Метаданные.РегистрыСведений.эв_НастройкиAPIИсточникаЗаказов.Ресурсы.Найти(ИмяРесурса) = Неопределено Тогда
		Возврат Справочники.СпособыОплаты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал
		|ИЗ
		|	РегистрСведений.эв_НастройкиAPIИсточникаЗаказов КАК Настройки
		|ГДЕ
		|	Настройки.ИсточникЗаказов = &ИсточникЗаказов";
	Запрос.УстановитьПараметр("ИсточникЗаказов", Источник);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ЭквайринговыйТерминал) Тогда
		Возврат Выборка.ЭквайринговыйТерминал;
	КонецЕсли;

	Возврат Справочники.СпособыОплаты.ПустаяСсылка();

КонецФункции

Функция ТекстОшибкиЗаписи()

	Текст = ОписаниеОшибки();
	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Для Каждого Сообщение Из Сообщения Цикл
		Текст = Текст + Символы.ПС + Сообщение.Текст;
	КонецЦикла;
	Возврат Текст;

КонецФункции


Функция ДанныеОтменыСайта(Источник, СтатусСайта, ДанныеОтмены)

	Если СтатусСайта <> "3" Тогда
		Возврат ДанныеОтмены;
	КонецЕсли;

	ДанныеСтатуса = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "3");
	Если ЗначениеЗаполнено(ДанныеСтатуса.ВидСтатуса) Или ЗначениеЗаполнено(ДанныеСтатуса.ПричинаОтмены) Тогда
		Возврат ДанныеСтатуса;
	КонецЕсли;

	Возврат ДанныеОтмены;

КонецФункции

Функция РазобратьЗаказ(ЗаказПортала, НомерНаСайте, ЕстьОшибки)

	Покупатель = ЗначениеПоляJSON(ЗаказПортала, "customer");
	Оплата = ЗначениеПоляJSON(ЗаказПортала, "payment");
	Доставка = ЗначениеПоляJSON(ЗаказПортала, "delivery");
	ТекстЗаказа = "";
	Попытка
		ТекстЗаказа = КоннекторHTTP.ОбъектВJson(ЗаказПортала);
	Исключение
		ТекстЗаказа = "";
	КонецПопытки;

	Комментарий = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ЗаказПортала, "comment")));
	ИдентификаторДоставки = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(Доставка, "id")));
	АдресДоставки = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(Доставка, "address")));
	Если ИдентификаторДоставки = "41" Или ИдентификаторДоставки = "66" Тогда
		СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		Если Не ЗначениеЗаполнено(АдресДоставки) Тогда
			АдресДоставки = "Самовывоз";
		КонецЕсли;
	Иначе
		СпособДоставки = Перечисления.СпособыДоставки.Курьер;
		Если ЗначениеЗаполнено(АдресДоставки) Тогда
			Комментарий = СокрЛП(Комментарий + " Доставка: " + АдресДоставки);
		Иначе
			АдресДоставки = "Доставка";
		КонецЕсли;
	КонецЕсли;

	ДанныеЗаказа = Новый Структура;
	ДанныеЗаказа.Вставить("НомерНаСайте", НомерНаСайте);
	ДанныеЗаказа.Вставить("Дата", ДатаЗаказаСайта(СтрокаИзJSON(ЗначениеПоляJSON(ЗаказПортала, "createdAt"))));
	ДанныеЗаказа.Вставить("Фамилия", СтрокаИзJSON(ЗначениеПоляJSON(Покупатель, "surname")));
	ДанныеЗаказа.Вставить("Имя", СтрокаИзJSON(ЗначениеПоляJSON(Покупатель, "name")));
	ДанныеЗаказа.Вставить("Отчество", СтрокаИзJSON(ЗначениеПоляJSON(Покупатель, "middleName")));
	ДанныеЗаказа.Вставить("Почта", СтрокаИзJSON(ЗначениеПоляJSON(Покупатель, "email")));
	ДанныеЗаказа.Вставить("Телефон", ПривестиТелефон(СтрокаИзJSON(ЗначениеПоляJSON(Покупатель, "phone"))));
	ДанныеЗаказа.Вставить("Комментарий", Комментарий);
	ДанныеЗаказа.Вставить("ИсходныйПакетJSON", ТекстЗаказа);
	ДанныеЗаказа.Вставить("ОплаченНаПортале", БулевоИзJSON(ЗначениеПоляJSON(Оплата, "isPayed")));
	ДанныеЗаказа.Вставить("СпособДоставки", СпособДоставки);
	ДанныеЗаказа.Вставить("АдресДоставки", АдресДоставки);
	ДанныеЗаказа.Вставить("Товары", Новый Массив);

	Корзина = ЗначениеПоляJSON(ЗаказПортала, "basket");
	Если ТипЗнч(Корзина) <> Тип("Массив") Или Корзина.Количество() = 0 Тогда
		ЕстьОшибки = Истина;
		Возврат ДанныеЗаказа;
	КонецЕсли;

	КэшСерийныхВидов = Новый Соответствие;
	Для Каждого СтрокаКорзины Из Корзина Цикл
		Номенклатура = НоменклатураПоXmlId(ЗначениеПоляJSON(СтрокаКорзины, "xmlId"));
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ЕстьОшибки = Истина;
			Продолжить;
		КонецЕсли;

		ИдТовара = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(СтрокаКорзины, "xmlId")));
		СтрокаТовара = Новый Структура;
		СтрокаТовара.Вставить("ИдПозиции", ИдТовара);
		СтрокаТовара.Вставить("ИдТовара", ИдТовара);
		СтрокаТовара.Вставить("ИмяТовара", СтрокаИзJSON(ЗначениеПоляJSON(СтрокаКорзины, "name")));
		СтрокаТовара.Вставить("Номенклатура", Номенклатура);
		СтрокаТовара.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		СтрокаТовара.Вставить("Количество", ЧислоИзJSON(ЗначениеПоляJSON(СтрокаКорзины, "quantity")));
		СтрокаТовара.Вставить("Цена", ЧислоИзJSON(ЗначениеПоляJSON(СтрокаКорзины, "price")));  
		ДобавитьСтрокиТовараЗаказа(ДанныеЗаказа.Товары, СтрокаТовара, КэшСерийныхВидов);
	КонецЦикла;

	Возврат ДанныеЗаказа;

КонецФункции

Процедура ДобавитьСтрокиТовараЗаказа(Товары, СтрокаТовара, КэшСерийныхВидов)

	КоличествоШтук = Цел(СтрокаТовара.Количество);
	Если КоличествоШтук < 2
		Или СтрокаТовара.Количество <> КоличествоШтук
		Или Не ВидНоменклатурыСерийный(СтрокаТовара.Номенклатура, КэшСерийныхВидов) Тогда
		Товары.Добавить(СтрокаТовара);
		Возврат;
	КонецЕсли;

	// Сумма позиции сайта — цена * количество, в копейках. Остаток копеек
	// кладётся на последние строки, чтобы сумма строк совпала с позицией сайта.
	СуммаКопеек = Окр(Окр(СтрокаТовара.Цена * СтрокаТовара.Количество, 2) * 100, 0);
	ЦенаКопеек = Цел(СуммаКопеек / КоличествоШтук);
	ОстатокКопеек = СуммаКопеек - ЦенаКопеек * КоличествоШтук;

	Для Номер = 1 По КоличествоШтук Цикл
		КопеекСтроки = ЦенаКопеек;
		Если Номер > КоличествоШтук - ОстатокКопеек Тогда
			КопеекСтроки = КопеекСтроки + 1;
		КонецЕсли;
		Товары.Добавить(КопияСтрокиТовара(СтрокаТовара, 1, КопеекСтроки / 100));
	КонецЦикла;

КонецПроцедуры

Функция ВидНоменклатурыСерийный(Номенклатура, КэшСерийныхВидов)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	Признак = КэшСерийныхВидов.Получить(Номенклатура);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;

	НаименованиеВида = "";
	Категория = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КатегорияНоменклатуры");
	Если ЗначениеЗаполнено(Категория) Тогда
		НаименованиеВида = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Категория, "Наименование");
	КонецЕсли;

	Признак = ТекстСодержитСлово(НаименованиеВида, "серийный");
	КэшСерийныхВидов.Вставить(Номенклатура, Признак);
	Возврат Признак;

КонецФункции

Функция ТекстСодержитСлово(Текст, Слово)

	ИсходныйТекст = " " + НРег(СокрЛП(Строка(Текст))) + " ";
	Искомое = НРег(Слово);
	Позиция = 1;
	Пока Позиция > 0 Цикл
		Позиция = СтрНайти(ИсходныйТекст, Искомое, , Позиция);
		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		СимволДо = Сред(ИсходныйТекст, Позиция - 1, 1);
		СимволПосле = Сред(ИсходныйТекст, Позиция + СтрДлина(Искомое), 1);
		Если Не ЭтоБуква(СимволДо) И Не ЭтоБуква(СимволПосле) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоБуква(Символ)

	Возврат СтрНайти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", НРег(Символ)) > 0;


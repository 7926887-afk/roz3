// Процедура выполняет чтение табличного документа формата MXL
//
Процедура ПрочитатьТабличныйДокументИзMXL(ТабличныйДокумент, АдресВоВременномХранилище, СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	ВременныйФайл = КаталогВременныхФайлов() + "testUA.mxl";
	ДанныеФайла.Записать(ВременныйФайл);
	
	Попытка
		ТабличныйДокумент.Прочитать(ВременныйФайл);
	Исключение
		Если СтруктураПараметровЛогирования = Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru= 'Ошибка открытия файла!'"));
		Иначе
			ДобавитьВЛог(НСтр("ru= 'Ошибка открытия файла!'"), 1, СтруктураПараметровЛогирования);
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

Функция ПрочитатьДанныеВТабличныйДокумент(ТабличныйДокумент, АдресВоВременномХранилище, ПереданноеРасширение = ".xls", СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	ВременныйФайл = КаталогВременныхФайлов() + "testUA"+ПереданноеРасширение;
	ДанныеФайла.Записать(ВременныйФайл);
	ИмяФайла = ВременныйФайл;
	
	
	ВыбФайл = Новый Файл(ИмяФайла);
	Если НЕ ВыбФайл.Существует() Тогда
		Если СтруктураПараметровЛогирования = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru= 'Файл не существует!'"));
		Иначе
			ДобавитьВЛог(НСтр("ru= 'Файл не существует!'"),1,СтруктураПараметровЛогирования);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		ТабличныйДокумент.Прочитать(ИмяФайла);
		
	Исключение
		Если СтруктураПараметровЛогирования = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Иначе
			ДобавитьВЛог(ОписаниеОшибки(),1,СтруктураПараметровЛогирования);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		УдалитьФайлы(ВременныйФайл);
	Исключение
	КонецПопытки;
	
	Возврат Истина;
КонецФункции

Функция ПерезаполнитьДанныеВТабличномДокументе (ТабличныйДокумент, НачалоСтраницы, КонецСтраницы) Экспорт
	
	ВыводимаяОбласть = "R"+НачалоСтраницы+":R"+КонецСтраницы;
	ВременныйТабДок = ТабличныйДокумент.ПолучитьОбласть(ВыводимаяОбласть);
	
	Возврат ВременныйТабДок;
	
КонецФункции

// Процедура проверяет загружаемые реквизиты объектов метаданных на соответствие
// текущим реквизитам объекта метаданных дерева конфигурации.
// Для переданных параметров реквизита в СтруктураЗагружаемогоРеквизита производится замена старых параметров
// на актуальные.
// Для реквизитов какого объекта метаданных необходимо производит замену, указывается в условии проверки и,
// Соответственно, версии ВерсияОбъектовМетаданных.
Процедура ПроверитьЗагружаемыйРеквизит(СтруктураЗагружаемогоРеквизита, МетаданныеИсточникаИмя, ВерсияОбъектовМетаданных, ТекстСообщения = "") Экспорт
	
	Макет = Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ПолучитьМакет("МакетСохраненияНастроек");
	ТекущаяВерсияОбъектовМетаданных = Макет.Область("R31C5").Текст;
	
	Если ТекущаяВерсияОбъектовМетаданных = ВерсияОбъектовМетаданных Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает по переданному строковому значению МетаданныеИсточникаИмя актуальный объект метаданных.
// Для выполнения замены несуществующего метаданного на актуальное необходимо в функцию передать полученное
// из настроек загрузки (Табличный документ) текстовое значение имени метаданных:
// МетаданныеОбъектаИмя = Настройки.Область(?(ВерсияОбработки = "1.1","R2","R3") + "C5").Текст.
// Соответственно в функции, для переданного имени и при условии ВерсияОбъектовМетаданных меньше актуальной
// Произвести присвоение для МетаданныеИсточника нового объекта метаданных
Функция ПреобразоватьЗагружаемоеМетаданное(МетаданныеИсточникаИмя, ВерсияОбъектовМетаданных, ТекстСообщения = "") Экспорт
	
	МетаданныеИсточника = Неопределено;
	
	Если ВерсияОбъектовМетаданных < "1.0" Тогда
		Если МетаданныеИсточникаИмя = "Документ.ТоварноТранспортнаяНакладнаяЕГАИС.ТабличнаяЧасть.Товары" Тогда
			МетаданныеИсточника = Метаданные.Документы.ТТНВходящаяЕГАИС.ТабличныеЧасти.Товары;
			Текст = "В настройках загрузки изменен объект метаданных " + МетаданныеИсточникаИмя + " на " + "" + МетаданныеИсточника.Родитель() + "";
			ТекстСообщения = ?(ТекстСообщения = "", Текст, ТекстСообщения + Символы.ПС + Текст);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МетаданныеИсточника;
	
КонецФункции

// Процедура выполняет групповую обработку настроек загрузки
//
Процедура ВыполнитьГрупповуюОбработкуНастроекЗагрузки(МассивНастроек, ТекстСообщения) Экспорт
	Для Каждого НастройкаСсылка ИЗ МассивНастроек Цикл
		НастройкаОбъект = НастройкаСсылка.ПолучитьОбъект();
		Настройка = НастройкаОбъект.НастройкиЗагрузкиВыгрузки.Получить();
		Если ТипЗнч(Настройка) <> Тип("ТабличныйДокумент") Тогда
			ТекстСообщения = "Для " + НастройкаСсылка + " указан неверный формат настроек Загрузки/Выгрузки!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		// Получим текущую версию обработки и версию объектов метаданных.
		Макет = Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ПолучитьМакет("МакетСохраненияНастроек");
		ТекущаяВерсияОбработки = Макет.Область("R1C5").Текст;
		ТекущаяВерсияОбъектовМетаданных = Макет.Область("R31C5").Текст;
		
		// Получим версию обработки и версию объектов метаданных настройки.
		ВерсияОбработки = СокрЛП(Настройка.Область("R1C5").Текст);
		ВерсияОбъектовМетаданных = СокрЛП(Настройка.Область("R31C5").Текст);
		Если ВерсияОбработки = ТекущаяВерсияОбработки И ВерсияОбъектовМетаданных = ТекущаяВерсияОбъектовМетаданных Тогда
			// Проверять настройку не нужно, она актуальна.
			Продолжить;
		КонецЕсли;
		
		МетаданныеИсточникаИмя = Настройка.Область("R3C5").Текст;
		МетаданныеИсточника = Метаданные.НайтиПоПолномуИмени(МетаданныеИсточникаИмя);
		
		ТекстСообщения = ?(ТекстСообщения = "", "" + НастройкаСсылка + " :", ТекстСообщения + Символы.ПС + "" + НастройкаСсылка + ":");
		
		Если МетаданныеИсточника = Неопределено Тогда
			МетаданныеИсточника = ПреобразоватьЗагружаемоеМетаданное(МетаданныеИсточникаИмя, ВерсияОбъектовМетаданных, ТекстСообщения);
			Если МетаданныеИсточника = Неопределено Тогда
				ВызватьИсключение "Неправильный формат файла";
			КонецЕсли;
		КонецЕсли;
		
		СтруктураНастройки = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ПолучитьПараметрыПоВерсииОбработки(ВерсияОбработки, Настройка);
		
		СтруктураНастройки.Вставить("МетаданныеИсточникаИзСправочника", МетаданныеИсточника);
		Если Метаданные.Справочники.Содержит(МетаданныеИсточника) Тогда
			РежимЗагрузки = 0;
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеИсточника) Тогда
			РежимЗагрузки = 2;
		Иначе
			РежимЗагрузки = 1;
		КонецЕсли;
		
		ТаблицаЗагружаемыхРеквизитов = Новый ТаблицаЗначений;
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("Пометка");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ПредставлениеРеквизита");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ИмяРеквизита");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("МожетБытьПолемПоиска");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ПолеПоиска");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ДоступноеОписаниеТипов");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ОписаниеТипов");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("РежимЗагрузки");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("НомерКолонки");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ЗначениеПоУмолчанию");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("Выражение");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ИскатьПо");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("СвязьПоВладельцу");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("СвязьПоТипу");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ЭлементСвязиПоТипу");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ШиринаКолонки");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("РежимПоиска");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("НастройкаЗагрузки");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ПодсвечиватьСтроку");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ЭтоДополнительныйРеквизит");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("СсылкаРеквизита");
		ТаблицаЗагружаемыхРеквизитов.Колонки.Добавить("ЭтоСведение");
		
		ТаблицаЗагружаемыхРеквизитовШапки = Новый ТаблицаЗначений;
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("Пометка");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ПредставлениеРеквизита");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ИмяРеквизита");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("МожетБытьПолемПоиска");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ПолеПоиска");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ДоступноеОписаниеТипов");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ОписаниеТипов");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("РежимЗагрузки");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("НомерКолонки");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ЗначениеПоУмолчанию");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("Выражение");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ИскатьПо");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("СвязьПоВладельцу");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("СвязьПоТипу");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ЭлементСвязиПоТипу");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ШиринаКолонки");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("РежимПоиска");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("НастройкаЗагрузки");
		ТаблицаЗагружаемыхРеквизитовШапки.Колонки.Добавить("ПодсвечиватьСтроку");
		
		ТаблицаДополнительныхПараметров = Новый ТаблицаЗначений;
		ТаблицаДополнительныхПараметров.Колонки.Добавить("ИмяРеквизита");
		ТаблицаДополнительныхПараметров.Колонки.Добавить("НомерКолонки");
		ТаблицаДополнительныхПараметров.Колонки.Добавить("РежимЗагрузки");
		ТаблицаДополнительныхПараметров.Колонки.Добавить("Выражение");
		
		ДополнительныеРеквизитыПоКатегорииНоменклатуры = Новый СписокЗначений;
		
		СтруктураНастройки.Вставить("РежимЗагрузки", РежимЗагрузки);
		
		// Добавляем "пустые" свойства, заполним их позднее.
		СтруктураНастройки.Вставить("ТаблицаЗагружаемыхРеквизитов", ТаблицаЗагружаемыхРеквизитов);
		СтруктураНастройки.Вставить("ТаблицаЗагружаемыхРеквизитовШапки", ТаблицаЗагружаемыхРеквизитовШапки);
		СтруктураНастройки.Вставить("ТаблицаДополнительныхПараметров", ТаблицаДополнительныхПараметров);
		СтруктураНастройки.Вставить("ПередЗаписьюОбъекта", "");
		СтруктураНастройки.Вставить("ПриЗаписиОбъекта", "");
		СтруктураНастройки.Вставить("ПослеДобавленияСтроки", "");
		
		Если СтруктураНастройки.Свойство("ДополнительныеРеквизитыПоКатегорииНоменклатурыИзНастроек") И СтруктураНастройки.ДополнительныеРеквизитыПоКатегорииНоменклатурыИзНастроек <> Неопределено Тогда
			СтруктураНастройки.Вставить("ДополнительныеРеквизитыПоКатегорииНоменклатуры", СтруктураНастройки.ДополнительныеРеквизитыПоКатегорииНоменклатурыИзНастроек);
		Иначе
			СтруктураНастройки.Вставить("ДополнительныеРеквизитыПоКатегорииНоменклатуры", ДополнительныеРеквизитыПоКатегорииНоменклатуры);
		КонецЕсли;
		
		Если НЕ СтруктураНастройки.Свойство("КоличествоНеОбрабатываемыхСтрок") Тогда
			СтруктураНастройки.Вставить("КоличествоНеОбрабатываемыхСтрок", 0);
		КонецЕсли;
		
		ПолучитьСтруктуруРеквизитовШапкиИТабличнойЧасти(Настройка, СтруктураНастройки, ТекстСообщения);
		
		СтруктураУмолчаний = СтруктураНастройки.СтруктураУмолчаний;
		
		Для Каждого Структура Из СтруктураУмолчаний Цикл
			СтрокаТаблицы = ТаблицаЗагружаемыхРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Структура.Значение);
		КонецЦикла;
		
		СтруктураУмолчанийШапки = СтруктураНастройки.СтруктураУмолчанийШапки;
		
		Для Каждого Структура Из СтруктураУмолчанийШапки Цикл
			СтрокаТаблицы = ТаблицаЗагружаемыхРеквизитовШапки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Структура.Значение);
		КонецЦикла;
		
		НоваяНастройка = ПолучитьНастройки(СтруктураНастройки);
		
		НастройкаОбъект.НастройкиЗагрузкиВыгрузки = Новый ХранилищеЗначения(НоваяНастройка);
		
		Попытка
			НастройкаОбъект.ОбменДанными.Загрузка = Истина;
			НастройкаОбъект.Записать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонецПопытки;
		
	КонецЦикла;
КонецПроцедуры

// Процедура выполняет проверку полученных реквизитов из настройки: есть ли они в метаданных объекта.
//
Процедура ВыполнитьПроверкуПолученныхРеквизитовИзНастройки(Метаданное, СтруктураРеквизитов, СтруктураРеквизитовШапки, ТекстСообщения) Экспорт
	
	Если Метаданные.РегистрыСведений.Найти(Метаданное.Имя) <> Неопределено
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Метаданное, "Измерения") Тогда
		
		ИзмеренияРегистра = Метаданное.Измерения;
		РесурсыРегистра = Метаданное.Ресурсы;
		РеквизитыРегистра = Метаданное.Реквизиты;
		СтандартныеРеквизитыРегистра = Метаданное.СтандартныеРеквизиты;
		
		Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
			НайденноеЗначение = ИзмеренияРегистра.Найти(КлючИЗначение.Ключ);
			Если НайденноеЗначение = Неопределено Тогда
				НайденноеЗначение = РесурсыРегистра.Найти(КлючИЗначение.Ключ);
				Если НайденноеЗначение = Неопределено Тогда
					НайденноеЗначение = РеквизитыРегистра.Найти(КлючИЗначение.Ключ);
					Если НайденноеЗначение = Неопределено Тогда
						Для Каждого СтандартныйРеквизит Из СтандартныеРеквизитыРегистра Цикл
							Если СтандартныйРеквизит.Имя = КлючИЗначение.Ключ Тогда
								НайденныйРеквизит = СтандартныйРеквизит;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если НайденноеЗначение = Неопределено Тогда
							Текст = "Были удалены настройки отсутствующего реквизита " + КлючИЗначение.Ключ + "";
							ТекстСообщения = ?(ТекстСообщения = "", Текст, ТекстСообщения + Символы.ПС + Текст);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Иначе
		СтандартныеРеквизитыМетаданного = Метаданное.СтандартныеРеквизиты;
		РеквизитыМетаданного = Метаданное.Реквизиты;
		
		Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
			НайденныйРеквизит = РеквизитыМетаданного.Найти(КлючИЗначение.Ключ);
			Если НайденныйРеквизит = Неопределено Тогда
				Для Каждого СтандартныйРеквизит Из СтандартныеРеквизитыМетаданного Цикл
					Если СтандартныйРеквизит.Имя = КлючИЗначение.Ключ Тогда
						НайденныйРеквизит = СтандартныйРеквизит;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НайденныйРеквизит = Неопределено Тогда
					Текст = "Были удалены настройки отсутствующего реквизита " + КлючИЗначение.Ключ + "";
					ТекстСообщения = ?(ТекстСообщения = "", Текст, ТекстСообщения + Символы.ПС + Текст);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если СтруктураРеквизитовШапки.Количество() <> 0 Тогда
			МетаданноеРодитель = Метаданное.Родитель();
			СтандартныеРеквизитыМетаданногоРодителя = МетаданноеРодитель.СтандартныеРеквизиты;
			РеквизитыМетаданногоРодителя = МетаданноеРодитель.Реквизиты;
			Для Каждого КлючИЗначение Из СтруктураРеквизитовШапки Цикл
				НайденныйРеквизит = РеквизитыМетаданногоРодителя.Найти(КлючИЗначение.Ключ);
				Если НайденныйРеквизит = Неопределено Тогда
					Для Каждого СтандартныйРеквизит Из СтандартныеРеквизитыМетаданногоРодителя Цикл
						Если СтандартныйРеквизит.Имя = КлючИЗначение.Ключ Тогда
							НайденныйРеквизит = СтандартныйРеквизит;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НайденныйРеквизит = Неопределено Тогда
						Текст = "Были удалены настройки отсутствующего реквизита " + КлючИЗначение.Ключ + "";
						ТекстСообщения = ?(ТекстСообщения = "", Текст, ТекстСообщения + Символы.ПС + Текст);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьКодировкуXBase(XBase, ТипКодировки) Экспорт
	
	Если ТипКодировки = "OEM" Тогда
		XBase.Кодировка = КодировкаXBase.OEM;
	ИначеЕсли ТипКодировки = "ANSI" Тогда
		XBase.Кодировка = КодировкаXBase.ANSI;
	КонецЕсли;
	
КонецПроцедуры

// Функция приводит строковое представление даты к его значению
//
// Параметры:
//  Представление - Строка			- Представление числа
//  ОписаниеТипов - ОписаниеТипов	- Допустимое описание типов значения типа дата
//  Примечание    - Строка			- Примечание (необязательный).
//
// Возвращаемое значение:
//  Дата 		- Значение типа дата
//
Функция ПривестиКДате(Представление, ТипРеквизита, Примечание = "") Экспорт
	
	Результат = ТипРеквизита.ПривестиЗначение(Представление);
	Если Результат = '00010101' Тогда
		
		МассивЧастей = ПолучитьЧастиПредставленияДаты(Представление);
		Если ТипРеквизита.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Время Тогда
			
			Попытка
				
				Если МассивЧастей.Количество() = 3 Тогда
					Результат = Дата(1,1,1, МассивЧастей[0],МассивЧастей[1],МассивЧастей[2]);
				ИначеЕсли МассивЧастей.Количество() = 6 Тогда
					Результат = Дата(1,1,1, МассивЧастей[3],МассивЧастей[4],МассивЧастей[5]);
				КонецЕсли;
				
			Исключение
				Примечание = НСтр("ru = 'Неправильный формат даты'");
			КонецПопытки;
			
		ИначеЕсли МассивЧастей.Количество() = 3 ИЛИ МассивЧастей.Количество() = 6 Тогда
			
			Если МассивЧастей[0] >= 1000 Тогда
				Временно = МассивЧастей[0];
				МассивЧастей[0] = МассивЧастей[2];
				МассивЧастей[2] = Временно;
			КонецЕсли;
			
			Если МассивЧастей[2] < 100 Тогда
				МассивЧастей[2] = МассивЧастей[2] + ?(МассивЧастей[2] < 30, 2000,1900);
			КонецЕсли;
			
			Попытка
				Если МассивЧастей.Количество() = 3 ИЛИ ТипРеквизита.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Дата Тогда
					Результат = Дата(МассивЧастей[2],МассивЧастей[1],МассивЧастей[0]);
				Иначе
					Результат = Дата(МассивЧастей[2],МассивЧастей[1],МассивЧастей[0],МассивЧастей[3],МассивЧастей[4],МассивЧастей[5]);
				КонецЕсли;
			Исключение
				Примечание = НСтр("ru = 'Неправильный формат даты'");
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //мПривестиКДате()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Для преобразования имени файла при обращении к OpenOffice/LibreOffice
Функция ConvertToURL(FileName)
	ИмяФайла =  СтрЗаменить(FileName," ","%20" );
	ИмяФайла =  СтрЗаменить(ИмяФайла,"\","/");
	Возврат "file:/" + "/localhost/" + ИмяФайла;
КонецФункции

// Получает информацию по заданному штрихкоду
//
// Параметры:
//  Штрихкод         - Строка			- значение штрих-кода
//
// Возвращаемое значение:
//  Таблица		- Таблица найденных товаров
//
Функция ПолучитьШтрихкоды(Штрихкод)
	
	// Создадим запрос по регистру сведений.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШК",Штрихкод);
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Штрихкоды.Номенклатура КАК Объект,
	|	Штрихкоды.Характеристика КАК ХарактеристикаНоменклатуры
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &ШК
	|	И Штрихкоды.Номенклатура.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Объект";
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);
	
КонецФункции // ПолучитьШтрихкодыШтрихкоды()

// Функция возвращает части представления даты
//
// Параметры:
//  Представление - Строка	- Представление даты
//
// Возвращаемое значение:
//  Массив	- Массив частей даты
//
Функция ПолучитьЧастиПредставленияДаты(ЗНАЧ Представление)
	
	МассивЧастей = Новый Массив;
	НачалоЦифры = 0;
	Для к = 1 По СтрДлина(Представление) Цикл
		
		Символ = Сред(Представление, к ,1);
		ЭтоЦифра = Символ >= "0" И Символ <= "9";
		
		Если ЭтоЦифра Тогда
			
			Если НачалоЦифры = 0 Тогда
				НачалоЦифры = к;
			КонецЕсли;
			
		Иначе
			
			Если НЕ НачалоЦифры = 0 Тогда
				МассивЧастей.Добавить(Число(Сред(Представление,НачалоЦифры, к - НачалоЦифры)));
			КонецЕсли;
			
			НачалоЦифры = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ НачалоЦифры = 0 Тогда
		МассивЧастей.Добавить(Число(Сред(Представление,НачалоЦифры)));
	КонецЕсли;
	
	Возврат МассивЧастей;
	
КонецФункции //ПолучитьЧастиПредставленияДаты()

// Заполняет настройки колонок по умолчанию для справочника
//
Процедура ЗаполнитьНастройкиКолонокСправочника(СтруктураПараметров)
	
	МассивБулево = Новый Массив;
	МассивБулево.Добавить(Тип("Булево"));
	
	МетаданныеИсточника = ПолучитьМетаданныеИсточника(СтруктураПараметров);
	
	Если МетаданныеИсточника.ДлинаКода > 0 Тогда
		
		ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "Код";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Код";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   =  Истина;
		
		Если МетаданныеИсточника.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка Тогда
			ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(МетаданныеИсточника.ДлинаКода));
		Иначе
			ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(МетаданныеИсточника.ДлинаКода));
		КонецЕсли;
		
	КонецЕсли;
	
	Если МетаданныеИсточника.ДлинаНаименования > 0 Тогда
		
		ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "Наименование";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Наименование";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   =  Истина;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(МетаданныеИсточника.ДлинаНаименования));
		
	КонецЕсли;
	
	ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита           = "ПометкаУдаления";
	ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Пометка удаления";
	ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Ложь;
	ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов(МассивБулево);
	
	Если МетаданныеИсточника.Владельцы.Количество() > 0 Тогда
		
		ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "Владелец";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Владелец";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   =  Истина;
		
		СтрокаОписанияТипов = "";
			
		Для Каждого ТекВладелец Из МетаданныеИсточника.Владельцы Цикл
			СтрокаОписанияТипов = ?(ПустаяСтрока(СтрокаОписанияТипов),"",СтрокаОписанияТипов + ", ") + ТекВладелец.ПолноеИмя();
		КонецЦикла;
			
		СтрокаОписанияТипов = СтрЗаменить(СтрокаОписанияТипов,".","Ссылка.");
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов(СтрокаОписанияТипов);
		
	КонецЕсли;
	
	Если МетаданныеИсточника.Иерархический Тогда
		
		ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "Родитель";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Родитель";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов(СтрЗаменить(МетаданныеИсточника.ПолноеИмя(),".","Ссылка."));
		
		ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "ЭтоГруппа";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Это группа";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Ложь;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов(МассивБулево);
	КонецЕсли;
	
	ЕстьОтраслевойПроизводитель = Ложь;
	Для Каждого Реквизит Из МетаданныеИсточника.Реквизиты Цикл
		Если Реквизит.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(Реквизит.Имя) = НРег("ор_Производитель") Тогда
			ЕстьОтраслевойПроизводитель = Истина;
		КонецЕсли;
		ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = НЕ Реквизит.Индексирование = Метаданные.СвойстваОбъектов.Индексирование.НеИндексировать;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = МетаданныеИсточника.Реквизиты[ЗагружаемыйРеквизит.ИмяРеквизита].Тип;
	КонецЦикла;
	
	// ++ Аптека
	Если ЕстьОтраслевойПроизводитель Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИмяРеквизита", "Производитель");
		МассивСтрок = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(ПараметрыОтбора);
		Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
			СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Удалить(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	// -- Аптека
	
	ДополнитьДополнительныеРеквизитыВТаблицуРеквизитов(МетаданныеИсточника, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов, СтруктураПараметров.ДополнительныеРеквизитыПоКатегорииНоменклатуры, СтруктураПараметров.ЗагружатьДополнительныеРеквизитыИСведения, СтруктураПараметров.ДополнительныеРеквизитыИСведенияТолькоОбщие);

	Для Каждого ЗагружаемыйРеквизит Из СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов Цикл
		ЗагружаемыйРеквизит.ОписаниеТипов = ЗагружаемыйРеквизит.ДоступноеОписаниеТипов;
	КонецЦикла;
	
	Для Каждого ЗагружаемыйРеквизит Из СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов Цикл
		
		СписокВыбора = ПолучитьСписокИменПредставлений(ЗагружаемыйРеквизит);
		ЗагружаемыйРеквизит.ИскатьПо = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоВладельцу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
		ЗагружаемыйРеквизит.СвязьПоВладельцу = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоТипу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
		Если СписокВыбора.Количество() = 0 Тогда
			ЗагружаемыйРеквизит.СвязьПоТипу = "";
			ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 0;
		Иначе
			ЗагружаемыйРеквизит.СвязьПоТипу = СписокВыбора[0].Значение;
			Если Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"3") <> 0 Тогда
				
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 3;
				
			ИначеЕсли Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"2") <> 0 Тогда
				
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 2;
				
			Иначе
				
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 1;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗагружаемыйРеквизит.ЗначениеПоУмолчанию = ЗагружаемыйРеквизит.ОписаниеТипов.ПривестиЗначение(Неопределено);
		
		ЗагружаемыйРеквизит.РежимЗагрузки = "Искать";
	КонецЦикла;
	
	
КонецПроцедуры // ЗаполнитьНастройкиКолонокСправочника()

// Заполняет настройки колонок по умолчанию для регистра сведений
//
Процедура ЗаполнитьНастройкиКолонокРегистраСведений(СтруктураПараметров)
	
	МетаданныеИсточника = ПолучитьМетаданныеИсточника(СтруктураПараметров);
	
	Если МетаданныеИсточника = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ МетаданныеИсточника.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		
		ЗагружаемыйРеквизит = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "Период";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Период";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска = Истина;
		ЗагружаемыйРеквизит.ПолеПоиска           = Истина;
		
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Дата", , , ,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
		
	КонецЕсли;
	
	Для Каждого Реквизит Из МетаданныеИсточника.Измерения Цикл
		ЗагружаемыйРеквизит                        = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска = Истина;
		ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = МетаданныеИсточника.Измерения[ЗагружаемыйРеквизит.ИмяРеквизита].Тип;
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеИсточника.Ресурсы Цикл
		ЗагружаемыйРеквизит                        = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = МетаданныеИсточника.Ресурсы[ЗагружаемыйРеквизит.ИмяРеквизита].Тип;
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеИсточника.Реквизиты Цикл
		ЗагружаемыйРеквизит                        = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = МетаданныеИсточника.Реквизиты[ЗагружаемыйРеквизит.ИмяРеквизита].Тип;
	КонецЦикла;
	
	Для Каждого ЗагружаемыйРеквизит Из СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов Цикл
		ЗагружаемыйРеквизит.ОписаниеТипов = ЗагружаемыйРеквизит.ДоступноеОписаниеТипов;
	КонецЦикла;
	
	Для Каждого ЗагружаемыйРеквизит Из СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов Цикл
		
		СписокВыбора = ПолучитьСписокИменПредставлений(ЗагружаемыйРеквизит);
		ЗагружаемыйРеквизит.ИскатьПо = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоВладельцу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
		ЗагружаемыйРеквизит.СвязьПоВладельцу = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоТипу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
		Если СписокВыбора.Количество() = 0 Тогда
			ЗагружаемыйРеквизит.СвязьПоТипу = "";
			ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 0;
		Иначе
			ЗагружаемыйРеквизит.СвязьПоТипу = СписокВыбора[0].Значение;
			Если Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"3") <> 0 Тогда
				
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 3;
				
			ИначеЕсли Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"2") <> 0 Тогда
				
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 2;
				
			Иначе
				
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 1;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗагружаемыйРеквизит.ЗначениеПоУмолчанию = ЗагружаемыйРеквизит.ОписаниеТипов.ПривестиЗначение(Неопределено);
		
		ЗагружаемыйРеквизит.РежимЗагрузки = "Искать";
		ЗагружаемыйРеквизит.РежимПоиска = "По равному значению";
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьНастройкиКолонокРегистраСведений()

// Заполняет настройки колонок по умолчанию для табличной части
//
Процедура ЗаполнитьНастройкиКолонокТабличнойЧасти(СтруктураПараметров)
	
	МетаданныеИсточника = ПолучитьМетаданныеИсточника(СтруктураПараметров);
	
	Если Метаданные.РегистрыСведений.Содержит(МетаданныеИсточника) Тогда
		Для Каждого Реквизит Из МетаданныеИсточника.Измерения Цикл
			ЗагружаемыйРеквизит                        = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
			ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
			ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
			ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Реквизит.Тип;
			ЗагружаемыйРеквизит.ОписаниеТипов          = Реквизит.Тип;
		КонецЦикла;
		Для Каждого Реквизит Из МетаданныеИсточника.Ресурсы Цикл
			ЗагружаемыйРеквизит                        = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
			ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
			ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
			ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Реквизит.Тип;
			ЗагружаемыйРеквизит.ОписаниеТипов          = Реквизит.Тип;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Реквизит Из МетаданныеИсточника.Реквизиты Цикл
		ЗагружаемыйРеквизит                        = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Реквизит.Тип;
		ЗагружаемыйРеквизит.ОписаниеТипов          = Реквизит.Тип;
	КонецЦикла;
	
	Для Каждого ЗагружаемыйРеквизит Из СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов Цикл
		
		СписокВыбора = ПолучитьСписокИменПредставлений(ЗагружаемыйРеквизит);
		ЗагружаемыйРеквизит.ИскатьПо = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоВладельцу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
		ЗагружаемыйРеквизит.СвязьПоВладельцу = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоТипу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
		Если СписокВыбора.Количество() = 0 Тогда
			ЗагружаемыйРеквизит.СвязьПоТипу = "";
			ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 0;
		Иначе
			ЗагружаемыйРеквизит.СвязьПоТипу = СписокВыбора[0].Значение;
			Если Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"3") <> 0 Тогда
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 3;
			ИначеЕсли Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"2") <> 0 Тогда
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 2;
			Иначе
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 1;
			КонецЕсли;
		КонецЕсли;
		
		ЗагружаемыйРеквизит.ЗначениеПоУмолчанию = ЗагружаемыйРеквизит.ОписаниеТипов.ПривестиЗначение(Неопределено);
		ЗагружаемыйРеквизит.РежимЗагрузки = "Искать";
		ЗагружаемыйРеквизит.РежимПоиска = "По равному значению";
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьНастройкиКолонокТабличнойЧасти()

// Функция проверки наличия реквизита в переданной табличной части.
//
Функция ЕстьРеквизитТЧОбъекта(ИмяРеквизита, МетаданныеОбъекта, ИмяТЧ)

	ТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ);
	Если ТЧ = Неопределено Тогда 
		Возврат Ложь;
	Иначе
		Если ТЧ.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

КонецФункции 

// Заполняет настройки шапки по умолчанию
//
Процедура ЗаполнитьНастройкиШапки(СтруктураПараметров)
	
	МетаданныеИсточника = ПолучитьМетаданныеИсточника(СтруктураПараметров);
	
	Если НЕ Метаданные.Документы.Содержит(МетаданныеИсточника.Родитель()) Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеРодителя = МетаданныеИсточника.Родитель();
	Для Каждого Реквизит Из МетаданныеРодителя.Реквизиты Цикл
		ЗагружаемыйРеквизит                        = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитовШапки.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Реквизит.Тип;
		ЗагружаемыйРеквизит.ОписаниеТипов          = Реквизит.Тип;
	КонецЦикла;
	
	Для Каждого ЗагружаемыйРеквизит Из СтруктураПараметров.ТаблицаЗагружаемыхРеквизитовШапки Цикл
		
		СписокВыбора = ПолучитьСписокИменПредставлений(ЗагружаемыйРеквизит);
		ЗагружаемыйРеквизит.ИскатьПо = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоВладельцу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитовШапки);
		ЗагружаемыйРеквизит.СвязьПоВладельцу = ?(СписокВыбора.Количество() = 0, "",СписокВыбора[0].Значение);
		
		СписокВыбора = ПолучитьСписокСвязейПоТипу(ЗагружаемыйРеквизит, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитовШапки);
		Если СписокВыбора.Количество() = 0 Тогда
			ЗагружаемыйРеквизит.СвязьПоТипу = "";
			ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 0;
		Иначе
			ЗагружаемыйРеквизит.СвязьПоТипу = СписокВыбора[0].Значение;
			Если Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"3") <> 0 Тогда
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 3;
			ИначеЕсли Найти(ЗагружаемыйРеквизит.ИмяРеквизита,"2") <> 0 Тогда
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 2;
			Иначе
				ЗагружаемыйРеквизит.ЭлементСвязиПоТипу = 1;
			КонецЕсли;
		КонецЕсли;
		
		ЗагружаемыйРеквизит.ЗначениеПоУмолчанию = ЗагружаемыйРеквизит.ОписаниеТипов.ПривестиЗначение(Неопределено);
		ЗагружаемыйРеквизит.РежимЗагрузки = "Искать";
		ЗагружаемыйРеквизит.РежимПоиска = "По равному значению";
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьНастройкиШапки()

// Процедура получает структуру реквизитов шапки и табличной части из переданной настройки(табличного документа).
//
Процедура ПолучитьСтруктуруРеквизитовШапкиИТабличнойЧасти(Настройки, СтруктураПараметров, ТекстСообщения)
	
	СтруктураПараметров.ПередЗаписьюОбъекта   = "";
	СтруктураПараметров.ПриЗаписиОбъекта      = "";
	СтруктураПараметров.ПослеДобавленияСтроки = "";
	
	Если ТипЗнч(Настройки) = Тип("ТабличныйДокумент") Тогда
		
		ВерсияОбработки = СокрЛП(Настройки.Область("R1C5").Текст);
		
		ТекущаяСтрока = СтруктураПараметров.ТекущаяСтрока;
		ТекущаяСтрокаШапка = СтруктураПараметров.ТекущаяСтрокаШапка;
		
		Попытка
			
			ТекстВосстановленногоРежимаЗагрузки = СокрЛП(Настройки.Область("R2C5").Текст);
			Если ТекстВосстановленногоРежимаЗагрузки = "в справочник" ИЛИ ТекстВосстановленногоРежимаЗагрузки = "" Тогда
				ВосстановленныйРежимЗагрузки = 0;
			ИначеЕсли ТекстВосстановленногоРежимаЗагрузки = "в табличную часть" ИЛИ ТекстВосстановленногоРежимаЗагрузки = "Х" Тогда
				Если ТекстВосстановленногоРежимаЗагрузки = "в табличную часть" Тогда
					ТекстОбъекта = СокрЛП(Настройки.Область("R3C5").Текст);
					Если Лев(ТекстОбъекта, 16) = "РегистрСведений." Тогда
						ВосстановленныйРежимЗагрузки = 2;
					Иначе
						ВосстановленныйРежимЗагрузки = 1;
					КонецЕсли;
				Иначе
					ВосстановленныйРежимЗагрузки = 1;
				КонецЕсли;
			ИначеЕсли ТекстВосстановленногоРежимаЗагрузки = "в регистр сведений" Тогда
				ВосстановленныйРежимЗагрузки = 2;
			КонецЕсли;
			
			Если СтруктураПараметров.РежимЗагрузки = 3 Тогда
				Если ВосстановленныйРежимЗагрузки = 1 ИЛИ ВосстановленныйРежимЗагрузки = 2 Тогда
					ВосстановленныйРежимЗагрузки = 3;
				ИначеЕсли ВосстановленныйРежимЗагрузки = 0 Тогда
				Иначе
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			ВерсияОбъектовМетаданных = СокрЛП(Настройки.Область("R31C5").Текст);
			
			МетаданныеОбъектаИмя = Настройки.Область("R3C5").Текст;
			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(МетаданныеОбъектаИмя);
			
			Если МетаданныеОбъекта = Неопределено Тогда
				Если СтруктураПараметров.Свойство("МетаданныеИсточникаИзСправочника") И СтруктураПараметров.МетаданныеИсточникаИзСправочника <> Неопределено Тогда
					МетаданныеОбъекта = СтруктураПараметров.МетаданныеИсточникаИзСправочника;
				Иначе
					МетаданныеОбъекта = ПреобразоватьЗагружаемоеМетаданное(МетаданныеОбъектаИмя, ВерсияОбъектовМетаданных, ТекстСообщения);
					Если МетаданныеОбъекта = Неопределено Тогда
						ВызватьИсключение "Неправильный формат файла";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			СтруктураУмолчаний = Новый Структура;
			ТекущаяСтрокаОбласти = "R" + Формат(ТекущаяСтрока, "ЧГ=");
			ИмяРеквизита = Настройки.Область(ТекущаяСтрокаОбласти + "C2").Текст;
			Пока НЕ ПустаяСтрока(ИмяРеквизита) Цикл
				СтруктураУмолчанияРеквизита = Новый Структура;
				СтруктураУмолчанияРеквизита.Вставить("ИмяРеквизита",ИмяРеквизита);
				СтруктураУмолчанияРеквизита.Вставить("Пометка",НЕ ПустаяСтрока(Настройки.Область(ТекущаяСтрокаОбласти + "C1").Текст));
				СтруктураУмолчанияРеквизита.Вставить("ПолеПоиска",НЕ ПустаяСтрока(Настройки.Область(ТекущаяСтрокаОбласти + "C3").Текст));
				
				Типы = Новый Массив;
				ОписаниеТиповСтрокой = Настройки.Область(ТекущаяСтрокаОбласти + "C4").Текст;
				
				Для к = 1 По СтрЧислоСтрок(ОписаниеТиповСтрокой)  Цикл
					

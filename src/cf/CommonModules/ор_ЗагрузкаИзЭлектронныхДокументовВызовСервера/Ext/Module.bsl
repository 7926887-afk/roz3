	СоответствиеНоменклатуры.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(150)));
	СоответствиеНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СоответствиеНоменклатуры.Колонки.Добавить("Цена",  Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)));
	СоответствиеНоменклатуры.Колонки.Добавить("Загружать", Новый ОписаниеТипов("Булево"));
	СоответствиеНоменклатуры.Колонки.Добавить("ВидСтавкиНДС", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыСтавокНДС"));
	СоответствиеНоменклатуры.Колонки.Добавить("ЗначенийБольшеОдного", Новый ОписаниеТипов("Булево"));
	
	СтруктураТаблиц = Новый Структура;
	СтруктураТаблиц.Вставить("ТаблицаЗагружаемыхРеквизитов", ТаблицаЗагружаемыхРеквизитов);
	СтруктураТаблиц.Вставить("ТаблицаЗагружаемыхРеквизитовШапки", ТаблицаЗагружаемыхРеквизитовШапки);
	СтруктураТаблиц.Вставить("ТаблицаДополнительныхПараметров", ТаблицаДополнительныхПараметров);
	СтруктураТаблиц.Вставить("СоответствиеНоменклатуры", СоответствиеНоменклатуры);
	
	Возврат СтруктураТаблиц;
	
КонецФункции

// Формирует запись в регистре "История загрузки"
//
Процедура ДобавитьВЛог(ТекстСообщения, Статус, СтруктураПараметровЛогирования) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкаЗагрузки    = СтруктураПараметровЛогирования.НастройкаЗагрузки;
	ДатаЗагрузки         = ТекущаяДата();
	ИмяЗагружаемогоФайла = СтруктураПараметровЛогирования.ИмяЗагружаемогоФайла;
	Объект               = СтруктураПараметровЛогирования.ОбъектДляЛогирования;
	ФоноваяЗагрузка      = СтруктураПараметровЛогирования.ФоноваяЗагрузка;
	Контрагент           = СтруктураПараметровЛогирования.Контрагент;
	Каталог              = СтруктураПараметровЛогирования.Каталог;
	ДатаНачалаЗагрузки   = СтруктураПараметровЛогирования.ДатаНачалаЗагрузки;
	
	Если Статус = 1 Тогда
		СтатусОшибки = Перечисления.ор_СтатусыОшибок.Ошибка;
		СтруктураПараметровЛогирования.ЕстьОшибки = Истина;
	ИначеЕсли Статус = 2 Тогда
		СтатусОшибки = Перечисления.ор_СтатусыОшибок.Замечание;
	Иначе
		СтатусОшибки = Перечисления.ор_СтатусыОшибок.Сообщение;
	КонецЕсли;
	
	СтруктураПараметровЛогирования.НумераторСообщений = СтруктураПараметровЛогирования.НумераторСообщений + 1;
	НумераторСообщений = СтруктураПараметровЛогирования.НумераторСообщений;
	
	МенеджерЗаписи = РегистрыСведений.ор_ИсторияЗагрузки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.НастройкаЗагрузки    = НастройкаЗагрузки;
	МенеджерЗаписи.ДатаЗагрузки         = ДатаЗагрузки;
	МенеджерЗаписи.ИмяЗагружаемогоФайла = ИмяЗагружаемогоФайла;
	МенеджерЗаписи.СтатусОшибки         = СтатусОшибки;
	МенеджерЗаписи.Объект               = Объект;
	МенеджерЗаписи.ФоноваяЗагрузка      = ФоноваяЗагрузка;
	МенеджерЗаписи.Контрагент           = Контрагент;
	МенеджерЗаписи.Каталог              = Каталог;
	МенеджерЗаписи.ДатаНачалаЗагрузки   = ДатаНачалаЗагрузки;
	МенеджерЗаписи.НумераторСообщений   = НумераторСообщений;
	МенеджерЗаписи.Сообщение            = ТекстСообщения;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Процедура очищает содержимое табличного документа
//
Процедура ОчиститьТабличныйДокумент(ТабличныйДокумент) Экспорт
	ТабличныйДокумент.Очистить();
КонецПроцедуры

// Функция выполняет формирование нового документа по имени
//
Функция СформироватьДокументГрупповаяЗагрузка(ИмяДокумента) Экспорт
	
	ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДата();
	ДокументОбъект.Комментарий = НСтр("ru = 'Документ создан автоматически при загрузке из электронного документа'");
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();
	ДокументОбъект.ОбменДанными.Загрузка = Ложь;
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

// Процедура выполняет удаление документа по переданной ссылке
//
Процедура УдалитьДокументПриАвтоматическойЗагрузке(СсылкаИсточника) Экспорт
	
	ДокументОбъект = СсылкаИсточника.ПолучитьОбъект();
	ДокументОбъект.Удалить();
	
КонецПроцедуры

// Процедура выполняет проведение документа по переданной ссылке
//
Процедура ПровестиДокументПриАвтоматическойЗагрузке(СсылкаИсточника, ДокументНеПроведен=Ложь) Экспорт
	
	ДокументОбъект = СсылкаИсточника.ПолучитьОбъект();
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная") Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("АвтоЗагрузкаДокумента");
	КонецЕсли;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	// Если при проведении документ не был проведен, а был просто записан, тогда вернем соответствующий признак.
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) И НЕ ДокументОбъект.Проведен Тогда
		ДокументНеПроведен = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Функция выполняет проверку настройки загрузки данных и возвращает результат
//
Функция ВыполнитьПроверкуНастройки(Настройки, НастройкаЗагрузки, СтруктураПараметровОбщая, СтруктураПараметровЛогирования) Экспорт 
	
	СтруктураТаблиц = СформироватьСтруктуруТаблиц();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СсылкаИсточника",                                   СтруктураПараметровОбщая.СсылкаИсточника);
	СтруктураПараметров.Вставить("РежимЗагрузки",                                     СтруктураПараметровОбщая.РежимЗагрузки);
	СтруктураПараметров.Вставить("ТабличнаяЧастьИсточника",                           СтруктураПараметровОбщая.ТабличнаяЧастьИсточника);
	СтруктураПараметров.Вставить("ИмяВидаРегистра",                                   СтруктураПараметровОбщая.ИмяВидаРегистра);
	СтруктураПараметров.Вставить("ИмяСправочника",                                    СтруктураПараметровОбщая.ИмяСправочника);
	СтруктураПараметров.Вставить("ТабличнаяЧастьДокументаОбъекта",                    Неопределено);
	СтруктураПараметров.Вставить("ТЧДокумента",                                       ?(ЗначениеЗаполнено(СтруктураПараметровОбщая.ТабличнаяЧастьИсточника), СтруктураПараметровОбщая.СсылкаИсточника[СтруктураПараметровОбщая.ТабличнаяЧастьИсточника].Выгрузить(), Неопределено));
	СтруктураПараметров.Вставить("НеСоздаватьНовыхЭлементов",                         Ложь);
	СтруктураПараметров.Вставить("НеОбновлятьСуществующиеЭлементы",                   Ложь);
	СтруктураПараметров.Вставить("ЗамещатьСуществующиеЗаписи",                        Ложь);
	СтруктураПараметров.Вставить("РучнаяНумерацияКолонокТабличногоДокумента",         Ложь);
	СтруктураПараметров.Вставить("ПерваяСтрокаДанныхТабличногоДокумента",             0);
	СтруктураПараметров.Вставить("КоличествоНеОбрабатываемыхСтрок",                   0);
	СтруктураПараметров.Вставить("ФорматДатыСрокаГодности",                           "");
	СтруктураПараметров.Вставить("ВсегдаФормироватьНовыеСерии",                       Ложь);
	СтруктураПараметров.Вставить("СоздаватьСтрануПроисхождения",                      Ложь);
	СтруктураПараметров.Вставить("ЗагружатьGTINДляСерии",                             Ложь);
	СтруктураПараметров.Вставить("ДействиеСЗагружаемымФайлом",                        0);
	СтруктураПараметров.Вставить("флПоискПоПрайсуПоставщика",                         Ложь);
	СтруктураПараметров.Вставить("КаталогАрхиваЗагруженныхФайлов",                    "");
	СтруктураПараметров.Вставить("СоздаватьПроизводителя",                            Ложь);
	СтруктураПараметров.Вставить("ИспользоватьВнешнийМодульПреобразованияФайла",      Ложь);
	СтруктураПараметров.Вставить("ОбработкаПреобразования",                           Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка());
	СтруктураПараметров.Вставить("Кодировка",                                         "");
	СтруктураПараметров.Вставить("Табуляция",                                         "");
	СтруктураПараметров.Вставить("ИмяТаблицы",                                        "");
	СтруктураПараметров.Вставить("ПередЗаписьюОбъекта",                               "");
	СтруктураПараметров.Вставить("ПриЗаписиОбъекта",                                  "");
	СтруктураПараметров.Вставить("ПослеДобавленияСтроки",                             "");
	СтруктураПараметров.Вставить("ТаблицаЗагружаемыхРеквизитов",                      СтруктураТаблиц.ТаблицаЗагружаемыхРеквизитов);
	СтруктураПараметров.Вставить("ДополнительныеРеквизитыПоКатегорииНоменклатуры",         Новый СписокЗначений);
	СтруктураПараметров.Вставить("ЗагружатьДополнительныеРеквизитыИСведения",         Ложь);
	СтруктураПараметров.Вставить("ДополнительныеРеквизитыИСведенияТолькоОбщие",       Ложь);
	СтруктураПараметров.Вставить("РучнаяНумерацияКолонокТабличногоДокументаДляШапки", Ложь);
	СтруктураПараметров.Вставить("ПерваяСтрокаДанныхШапки",                           0);
	СтруктураПараметров.Вставить("ТаблицаЗагружаемыхРеквизитовШапки",                 СтруктураТаблиц.ТаблицаЗагружаемыхРеквизитовШапки);
	
	ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ДополнитьВСтруктуруДопПараметрыАвтозагрузка(СтруктураПараметров, СтруктураТаблиц);
	
	ЗаполнитьНастройкиКолонок(Настройки, СтруктураПараметров,,СтруктураПараметровЛогирования);
	
	// Проверка наличия ошибок при заполнении настроек.
	Если СтруктураПараметровЛогирования.ЕстьОшибки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверка настройки загрузки.
	ОтборСтрок = Новый Структура("Пометка", Истина);
	СтрокиТаблицы = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(ОтборСтрок);
	Если СтрокиТаблицы.Количество() = 0 Тогда
		ДобавитьВЛог("В настройке загрузки <"+НастройкаЗагрузки+"> не отмечен ни один загружаемый реквизит", 1, СтруктураПараметровЛогирования);
		Возврат Ложь;
	КонецЕсли;
	
	Если СтруктураПараметров.ИспользоватьВнешнийМодульПреобразованияФайла И НЕ ЗначениеЗаполнено(СтруктураПараметров.ОбработкаПреобразования) Тогда 
		ДобавитьВЛог("В настройке загрузки указано, что файл преобразовывается в табличный документ внешней обработкой, но обработка не указана!", 1, СтруктураПараметровЛогирования);
		Возврат Ложь;
	КонецЕсли;
	
	// Добавим в общую структуру параметров данные, необходимые для выполнения проверок на клиенте.
	СтруктураПараметровОбщая.Вставить("ИспользоватьВнешнийМодульПреобразованияФайла", СтруктураПараметров.ИспользоватьВнешнийМодульПреобразованияФайла);
	СтруктураПараметровОбщая.Вставить("ОбработкаПреобразования",                      СтруктураПараметров.ОбработкаПреобразования);
	СтруктураПараметровОбщая.Вставить("ПерваяСтрокаДанныхТабличногоДокумента",        СтруктураПараметров.ПерваяСтрокаДанныхТабличногоДокумента);
	СтруктураПараметровОбщая.Вставить("Табуляция",                                    СтруктураПараметров.Табуляция);
	СтруктураПараметровОбщая.Вставить("Кодировка",                                    СтруктураПараметров.Кодировка);
	
	Возврат Истина;
	
КонецФункции


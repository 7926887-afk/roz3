
#Область ПрограммныйИнтерфейс

// Функция - Запросить токен авторизации из сервиса
//
// Параметры:
//  Логин	 - Строка - текущий логин
//  Пароль	 - Строка - текущий пароль
// 
// Возвращаемое значение:
//  Структура - структура возвращаемого значения
//
Функция ЗапроситьТокенАвторизацииИзСервиса(Логин, Пароль) Экспорт
	
	Возврат ор_ОбменСАптекаРУВызовСервера.ЗапроситьТокенАвторизацииИзСервиса(Логин, Пароль);
	
КонецФункции

// Процедура - Передать пакет заказов по действию
//
// Параметры:
//  МассивЗаказов	 - Массив - массив ссылок на заказы
//  Действие		 - Строка - выполянемое действие
//  Организация		 - СправочникСсылка.Организации - ссылка на организацию
//
Процедура ПередатьПакетЗаказовПоДействию(МассивЗаказов, Действие, Организация) Экспорт
	
	Результат = ор_ОбменСАптекаРУВызовСервера.ОбработатьЗаказИПередатьВАптекаРу(
		МассивЗаказов,
		Действие,
		Организация);
		
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обработать навигационную ссылку статуса заказа
//
// Параметры:
//  ЭтотОбъект								 - ФормаКлиентскогоПриложения - форма
//  НавигационнаяСсылкаФорматированнойСтроки - Строка - текущее действие
//
Процедура ОбработатьНавигационнуюСсылкуСтатусаЗаказа(ЭтотОбъект, НавигационнаяСсылкаФорматированнойСтроки) Экспорт
	
	ЗаказПокупателя = ЭтотОбъект.Объект.Ссылка;
	
	МассивПередачи = Новый Массив();
	МассивПередачи.Добавить(ЗаказПокупателя);
	
	Результат = ор_ОбменСАптекаРУВызовСервера.ОбработатьЗаказИПередатьВАптекаРу(МассивПередачи, НавигационнаяСсылкаФорматированнойСтроки, ЭтотОбъект.Объект.Организация);
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.СтатусОбменаАптекаРУ = Результат.ПредставлениеСтатуса;
	
	ЭлементФормы = ЭтотОбъект.Элементы.СообщениеСервисаАптекаРУ;
	Если ЗначениеЗаполнено(Результат.СообщениеСервисаДляЭлемента) Тогда
		ЭтотОбъект.СообщениеСервисаАптекаРУ = Результат.СообщениеСервисаДляЭлемента;
		ЭлементФормы.Видимость = Истина;
		ЭлементФормы.Подсказка = Результат.СообщениеСервисаДляЭлемента;
	Иначе
		ЭлементФормы.Видимость = Ложь;
	КонецЕсли;
	
	// Предопределяем ширину форматированного поля, чтобы избежать разрывов между полем и текстом ошибки при ее наличии.
	Если Результат.СтатусОбмена = ПредопределенноеЗначение("Перечисление.ор_СтатусыОбменаАптекаРУ.Принят") Тогда
		ЭтотОбъект.Элементы.СтатусОбменаАптекаРУ.Ширина = 19;
	ИначеЕсли Результат.СтатусОбмена = ПредопределенноеЗначение("Перечисление.ор_СтатусыОбменаАптекаРУ.ГотовКВыдаче") Тогда
		ЭтотОбъект.Элементы.СтатусОбменаАптекаРУ.Ширина = 40;
	Иначе
		ЭтотОбъект.Элементы.СтатусОбменаАптекаРУ.Ширина = 22;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - После пробития чека
//
// Параметры:
//  ЧекККМСсылка - ДокументСсылка.ЧекККМ - ссылка на ЧекККМ
//  СообщениеОбОшибке - Строка - сообщение об ошибке
//
Процедура ПослеПробитияЧека(ЧекККМСсылка, СообщениеОбОшибке) Экспорт
	
	Если ТипЗнч(ЧекККМСсылка) = Тип("ДокументСсылка.ЧекККМ") Тогда
	
		Результат = ор_ОбменСАптекаРУВызовСервера.ПослеПробитияЧека(ЧекККМСсылка);
		Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
			СообщениеОбОшибке = Результат.ТекстОшибки;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


Функция ВыполняемыеОперацииПроверкиКМ()
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("ПроверкаКМНаВнутреннемТСПИоТ", "ПроверкаКМНаВнутреннемТСПИоТ");
	ВозвращаемоеЗначение.Вставить("ПроверкаКМНаСервере"         , "ПроверкаКМНаСервере");
	ВозвращаемоеЗначение.Вставить("ПроверкаКМНаКлиенте"         , "ПроверкаКМНаКлиенте");
	ВозвращаемоеЗначение.Вставить("ПолучениеТокенаГИСМТ"        , "ПолучениеТокенаГИСМТ");
	ВозвращаемоеЗначение.Вставить("ОбновлениеCDNПлощадок"       , "ОбновлениеCDNПлощадок");
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ПерваяВыполняемаяОперацияПроверкиКМПоУмолчанию()
	
	ВыполняемыеОперации = ВыполняемыеОперацииПроверкиКМ();
	
	Возврат ВыполняемыеОперации.ПроверкаКМНаВнутреннемТСПИоТ;
	
КонецФункции

Функция ПодготовкитьПараметрыВыполненияПроверкиКМ(ПараметрыПроверкиКМ, ОповещениеОЗавершении)
	
	ПараметрыВыполненияПроверки = Новый Структура;
	
	// Параметры итерации
	ПараметрыВыполненияПроверки.Вставить("Интервал"       , 0.1);
	ПараметрыВыполненияПроверки.Вставить("ТекущаяОперация", ПерваяВыполняемаяОперацияПроверкиКМПоУмолчанию());
	
	// Целевые клиентские параметры
	ПараметрыВыполненияПроверки.Вставить("Форма"                     , Неопределено);
	ПараметрыВыполненияПроверки.Вставить("ОповещениеОЗавершении"     , Неопределено);
	
	// Локальные параметры
	ПараметрыВыполненияПроверки.Вставить("РезультатыПроверкиКМОбработаны", Ложь);
	
	ДополнительныеПараметрыПодготовки = Новый Структура("ПропуститьПолучениеИсходногоКодаМаркировки", Истина);
	
	РазрешительныйРежимМДЛПКлиентСервер.ПодготовитьПараметрыВыполненияПроверкиКМ(ПараметрыВыполненияПроверки, ПараметрыПроверкиКМ, ДополнительныеПараметрыПодготовки);
	
	ПараметрыВыполненияПроверки.ОповещениеОЗавершении = ОповещениеОЗавершении;
	
	Возврат ПараметрыВыполненияПроверки;
	
КонецФункции

Процедура СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки)
	
	ПараметрыПриложения["ТекущееЗаданиеПроверкиКМРазрешительныйРежим"] = ПараметрыВыполненияПроверки;
	
	// Запуск ВыполнитьШагПроверкиКМ.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьШагПроверкиКМРазрешительныйРежим", ПараметрыВыполненияПроверки.Интервал, Истина);
	
КонецПроцедуры

Процедура ВыполнитьШагПроверкиКМ() Экспорт
	
	ПараметрыВыполненияПроверки = ПараметрыПриложения["ТекущееЗаданиеПроверкиКМРазрешительныйРежим"];
	Если ПараметрыВыполненияПроверки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Если ПараметрыВыполненияПроверки.РезультатыПроверкиКМОбработаны // Крайний случай рекурентного выполнения
		 Или ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки // Критическая ошибка
		Тогда
			
			ПараметрыПриложения["ТекущееЗаданиеПроверкиКМРазрешительныйРежим"] = Неопределено; // Очистка параметров приложения обязательна.
			
			ВыполнитьОбработкуОповещения(ПараметрыВыполненияПроверки.ОповещениеОЗавершении, ПараметрыВыполненияПроверки.РезультатПроверки);
			Возврат;
			
		КонецЕсли;
		
		ВыполняемыеОперации = ВыполняемыеОперацииПроверкиКМ();
		Если ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ПроверкаКМНаВнутреннемТСПИоТ Тогда
			
			ВыполнитьПроверкуКМНаВнутреннемТСПИоТ(ПараметрыВыполненияПроверки);
			
		ИначеЕсли ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ПроверкаКМНаСервере Тогда
			
			ВыполнитьПроверкуКМНаСервере(ПараметрыВыполненияПроверки);
			
		ИначеЕсли ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ПроверкаКМНаКлиенте Тогда
			
			ВыполнитьПроверкуКМНаКлиенте(ПараметрыВыполненияПроверки);
			
		ИначеЕсли ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ПолучениеТокенаГИСМТ Тогда
			
			ВыполнитьПолучениеТокенаГИСМТ(ПараметрыВыполненияПроверки);
			
		ИначеЕсли ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ОбновлениеCDNПлощадок Тогда
			
			ВыполнитьОбновлениеCDNПлощадокГИСМТ(ПараметрыВыполненияПроверки);
			
		КонецЕсли;
		
	Исключение
		ПараметрыПриложения["ТекущееЗаданиеПроверкиКМРазрешительныйРежим"] = Неопределено; // Очистка параметров приложения обязательна.
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры


Процедура ВыполнитьПроверкуКМНаВнутреннемТСПИоТ(ПараметрыВыполненияПроверки)
	
	ВыполняемыеОперации = ВыполняемыеОперацииПроверкиКМ();
	
	Если Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаВнутреннемТСПИоТ Тогда
		ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ПроверкаКМНаСервере;
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	ПараметрыПроверкиКМНаТСПИоТ = ИнтеграцияТСПИоТМДЛПКлиентСервер.ПараметрыПроверкиКМНаТСПИоТ();
	ЗаполнитьЗначенияСвойств(ПараметрыПроверкиКМНаТСПИоТ, ПараметрыВыполненияПроверки);
	
	ВыполнитьПроверкуКМНаВнутреннемТСПИоТЗавершение = Новый ОписаниеОповещения(
		"ВыполнитьПроверкуКМНаВнутреннемТСПИоТЗавершение",
		ЭтотОбъект,
		ПараметрыВыполненияПроверки);
	
	ИнтеграцияТСПИоТМДЛПКлиент.НачатьПроверкуКМНаВнутреннемТСПИоТ(ПараметрыПроверкиКМНаТСПИоТ, ВыполнитьПроверкуКМНаВнутреннемТСПИоТЗавершение);
	
КонецПроцедуры

Процедура ВыполнитьПроверкуКМНаВнутреннемТСПИоТЗавершение(ТекущийРезультатПроверки, ПараметрыВыполненияПроверки) Экспорт
	
	Если РазрешительныйРежимМДЛПКлиентСервер.ДействуетАварийныйРежимДляРозничныхПродаж() Тогда
		СобытияФормРазрешительныйРежимМДЛПКлиент.ОповеститьОбИзмененииАварийногоРежима();
	КонецЕсли;
	
	// ТекущийРезультатПроверки нужно дополнить данными предыдущей актуальной проверки, в случае, если не все КМ коллекции проверяются повторно.
	// Повторная проверка может быть выполнена, если у части (или у всех) КМ результаты проверки стали неактуальными.
	ПредыдущиеДанныеПроверки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполненияПроверки.РезультатПроверки, "ДанныеПроверки");
	Если ЗначениеЗаполнено(ПредыдущиеДанныеПроверки) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(ТекущийРезультатПроверки.ДанныеПроверки, ПредыдущиеДанныеПроверки, Ложь);
	КонецЕсли;
	
	ПараметрыВыполненияПроверки.РезультатПроверки = ТекущийРезультатПроверки;
	
	ПараметрыВыполненияПроверки.РезультатыПроверкиКМОбработаны = Истина;
	СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
	
КонецПроцедуры


Процедура ВыполнитьПроверкуКМНаСервере(ПараметрыВыполненияПроверки)
	
	Если Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ
		И Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуОнлайн
		И Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаЛокальномМодуле Тогда
		ПараметрыВыполненияПроверки.РезультатыПроверкиКМОбработаны = Истина;
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	ПараметрыПроверкиКМНаСервере = РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаКлиентеНаСервере();
	ЗаполнитьЗначенияСвойств(ПараметрыПроверкиКМНаСервере, ПараметрыВыполненияПроверки);
	
	ВыполнитьПроверкуКМНаСервереЗавершение = Новый ОписаниеОповещения(
		"ВыполнитьПроверкуКМНаСервереЗавершение",
		ЭтотОбъект,
		ПараметрыВыполненияПроверки);
	
	ДлительнаяОперация = РазрешительныйРежимМДЛПВызовСервера.НачатьПроверкуКМНаСервере(ПараметрыПроверкиКМНаСервере);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ПараметрыВыполненияПроверки.Форма);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ВыполнитьПроверкуКМНаСервереЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

Процедура ВыполнитьПроверкуКМНаСервереЗавершение(Результат, ПараметрыВыполненияПроверки) Экспорт
	
	Если Результат.Статус = "Ошибка" Тогда
		// Критическая ошибка.
		ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки  = Истина;
		ПараметрыВыполненияПроверки.РезультатПроверки.ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	Если РазрешительныйРежимМДЛПКлиентСервер.ДействуетАварийныйРежимДляРозничныхПродаж() Тогда
		СобытияФормРазрешительныйРежимМДЛПКлиент.ОповеститьОбИзмененииАварийногоРежима();
	КонецЕсли;
	
	ТекущийРезультатПроверки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	// ТекущийРезультатПроверки нужно дополнить данными предыдущей актуальной проверки, в случае, если не все КМ коллекции проверяются повторно.
	// Повторная проверка может быть выполнена, если у части (или у всех) КМ результаты проверки стали неактуальными.
	ПредыдущиеДанныеПроверки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполненияПроверки.РезультатПроверки, "ДанныеПроверки");
	Если ЗначениеЗаполнено(ПредыдущиеДанныеПроверки) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(ТекущийРезультатПроверки.ДанныеПроверки, ПредыдущиеДанныеПроверки, Ложь);
	КонецЕсли;
	
	ПараметрыВыполненияПроверки.РезультатПроверки = ТекущийРезультатПроверки;
	
	ВыполняемыеОперации = ВыполняемыеОперацииПроверкиКМ();
	
	Если ПараметрыВыполненияПроверки.РезультатПроверки.ТребуетсяОбновлениеКлючаСессии Тогда
		ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ПолучениеТокенаГИСМТ;
		ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки  = Ложь;
		ПараметрыВыполненияПроверки.РезультатПроверки.ТекстОшибки = "";
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыВыполненияПроверки.РезультатПроверки.ОтсутствуютCDNПлощадки Тогда
		ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ОбновлениеCDNПлощадок;
		ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки  = Ложь;
		ПараметрыВыполненияПроверки.РезультатПроверки.ТекстОшибки = "";
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыВыполненияПроверки.РезультатПроверки.ТребуетсяПроверкаНаКлиенте Тогда
		ПараметрыВыполненияПроверки.ТекущаяОперация = ВыполняемыеОперации.ПроверкаКМНаКлиенте;
		ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки  = Ложь;
		ПараметрыВыполненияПроверки.РезультатПроверки.ТекстОшибки = "";
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки Тогда
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполненияПроверки.РезультатыПроверкиКМОбработаны = Истина;
	СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
	
КонецПроцедуры


Асинх Процедура ВыполнитьПроверкуКМНаКлиенте(ПараметрыВыполненияПроверки)
	
	Если Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ
		И Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаЛокальномМодуле Тогда
		ПараметрыВыполненияПроверки.РезультатыПроверкиКМОбработаны = Истина;
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ Тогда
		
		ПараметрыПроверкиКМНаКлиенте = ИнтеграцияТСПИоТМДЛПКлиентСервер.ПараметрыПроверкиКМНаТСПИоТ();
		ЗаполнитьЗначенияСвойств(ПараметрыПроверкиКМНаКлиенте, ПараметрыВыполненияПроверки);
		
		#Если ВебКлиент Тогда
			ТекущийРезультатПроверки = Ждать ИнтеграцияТСПИоТМДЛПВебКлиент.ПроверитьКМНаТСПИоТ(ПараметрыПроверкиКМНаКлиенте);
		#Иначе
			ТекущийРезультатПроверки = ИнтеграцияТСПИоТМДЛПКлиентСервер.ПроверитьКМНаТСПИоТ(ПараметрыПроверкиКМНаКлиенте);
		#КонецЕсли
		
		Если РазрешительныйРежимМДЛПКлиентСервер.ДействуетАварийныйРежимДляРозничныхПродаж() Тогда
			СобытияФормРазрешительныйРежимМДЛПКлиент.ОповеститьОбИзмененииАварийногоРежима();
		КонецЕсли;
		
	ИначеЕсли ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаЛокальномМодуле Тогда
		
		ПараметрыПроверкиКМНаКлиенте = РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаЛокальномМодуле();
		ЗаполнитьЗначенияСвойств(ПараметрыПроверкиКМНаКлиенте, ПараметрыВыполненияПроверки);
		
		#Если ВебКлиент Тогда
			ТекущийРезультатПроверки = Ждать РазрешительныйРежимМДЛПВебКлиент.ПроверитьКМНаЛокальномМодуле(ПараметрыПроверкиКМНаКлиенте);
		#Иначе
			ТекущийРезультатПроверки = РазрешительныйРежимМДЛПКлиентСервер.ПроверитьКМНаЛокальномМодуле(ПараметрыПроверкиКМНаКлиенте);
		#КонецЕсли
		
	КонецЕсли;
	
	// ТекущийРезультатПроверки нужно дополнить данными предыдущей актуальной проверки, в случае, если не все КМ коллекции проверяются повторно.
	// Повторная проверка может быть выполнена, если у части (или у всех) КМ результаты проверки стали неактуальными.
	ПредыдущиеДанныеПроверки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполненияПроверки.РезультатПроверки, "ДанныеПроверки");
	Если ЗначениеЗаполнено(ПредыдущиеДанныеПроверки) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(ТекущийРезультатПроверки.ДанныеПроверки, ПредыдущиеДанныеПроверки, Ложь);
	КонецЕсли;
	
	ПараметрыВыполненияПроверки.РезультатПроверки = ТекущийРезультатПроверки;
	
	ПараметрыВыполненияПроверки.РезультатыПроверкиКМОбработаны = Истина;
	СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
	
КонецПроцедуры


Процедура ВыполнитьПолучениеТокенаГИСМТ(ПараметрыВыполненияПроверки)
	
	ВыполнитьПолучениеТокенаГИСМТЗавершение = Новый ОписаниеОповещения(
		"ВыполнитьПолучениеТокенаГИСМТЗавершение",
		ЭтотОбъект,
		ПараметрыВыполненияПроверки);
	
	ЗапроситьКлючСессии(
		РазрешительныйРежимМДЛПКлиентСервер.ПараметрыЗапросаКлючаСессииГИСМТРозница(ПараметрыВыполненияПроверки.Организация),
		ВыполнитьПолучениеТокенаГИСМТЗавершение);
	
КонецПроцедуры

Процедура ВыполнитьПолучениеТокенаГИСМТЗавершение(Результат, ПараметрыВыполненияПроверки) Экспорт
	
	ОтказОтАвторизации = Ложь;
	ОшибкаАвторизации  = Ложь;
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		ОтказОтАвторизации = Истина;
	Иначе
		
		РезультатАвторизации = Результат[ПараметрыВыполненияПроверки.Организация];
		
		Если РезультатАвторизации = Неопределено Тогда
			ОшибкаАвторизации = Истина;
			ТекстОшибки = НСтр("ru = 'Произошла ошибка при авторизации в ГИС МТ.'");
		ИначеЕсли РезультатАвторизации <> Истина Тогда
			ОшибкаАвторизации = Истина;
			ТекстОшибки = СокрЛП(РезультатАвторизации);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОтказОтАвторизации Или ОшибкаАвторизации Тогда
		
		// Критическая ошибка.
		ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки  = Истина;
		ПараметрыВыполненияПроверки.РезультатПроверки.ТекстОшибки = ТекстОшибки;
		
	КонецЕсли;
	
	ПараметрыВыполненияПроверки.ТекущаяОперация = ПерваяВыполняемаяОперацияПроверкиКМПоУмолчанию();
	СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
	
КонецПроцедуры


Процедура ВыполнитьОбновлениеCDNПлощадокГИСМТ(ПараметрыВыполненияПроверки)
	
	ВыполнитьОбновлениеCDNПлощадокГИСМТЗавершение = Новый ОписаниеОповещения("ВыполнитьОбновлениеCDNПлощадокГИСМТЗавершение", ЭтотОбъект, ПараметрыВыполненияПроверки);
	
	ПараметрыЗапроса                         = ПараметрыЗапросаДанных();
	ПараметрыЗапроса.ОповещениеОЗавершении   = ВыполнитьОбновлениеCDNПлощадокГИСМТЗавершение;
	ПараметрыЗапроса.УникальныйИдентификатор = ПараметрыВыполненияПроверки.Форма.УникальныйИдентификатор;
	ПараметрыЗапроса.Организация             = ПараметрыВыполненияПроверки.Организация;
	ПараметрыЗапроса.Параметры               = Новый Структура("НеВыводитьОкноОжидания", Истина);
	
	АктуализацияСпискаCDNПлощадок(ПараметрыЗапроса);
	
КонецПроцедуры

Процедура ВыполнитьОбновлениеCDNПлощадокГИСМТЗавершение(Результат, ПараметрыВыполненияПроверки) Экспорт
	
	Если Результат = Неопределено Тогда
		
		// Критическая ошибка.
		ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки  = Истина;
		ПараметрыВыполненияПроверки.РезультатПроверки.ТекстОшибки = НСтр("ru = 'Не удалось обновить CDN-площадки.'");
		
	ИначеЕсли Результат.ЕстьОшибки И ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		
		// Критическая ошибка.
		ПараметрыВыполненияПроверки.РезультатПроверки.ЕстьОшибки  = Истина;
		ПараметрыВыполненияПроверки.РезультатПроверки.ТекстОшибки = Результат.ТекстОшибки;
		
	КонецЕсли;
	
	ПараметрыВыполненияПроверки.ТекущаяОперация = ПерваяВыполняемаяОперацияПроверкиКМПоУмолчанию();
	СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
	
КонецПроцедуры


Процедура ЗакончитьПроверкуКМ(ТекущийРезультатПроверки, ПараметрыПроверкиКМ) Экспорт
	
	РезультатПроверки = НовыйРезультатПроверкиКМ();
	
	Если ЗначениеЗаполнено(ТекущийРезультатПроверки) Тогда
		
		РезультатПроверки.ЕстьОшибки  = ТекущийРезультатПроверки.ЕстьОшибки;
		РезультатПроверки.ТекстОшибки = ТекущийРезультатПроверки.ТекстОшибки;
		
		Для Каждого ЭлементДанных Из ПараметрыПроверкиКМ.ДанныеДляПроверки Цикл
			
			РезультатЭлементаПроверки = НовыйРезультатЭлементаПроверкиКМ();
			ЗаполнитьЗначенияСвойств(РезультатЭлементаПроверки, ЭлементДанных);
			
			ТекущийРезультатЭлементаПроверки = ТекущийРезультатПроверки.ДанныеПроверки[ЭлементДанных.ИдентификаторЭлемента];
			Если ЗначениеЗаполнено(ТекущийРезультатЭлементаПроверки) Тогда
				РезультатЭлементаПроверки.РезультатПроверкиКМ = Новый ФиксированнаяСтруктура(ТекущийРезультатЭлементаПроверки);
			КонецЕсли;
			
			РезультатПроверки.ДанныеПроверки.Вставить(ЭлементДанных.ИдентификаторЭлемента, РезультатЭлементаПроверки);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыПроверкиКМ.ОповещениеОЗавершении, РезультатПроверки);
	
КонецПроцедуры

#КонецОбласти // ПроверкаКодаМаркировки

#Область Авторизация

// Возвращает структуру с результатом подписания.
//
// Параметры:
//  ПараметрыЗапроса     - (См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыЗапросаКлючаСессии).
//  Описание             - Строка - Описание.
//  ПараметрыАвторизации - (См. РазрешительныйРежимМДЛП.ПараметрыАвторизации).
//
// Возвращаемое значение:
//  Структура - Описание:
// * ПараметрыЗапроса     - (См. ПараметрыЗапросаДанных).
// * Описание             - Строка - Описание.
// * ПараметрыАвторизации - (См. РазрешительныйРежимМДЛП.ЗапроситьПараметрыАвторизации).
// * СвойстваПодписи      - Структура, Неопределено - Свойства подписи.
//
Функция РезультатПодписания(ПараметрыЗапроса, Описание, ПараметрыАвторизации)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПараметрыЗапроса"    , ПараметрыЗапроса);
	ВозвращаемоеЗначение.Вставить("Описание"            , Описание);
	ВозвращаемоеЗначение.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ВозвращаемоеЗначение.Вставить("СвойстваПодписи"     , Неопределено);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Процедура Подписать(Сообщения, ПараметрыЗапроса, ОповещениеПриЗавершении)
	
	КоличествоСообщений = Сообщения.Количество();
	Если КоличествоСообщений = 1 Тогда
		ЗаголовокДанных = НСтр("ru = 'Сообщение'");
	Иначе
		ЗаголовокДанных = НСтр("ru = 'Сообщения'");
	КонецЕсли;
	
	НаборДанныхДляПодписания = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		
		// Для авторизации требуется прикрепленная подпись
		ПараметрыCMS = ЭлектроннаяПодписьКлиент.ПараметрыCMS();
		ПараметрыCMS.Открепленная = Ложь;
		
		Данные = Новый Структура;
		Данные.Вставить("Данные",       Сообщение.ПараметрыАвторизации.Данные);
		Данные.Вставить("Сообщение",    Сообщение);
		Данные.Вставить("ПараметрыCMS", ПараметрыCMS);
		
		ПодписатьПоказатьТекстСообщенияXML = Новый ОписаниеОповещения("ПодписатьПоказатьТекстСообщенияXML", ЭтотОбъект, Сообщение);
		
		ПредставлениеДанных = Новый Структура;
		ПредставлениеДанных.Вставить("Значение",      ПодписатьПоказатьТекстСообщенияXML);
		ПредставлениеДанных.Вставить("Представление", Сообщение.Описание);
		
		СтруктураДанные = Новый Структура;
		СтруктураДанные.Вставить("Данные",        Данные);
		СтруктураДанные.Вставить("Представление", ПредставлениеДанных);
		
		НаборДанныхДляПодписания.Добавить(СтруктураДанные);
		
	КонецЦикла;
	
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("Операция",            НСтр("ru = 'Обмен с ГИС МТ'"));
	ОписаниеДанных.Вставить("ЗаголовокДанных",     ЗаголовокДанных);
	ОписаниеДанных.Вставить("СообщитьОЗавершении", Ложь);
	ОписаниеДанных.Вставить("ПоказатьКомментарий", Ложь);
	
	ОписаниеДанных.Вставить("БезПодтверждения",    Истина);
	ОписаниеДанных.Вставить("ВыполнятьНаСервере",  Неопределено);
	ОписаниеДанных.Вставить("НаборДанных",         НаборДанныхДляПодписания);
	ОписаниеДанных.Вставить("ПредставлениеНабора", СтрШаблон(НСтр("ru = 'Показать (%1)'"), КоличествоСообщений));
	
	ДанныеДляОповещения = Новый Структура;
	ДанныеДляОповещения.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
	ДанныеДляОповещения.Вставить("Сообщения",               Сообщения);
	
	ПодписатьЗавершение = Новый ОписаниеОповещения("ПодписатьЗавершение", ЭтотОбъект, ДанныеДляОповещения);
	ЭлектроннаяПодписьКлиент.Подписать(ОписаниеДанных, ЭтотОбъект, ПодписатьЗавершение);
	
КонецПроцедуры

Процедура ПослеПодписания(ПараметрыЗапросовПоОрганизациям, ДополнительныеПараметры) Экспорт
	
	Если ПараметрыЗапросовПоОрганизациям = Неопределено Тогда
		
		Результат = Новый Соответствие();
		Результат.Вставить(ДополнительныеПараметры.ПараметрыЗапроса.Организация, Неопределено);
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеПриЗавершении, Результат);
		
	Иначе
		
		Результат = РазрешительныйРежимМДЛПВызовСервера.ЗапроситьКлючиСессий(ПараметрыЗапросовПоОрганизациям);
		
		Если ДополнительныеПараметры.ОповещениеПриЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеПриЗавершении, Результат);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодписатьПоказатьТекстСообщенияXML(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("ПараметрыАвторизации") Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.ДобавитьСтроку(ДополнительныеПараметры.ПараметрыАвторизации.Данные);
		ТекстовыйДокумент.Показать(ДополнительныеПараметры.Описание);
	ИначеЕсли ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("ПредставлениеСообщенияДляРасшифровки") Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.ДобавитьСтроку(ДополнительныеПараметры.ПредставлениеСообщенияДляРасшифровки);
		ТекстовыйДокумент.Показать(ДополнительныеПараметры.Описание);
	ИначеЕсли ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("ТекстСообщенияJSON") Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.ДобавитьСтроку(ДополнительныеПараметры.ТекстСообщенияJSON);
		ТекстовыйДокумент.Показать(ДополнительныеПараметры.Описание);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодписатьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено
		И Результат.Успех Тогда
		
		Сообщения = Новый Массив;
		
		Для Каждого ТекущийЭлементНабораДанных Из Результат.НаборДанных Цикл
			
			СвойстваПодписи = ТекущийЭлементНабораДанных.СвойстваПодписи;
			
			Сообщение = ТекущийЭлементНабораДанных.Данные.Сообщение;
			Сообщение.Вставить("СвойстваПодписи", СвойстваПодписи);
			Сообщение.Вставить("Сертификат"     , Результат.ВыбранныйСертификат.Ссылка);
			
			Сообщения.Добавить(Сообщение);
			
		КонецЦикла;
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеПриЗавершении, Сообщения);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеПриЗавершении, Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // Авторизация

#КонецОбласти // СлужебныеПроцедурыИФункции

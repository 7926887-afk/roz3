#Область Авторизация

// Выполняет операцию получения розничного токена в ГИС МТ.
//
// Параметры:
//  ПараметрыЗапроса - см. ПараметрыЗапросаДанных.
//
Процедура АвторизацияГИСМТРозничныйТокен(ПараметрыЗапроса) Экспорт
	
	ПараметрыОбработки                                  = РазрешительныйРежимМаршрутизаторМДЛПСлужебныйКлиент.ПараметрыОбработкиЗапросаДанных(ПараметрыЗапроса);
	ДоступныеМетодыИнтерфейса                           = РазрешительныйРежимМДЛПКлиентСервер.ДоступныеМетодыИнтерфейса();
	ПараметрыОбработки.ИмяОбработчика                   = ДоступныеМетодыИнтерфейса.ПолучениеРозничногоТокена;
	ПараметрыОбработки.ПроверкаПоТокенуРозничнойПродажи = Истина;
	ПараметрыОбработки.ОрганизацияПоСертификатам        = Не ЗначениеЗаполнено(ПараметрыЗапроса.Организация);
	
	РазрешительныйРежимМаршрутизаторМДЛПСлужебныйКлиент.ОбработкаМетодаИнтерфейсаСАвторизацией(ПараметрыЗапроса, ПараметрыОбработки);
	
КонецПроцедуры

// Запросить новый ключ сессии для авторизации в ГИС МТ.
//
// Параметры:
//  ПараметрыЗапроса        - (См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыЗапросаКлючаСессии).
//  ОповещениеПриЗавершении - ОписаниеОповещения - Описание оповещения после получения результата. 
//
Процедура ЗапроситьКлючСессии(ПараметрыЗапроса, ОповещениеПриЗавершении = Неопределено) Экспорт
	
	РезультатЗапроса = РазрешительныйРежимМДЛПВызовСервера.ЗапроситьПараметрыАвторизации(ПараметрыЗапроса);
	
	ПараметрыАвторизации = РезультатЗапроса.ПараметрыАвторизации;
	
	Если ПараметрыАвторизации = Неопределено Тогда
		Если ОповещениеПриЗавершении <> Неопределено Тогда
			ВозвращаемоеЗначение = Новый Соответствие;
			ВозвращаемоеЗначение.Вставить(ПараметрыЗапроса.Организация, РезультатЗапроса.ТекстОшибки);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, ВозвращаемоеЗначение);
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатЗапроса.ТекстОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Авторизация в %1 для %2'"),
		ПараметрыЗапроса.ПредставлениеСервиса,
		ПараметрыЗапроса.Организация);
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(РезультатПодписания(ПараметрыЗапроса, Описание, ПараметрыАвторизации));
	
	Контекст = Новый Структура;
	Контекст.Вставить("ПараметрыЗапроса",        ПараметрыЗапроса);
	Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
	
	ПослеПодписания = Новый ОписаниеОповещения("ПослеПодписания", ЭтотОбъект, Контекст);
	
	Подписать(Сообщения, ПараметрыЗапроса, ПослеПодписания);
	
КонецПроцедуры

#КонецОбласти // Авторизация

#КонецОбласти // МетодыИнтерфейсаРазрешительногоРежима

#Область ФиксацияПродажиВЛМЧЗ

// Параметры пробития чека для фиксации продажи в ЛМ ЧЗ.
//
// Возвращаемое значение:
//  Структура - Параметры пробития чека:
// * ККТ - Неопределено - ККТ, через которую осуществляется пробитие
// * Операция - Строка - см. ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ОперацииПриРаботеСКодамиМаркировки()
// * ДанныеКИ - Массив из см. ДанныеКодовИдентификации
//
Функция ПараметрыПробитияЧека() Экспорт
	
	СтруктураВозврата = Новый Структура;
	
	СтруктураВозврата.Вставить("ККТ",      Неопределено);
	СтруктураВозврата.Вставить("Операция", "");
	СтруктураВозврата.Вставить("ДанныеКИ", Новый Массив);
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Структура описания кодов идентификации для фиксации продажи в ЛМ ЧЗ.
//
// Возвращаемое значение:
//  Структура - Данные кодов идентификации:
// * КодИдентификации             - Строка - нормализованный код идентификации
// * ДробноеКоличествоЧислитель   - Число - числитель
// * ДробноеКоличествоЗнаменатель - Число - знаменатель
// * Количество                   - Число - количество выбытия
//
Функция ДанныеКодовИдентификации() Экспорт
	
	СтруктураВозврата = Новый Структура();
	
	СтруктураВозврата.Вставить("КодИдентификации",             "");
	СтруктураВозврата.Вставить("ДробноеКоличествоЧислитель",   0);
	СтруктураВозврата.Вставить("ДробноеКоличествоЗнаменатель", 0);
	СтруктураВозврата.Вставить("Количество",                   0);
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Зафиксировать факт продажи/возврата марок из списка в локальной базе Локального модуля Честный знак.
//
Процедура ЗафиксироватьФактПродажиВозвратаКодовМаркировки(ПараметрыПробитияЧека) Экспорт
	
	ДанныеУстановленныхЛокальныхМодулей = РазрешительныйРежимМДЛПВызовСервера.НастройкиОсновногоПодключенияЛокальномуМодулюЧестныйЗнакПоККТ(ПараметрыПробитияЧека.ККТ);
	
	Если Не ДанныеУстановленныхЛокальныхМодулей.НастроеноПодключение Тогда
		// Если локальных модулей не установлено, то не фиксировать продажу/возврат.
		Возврат;
	КонецЕсли;
	
	МассивКИ = Новый Массив;
	
	Для Каждого СтрокаДанныхКИ Из ПараметрыПробитияЧека.ДанныеКИ Цикл
		
		Если ЗначениеЗаполнено(СтрокаДанныхКИ.ДробноеКоличествоЧислитель)
			Или ЗначениеЗаполнено(СтрокаДанныхКИ.ДробноеКоличествоЗнаменатель)
			Или Не СтрокаДанныхКИ.Количество = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		МассивКИ.Добавить(СтрокаДанныхКИ.КодИдентификации);
		
	КонецЦикла;
	
	Если Не ДанныеУстановленныхЛокальныхМодулей.Настройки.ОбменНаСервере Тогда
		РазрешительныйРежимМДЛПКлиентСервер.ЗафиксироватьФактПродажиВозвратаКодовМаркировки(МассивКИ, ПараметрыПробитияЧека.Операция, ДанныеУстановленныхЛокальныхМодулей.Настройки);
	Иначе
		РазрешительныйРежимМДЛПВызовСервера.ЗафиксироватьФактПродажиВозвратаКодовМаркировки(МассивКИ, ПараметрыПробитияЧека.Операция, ДанныеУстановленныхЛокальныхМодулей.Настройки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ФиксацияПродажиВЛМЧЗ

#КонецОбласти // ПрограммныйИнтерфейс


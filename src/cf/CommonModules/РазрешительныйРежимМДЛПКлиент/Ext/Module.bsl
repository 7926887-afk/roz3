
#Область ПрограммныйИнтерфейс

#Область ПроверкаКодаМаркировки

// Возвращает параметры, необходимые для выполнения проверки КМ на форме объекта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма объекта, к которому подключен механизма проверки КМ.
//
// Возвращаемое значение:
//  ВозвращаемоеЗначение - Структура - параметры, необходимые для выполнения проверки КМ на форме объекта.
//   См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаКлиентеНаСервере(), а также:
//   Форма                      - ФормаКлиентскогоПриложения - форма объекта, к которому подключен механизма проверки КМ.
//   ОповещениеОЗавершении      - ОписаниеОповещения - обработчик, в который будет возвращен результат проверки КМ.
//
Функция ПараметрыПроверкиКМ(Форма) Экспорт
	
	ВозвращаемоеЗначение = РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаКлиентеНаСервере();
	
	ВозвращаемоеЗначение.Вставить("Форма"                , Форма);
	ВозвращаемоеЗначение.Вставить("ОповещениеОЗавершении", Неопределено);
	
	Если ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") Тогда
		ВозвращаемоеЗначение.УникальныйИдентификатор = Форма.УникальныйИдентификатор;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает структуру элемента проверки КМ.
//
// Возвращаемое значение:
//  ВозвращаемоеЗначение - Структура - описание элемента проверки КМ.
//   См. РазрешительныйРежимМДЛПКлиентСервер.НовыйЭлементДанныхДляПроверкиНаКлиентеНаСервере(), а также:
//
Функция НовыйЭлементДанныхДляПроверки() Экспорт
	
	Возврат РазрешительныйРежимМДЛПКлиентСервер.НовыйЭлементДанныхДляПроверкиНаКлиентеНаСервере();
	
КонецФункции

// Запускает выполнение проверки КМ.
// Результат будет возвращен в процедуру, указанную в параметре ПараметрыПроверкиКМ.ОповещениеОЗавершении.
// Результат выполнения процедуры см. НовыйРезультатПроверкиКМ().
//
// Параметры:
//  Параметры - Структура - см. ПараметрыПроверкиКМ.
//
Процедура НачатьПроверкуКМ(ПараметрыПроверкиКМ) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	РазрешительныйРежимМДЛПКлиентПереопределяемый.НачатьПроверкуКМ(ПараметрыПроверкиКМ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		Если Не ЗначениеЗаполнено(ПараметрыПроверкиКМ.ДанныеДляПроверки) Тогда
			ВыполнитьОбработкуОповещения(ПараметрыПроверкиКМ.ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗакончитьПроверкуКМ", ЭтотОбъект, ПараметрыПроверкиКМ);
		
		ПараметрыВыполненияПроверки = ПодготовкитьПараметрыВыполненияПроверкиКМ(ПараметрыПроверкиКМ, ОповещениеОЗавершении);
		
		СледующийШагПроверкиКМ(ПараметрыВыполненияПроверки);
		
	КонецЕсли;
	
КонецПроцедуры


// Возвращает описание результата проверки КМ.
//
// Возвращаемое значение:
//  ЕстьОшибки     - Булево - признак наличия критических ошибок выполнения проверки КМ.
//  ТекстОшибки    - Строка - текст критических ошибок выполнения проверки КМ.
//  ДанныеПроверки - Соответствие - коллекция результатов проверки кодов маркировки.
//   * Ключ - ИдентификаторЭлемента из коллекции ДанныеДляПроверки параметров проверки КМ
//            (см. функции ПараметрыПроверкиКМ и НовыйЭлементДанныхДляПроверки).
//   * Значение - Структура - результат проверки конкретного кода маркировки (см. функцию НовыйРезультатЭлементаПроверкиКМ).
//
Функция НовыйРезультатПроверкиКМ()
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки"    , Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки"   , "");
	ВозвращаемоеЗначение.Вставить("ДанныеПроверки", Новый Соответствие);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает описание результата проверки конкретного кода маркировки.
//
// Возвращаемое значение:
//  ПолныйКодМаркировки - Строка - полный код маркировки в формате Base64.
//  КонтрольВыполнен    - Булево - признак того, что по КМ был выполнен контроль.
//  КонтрольПройден     - Булево - признак того, что КМ прошел проверку.
//  РезультатПроверкиКМ - ФиксированнаяСтруктура - результат проверки конкретного кода маркировки
//                                            (см. РазрешительныйРежимМДЛПКлиентСервер.НовыйРезультатЭлементаПроверкиКМНаКлиентеНаСервере()).
//
Функция НовыйРезультатЭлементаПроверкиКМ()
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("ПолныйКодМаркировки", "");
	ВозвращаемоеЗначение.Вставить("РезультатПроверкиКМ", Неопределено);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти // ПроверкаКодаМаркировки

#Область МетодыИнтерфейсаРазрешительногоРежима

// Параметры запроса данных методов интерфейса разрешительного режима.
//
// Возвращаемое значение:
//  Структура - Параметры запроса данных:
//   * Параметры               - Неопределено, Структура - Параметры запроса.
//   * Организация             - Неопределено, СправочникСсылка.Организации - Организация.
//   * ОповещениеОЗавершении   - Неопределено, ОписаниеОповещения - Точка возврата после выполенения метода.
//   * УникальныйИдентификатор - Неопределено, УникальныйИдентификатор - уникальный идентификатор формы.
//   * ВыполнениеНаКлиенте     - Булево - Истина, если выполняется запуск процедуры на клиенте.
//
Функция ПараметрыЗапросаДанных() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура();
	ВозвращаемоеЗначение.Вставить("Параметры",               Неопределено);
	ВозвращаемоеЗначение.Вставить("Организация",             Неопределено);
	ВозвращаемоеЗначение.Вставить("ОповещениеОЗавершении",   Неопределено);
	ВозвращаемоеЗначение.Вставить("УникальныйИдентификатор", Неопределено);
	ВозвращаемоеЗначение.Вставить("ВыполнениеНаКлиенте",     Ложь);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#Область CDNПлощадки

// Обновляет список CDN-площадок и время их отклика.
// Результат выполнения операции будет передан в ОписаниеОповещения в переданном параметре.
//
// Параметры:
//  ПараметрыЗапроса - см. ПараметрыЗапросаДанных.
//
Процедура АктуализацияСпискаCDNПлощадок(ПараметрыЗапроса) Экспорт
	
	ПараметрыОбработки                                  = РазрешительныйРежимМаршрутизаторМДЛПСлужебныйКлиент.ПараметрыОбработкиЗапросаДанных(ПараметрыЗапроса);
	ДоступныеМетодыИнтерфейса                           = РазрешительныйРежимМДЛПКлиентСервер.ДоступныеМетодыИнтерфейса();
	ПараметрыОбработки.ИмяОбработчика                   = ДоступныеМетодыИнтерфейса.АктуализацияCDNПлощадок;
	ПараметрыОбработки.ПроверкаПоТокенуРозничнойПродажи = Истина;
	ПараметрыОбработки.УникальныйИдентификатор          = ПараметрыЗапроса.УникальныйИдентификатор;
	ПараметрыОбработки.ВыполнениеВФоне                  = Истина;
	
	РазрешительныйРежимМаршрутизаторМДЛПСлужебныйКлиент.ОбработкаМетодаИнтерфейсаСАвторизацией(ПараметрыЗапроса, ПараметрыОбработки);
	
КонецПроцедуры

#КонецОбласти // CDNПлощадки


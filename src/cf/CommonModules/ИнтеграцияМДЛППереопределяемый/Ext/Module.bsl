// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОФактеУничтожения(ДокументОснование) Экспорт
	
КонецФункции

// Рассчитывает статус оформления документа учетной системы.
// См. ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - Основание уведомления.
//
Процедура РассчитатьСтатусОформленияУведомленияОВыбытии(ДокументОснование) Экспорт
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ор_ИзготовлениеЛекарственныхФорм") Тогда
		
		ЗапрашиваемыеРеквизиты = Новый Структура;
		ЗапрашиваемыеРеквизиты.Вставить("Проведен");
		ЗапрашиваемыеРеквизиты.Вставить("Дата");
		ЗапрашиваемыеРеквизиты.Вставить("Номер");
		ЗапрашиваемыеРеквизиты.Вставить("Ответственный");
		ЗапрашиваемыеРеквизиты.Вставить("МестоДеятельности", "СтруктурнаяЕдиница");
		ЗапрашиваемыеРеквизиты.Вставить("Организация");
		ЗапрашиваемыеРеквизиты.Вставить("ор_ЕстьМаркируемаяПродукция");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗапрашиваемыеРеквизиты);
		
		ИнтеграцияМДЛП.РассчитатьСтатусОформления(
			Метаданные.Документы.УведомлениеОВыбытииМДЛП,
			ДокументОснование,
			ЗначенияРеквизитов,
			ЗначенияРеквизитов.ор_ЕстьМаркируемаяПродукция);
		
	Иначе
		
		ЗапрашиваемыеРеквизиты = Новый Структура;
		ЗапрашиваемыеРеквизиты.Вставить("Проведен");
		ЗапрашиваемыеРеквизиты.Вставить("Дата");
		ЗапрашиваемыеРеквизиты.Вставить("Номер");
		ЗапрашиваемыеРеквизиты.Вставить("Ответственный", "Автор");
		ЗапрашиваемыеРеквизиты.Вставить("МестоДеятельности", "СтруктурнаяЕдиница");
		ЗапрашиваемыеРеквизиты.Вставить("Организация");
		ЗапрашиваемыеРеквизиты.Вставить("ор_ЕстьМаркируемаяПродукция");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗапрашиваемыеРеквизиты);
		
		ИнтеграцияМДЛП.РассчитатьСтатусОформления(
			Метаданные.Документы.УведомлениеОВыбытииМДЛП,
			ДокументОснование,
			ЗначенияРеквизитов,
			ЗначенияРеквизитов.ор_ЕстьМаркируемаяПродукция);
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОВыбытии(ДокументОснование) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТаблицаДокументы.Ссылка  КАК Ссылка
	|ПОМЕСТИТЬ ОформленныеДокументы
	|ИЗ
	|	Документ.УведомлениеОВыбытииМДЛП КАК ТаблицаДокументы
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|	ПО
	|		Статусы.Документ = ТаблицаДокументы.Ссылка
	|ГДЕ
	|	ТаблицаДокументы.Основание = &ДокументОснование
	|	И НЕ ТаблицаДокументы.ПометкаУдаления
	|	И НЕ (ТаблицаДокументы.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|		И Статусы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	1                        КАК План,
	|	0                        КАК Факт
	|ПОМЕСТИТЬ ТоварыКОформлению
	|ИЗ
	|	#ДокументТовары КАК ТаблицаТовары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		#ДокументНомераУпаковок КАК ТаблицаУпаковок
	|	ПО
	|		ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка
	|		И ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0";
	
	Если ДокументОснование.Метаданные().ПолноеИмя() = "Документ.СписаниеТоваров" Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТаблицаТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки,
		|	1                           КАК План,
		|	0                           КАК Факт
		|ИЗ
		|	#ДокументТранспортныеУпаковки КАК ТаблицаТранспортныеУпаковки
		|ГДЕ
		|	ТаблицаТранспортныеУпаковки.Ссылка = &ДокументОснование";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеУпаковки.НомерКИЗ,
	|	0,
	|	1
	|ИЗ
	|	Документ.УведомлениеОВыбытииМДЛП.НомераУпаковок КАК ОформленныеУпаковки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.УведомлениеОВыбытииМДЛП.Товары КАК ОформленныеТовары
	|	ПО
	|		ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка
	|		И ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ОформленныеДокументы КАК ОформленныеДокументы
	|	ПО
	|		ОформленныеДокументы.Ссылка = ОформленныеУпаковки.Ссылка
	|ГДЕ
	|	НЕ ОформленныеУпаковки.Отклонено
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеТранспортныеУпаковки.НомерУпаковки,
	|	0,
	|	1
	|ИЗ
	|	Документ.УведомлениеОВыбытииМДЛП.ТранспортныеУпаковки КАК ОформленныеТранспортныеУпаковки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ОформленныеДокументы КАК ОформленныеДокументы
	|	ПО
	|		ОформленныеДокументы.Ссылка = ОформленныеТранспортныеУпаковки.Ссылка
	|ГДЕ
	|	НЕ ОформленныеТранспортныеУпаковки.Отклонено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки,
	|	СУММА(ТоварыКОформлению.План)   КАК План,
	|	СУММА(ТоварыКОформлению.Факт)   КАК Факт
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТоварыКОформлению КАК ТоварыКОформлению
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОформлению.НомерУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.Факт > 0 И Т.План > 0)                КАК ЕстьОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.Факт >= 0 И Т.План > Т.Факт)          КАК ЕстьНеОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.План = Т.Факт)                        КАК ЕстьПолностьюОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.План < Т.Факт)                        КАК ЕстьОшибкиОформления
	|";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТовары"              , ДокументОснование.Метаданные().ПолноеИмя() + ".Запасы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументНомераУпаковок"      , ДокументОснование.Метаданные().ПолноеИмя() + ".ор_НомераУпаковок");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТранспортныеУпаковки", ДокументОснование.Метаданные().ПолноеИмя() + ".ор_ТранспортныеУпаковки");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Возврат Запрос;
	
КонецФункции

// Рассчитывает статус оформления документа учетной системы.
// См. ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - Основание уведомления.
//
Процедура РассчитатьСтатусОформленияУведомленияОПовторномВводеВОборот(ДокументОснование) Экспорт
	
	ЗапрашиваемыеРеквизиты = Новый Структура;
	ЗапрашиваемыеРеквизиты.Вставить("Проведен");
	ЗапрашиваемыеРеквизиты.Вставить("Дата");
	ЗапрашиваемыеРеквизиты.Вставить("Номер");
	ЗапрашиваемыеРеквизиты.Вставить("Ответственный", "Автор");
	ЗапрашиваемыеРеквизиты.Вставить("МестоДеятельности", "СтруктурнаяЕдиница");
	ЗапрашиваемыеРеквизиты.Вставить("Организация");
	ЗапрашиваемыеРеквизиты.Вставить("ор_ЕстьМаркируемаяПродукция");
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗапрашиваемыеРеквизиты);
	
	ИнтеграцияМДЛП.РассчитатьСтатусОформления(
		Метаданные.Документы.УведомлениеОПовторномВводеВОборотМДЛП,
		ДокументОснование,
		ЗначенияРеквизитов,
		ЗначенияРеквизитов.ор_ЕстьМаркируемаяПродукция);
	
КонецПроцедуры

// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОПовторномВводеВОборот(ДокументОснование) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТаблицаДокументы.Ссылка  КАК Ссылка
	|ПОМЕСТИТЬ ОформленныеДокументы
	|ИЗ
	|	Документ.УведомлениеОПовторномВводеВОборотМДЛП КАК ТаблицаДокументы
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|	ПО
	|		Статусы.Документ = ТаблицаДокументы.Ссылка
	|ГДЕ
	|	ТаблицаДокументы.Основание = &ДокументОснование
	|	И НЕ ТаблицаДокументы.ПометкаУдаления
	|	И НЕ (ТаблицаДокументы.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|		И Статусы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	1                        КАК План,
	|	0                        КАК Факт
	|ПОМЕСТИТЬ ТоварыКОформлению
	|ИЗ
	|	#ДокументТовары КАК ТаблицаТовары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		#ДокументНомераУпаковок КАК ТаблицаУпаковок
	|	ПО
	|		ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка
	|		И ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеУпаковки.НомерКИЗ,
	|	0,
	|	1
	|ИЗ
	|	Документ.УведомлениеОПовторномВводеВОборотМДЛП.НомераУпаковок КАК ОформленныеУпаковки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.УведомлениеОПовторномВводеВОборотМДЛП.Товары КАК ОформленныеТовары
	|	ПО
	|		ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка
	|		И ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ОформленныеДокументы КАК ОформленныеДокументы
	|	ПО
	|		ОформленныеДокументы.Ссылка = ОформленныеТовары.Ссылка
	|ГДЕ
	|	НЕ ОформленныеУпаковки.Отклонено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки,
	|	СУММА(ТоварыКОформлению.План)   КАК План,
	|	СУММА(ТоварыКОформлению.Факт)   КАК Факт
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТоварыКОформлению КАК ТоварыКОформлению
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОформлению.НомерУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.Факт > 0 И Т.План > 0)                КАК ЕстьОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.Факт >= 0 И Т.План > Т.Факт)          КАК ЕстьНеОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.План = Т.Факт)                        КАК ЕстьПолностьюОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.План < Т.Факт)                        КАК ЕстьОшибкиОформления
	|";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТовары", ДокументОснование.Метаданные().ПолноеИмя() + ".Запасы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументНомераУпаковок", ДокументОснование.Метаданные().ПолноеИмя() + ".ор_НомераУпаковок");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Возврат Запрос;
	
КонецФункции


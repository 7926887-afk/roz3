// Выполняет действия при изменении GTIN, номера серии, годен до.
//
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормы - Документ, в которой произошло событие,
//  ТекущаяСтрока - СтрокаТабличнойЧасти - строка таблицы товаров,
//  ПараметрыЗаполнения - Структура - см. функцию ИнтеграцияМДЛПКлиентСервер.ПараметрыЗаполненияТабличнойЧасти.
//
Процедура ПриИзмененииПараметровНоменклатуры(Объект, ТекущаяСтрока, ПараметрыЗаполнения) Экспорт
	
	// +ор интеграция МДЛП
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Ссылка")
		И ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ИнвентаризацияПотребительскихУпаковокМДЛП") Тогда
		ор_ИнтеграцияМДЛП.ЗаполнитьНоменклатуруХарактеристикуПоGTIN(Объект, ТекущаяСтрока);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущаяСтрока, "Упаковка")
			И Не ЗначениеЗаполнено(ТекущаяСтрока.Упаковка) Тогда
			ор_ИнтеграцияМДЛПКлиентСервер.ЗаполнитьСлужебныеРеквизитыНоменклатуры(ТекущаяСтрока);
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			ТекущаяСтрока.Номенклатура = ор_ИнтеграцияМДЛП.НайтиНоменклатруПоGTIN(ТекущаяСтрока.GTIN);
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущаяСтрока, "Упаковка")
				И Не ЗначениеЗаполнено(ТекущаяСтрока.Упаковка) Тогда
				ор_ИнтеграцияМДЛПКлиентСервер.ЗаполнитьСлужебныеРеквизитыНоменклатуры(ТекущаяСтрока);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	// -ор интеграция МДЛП
	
КонецПроцедуры


КонецПроцедуры

// Получить количество возможных документов-оснований для сопоставления с документом-уведомлением.
//
// Параметры:
//  Объект - ДокументОбъект.Уведомление - документ для которого подбираются документ-основание.
// 
// Возвращаемое значение:
//  Число - количество документов.
//
Функция ПолучитьКоличествоВозможныхОснованийДляУведомления(Объект) Экспорт
	
	// +ор интеграция МДЛП
	ПолучитьКоличествоВозможных = Ложь;
	
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.УведомлениеОПриемкеМДЛП") Тогда
		ПолучитьКоличествоВозможных = Истина;
	КонецЕсли;
	
	Если НЕ ПолучитьКоличествоВозможных Тогда
		Возврат 0;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НомерДокумента"                  , Объект.НомерДокумента);
	СтруктураПараметров.Вставить("ДатаДокумента"                   , Объект.ДатаДокумента);
	СтруктураПараметров.Вставить("Операция"                        , Объект.Операция);
	СтруктураПараметров.Вставить("ОрганизацияМДЛП"                 , Объект.Организация);
	СтруктураПараметров.Вставить("МестоДеятельностиОрганизацииМДЛП", Объект.МестоДеятельности);
	СтруктураПараметров.Вставить("КонтрагентМДЛП"                  , Объект.Грузоотправитель);
	СтруктураПараметров.Вставить("МестоДеятельностиКонтрагентаМДЛП", Объект.МестоДеятельностиГрузоотправителя);
	СтруктураПараметров.Вставить("ТипДоговора"                     , Объект.ТипДоговора);
	СтруктураПараметров.Вставить("ТипОперации"                     , Объект.ТипОперации);
	
	СписокУведомлений = ор_ИнтеграцияМДЛП.ПолучитьТаблицуВыбораОснований(СтруктураПараметров);
	
	Если СписокУведомлений = Неопределено Тогда
		Возврат 0;
	Иначе
		Возврат СписокУведомлений.Количество();
	КонецЕсли;
	// -ор интеграция МДЛП
	
	КоличествоДокументов = 0;
	
	Возврат КоличествоДокументов;
	
КонецФункции

// Нужно реализовать проверку наличия расхождений между Уведомлением и Основанием.
//
// Параметры:
//  Уведомление - ДокументСсылка.Уведомление - проверяемое уведомление,
//  Основание - ДокументСсылка - проверяемое основание уведомления.
//
// Возвращаемое значение:
//  Булево - Истина, если есть расхождения, иначе - Ложь.
//
Функция ЕстьРасхожденияМеждуУведомлениемИОснованием(Уведомление, Основание) Экспорт
	
	Возврат Ложь;
	
КонецФункции

// Нужно заполнить список возможных уведомлений для связи с основанием.
//
// Параметры:
//  МетаданныеУведомления - ОбъектМетаданных - метаданные уведомления, возможные значения которого надо получить;
//  Основание - Ссылка - основание уведомления, для которого подбираются уведомления.
//
// Возвращаемое значение:
//  Массив - список подходящих уведомлений.
//
Функция ВозможныеУведомленияПоОснованию(МетаданныеУведомления, Основание) Экспорт
	
	ВозможныеУведомления = Новый Массив;
	
	// +ор интеграция МДЛП
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПеремещениеЗапасов") ТОгда
		
		СписокВыбораДляСвязыванияПеремещенияТоваров = ор_ИнтеграцияМДЛП.ПолучитьСписокВыбораДляСвязыванияПеремещенияТоваров(Основание);
		
		Для Каждого Строка Из СписокВыбораДляСвязыванияПеремещенияТоваров Цикл
			ВозможныеУведомления.Добавить(Строка.Значение);
		КонецЦикла;
		
	Иначе
		
		СтруктураВозврата = ор_ИнтеграцияМДЛП.ПолучитьСписокВыбораУведомленний(Основание);
		
		Если СтруктураВозврата <> Неопределено Тогда
			Для Каждого Строка Из СтруктураВозврата.ТаблицаУведомлений Цикл
				
				Если НЕ Строка.УжеСопоставлен Тогда
					ВозможныеУведомления.Добавить(Строка.Ссылка);
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	// -ор интеграция МДЛП
	
	Возврат ВозможныеУведомления;
	
КонецФункции

// Можно переопределить необходимость добавления команды создания уведомления для учетного документа.
//
// Параметры:
//  МетаданныеУведомления - ОбъектМетаданных - Метаданные документа.
//  Основание             - Ссылка - основание уведомления, для которого подбираются уведомления.
// 
// Возвращаемое значение:
//   Булево - команда создания уведомления не будет/будет добавлена (Ложь/Истина)
//
Функция НужноСоздатьУведомленияПоОснованию(МетаданныеУведомления, Основание) Экспорт
	
	// +ор интеграция МДЛП
	Если МетаданныеУведомления = Метаданные.Документы.УведомлениеВладельцаОбОприходованииМДЛП Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТребуетсяСоздание = Ложь;
	ТипОбъектОснование = ТипЗнч(Основание);
	
	Если ТипОбъектОснование = ТИП("ДокументСсылка.ПриходнаяНакладная") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
		Если ор_ИнтеграцияМДЛП.ИспользуетсяОрдернаяСхемаПриемкиОтгрузки(Основание) Тогда
			ТребуетсяСоздание = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.РасходнаяНакладная") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
		Если ор_ИнтеграцияМДЛП.ИспользуетсяОрдернаяСхемаПриемкиОтгрузки(Основание) Тогда
			ТребуетсяСоздание = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.СписаниеЗапасов") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.ОприходованиеЗапасов") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.ор_ИзготовлениеЛекарственныхФорм") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.КомплектацияЗапасов") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.ЧекККМ") Тогда
		
		ТребуетсяСоздание = Истина;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		СтруктураОтправитель = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиница, Истина);
		СтруктураПолучатель  = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.Организация, Основание.СтруктурнаяЕдиницаПолучатель , Истина);
		
		Если СтруктураОтправитель.Идентификатор = СтруктураПолучатель.Идентификатор Тогда
			ТребуетсяСоздание = Ложь;
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураОтправитель.Организация) Тогда
			ТребуетсяСоздание = СтруктураОтправитель.ВестиУчетВЭтойИБ;
			
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.ПриходныйОрдер")
		И ТипЗнч(Основание.ДокументОснование) = ТИП("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		СтруктураОтправитель = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.ДокументОснование.Организация, Основание.ДокументОснование.СтруктурнаяЕдиница, Истина);
		СтруктураПолучатель  = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.ДокументОснование.Организация, Основание.ДокументОснование.СтруктурнаяЕдиницаПолучатель , Истина);
		
		Если СтруктураОтправитель.Идентификатор = СтруктураПолучатель.Идентификатор Тогда
			ТребуетсяСоздание = Ложь;
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураОтправитель.Организация) Тогда
			ТребуетсяСоздание = СтруктураОтправитель.ВестиУчетВЭтойИБ;
			
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.ПриходныйОрдер") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.ДокументОснование.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.РасходныйОрдер")
		И ТипЗнч(Основание.ДокументОснование) = ТИП("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		СтруктураОтправитель = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.ДокументОснование.Организация, Основание.ДокументОснование.СтруктурнаяЕдиница, Истина);
		СтруктураПолучатель  = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.ДокументОснование.Организация, Основание.ДокументОснование.СтруктурнаяЕдиницаПолучатель , Истина);
		
		Если СтруктураОтправитель.Идентификатор = СтруктураПолучатель.Идентификатор Тогда
			ТребуетсяСоздание = Ложь;
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураОтправитель.Организация) Тогда
			ТребуетсяСоздание = СтруктураОтправитель.ВестиУчетВЭтойИБ;
			
		КонецЕсли;
		
	ИначеЕсли ТипОбъектОснование = ТИП("ДокументСсылка.РасходныйОрдер") Тогда
		
		СтруктураОрганизации = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Основание.ДокументОснование.Организация, Основание.СтруктурнаяЕдиница, Истина);
		Если ЗначениеЗаполнено(СтруктураОрганизации.Организация) Тогда
			ТребуетсяСоздание = СтруктураОрганизации.ВестиУчетВЭтойИБ;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТребуетсяСоздание;
	// -ор интеграция МДЛП
	
КонецФункции

// Можно установить возможность отключения требования создания уведомления на основании учетного документа.

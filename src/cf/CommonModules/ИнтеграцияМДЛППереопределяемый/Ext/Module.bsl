//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОВыпускеГотовойПродукцииЗаПределамиРФ(ДокументОснование) Экспорт
	
КонецФункции

// Рассчитывает статус оформления документа учетной системы.
// См. ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - Основание уведомления.
//
Процедура РассчитатьСтатусОформленияУведомленияОРозничныхПродажах(ДокументОснование) Экспорт
	
	ЗапрашиваемыеРеквизиты = Новый Структура;
	ЗапрашиваемыеРеквизиты.Вставить("Проведен");
	ЗапрашиваемыеРеквизиты.Вставить("Дата");
	ЗапрашиваемыеРеквизиты.Вставить("Номер");
	ЗапрашиваемыеРеквизиты.Вставить("Ответственный");
	//ЗапрашиваемыеРеквизиты.Вставить("МестоДеятельности", "СтруктурнаяЕдиница");
	ЗапрашиваемыеРеквизиты.Вставить("Организация");
	ЗапрашиваемыеРеквизиты.Вставить("ор_ЕстьМаркируемаяПродукция");
	ЗапрашиваемыеРеквизиты.Вставить("Статус");
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗапрашиваемыеРеквизиты);
	
	ЗаписьТребуется = ЗначенияРеквизитов.ор_ЕстьМаркируемаяПродукция;
	
	Если НЕ(ЗначенияРеквизитов.Статус = Перечисления.СтатусыЧековККМ.Пробит) Тогда
		ЗаписьТребуется = Ложь;
	КонецЕсли;
	
	Если ор_ИнтеграцияМДЛП.ПолучитьПризнакПередачиДанныхМаркировкиЧерезОФД(ДокументОснование) Тогда
		ЗаписьТребуется = Ложь;
	КонецЕсли;
	
	ИнтеграцияМДЛП.РассчитатьСтатусОформления(
		Метаданные.Документы.УведомлениеОРозничнойПродажеМДЛП,
		ДокументОснование,
		ЗначенияРеквизитов,
		ЗаписьТребуется);
	
КонецПроцедуры

// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОРозничныхПродажах(ДокументОснование) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТаблицаДокументы.Ссылка  КАК Ссылка
	|ПОМЕСТИТЬ ОформленныеДокументы
	|ИЗ
	|	Документ.УведомлениеОРозничнойПродажеМДЛП КАК ТаблицаДокументы
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|	ПО
	|		Статусы.Документ = ТаблицаДокументы.Ссылка
	|ГДЕ
	|	ТаблицаДокументы.Основание = &ДокументОснование
	|	И НЕ ТаблицаДокументы.ПометкаУдаления
	|	И НЕ (ТаблицаДокументы.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|		И Статусы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	1                      КАК План,
	|	0                      КАК Факт
	|ПОМЕСТИТЬ ТоварыКОформлению
	|ИЗ
	|	#ДокументТовары КАК ТаблицаТовары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		#ДокументНомераУпаковок КАК ТаблицаУпаковок
	|	ПО
	|		ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка
	|		И ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеУпаковки.НомерКИЗ,
	|	0,
	|	1
	|ИЗ
	|	Документ.УведомлениеОРозничнойПродажеМДЛП.НомераУпаковок КАК ОформленныеУпаковки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.УведомлениеОРозничнойПродажеМДЛП.Товары КАК ОформленныеТовары
	|	ПО
	|		ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка
	|		И ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ОформленныеДокументы КАК ОформленныеДокументы
	|	ПО
	|		ОформленныеДокументы.Ссылка = ОформленныеТовары.Ссылка
	|ГДЕ
	|	НЕ ОформленныеУпаковки.Отклонено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки,
	|	СУММА(ТоварыКОформлению.План)   КАК План,
	|	СУММА(ТоварыКОформлению.Факт)   КАК Факт
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТоварыКОформлению КАК ТоварыКОформлению
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОформлению.НомерУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.Факт > 0 И Т.План > 0)                КАК ЕстьОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.Факт >= 0 И Т.План > Т.Факт)          КАК ЕстьНеОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.План = Т.Факт)                        КАК ЕстьПолностьюОформленныеТовары,
	|	1 В (ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Результат КАК Т ГДЕ Т.План < Т.Факт)                        КАК ЕстьОшибкиОформления
	|";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТовары", ДокументОснование.Метаданные().ПолноеИмя() + ".Запасы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументНомераУпаковок", ДокументОснование.Метаданные().ПолноеИмя() + ".ор_НомераУпаковок");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Возврат Запрос;
	
КонецФункции

// Рассчитывает статус оформления документа учетной системы.
// См. ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - Основание уведомления.
//
Процедура РассчитатьСтатусОформленияУведомленияОПриемке(ДокументОснование) Экспорт
	
	ДокументОснованиессылка = Неопределено;
	ЗаказПоставщикуСсылка = Неопределено;
	ЭтоДокументОрдера = Ложь;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
		
		ЭтоДокументОрдера = Истина;
		
		ЗапрашиваемыеРеквизитыДокумента = Новый Структура;
		ЗапрашиваемыеРеквизитыДокумента.Вставить("ДокументОснование");
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗапрашиваемыеРеквизитыДокумента);
		
		Если ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная")
			И ЗначениеЗаполнено(РеквизитыДокумента.ДокументОснование) Тогда
			ДокументОснованиеСсылка = РеквизитыДокумента.ДокументОснование;
			
		ИначеЕсли ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику")
			И ЗначениеЗаполнено(РеквизитыДокумента.ДокументОснование) Тогда
			
			Поступление = ор_ИнтеграцияМДЛП.ПолучитьПоступлениеТоваровПоЗаказуПоставщику(РеквизитыДокумента.ДокументОснование);
			
			Если Поступление = Неопределено Тогда
				Возврат;
			Иначе
				ДокументОснованиеСсылка = Поступление;
				ЗаказПоставщикуСсылка = РеквизитыДокумента.ДокументОснование;
			КонецЕсли;
			
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		
		ДокументОснованиессылка = ДокументОснование;
		
	КонецЕсли;
	
	Если ДокументОснованиессылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументОснованиессылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснованиессылка) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		
		ЗапрашиваемыеРеквизиты = Новый Структура;
		ЗапрашиваемыеРеквизиты.Вставить("Проведен");
		ЗапрашиваемыеРеквизиты.Вставить("Дата", "ДатаВходящегоДокумента");
		ЗапрашиваемыеРеквизиты.Вставить("Номер", "НомерВходящегоДокумента");
		ЗапрашиваемыеРеквизиты.Вставить("Ответственный");
		ЗапрашиваемыеРеквизиты.Вставить("МестоДеятельности", "СтруктурнаяЕдиница");
		ЗапрашиваемыеРеквизиты.Вставить("Организация");
		ЗапрашиваемыеРеквизиты.Вставить("ор_ЕстьМаркируемаяПродукция");
		ЗапрашиваемыеРеквизиты.Вставить("ИспользоватьОрдернуюСхему", "СтруктурнаяЕдиница.ОрдерныйСклад");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиессылка, ЗапрашиваемыеРеквизиты);
		
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитов.ИспользоватьОрдернуюСхему) Тогда
			
			ЕстьМаркируемаяПродукция = Ложь;
			
		ИначеЕсли ЗначенияРеквизитов.ИспользоватьОрдернуюСхему Тогда
			
			Если НЕ ЭтоДокументОрдера Тогда
				Возврат;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЕСТЬNULL(СУММА(ВЫБОР
			|				КОГДА ПриходныйОрдер.ор_ЕстьМаркируемаяПродукция
			|					ТОГДА 1
			|				ИНАЧЕ 0
			|			КОНЕЦ), 0) КАК ор_ЕстьМаркируемаяПродукция
			|ИЗ
			|	Документ.ПриходныйОрдер КАК ПриходныйОрдер
			|ГДЕ
			|	ПриходныйОрдер.ДокументОснование = &ДокументОснование
			|	ИЛИ ПриходныйОрдер.ДокументОснование = &ЗаказПоставщикуСсылка";
			Запрос.УстановитьПараметр("ДокументОснование", ДокументОснованиессылка);
			Запрос.УстановитьПараметр("ЗаказПоставщикуСсылка", ЗаказПоставщикуСсылка);
			
			Результат = Запрос.Выполнить();
			
			Если Результат.Пустой() Тогда
				ЕстьМаркируемаяПродукция = Ложь;
			Иначе
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				ЕстьМаркируемаяПродукция = Выборка.ор_ЕстьМаркируемаяПродукция > 0;
			КонецЕсли;
			
		Иначе
			
			ЕстьМаркируемыеТовары = Ложь;
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	Товары.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ПриходнаяНакладная.Запасы КАК Товары
			|ГДЕ
			|	Товары.Ссылка = &Ссылка
			|	И Товары.ор_СтатусЗаполненияУпаковок <> 0";
			Запрос.УстановитьПараметр("Ссылка", ДокументОснованиессылка);
			
			Результат = Запрос.Выполнить();
			
			Если Результат.Пустой() Тогда
				ЕстьМаркируемыеТовары = Ложь;
			Иначе
				ЕстьМаркируемыеТовары = Истина;
			КонецЕсли;
			
			ЕстьМаркируемаяПродукция = ЗначенияРеквизитов.ор_ЕстьМаркируемаяПродукция ИЛИ ЕстьМаркируемыеТовары;
			
		КонецЕсли;
		
		ИнтеграцияМДЛП.РассчитатьСтатусОформления(
			Метаданные.Документы.УведомлениеОПриемкеМДЛП,
			ДокументОснованиессылка,
			ЗначенияРеквизитов,
			ЕстьМаркируемаяПродукция);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОПриемке(ДокументОснование) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаДокументы.Ссылка КАК Ссылка,
	|	Статусы.Статус КАК Статус
	|ПОМЕСТИТЬ ОформленныеДокументы
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП КАК ТаблицаДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|		ПО (Статусы.Документ = ТаблицаДокументы.Ссылка)
	|ГДЕ
	|	ТаблицаДокументы.Основание = &ДокументОснование
	|	И НЕ ТаблицаДокументы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	1 КАК План,
	|	0 КАК Факт
	|ПОМЕСТИТЬ ТоварыКОформлению
	|ИЗ
	|	#ДокументТовары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ДокументНомераУпаковок КАК ТаблицаУпаковок
	|		ПО (ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТранспортныеУпаковки.НомерУпаковки,
	|	1,
	|	0
	|ИЗ
	|	#ДокументТранспортныеУпаковки КАК ТаблицаТранспортныеУпаковки
	|ГДЕ
	|	ТаблицаТранспортныеУпаковки.Ссылка = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ,
	|	1,
	|	0
	|ИЗ
	|	Документ.ПриходныйОрдер.Запасы КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдер.ор_НомераУпаковок КАК ТаблицаУпаковок
	|		ПО (ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка.ДокументОснование = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И ТаблицаТовары.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТранспортныеУпаковки.НомерУпаковки,
	|	1,
	|	0
	|ИЗ
	|	Документ.ПриходныйОрдер.ор_ТранспортныеУпаковки КАК ТаблицаТранспортныеУпаковки
	|ГДЕ
	|	ТаблицаТранспортныеУпаковки.Ссылка.ДокументОснование = &ДокументОснование
	|	И ТаблицаТранспортныеУпаковки.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеУпаковки.НомерКИЗ,
	|	0,
	|	ВЫБОР
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтозваноПоставщиком)
	|			ТОГДА 0
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоПокупателем)
	|			ТОГДА 0
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОформленныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто)
	|						ТОГДА 0
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.НомераУпаковок КАК ОформленныеУпаковки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП.Товары КАК ОформленныеТовары
	|		ПО (ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка)
	|			И (ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
	|		ПО (ОформленныеДокументы.Ссылка = ОформленныеУпаковки.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеТранспортныеУпаковки.НомерУпаковки,
	|	0,
	|	ВЫБОР
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтозваноПоставщиком)
	|			ТОГДА 0
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоПокупателем)
	|			ТОГДА 0
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОформленныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто)
	|						ТОГДА 0
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.ТранспортныеУпаковки КАК ОформленныеТранспортныеУпаковки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
	|		ПО (ОформленныеДокументы.Ссылка = ОформленныеТранспортныеУпаковки.Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки,
	|	СУММА(ТоварыКОформлению.План) КАК План,
	|	СУММА(ТоварыКОформлению.Факт) КАК Факт
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТоварыКОформлению КАК ТоварыКОформлению
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОформлению.НомерУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.Факт > 0
	|			И Т.План > 0) КАК ЕстьОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.Факт >= 0
	|			И Т.План > Т.Факт) КАК ЕстьНеОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.План = Т.Факт) КАК ЕстьПолностьюОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.План < Т.Факт) КАК ЕстьОшибкиОформления";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТовары"              , ДокументОснование.Метаданные().ПолноеИмя() + ".Запасы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументНомераУпаковок"      , ДокументОснование.Метаданные().ПолноеИмя() + ".ор_НомераУпаковок");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТранспортныеУпаковки", ДокументОснование.Метаданные().ПолноеИмя() + ".ор_ТранспортныеУпаковки");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Возврат Запрос;
	
	
КонецФункции


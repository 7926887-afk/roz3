// Вызывается при загрузке уведомления о приемке.
//
// Параметры:
//  Объект - ДокументОбъект.УведомлениеОбОтгрузкеМДЛП - загружаемое уведомление.
//
Процедура ПриЗагрузкеУведомленияОПриемке(Объект) Экспорт
	
	// +ор интеграция МДЛП
	ор_ИнтеграцияМДЛП.ПриЗагрузкеУведомленияЗаполнитьКоличествоУпаковок(Объект);
	
	Если Объект.Операция = Перечисления.ОперацииПриемкиМДЛП.ВозвратОтПокупателя Тогда
		ор_ИнтеграцияМДЛП.ПриЗагрузкеУведомленияЗаполнитьНоменклатуруХарактеристику(Объект);
		ор_ИнтеграцияМДЛП.ПриЗагрузкеУведомленияЗаполнитьНоменклатуруХарактеристику(Объект, "СоставТранспортныхУпаковок");
	Иначе
		ор_ИнтеграцияМДЛП.ПриЗагрузкеУведомленияЗаполнитьНоменклатуруХарактеристику(Объект,, Истина);
		ор_ИнтеграцияМДЛП.ПриЗагрузкеУведомленияЗаполнитьНоменклатуруХарактеристику(Объект, "СоставТранспортныхУпаковок", Истина);
	КонецЕсли
	// -ор интеграция МДЛП
	
КонецПроцедуры


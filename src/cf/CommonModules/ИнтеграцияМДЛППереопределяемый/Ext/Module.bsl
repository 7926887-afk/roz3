#Область ОбработчикиСобытийДокументов

// Вызывается при вводе документа на основании, при выполнении метода Заполнить или при интерактивном вводе нового.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - заполняемый документ,
//  ДанныеЗаполнения - Произвольный - значение, которое используется как основание для заполнения,
//  ТекстЗаполнения - Строка, Неопределено - текст, используемый для заполнения документа,
//  СтандартнаяОбработка - Булево - признак выполнения стандартной (системной) обработки события.
//
Процедура ОбработкаЗаполнения(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	// +ор интеграция МДЛП
	ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	
	ор_ИнтеграцияМДЛП.ОбработкаЗаполнения(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
	// -ор интеграция МДЛП
	
КонецПроцедуры

// Вызывается расширением формы в случае необходимости проверки заполнения реквизитов
// при записи или при проведении документа в форме, а также при выполнении метода ПроверитьЗаполнение.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - проверяемый документ,
//  Отказ - Булево - признак отказа от проведения документа,
//  ПроверяемыеРеквизиты - Массив - массив путей к реквизитам, для которых будет выполнена проверка заполнения,
//  НепроверяемыеРеквизиты - Массив - массив путей к реквизитам, для которых не будет выполнена проверка заполнения.
//
Процедура ОбработкаПроверкиЗаполнения(ДокументОбъект, Отказ, ПроверяемыеРеквизиты, НепроверяемыеРеквизиты) Экспорт
	
	// +ор интеграция МДЛП
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ИнвентаризационнаяОписьМДЛП") Тогда
		Возврат;
	КонецЕсли;
	
	КонтролироватьЗаполнениеТоваровВУведомлениях = ор_ИнтеграцияМДЛП.ПолучитьПризнакКонтролироватьЗаполнениеТоваровВУведомлениях();
	
	Если КонтролироватьЗаполнениеТоваровВУведомлениях Тогда
		ор_ИнтеграцияМДЛП.ПроверитьЗаполнениеНоменклатуры(ДокументОбъект,НепроверяемыеРеквизиты,Отказ);
	Иначе
		
		НепроверяемыеРеквизиты.Добавить("Товары.Номенклатура");
		НепроверяемыеРеквизиты.Добавить("Товары.Характеристика");
		
	КонецЕсли;
	
	ор_ИнтеграцияМДЛП.ПроверитьЗаполнениеХарактеристик(ДокументОбъект,НепроверяемыеРеквизиты,Отказ);
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОПриемкеМДЛП")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОтгрузкеМДЛП")
		ИЛИ (ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОПеремещенииМДЛП")
		И ДокументОбъект.Операция = Перечисления.ОперацииПеремещенияМДЛП.ПриходныйОрдер
		И ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.ПринятоГИСМ) Тогда
		
		Если КонтролироватьЗаполнениеТоваровВУведомлениях Тогда
			ор_ИнтеграцияМДЛП.ПроверитьЗаполнениеНоменклатурыТранспортнойУпаковки(ДокументОбъект,НепроверяемыеРеквизиты,Отказ);
		Иначе
			
			НепроверяемыеРеквизиты.Добавить("СоставТранспортныхУпаковок.Номенклатура");
			НепроверяемыеРеквизиты.Добавить("СоставТранспортныхУпаковок.Характеристика");
			
		КонецЕсли;
		
		ор_ИнтеграцияМДЛП.ПроверитьЗаполнениеХарактеристик(ДокументОбъект,НепроверяемыеРеквизиты,Отказ, Новый Структура("ИмяТЧ", "СоставТранспортныхУпаковок"));
		
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОПриемкеМДЛП")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОприходованииМДЛП")
		ИЛИ (ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОПеремещенииМДЛП")
		И ДокументОбъект.Операция = Перечисления.ОперацииПеремещенияМДЛП.ПриходныйОрдер
		И ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.ПринятоГИСМ) Тогда
		
		ДанныеGTIN = Новый Соответствие;
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.GTIN) И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Номенклатура) Тогда
				ПолученныйGTIN = ДанныеGTIN[СтрокаТабличнойЧасти.GTIN];
				Если ПолученныйGTIN = Неопределено Тогда
					ДанныеGTIN.Вставить(СтрокаТабличнойЧасти.GTIN, Новый Структура("Номенклатура", СтрокаТабличнойЧасти.Номенклатура));
				ИначеЕсли ПолученныйGTIN.Номенклатура <> СтрокаТабличнойЧасти.Номенклатура Тогда
					ТекстСообщения = НСтр("ru = 'В списке товаров есть строки с одним и тем же GTIN %GTIN% для разной номенклатуры.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "", СтрокаТабличнойЧасти.GTIN);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.СоставТранспортныхУпаковок Цикл
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.GTIN) И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Номенклатура) Тогда
				ПолученныйGTIN = ДанныеGTIN[СтрокаТабличнойЧасти.GTIN];
				Если ПолученныйGTIN = Неопределено Тогда
					ДанныеGTIN.Вставить(СтрокаТабличнойЧасти.GTIN, Новый Структура("Номенклатура", СтрокаТабличнойЧасти.Номенклатура));
				ИначеЕсли ПолученныйGTIN.Номенклатура <> СтрокаТабличнойЧасти.Номенклатура Тогда
					ТекстСообщения = НСтр("ru = 'В списке состава транспортных упаковок есть строки с одним и тем же GTIN %GTIN% для разной номенклатуры.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "", СтрокаТабличнойЧасти.GTIN);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	// -ор интеграция МДЛП
	
КонецПроцедуры

// Возникает перед выполнением записи документа. Вызывается после начала транзакции записи, но до начала записи документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - записываемый документ,
//  Отказ - Булево - признак отказа от записи,
//  РежимЗаписи - РежимЗаписиДокумента - текущий режим записи документа,
//  РежимПроведения - РежимПроведенияДокумента - текущий режим проведения документа.
//
Процедура ПередЗаписью(ДокументОбъект, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	// +ор интеграция МДЛП
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) И ЗначениеЗаполнено(ДокументОбъект.Ссылка.Основание) Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("ОснованиеПередЗаписью", ДокументОбъект.Ссылка.Основание);
	КонецЕсли;
	// -ор интеграция МДЛП
	
КонецПроцедуры


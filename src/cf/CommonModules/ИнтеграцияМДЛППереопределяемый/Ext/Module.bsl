// Позволяет переопределить стандартный механизм заполнения документов, выводимых в панели маркировки.
//
// Параметры:
//  ТаблицаДокументы     - ТаблицаЗначений - 
//  СтандартнаяОбработка - Булево - если установить Ложь, то стандартное заполнение пропускается.
//
Процедура ПередЗаполнениемДокументовПанелиМаркировкиМДЛП(ТаблицаДокументы, СтандартнаяОбработка) Экспорт
	
	// +ор интеграция МДЛП
	СтандартнаяОбработка = Ложь;
	
	ТипыДокументов = Метаданные.ОпределяемыеТипы.ДокументИнформированияМДЛП.Тип.Типы();
	
	ТипыДокументовРазрешенные = Новый Массив;
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОбАгрегированииИТрансформацииУпаковокМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОбОтгрузкеМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОВыбытииМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОВыдачеВОтделенияМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОПередачеНаУничтожениеМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОПеремещенииМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОПовторномВводеВОборотМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОПриемкеМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОРозничнойПродажеМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОФактеУничтоженияМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеОбОприходованииМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.УведомлениеВладельцаОбОприходованииМДЛП");
	
	ТипыДокументовРазрешенные.Добавить("Документ.ИнвентаризационнаяОписьМДЛП");
	ТипыДокументовРазрешенные.Добавить("Документ.ИнвентаризацияПотребительскихУпаковокМДЛП");
	
	Для Каждого Тип Из ТипыДокументов Цикл
		
		МетаданныеДокумента = Метаданные.НайтиПоТипу(Тип);
		ПолноеИмяДокумента = МетаданныеДокумента.ПолноеИмя();
		
		Если ТипыДокументовРазрешенные.Найти(ПолноеИмяДокумента) <> Неопределено Тогда
			Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяДокумента);
			Менеджер.ПриЗаполненииДокументовПанелиМаркировкиМДЛП(ТаблицаДокументы);
		КонецЕсли;
		
	КонецЦикла;
	// -ор интеграция МДЛП
	
КонецПроцедуры


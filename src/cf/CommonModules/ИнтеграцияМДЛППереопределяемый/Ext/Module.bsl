// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОВвозеЛПвРФБезИмпортера(ДокументОснование) Экспорт
	
КонецФункции

// Рассчитывает статус оформления документа учетной системы.
// См. ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - Основание уведомления.
//
Процедура РассчитатьСтатусОформленияУведомленияОбОтгрузке(ДокументОснование) Экспорт
	
	ДокументОснованиессылка = Неопределено;
	ЭтоДокументОрдера = Ложь;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		
		ЭтоДокументОрдера = Истина;
		
		ЗапрашиваемыеРеквизитыДокумента = Новый Структура;
		ЗапрашиваемыеРеквизитыДокумента.Вставить("ДокументОснование");
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗапрашиваемыеРеквизитыДокумента);
		
		Если ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.РасходнаяНакладная")
			И ЗначениеЗаполнено(РеквизитыДокумента.ДокументОснование) Тогда
			
			ДокументОснованиессылка = РеквизитыДокумента.ДокументОснование;
			
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		ДокументОснованиессылка = ДокументОснование;
		
	КонецЕсли;
	
	Если ДокументОснованиессылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснованиессылка) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		ЗапрашиваемыеРеквизиты = Новый Структура;
		ЗапрашиваемыеРеквизиты.Вставить("Проведен");
		ЗапрашиваемыеРеквизиты.Вставить("Дата", "Дата");
		ЗапрашиваемыеРеквизиты.Вставить("Номер", "Номер");
		ЗапрашиваемыеРеквизиты.Вставить("Ответственный");
		ЗапрашиваемыеРеквизиты.Вставить("МестоДеятельности", "СтруктурнаяЕдиница");
		ЗапрашиваемыеРеквизиты.Вставить("Организация");
		ЗапрашиваемыеРеквизиты.Вставить("ор_ЕстьМаркируемаяПродукция");
		ЗапрашиваемыеРеквизиты.Вставить("ИспользоватьОрдернуюСхему", "СтруктурнаяЕдиница.ОрдерныйСклад");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиессылка, ЗапрашиваемыеРеквизиты);
		
		Если ЗначенияРеквизитов.ИспользоватьОрдернуюСхему Тогда
			
			Если НЕ ЭтоДокументОрдера Тогда
				Возврат;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЕСТЬNULL(СУММА(ВЫБОР
			|				КОГДА РасходныйОрдер.ор_ЕстьМаркируемаяПродукция
			|					ТОГДА 1
			|				ИНАЧЕ 0
			|			КОНЕЦ), 0) КАК ор_ЕстьМаркируемаяПродукция
			|ИЗ
			|	Документ.РасходныйОрдер КАК РасходныйОрдер
			|ГДЕ
			|	РасходныйОрдер.ДокументОснование = &ДокументОснование";
			Запрос.УстановитьПараметр("ДокументОснование", ДокументОснованиессылка);
			
			Результат = Запрос.Выполнить();
			
			Если Результат.Пустой() Тогда
				ЕстьМаркируемаяПродукция = Ложь;
			Иначе
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				ЕстьМаркируемаяПродукция = Выборка.ор_ЕстьМаркируемаяПродукция > 0;
			КонецЕсли;
			
		Иначе
			ЕстьМаркируемаяПродукция = ЗначенияРеквизитов.ор_ЕстьМаркируемаяПродукция;
		КонецЕсли;
		
		ИнтеграцияМДЛП.РассчитатьСтатусОформления(
			Метаданные.Документы.УведомлениеОбОтгрузкеМДЛП,
			ДокументОснованиессылка,
			ЗначенияРеквизитов,
			ЕстьМаркируемаяПродукция);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОбОтгрузке(ДокументОснование) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаДокументы.Ссылка КАК Ссылка,
	|	Статусы.Статус КАК Статус
	|ПОМЕСТИТЬ ОформленныеДокументы
	|ИЗ
	|	Документ.УведомлениеОбОтгрузкеМДЛП КАК ТаблицаДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|		ПО (Статусы.Документ = ТаблицаДокументы.Ссылка)
	|ГДЕ
	|	ТаблицаДокументы.Основание = &ДокументОснование
	|	И НЕ ТаблицаДокументы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	1 КАК План,
	|	0 КАК Факт,
	|	0 КАК Актуализирован
	|ПОМЕСТИТЬ ТоварыКОформлению
	|ИЗ
	|	#ДокументТовары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ДокументНомераУпаковок КАК ТаблицаУпаковок
	|		ПО (ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТранспортныеУпаковки.НомерУпаковки,
	|	1,
	|	0,
	|	0
	|ИЗ
	|	#ДокументТранспортныеУпаковки КАК ТаблицаТранспортныеУпаковки
	|ГДЕ
	|	ТаблицаТранспортныеУпаковки.Ссылка = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ,
	|	1,
	|	0,
	|	0
	|ИЗ
	|	Документ.РасходныйОрдер.Запасы КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходныйОрдер.ор_НомераУпаковок КАК ТаблицаУпаковок
	|		ПО (ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка.ДокументОснование = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И ТаблицаТовары.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТранспортныеУпаковки.НомерУпаковки,
	|	1,
	|	0,
	|	0
	|ИЗ
	|	Документ.РасходныйОрдер.ор_ТранспортныеУпаковки КАК ТаблицаТранспортныеУпаковки
	|ГДЕ
	|	ТаблицаТранспортныеУпаковки.Ссылка.ДокументОснование = &ДокументОснование
	|	И ТаблицаТранспортныеУпаковки.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеУпаковки.НомерКИЗ,
	|	0,
	|	ВЫБОР
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтозваноПоставщиком)
	|			ТОГДА 0
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоПокупателем)
	|			ТОГДА 0
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.АктуализироватьДанныеОбУпаковках)
	|			ТОГДА 0
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ДанныеОбУпаковкахАктуализированы)
	|			ТОГДА 0
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОформленныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто)
	|						ТОГДА 0
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.АктуализироватьДанныеОбУпаковках)
	|			ТОГДА 1
	|		КОГДА ОформленныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ДанныеОбУпаковкахАктуализированы)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	Документ.УведомлениеОбОтгрузкеМДЛП.НомераУпаковок КАК ОформленныеУпаковки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОтгрузкеМДЛП.Товары КАК ОформленныеТовары
	|		ПО (ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка)
	|			И (ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
	|		ПО (ОформленныеДокументы.Ссылка = ОформленныеУпаковки.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеТранспортныеУпаковки.НомерУпаковки,
	|	0,
	|	ВЫБОР
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтозваноПоставщиком)
	|			ТОГДА 0
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоПокупателем)
	|			ТОГДА 0
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.АктуализироватьДанныеОбУпаковках)
	|			ТОГДА 0
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ДанныеОбУпаковкахАктуализированы)
	|			ТОГДА 0
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОформленныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто)
	|						ТОГДА 0
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.АктуализироватьДанныеОбУпаковках)
	|			ТОГДА 1
	|		КОГДА ОформленныеТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ДанныеОбУпаковкахАктуализированы)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	Документ.УведомлениеОбОтгрузкеМДЛП.ТранспортныеУпаковки КАК ОформленныеТранспортныеУпаковки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
	|		ПО (ОформленныеДокументы.Ссылка = ОформленныеТранспортныеУпаковки.Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки,
	|	СУММА(ТоварыКОформлению.План) КАК План,
	|	СУММА(ТоварыКОформлению.Факт) КАК Факт,
	|	СУММА(ТоварыКОформлению.Актуализирован) КАК Актуализирован
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТоварыКОформлению КАК ТоварыКОформлению
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОформлению.НомерУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.Факт > 0
	|			И Т.План > 0) КАК ЕстьОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.Факт >= 0
	|			И Т.План > Т.Факт) КАК ЕстьНеОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.План = Т.Факт) КАК ЕстьПолностьюОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			(Т.План < Т.Факт
	|				ИЛИ Т.Факт = 0
	|					И Т.Актуализирован > 0)) КАК ЕстьОшибкиОформления";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТовары"              , ДокументОснование.Метаданные().ПолноеИмя() + ".Запасы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументНомераУпаковок"      , ДокументОснование.Метаданные().ПолноеИмя() + ".ор_НомераУпаковок");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТранспортныеУпаковки", ДокументОснование.Метаданные().ПолноеИмя() + ".ор_ТранспортныеУпаковки");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Возврат Запрос;
	
КонецФункции

// Рассчитывает статус оформления документа учетной системы.
// См. ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - Основание уведомления.
//
Процедура РассчитатьСтатусОформленияУведомленияОбОтгрузкеВРФ(ДокументОснование) Экспорт
	
	
	
КонецПроцедуры

// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями:
//    * ЕстьОформленныеТовары - Булево
//    * ЕстьНеОформленныеТовары - Булево
//    * ЕстьПолностьюОформленныеТовары - Булево
//    * ЕстьОшибкиОформления - Булево
//
Функция ЗапросСтатусаОформленияУведомленияОбОтгрузкеВРФ(ДокументОснование) Экспорт
	
КонецФункции

// Рассчитывает статус оформления документа учетной системы.
// См. ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - Основание уведомления.
//
Процедура РассчитатьСтатусОформленияУведомленияОПеремещении(ДокументОснование) Экспорт
	
	ДокументОснованиессылка = Неопределено;
	ЭтоДокументОрдера = Ложь;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		
		ЭтоДокументОрдера = Истина;
		
		ЗапрашиваемыеРеквизитыДокумента = Новый Структура;
		ЗапрашиваемыеРеквизитыДокумента.Вставить("ДокументОснование");
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗапрашиваемыеРеквизитыДокумента);
		
		Если ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов")
			И ЗначениеЗаполнено(РеквизитыДокумента.ДокументОснование) Тогда
			
			ДокументОснованиессылка = РеквизитыДокумента.ДокументОснование;
			
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		ДокументОснованиессылка = ДокументОснование;
		
	КонецЕсли;
	
	Если ДокументОснованиессылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснованиессылка) = ТИП("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		ЗапрашиваемыеРеквизиты = Новый Структура;
		ЗапрашиваемыеРеквизиты.Вставить("Проведен");
		ЗапрашиваемыеРеквизиты.Вставить("Дата");
		ЗапрашиваемыеРеквизиты.Вставить("Номер");
		ЗапрашиваемыеРеквизиты.Вставить("Ответственный", "Автор");
		ЗапрашиваемыеРеквизиты.Вставить("МестоДеятельности", "СтруктурнаяЕдиница");
		ЗапрашиваемыеРеквизиты.Вставить("Организация");
		ЗапрашиваемыеРеквизиты.Вставить("ор_ЕстьМаркируемаяПродукция");
		ЗапрашиваемыеРеквизиты.Вставить("ИспользоватьОрдернуюСхему", "СтруктурнаяЕдиница.ОрдерныйСклад");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиессылка, ЗапрашиваемыеРеквизиты);
		
		ЕстьМаркируемаяПродукцияОрдера = Ложь;
		
		Если ЗначенияРеквизитов.ИспользоватьОрдернуюСхему И ЭтоДокументОрдера Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЕСТЬNULL(СУММА(ВЫБОР
			|				КОГДА РасходныйОрдер.ор_ЕстьМаркируемаяПродукция
			|					ТОГДА 1
			|				ИНАЧЕ 0
			|			КОНЕЦ), 0) КАК ор_ЕстьМаркируемаяПродукция
			|ИЗ
			|	Документ.РасходныйОрдер КАК РасходныйОрдер
			|ГДЕ
			|	РасходныйОрдер.ДокументОснование = &ДокументОснование";
			Запрос.УстановитьПараметр("ДокументОснование", ДокументОснованиессылка);
			
			Результат = Запрос.Выполнить();
			
			Если Результат.Пустой() Тогда
				ЕстьМаркируемаяПродукцияОрдера = Ложь;
			Иначе
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				ЕстьМаркируемаяПродукцияОрдера = Выборка.ор_ЕстьМаркируемаяПродукция > 0;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаписьТребуется = ЕстьМаркируемаяПродукцияОрдера ИЛИ ЗначенияРеквизитов.ор_ЕстьМаркируемаяПродукция;
		
		ИнтеграцияМДЛП.РассчитатьСтатусОформления(
			Метаданные.Документы.УведомлениеОПеремещенииМДЛП,
			ДокументОснованиессылка,
			ЗначенияРеквизитов,
			ЗаписьТребуется);
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает запрос для расчета статуса оформления. Используется при вызове ИнтеграцияМДЛП.РассчитатьСтатусОформления.
//
// Параметры:
//  ДокументОснование - Ссылка - основание уведомления, для которого формируется запрос статуса.
//  ДокументОснование - ДокументСсылка - основание уведомления.
//
// Возвращаемое значение:
//  Запрос - Выборка из результата запроса должна содержать одну строку с полями.
//
Функция ЗапросСтатусаОформленияУведомленияОПеремещении(ДокументОснование) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ОформленныеДокументы
	|ИЗ
	|	Документ.УведомлениеОПеремещенииМДЛП КАК ТаблицаДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|		ПО (Статусы.Документ = ТаблицаДокументы.Ссылка)
	|ГДЕ
	|	ТаблицаДокументы.Основание = &ДокументОснование
	|	И НЕ ТаблицаДокументы.ПометкаУдаления
	|	И НЕ(ТаблицаДокументы.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
	|				И Статусы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	1 КАК План,
	|	0 КАК Факт
	|ПОМЕСТИТЬ ТоварыКОформлению
	|ИЗ
	|	#ДокументТовары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ДокументНомераУпаковок КАК ТаблицаУпаковок
	|		ПО (ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТранспортныеУпаковки.НомерУпаковки,
	|	1,
	|	0
	|ИЗ
	|	#ДокументТранспортныеУпаковки КАК ТаблицаТранспортныеУпаковки
	|ГДЕ
	|	ТаблицаТранспортныеУпаковки.Ссылка = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерКИЗ,
	|	1,
	|	0
	|ИЗ
	|	Документ.РасходныйОрдер.Запасы КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходныйОрдер.ор_НомераУпаковок КАК ТаблицаУпаковок
	|		ПО (ТаблицаУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТаблицаУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка.ДокументОснование = &ДокументОснование
	|	И ТаблицаТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И ТаблицаТовары.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТранспортныеУпаковки.НомерУпаковки,
	|	1,
	|	0
	|ИЗ
	|	Документ.РасходныйОрдер.ор_ТранспортныеУпаковки КАК ТаблицаТранспортныеУпаковки
	|ГДЕ
	|	ТаблицаТранспортныеУпаковки.Ссылка.ДокументОснование = &ДокументОснование
	|	И ТаблицаТранспортныеУпаковки.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеУпаковки.НомерКИЗ,
	|	0,
	|	1
	|ИЗ
	|	Документ.УведомлениеОПеремещенииМДЛП.НомераУпаковок КАК ОформленныеУпаковки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПеремещенииМДЛП.Товары КАК ОформленныеТовары
	|		ПО (ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка)
	|			И (ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
	|		ПО (ОформленныеДокументы.Ссылка = ОформленныеУпаковки.Ссылка)
	|ГДЕ
	|	НЕ ОформленныеУпаковки.Отклонено
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОформленныеТранспортныеУпаковки.НомерУпаковки,
	|	0,
	|	1
	|ИЗ
	|	Документ.УведомлениеОПеремещенииМДЛП.ТранспортныеУпаковки КАК ОформленныеТранспортныеУпаковки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
	|		ПО (ОформленныеДокументы.Ссылка = ОформленныеТранспортныеУпаковки.Ссылка)
	|ГДЕ
	|	НЕ ОформленныеТранспортныеУпаковки.Отклонено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки,
	|	СУММА(ТоварыКОформлению.План) КАК План,
	|	СУММА(ТоварыКОформлению.Факт) КАК Факт
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТоварыКОформлению КАК ТоварыКОформлению
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОформлению.НомерУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.Факт > 0
	|			И Т.План > 0) КАК ЕстьОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.Факт >= 0
	|			И Т.План > Т.Факт) КАК ЕстьНеОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.План = Т.Факт) КАК ЕстьПолностьюОформленныеТовары,
	|	1 В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			1
	|		ИЗ
	|			Результат КАК Т
	|		ГДЕ
	|			Т.План < Т.Факт) КАК ЕстьОшибкиОформления";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТовары"              , ДокументОснование.Метаданные().ПолноеИмя() + ".Запасы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументНомераУпаковок"      , ДокументОснование.Метаданные().ПолноеИмя() + ".ор_НомераУпаковок");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ДокументТранспортныеУпаковки", ДокументОснование.Метаданные().ПолноеИмя() + ".ор_ТранспортныеУпаковки");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Возврат Запрос;
	
КонецФункции


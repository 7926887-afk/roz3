
#Область ПрограммныйИнтерфейс

#Область НастройкиРазрешительногоРежима

// Возвращает сохраненные настройки разрешительного режима.
//
// Возвращаемое значение:
//  Результат - Структура - См. РазрешительныйРежимМДЛПКлиентСервер.НастройкиРазрешительногоРежимаПоУмолчанию().
//
Функция НастройкиРазрешительногоРежима() Экспорт
	
	Результат = РазрешительныйРежимМДЛПКлиентСервер.НастройкиРазрешительногоРежимаПоУмолчанию();
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗначениеКонстанты = Константы.НастройкиРазрешительногоРежимаМДЛП.Получить().Получить();
	
	Если ТипЗнч(ЗначениеКонстанты) = Тип("Структура") Или ТипЗнч(ЗначениеКонстанты) = Тип("ФиксированнаяСтруктура") Тогда
		ЗаполнитьЗначенияСвойств(Результат, ЗначениеКонстанты);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает новые настройки разрешительного режима.
//
// Параметры:
//  НовыеНастройки - Структура - новые настройки разрешительного режима.
//
Процедура УстановитьНастройкиРазрешительногоРежима(НовыеНастройки) Экспорт
	
	Настройки = РазрешительныйРежимМДЛПКлиентСервер.НастройкиРазрешительногоРежимаПоУмолчанию();
	
	ЗаполнитьЗначенияСвойств(Настройки, НовыеНастройки);
	
	ЗначениеКонстанты = Новый ХранилищеЗначения(Новый ФиксированнаяСтруктура(Настройки));
	
	Константы.НастройкиРазрешительногоРежимаМДЛП.Установить(ЗначениеКонстанты);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти // НастройкиРазрешительногоРежима

#Область МетодыИнтерфейсаРазрешительногоРежима

#Область ПроверкаКодаМаркировки

// Запускает проверку кодов маркировки в длительной операции.
//
// Параметры:
//  ПараметрыПроверкиКМНаСервере - Структура - См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаКлиентеНаСервере.
//
// Возвращаемое значение:
//  ДлительнаяОперация - длительная операция выполнения проверки КМ.
//
Функция НачатьПроверкуКМНаСервере(ПараметрыПроверкиКМНаСервере) Экспорт
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ПараметрыПроверкиКМНаСервере.УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Фоновое получение идентификаторов запроса ГИС МТ при розничной продаже'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"РазрешительныйРежимМДЛП.ПроверитьКМНаСервереДлительнаяОперация",
		ПараметрыПроверкиКМНаСервере,
		ПараметрыВыполнения);
	
КонецФункции

// Длительная операция проверки кодов маркировки.
//
// Параметры:
//  ПараметрыПроверкиКМНаСервере - Структура - См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаКлиентеНаСервере.
//  АдресРезультата - Строка - адрес временного хранилища, по которому будет помещен результат проверки КМ.
//
Процедура ПроверитьКМНаСервереДлительнаяОперация(ПараметрыПроверкиКМНаСервере, АдресРезультата) Экспорт
	
	РезультатПроверки = ПроверитьКМНаСервере(ПараметрыПроверкиКМНаСервере);
	
	ПоместитьВоВременноеХранилище(РезультатПроверки, АдресРезультата);
	
КонецПроцедуры

// Возвращает результат проверки кодов маркировки на сервере.
//
// Параметры:
//  ПараметрыПроверкиКМНаСервере - Структура - См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаКлиентеНаСервере.
//
// Возвращаемое значение:
//  РезультатПроверки - Структура - см. РазрешительныйРежимМДЛПКлиентСервер.НовыйРезультатПроверкиКМНаКлиентеНаСервере.
//
Функция ПроверитьКМНаСервере(Знач ПараметрыПроверкиКМНаСервере) Экспорт
	
	ПараметрыВыполненияПроверкиКМНаСервере = РазрешительныйРежимМДЛПКлиентСервер.ПараметрыПроверкиКМНаКлиентеНаСервере();
	ЗаполнитьЗначенияСвойств(ПараметрыВыполненияПроверкиКМНаСервере, ПараметрыПроверкиКМНаСервере);
	
	Если ПараметрыВыполненияПроверкиКМНаСервере.ВыполнятьПроверкуНаТСПИоТ Тогда
		
		// Проверка на ТС ПИоТ.
		РезультатПроверкиНаТСПИоТ = ИнтеграцияТСПИоТМДЛПКлиентСервер.ПроверитьКМНаТСПИоТ(ПараметрыВыполненияПроверкиКМНаСервере);
		
		ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки = РезультатПроверкиНаТСПИоТ;
		// ор ++
		Если Не ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки.ЕстьОшибки
			И РезультатПроверкиНаТСПИоТ.КодыМаркировкиБезДанных <> Неопределено
			И РезультатПроверкиНаТСПИоТ.КодыМаркировкиБезДанных.Количество() > 0 Тогда
			// Проверка на Локальном модуле ЧЗ.
			РезультатПроверкиНаЛокальномМодуле = РазрешительныйРежимМДЛПКлиентСервер.ПроверитьКМНаЛокальномМодуле(ПараметрыВыполненияПроверкиКМНаСервере);
			РезультатПроверкиНаЛокальномМодуле.ПроверкаНаТСПИоТЗавершена = РезультатПроверкиНаТСПИоТ.ПроверкаНаТСПИоТЗавершена;
			ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки = РезультатПроверкиНаЛокальномМодуле;
		КонецЕсли;
		// ор --
		
		Возврат ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки;
		
	Иначе
		
		// Онлайн проверка.
		РезультатПроверкиОнлайн = РазрешительныйРежимМДЛПКлиентСервер.ПроверитьКМОнлайн(ПараметрыВыполненияПроверкиКМНаСервере);
		
		ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки = РезультатПроверкиОнлайн;
		
		Если ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки.ЕстьОшибки Тогда
			Возврат ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки;
		КонецЕсли;
		
		// Проверка на Локальном модуле ЧЗ.
		РезультатПроверкиНаЛокальномМодуле = РазрешительныйРежимМДЛПКлиентСервер.ПроверитьКМНаЛокальномМодуле(ПараметрыВыполненияПроверкиКМНаСервере);
		
		ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки = РезультатПроверкиНаЛокальномМодуле;
		
		Возврат ПараметрыВыполненияПроверкиКМНаСервере.РезультатПроверки;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти // ПроверкаКодаМаркировки

#Область CDNПлощадки

// Актуализация списка CDN-площадок для обращения в ГИС МТ методом розничной продажи.
// При своевременной актуализации списка гарантируется максимально быстрое получение идентификаторов
// разрешительного режима для ускорения розничной продажи.
//
// Параметры:
//  Организация - СправочникСсылка.ОрганизацииМДЛП - Организация.
//
// Возвращаемое значение:
//  Структура - результат обновления площадок:
//   * ТребуетсяОбновлениеКлючаСессииРозница - Булево - признак необходимости обновления ключа сессии.
//   * СписокПлощадок - Соответствие Из КлючИЗначение - полученные CDN-площадки:
//      ** Ключ     - Строка - адрес площадки.
//      ** Значение - Структура - замеры скорости CDN-площадок.
// * ТекстОшибки - Строка - текст ошибки, полученной от ГИС МТ.
//
Функция АктуализацияСпискаCDNПлощадок(Организация) Экспорт
	
	КлючСессии = ПроверитьОбновитьКлючСессии(РазрешительныйРежимМДЛПКлиентСервер.ПараметрыЗапросаКлючаСессииГИСМТРозница(Организация));
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ТребуетсяОбновлениеКлючаСессииРозница", КлючСессии = Неопределено);
	ВозвращаемоеЗначение.Вставить("СписокПлощадок",                        Новый Соответствие);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",                           "");
	
	Если ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессииРозница Тогда
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ЗаголовкиHTTP = Новый Соответствие;
	ЗаголовкиHTTP.Вставить("Content-Type"  , "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Accept-Charset", "utf-8");
	ЗаголовкиHTTP.Вставить("X-API-KEY"     , КлючСессии);
	
	ДанныеЗапроса = ТранспортМДЛПКлиентСервер.ДанныеHTTPЗапроса("GET");
	ДанныеЗапроса.АдресЗапроса = "api/v4/true-api/cdn/info";
	ДанныеЗапроса.Заголовки = ЗаголовкиHTTP;
	
	ПараметрыЗапросов = РазрешительныйРежимМДЛПКлиентСервер.ПараметрыОтправкиHTTPЗапросов(Истина, Истина);
	
	ПараметрыПодключения = ТранспортМДЛПКлиентСервер.НовыеПараметрыОтправкиHTTPЗапросов();
	ЗаполнитьЗначенияСвойств(ПараметрыПодключения, ПараметрыЗапросов);
	
	РезультатОтправкиЗапроса = ТранспортМДЛПКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыПодключения, ДанныеЗапроса);
	
	Если РезультатОтправкиЗапроса.Статус = "Ошибка" Тогда
		// Не получен список площадок, таймаут или иные проблемы.
		ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(ДанныеЗапроса.АдресЗапроса, РезультатОтправкиЗапроса);
		ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессииРозница = РезультатОтправкиЗапроса.ТребуетсяАвторизация;
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ДанныеОтвета = ТранспортМДЛПКлиентСервер.ПреобразоватьJSONВЗначение(РезультатОтправкиЗапроса.ОтветТранспортногоМодуля, Истина);
	
	Если ДанныеОтвета = Неопределено Тогда
		ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(ДанныеЗапроса.АдресЗапроса, РезультатОтправкиЗапроса);
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	КодОтвета = ДанныеОтвета.Получить("code");
	Если КодОтвета <> 0 Тогда
		РезультатОтправкиЗапросаОшибка = ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации();
		РезультатОтправкиЗапросаОшибка.Статус = "Ошибка";
		РезультатОтправкиЗапросаОшибка.ОписаниеОшибки = НСтр("ru = 'Получен неверный запрос. Код ответа - %1: %2'");
		РезультатОтправкиЗапросаОшибка.ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(РезультатОтправкиЗапросаОшибка.ОписаниеОшибки, КодОтвета, ДанныеОтвета.Получить("description"));
		ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(ДанныеЗапроса.АдресЗапроса, РезультатОтправкиЗапроса);
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	КоличествоЗапросовПоОднойПлощадкеДляУсредненияРезультата = 3;
	
	СписокПлощадок = ДанныеОтвета.Получить("hosts");
	
	ЗаголовкиHTTP.Вставить("Connection", "close");
	
	Для Каждого Площадка Из СписокПлощадок Цикл
		
		АдресПлощадки = Площадка.Получить("host");
		СтруктураАдреса = РегистрыСведений.СостоянияCDNПлощадокМДЛП.РазобратьАдресПлощадкиНаСерверИПорт(АдресПлощадки);
		
		ДанныеЗапроса = ТранспортМДЛПКлиентСервер.ДанныеHTTPЗапроса("GET");
		ДанныеЗапроса.АдресЗапроса = "api/v4/true-api/cdn/health/check";
		ДанныеЗапроса.Заголовки = ЗаголовкиHTTP;
		
		ПараметрыПодключения = ТранспортМДЛПКлиентСервер.НовыеПараметрыОтправкиHTTPЗапросов();
		ПараметрыПодключения.Адрес                = СтруктураАдреса.Сервер;
		ПараметрыПодключения.Порт                 = СтруктураАдреса.Порт;
		ПараметрыПодключения.ЗащищенноеСоединение = СтруктураАдреса.ЗащищенноеСоединение;
		
		ЗамерыПоПлощадке = Новый Массив;
		
		Для Индекс = 1 По КоличествоЗапросовПоОднойПлощадкеДляУсредненияРезультата Цикл
			
			НачалоЗамеровУниверсальнаяДата = ТекущаяУниверсальнаяДатаВМиллисекундах();
			
			РезультатОтправкиЗапроса = ТранспортМДЛПКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыПодключения, ДанныеЗапроса);
			
			Если РезультатОтправкиЗапроса.Статус = "Ошибка" Тогда
				
				ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(АдресПлощадки + "/" + ДанныеЗапроса.АдресЗапроса, РезультатОтправкиЗапроса);
				
				Если РезультатОтправкиЗапроса.ТребуетсяАвторизация Тогда
					ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессииРозница = РезультатОтправкиЗапроса.ТребуетсяАвторизация;
					ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибки;
					Возврат ВозвращаемоеЗначение;
				Иначе
					РазрешительныйРежимМДЛПКлиентСервер.ДополнитьТекстОшибки(ВозвращаемоеЗначение.ТекстОшибки, ТекстОшибки);
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
			ДанныеОтвета = ТранспортМДЛПКлиентСервер.ПреобразоватьJSONВЗначение(РезультатОтправкиЗапроса.ОтветТранспортногоМодуля, Истина);
			
			Если ДанныеОтвета = Неопределено Тогда
				ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(АдресПлощадки + "/" + ДанныеЗапроса.АдресЗапроса, РезультатОтправкиЗапроса);
				Прервать;
			КонецЕсли;
			
			СреднееВремяОбработкиКМ = ДанныеОтвета.Получить("avgTimeMs");
			Если Не ЗначениеЗаполнено(СреднееВремяОбработкиКМ) Тогда
				СреднееВремяОбработкиКМ = 0;
			КонецЕсли;
			
			ЗамерПоПлощадке = Новый Структура("НачалоЗамера, КонецЗамера, СреднееВремяОбработкиКМ", НачалоЗамеровУниверсальнаяДата, ТекущаяУниверсальнаяДатаВМиллисекундах(), СреднееВремяОбработкиКМ);
			
			ЗамерыПоПлощадке.Добавить(ЗамерПоПлощадке);
			
		КонецЦикла;
		
		СтруктураЗамеров = Новый Структура;
		СтруктураЗамеров.Вставить("СреднееВремяПроверкиКМ", 0);
		СтруктураЗамеров.Вставить("СреднееВремяОтвета",     0);
		
		Если ЗначениеЗаполнено(ЗамерыПоПлощадке) Тогда
			
			ОбщееВремяПроверкиКМ = 0;
			ОбщееВремяОтвета     = 0;
			
			Для Каждого ЗамерВремени Из ЗамерыПоПлощадке Цикл
				ОбщееВремяПроверкиКМ = ОбщееВремяПроверкиКМ + ЗамерВремени.СреднееВремяОбработкиКМ;
				ОбщееВремяОтвета     = ОбщееВремяОтвета + (ЗамерВремени.КонецЗамера - ЗамерВремени.НачалоЗамера);
			КонецЦикла;
			
			СтруктураЗамеров.СреднееВремяПроверкиКМ = ОбщееВремяПроверкиКМ / КоличествоЗапросовПоОднойПлощадкеДляУсредненияРезультата;
			СтруктураЗамеров.СреднееВремяОтвета     = ОбщееВремяОтвета / КоличествоЗапросовПоОднойПлощадкеДляУсредненияРезультата;
			
		Иначе
			
			// Ответа от площадок не получено, площадка получает минимальный рейтинг в списке.
			СтруктураЗамеров.СреднееВремяПроверкиКМ = -1;
			СтруктураЗамеров.СреднееВремяОтвета     = -1;
			
		КонецЕсли;
		
		ВозвращаемоеЗначение.СписокПлощадок.Вставить(АдресПлощадки, СтруктураЗамеров);
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти // CDNПлощадки

#КонецОбласти // МетодыИнтерфейсаРазрешительногоРежима


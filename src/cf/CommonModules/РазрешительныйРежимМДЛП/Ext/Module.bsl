#Область ОбновлениеИнформационнойБазы

// См. процедуры ОбновлениеИнформационнойБазыМДЛП.ПриДобавленииОбработчиковОбновления,
// ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления.
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РазрешительныйРежимМДЛП.НачальноеЗаполнение";
	Обработчик.НачальноеЗаполнение = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия              = "1.2.11.1";
	Обработчик.Процедура           = "РазрешительныйРежимМДЛП.УстановитьНастройкиРазрешительногоРежимаМДЛП";
	Обработчик.РежимВыполнения = "Монопольно";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.2.13.1";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("7def8dc0-a658-4dab-ba60-9f9d4957dc9a");
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Процедура = "РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП.ОбработатьДанныеДляПереходаНаНовуюВерсиюЗаполнениеФорматаОбмена";
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсиюЗаполнениеФорматаОбмена";
	Обработчик.ОчередьОтложеннойОбработки = 1;
	Обработчик.ПроцедураПроверки  = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.БлокируемыеОбъекты = "";
	Обработчик.ЧитаемыеОбъекты    = "РегистрСведений.НастройкиПодключенияЛокальныхМодулейМДЛП";
	Обработчик.ИзменяемыеОбъекты  = "РегистрСведений.НастройкиПодключенияЛокальныхМодулейМДЛП";
	Обработчик.Комментарий        = НСтр("ru = 'Заполнение формата обмена с ЛМ ЧЗ по умолчанию'");
	Обработчик.ПриоритетыВыполнения = ОбновлениеИнформационнойБазы.ПриоритетыВыполненияОбработчика();
	
КонецПроцедуры

#Область ПервоначальноеЗаполнениеИОбновлениеИнформационнойБазы

Процедура НачальноеЗаполнение() Экспорт
	
	УстановитьНастройкиРазрешительногоРежимаМДЛП(Истина);
	
КонецПроцедуры

Процедура УстановитьНастройкиРазрешительногоРежимаМДЛП(НачальноеЗаполнение = Ложь) Экспорт
	
	Настройки = НастройкиРазрешительногоРежима();
	
	Если Не НачальноеЗаполнение Тогда
		ЗаполнитьЗначенияСвойств(Настройки, ОбщегоНазначенияИСМПВызовСервера.НастройкиСканированияКодовМаркировки());
	КонецЕсли;
	
	УстановитьНастройкиРазрешительногоРежима(Настройки);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти // ОбновлениеИнформационнойБазы

#Область Авторизация

// Возвращает структуру данных ключа сессии обмена с ГИС МТ.
//
// Параметры:
// Возвращаемое значение:
//  Структура - Параметры ключа сессии:
//   * КлючСессии  - Строка - Ключ сессии.
//   * ДействуетДо - Дата   - Дата и время окончания действия ключа сессии.
//
Функция ПараметрыКлючаСессии() Экспорт
	
	ПараметрыКлючаСессии = Новый Структура;
	ПараметрыКлючаСессии.Вставить("ИНН",         "");
	ПараметрыКлючаСессии.Вставить("КлючСессии" , "");
	ПараметрыКлючаСессии.Вставить("ДействуетДо", Дата(1,1,1));
	
	Возврат ПараметрыКлючаСессии;
	
КонецФункции

// Возвращает ключ сессии для обмена с ГИС МТ.
//
// Параметры:
//  ПараметрыЗапроса             - См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыЗапросаКлючаСессииГИСМТРозница.
//  СрокДействия                 - Дата, Неопределено - Срок действия ключа сессии.
//  ОбновлятьКлючСессииНаСервере - Булево - Признак необходимости обновления ключа сессии на сервере.
//
// Возвращаемое значение:
//  Строка, Неопределено - Действующий ключ сессии для организации.
//
Функция ПроверитьОбновитьКлючСессии(ПараметрыЗапроса, Знач СрокДействия = Неопределено, ОбновлятьКлючСессииНаСервере = Истина) Экспорт
	
	КлючСессии = ТекущийКлючСессии(ПараметрыЗапроса, СрокДействия);
	
	ТребуетсяОбновлениеКлючаСессии = (КлючСессии = Неопределено);
	
	Если ТребуетсяОбновлениеКлючаСессии И ОбновитьКлючСессииНаСервере(ПараметрыЗапроса, ОбновлятьКлючСессииНаСервере) Тогда
		КлючСессии = ТекущийКлючСессии(ПараметрыЗапроса);
	КонецЕсли;
	
	Возврат КлючСессии;
	
КонецФункции

Функция ЗапроситьПараметрыАвторизации(ПараметрыЗапроса) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПараметрыАвторизации", Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",          "");
	
	ДанныеЗапроса = ТранспортМДЛПКлиентСервер.ДанныеHTTPЗапроса("GET");
	ДанныеЗапроса.АдресЗапроса = ПараметрыЗапроса.АдресЗапросаПараметровАвторизации;
	ДанныеЗапроса.Заголовки.Вставить("Content-Type"  , "application/json; charset=utf-8");
	ДанныеЗапроса.Заголовки.Вставить("Accept-Charset", "utf-8");
	ДанныеЗапроса.Заголовки.Вставить("Cache-Control" , "no-cache");
	
	ПараметрыПодключения = ТранспортМДЛПКлиентСервер.НовыеПараметрыОтправкиHTTPЗапросов();
	ЗаполнитьЗначенияСвойств(ПараметрыПодключения, ПараметрыЗапроса);
	
	РезультатОтправкиЗапроса = ТранспортМДЛПКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыПодключения, ДанныеЗапроса);
	
	Если РезультатОтправкиЗапроса.Статус = "Ошибка" Тогда
		ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(ДанныеЗапроса.АдресЗапроса, РезультатОтправкиЗапроса);
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ДанныеОтвета = ТранспортМДЛПКлиентСервер.ПреобразоватьJSONВЗначение(РезультатОтправкиЗапроса.ОтветТранспортногоМодуля, Ложь);
	
	Если ДанныеОтвета = Неопределено Тогда
		ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(ДанныеЗапроса.АдресЗапроса, РезультатОтправкиЗапроса);
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ПараметрыАвторизации = ПараметрыАвторизации();
	ПараметрыАвторизации.Идентификатор = ДанныеОтвета.uuid;
	ПараметрыАвторизации.Данные        = ДанныеОтвета.data;
	
	ВозвращаемоеЗначение.ПараметрыАвторизации = ПараметрыАвторизации;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ЗапроситьКлючиСессий(ПараметрыЗапросовПоОрганизациям) Экспорт
	
	ВозвращаемоеЗначение = Новый Соответствие;
	
	Для Каждого ПараметрыЗапросаПоОрганизации Из ПараметрыЗапросовПоОрганизациям Цикл
		
		РезультатЗапросаКлючаСессии = ЗапроситьКлючСессии(ПараметрыЗапросаПоОрганизации);
		
		Если РезультатЗапросаКлючаСессии.ПараметрыКлючаСессии <> Неопределено Тогда
			
			УстановитьКлючСессии(ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса, РезультатЗапросаКлючаСессии.ПараметрыКлючаСессии);
			
			// Ключ сессии обновлен
			ВозвращаемоеЗначение.Вставить(ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса.Организация, Истина);
			
		Иначе
			
			// Ключ сессии не обновлен
			ВозвращаемоеЗначение.Вставить(ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса.Организация, РезультатЗапросаКлючаСессии.ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция СертификатыДляПодписанияНаСервере() Экспорт
	
	СертификатыДляПодписанияНаСервере = ОбщегоНазначенияИС.СертификатыДляПодписанияНаСервере();
	Если СертификатыДляПодписанияНаСервере <> Неопределено
		И СертификатыДляПодписанияНаСервере.Сертификаты.Количество() > 0 Тогда
		
		Организации = СертификатыДляПодписанияНаСервере.Сертификаты.Скопировать(, "Организация");
		Организации.Свернуть("Организация");
		
		Для Каждого ТекОрганизация Из Организации Цикл
			ОрганизацияМДЛП = ИнтеграцияМДЛПВызовСервера.ОрганизацияМДЛППоОрганизации(ТекОрганизация.Организация);
			Если ЗначениеЗаполнено(ОрганизацияМДЛП) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаСертификата = СертификатыДляПодписанияНаСервере.Сертификаты.Найти(ТекОрганизация.Организация, "Организация");
			Если СтрокаСертификата <> Неопределено Тогда
				НоваяСтрока = СертификатыДляПодписанияНаСервере.Сертификаты.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСертификата);
				НоваяСтрока.Организация = ОрганизацияМДЛП;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СертификатыДляПодписанияНаСервере;
	
КонецФункции

#КонецОбласти // Авторизация


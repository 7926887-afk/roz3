#Область Авторизация

// Возвращает структуру данных запроса авторизации
//
// Возвращаемое значение:
//  Структура - Параметры авторизации:
//  * Идентификатор        - Строка - Идентификатор запроса
//  * Данные               - Строка - Данные для подписания
//  * UnitedToken - Булево - Признак возможности получения единого токена
//  * ИНН                  - Строка - ИНН для подписания МЧД
//
Функция ПараметрыАвторизации()
	
	ПараметрыАвторизации = Новый Структура;
	ПараметрыАвторизации.Вставить("Идентификатор", "");
	ПараметрыАвторизации.Вставить("Данные"       , "");
	
	Возврат ПараметрыАвторизации;
	
КонецФункции

// Возвращает текущий ключ сессии для обмена с ГИС МТ.
//
// Параметры:
//  ПараметрыЗапроса - (См. РазрешительныйРежимМДЛПКлиентСервер.ПараметрыЗапросаКлючаСессииГИСМТРозница).
//  СрокДействия - Дата, Неопределено - Срок действия ключа сессии.
//
// Возвращаемое значение:
//  Строка, Неопределено - Действующий ключ сессии для организации.
//
Функция ТекущийКлючСессии(ПараметрыЗапроса, Знач СрокДействия = Неопределено)
	
	Попытка
		ДанныеКлючаСессии = ПараметрыСеанса[ПараметрыЗапроса.ИмяПараметраКлючаСессии].Получить();
	Исключение
		ДанныеКлючаСессии = Неопределено;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ДанныеКлючаСессии) Тогда
		ДанныеКлючаСессии = РегистрыСведений.ДанныеКлючаСессииМДЛП.ПолучитьСохраненныеДанныеКлючаСессии(ПараметрыЗапроса.ИмяПараметраКлючаСессии);
	КонецЕсли;
	
	// Ключ сессии еще не установлен
	Если ДанныеКлючаСессии = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеКлючаСессииДляОрганизации = АктуальныеПараметрыКлючаСессии(ПараметрыЗапроса, ДанныеКлючаСессии, СрокДействия);
	
	Если ДанныеКлючаСессииДляОрганизации = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючСессии = ДанныеКлючаСессииДляОрганизации.КлючСессии;
	
	Если ДанныеКлючаСессииДляОрганизации.Свойство("ИНН")
		И Не ЗначениеЗаполнено(ПараметрыЗапроса.ИНН)
		И ЗначениеЗаполнено(ДанныеКлючаСессииДляОрганизации.ИНН) Тогда
		ПараметрыЗапроса.ИНН = ДанныеКлючаСессииДляОрганизации.ИНН;
	КонецЕсли;
	
	Возврат КлючСессии;
	
КонецФункции

Функция ОбновитьКлючСессииНаСервере(ПараметрыЗапроса, ОбновлятьКлючСессииНаСервере = Истина)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СохраненныеДанныеКлючаСессии = РегистрыСведений.ДанныеКлючаСессииМДЛП.ПолучитьСохраненныеДанныеКлючаСессии(ПараметрыЗапроса.ИмяПараметраКлючаСессии);
	
	Если СохраненныеДанныеКлючаСессии <> Неопределено Тогда
		
		ПараметрыКлючаСессии = АктуальныеПараметрыКлючаСессии(ПараметрыЗапроса, СохраненныеДанныеКлючаСессии);
		
		Если ПараметрыКлючаСессии <> Неопределено Тогда
			
			УстановитьКлючСессии(ПараметрыЗапроса, ПараметрыКлючаСессии, Ложь);
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ОбновлятьКлючСессииНаСервере Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СертификатыДляПодписанияНаСервере = СертификатыДляПодписанияНаСервере();
	Если СертификатыДляПодписанияНаСервере = Неопределено
		Или СертификатыДляПодписанияНаСервере.Сертификаты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РезультатЗапроса = ЗапроситьПараметрыАвторизации(ПараметрыЗапроса);
	Если РезультатЗапроса.ПараметрыАвторизации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыЗапроса.Организация = Неопределено Тогда
		СтрокаСертификата = СертификатыДляПодписанияНаСервере.Сертификаты[0];
	Иначе
		СтрокаСертификата = СертификатыДляПодписанияНаСервере.Сертификаты.Найти(ПараметрыЗапроса.Организация, "Организация");
	КонецЕсли;
	
	Если СтрокаСертификата <> Неопределено Тогда
		
		// Для авторизации требуется прикрепленная подпись
		ПараметрыCMS = ЭлектроннаяПодпись.ПараметрыCMS();
		ПараметрыCMS.Открепленная = Ложь;
		
		Если СертификатыДляПодписанияНаСервере.МенеджерКриптографии <> Неопределено Тогда
			СертификатыДляПодписанияНаСервере.МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = СтрокаСертификата.Пароль;
		КонецЕсли;
		
		РезультатПодписания = Подписать(
			РезультатЗапроса.ПараметрыАвторизации.Данные,
			ПараметрыCMS,
			СтрокаСертификата.СертификатКриптографии,
			СертификатыДляПодписанияНаСервере.МенеджерКриптографии);
		
	КонецЕсли;
	
	Если СтрокаСертификата = Неопределено
		Или Не РезультатПодписания.Успех Тогда
		
		Возврат Ложь;
		
	Иначе
		
		Возврат ЗапроситьУстановитьКлючСессии(
			ПараметрыЗапроса,
			РезультатЗапроса.ПараметрыАвторизации,
			РезультатПодписания.Подпись).КлючСессииУстановлен;
		
	КонецЕсли;
	
КонецФункции

Функция АктуальныеПараметрыКлючаСессии(ПараметрыЗапроса, ДанныеКлючаСессии, СрокДействия = Неопределено)
	
	Если СрокДействия = Неопределено Тогда
		
		Таймаут      = 60;
		СрокДействия = ТекущаяУниверсальнаяДата() + Таймаут;
		
	КонецЕсли;
	
	Если ПараметрыЗапроса.Организация <> Неопределено Тогда
		
		ПараметрыКлючаСессии = ДанныеКлючаСессии.Получить(ПараметрыЗапроса.Организация);
		
		Если ПараметрыКлючаСессии = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Ключ сессии устарел
		Если ПараметрыЗапроса.ИмяПараметраКлючаСессии = РазрешительныйРежимМДЛПКлиентСервер.ИмяДанныхКлючаСессии(Перечисления.ТипыТокеновАвторизацииМДЛП.ГИСМТРозница) Тогда
			
			Если РазрешительныйРежимМДЛПКлиентСервер.ДатаДействияТокенаГИСМТРозница() <= СрокДействия Тогда
				Возврат Неопределено; 
			КонецЕсли;
			
		ИначеЕсли ПараметрыКлючаСессии.ДействуетДо <= СрокДействия Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		Для Каждого КлючИЗначение Из ДанныеКлючаСессии Цикл
			
			Если КлючИЗначение.Значение.ДействуетДо > СрокДействия Тогда
				
				ПараметрыКлючаСессии = КлючИЗначение.Значение;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПараметрыКлючаСессии;
	
КонецФункции

Процедура УстановитьКлючСессии(ПараметрыЗапроса, ПараметрыКлючаСессии, ЗаписатьВРегистр = Истина) Экспорт // ор ++
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗаписатьВРегистр Тогда
		
		РегистрыСведений.ДанныеКлючаСессииМДЛП.УстановитьКлючСессии(ПараметрыЗапроса, ПараметрыКлючаСессии);
		
	Иначе
		
		Попытка
			ДанныеКлючаСессии = ПараметрыСеанса[ПараметрыЗапроса.ИмяПараметраКлючаСессии].Получить();
		Исключение
			ДанныеКлючаСессии = Неопределено;
		КонецПопытки;
		
		Если ДанныеКлючаСессии = Неопределено Тогда
			ДанныеКлючаСессии = Новый Соответствие;
		КонецЕсли;
		
		Если ПараметрыКлючаСессии.КлючСессии = "" Или ПараметрыКлючаСессии.ДействуетДо = Дата(1,1,1) Тогда
			ДанныеКлючаСессии.Удалить(ПараметрыЗапроса.Организация);
		Иначе
			ДанныеКлючаСессии.Вставить(ПараметрыЗапроса.Организация, ПараметрыКлючаСессии);
		КонецЕсли;
		
		СохраняемыеДанные = Новый ХранилищеЗначения(ДанныеКлючаСессии);
		
		ПараметрыСеанса[ПараметрыЗапроса.ИмяПараметраКлючаСессии] = СохраняемыеДанные;
		
	КонецЕсли;
	
КонецПроцедуры

Функция Подписать(ДанныеДляПодписания, ПараметрыCMS, СертификатКриптографии, МенеджерКриптографии)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Успех");
	ВозвращаемоеЗначение.Вставить("Подпись");
	ВозвращаемоеЗначение.Вставить("ТекстОшибки");
	
	Попытка
		
		Подпись = ЭлектроннаяПодписьСлужебный.ПодписатьCMS(
			ДанныеДляПодписания,
			ПараметрыCMS,
			СертификатКриптографии, МенеджерКриптографии);
		
		ВозвращаемоеЗначение.Успех   = Истина;
		ВозвращаемоеЗначение.Подпись = Подпись;
		
	Исключение
		
		ВозвращаемоеЗначение.Успех       = Ложь;
		ВозвращаемоеЗначение.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ЗапроситьУстановитьКлючСессии(ПараметрыЗапроса, ПараметрыАвторизации, Подпись)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("КлючСессииУстановлен", Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",          "");
	
	СвойстваПодписи = Новый Структура("Подпись", Подпись);
	
	ПараметрыЗапросаПоОрганизации = Новый Структура;
	ПараметрыЗапросаПоОрганизации.Вставить("ПараметрыЗапроса",     ПараметрыЗапроса);
	ПараметрыЗапросаПоОрганизации.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ПараметрыЗапросаПоОрганизации.Вставить("СвойстваПодписи",      СвойстваПодписи);
	
	РезультатЗапросаКлючаСессии = ЗапроситьКлючСессии(ПараметрыЗапросаПоОрганизации);
	Если РезультатЗапросаКлючаСессии.ПараметрыКлючаСессии <> Неопределено Тогда
		
		УстановитьКлючСессии(ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса, РезультатЗапросаКлючаСессии.ПараметрыКлючаСессии);
		
		ВозвращаемоеЗначение.КлючСессииУстановлен = Истина;
		
		Возврат ВозвращаемоеЗначение;
		
	Иначе
		
		ВозвращаемоеЗначение.КлючСессииУстановлен = Ложь;
		ВозвращаемоеЗначение.ТекстОшибки          = РезультатЗапросаКлючаСессии.ТекстОшибки;
		
		Возврат ВозвращаемоеЗначение;
		
	КонецЕсли;
	
КонецФункции

Функция ЗапроситьКлючСессии(ПараметрыЗапросаПоОрганизации)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПараметрыКлючаСессии", Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",          "");
	
	АдресЗапроса = ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса.АдресЗапросаКлючаСессии;
	
	ДанныеЗапроса = ТранспортМДЛПКлиентСервер.ДанныеHTTPЗапроса("POST");
	ДанныеЗапроса.АдресЗапроса = АдресЗапроса;
	
	ДанныеЗапроса.ТелоЗапроса = Новый Структура;
	ДанныеЗапроса.ТелоЗапроса.Вставить("data", ИнтеграцияМДЛПКлиентСервер.ДвоичныеДанныеBase64(ТранспортМДЛПАПИКлиентСервер.ПодписьИзСвойствПодписи(ПараметрыЗапросаПоОрганизации)));
	
	ИНН = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса, "ИНН");
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса, "Организация");
		Если ЗначениеЗаполнено(Организация) Тогда
			ИНН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ИНН");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		ДанныеЗапроса.ТелоЗапроса.Вставить("inn", ИНН);
	КонецЕсли;
	
	ДанныеЗапроса.Заголовки.Вставить("Content-Type"  , "application/json; charset=utf-8");
	ДанныеЗапроса.Заголовки.Вставить("Accept-Charset", "utf-8");
	
	ПараметрыПодключения = ТранспортМДЛПКлиентСервер.НовыеПараметрыОтправкиHTTPЗапросов();
	ЗаполнитьЗначенияСвойств(ПараметрыПодключения, ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса);
	
	ТипТокенаАвторизации = РазрешительныйРежимМДЛПКлиентСервер.ТипТокенаАвторизацииПоИмениДанныхКлючаСессии(ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса.ИмяПараметраКлючаСессии);
	Если ТипТокенаАвторизации = Перечисления.ТипыТокеновАвторизацииМДЛП.ГИСМТРозница Тогда
		ПараметрыПодключения.Адрес = РазрешительныйРежимМДЛПКлиентСервер.АдресСервера(Истина, Истина);
	КонецЕсли;
	
	РезультатОтправкиЗапроса = ТранспортМДЛПКлиентСервер.ВыполнитьHTTPЗапрос(ПараметрыПодключения, ДанныеЗапроса);
	
	Если РезультатОтправкиЗапроса.Статус = "Ошибка" Тогда
		ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(АдресЗапроса, РезультатОтправкиЗапроса);
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ДанныеОтвета = ТранспортМДЛПКлиентСервер.ПреобразоватьJSONВЗначение(РезультатОтправкиЗапроса.ОтветТранспортногоМодуля, Ложь);
	
	Если ДанныеОтвета = Неопределено Или Не ДанныеОтвета.Свойство("access_token") Тогда
		ВозвращаемоеЗначение.ТекстОшибки = РазрешительныйРежимМДЛПКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(АдресЗапроса, РезультатОтправкиЗапроса);
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	Если ТипТокенаАвторизации = Перечисления.ТипыТокеновАвторизацииМДЛП.ГИСМТРозница Тогда
		КлючСессии  = ДанныеОтвета.access_token;
		ДействуетДо = ТекущаяУниверсальнаяДата() + ДанныеОтвета.expires_in;
	КонецЕсли;
	
	ПараметрыКлючаСессии = ПараметрыКлючаСессии();
	ПараметрыКлючаСессии.ИНН         = ИНН;
	ПараметрыКлючаСессии.КлючСессии  = КлючСессии;
	ПараметрыКлючаСессии.ДействуетДо = ДействуетДо;
	
	ВозвращаемоеЗначение.ПараметрыКлючаСессии = ПараметрыКлючаСессии;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти // Авторизация

#КонецОбласти // СлужебныеПроцедурыИФункции

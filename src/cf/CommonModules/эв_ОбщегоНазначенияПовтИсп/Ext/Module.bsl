
#Область ПрограммныйИнтерфейс

  
// Признак базы офиса. Читается без проверки прав на константу.
// Значение кэшируется на время сеанса.
//
// Возвращаемое значение:
//  Булево - Истина, если это база офиса.
//
Функция ЭтоБазаОфиса() Экспорт
    
    УстановитьПривилегированныйРежим(Истина); 
    эв_ЭтоБазаОфиса = Константы.эв_ЭтоБазаОфиса.Получить();
    УстановитьПривилегированныйРежим(Ложь);

    Возврат эв_ЭтоБазаОфиса;
    
КонецФункции

Функция ОсновнойСклад() Экспорт
    
    УстановитьПривилегированныйРежим(Истина); 
    ОсновнойСклад = Справочники.СтруктурныеЕдиницы.ОсновнойСклад();
    УстановитьПривилегированныйРежим(Ложь);

    Возврат ОсновнойСклад;
    
КонецФункции



#КонецОбласти
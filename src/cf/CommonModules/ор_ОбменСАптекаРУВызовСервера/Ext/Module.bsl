#Область СлужебныеПроцедурыИФункции

Функция ОбъектВТекстJSON(Структура, УдалитьПробелыИПереносыСтрок = Ложь)
	
	ТекстJSON = "";
	
	Если УдалитьПробелыИПереносыСтрок Тогда
		ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "");
	Иначе
		ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписатьJSON(ЗаписьJSON, Структура);
	
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Возврат ТекстJSON;
	
КонецФункции

Функция ТекстJSONВОбъект(ТекстJSON, ПреобразовыватьВСоответствие = Ложь)
	
	РезультатРазбора = Неопределено;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	
	Попытка
		РезультатРазбора = ПрочитатьJSON(Чтение, ПреобразовыватьВСоответствие);
	Исключение
		РезультатРазбора = Неопределено;
	КонецПопытки;
	
	Возврат РезультатРазбора;
	
КонецФункции

Функция ОбновитьТекущийСтатусЗаказаНаОснованииОтветаСервиса(МассивЗаказов, МассивОтвета, ВозвращаемоеЗначение, Действие, СоответствиеЗаказНомер)
	
	ТекущиеСтатусыЗаказов = ПолучитьТекущиеСтатусыЗаказов(МассивЗаказов);
	
	Для Каждого ЭлементОтвета Из МассивОтвета Цикл
		
		СтатусАптекаРУ   = ЭлементОтвета.status;
		СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.ПустаяСсылка();
		
		Если СтатусАптекаРУ = "Success" Тогда
			СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.Success;
		ИначеЕсли СтатусАптекаРУ = "Conflict" Тогда
			СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.Conflict;
		ИначеЕсли СтатусАптекаРУ = "Unknown" Тогда
			СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.Unknown;
		ИначеЕсли СтатусАптекаРУ = "NotFound" Тогда
			СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.NotFound;
		ИначеЕсли СтатусАптекаРУ = "AlreadyReported" Тогда
			СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.AlreadyReported;
		КонецЕсли;
		
		ЗаказПокупателя = СоответствиеЗаказНомер.Получить(ЭлементОтвета.orderNum);
		Если ЗаказПокупателя = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтатусОбмена = СформироватьФактическийСтатусОбменаЗаказа(ЗаказПокупателя, Действие, СтатусАптекаРуИБ, ТекущиеСтатусыЗаказов);
		
		// В случае, если по измерению ЗаказПокупателя уже есть запись, она будет замещена новой.
		МенеджерЗаписи = РегистрыСведений.ор_СтатусыИнформированияАптекаРУ.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
		МенеджерЗаписи.СтатусОбмена    = СтатусОбмена;
		МенеджерЗаписи.СтатусАптекаРУ  = СтатусАптекаРуИБ;
		
		Если ЭлементОтвета.Свойство("errorMessage")
			И Не (СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.Success) Тогда
			МенеджерЗаписи.СообщениеОбОшибке = СтрШаблон(НСтр("ru = '%1.%2'"), Строка(СтатусАптекаРуИБ), ЭлементОтвета.errorMessage);
		КонецЕсли;
		
		МенеджерЗаписи.Записать();
		
		ВозвращаемоеЗначение.СообщениеСервисаДляЭлемента = МенеджерЗаписи.СообщениеОбОшибке;
		
		ВозвращаемоеЗначение.ПредставлениеСтатуса = СформироватьПредставлениеСтатусаЗаказа(СтатусОбмена);
		ВозвращаемоеЗначение.СтатусОбмена         = СтатусОбмена;
	КонецЦикла;
	
КонецФункции

Функция СформироватьФактическийСтатусОбменаЗаказа(ЗаказПокупателя, Действие, СтатусАптекаРуИБ, ТекущиеСтатусыЗаказов)
	
	// Если передача успешна, вставляем статус текущей операции.
	Если СтатусАптекаРуИБ = Перечисления.ор_СтатусыИнформированияАптекаРУ.Success Тогда
		Если НРег(Действие) = НРег("ПередатьДанныеОПривезенномЗаказе") Тогда
			СтатусОбмена =  Перечисления.ор_СтатусыОбменаАптекаРУ.Принят;
		ИначеЕсли НРег(Действие) = НРег("ПередатьДанныеОГотовностиКВыдачеЗаказа") Тогда
			СтатусОбмена =  Перечисления.ор_СтатусыОбменаАптекаРУ.ГотовКВыдаче;
		ИначеЕсли НРег(Действие) = НРег("ПередатьДанныеОВыкупленномЗаказе") Тогда
			СтатусОбмена =  Перечисления.ор_СтатусыОбменаАптекаРУ.Продан;
		ИначеЕсли НРег(Действие) = НРег("ПередатьДанныеОВозвращенномЗаказе") Тогда
			СтатусОбмена = Перечисления.ор_СтатусыОбменаАптекаРУ.Возвращен;
		КонецЕсли;
		Возврат СтатусОбмена;
	КонецЕсли;
	
	Статус = ПолучитьТекущийСтатусЗаказа(ЗаказПокупателя, ТекущиеСтатусыЗаказов).СтатусОбмена;
	Возврат Статус;
	
КонецФункции

#КонецОбласти

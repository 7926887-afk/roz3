
#Область СлужебныеПроцедурыИФункции

// Функция возвращает флаг серийного учета по характеристике
//
// Параметры
//  Владелец - <СправочникСсылка.Номенклатура>, <СправочникСсылка.ВидыНоменклатуры> -
//             владелец характеристики, для которой проверяется ведение серийного учета.
//
// Возвращаемое значение:
// Булево. Истина - серийный учет по характеристикам ведется, иначе ложь.
//
Функция ПолучитьФлагСерийногоУчета(Владелец) Экспорт
	
	Если ТипЗнч(Владелец)=Тип("СправочникСсылка.Номенклатура") Тогда
		КатегорияНоменклатуры = Владелец.КатегорияНоменклатуры;
	ИначеЕсли ТипЗнч(Владелец)=Тип("СправочникСсылка.КатегорииНоменклатуры") Тогда
		КатегорияНоменклатуры = Владелец;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Возврат КатегорияНоменклатуры.ор_ВестиСерийныйУчет;
	
КонецФункции // ПолучитьФлагСерийногоУчета()

// Процедура формирует наименование объекта для серийного учета
//
// Параметры:
//  СерияПроизводителя - Строка - серия производителя лекарственного средства
//  СрокГодности - Дата - дата окончания срока годности лекарственного средства
//
// Возвращаемое значение:
// Строка - Наименование
//
Функция СформироватьНаименованиеСерии(СерияПроизводителя, СрокГодности) Экспорт
	
	Строка = "";
	// Формируем наименование в зависимости от заполненных реквизитов
	// серия производителя
	Если ЗначениеЗаполнено(СерияПроизводителя) Тогда
		Строка=Строка+" "+СокрЛП(СерияПроизводителя);
	КонецЕсли;
	// срок годности
	Если ЗначениеЗаполнено(СрокГодности) Тогда
		Строка=Строка+", "+Формат(СрокГодности,"ДФ=dd.MM.yyyy");
	КонецЕсли;
	// обрежем лишние пробелы
	Строка=СокрЛП(Строка);
	// проверяем, что получилось
	Если ПустаяСтрока(Строка) Тогда
		Строка="<не заполнены реквизиты>";
	КонецЕсли;
	// вернем результат
	Возврат Строка;
	
КонецФункции // СформироватьНаименованиеСерии()

#КонецОбласти

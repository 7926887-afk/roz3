	ПараметрыОтправки.ПараметрыURL.Вставить("columns", МассивКолонок);
	
	НужнаИтерация = Истина;
	КоличествоПолучено = 0;
	
	Пока НужнаИтерация Цикл
		
		НужнаИтерация = Ложь;
		
		ДанныеСправочника = ВыполнитьЗапросНСИ(ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыОтправки));
		
		Если ДанныеСправочника.Код <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДанныеСправочника.Описание);
			Возврат;
		КонецЕсли;
		
		КоличествоПолучено = КоличествоПолучено + ДанныеСправочника.Данные.list.Количество(); 
		
		Для Каждого ЭлементСправочника Из ДанныеСправочника.Данные.list Цикл
			
			СтруктураСтроки = Новый Структура;
			
			Для Каждого Колонка Из ЭлементСправочника Цикл
				ИмяКолонки = ВРег(Колонка.column);
				Если ИмяКолонки = ВРег("DosageFormFullName") Тогда
					СтруктураСтроки.Вставить("НаименованиеПолное", Колонка.value);
				ИначеЕсли ИмяКолонки = ВРег("BasicDoseForm") Тогда
					СтруктураСтроки.Вставить("БазоваяЛФ", Колонка.value);
				КонецЕсли;
			КонецЦикла;
			
			// Проверка на уникальность.
			Если СтруктураСтроки.Свойство("БазоваяЛФ")
				И ЗначениеЗаполнено(СтруктураСтроки.БазоваяЛФ) Тогда
				СтрокаБазоваяЛФ = Дерево.Строки.Найти(СтруктураСтроки.БазоваяЛФ, "Наименование", Истина);
				СтрокаПодчиненнаяЛФ = Дерево.Строки.Найти(СтруктураСтроки.НаименованиеПолное, "Наименование", Истина);
				Если ЗначениеЗаполнено(СтрокаБазоваяЛФ) И НЕ ЗначениеЗаполнено(СтрокаПодчиненнаяЛФ) Тогда
					НоваяСтрока = СтрокаБазоваяЛФ.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
					НоваяСтрока.Наименование = СтруктураСтроки.НаименованиеПолное;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		// Если получено не все, то инкрементируем номер страницы и получаем еще раз.
		Если КоличествоПолучено < ДанныеСправочника.Данные.total Тогда
			НужнаИтерация = Истина;
			ТекущаяСтраница = ПараметрыОтправки.ПараметрыURL.Получить("page");
			ПараметрыОтправки.ПараметрыURL.Вставить("page", ?(ТекущаяСтраница = Неопределено, 0, ТекущаяСтраница) + 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеСМННИзСервиса(Дерево)
	
	// Проверка на заполненость токена.
	ТокенПользователя = Константы.ор_ТокенПользователяНСИ.Получить();
	Если Не ЗначениеЗаполнено(ТокенПользователя) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Для загрузки данных из НСИ необходимо указать токен пользователя.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОтправки = ПараметрыОтправкиЗапросаНСИ();
	
	ПараметрыОтправки.ПараметрыURL.Вставить("userKey", СокрЛП(ТокенПользователя));
	ПараметрыОтправки.ПараметрыURL.Вставить("identifier", "1.2.643.5.1.13.13.99.2.611");
	
	ПараметрыОтправки.ПараметрыURL.Вставить("page", 1);
	
	// 10000 записей - максимум что может вернуть сайт в одном запросе.
	ПараметрыОтправки.ПараметрыURL.Вставить("size", 10000);
	
	НужнаИтерация = Истина;
	КоличествоПолучено = 0;
	
	Пока НужнаИтерация Цикл
		
		НужнаИтерация = Ложь;
		
		ДанныеСправочника = ВыполнитьЗапросНСИ(ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыОтправки));
		
		Если ДанныеСправочника.Код <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДанныеСправочника.Описание);
			Возврат;
		КонецЕсли;
		
		КоличествоПолучено = КоличествоПолучено + ДанныеСправочника.Данные.list.Количество(); 
		
		Для Каждого ЭлементСправочника Из ДанныеСправочника.Данные.list Цикл
			
			СтруктураСтроки = Новый Структура;
			
			Для Каждого Колонка Из ЭлементСправочника Цикл
				ИмяКолонки = ВРег(Колонка.column);
				Если ИмяКолонки ="SMNN_CODE" Тогда
					СтруктураСтроки.Вставить("КодЕСКЛП", Колонка.value);
				ИначеЕсли ИмяКолонки = "STANDARD_INN" Тогда
					СтруктураСтроки.Вставить("СтандартизированноеМНН", Колонка.value);
				ИначеЕсли ИмяКолонки = "STANDARD_FORM" Тогда
					СтруктураСтроки.Вставить("СтандартизированнаяЛекарственнаяФорма", Колонка.value);
				ИначеЕсли ИмяКолонки = "STANDARD_DOZE" Тогда
					СтруктураСтроки.Вставить("СтандартизированнаяЛекарственнаяДоза", Колонка.value);
				ИначеЕсли ИмяКолонки = "KTRU_CODE" Тогда
					СтруктураСтроки.Вставить("КодКТРУ", Колонка.value);
				ИначеЕсли ИмяКолонки = "NAME_UNIT" Тогда
					СтруктураСтроки.Вставить("НаименованиеПотребительскойЕдиницыИзмерения", Колонка.value);
				ИначеЕсли ИмяКолонки = "OKEI_CODE" Тогда
					СтруктураСтроки.Вставить("КодОКЕИ", Колонка.value);
				ИначеЕсли ИмяКолонки = "OKPD_2_CODE" Тогда
					СтруктураСтроки.Вставить("КодОКПД2", Колонка.value);
				ИначеЕсли ИмяКолонки = "ESSENTIAL_MEDICINES" Тогда
					СтруктураСтроки.Вставить("ЖНВЛП", Колонка.value);
				ИначеЕсли ИмяКолонки = "NARCOTIC_PSYCHOTROPIC" Тогда
					СтруктураСтроки.Вставить("НаличиеВЛПНаркотическихПсихотропныхВеществИИхПрекурсоров", Колонка.value);
				ИначеЕсли ИмяКолонки = "CODE_ATC" Тогда
					СтруктураСтроки.Вставить("КодАТХ", Колонка.value);
				ИначеЕсли ИмяКолонки = "NAME_ATC" Тогда
					СтруктураСтроки.Вставить("НаименованиеАТХ", Колонка.value);
				ИначеЕсли ИмяКолонки = "TN" Тогда
					СтруктураСтроки.Вставить("НаименованиеФТГ", Колонка.value);
				КонецЕсли;
			КонецЦикла;
			
			// Проверка на уникальность.
			НайденнаяСтрока = Дерево.Строки.Найти(СтруктураСтроки.КодЕСКЛП, "КодЕСКЛП", Истина);
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока) Тогда
				СтрокаДерева = Дерево.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(
					СтрокаДерева,
					СтруктураСтроки,,
					"ЖНВЛП,НаличиеВЛПНаркотическихПсихотропныхВеществИИхПрекурсоров");
				СтрокаДерева.ЖНВЛП = ?(НРег(СтруктураСтроки.ЖНВЛП) = "да", Истина, Ложь);
				СтрокаДерева.НаличиеВЛПНаркотическихПсихотропныхВеществИИхПрекурсоров = ?(
					НРег(СтруктураСтроки.НаличиеВЛПНаркотическихПсихотропныхВеществИИхПрекурсоров) = "да",
					Истина,
					Ложь);
			КонецЕсли;
		КонецЦикла;
		
		// Если получено не все, то инкрементируем номер страницы и получаем еще раз.
		Если КоличествоПолучено < ДанныеСправочника.Данные.total Тогда
			НужнаИтерация = Истина;
			ТекущаяСтраница = ПараметрыОтправки.ПараметрыURL.Получить("page");
			ПараметрыОтправки.ПараметрыURL.Вставить("page", ?(ТекущаяСтраница = Неопределено, 0, ТекущаяСтраница) + 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


Процедура ЗаполнитьДанныеЛекарственныхФормИзФайла(Дерево, ФайлСБазовымиЛФ = Неопределено, ФайлСПодчиненнымиЛФ = Неопределено)
	
	// Записываем в дерево базовые ЛФ.
	ЧтениеКлассификаторБазовые = Новый ЧтениеXML;
	Если ФайлСБазовымиЛФ = Неопределено Тогда
		МакетКлассификатор = Справочники.ор_ЛекарственныеФормы.ПолучитьМакет("КлассификаторБазовые");
		ЧтениеКлассификаторБазовые.УстановитьСтроку(МакетКлассификатор.ПолучитьТекст());
	Иначе
		ЧтениеКлассификаторБазовые.ОткрытьФайл(ФайлСБазовымиЛФ);
	КонецЕсли;
	
	ОбработкаРеквизитов = Ложь;
	Пока ЧтениеКлассификаторБазовые.Прочитать() Цикл
		
		Если ЧтениеКлассификаторБазовые.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификаторБазовые.Имя = "entry" Тогда
			СтруктураСтроки = Новый Структура;
			ОбработкаРеквизитов = Истина;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ОбработкаРеквизитов Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеКлассификаторБазовые.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификаторБазовые.Имя = "BasicDoseForm" Тогда
			ЧтениеКлассификаторБазовые.Прочитать();
			СтруктураСтроки.Вставить("Наименование", ЧтениеКлассификаторБазовые.Значение);
			ЧтениеКлассификаторБазовые.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификаторБазовые.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификаторБазовые.Имя = "BasicDoseForm_LAT" Тогда
			ЧтениеКлассификаторБазовые.Прочитать();
			СтруктураСтроки.Вставить("НаименованиеЛатынь", ЧтениеКлассификаторБазовые.Значение);
			ЧтениеКлассификаторБазовые.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификаторБазовые.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеКлассификаторБазовые.Имя = "entry" Тогда
			СтрокаБазоваяЛФ = Дерево.Строки.Найти(СтруктураСтроки.Наименование, "Наименование", Истина);
			Если НЕ ЗначениеЗаполнено(СтрокаБазоваяЛФ) Тогда
				СтрокаДерева = Дерево.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктураСтроки);
			КонецЕсли;
			ОбработкаРеквизитов = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// Записываем в дерево подчиненные ЛФ.
	ЧтениеКлассификатор = Новый ЧтениеXML;
	Если ФайлСПодчиненнымиЛФ = Неопределено Тогда
		МакетКлассификатор = Справочники.ор_ЛекарственныеФормы.ПолучитьМакет("Классификатор");
		ЧтениеКлассификатор.УстановитьСтроку(МакетКлассификатор.ПолучитьТекст());
	Иначе
		ЧтениеКлассификатор.ОткрытьФайл(ФайлСПодчиненнымиЛФ);
	КонецЕсли;
	
	ОбработкаРеквизитов = Ложь;
	Пока ЧтениеКлассификатор.Прочитать() Цикл
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификатор.Имя = "entry" Тогда
			СтруктураЭлемента = Новый Структура;
			ОбработкаРеквизитов = Истина;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ОбработкаРеквизитов Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификатор.Имя = "DosageFormFullName" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураЭлемента.Вставить("НаименованиеПолное", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификатор.Имя = "BasicDoseForm" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураЭлемента.Вставить("БазоваяЛФ", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеКлассификатор.Имя = "entry" Тогда
			Если СтруктураЭлемента.Свойство("БазоваяЛФ")
				И ЗначениеЗаполнено(СтруктураЭлемента.БазоваяЛФ) Тогда
				СтрокаБазоваяЛФ = Дерево.Строки.Найти(СтруктураЭлемента.БазоваяЛФ, "Наименование", Истина);
				СтрокаПодчиненнаяЛФ = Дерево.Строки.Найти(СтруктураЭлемента.НаименованиеПолное, "Наименование", Истина);
				Если ЗначениеЗаполнено(СтрокаБазоваяЛФ) И НЕ ЗначениеЗаполнено(СтрокаПодчиненнаяЛФ) Тогда
					НоваяСтрока = СтрокаБазоваяЛФ.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураЭлемента);
					НоваяСтрока.Наименование = СтруктураЭлемента.НаименованиеПолное;
				КонецЕсли;
			КонецЕсли;
			ОбработкаРеквизитов = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеСМННИзФайла(Дерево, ФайлСДанными = Неопределено)
	
	Если ФайлСДанными = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеКлассификатор = Новый ЧтениеXML;
	ЧтениеКлассификатор.ОткрытьФайл(ФайлСДанными);
	
	ОбработкаРеквизитов = Ложь;
	Пока ЧтениеКлассификатор.Прочитать() Цикл
		
		ИмяЭлементаВРег = ВРег(ЧтениеКлассификатор.Имя);
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "ENTRY" Тогда
			СтруктураСтроки = Новый Структура;
			ОбработкаРеквизитов = Истина;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ОбработкаРеквизитов Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "SMNN_CODE" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("КодЕСКЛП", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "STANDARD_INN" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("СтандартизированноеМНН", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "STANDARD_FORM" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("СтандартизированнаяЛекарственнаяФорма", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "STANDARD_DOZE" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("СтандартизированнаяЛекарственнаяДоза", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "KTRU_CODE" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("КодКТРУ", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "NAME_UNIT" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("НаименованиеПотребительскойЕдиницыИзмерения", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "OKEI_CODE" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("КодОКЕИ", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "OKPD_2_CODE" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("КодОКПД2", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ИмяЭлементаВРег = "ESSENTIAL_MEDICINES" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("ЖНВЛП", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СкопироватьУзелДерева(СтрокиПолучателя, УзелИсточник)
	НоваяСтрока = СтрокиПолучателя.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, УзелИсточник);
	Для Каждого Строка Из УзелИсточник.Строки Цикл
		СкопироватьУзелДерева(НоваяСтрока.Строки, Строка);
	КонецЦикла;
КонецПроцедуры

Функция ПараметрыОтправкиЗапросаНСИ(Знач ИмяКоманды = "port/rest/data", Метод = "GET")
	
	Параметры = ОтправкаЗапросов.НовыйПараметрыОтправки(Метод);
	
	ИмяКоманды = СокрЛП(ИмяКоманды);
	Если Не ПустаяСтрока(ИмяКоманды)
		И Не СтрНачинаетсяС(ИмяКоманды, "/") Тогда
		ИмяКоманды = "/" + ИмяКоманды;
	КонецЕсли;
	
	Параметры.URL = "https://nsi.rosminzdrav.ru" + ИмяКоманды;
	
	Параметры.Заголовки.Вставить("Content-Type", "application/json");
	
	Параметры.ИмяСобытияЖР = "Классификаторы.ЗагрузкаИзСервисаНСИ";
	
	Возврат Параметры;
	
КонецФункции

Функция ВыполнитьЗапросНСИ(ПараметрыОтправки)
	
	Если СтрНайти(ПараметрыОтправки.URL, "?") = 0 Тогда
		ДополнитьURLПараметрами(ПараметрыОтправки);
	КонецЕсли;
	
	РезультатЗапроса = ОтправкаЗапросов.ОтправитьЗапрос(ПараметрыОтправки, Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("Код", РезультатЗапроса.КодСостояния);
	Результат.Вставить("Описание", "");
	Результат.Вставить("Данные", РезультатЗапроса.ПараметрыТела);
	
	Если РезультатЗапроса.КодСостояния = 0 Или РезультатЗапроса.КодСостояния = 200 Тогда
		
		Данные = Новый Структура;
		
		Если РезультатЗапроса.ПараметрыТела.Свойство("total") Тогда
			Данные.Вставить("total", РезультатЗапроса.ПараметрыТела.total);
		КонецЕсли;
		
		Если РезультатЗапроса.ПараметрыТела.Свойство("list") Тогда
			Данные.Вставить("list", РезультатЗапроса.ПараметрыТела.list);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РезультатЗапроса.ПараметрыТела.resultCode) Тогда
			РезультатКод = 40; // .Метод не выполнен по причине: %resultText%.
		Иначе
			РезультатКод = 0;
		КонецЕсли;
		
		Результат.Код = РезультатКод;
		Результат.Описание = РезультатЗапроса.ПараметрыТела.resultText;
		Результат.Данные = Данные;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьURLПараметрами(ПараметрыОтправки)
	
	Если ПараметрыОтправки.ПараметрыURL.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыURL = Новый Массив;
	Для Каждого КлючЗначение Из ПараметрыОтправки.ПараметрыURL Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого ТекущийЭлемент Из КлючЗначение.Значение Цикл
				ПараметрURL = КлючЗначение.Ключ + "=" + ОтправкаЗапросов.ЗначениеПараметраДляURL(ТекущийЭлемент);
				ПараметрыURL.Добавить(ПараметрURL);
			КонецЦикла;
		Иначе
			ПараметрURL = КлючЗначение.Ключ + "=" + ОтправкаЗапросов.ЗначениеПараметраДляURL(КлючЗначение.Значение);
			ПараметрыURL.Добавить(ПараметрURL);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОтправки.URL = ОтправкаЗапросов.ДополнитьURLСтрокойПараметров(ПараметрыОтправки.URL, СтрСоединить(ПараметрыURL, "&"));
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДВЛПИзФайла(Дерево, ФайлСДанными = Неопределено)
	
	ЧтениеКлассификатор = Новый ЧтениеXML;
	Если ФайлСДанными = Неопределено Тогда
		МакетКлассификатор = Справочники.ор_ДВЛП.ПолучитьМакет("Классификатор");
		ЧтениеКлассификатор.УстановитьСтроку(МакетКлассификатор.ПолучитьТекст());
	Иначе
		ЧтениеКлассификатор.ОткрытьФайл(ФайлСДанными);
	КонецЕсли;
	
	ОбработкаРеквизитов = Ложь;
	Пока ЧтениеКлассификатор.Прочитать() Цикл
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента

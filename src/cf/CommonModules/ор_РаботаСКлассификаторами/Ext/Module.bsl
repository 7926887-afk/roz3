		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ИмяЭлементаВРег = "ENTRY" Тогда
			НайденнаяСтрока = Дерево.Строки.Найти(СтруктураСтроки.КодЕСКЛП, "КодЕСКЛП", Истина);

					Ложь);
			КонецЕсли;
			ОбработкаРеквизитов = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеФТГИзФайла(Дерево, ФайлСДанными = Неопределено)
	
	ЧтениеКлассификатор = Новый ЧтениеXML;
	Если ФайлСДанными = Неопределено Тогда
		МакетКлассификатор = Справочники.ор_ФТГ.ПолучитьМакет("Классификатор");
		ЧтениеКлассификатор.УстановитьСтроку(МакетКлассификатор.ПолучитьТекст());
	Иначе
		ЧтениеКлассификатор.ОткрытьФайл(ФайлСДанными);
	КонецЕсли;
	
	ОбработкаРеквизитов = Ложь;
	Пока ЧтениеКлассификатор.Прочитать() Цикл
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификатор.Имя = "entry" Тогда
			СтруктураСтроки = Новый Структура;
			ОбработкаРеквизитов = Истина;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ОбработкаРеквизитов Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификатор.Имя = "CS_ID" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("КодРаздела", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификатор.Имя = "NameR" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("НаименованиеПолное", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеКлассификатор.Имя = "NameE" Тогда
			ЧтениеКлассификатор.Прочитать();
			СтруктураСтроки.Вставить("НаименованиеАнглийское", ЧтениеКлассификатор.Значение);
			ЧтениеКлассификатор.Прочитать();
		КонецЕсли;
		
		
		Если ЧтениеКлассификатор.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеКлассификатор.Имя = "entry" Тогда
			НайденнаяСтрока = Дерево.Строки.Найти(СтруктураСтроки.НаименованиеПолное, "НаименованиеПолное", Истина);
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока) Тогда
				СтрокаДерева = Дерево.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктураСтроки);
			КонецЕсли;
			ОбработкаРеквизитов = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДВЛПИзСервиса(Дерево)
	
	// Проверка на заполненость токена.
	ТокенПользователя = Константы.ор_ТокенПользователяНСИ.Получить();
	Если Не ЗначениеЗаполнено(ТокенПользователя) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Для загрузки данных из НСИ необходимо указать токен пользователя.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОтправки = ПараметрыОтправкиЗапросаНСИ();
	
	ПараметрыОтправки.ПараметрыURL.Вставить("userKey", СокрЛП(ТокенПользователя));
	ПараметрыОтправки.ПараметрыURL.Вставить("identifier", "1.2.643.5.1.13.13.11.1367");
	
	// Фильтр по колонкам которые должны вернутся.
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("ID");
	МассивКолонок.Добавить("NAME_RUS");
	МассивКолонок.Добавить("NAME_LAT");
	МассивКолонок.Добавить("NAME_ENG");
	МассивКолонок.Добавить("GROUP");
	МассивКолонок.Добавить("ATC");
	ПараметрыОтправки.ПараметрыURL.Вставить("columns", МассивКолонок);
	
	ПараметрыОтправки.ПараметрыURL.Вставить("page", 1);
	
	// 10000 записей - максимум что может вернуть сайт в одном запросе.
	ПараметрыОтправки.ПараметрыURL.Вставить("size", 10000);
	
	НужнаИтерация = Истина;
	КоличествоПолучено = 0;
	
	Пока НужнаИтерация Цикл
		
		НужнаИтерация = Ложь;
		
		ДанныеСправочника = ВыполнитьЗапросНСИ(ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыОтправки));
		
		Если ДанныеСправочника.Код <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДанныеСправочника.Описание);
			Возврат;
		КонецЕсли;
		
		КоличествоПолучено = КоличествоПолучено + ДанныеСправочника.Данные.list.Количество(); 
		
		Для Каждого ЭлементСправочника Из ДанныеСправочника.Данные.list Цикл
			
			СтруктураСтроки = Новый Структура;
			
			Для Каждого Колонка Из ЭлементСправочника Цикл
				ИмяКолонки = ВРег(Колонка.column);
				Если ИмяКолонки ="ID" Тогда
					СтруктураСтроки.Вставить("КодРаздела", Колонка.value);
				ИначеЕсли ИмяКолонки = "NAME_RUS" Тогда
					СтруктураСтроки.Вставить("Наименование",Колонка.value);
				ИначеЕсли ИмяКолонки = "NAME_LAT" Тогда
					СтруктураСтроки.Вставить("НаименованиеЛатинское",Колонка.value);
				ИначеЕсли ИмяКолонки = "NAME_ENG" Тогда
					СтруктураСтроки.Вставить("НаименованиеАнглийское",Колонка.value);
				ИначеЕсли ИмяКолонки = "GROUP" Тогда
					СтруктураСтроки.Вставить("ГруппаДействующегоВещества",Колонка.value);
				ИначеЕсли ИмяКолонки = "ATC" Тогда
					СтруктураСтроки.Вставить("АТХ",Колонка.value);
				КонецЕсли;
			КонецЦикла;
			
			// Проверка на уникальность.
			НайденнаяСтрока = Дерево.Строки.Найти(СтруктураСтроки.Наименование, "Наименование", Истина);
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока) Тогда
				СтрокаДерева = Дерево.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева,СтруктураСтроки);
				СтрокаДерева.НаименованиеПолное = СтруктураСтроки.Наименование;
			КонецЕсли;
			
		КонецЦикла;
		
		// Если получено не все, то инкрементируем номер страницы и получаем еще раз.
		Если КоличествоПолучено < ДанныеСправочника.Данные.total Тогда
			НужнаИтерация = Истина;
			ТекущаяСтраница = ПараметрыОтправки.ПараметрыURL.Получить("page");
			ПараметрыОтправки.ПараметрыURL.Вставить("page", ?(ТекущаяСтраница = Неопределено, 0, ТекущаяСтраница) + 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


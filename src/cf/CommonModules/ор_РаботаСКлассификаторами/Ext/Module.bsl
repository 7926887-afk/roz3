
#Область ПрограммныйИнтерфейс

// Процедура - Проверить токен
//
Процедура ПроверитьТокен() Экспорт
	
	// Проверка на заполненость токена.
	ТокенПользователя = Константы.ор_ТокенПользователяНСИ.Получить();
	
	Если Не ЗначениеЗаполнено(ТокенПользователя) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Необходимо указать токен пользователя.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОтправки = ПараметрыОтправкиЗапросаНСИ("port/rest/validate", "POST");
	
	ПараметрыОтправки.Json = "{
	|""userKey"": """ + СокрЛП(ТокенПользователя) + """,
	|""date"": """ + Формат(ТекущаяДатаСеанса(),"ДФ=""гггг-ММ-дд ЧЧ:мм:сс""") + """
	|}";
	
	Результат = ВыполнитьЗапросНСИ(ПараметрыОтправки);
	
	Если Результат.Код = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Токен верный.'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка авторизации: Токен не верный.'"));
	КонецЕсли;
	
КонецПроцедуры

// Функция - Сформировать дерево ДВЛП
//
// Параметры:
//  ИсточникДанных	 - Строка - источник данных
//  ФайлСДанными	 - XMLСтрока - строка данных в XML
// 
// Возвращаемое значение:
//  ДеревоЗначений - дерево действующих веществ лекарственных препаратов
//
Функция СформироватьДеревоДВЛП(ИсточникДанных = "Классификаторы", ФайлСДанными = Неопределено) Экспорт
	
	Число10   = Новый ОписаниеТипов("Число",   Новый КвалификаторыЧисла(10));
	Строка150 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150));
	Строка400 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(400));
	Строка500 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(500));
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Наименование"              , Строка150, НСтр("ru = 'Наименование'"));
	Дерево.Колонки.Добавить("КодРаздела"                , Строка400, НСтр("ru = 'Код'"));
	Дерево.Колонки.Добавить("НаименованиеПолное"        , Строка500, НСтр("ru = 'Наименование полное'"));
	Дерево.Колонки.Добавить("НаименованиеАнглийское"    , Строка500, НСтр("ru = 'Английское наименование'"));
	Дерево.Колонки.Добавить("НаименованиеЛатинское"     , Строка500, НСтр("ru = 'Латинское наименование'"));
	Дерево.Колонки.Добавить("ГруппаДействующегоВещества", Число10  , НСтр("ru = 'Группа действующего вещества'"));
	Дерево.Колонки.Добавить("АТХ"                       , Строка400, НСтр("ru = 'Код раздела (АТХ)'"));
	
	Если ИсточникДанных = "Файлы" И ЗначениеЗаполнено(ФайлСДанными) Тогда
		ЗаполнитьДанныеДВЛПИзФайла(Дерево, ФайлСДанными);
	ИначеЕсли ИсточникДанных = "API" Тогда
		ЗаполнитьДанныеДВЛПИзСервиса(Дерево);
	Иначе
		ЗаполнитьДанныеДВЛПИзФайла(Дерево);
	КонецЕсли;
	
	Возврат Дерево;
	
КонецФункции

// Функция - Сформировать дерево классификаторов ATX
//
// Параметры:
//  ИсточникДанных	 - Строка - источник данных
//  ФайлСДанными	 - XMLСтрока - строка данных в XML
// 
// Возвращаемое значение:
//  ДеревоЗначений - дерево классификаторов ATX
//
Функция СформироватьДеревоКлассификаторовATX(ИсточникДанных = "Классификаторы", ФайлСДанными = Неопределено) Экспорт
	
	Число10   = Новый ОписаниеТипов("Число",   Новый КвалификаторыЧисла(10));
	Строка150 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150));
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Идентификатор"       , Число10  , НСтр("ru = 'Идентификатор'"));
	Дерево.Колонки.Добавить("КодРаздела"          , Строка150, НСтр("ru = 'Код раздела'"));
	Дерево.Колонки.Добавить("Наименование"        , Строка150, НСтр("ru = 'Наименование'"));
	Дерево.Колонки.Добавить("НаименованиеПолное"  , Строка150, НСтр("ru = 'Полное наименование'"));
	Дерево.Колонки.Добавить("ИДРодительскойЗаписи", Число10  , НСтр("ru = 'Идентификатор родительской записи'"));
	
	Если ИсточникДанных = "Файлы" И ЗначениеЗаполнено(ФайлСДанными) Тогда
		ЗаполнитьДанныеКлассификатораATXИзФайла(Дерево, ФайлСДанными);
	ИначеЕсли ИсточникДанных = "API" Тогда
		ЗаполнитьДанныеКлассификатораATXИзСервиса(Дерево);
	Иначе
		ЗаполнитьДанныеКлассификатораATXИзФайла(Дерево);
	КонецЕсли;
	
	// Так как в дереве только ИД-строки и ИД-родителя установим реквизит "Родитель" к элементам дерева.
	
	// Копия дерева чтоб при изменени элементов цикл не сломался.
	ДеревоКопия = Дерево.Скопировать();
	
	// У данного дерева вложенности нет, поэтому рекурсии не будет.
	Для Каждого СтрокаДеревоКопия Из ДеревоКопия.Строки Цикл
		Если ЗначениеЗаполнено(СтрокаДеревоКопия.ИДРодительскойЗаписи) Тогда
			СтрокаРодительДерево = Дерево.Строки.Найти(СтрокаДеревоКопия.ИДРодительскойЗаписи, "Идентификатор", Истина);
			СтрокаДерево         = Дерево.Строки.Найти(СтрокаДеревоКопия.Идентификатор, "Идентификатор", Истина);
			Если ЗначениеЗаполнено(СтрокаРодительДерево) И ЗначениеЗаполнено(СтрокаДерево) Тогда
				СкопироватьУзелДерева(СтрокаРодительДерево.Строки, СтрокаДерево);
				Если ЗначениеЗаполнено(СтрокаДерево.Родитель) Тогда
					СтрокаДерево.Родитель.Строки.Удалить(СтрокаДерево);
				Иначе
					Дерево.Строки.Удалить(СтрокаДерево);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Удаляем ненужные колонки.
	Дерево.Колонки.Удалить(Дерево.Колонки.Найти("Идентификатор"));
	Дерево.Колонки.Удалить(Дерево.Колонки.Найти("ИДРодительскойЗаписи"));
	
	Возврат Дерево;
	
КонецФункции

// Функция - Сформировать дерево лекарственных форм
//
// Параметры:
//  ИсточникДанных		 - Строка - источник данных
//  ФайлСБазовымиЛФ		 - XMLСтрока - строка данных в XML
//  ФайлСПодчиненнымиЛФ	 - XMLСтрока - строка данных в XML
// 
// Возвращаемое значение:
//  ДеревоЗначений - дерево лекарственных форм
//
Функция СформироватьДеревоЛекарственныхФорм(ИсточникДанных = "Классификаторы", ФайлСБазовымиЛФ = Неопределено, ФайлСПодчиненнымиЛФ = Неопределено) Экспорт
	
	Строка100 = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100));
	Строка150 = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(150));
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Наименование"            , Строка100, НСтр("ru = 'Наименование'"));
	Дерево.Колонки.Добавить("НаименованиеЛатынь"      , Строка100, НСтр("ru = 'Наименование(Латынь)'"));
	Дерево.Колонки.Добавить("НаименованиеЛатыньПолное", Строка150, НСтр("ru = 'Полное наименование(Латынь)'"));
	Дерево.Колонки.Добавить("НаименованиеПолное"      , Строка150, НСтр("ru = 'Полное наименование'"));
	
	Если ИсточникДанных = "Файлы" Тогда
		ЗаполнитьДанныеЛекарственныхФормИзФайла(Дерево, ФайлСБазовымиЛФ, ФайлСПодчиненнымиЛФ);
	ИначеЕсли ИсточникДанных = "API" Тогда
		ЗаполнитьДанныеЛекарственныхФормИзСервиса(Дерево);
	Иначе
		ЗаполнитьДанныеЛекарственныхФормИзФайла(Дерево);
	КонецЕсли;
	
	Возврат Дерево;
	
КонецФункции

// Функция - Сформировать дерево СМНН
//
// Параметры:
//  ИсточникДанных	 - Строка - источник данных
//  ФайлСДанными	 - XMLСтрока - строка данных в XML
// 
// Возвращаемое значение:
//  ДеревоЗначений - дерево международных непатентованных наименований
//
Функция СформироватьДеревоСМНН(ИсточникДанных = "Классификаторы", ФайлСДанными = Неопределено) Экспорт
	
	Строка150 = Новый ОписаниеТипов("Строка",,,,  Новый КвалификаторыСтроки(150));
	Булево    = Новый ОписаниеТипов("Булево");
	Дерево = Новый ДеревоЗначений; 
	Дерево.Колонки.Добавить("КодЕСКЛП"       , Строка150, НСтр("ru = 'Код узла СМНН'"));
	Дерево.Колонки.Добавить("КодКТРУ"        , Строка150, НСтр("ru = 'Код КТРУ'"));
	Дерево.Колонки.Добавить("КодОКЕИ"        , Строка150, НСтр("ru = 'Код ОКЕИ'"));
	Дерево.Колонки.Добавить("КодОКПД2"       , Строка150, НСтр("ru = 'Код ОКПД2'"));
	Дерево.Колонки.Добавить("ЖНВЛП"          , Булево   , НСтр("ru = 'ЖНВЛП'"));
	Дерево.Колонки.Добавить("КодАТХ"         , Строка150, НСтр("ru = 'Код АТХ'"));
	Дерево.Колонки.Добавить("НаименованиеАТХ", Строка150, НСтр("ru = 'Наименование АТХ'"));
	Дерево.Колонки.Добавить("НаименованиеФТГ", Строка150, НСтр("ru = 'Наименование ФТГ'"));
	Дерево.Колонки.Добавить(
		"СтандартизированноеМНН",
		Строка150,
		НСтр("ru = 'Стандартизированное МНН'"));
	Дерево.Колонки.Добавить(
		"СтандартизированнаяЛекарственнаяФорма",
		Строка150,
		НСтр("ru = 'Стандартизированная лекарственная форма'"));
	Дерево.Колонки.Добавить(
		"СтандартизированнаяЛекарственнаяДоза",
		Строка150,
		НСтр("ru = 'Стандартизированная лекарственная доза'"));
	Дерево.Колонки.Добавить(
		"НаименованиеПотребительскойЕдиницыИзмерения",
		Строка150,
		НСтр("ru = 'Наименование потребительской единицы измерения'"));
	Дерево.Колонки.Добавить(
		"НаличиеВЛПНаркотическихПсихотропныхВеществИИхПрекурсоров",
		Булево,
		НСтр("ru = 'Наличие в ЛП наркотических психотропных веществ и их прекурсоров'"));
	
	// Макета с классификатором СМНН нет.
	Если ИсточникДанных = "API" Тогда
		ЗаполнитьДанныеСМННИзСервиса(Дерево);
	Иначе
		ЗаполнитьДанныеСМННИзФайла(Дерево, ФайлСДанными);
	КонецЕсли;
	
	Возврат Дерево;
	
КонецФункции


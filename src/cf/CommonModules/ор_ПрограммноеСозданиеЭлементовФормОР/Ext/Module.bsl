
#Область ПрограммныйИнтерфейс

// Выполняет программное изменение структуры формы
// (создание и изменение реквизитов, команд, элементов, условного оформления), 
// связанное с изменениями в общих отраслевых блоках. 
//
// Параметры:
//   ИмяПроцедуры - Строка - Имя процедуры, которая будет выполнять изменение структуры для конкретной формы.
// 				    Должно подчиняться шаблону именования [Сокращенное наименование типа объекта][Имя объекта][Имя Формы] 
//   Форма 	  	  - Форма клиентского приложения, структура которой изменяется 
//   СписокОшибок - Строка - Список ошибок при изменении формы
//
Процедура ОбработатьПрограммноеСозданиеЭлементовФормы(ИмяПроцедуры, Форма, СписокОшибок) Экспорт
	
	СписокПроцедурПрограммногоСоздания 	= ор_ПрограммноеСозданиеЭлементовФормПовтИсп.СписокПроцедурОР();
	ПроцедураЕсть 						= СписокПроцедурПрограммногоСоздания.Получить(ИмяПроцедуры);
	
	Если ПроцедураЕсть <> Неопределено  Тогда
		Выполнить("" + ИмяПроцедуры + "(Форма, СписокОшибок);");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


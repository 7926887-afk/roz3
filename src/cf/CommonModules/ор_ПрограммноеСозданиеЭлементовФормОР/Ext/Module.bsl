Процедура ОФФормаВыбораДанныхПоискаПоШтрихкоду(Форма, СписокОшибок)

	#Область УсловноеОформлениеФормы
	ЭлементУсловногоОформления = Форма.УсловноеОформление.Элементы.Добавить();
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
					ЭлементУсловногоОформления.Отбор,, 
					ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, 
														"ДеревоВыбора.Остаток",
														0, 
														ВидСравненияКомпоновкиДанных.Равно,,
														Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, 
														"ОтображатьТолькоТоварыНаОстатках", 
														Истина, 
														ВидСравненияКомпоновкиДанных.Равно,,
														Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, 
														"ДеревоВыбора.Номенклатура", 
														, 
														ВидСравненияКомпоновкиДанных.Заполнено,,
														Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, 
														"ПоказыватьОстатокНоменклатуры",
														Истина, 
														ВидСравненияКомпоновкиДанных.Равно,,
														Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, 
														"ДеревоВыбора.ОтображатьОстатки",
														Истина, 
														ВидСравненияКомпоновкиДанных.Равно,,
														Истина);
	МассивОформляемыхПолей = Новый Массив();
	МассивОформляемыхПолей.Добавить("ТаблицаВыбора");
	МассивОформляемыхПолей.Добавить("ТаблицаВыбораВыбрана");
	МассивОформляемыхПолей.Добавить("ТаблицаВыбораКодПоиска");
	МассивОформляемыхПолей.Добавить("ТаблицаВыбораПредставлениеВладельца");
	МассивОформляемыхПолей.Добавить("ТаблицаВыбораТипОбъекта");
	МассивОформляемыхПолей.Добавить("ТаблицаВыбораШаблонШтрихкода");
	МассивОформляемыхПолей.Добавить("ТаблицаВыбораОстаток");
	МассивОформляемыхПолей.Добавить("ТаблицаВыбораРезерв");
	
	Для Каждого Поле Из МассивОформляемыхПолей Цикл
		ПолеОформления = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле 		 = Новый ПолеКомпоновкиДанных(Поле);
		ПолеОформления.Использование = Истина;
	КонецЦикла;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Видимость" , Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
#КонецОбласти

#Область ИзмененныеСвойства
#КонецОбласти

#Область Реквизиты
	МассивДобавляемыхРеквизитов = Новый Массив;

Процедура СпрНоменклатураФормаСписка(Форма, СписокОшибок)
	
#Область ИзмененныеСвойства
	Если Форма.СписокЗапасы.ПроизвольныйЗапрос Тогда
		СхемаЗапроса = ор_ПрограммноеСозданиеЭлементовФорм.ПолучитьСхемуЗапроса(Форма.СписокЗапасы.ТекстЗапроса);
		Колонки      = СхемаЗапроса.ПакетЗапросов[0].Колонки;
		Поля         = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;
		
		Поля.Добавить("НоменклатураПереопределяемый.ор_МНН");
		Колонки[Поля.Количество() - 1].Псевдоним = "МНН";
		
		Поля.Добавить("НоменклатураПереопределяемый.ор_МНН.НаименованиеЛатинское");
		Колонки[Поля.Количество() - 1].Псевдоним = "ЛатинскоеМНН";
		
		Поля.Добавить("НоменклатураПереопределяемый.ор_Производитель");
		Колонки[Поля.Количество() - 1].Псевдоним = "ор_Производитель";
		
		Поля.Добавить("1");
		Колонки[Поля.Количество() - 1].Псевдоним = "КоэффициентЗаменыАналогом";
		
		Поля.Добавить("0");
		Колонки[Поля.Количество() - 1].Псевдоним = "ПриоритетАналога";
		
		Поля.Добавить("0");
		Колонки[Поля.Количество() - 1].Псевдоним = "ПриоритетРеализации";
		
		Поля.Добавить("НоменклатураПереопределяемый.ор_ОтпускПоРецепту");
		Колонки[Поля.Количество() - 1].Псевдоним = "ор_ОтпускПоРецепту";
		
		СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
		СвойстваСписка.ОсновнаяТаблица              = "Справочник.Номенклатура";
		СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
		СвойстваСписка.ТекстЗапроса                 = СхемаЗапроса.ПолучитьТекстЗапроса();
		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Форма.Элементы.СписокЗапасы, СвойстваСписка);
		
		Форма.СписокЗапасы.УстановитьОбязательноеИспользование("КоэффициентЗаменыАналогом", Истина);
		Форма.СписокЗапасы.УстановитьОбязательноеИспользование("ПриоритетАналога",          Истина);
		Форма.СписокЗапасы.УстановитьОбязательноеИспользование("ПриоритетРеализации",       Истина);

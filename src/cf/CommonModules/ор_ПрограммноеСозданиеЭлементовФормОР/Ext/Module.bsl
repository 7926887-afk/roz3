Процедура РСАналогиНоменклатурыФормаДляНоменклатуры(Форма, СписокОшибок)

#Область ИзмененныеСвойства
	Если Форма.Список.ПроизвольныйЗапрос Тогда
		Форма.Список.ТекстЗапроса = "ВЫБРАТЬ
		|	АналогиНоменклатуры.Номенклатура КАК НоменклатураОригинал,
		|	АналогиНоменклатуры.Аналог КАК Аналог,
		|	АналогиНоменклатуры.Аналог КАК АналогОригинал,
		|	АналогиНоменклатуры.Приоритет КАК Приоритет,
		|	АналогиНоменклатуры.Комментарий КАК Комментарий,
		|	АналогиНоменклатуры.ор_Коэффициент КАК Коэффициент,
		|	АналогиНоменклатуры.ор_Обратимость КАК Обратимость,
		|	ЛОЖЬ КАК ОбратныйАналог
		|ИЗ
		|	РегистрСведений.АналогиНоменклатуры КАК АналогиНоменклатуры
		|ГДЕ
		|	АналогиНоменклатуры.Номенклатура = &Ссылка";
	КонецЕсли;
#КонецОбласти

#Область Команды
	НоваяКоманда = Форма.Команды.Добавить("ЗагрузитьИзФайла");
	НоваяКоманда.Действие  = "Подключаемый_ЗагрузитьИзФайла";
	НоваяКоманда.Заголовок = НСтр("ru = 'Загрузить из файла'");
#КонецОбласти

#Область Элементы
	Элементы = Форма.Элементы;
	
	НовыйЭлемент = Элементы.Вставить(
		"Коэффициент",
		Тип("ПолеФормы"),
		Элементы.Список,
		Элементы.Комментарий);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.ПутьКДанным = "Список.Коэффициент";
	
	НовыйЭлемент = Элементы.Вставить(
		"Обратимость",
		Тип("ПолеФормы"),
		Элементы.Список,
		Элементы.Комментарий);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = "Список.Обратимость";
	
	НовыйЭлемент = Элементы.Вставить(
		"ЗагрузитьИзФайла",
		Тип("КнопкаФормы"),
		Элементы.СписокОбщий.КоманднаяПанель);
	НовыйЭлемент.Вид         = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды  = "ЗагрузитьИзФайла";
#КонецОбласти

#Область ИзмененныеСвойства
	
#КонецОбласти

КонецПроцедуры

Процедура РСАналогиНоменклатурыФормаЗаписи(Форма, СписокОшибок)
	
#Область Реквизиты
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы(
		"БылаЗаписьОбратнойЗамены",
		Новый ОписаниеТипов("Булево"),,
		НСтр("ru = 'Была запись обратной замены'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
#КонецОбласти

#Область Элементы
	Элементы = Форма.Элементы;
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаКоэффициент",
		Тип("ГруппаФормы"),,
		Элементы.Комментарий);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	НовыйЭлемент = Элементы.Вставить(
		"Коэффициент",
		Тип("ПолеФормы"),
		Элементы.ГруппаКоэффициент);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Запись.ор_Коэффициент";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ЭлементПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить(
		"Обратимость",
		Тип("ПолеФормы"),
		Элементы.ГруппаКоэффициент);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = "Запись.ор_Обратимость";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ЭлементПриИзменении");
	
#КонецОбласти

#Область ИзмененныеСвойства
	ор_ПрограммноеСозданиеЭлементовФорм.ИзменитьДействиеЭлемента(
		Форма,
		"Номенклатура",
		"ПриИзменении",
		"Подключаемый_ЭлементПриИзменении",,
		СписокОшибок);
	ор_ПрограммноеСозданиеЭлементовФорм.ИзменитьДействиеЭлемента(
		Форма,
		"Аналог",
		"ПриИзменении",
		"Подключаемый_ЭлементПриИзменении",,
		СписокОшибок);
		
	Элементы.Переместить(
		Элементы.Приоритет,
		Элементы.ГруппаКоэффициент,
		Элементы.Обратимость);
#КонецОбласти

КонецПроцедуры


	Если Форма.Список.ПроизвольныйЗапрос Тогда
		СхемаЗапроса = ор_ПрограммноеСозданиеЭлементовФорм.ПолучитьСхемуЗапроса(Форма.Список.ТекстЗапроса);
		Колонки      = СхемаЗапроса.ПакетЗапросов[1].Колонки;
		Поля         = СхемаЗапроса.ПакетЗапросов[1].Операторы[0].ВыбираемыеПоля;
		
		Поля.Добавить("ДокументЗаказПокупателя.ор_НомерЗаказаАптекаРУ");
		Колонки[Поля.Количество() - 1].Псевдоним = "ор_НомерЗаказаАптекаРУ";
		
		СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
		СвойстваСписка.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Форма.Элементы.Список, СвойстваСписка);
	КонецЕсли;

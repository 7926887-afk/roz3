Процедура СпрВидыЦенКонструкторФормул(Форма, СписокОшибок)

#Область Реквизиты
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_ВидЦенБазыРасчета",
		Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"),,
		НСтр("ru = 'Вид цен поставщика'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_ВидЦенДляРасчетаНаценки",
		Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"),,
		НСтр("ru = 'Вид цен производителя'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	// Диапазоны наценок.
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_ДиапазоныНаценок",
		Новый ОписаниеТипов("ТаблицаЗначений"),,
		НСтр("ru = 'Диапазоны наценок'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ВерхняяГраница",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)),
		"ор_ДиапазоныНаценок",
		НСтр("ru = 'Верхняя граница'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ЗначениеНаценки",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)),
		"ор_ДиапазоныНаценок",
		НСтр("ru = 'Значение'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ПредставлениеИнтервала",
		Новый ОписаниеТипов("Строка"),
		"ор_ДиапазоныНаценок",
		НСтр("ru = 'Представление'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	// Конец Диапазоны наценок.
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_СистемаНалогообложения",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыСистемНалогообложенияККТ"),,
		НСтр("ru = 'Система налогообложения'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_ПроцентНаценки",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)),,
		НСтр("ru = 'Процент наценки'"),
		Истина);
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_ИспользоватьДиапазоны",
		Новый ОписаниеТипов("Булево"),,
		НСтр("ru = 'Использовать диапазоны'"),
		Истина);
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_КонтрольМаксНаценки",
		Новый ОписаниеТипов("Булево"),,
		НСтр("ru = 'Контроль максимальной наценки'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_КонтрольМинНаценки",
		Новый ОписаниеТипов("Булево"),,

Процедура Спрор_НастройкиЗагрузкиДанныхИзТабличногоДокументаФормаНастройкиДополнительныхПараметров(Форма, СписокОшибок)

#Область ИзмененныеСвойства
	ор_ПрограммноеСозданиеЭлементовФорм.ИзменитьСвойствоЭлемента(Форма, "СоздаватьШКДляНовойНоменклатуры", "Видимость", Ложь, СписокОшибок);
	ор_ПрограммноеСозданиеЭлементовФорм.ИзменитьСвойствоЭлемента(Форма, "СоздаватьШКДляНовойХарактеристики", "Видимость", Ложь, СписокОшибок);
#КонецОбласти

#Область Реквизиты
	МассивДобавляемыхРеквизитов = Новый Массив;
		
	НовыйРеквизит = Новый РеквизитФормы(
		"СоздаватьСтрануПроисхождения",
		Новый ОписаниеТипов("Булево"),,
		НСтр("ru = 'Создавать страну происхождения'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ЗагружатьGTINДляСерии",
		Новый ОписаниеТипов("Булево"),,
		НСтр("ru = 'Загружать GTIN для серии'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
#КонецОбласти

#Область Команды
#КонецОбласти

#Область Элементы
	Элементы = Форма.Элементы;
	
	НовыйЭлемент = Элементы.Вставить(
		"ЗагружатьШК",
		Тип("ПолеФормы"),
		Элементы.ГруппаФлажки,
		Элементы.ШКЯвляетсяПолемПоискаНоменклатуры);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "ЗагружатьШК";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	НовыйЭлемент = Элементы.Вставить(
		"НеФормироватьДопНомерСерии",
		Тип("ПолеФормы"),
		Элементы.ГруппаФлажки,
		Элементы.ЗагружатьШК);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "НеФормироватьДопНомерСерии";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.Подсказка          = НСтр("ru = 'Если истина, то при формировании серий не будут формироваться дополнительные номера для наименования серии, чтобы соблюсти уникальность нименования.'");
	
	НовыйЭлемент = Элементы.Вставить(
		"СоздаватьСтрануПроисхождения",
		Тип("ПолеФормы"),
		Элементы.ГруппаФлажки,
		Элементы.НеФормироватьДопНомерСерии);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "СоздаватьСтрануПроисхождения";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	НовыйЭлемент = Элементы.Вставить(
		"СоздаватьПроизводителя",
		Тип("ПолеФормы"),
		Элементы.ГруппаФлажки,
		Элементы.СоздаватьСтрануПроисхождения);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "СоздаватьПроизводителя";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	НовыйЭлемент = Элементы.Вставить(
		"ВсегдаФормироватьНовыеСерии",
		Тип("ПолеФормы"),
		Элементы.ГруппаФлажки,
		Элементы.СоздаватьПроизводителя);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "ВсегдаФормироватьНовыеСерии";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	НовыйЭлемент = Элементы.Вставить(
		"ФорматДатыСрокаГодности",
		Тип("ПолеФормы"),
		Элементы.ГруппаФорматДаты);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ФорматДатыСрокаГодности";
	НовыйЭлемент.Заголовок   = НСтр("ru = 'Формат даты'");
	
	НовыйЭлемент = Элементы.Вставить(
		"ЗагружатьGTINДляСерии",
		Тип("ПолеФормы"),
		Элементы.ГруппаФлажки,
		Элементы.ШКЯвляетсяПолемПоискаНоменклатуры);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "ЗагружатьGTINДляСерии";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
#КонецОбласти
	
КонецПроцедуры

Процедура СпрХарактеристикиНоменклатурыФормаЭлемента(Форма, СписокОшибок)
	
#Область Реквизиты
	МассивДобавляемыхРеквизитов = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы(
		"ор_СрокХранения",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)),,
		НСтр("ru = 'Срок хранения'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
#КонецОбласти

#Область Команды
#КонецОбласти

#Область Элементы
	Элементы = Форма.Элементы;
	
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаРеквизитыСерии",
		Тип("ГруппаФормы"),,
		Элементы.ДополнительныеРеквизиты);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок   = НСтр("ru = 'Параметры серии'");
	НовыйЭлемент.Подсказка   = НСтр("ru = 'Дополнительные реквизиты учета'");
	НовыйЭлемент.Поведение   = ПоведениеОбычнойГруппы.Свертываемая;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	НовыйЭлемент.Скрыть();
	
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаСрокГодности",
		Тип("ГруппаФормы"),
		Элементы.ГруппаРеквизитыСерии);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_ДатаИзготовления",
		Тип("ПолеФормы"),
		Элементы.ГруппаСрокГодности);
	НовыйЭлемент.Вид                    = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным            = "Объект.ор_ДатаИзготовления";
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ДатаИзготовленияПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_СрокХранения",
		Тип("ПолеФормы"),
		Элементы.ГруппаСрокГодности);
	НовыйЭлемент.Вид                    = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным            = "ор_СрокХранения";
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_СрокХраненияПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_СрокГодности",
		Тип("ПолеФормы"),
		Элементы.ГруппаСрокГодности);
	НовыйЭлемент.Вид                    = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным            = "Объект.ор_СрокГодности";
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_СрокГодностиПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_СерияПроизводителя",
		Тип("ПолеФормы"),
		Элементы.ГруппаРеквизитыСерии);
	НовыйЭлемент.Вид                    = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным            = "Объект.ор_СерияПроизводителя";
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ор_СерияПроизводителяПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаДополнительныеРеквизитыСерии",
		Тип("ГруппаФормы"),
		Элементы.ГруппаРеквизитыСерии);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаСерияПроизводителя",
		Тип("ГруппаФормы"),
		Элементы.ГруппаДополнительныеРеквизитыСерии);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_Производитель",
		Тип("ПолеФормы"),
		Элементы.ГруппаСерияПроизводителя);
	НовыйЭлемент.Вид                    = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным            = "Объект.ор_Производитель";
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ор_ОтраслевкаПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_СтранаПроисхождения",
		Тип("ПолеФормы"),
		Элементы.ГруппаСерияПроизводителя);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ор_СтранаПроисхождения";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ор_ОтраслевкаПриИзменении");

	НовыйЭлемент = Элементы.Вставить(
		"ГруппаФлажков",
		Тип("ГруппаФормы"),
		Элементы.ГруппаДополнительныеРеквизитыСерии);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_Фальсификат",
		Тип("ПолеФормы"),
		Элементы.ГруппаФлажков);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеФлажка;

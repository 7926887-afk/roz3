	НовыйЭлемент.Заголовок   = НСтр("ru = 'Информационный киоск'");
	НовыйЭлемент.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Кнопка;
	НовыйЭлемент.Скрыть();
	
	НовыйЭлемент = Элементы.Добавить(
		"ор_ИнфоКиоскИспользовать",
		Тип("ПолеФормы"),
		Элементы.СтраницаПродажиИнформационныйКиоск);
	НовыйЭлемент.Вид                  = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ВидФлажка          = ВидФлажка.Выключатель;
	НовыйЭлемент.ПутьКДанным          = "ор_ИнфоКиоскИспользовать";
	НовыйЭлемент.ПоложениеЗаголовка   = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	НовыйЭлемент.РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Позволяет использовать информационный киоск'");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ПриИзмененииЭлементаУНФ");
	
	НовыйЭлемент = Элементы.Добавить(
		"ОткрытьНастройкиИнформационногоКиоска",
		Тип("КнопкаФормы"),

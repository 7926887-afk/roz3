	НовыйЭлемент.Вид                  = ВидКнопкиФормы.Гиперссылка;
	НовыйЭлемент.Заголовок            = НСтр("ru = 'Настройка информационного киоска'");
	НовыйЭлемент.ИмяКоманды           = "ОткрытьНастройкиИнформационногоКиоска";
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	

Процедура ОФНастройкиРабочегоМестаКассира(Форма, СписокОшибок)

#Область Реквизиты
#КонецОбласти

#Область Команды
#КонецОбласти

#Область Элементы
	
	Элементы = Форма.Элементы;
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаОтраслевыеФлаги",
		Тип("ГруппаФормы"),
		Элементы.НастройкиИнтерфейсаКарточка);
	НовыйЭлемент.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение         = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаОтраслевыеФлагиЛево",
		Тип("ГруппаФормы"),
		Элементы.ГруппаОтраслевыеФлаги);
	НовыйЭлемент.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение         = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Ширина              = 43;
	
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаОтраслевыеФлагиПраво",
		Тип("ГруппаФормы"),
		Элементы.ГруппаОтраслевыеФлаги);
	НовыйЭлемент.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение         = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Элементы.Вставить(
		"НастройкаРМКор_ПоказыватьТолькоХарактеристикиВНаличии",
		Тип("ПолеФормы"),
		Элементы.ГруппаОтраслевыеФлагиЛево);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "НастройкиРМК.ор_ПоказыватьТолькоХарактеристикиВНаличии";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	НовыйЭлемент = Элементы.Вставить(
		"НастройкаРМКор_ИнтерактивноОповещатьОСопутствующихТоварах",
		Тип("ПолеФормы"),
		Элементы.ГруппаОтраслевыеФлагиЛево);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "НастройкиРМК.ор_ИнтерактивноОповещатьОСопутствующихТоварах";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	НовыйЭлемент = Элементы.Вставить(
		"НастройкаРМКор_ВыводитьХарактеристикиДляПодаркаВВидеДерева",
		Тип("ПолеФормы"),
		Элементы.ГруппаОтраслевыеФлагиПраво);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.Видимость          = Ложь;
	НовыйЭлемент.ПутьКДанным        = "НастройкиРМК.ор_ВыводитьХарактеристикиДляПодаркаВВидеДерева";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.Подсказка          = НСтр("ru = 'В форме выбора подарка для каждой номенклатурной позиции будет выводиться список доступных характеристик.'");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ВыводитьХарактеристикиДляПодаркаВВидеДереваПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить(
		"НастройкаРМКор_РаскрытьГруппыХарактеристикПриОткрытии",
		Тип("ПолеФормы"),
		Элементы.ГруппаОтраслевыеФлагиПраво);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.Видимость          = Ложь;
	НовыйЭлемент.ПутьКДанным        = "НастройкиРМК.ор_РаскрытьГруппыХарактеристикПриОткрытии";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.Доступность        = Ложь;
	
#КонецОбласти

#Область ИзмененныеСвойства
#КонецОбласти


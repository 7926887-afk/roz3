Процедура ОФФормаВыбораДанныхПоискаПоШтрихкоду(Форма, СписокОшибок)
	
#Область ИзмененныеСвойства
#КонецОбласти

#Область Реквизиты

	МассивДобавляемыхРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ОтображатьЦены",
		Новый ОписаниеТипов("Булево"),
		"ДеревоВыбора",
		НСтр("ru = 'Отображать цены'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ПоказыватьЦеныНоменклатуры",
		Новый ОписаниеТипов("Булево"),
		,
		НСтр("ru = 'Показывать цены'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"РозничныйВидЦены",
		Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"),
		,
		НСтр("ru = 'РозничныйВидЦены'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"ТаблицаНоменклатурыДляЦен",
		Новый ОписаниеТипов("ТаблицаЗначений"),
		,
		НСтр("ru = 'ТаблицаНоменклатурыДляЦен'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"),
		"ТаблицаНоменклатурыДляЦен", 
		НСтр("ru = 'Номенклатура'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"Характеристика",
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"),
		"ТаблицаНоменклатурыДляЦен",
		НСтр("ru = 'Характеристика'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы(
		"Цена",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)),
		"ТаблицаНоменклатурыДляЦен",
		НСтр("ru = 'Цена'"));
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
#КонецОбласти

#Область Команды
#КонецОбласти

#Область Элементы
	
	Элементы = Форма.Элементы;
	НовыйЭлемент = Элементы.Вставить(
		"ГруппаПоказыватьЦену",
		Тип("ГруппаФормы"));
	НовыйЭлемент.Вид 		 		 = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок   		 = "ГруппаПоказыватьЦену";
	НовыйЭлемент.отображатьЗаголовок = Ложь;
	НовыйЭлемент.Отображение 		 = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка 		 = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	

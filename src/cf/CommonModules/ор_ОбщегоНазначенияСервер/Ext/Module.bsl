#Область СлужебныеПроцедурыИФункции

Функция ЗапуститьИнфоКиоск(Параметры)
	
	ЗапуститьИнфоКиоск = Ложь;
	
	Если Не ПолучитьФункциональнуюОпцию("ор_ИспользоватьИнформационныйКиоск")
		Или ОбщегоНазначения.ЭтоМобильныйКлиент()
		Или ОбщегоНазначения.ЭтоВебКлиент()
		Или Параметры.Свойство("ЗапуститьНовыйРМК") И Параметры.ЗапуститьНовыйРМК
		Или Параметры.Свойство("РежимКассыСамообслуживания") И Параметры.РежимКассыСамообслуживания Тогда
		Возврат ЗапуститьИнфоКиоск;
	КонецЕсли;
	
	ПолучитьТекущегоПользователя = Истина;
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Если ИнтернетПоддержкаПользователей.СеансЗапущенБезРазделителей() Тогда
			ПолучитьТекущегоПользователя = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТекущийПользователь = Справочники.Пользователи.ПустаяСсылка();
	Если ПолучитьТекущегоПользователя Тогда
		ТекущийПользователь = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийПользователь) Тогда
		ЕстьПрофиль   = УправлениеДоступомУНФ.ЕстьПрофильИнформационныйКиоск(ТекущийПользователь);
		ВключенЗапуск = ПерсональныеНастройкиРУНФ.Прочитать("ор_ЗапускатьИнформационныйКиоскПриСтартеСистемы");
		ЗапуститьИнфоКиоск = ВключенЗапуск И ЕстьПрофиль;
	КонецЕсли;
	
	Возврат ЗапуститьИнфоКиоск;
	
КонецФункции

Функция ВерсияФорматаЧислом(СтрокаВерсии)
	ВерсияФорматаЧислом = 0;
	
	РазрядыВерсии = СтрРазделить(СтрокаВерсии, ".");
	
	МножительРазряда = 10000;
	Для ИндексРазрядаОбратный = 0 По 1 Цикл
		ВерсияФорматаЧислом = ВерсияФорматаЧислом + Число(РазрядыВерсии[ИндексРазрядаОбратный])*МножительРазряда;
		МножительРазряда = МножительРазряда / 100;
	КонецЦикла;
	Возврат ВерсияФорматаЧислом;
КонецФункции

// Поиск забракованных товаров в табличной части
//
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - табличная часть документа.
//
// Возвращаемое значение:
// ТаблицаЗначений. Таблица, хранящая найденные фальсификаты.
//
Функция НайтиФальсификатыВТабличнойЧастиСервер(ТабличнаяЧасть, ЭтоПересортица = Ложь)
	
	Результат = Новый ТаблицаЗначений;
	Если ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат ТабличнаяЧасть;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВнешняяТаблица.НомерСтроки КАК НомерСтроки,
	|	ВнешняяТаблица.Номенклатура КАК Номенклатура,
	|	ВнешняяТаблица.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ТабличнаяЧастьДокумента
	|ИЗ
	|	&ВнешняяТаблица КАК ВнешняяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабличнаяЧастьДокумента.НомерСтроки КАК НомерСтроки,
	|	ТабличнаяЧастьДокумента.Номенклатура КАК Номенклатура,
	|	ТабличнаяЧастьДокумента.Характеристика КАК Характеристика,
	|	ХарактеристикиНоменклатуры.ор_СерияПроизводителя КАК НомерСерии
	|ИЗ
	|	ТабличнаяЧастьДокумента КАК ТабличнаяЧастьДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО ТабличнаяЧастьДокумента.Характеристика = ХарактеристикиНоменклатуры.Ссылка
	|ГДЕ
	|	ХарактеристикиНоменклатуры.ор_Фальсификат");
	
	Если ЭтоПересортица Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВнешняяТаблица.Номенклатура",
			"ВнешняяТаблица.НоменклатураОприходование");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВнешняяТаблица.Характеристика",
			"ВнешняяТаблица.ХарактеристикаОприходование");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВнешняяТаблица", ТабличнаяЧасть);
	
	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
	Исключение
		Результат = Новый ТаблицаЗначений;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Поиск забракованных товаров в определенных документах
//
// Параметры:
//  ОбъектДокумент - ДокументОбъект - документ, в данных которого необходимо произвести поиск фальсификатов.
//
// Возвращаемое значение:
// Булево. Истина - поиск удачен, иначе ложь.
//
Функция НайтиФальсификаты(ОбъектДокумент)
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РазрешитьПроведениеДокументовСФальсификатами = Пользователи.РолиДоступны(
		"ор_ПравоРазрешитьПроведениеДокументовСФальсификатами");
	
	ТипОбъекта = ТипЗнч(ОбъектДокумент);
	Если НЕ ТипОбъекта = Тип("ДокументОбъект.ПриходнаяНакладная")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ПеремещениеЗапасов")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ЧекККМ")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.РасходнаяНакладная")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ОприходованиеЗапасов")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ПересортицаЗапасов")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыСеанса.ор_ОтключитьПроверкуФальсификатовИСроковГодностиПриОбновлении Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьФальсификатВШапке = Ложь;
	Если ТипОбъекта = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм") Тогда
		Если ОбъектДокумент.Характеристика.ор_Фальсификат Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Серия %1 лекарственной формы %2 является фальсификатом'"),
				ОбъектДокумент.Характеристика,
				ОбъектДокумент.Номенклатура);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ОбъектДокумент);
			ЕстьФальсификатВШапке = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоПересортица = ТипОбъекта = Тип("ДокументОбъект.ПересортицаЗапасов");
	НайденныеФальсификаты = НайтиФальсификатыВТабличнойЧастиСервер(ОбъектДокумент.Запасы, ЭтоПересортица);
	ЕстьФальсификатыВПодарках = Ложь;
	Если ТипОбъекта = Тип("ДокументОбъект.ЧекККМ") Тогда
		НайденныеФальсификатыВПодарках = НайтиФальсификатыВТабличнойЧастиСервер(ОбъектДокумент.Подарки, Ложь);
		Если НайденныеФальсификатыВПодарках.Количество()<>0 Тогда
			ЕстьФальсификатыВПодарках = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НайденныеФальсификаты.Количество() = 0 И НЕ ЕстьФальсификатыВПодарках И Не ЕстьФальсификатВШапке Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'В списке товаров найдены фальсификаты:'");
	Для Каждого ТекСтрока Из НайденныеФальсификаты Цикл
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
			|Строка №%2 <%3> серия: %4'"),
			ТекстСообщения,
			ТекСтрока.НомерСтроки,
			ТекСтрока.Номенклатура,
			ТекСтрока.Характеристика);
	КонецЦикла;
	
	Если НайденныеФальсификаты.Количество() <> 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ОбъектДокумент);
	КонецЕсли;
	
	Если ЕстьФальсификатыВПодарках Тогда
		ТекстСообщения = НСтр("ru = 'В списке подарков найдены фальсификаты:'");
		Для Каждого ТекСтрока Из НайденныеФальсификатыВПодарках Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1
				|Строка №%2 <%3> серия: %4'"),
				ТекстСообщения,
				ТекСтрока.НомерСтроки,
				ТекСтрока.Номенклатура,
				ТекСтрока.Характеристика);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ОбъектДокумент);
	КонецЕсли;
	
	Если РазрешитьПроведениеДокументовСФальсификатами Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции // НайтиФальсификатыСервер()

// Поиск просроченных товаров в определенных документах
//
// Параметры:
//  ОбъектДокумент - ДокументОбъект - документ, в данных которого необходимо произвести поиск просроченных товаров.
//
// Возвращаемое значение:
// Булево. Истина - поиск удачен, иначе ложь.
//
Функция НайтиПросроченныеСерии(ОбъектДокумент)
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РазрешитьЗаписьДокументов = Пользователи.РолиДоступны(
		"ор_ПравоРазрешитьЗаписьДокументовСодержащихМедикаментыСИстекшимСрокомГодности");
	
	ТипОбъекта = ТипЗнч(ОбъектДокумент);
	Если НЕ ТипОбъекта = Тип("ДокументОбъект.ЗаказПокупателя")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ЧекККМ")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ОприходованиеЗапасов")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ПриходнаяНакладная")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ПриходныйОрдер")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ПеремещениеЗапасов")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ПересортицаЗапасов")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.РасходнаяНакладная")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.РасходныйОрдер")
		И НЕ ТипОбъекта = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыСеанса.ор_ОтключитьПроверкуФальсификатовИСроковГодностиПриОбновлении Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьПросрочкаВШапке = Ложь;
	Если ТипОбъекта = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм") Тогда
		Если ор_ОбщегоНазначенияКлиентСервер.ПолучитьФлагСерийногоУчета(ОбъектДокумент.Номенклатура)
			И ЗначениеЗаполнено(ОбъектДокумент.Характеристика.ор_СрокГодности)
			И КонецДня(ОбъектДокумент.Характеристика.ор_СрокГодности) < ОбъектДокумент.Дата Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'У серия %1 лекарственной формы %2 срок годности истек: %3'"),
				ОбъектДокумент.Характеристика,
				ОбъектДокумент.Номенклатура,
				ОбъектДокумент.Характеристика.ор_СрокГодности);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ОбъектДокумент);
			ЕстьПросрочкаВШапке = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоПересортица = ТипОбъекта = Тип("ДокументОбъект.ПересортицаЗапасов");
	НайденнаяПросрочка = НайтиПросроченныеСерииВТабличнойЧастиСервер(ОбъектДокумент.Запасы, ОбъектДокумент.Дата, ЭтоПересортица);
	ЕстьПросрочкаВПодарках = Ложь;
	Если ТипОбъекта = Тип("ДокументОбъект.ЧекККМ") Тогда
		НайденнаяПросрочкаВПодарках = НайтиПросроченныеСерииВТабличнойЧастиСервер(ОбъектДокумент.Подарки, ОбъектДокумент.Дата);
		ЕстьПросрочкаВПодарках = НайденнаяПросрочкаВПодарках.Количество() <> 0;
	КонецЕсли;
	Если НайденнаяПросрочка.Количество() = 0 И НЕ ЕстьПросрочкаВПодарках И Не ЕстьПросрочкаВШапке Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'В списке товаров найдены просроченные серии:'");
	Для Каждого ТекСтрока Из НайденнаяПросрочка Цикл
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1
			|Строка №%2 <%3> серия: %4 срок годности: %5'"),
			ТекстСообщения,
			ТекСтрока.НомерСтроки,
			ТекСтрока.Номенклатура,
			ТекСтрока.Характеристика,
			ТекСтрока.СрокГодности);
	КонецЦикла;
	
	Если НайденнаяПросрочка.Количество() <> 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ОбъектДокумент);
	КонецЕсли;
	
	Если ЕстьПросрочкаВПодарках Тогда
		ТекстСообщения = НСтр("ru = 'В списке подарков найдены просроченные серии:'");
		Для Каждого ТекСтрока Из НайденнаяПросрочкаВПодарках Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1
				|Строка №%2 <%3> серия: %4 срок годности: %5'"),
				ТекстСообщения,
				ТекСтрока.НомерСтроки,
				ТекСтрока.Номенклатура,
				ТекСтрока.Характеристика,
				ТекСтрока.СрокГодности);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ОбъектДокумент);
	КонецЕсли;
	
	Если Не РазрешитьЗаписьДокументов Тогда
		// Установим признак того, что при проведении, после проверок надо осуществить отказ,
		// т.к. не были пройдены проверки при записи.
		ОбъектДокумент.ДополнительныеСвойства.Вставить("УстановитьОтказПриПроведении");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Поиск просроченных товаров в табличной части
//
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - табличная часть документа.
//
// Возвращаемое значение:
// ТаблицаЗначений. Таблица, хранящая найденные просроченные серии.
//
Функция НайтиПросроченныеСерииВТабличнойЧастиСервер(ТабличнаяЧасть, Дата, ЭтоПересортица = Ложь)
	
	Результат = Новый ТаблицаЗначений;
	Если ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат ТабличнаяЧасть;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВнешняяТаблица.НомерСтроки КАК НомерСтроки,
	|	ВнешняяТаблица.Номенклатура КАК Номенклатура,
	|	ВнешняяТаблица.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ТабличнаяЧастьДокумента
	|ИЗ
	|	&ВнешняяТаблица КАК ВнешняяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабличнаяЧастьДокумента.НомерСтроки КАК НомерСтроки,
	|	ТабличнаяЧастьДокумента.Номенклатура КАК Номенклатура,
	|	ТабличнаяЧастьДокумента.Характеристика КАК Характеристика,
	|	СпрХарактеристики.ор_СерияПроизводителя КАК НомерСерии,
	|	СпрХарактеристики.ор_СрокГодности КАК СрокГодности
	|ИЗ
	|	ТабличнаяЧастьДокумента КАК ТабличнаяЧастьДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристики
	|		ПО ТабличнаяЧастьДокумента.Характеристика = СпрХарактеристики.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТабличнаяЧастьДокумента.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	СпрНоменклатура.КатегорияНоменклатуры.ор_ВестиСерийныйУчет
	|	И СпрХарактеристики.ор_СрокГодности <> &ПустаяДата
	|	И СпрХарактеристики.ор_СрокГодности < &Дата");
	
	Если ЭтоПересортица Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВнешняяТаблица.Номенклатура",
			"ВнешняяТаблица.НоменклатураОприходование");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВнешняяТаблица.Характеристика",
			"ВнешняяТаблица.ХарактеристикаОприходование");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВнешняяТаблица", ТабличнаяЧасть);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.УстановитьПараметр("Дата", КонецДня(?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса())));
	
	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
	Исключение
		Результат = Новый ТаблицаЗначений;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Функция - Загрузить данные аналогов
//
// Параметры:
//  Параметры	 - Структура - структура таблиц
// 
// Возвращаемое значение:
//  Структура - структура таблиц
//
Функция ЗагрузитьДанныеАналогов(Параметры) Экспорт
	
	Обработки.ор_ЗагрузкаАналогов.ЗагрузитьАналогиИзФайлаИлиПолучитьСписокЛистов(Параметры);
	
	Если Параметры.ЭтоЗаполнениеСпискаЛистов Тогда
		Возврат Параметры.ВыбранныеЛисты;
	Иначе
		
		СтруктураВозврата = Новый Структура();
		СтруктураВозврата.Вставить("ТаблицаЗагрузки", 		Параметры.ТаблицаЗагрузки);
		СтруктураВозврата.Вставить("ДеревоДляОтображения",	Параметры.ДеревоДляОтображения);
		СтруктураВозврата.Вставить("СопоставленныеАналоги", Параметры.СопоставленныеАналоги);
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

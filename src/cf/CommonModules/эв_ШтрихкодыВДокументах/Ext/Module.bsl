
#Область ПрограммныйИнтерфейс

// Возвращает имя программного реквизита штрихкода табличной части.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяРеквизитаШтрихкод() Экспорт
	
	Возврат "эв_Штрихкод";
	
КонецФункции

// Возвращает имя служебного реквизита ключа заполнения штрихкода.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяРеквизитаКлючШтрихкода() Экспорт
	
	Возврат "эв_ШтрихкодКлюч";
	
КонецФункции

// Добавляет на форму программный реквизит и колонку штрихкода табличной части.
// Предназначена для повторного использования в документах (Заказ покупателя, Чек ККМ, РМК).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа или обработки.
//  ИмяТаблицыФормы - Строка - имя элемента таблицы формы, например "Запасы".
//  ПутьКДаннымТаблицы - Строка - путь к данным таблицы, например "Объект.Запасы".
//  ИмяЭлементаПеред - Строка - имя элемента, перед которым вставляется колонка.
//
Процедура ДобавитьРеквизитШтрихкодНаФорму(Форма, ИмяТаблицыФормы, ПутьКДаннымТаблицы, ИмяЭлементаПеред = "") Экспорт
	
	ИмяРеквизита = ИмяРеквизитаШтрихкод();
	ИмяРеквизитаКлюч = ИмяРеквизитаКлючШтрихкода();
	ИмяЭлемента = ИмяТаблицыФормы + ИмяРеквизита;
	
	ТаблицаФормы = Форма.Элементы.Найти(ИмяТаблицыФормы);
	Если ТаблицаФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	Если Не РеквизитТаблицыСуществует(Форма, ПутьКДаннымТаблицы, ИмяРеквизита) Тогда
		НовыйРеквизит = Новый РеквизитФормы(
			ИмяРеквизита,
			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200)),
			ПутьКДаннымТаблицы,
			НСтр("ru = 'Штрихкод'"));
		МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	КонецЕсли;
	
	Если Не РеквизитТаблицыСуществует(Форма, ПутьКДаннымТаблицы, ИмяРеквизитаКлюч) Тогда
		НовыйРеквизит = Новый РеквизитФормы(
			ИмяРеквизитаКлюч,
			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(80)),
			ПутьКДаннымТаблицы);
		МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	КонецЕсли;
	
	Если МассивДобавляемыхРеквизитов.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	КонецЕсли;
	
	Если Форма.Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		
		ЭлементПеред = Неопределено;
		Если ЗначениеЗаполнено(ИмяЭлементаПеред) Тогда
			ЭлементПеред = Форма.Элементы.Найти(ИмяЭлементаПеред);
		КонецЕсли;
		
		НовыйЭлемент = Форма.Элементы.Вставить(
			ИмяЭлемента,
			Тип("ПолеФормы"),
			ТаблицаФормы,
			ЭлементПеред);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = ПутьКДаннымТаблицы + "." + ИмяРеквизита;
		НовыйЭлемент.ТолькоПросмотр = Истина;
		НовыйЭлемент.Ширина = 16;
		
	КонецЕсли;
	
	ЗаполнитьШтрихкодыТабличнойЧасти(ТабличнаяЧастьПоПути(Форма, ПутьКДаннымТаблицы));
	
КонецПроцедуры

// Заполняет штрихкоды во всех табличных частях объекта, где есть программный реквизит.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - объект формы документа.
//
Процедура ЗаполнитьШтрихкодыВОбъекте(Объект) Экспорт
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Ссылка") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧастьМетаданных Из Объект.Ссылка.Метаданные().ТабличныеЧасти Цикл
		
		ИмяТабличнойЧасти = ТабличнаяЧастьМетаданных.Имя;
		Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяТабличнойЧасти) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьШтрихкодыТабличнойЧасти(Объект[ИмяТабличнойЧасти]);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет реквизит штрихкода строк табличной части из регистра сведений ШтрихкодыНоменклатуры
// по номенклатуре и характеристике.
//
// Параметры:
//  ТабличнаяЧасть - ДанныеФормыКоллекция, ТабличнаяЧасть - табличная часть с номенклатурой.
//
Процедура ЗаполнитьШтрихкодыТабличнойЧасти(ТабличнаяЧасть) Экспорт
	
	ИмяРеквизита = ИмяРеквизитаШтрихкод();
	ИмяРеквизитаКлюч = ИмяРеквизитаКлючШтрихкода();
	
	Если ТабличнаяЧасть = Неопределено Или ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяСтрока = ТабличнаяЧасть[0];
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, ИмяРеквизита)
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, "Номенклатура") Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьХарактеристика = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, "Характеристика");
	ЕстьКлюч = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрока, ИмяРеквизитаКлюч);
	
	ТаблицаКлючей = Новый ТаблицаЗначений;
	ТаблицаКлючей.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКлючей.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаКлючей.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 0)));
	
	Для ИндексСтроки = 0 По ТабличнаяЧасть.Количество() - 1 Цикл
		
		СтрокаТаблицы = ТабличнаяЧасть[ИндексСтроки];
		СтрокаТаблицы[ИмяРеквизита] = "";
		Если ЕстьКлюч Тогда
			СтрокаТаблицы[ИмяРеквизитаКлюч] = КлючШтрихкода(
				СтрокаТаблицы.Номенклатура,
				?(ЕстьХарактеристика, СтрокаТаблицы.Характеристика, Неопределено));
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаКлюча = ТаблицаКлючей.Добавить();
		СтрокаКлюча.Номенклатура = СтрокаТаблицы.Номенклатура;
		Если ЕстьХарактеристика Тогда
			СтрокаКлюча.Характеристика = СтрокаТаблицы.Характеристика;
		КонецЕсли;
		СтрокаКлюча.ИндексСтроки = ИндексСтроки;
		
	КонецЦикла;
	
	Если ТаблицаКлючей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКлючей.Номенклатура КАК Номенклатура,
	|	ТаблицаКлючей.Характеристика КАК Характеристика,
	|	ТаблицаКлючей.ИндексСтроки КАК ИндексСтроки
	|ПОМЕСТИТЬ ТаблицаКлючей
	|ИЗ
	|	&ТаблицаКлючей КАК ТаблицаКлючей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	МИНИМУМ(ШтрихкодыНоменклатуры.Штрихкод) КАК Штрихкод
	|ПОМЕСТИТЬ ШтрихкодыПоКлючу
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура В
	|			(ВЫБРАТЬ
	|				ТаблицаКлючей.Номенклатура
	|			ИЗ
	|				ТаблицаКлючей КАК ТаблицаКлючей)
	|
	|СГРУППИРОВАТЬ ПО
	|	ШтрихкодыНоменклатуры.Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКлючей.ИндексСтроки КАК ИндексСтроки,
	|	ШтрихкодыПоКлючу.Штрихкод КАК Штрихкод
	|ИЗ
	|	ТаблицаКлючей КАК ТаблицаКлючей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ШтрихкодыПоКлючу КАК ШтрихкодыПоКлючу
	|		ПО ТаблицаКлючей.Номенклатура = ШтрихкодыПоКлючу.Номенклатура
	|			И ТаблицаКлючей.Характеристика = ШтрихкодыПоКлючу.Характеристика";
	
	Запрос.УстановитьПараметр("ТаблицаКлючей", ТаблицаКлючей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТабличнаяЧасть[Выборка.ИндексСтроки][ИмяРеквизита] = Выборка.Штрихкод;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает штрихкод номенклатуры из регистра сведений ШтрихкодыНоменклатуры.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Неопределено
//
// Возвращаемое значение:
//  Строка
//
Функция ШтрихкодПоНоменклатуре(Номенклатура, Характеристика = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат РегистрыСведений.ШтрихкодыНоменклатуры.ПолучитьШтрихкодПоНоменклатуре(Номенклатура, Характеристика);
	
КонецФункции

// Формирует ключ заполнения штрихкода по номенклатуре и характеристике.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Неопределено
//
// Возвращаемое значение:
//  Строка
//
Функция КлючШтрихкода(Номенклатура, Характеристика = Неопределено) Экспорт
	
	НоменклатураКлюч = "";
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НоменклатураКлюч = XMLСтрока(Номенклатура);
	КонецЕсли;
	
	ХарактеристикаКлюч = "";
	Если ЗначениеЗаполнено(Характеристика) Тогда
		ХарактеристикаКлюч = XMLСтрока(Характеристика);
	КонецЕсли;
	
	Возврат НоменклатураКлюч + "/" + ХарактеристикаКлюч;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РеквизитТаблицыСуществует(Форма, ПутьКДаннымТаблицы, ИмяРеквизита)
	
	РеквизитыТаблицы = Форма.ПолучитьРеквизиты(ПутьКДаннымТаблицы);
	Для Каждого РеквизитТаблицы Из РеквизитыТаблицы Цикл
		Если РеквизитТаблицы.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТабличнаяЧастьПоПути(Форма, ПутьКДаннымТаблицы)
	
	ТекущиеДанные = Форма;
	Для Каждого ЧастьПути Из СтрРазделить(ПутьКДаннымТаблицы, ".") Цикл
		ТекущиеДанные = ТекущиеДанные[ЧастьПути];
	КонецЦикла;
	
	Возврат ТекущиеДанные;
	
КонецФункции

#КонецОбласти

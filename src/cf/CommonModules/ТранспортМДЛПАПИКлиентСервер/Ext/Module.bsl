		// Массив серий.
		ПараметрыФильтрации.Вставить("1247_IC_Product_batch", Неопределено);
		
		// Статус ЛП.
		// Строка.
		// Необязательный.
		// Возможные значения:
		//  "ЛП отгружено новому владельцу";
		//  "На балансе текущего владельца (значение по умолчанию)".
		ПараметрыФильтрации.Вставить("1257_IC_Product_MDLP_stat_lp", Неопределено);
		
		// Тип срока годности.
		// Массив.
		// Необязательный.
		// Возможные значения:
		//  "Просрочено";
		//  "Остаток срока годности до 14 дней";
		//  "Остаток срока годности до месяца";
		//  "Остаток срока годности до 2х месяцев";
		//  "Остаток срока годности до 3х месяцев";
		//  "Остаток срока годности больше 3х месяцев"
		ПараметрыФильтрации.Вставить("1173_IC_Product_MDLP_expiration_lp", Неопределено);
		
		// Завершение периода окончания срока годности.
		// Строка.
		// Необязательный.
		// Значение по умолчанию: текущая дата минус 2 года.
		ПараметрыФильтрации.Вставить("0238_IC_Date_Start_period_8", Неопределено);
		
		// Начало периода окончания срока годности.
		// Строка.
		// Необязательный.
		// Значение по умолчанию: текущая дата плюс 2 года.
		ПараметрыФильтрации.Вставить("0239_IC_Date_Finish_period_8", Неопределено);
		
	КонецЕсли;
	
	ВозвращаемоеЗначение.Вставить("params", ПараметрыФильтрации);
	
	Возврат ВозвращаемоеЗначение;
	

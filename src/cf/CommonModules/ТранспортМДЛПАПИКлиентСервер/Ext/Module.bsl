// Параметры метода получения статусов заданий на выгрузку
// 
// Возвращаемое значение:
//  Структура - параметры.
//
Функция ПараметрыМетодаПолученияСтатусовЗаданийНаВыгрузку() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	// Пагинация.
	// Обязательный.
	// Структура:
	//  * page - Число - Страница пагинации. Для получения списка заданий на выгрузку с первой записи необходимо указать 0.
	//  * size - Число - Размер значений пагинации. Не может превышать 1000.
	ВозвращаемоеЗначение.Вставить("pagination", Новый Структура("page, size", 0, 1000));
	
	// Текущий статус задания.
	// Строка.
	// Необязательный.
	// Возможные значения:
	//  "PREPARATION" - "Подготовка";
	//  "COMPLETED" - "Выполнено";
	//  "FAILED" - "Не успешно".
	// Можно передавать несколько значений в строке, например: "PREPARATION,COMPLETED,FAILED".
	ВозвращаемоеЗначение.Вставить("current_statuses", Неопределено);
	
	// Наименования типов задания.
	// Массив.
	// Необязательный.
	// Возможные значения:
	//  general_pricing_report - Общий отчет по ценам
	//  general_report_on_movement - Общий отчет по движению ЛП
	//  general_report_on_remaining_items - Общий отчет по остаткам ЛП
	//  general_report_on_disposal - Общий отчет по выбытию ЛП
	//  virtual_warehouse_report - Мой виртуальный склад (новый)
	ВозвращаемоеЗначение.Вставить("report_ids", Неопределено);
	
	// Идентификаторы созданных заданий.
	// Массив.
	// Необязательный.
	ВозвращаемоеЗначение.Вставить("task_ids", Неопределено);
	
	// Дата создания (с).
	// Дата.
	// Необязательный.
	ВозвращаемоеЗначение.Вставить("create_dates_from", Неопределено);
	
	// Дата создания (по).
	// Дата.
	// Необязательный.
	ВозвращаемоеЗначение.Вставить("create_dates_to", Неопределено);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


//
// Возвращаемое значение:
//  Результат - Структура - ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации().
//                          Данные зависят от параметров выполнения задания.
//
Функция ВыполнитьЗаданиеНаВыгрузкуАналитическихДанных(ПараметрыПодключения, ПараметрыВыполненияЗадания) Экспорт
	
	#Если ВебКлиент Тогда
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(ПараметрыВыполненияЗадания);
		Возврат ТранспортМДЛПАПИВызовСервера.ВыполнитьМетодАПИ(ПараметрыПодключения, "ВыполнитьЗаданиеНаВыгрузкуАналитическихДанных", ПараметрыМетода);
	#Иначе
		
		ТипЗадания                          = ПараметрыВыполненияЗадания.ТипЗадания;
		ПараметрыСозданияЗадания            = ПараметрыВыполненияЗадания.ПараметрыСозданияЗадания;
		ВладелецЗадания                     = ПараметрыВыполненияЗадания.ВладелецЗадания;
		
		ПолучитьРезультатыЗадания           = ПараметрыВыполненияЗадания.ПолучитьРезультатыЗадания;
		ИзвлекатьИзАрхиваВСтруктуру         = ПараметрыВыполненияЗадания.ИзвлекатьИзАрхиваВСтруктуру;
		
		ЗагрузитьРезультатыЗадания          = ПараметрыВыполненияЗадания.ЗагрузитьРезультатыЗадания;
		ПараметрыЗагрузкиРезультатовЗадания = ПараметрыВыполненияЗадания.ПараметрыЗагрузкиРезультатовЗадания;
		
		Результат = ЗарегистрироватьЗаданиеНаВыгрузку(ПараметрыПодключения, ТипЗадания, ПараметрыСозданияЗадания, ВладелецЗадания);
		Если Результат.Статус = "Ошибка" Тогда
			Возврат ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации(Результат);
		КонецЕсли;
		
		ИдентификаторЗадания = Результат.Данные["task_id"];
		
		// Ожидание выполнения асинхронной задачи.
		Результат = ОжидатьВыполнениеЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторЗадания);
		Если Результат.Статус = "Ошибка" Тогда
			Возврат Результат;
		КонецЕсли;
		
		ИдентификаторВыгрузки = Результат.Данные["result_id"];
		
		Если ПолучитьРезультатыЗадания Тогда
			
			Результат = ПолучитьРезультатЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторВыгрузки);
			Если Результат.Статус = "Ошибка" Тогда
				Возврат ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации(Результат);
			КонецЕсли;
			
			Если ИзвлекатьИзАрхиваВСтруктуру Тогда
				Результат = ТранспортМДЛПАПИВызовСервера.ПолучитьДанныеЗаданияНаВыгрузкуИзАрхива(Результат.Данные);
			КонецЕсли;
			
		ИначеЕсли ЗагрузитьРезультатыЗадания Тогда
			
			// Загрузка результата задачи с проверками результата и выполнением соответствующих действий.
			Результат = ЗагрузитьРезультатЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторВыгрузки, ТипЗадания, ПараметрыЗагрузкиРезультатовЗадания);
			Если Результат.Статус = "Ошибка" Тогда
				Возврат ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации(Результат);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Результат;
		
	#КонецЕсли
	
КонецФункции

// Зарегистрировать задание на выгрузку
//
// Параметры:
//  ПараметрыПодключения      - Структура - параметры подключения к ИС "Маркировка.МДЛП".
//  ТипЗадания      - ПеречислениеСсылка.ТипыЗаданийНаВыгрузкуМДЛП - тип задания на выгрузку.
//  ПараметрыСозданияЗадания - Структура - параметры методов АПИ ИС МДЛП (см. ПараметрыМетодаСозданияНовогоЗаданияНаВыгрузку
//                                         и документацию АПИ к методам интеграции ИС МДЛП).
//  ВладелецЗадания - ЛюбаяСсылка, Строка - ссылка на объект или другой идентификатор, 
//                                          в разрезе которого можно зарегистрировать задание на выгрузку.
// 
// Возвращаемое значение:
//  Результат - Структура - ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации().
//                          Данные зависят от параметров выполнения задания.
//
Функция ЗарегистрироватьЗаданиеНаВыгрузку(ПараметрыПодключения, ТипЗадания, ПараметрыСозданияЗадания, ВладелецЗадания) Экспорт
	
	#Если ВебКлиент Тогда
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(ТипЗадания);
		ПараметрыМетода.Добавить(ПараметрыСозданияЗадания);
		ПараметрыМетода.Добавить(ВладелецЗадания);
		Возврат ТранспортМДЛПАПИВызовСервера.ВыполнитьМетодАПИ(ПараметрыПодключения, "ЗарегистрироватьЗаданиеНаВыгрузку", ПараметрыМетода);
	#Иначе
		
		Результат = ВыполнитьМетодСозданияНовогоЗаданияНаВыгрузку(ПараметрыПодключения, ПараметрыСозданияЗадания);
		
		Возврат Результат;
		
	#КонецЕсли
	
КонецФункции

// Ожидать выполнение задания на выгрузку
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения к ИС "Маркировка.МДЛП".
//  ИдентификаторЗадачи  - Строка - УИД задачи.
// 
// Возвращаемое значение:
//  Результат - Структура - ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации().
//                          Данные зависят от параметров выполнения задания.
//
Функция ОжидатьВыполнениеЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторЗадания) Экспорт
	
	#Если ВебКлиент Тогда
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(ИдентификаторЗадания);
		Возврат ТранспортМДЛПАПИВызовСервера.ВыполнитьМетодАПИ(ПараметрыПодключения, "ОжидатьВыполнениеЗаданияНаВыгрузку", ПараметрыМетода);
	#Иначе
		
		Таймаут(5000);
		
		// Цикл ожидания получения статуса выполнения задания на сервере.
		Пока Истина Цикл
			
			Результат = ВыполнитьМетодПолученияСтатусаЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторЗадания);
			Если Результат.Статус = "Ошибка" Тогда
				Возврат Результат;
			КонецЕсли;
			
			СтатусЗадания = Результат.Данные["current_status"];
			Если СтатусЗадания = "COMPLETED" Тогда
				
				// Задание выполнилось. Прекращаем ожидание.
				Прервать;
				
			ИначеЕсли СтатусЗадания = "FAILED" Тогда
				
				Результат = ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации();
				Результат.Статус = "Ошибка";
				Результат.ОписаниеОшибки = СтрШаблон("status %1: %2", СтатусЗадания, НСтр("ru = 'Ошибка получения статуса задания на выгрузку.'"));
				Возврат Результат;
				
			Иначе
				// Задача выполняется. Ожидаем пока не выполнится или не закончится период ожидания выполнения задачи.
			КонецЕсли;
			
		КонецЦикла;
		
		// Цикл ожидания получения результирующих идентификаторов выгрузок заданий на сервере.
		Пока Истина Цикл
			
			Результат = ВыполнитьМетодПолученияРезультирующихИдентификаторовВыгрузокДанных(ПараметрыПодключения, ИдентификаторЗадания);
			Если Результат.Статус = "Ошибка" Тогда
				Возврат Результат;
			КонецЕсли;
			
			Если Результат.Данные["total_count"] = 0 Тогда
				
				Результат = ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации();
				Результат.Статус = "Ошибка";
				Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось получить результирующие идентификаторы выгрузки данных.'");
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + Символы.ПС + НСтр("ru = 'Результат запроса:'");
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ТранспортМДЛПКлиентСервер.ПреобразоватьЗначениеВJSON(Результат.Данные);
				Возврат Результат;
				
			КонецЕсли;
			
			Задание = Результат.Данные["list"][0];
			
			СтатусЗадания = Задание["download_status"];
			ВозможностьСкачивания = Задание["available"];
			Если СтатусЗадания = "SUCCESS" И ВозможностьСкачивания = "AVAILABLE" Тогда
				
				// Задание выполнилось. Прекращаем ожидание.
				Данные = Новый Соответствие;
				Данные.Вставить("result_id", Задание["result_id"]);
				
				Результат = ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации();
				Результат.Вставить("Данные", Данные);
				
				Прервать;
				
			ИначеЕсли СтатусЗадания = "FAILED" Тогда
				
				Результат = ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации();
				Результат.Статус = "Ошибка";
				Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось получить результирующие идентификаторы выгрузки данных по причине:'");
				Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + Символы.ПС + СтрШаблон("status %1: %2", СтатусЗадания, Задание["error_message"]);
				Возврат Результат;
				
			Иначе
				// Задание выполняется. Ожидаем пока не выполнится или не закончится период ожидания выполнения задачи.
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат Результат;
		
	#КонецЕсли
	
КонецФункции

// Получить результат задания на выгрузку
//
// Параметры:
//  ПараметрыПодключения - Структура - параметры подключения к ИС "Маркировка.МДЛП".
//  ИдентификаторЗадачи  - Строка - УИД задачи.
// 
// Возвращаемое значение:
//  Результат - Структура - ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации().
//                          Данные зависят от параметров выполнения задания.
//
Функция ПолучитьРезультатЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторВыгрузки) Экспорт
	
	#Если ВебКлиент Тогда
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(ИдентификаторВыгрузки);
		Возврат ТранспортМДЛПАПИВызовСервера.ВыполнитьМетодАПИ(ПараметрыПодключения, "ПолучитьРезультатЗаданияНаВыгрузку", ПараметрыМетода);
	#Иначе
		
		// Получение данных результата выполнения задания.
		Результат = ВыполнитьМетодПолученияРезультатовЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторВыгрузки);
		Если Результат.Статус = "Ошибка" Тогда
			Возврат Результат;
		КонецЕсли;
		
		// Проверка наличия ошибок в результате выгрузки.
		КодОшибки = Результат.Данные["error_code"];
		ОписаниеОшибки = Результат.Данные["error_description"];
		
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			
			Результат = ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации();
			Результат.Статус = "Ошибка";
			Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось получить данные выгрузки по причине:'");
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + Символы.ПС + СтрШаблон("status %1: %2", КодОшибки, ОписаниеОшибки);
			Возврат Результат;
			
		КонецЕсли;
		
		Возврат Результат;
		
	#КонецЕсли
	
КонецФункции

// Загрузить результат задания на выгрузку
//
// Параметры:
//  ПараметрыПодключения     - Структура - параметры подключения к ИС "Маркировка.МДЛП".
//  ИдентификаторВыгрузки    - Строка - УИД задачи.
//  ТипЗадания               - ПеречислениеСсылка.ТипыЗаданийНаВыгрузкуМДЛП - тип задания на выгрузку.
//  ПараметрыСозданияЗадания - Структура - параметры методов АПИ ИС МДЛП (см. ПараметрыМетодаСозданияНовогоЗаданияНаВыгрузку
//                                         и документацию АПИ к методам интеграции ИС МДЛП).
// 
// Возвращаемое значение:
//  Результат - Структура - ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации().
//                          Данные зависят от параметров выполнения задания.
//
Функция ЗагрузитьРезультатЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторВыгрузки, ТипЗадания, ПараметрыЗагрузкиРезультатовЗадания) Экспорт
	
	#Если ВебКлиент Тогда
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(ИдентификаторВыгрузки);
		ПараметрыМетода.Добавить(ТипЗадания);
		ПараметрыМетода.Добавить(ПараметрыЗагрузкиРезультатовЗадания);
		Возврат ТранспортМДЛПАПИВызовСервера.ВыполнитьМетодАПИ(ПараметрыПодключения, "ЗагрузитьРезультатЗаданияНаВыгрузку", ПараметрыМетода);
	#Иначе
		
		Результат = ТранспортМДЛПАПИВызовСервера.ПроверитьВозможностьЗагрузкиДанныхРезультатовМетода(ТипЗадания);
		Если Результат.Статус = "Ошибка" Тогда
			Возврат Результат;
		КонецЕсли;
		
		// Получение исходных данных результата выполнения задачи.
		Результат = ВыполнитьМетодПолученияРезультатовЗаданияНаВыгрузку(ПараметрыПодключения, ИдентификаторВыгрузки);
		Если Результат.Статус = "Ошибка" Тогда
			Возврат Результат;
		КонецЕсли;
		
		// Проверка наличия ошибок в результате выгрузки.
		КодОшибки = Результат.Данные["error_code"];
		ОписаниеОшибки = Результат.Данные["error_description"];
		
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			
			Результат = ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации();
			Результат.Статус = "Ошибка";
			Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось получить данные выгрузки по причине:'");
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + Символы.ПС + СтрШаблон("status %1: %2", КодОшибки, ОписаниеОшибки);
			Возврат Результат;
			
		КонецЕсли;
		
		// Получение результата загрузки данных выполняемой задачи.
		Результат = ТранспортМДЛПАПИВызовСервера.ЗагрузитьДанныеРезультатовМетода(Результат.Данные, ПараметрыЗагрузкиРезультатовЗадания);
		Возврат Результат;
		
	#КонецЕсли
	
КонецФункции

// Параметры метода создания нового задания на выгрузку
//
// Параметры:
//  ТипЗадания - ПеречислениеСсылка.ТипыЗаданийНаВыгрузкуМДЛП - тип задания на выгрузку.
// 
// Возвращаемое значение:
//  Результат - Структура - ТранспортМДЛПКлиентСервер.РезультатВыполненияОперации().
//                          Данные зависят от параметров выполнения задания.
//
Функция ПараметрыМетодаСозданияНовогоЗаданияНаВыгрузку(ТипЗадания) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ИдентификаторТипаЗадания = ТранспортМДЛПАПИВызовСервера.ИдентификаторТипаЗаданийНаВыгрузку(ТипЗадания);
	Если Не ЗначениеЗаполнено(ИдентификаторТипаЗадания) Тогда
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ВозвращаемоеЗначение.Вставить("report_id", ИдентификаторТипаЗадания);
	
	ПараметрыФильтрации = Новый Соответствие;
	
	Если ТипЗадания = ПредопределенноеЗначение("Перечисление.ТипыЗаданийНаВыгрузкуМДЛП.ВыгрузкаОбщегоОтчетаПоЦенам") Тогда
		
		// Тип периода.
		// Обязательный. Допустимые значения:
		// "IC_Period_Week" - Неделя.
		// "IC_Period_Month" - Месяц;
		ПараметрыФильтрации.Вставить("1026_IC_Period_Type_WM", "IC_Period_Week");
		
		// Неделя.
		// Строка.
		// Обязательный, если не указано значение параметра 1027_IC_Period_Month_11_2019
		// или если в параметре "0616_IC_Operation_MDLP_period_all" ("Получить данные за последние две недели") указано значение, отличное от "true".
		// Указать период выгрузки в виде порядкового номера недели при отсчете с 1 января 1970 года.
		// В этом параметре недоступно указание двух последних недель.

// Открывает форму создания нового документа поступления товаров на основании уведомления о приемке.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой вызывается команда создания документа. Для автоматической подстановки
//         создаваемого документа в поле "Основание", форма должна быть передана в качестве владельца открываемой формы;
//  Ссылка - ДокументСсылка.Уведомление - ссылка на уведомление о поступлении.
//
Процедура ОткрытьФормуСозданияДокументаПоступленияТоваровНаОсновании(Форма, Ссылка) Экспорт
	
	// +ор интеграция МДЛП
	Если Форма.ИмяФормы = "Документ.УведомлениеОПриемкеМДЛП.Форма.ФормаДокумента" Тогда
		
		Если Форма.Объект.Операция = ПредопределенноеЗначение("Перечисление.ОперацииПриемкиМДЛП.Поступление")
			ИЛИ Форма.Объект.Операция = ПредопределенноеЗначение("Перечисление.ОперацииПриемкиМДЛП.ПоступлениеВРамкахАгентскогоДоговора")
			ИЛИ Форма.Объект.Операция = ПредопределенноеЗначение("Перечисление.ОперацииПриемкиМДЛП.ВозвратОтПокупателя") Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Основание", Ссылка);
			Форма.ОжидаетсяЗаписьДокументаОсновния = Истина;
			ОписаниеОповещения = Новый ОписаниеОповещения("ОформлениеДокументаОснованияЗавершение", Форма);
			ОткрытьФорму("Документ.ПриходнаяНакладная.Форма.ФормаДокумента", ПараметрыФормы, Форма);
		КонецЕсли;
		
	ИначеЕсли Форма.ИмяФормы = "Документ.УведомлениеОбОприходованииМДЛП.Форма.ФормаДокумента" Тогда
		
		Если Форма.Объект.Операция = ПредопределенноеЗначение("Перечисление.ОперацииОприходованияМДЛП.Пересорт") Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Основание", Ссылка);
			Форма.ОжидаетсяЗаписьДокументаОсновния = Истина;
			ОписаниеОповещения = Новый ОписаниеОповещения("ОформлениеДокументаОснованияЗавершение", Форма);
			ОткрытьФорму("Документ.ОприходованиеЗапасов.Форма.ФормаДокумента", ПараметрыФормы, Форма);
		КонецЕсли;
		
	КонецЕсли;

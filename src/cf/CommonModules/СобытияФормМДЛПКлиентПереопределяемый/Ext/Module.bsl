// Открывает форму выбора документа поступления товаров.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой вызывается команда выбора документа;
//  Объект - ДокументОбъект.Уведомление - уведомление для которого подбирается поступление;
//  ОповещениеПриЗавершении - ОписаниеОповещения - процедура, вызываемая после закрытия формы выбора;
//
Процедура ОткрытьФормуВыбораДокументаПоступлениеТоваров(Форма, Объект, ОповещениеПриЗавершении) Экспорт
	
	// +ор интеграция МДЛП
	Если Форма.ИмяФормы = "Документ.УведомлениеОПеремещенииМДЛП.Форма.ФормаДокумента" Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НомерДокумента"                  , Объект.НомерДокумента);
		СтруктураПараметров.Вставить("ДатаДокумента"                   , Объект.ДатаДокумента);
		СтруктураПараметров.Вставить("ОрганизацияМДЛП"                 , Объект.Организация);
		СтруктураПараметров.Вставить("МестоДеятельностиМДЛП"           , Объект.МестоДеятельности);
		СтруктураПараметров.Вставить("МестоДеятельностиПолучательМДЛП" , Объект.МестоДеятельностиПолучатель);
		СтруктураПараметров.Вставить("ЭтоОрдер"                        , Ложь);
		
		МассивДокументов = ор_ИнтеграцияМДЛП.ПолучитьСписокВыбораДляСвязыванияУведомленияОПеремещенииТоваров(СтруктураПараметров);
		
		ПараметрыОтбор = Новый Структура("Ссылка", МассивДокументов);
		ПараметрыФормы = Новый Структура("Отбор", ПараметрыОтбор);
		
		ОткрытьФорму("Документ.ПеремещениеЗапасов.ФормаВыбора",
			ПараметрыФормы,
			Форма,
			,
			,
			,
			ОповещениеПриЗавершении,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Форма.ИмяФормы = "Документ.УведомлениеОбОприходованииМДЛП.Форма.ФормаДокумента" Тогда
		
		Если Форма.Объект.Операция = ПредопределенноеЗначение("Перечисление.ОперацииОприходованияМДЛП.Пересорт") Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("ОрганизацияМДЛП"      , Объект.Организация);
			СтруктураПараметров.Вставить("МестоДеятельностиМДЛП", Объект.МестоДеятельности);
			
			МассивДокументов = ор_ИнтеграцияМДЛП.ПолучитьСписокВыбораДляСвязыванияУведомленияОбОприходованииМДЛП(СтруктураПараметров);
			
			ПараметрыОтбор = Новый Структура("Ссылка", МассивДокументов);
			ПараметрыФормы = Новый Структура("Отбор", ПараметрыОтбор);
			
			ОткрытьФорму("Документ.ОприходованиеЗапасов.ФормаВыбора",
				ПараметрыФормы,
				Форма,
				,
				,
				,
				ОповещениеПриЗавершении,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли;
	// -ор интеграция МДЛП
	
КонецПроцедуры


// Требуется реализовать получение данных связанной номенклатуры.
//
// Параметры:
//  Данные - Структура - 
//    * Штрихкод - Строка - представление исходного штрихкода;
//    * GTIN - Строка - код товара;
//    * SGTIN - Строка - уникальный код упаковки;
// 
// Возвращаемое значение:
//   - Структура
//      * Номенклатура
//      * Характеристика
//      * Упаковка
//
Функция ПолучитьДанныеНоменклатурыПоКиЗ(Данные) Экспорт
	
	// +ор интеграция МДЛП
	СтруктураВозврата = Новый Структура();
	
	НайденнаяВСправочнике = ор_ИнтеграцияМДЛП.НайтиНоменклатуруПоНомеруИКлючуУпаковки(Данные);
	Если НайденнаяВСправочнике <> Неопределено Тогда
		
		СтруктураВозврата.Вставить("Номенклатура", НайденнаяВСправочнике.Номенклатура);
		Если ЗначениеЗаполнено(НайденнаяВСправочнике.Характеристика) Тогда
			СтруктураВозврата.Вставить("Характеристика",НайденнаяВСправочнике.Характеристика);
		КонецЕсли;
		
		СтруктураВозврата.Вставить("Упаковка");
		ор_ИнтеграцияМДЛПКлиентСервер.ЗаполнитьСлужебныеРеквизитыНоменклатуры(СтруктураВозврата);
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	Номенклатура = ор_ИнтеграцияМДЛП.НайтиНоменклатруПоGTIN(Данные.GTIN);
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		
		СтруктураВозврата.Вставить("Номенклатура", Номенклатура);
		
		Характеристика = ор_ИнтеграцияМДЛП.НайтиХарактеристикуПоСерииИСроку(Номенклатура, Данные);
		Если ЗначениеЗаполнено(Характеристика) Тогда
			СтруктураВозврата.Вставить("Характеристика", Характеристика);
		КонецЕсли;
		
		СтруктураВозврата.Вставить("Упаковка");
		ор_ИнтеграцияМДЛПКлиентСервер.ЗаполнитьСлужебныеРеквизитыНоменклатуры(СтруктураВозврата);
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	// -ор интеграция МДЛП
	
КонецФункции



#Область ПрограммныйИнтерфейс

#Область ОбработчикиСобытийФормы

// Возникает на клиенте перед выполнением записи объекта из формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма записываемого объекта,
//  Отказ - Булево - признак отказа от записи,
//  ПараметрыЗаписи - Структура - структура, содержащая параметры записи.
//
Процедура ПередЗаписью(Форма, Отказ, ПараметрыЗаписи) Экспорт
	
	// +ор интеграция МДЛП
	Если Форма.ИмяФормы = "РегистрСведений.СубъектыОбращенияМДЛП.Форма.ФормаЗаписи" Тогда
		
		Если Форма.Запись.СобственнаяОрганизация И Не ЗначениеЗаполнено(Форма.Запись.МестоДеятельности) Тогда
			ТекстСообщения = НСтр("ru = 'Место деятельности не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "МестоДеятельности", "Запись", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	// -ор интеграция МДЛП
	
КонецПроцедуры

// Вызывается во всех созданных формах при вызове метода Оповестить.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - оповещаемая форма,
//  ИмяСобытия - Строка - имя события,
//  Параметр - Произвольный - параметр сообщения. Могут быть переданы любые необходимые данные,
//  Источник - Произвольный - источник события.
//
Процедура ОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник) Экспорт
	
	// +ор интеграция МДЛП
	Если Форма.ИмяФормы = "Документ.УведомлениеОПриемкеМДЛП.Форма.ФормаДокумента" Тогда
		
		Если ИмяСобытия = "ВыполненоСопоставлениеЗаполнениеМДЛП" И Параметр = Форма.Объект.Ссылка Тогда
			Форма.Прочитать();
			Форма.ОбновитьСтатусУведомленияЭкспорт();
		КонецЕсли;
		
	КонецЕсли;
	// -ор интеграция МДЛП
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Выполняет действия при изменении номенклатуры в таблице Товары.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой произошло событие,
//  ТекущаяСтрока - ДанныеФормыЭлементКоллекции - строка таблицы товаров,
//  КэшированныеЗначения - Структура - сохраненные значения параметров, используемых при обработке,
//  ПараметрыЗаполнения - Структура - см. функцию ИнтеграцияМДЛПКлиентСервер.ПараметрыЗаполненияТабличнойЧасти.
//
Процедура ПриИзмененииНоменклатуры(Форма, ТекущаяСтрока, КэшированныеЗначения, ПараметрыЗаполнения) Экспорт
	
	// +ор интеграция МДЛП
	Если НЕ ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(ТекущаяСтрока.Номенклатура) Тогда
		ТекстСообщения = НСтр("ru = 'Для выбранной номенклатуры не ведется учет маркируемых товаров.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		ТекущаяСтрока.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	КонецЕсли;
	
	ор_ИнтеграцияМДЛПКлиентСервер.ОбработатьИзменениеСтрокиПоПараметрамЗаполнения(ТекущаяСтрока, ПараметрыЗаполнения);
	ор_ИнтеграцияМДЛПКлиентСервер.ЗаполнитьСлужебныеРеквизитыНоменклатуры(ТекущаяСтрока);
	// -ор интеграция МДЛП
	
КонецПроцедуры

// Выполняет действия при изменении характеристики в таблице Товары.

	|	втШтрихкодыИтог.Штрихкод,
	|	втШтрихкодыИтог.ТипОбъекта,
	|	втШтрихкодыИтог.ШаблонШтрихкода,
	|	втШтрихкодыИтог.Характеристика,
	|	втШтрихкодыИтог.НомерСтроки";
	
	ДоплнитьЗапросПоискаПоШтрихкодуОстатки(ТекстЗапроса, ПолучатьОстатокПоХарактеристикам);
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	втШтрихкоды.НомерСтроки КАК НомерСтроки,
	|	втШтрихкоды.Владелец КАК Владелец,

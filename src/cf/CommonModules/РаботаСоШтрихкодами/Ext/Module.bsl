		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ТаблицаИтоговоеКоличество.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВсегоОстаток
		|ИЗ
		|	ТаблицаИтоговоеКоличество КАК ТаблицаИтоговоеКоличество
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаИтог.НомерСтроки КАК НомерСтроки,
		|	ТаблицаИтог.Владелец КАК Владелец,
		|	ТаблицаИтог.Характеристика КАК Характеристика,
		|	ТаблицаИтог.Упаковка КАК Упаковка,
		|	ТаблицаИтог.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ТаблицаИтог.Партия КАК Партия,
		|	ТаблицаИтог.Количество КАК Количество,
		|	ТаблицаИтог.Штрихкод КАК Штрихкод,
		|	ТаблицаИтог.ТипОбъекта КАК ТипОбъекта,
		|	ТаблицаИтог.ШаблонШтрихкода КАК ШаблонШтрихкода
		|ПОМЕСТИТЬ втНоменклатураОстаткиИтог
		|ИЗ
		|	ТаблицаИтог КАК ТаблицаИтог,
		|	ВсегоОстаток
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ТаблицаИтог.Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				ТОГДА ВЫБОР
		|						КОГДА ТаблицаИтог.КоличествоОстаток > 0
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ВсегоОстаток.КоличествоОстаток = 0
		|					КОНЕЦ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьЗначениеСтрокойТовара(СтрокаЗначения, СтруктураПараметров, ПустаяСтрокаТаблицыТоваров = Неопределено) Экспорт
	
	РеквизитыФормыРМК = СтруктураПараметров.РеквизитыФормыРМК;
	Если ПустаяСтрокаТаблицыТоваров = Неопределено Тогда
		ПустаяСтрокаТаблицыТоваров = РеквизитыФормыРМК.ПустаяСтрокаТаблицыТоваров;
	КонецЕсли;
	
	ПараметрыДляОбработкиШтрихкода = Неопределено;
	НайденнаяНоменклатура = Неопределено;
	ШтрихкодированиеРМКПереопределяемый.ЗаполнитьДанныеНайденнойНоменклатуры(
		СтрокаЗначения, РеквизитыФормыРМК, ПараметрыДляОбработкиШтрихкода, НайденнаяНоменклатура);
		
	Если НЕ НайденнаяНоменклатура = Неопределено Тогда
		
		ДанныеКонтроляПродаж = ?(РеквизитыФормыРМК.ИспользоватьКонтрольПродаж, Новый Структура, Неопределено);
		ДополнительныеДанные = Новый Структура("ДанныеКонтроляПродаж", ДанныеКонтроляПродаж);
		ДополнительныеДанные.Вставить("Характеристика", Неопределено);
		ДополнительныеДанные.Вставить("ИспользоватьВыборСкладаПриПродаже", РеквизитыФормыРМК.ИспользоватьВыборСкладаПриПродаже);
		ДополнительныеДанные.Вставить("ТорговыйОбъект", РеквизитыФормыРМК.Объект.ТорговыйОбъект);
		ДополнительныеДанные.Вставить("РежимКассыСамообслуживания", РеквизитыФормыРМК.РежимКассыСамообслуживания);
		
		ДанныеУточненияПринадлежностиЗапасов = ?(РеквизитыФормыРМК.ИспользоватьУточненияПринадлежностиЗапасов, Новый Соответствие, Неопределено);
		ДополнительныеДанные.Вставить("ДанныеУточненияПринадлежностиЗапасов", ДанныеУточненияПринадлежностиЗапасов);
		
		Если СтрокаЗначения.Свойство("Характеристика") Тогда
			ДополнительныеДанные.Характеристика = СтрокаЗначения.Характеристика;
		КонецЕсли;
		
		НайденнаяНоменклатура.Вставить("РеквизитыФормыРМК", РеквизитыФормыРМК);
		СтрокаТовара = ПродажиРМК.СтрокаТовара(НайденнаяНоменклатура, ДополнительныеДанные);
		СтрокаЗначения.Вставить("СтрокаТовара", СтрокаТовара);
		СтрокаЗначения.Вставить("СтруктураНайденнойНоменклатуры", НайденнаяНоменклатура);
		Если СтрокаЗначения.Свойство("ДополнительныеДанные") Тогда
			СтрокаЗначения.ДополнительныеДанные.Вставить("СтрокаТовара", СтрокаТовара);
			СтрокаЗначения.ДополнительныеДанные.Вставить("СтруктураНайденнойНоменклатуры", НайденнаяНоменклатура);
		КонецЕсли;
		
		Если Не ДополнительныеДанные.ДанныеКонтроляПродаж = Неопределено Тогда
			ИнтерфейсРМКСлужебныйКлиентСервер.ДобавитьНовыеДанныеКэшаПродаж(СтруктураПараметров.ДанныеКонтроляПродаж,
				ДополнительныеДанные.ДанныеКонтроляПродаж);
		КонецЕсли;
			
		Если Не ДополнительныеДанные.ДанныеУточненияПринадлежностиЗапасов = Неопределено Тогда
			ИнтерфейсРМКСлужебныйКлиентСервер.ДобавитьНовыеДанныеКэшаУточненияПринадлежностиЗапасов(СтруктураПараметров.ДанныеУточненияПринадлежностиЗапасов,
				ДополнительныеДанные.ДанныеУточненияПринадлежностиЗапасов);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

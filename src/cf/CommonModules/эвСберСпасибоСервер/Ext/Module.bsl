   		 НадписьRRN.Видимость = Ложь;
   		 НадписьRRN.АвтоМаксимальнаяШирина = Ложь;
   		 НадписьRRN.РастягиватьПоГоризонтали = Истина;
   		 НадписьRRN.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
   		 НадписьRRN.Шрифт = ШрифтыСтиля.ШрифтОбычныйПолужирный12РМК;
   		 
   	 КонецЕсли;
    КонецЕсли;
    
    Если Форма.Элементы.Найти("ТоварыэвНеВходитВАссортиментСберСпасибо") = Неопределено Тогда
   	 ТаблицаТовары = Форма.Элементы.Найти("Товары");
   	 Если НЕ ТаблицаТовары = Неопределено Тогда
   		 ПолеПризнака = Форма.Элементы.Добавить("ТоварыэвНеВходитВАссортиментСберСпасибо", Тип("ПолеФормы"), ТаблицаТовары);
   		 ПолеПризнака.Вид = ВидПоляФормы.ПолеФлажка;
   		 ПолеПризнака.ПутьКДанным = "Объект.Товары.эвНеВходитВАссортиментСберСпасибо";
   		 ПолеПризнака.Видимость = Ложь;
   		 ПолеПризнака.ТолькоПросмотр = Истина;
   		 ПолеПризнака.ПропускатьПриВводе = Истина;
   	 КонецЕсли;
    КонецЕсли;

КонецПроцедуры

Функция эв_РассчитатьМаксСуммаОплатыСпасибоНаСервере(Товары, МаксПроцентОплатыБонусами) Экспорт
	
	Если МаксПроцентОплатыБонусами = 0 Тогда
	    Возврат 0;
	КонецЕсли;    
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	Товары.СуммаБезСкидки КАК СуммаБезСкидки
	|ПОМЕСТИТЬ ТаблицаВЗапросе
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ТаблицаВЗапросе.СуммаБезСкидки * &МаксПроцентОплатыБонусами / 100), 0) КАК Сумма
	|ИЗ
	|	ТаблицаВЗапросе КАК ТаблицаВЗапросе
	|ГДЕ
	|	НЕ ТаблицаВЗапросе.Номенклатура.эвНеВходитВАссортиментСберСпасибо";
	
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("МаксПроцентОплатыБонусами", МаксПроцентОплатыБонусами);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Окр(Выборка.Сумма, 0);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция эв_ПолучитьМаксПроцентОплатыБонусамиНаСервере(КассаККМ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СпособыОплаты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Терминалы
	|ИЗ
	|	Справочник.СпособыОплаты КАК СпособыОплаты
	|ГДЕ
	|	(ВЫРАЗИТЬ(СпособыОплаты.Касса КАК Справочник.КассыККМ)) = &КассаККМ
	|	И НЕ СпособыОплаты.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(эвПараметрыЭквайринкогоТерминалаСпасибо.МаксимальныйПроцентОплатыБонусами) КАК МаксимальныйПроцентОплатыБонусами
	|ИЗ
	|	Справочник.эвПараметрыЭквайринкогоТерминалаСпасибо КАК эвПараметрыЭквайринкогоТерминалаСпасибо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Терминалы КАК ВТ_Терминалы
	|		ПО эвПараметрыЭквайринкогоТерминалаСпасибо.Владелец = ВТ_Терминалы.Ссылка
	|ГДЕ
	|	НЕ эвПараметрыЭквайринкогоТерминалаСпасибо.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Окр(Выборка.МаксимальныйПроцентОплатыБонусами, 0);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция эв_ПолучитьПараметрыТерминалаСпасибоСервер(Терминал) Экспорт
	
	Пар = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.networks КАК networks,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.partners КАК partners,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.НомерТерминала КАК НомерТерминала,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.servicePointExtId КАК servicePointExtId,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.Сертификат КАК Сертификат,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.ПарольСертификата КАК ПарольСертификата,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.АдресПроцессинга КАК АдресПроцессинга,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.P_DistribPath КАК P_DistribPath,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.ОднаФиктивнаяПозиция КАК ОднаФиктивнаяПозиция,
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.МаксимальныйПроцентОплатыБонусами КАК МаксимальныйПроцентОплатыБонусами
		|ИЗ
		|	Справочник.эвПараметрыЭквайринкогоТерминалаСпасибо КАК эвПараметрыЭквайринкогоТерминалаСпасибо
		|ГДЕ
		|	эвПараметрыЭквайринкогоТерминалаСпасибо.ПометкаУдаления = ЛОЖЬ
		|	И эвПараметрыЭквайринкогоТерминалаСпасибо.Владелец = &Терминал";
	
	Запрос.УстановитьПараметр("Терминал", Терминал);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Пар.Вставить("АдресПроцессинга",  ВыборкаДетальныеЗаписи.АдресПроцессинга);
		Пар.Вставить("networks",          ВыборкаДетальныеЗаписи.networks);
		Пар.Вставить("partners",          ВыборкаДетальныеЗаписи.partners);
		Пар.Вставить("НомерТерминала",    ВыборкаДетальныеЗаписи.НомерТерминала);
		Пар.Вставить("servicePointExtId", ВыборкаДетальныеЗаписи.servicePointExtId);
		Пар.Вставить("ПарольСертификата", ВыборкаДетальныеЗаписи.ПарольСертификата); 
		Пар.Вставить("P_DistribPath",     ВыборкаДетальныеЗаписи.P_DistribPath); 
		Пар.Вставить("ОднаФиктивнаяПозиция", ВыборкаДетальныеЗаписи.ОднаФиктивнаяПозиция); 
		Пар.Вставить("МаксимальныйПроцентОплатыБонусами", ВыборкаДетальныеЗаписи.МаксимальныйПроцентОплатыБонусами); 
		Если ТипЗнч(ВыборкаДетальныеЗаписи.Сертификат) = Тип("ХранилищеЗначения") Тогда
			ХЗ = ВыборкаДетальныеЗаписи.Сертификат.Получить();
			Если ХЗ = Неопределено Тогда
				Пар.Вставить("АдресСертификата", Неопределено);
			Иначе
				Пар.Вставить("АдресСертификата",  ПоместитьВоВременноеХранилище(ХЗ, Новый УникальныйИдентификатор));
			КонецЕсли; 
		Иначе
			Пар.Вставить("АдресСертификата", Неопределено);
		КонецЕсли;
		
	Иначе	
		Пар = Неопределено;
	КонецЕсли;
	
    Возврат Пар;
	
КонецФункции // ПолучитьПараметрыТерминалаСпасибо()

Функция эв_ПолучитьПараметрыПроверкиДоступаКПроцессингуПоКассеККМ(КассаККМ, УникальныйИдентификаторФормы) Экспорт
    
    Если Не ЗначениеЗаполнено(КассаККМ) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   СпособыОплаты.Ссылка КАК Ссылка
    |ПОМЕСТИТЬ ВТ_Терминалы
    |ИЗ
    |   Справочник.СпособыОплаты КАК СпособыОплаты
    |ГДЕ
    |   (ВЫРАЗИТЬ(СпособыОплаты.Касса КАК Справочник.КассыККМ)) = &КассаККМ
    |   И НЕ СпособыОплаты.ПометкаУдаления
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |   эвПараметрыЭквайринкогоТерминалаСпасибо.АдресПроцессинга КАК АдресПроцессинга,
    |   эвПараметрыЭквайринкогоТерминалаСпасибо.ПарольСертификата КАК ПарольСертификата,
    |   эвПараметрыЭквайринкогоТерминалаСпасибо.Сертификат КАК Сертификат,
    |   эвПараметрыЭквайринкогоТерминалаСпасибо.networks КАК networks,
    |   эвПараметрыЭквайринкогоТерминалаСпасибо.partners КАК partners
    |ИЗ
    |   Справочник.эвПараметрыЭквайринкогоТерминалаСпасибо КАК эвПараметрыЭквайринкогоТерминалаСпасибо
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Терминалы КАК ВТ_Терминалы
    |       ПО эвПараметрыЭквайринкогоТерминалаСпасибо.Владелец = ВТ_Терминалы.Ссылка
    |ГДЕ
    |   НЕ эвПараметрыЭквайринкогоТерминалаСпасибо.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ПараметрыПроверки = Новый Структура;
    ПараметрыПроверки.Вставить("АдресПроцессинга", Выборка.АдресПроцессинга);
    ПараметрыПроверки.Вставить("ПарольСертификата", Выборка.ПарольСертификата);
    ПараметрыПроверки.Вставить("networks", Выборка.networks);
    ПараметрыПроверки.Вставить("partners", Выборка.partners);
    
    АдресСертификата = Неопределено;
    Если ТипЗнч(Выборка.Сертификат) = Тип("ХранилищеЗначения") Тогда
        ДанныеСертификата = Выборка.Сертификат.Получить();
        Если ДанныеСертификата <> Неопределено Тогда
            АдресСертификата = ПоместитьВоВременноеХранилище(ДанныеСертификата, УникальныйИдентификаторФормы);
        КонецЕсли;
    КонецЕсли;
    ПараметрыПроверки.Вставить("АдресСертификата", АдресСертификата);
    
    Возврат ПараметрыПроверки;
    
КонецФункции


// Добавляет сообщение в пакет и запускает запись в Эв_ЛогСпасибо фоновым заданием.
// С клиента передаётся готовый МассивЛогов (цикл обмена); с сервера — один элемент.
// Элемент: ДатаОперации, Идентификатор, ЭтоОшибка, Сообщение.
// Регистр: измерения ДатаОперации, Идентификатор, Тип; ресурс Сообщение.
//
Процедура ЗаписатьЛогСпасибо(ТекстСообщения, ЭтоОшибка = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементЛога = Новый Структура;
	ЭлементЛога.Вставить("ДатаОперации", ТекущаяДатаСеанса());
	ЭлементЛога.Вставить("Идентификатор", Новый УникальныйИдентификатор);
	ЭлементЛога.Вставить("ЭтоОшибка", ЭтоОшибка);
	ЭлементЛога.Вставить("Сообщение", ТекстСообщения);
	
	МассивЛогов = Новый Массив;
	МассивЛогов.Добавить(ЭлементЛога);
	
	ЗапуститьЗаписьЛоговСпасибоВФоне(МассивЛогов);
	
КонецПроцедуры

// Запускает фоновую запись пакета логов. Вызывается с клиента после цикла обмена.
//
Процедура ЗапуститьЗаписьЛоговСпасибоВФоне(МассивЛогов) Экспорт
	
	Если МассивЛогов = Неопределено Или МассивЛогов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(МассивЛогов);
	
	ФоновыеЗадания.Выполнить(
		"эвСберСпасибоСервер.ЗаписатьЛогиСпасибоФоном",
		ПараметрыЗадания,
		,
		НСтр("ru = 'Запись логов Спасибо'"));
	
КонецПроцедуры

// Запись пакета логов в регистр сведений Эв_ЛогСпасибо (вызывается фоновым заданием).
//
Процедура ЗаписатьЛогиСпасибоФоном(МассивЛогов) Экспорт
	
	Если МассивЛогов = Неопределено Или МассивЛогов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого ЭлементЛога Из МассивЛогов Цикл
			
			МенеджерЗаписи = РегистрыСведений.Эв_ЛогСпасибо.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ДатаОперации = ЭлементЛога.ДатаОперации;
			МенеджерЗаписи.Идентификатор = ЭлементЛога.Идентификатор;
			МенеджерЗаписи.Тип = ?(ЭлементЛога.ЭтоОшибка,
				Перечисления.эв_ТипыСообщенийЛога.Ошибка,
				Перечисления.эв_ТипыСообщенийЛога.Сервисное);
			МенеджерЗаписи.Сообщение = ЭлементЛога.Сообщение;
			МенеджерЗаписи.Записать(Истина);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

// Распределяет сумму списания Спасибо по строкам ТЧ Товары как СуммаСкидкиОплатыБонусом
// (только по ассортименту Спасибо), пересчитывает Сумма и НДС.
// Сопоставление строк — по индексам отобранных строк исходной ТЧ (без ор_ИдентификаторСтроки).
//
Процедура РаспределитьСуммуСпасибоПоТоварам(ОбъектЧека, СуммаОперацииСпасибо) Экспорт
    
    Если СуммаОперацииСпасибо <= 0 Тогда
        Возврат;
    КонецЕсли;
    
    // Индексы строк ОбъектЧека.Товары, участвующих в ассортименте Спасибо.
    ИндексыСтрокСпасибо = Новый Массив;
    СуммаТоваровСпасибо = 0;
    
    ИндексСтроки = 0;
    Для Каждого Стр Из ОбъектЧека.Товары Цикл
        
        Если Не Стр.Номенклатура.эвНеВходитВАссортиментСберСпасибо Тогда
            
            ИндексыСтрокСпасибо.Добавить(ИндексСтроки);
            СуммаТоваровСпасибо = СуммаТоваровСпасибо
                + Стр.Цена * Стр.Количество
                - Стр.СуммаАвтоматическойСкидки
                - Стр.СуммаСкидкиНаценки;
            
        КонецЕсли;
        
        ИндексСтроки = ИндексСтроки + 1;
        
    КонецЦикла;
    
    СтрокСпасибо = ИндексыСтрокСпасибо.Количество();
    Если СтрокСпасибо = 0 Или СуммаТоваровСпасибо <= 0 Тогда
        Возврат;
    КонецЕсли;
    
    СуммаОперацииСпасибоОстаток = СуммаОперацииСпасибо;
    
    Для НомерПоПорядку = 0 По СтрокСпасибо - 1 Цикл
        
        Если СуммаОперацииСпасибоОстаток <= 0 Тогда
            Прервать;
        КонецЕсли;
        
        Стр = ОбъектЧека.Товары[ИндексыСтрокСпасибо[НомерПоПорядку]];
        
        Если НомерПоПорядку = СтрокСпасибо - 1 Тогда
            СуммаСкидкиОплатыБонусом = СуммаОперацииСпасибоОстаток;
        Иначе
            БазаСтроки = Стр.Цена * Стр.Количество
                - Стр.СуммаАвтоматическойСкидки
                - Стр.СуммаСкидкиНаценки;
            КоэфСписания = БазаСтроки / СуммаТоваровСпасибо;
            СуммаСкидкиОплатыБонусом = Окр(СуммаОперацииСпасибо * КоэфСписания, 2);
        КонецЕсли;
        
        Стр.СуммаСкидкиОплатыБонусом = СуммаСкидкиОплатыБонусом;
        Стр.Сумма = Стр.Цена * Стр.Количество
            - Стр.СуммаСкидкиОплатыБонусом
            - Стр.СуммаАвтоматическойСкидки
            - Стр.СуммаСкидкиНаценки;
        
     	// Как в ФормаРМК при распределении оплаты бонусами.
        ОбщегоНазначенияРМККлиентСервер.РассчитатьСуммуНДС(ОбъектЧека, Стр);
        
        СуммаОперацииСпасибоОстаток = СуммаОперацииСпасибоОстаток - СуммаСкидкиОплатыБонусом;
        
    КонецЦикла;
    
    //ОбщегоНазначенияРМККлиентСервер.СуммаДокумента(ОбъектЧека);
    
КонецПроцедуры

Функция ДанныеОплатыЧекаПродажиДляСпасибо(ЧекККМПродажа) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторПлатежнойСистемы", "");
	Результат.Вставить("СуммаБонусовВозврата", 0);
	
	Если Не ЗначениеЗаполнено(ЧекККМПродажа) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	//|	Оплата.ВидОплаты КАК ВидОплаты,
	|	Оплата.ИдентификаторПлатежнойСистемы КАК ИдентификаторПлатежнойСистемы
	//|	Оплата.СуммаБонусов КАК СуммаБонусов,
	//|	Оплата.Сумма КАК Сумма
	|ИЗ
	|	Документ.ЧекККМ.БезналичнаяОплата КАК Оплата
	|ГДЕ
	|	Оплата.Ссылка = &ЧекККМПродажа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Оплата.НомерСтроки";
	Запрос.УстановитьПараметр("ЧекККМПродажа", ЧекККМПродажа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Результат.ИдентификаторПлатежнойСистемы)
			И ЗначениеЗаполнено(Выборка.ИдентификаторПлатежнойСистемы) Тогда
			Результат.ИдентификаторПлатежнойСистемы = Выборка.ИдентификаторПлатежнойСистемы;
		КонецЕсли;
		
		//Если Выборка.ВидОплаты = Перечисления.ВидыБезналичныхОплат.Бонусы Тогда
		//	Результат.СуммаБонусовВозврата = ?(Выборка.СуммаБонусов > 0, Выборка.СуммаБонусов, Выборка.Сумма);
		//КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
            "МаксСуммаОплатыСпасибо",
            Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)),
            ,
            "Спасибо"));
        

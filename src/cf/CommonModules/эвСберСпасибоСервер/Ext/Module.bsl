    Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "эвНеВходитВАссортиментСберСпасибо") Тогда
   	 
        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
        	"эвНеВходитВАссортиментСберСпасибо",
        	Новый ОписаниеТипов("Булево"),
        	"Объект.Товары",
        	НСтр("ru = 'Не входит в ассортимент СберСпасибо'"))); 
        
    КонецЕсли;


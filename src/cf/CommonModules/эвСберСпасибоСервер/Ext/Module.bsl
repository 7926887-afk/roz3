   		 ПолеСпасибо.ТолькоПросмотр = Истина;
   		 ПолеСпасибо.ПропускатьПриВводе = Истина;
   		 ПолеСпасибо.Гиперссылка = Ложь;
   		 
   	 КонецЕсли;

   		 ПолеСпасибо.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
   		 ПолеСпасибо.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
   		 ПолеСпасибо.Высота = 1;
   		 ПолеСпасибо.Ширина = 10;
   		 ПолеСпасибо.АвтоМаксимальнаяШирина = Ложь;
   		 ПолеСпасибо.РастягиватьПоГоризонтали = Ложь;

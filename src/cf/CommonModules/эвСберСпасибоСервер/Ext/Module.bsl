

Функция эв_СоединитьсяСПроцессингом(Выборка) Экспорт
	
	ssl = Неопределено;
	
	Если ТипЗнч(Выборка) = Тип("Структура") И Выборка.Свойство("АдресПроцессинга") Тогда
		
		ПараметрыТерминала = Выборка;
		end_point          = Выборка.АдресПроцессинга; 
		
	Иначе // Выборка из очереди
		
		ПараметрыТерминала = эвСберСпасибоСерверКеш.ПолучитьПараметрыТерминалаСпасибо(Выборка.Терминал); 
		end_point = Выборка.end_point; 
		
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("pfx");

	//ДД = ПараметрыТерминала.АдресСертификата.Получить();

	Если ЭтоАдресВременногоХранилища(ПараметрыТерминала.АдресСертификата) Тогда
		ДД = ПолучитьИзВременногоХранилища(ПараметрыТерминала.АдресСертификата);
		Попытка
			ДД.Записать(ИмяФайла);
		Исключение
			
			ЗаписатьЛогСпасибо(
				НСтр("ru = 'Ошибка получения сертификата из двоичных данных'")
					+ Символы.ПС
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				Истина);
			
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	СертификатКлиентаWindows = Новый СертификатКлиентаФайл(ИмяФайла, ПараметрыТерминала.ПарольСертификата);
	
	ssl = Новый ЗащищенноеСоединениеOpenSSL(СертификатКлиентаWindows, Неопределено);
	
	Попытка
		
		Соединение = Новый HTTPСоединение(end_point,,,,,,ssl);
		
	Исключение
		
		Соединение = Неопределено;
		
		ЗаписатьЛогСпасибо(
			НСтр("ru = 'Ошибка соединения с сервером Спасибо'")
				+ Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Истина);
		
	КонецПопытки;

    Возврат Соединение;
	
КонецФункции // ()

		 
		 
Процедура СохранитьЗапросВОчереди(ПараметрыОчереди) Экспорт
	
	ТелоЗапроса = "";
	Заголовки   = ""; 
	 
	Если ПараметрыОчереди.Свойство("body") И ЗначениеЗаполнено(ПараметрыОчереди.body) Тогда
		ТелоЗапроса = ЗначениеВСтрокуВнутр(ПараметрыОчереди.body);  
		ТелоЗапроса = СтрЗаменить(ТелоЗапроса,"¶","")
	КонецЕсли; 
	
	Если ПараметрыОчереди.Свойство("Заголовки") И ЗначениеЗаполнено(ПараметрыОчереди.Заголовки) Тогда 
		Заголовки = ЗначениеВСтрокуВнутр(ПараметрыОчереди.Заголовки);
		Заголовки = СтрЗаменить(Заголовки,"¶","")
	КонецЕсли;
	
	
	МЗ = РегистрыСведений.эв_ОчередьЗапросовСпасибо.СоздатьМенеджерЗаписи();
	МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
	ЗаполнитьЗначенияСвойств(МЗ, ПараметрыОчереди);        
	МЗ.body          = ТелоЗапроса;
	МЗ.Заголовки     = Заголовки;  
	МЗ.ДатаЗапроса   = ТекущаяДатаСеанса();
	МЗ.Записать();

КонецПроцедуры  

Процедура эвОчередьЗапросов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	эвОчередьЗапросов.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	эвОчередьЗапросов.end_point КАК end_point,
		|	эвОчередьЗапросов.service КАК service,
		|	эвОчередьЗапросов.body КАК body,
		|	эвОчередьЗапросов.http_status КАК http_status,
		|	эвОчередьЗапросов.send_limit КАК send_limit,
		|	эвОчередьЗапросов.Терминал КАК Терминал,
		|	эвОчередьЗапросов.metod КАК metod
		|ИЗ
		|	РегистрСведений.эв_ОчередьЗапросовСпасибо КАК эвОчередьЗапросов
		|ГДЕ
		|	эвОчередьЗапросов.http_status ПОДОБНО &http_status";
	
	Запрос.УстановитьПараметр("http_status","400"); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.эв_ОчередьЗапросовСпасибо.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Выборка);

		Если Выборка.send_limit <= 20 Тогда
		
			Ответ = ОбработатьЭлементОчереди(Выборка);       
		
			МЗ.http_status = Ответ.http_status;
			МЗ.ТекстОшибки = Ответ.ТекстОшибки;

		Иначе
			
			МЗ.http_status = "404";
			МЗ.ТекстОшибки = "Исчерпано более 20 попыток обработки запроса";
			
		КонецЕсли;

		МЗ.ДатаЗапроса = ТекущаяДатаСеанса();
		МЗ.send_limit  = МЗ.send_limit + 1;
		МЗ.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОбработатьЭлементОчереди(Выборка) Экспорт
	
	Ответ = Новый Структура;
	Ответ.Вставить("Результат",   Ложь);
	Ответ.Вставить("http_status", "400");
	Ответ.Вставить("ТекстОшибки", "");
	
	ТелоЗапроса = "";
	Если ЗначениеЗаполнено(Выборка.body) Тогда
		ТелоЗапроса = ЗначениеИзСтрокиВнутр(Выборка.body); 
		Если НЕ ТипЗнч(ТелоЗапроса) = Тип("Структура") Тогда
			ТелоЗапроса = "";
		КонецЕсли;
	КонецЕсли;

	HTTPОтвет = ОтправитьHTTPзапрос(Выборка, Выборка.service, ТелоЗапроса, Выборка.metod);
	
	Если (HTTPОтвет.КодСостояния = 201 ИЛИ HTTPОтвет.КодСостояния = 200) Тогда
		Ответ.Результат   = Истина;
		Ответ.http_status = HTTPОтвет.КодСостояния;
	Иначе      
		
		Ответ.ТекстОшибки = Строка(HTTPОтвет.КодСостояния);
		
		Если HTTPОтвет.Свойство("message") Тогда
			Ответ.ТекстОшибки = Ответ.ТекстОшибки + " " + HTTPОтвет.message;
		КонецЕсли; 
		
		Если HTTPОтвет.Свойство("error") Тогда
			Ответ.ТекстОшибки = Ответ.ТекстОшибки + " " + HTTPОтвет.error;
		КонецЕсли; 
	КонецЕсли;

	Возврат Ответ;
	
КонецФункции // ОбработатьЭлементОчереди()

Функция ОтправитьHTTPзапрос(ПараметрыБонусовСпасибо, Ресурс, Данные = Неопределено, Метод = "POST") Экспорт
	

    Соединение = эв_СоединитьсяСПроцессингом(ПараметрыБонусовСпасибо);
	
	Если Соединение = Неопределено Тогда
		Возврат Новый Структура("КодСостояния",400);  
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	HTTPЗапрос  = Новый HTTPЗапрос(Ресурс, Заголовки);

	Если НЕ Данные = Неопределено Тогда
	
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();	
		ЗаписатьJSON(ЗаписьJSON, Данные);			
		ТелоЗапроса = ЗаписьJSON.Закрыть(); 
		
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		
	КонецЕсли;
	
	Лог = ПолучитьИмяВременногоФайла("txt");
	
	ТекстОшибки = "";
	
	Если Метод = "POST" Тогда
		
		Попытка
			
			Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
			
		Исключение  
			
			Возврат Новый Структура("error,КодСостояния", "Ошибка отправки POST-запроса к серверу Спасибо", 404);

		КонецПопытки;
		
	ИначеЕсли Метод = "PUT" Тогда

		Попытка

			Ответ = Соединение.ВызватьHTTPМетод("PUT",HTTPЗапрос);
			
		Исключение    
			
			Возврат Новый Структура("error,КодСостояния", "Ошибка отправки PUT-запроса к серверу Спасибо", 404);
			
		КонецПопытки;

	Иначе
		Возврат Новый Структура("КодСостояния,error", 400, "Не известный метод");
	КонецЕсли;
	
	ТекстСообщения = "";
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ТекстСообщения = Ответ.ПолучитьТелоКакСтроку();
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON, Ложь);
		СтруктураОтвета.Вставить("КодСостояния", Ответ.КодСостояния);
	Исключение
		СтруктураОтвета = Новый Структура("error,КодСостояния", "Ошибка разбора ответа сервера процессинга", Ответ.КодСостояния);
	КонецПопытки;

	ТекДанные = "====================== Операция: " + Метод + " " + HTTPЗапрос.АдресРесурса + " ======================" + Символы.ПС;
	ТекДанные = ТекДанные + "Точное время начала выполнения операции: "+XMLСтрока(ТекущаяДата())+Символы.ПС+Символы.ПС; 
	ТекДанные = ТекДанные + "Метод: "   + Метод + " " + HTTPЗапрос.АдресРесурса + Символы.ПС + Символы.ПС;  
	ТекДанные = ТекДанные + "Запрос: "  + Символы.ПС;  
	ТекДанные = ТекДанные + СтрЗаменить(ТелоЗапроса,Символы.ПС,"") + Символы.ПС + Символы.ПС;  
	ТекДанные = ТекДанные + "Ответ: "   + Символы.ПС;  
	ТекДанные = ТекДанные + ТекстСообщения + Символы.ПС + Символы.ПС; 
	Если ТекстОшибки = "" Тогда
		ТекДанные = ТекДанные + "Комментарий: успешно";  
	Иначе
		ТекДанные = ТекДанные + "Комментарий: не успешно" + Символы.ПС;  
		ТекДанные = ТекДанные + ТекстОшибки + Символы.ПС + ТекстСообщения;	
	КонецЕсли;
	
	ЗаписатьЛогСпасибо(ТекДанные, ТекстОшибки <> "");
	
	Возврат СтруктураОтвета;

КонецФункции

Процедура эв_ДобавитьРеквизитыСпасибо(Форма) Экспорт
    

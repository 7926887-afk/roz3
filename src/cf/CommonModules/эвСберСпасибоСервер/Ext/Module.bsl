   	 РодительскаяГруппа = Форма.Элементы.Найти("ГруппаОбщиеИтоги");
   	 Если НЕ РодительскаяГруппа = Неопределено Тогда
   		 
   		 ЭлементПеред = Форма.Элементы.Найти("ОтменитьВсеОплаты");
   		 НадписьRRN = Форма.Элементы.Вставить(ИмяЭлемента, Тип("ДекорацияФормы"), РодительскаяГруппа, ЭлементПеред);
   		 НадписьRRN.Вид = ВидДекорацииФормы.Надпись;




#Область ПрограммныйИнтерфейс

// Ставит пробитый чек кассы без подключения оборудования в очередь ККТ
// для последующей фискализации в облачной кассе.
// Пока чек не пробит, запись этого документа из очереди удаляется.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЧекККМ - записываемый чек.
//
Процедура эв_ПоставитьЧекБезОборудованияВОчередь(ДокументОбъект) Экспорт
	
	Если ДокументОбъект = Неопределено
		Или Не ЗначениеЗаполнено(ДокументОбъект.Ссылка)
		Или Не ЗначениеЗаполнено(ДокументОбъект.КассаККМ) Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьБезПодключенияОборудования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДокументОбъект.КассаККМ,
		"ИспользоватьБезПодключенияОборудования");
	Если ИспользоватьБезПодключенияОборудования <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ДокументОбъект.Статус = Перечисления.СтатусыЧековККМ.Пробит Тогда
			эв_ДобавитьЧекБезОборудованияВОчередь(ДокументОбъект.Ссылка);
		Иначе
			РаспределеннаяФискализация.УдалитьЧекИзОчереди(ДокументОбъект.Ссылка);
		КонецЕсли;
	Исключение
		ТекстСообщения = ?(ДокументОбъект.Статус = Перечисления.СтатусыЧековККМ.Пробит,
			НСтр("ru = 'Не удалось поставить чек в очередь фискализации. Подробности в журнале регистрации.'"),
			НСтр("ru = 'Не удалось убрать чек из очереди фискализации. Подробности в журнале регистрации.'"));
		ЗаписьЖурналаРегистрации(
			"ЧекККМ.ОчередьЧековККТ",
			УровеньЖурналаРегистрации.Ошибка,
			ДокументОбъект.Метаданные(),
			ДокументОбъект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

// Фискализирует чеки регистра ОчередьЧековККТ в облачной кассе АТОЛ Онлайн (протокол v5).
// Берутся чеки ККМ касс без подключения оборудования в статусах Новый, Ошибка и Фискализируется.
// Логин, пароль, код группы и адрес сервиса читаются из регистра эв_НастройкиAPIОнлайнКассы.
// Повторный запуск дочитывает результат чеков, которые сервис еще обрабатывает.
// Результат успешной фискализации записывается в регистр ФискальныеОперации по чеку очереди.
//
Процедура эв_ОбработатьОчередьЧековККТ() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЧекиОчереди = эв_ЧекиОчередиДляФискализацииАтол();
	Если ЧекиОчереди.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'В очереди нет чеков для фискализации в АТОЛ Онлайн.'"));
		Возврат;
	КонецЕсли;
	
	КэшНастроек = Новый Соответствие;
	КэшТокенов = Новый Соответствие;
	Фискализировано = 0;
	Ожидают = 0;
	Ошибок = 0;
	
	Для Каждого СтрокаОчереди Из ЧекиОчереди Цикл
		Попытка
			ИтогОбработки = эв_ОбработатьЧекОчередиАтол(СтрокаОчереди, КэшНастроек, КэшТокенов);
		Исключение
			ИтогОбработки = "error";
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			эв_ЗаписатьСостояниеЧекаВОчереди(
				СтрокаОчереди.ДокументОснование,
				СтрокаОчереди.ИдентификаторЗаписи,
				Перечисления.СтатусЧекаККТВОчереди.Ошибка,
				ТекстОшибки,
				Неопределено,
				Неопределено);
			эв_ЗаписатьОшибкуФискализацииАтол(СтрокаОчереди.ДокументОснование, ТекстОшибки);
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = '%1: %2'"), СтрокаОчереди.ДокументОснование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		
		Если ИтогОбработки = "done" Тогда
			Фискализировано = Фискализировано + 1;
		ИначеЕсли ИтогОбработки = "wait" Тогда
			Ожидают = Ожидают + 1;
		Иначе
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
		НСтр("ru = 'Очередь АТОЛ обработана. Фискализировано: %1. Ожидают результат: %2. Ошибки: %3.'"),
		Фискализировано,
		Ожидают,
		Ошибок));
	
КонецПроцедуры

// Проверяет код маркировки через сервис ТС ПИоТ АТОЛ Онлайн.
// Используется для кассы с признаком работы без подключения оборудования.
//
// Параметры:
//  КассаККМ - СправочникСсылка.КассыККМ - касса, для которой заданы настройки API.
//  КодМаркировки - Строка - код маркировки в формате GS1 или Base64.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - запрос выполнен и ответ сервиса разобран.
//   * РазрешенаПродажа - Булево - ПМСР разрешает продажу.
//   * РазрешительныйРежимИдентификаторЗапросаГИСМТ - Строка - req_id.
//   * РазрешительныйРежимДатаЗапросаГИСМТ - Строка - reqTimestamp.
//   * РазрешительныйРежимИдентификаторЭкземпляраПО - Строка - inst.
//   * РазрешительныйРежимВерсияБазы - Строка - version.
//   * ТекстОшибки - Строка - текст ошибки или причина запрета продажи.
//
Функция эв_ПроверитьКодМаркировкиТСПИоТ(КассаККМ, КодМаркировки) Экспорт
	
	Результат = эв_НовыйРезультатПроверкиКодаМаркировки();
	КодМаркировки = СокрЛП(КодМаркировки);
	Если Не ЗначениеЗаполнено(КассаККМ) Или Не ЗначениеЗаполнено(КодМаркировки) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнены касса или код маркировки для проверки.'");
		Возврат Результат;
	КонецЕсли;
	
	КэшНастроек = Новый Соответствие;
	КэшТокенов = Новый Соответствие;
	Настройки = эв_НастройкиКассыАтол(КассаККМ, КэшНастроек);
	Если Не Настройки.Заполнены Тогда
		Результат.ТекстОшибки = Настройки.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Настройки.Вставить("СоединениеТСПИоТ", эв_ПараметрыСоединенияТСПИоТ(Настройки.Адрес));
	
	Попытка
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Результат.ТекстОшибки = ДанныеТокена.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Коды = Новый Массив;
		Коды.Добавить(эв_КодМаркировкиВBase64(КодМаркировки));
		Тело = эв_ТекстJSON(Новый Структура("codes", Коды));
		Ответ = Неопределено;
		Для НомерПопытки = 1 По 3 Цикл
			Если НомерПопытки > 1 Тогда
				эв_Пауза(1000);
				ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
				Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
					Результат.ТекстОшибки = ДанныеТокена.ТекстОшибки;
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
			Ответ = эв_ЗапросТСПИоТ(Настройки, "POST", "/codes/check", Тело, ДанныеТокена.Токен, КэшТокенов);
			КодОшибки = эв_КодОшибкиТСПИоТ(Ответ);
			Если КодОшибки = 203 Тогда
				Результат.Успех = Истина;
				Результат.РазрешенаПродажа = Истина;
				Возврат Результат;
			КонецЕсли;
			Если Не эв_ПовторитьЗапросТСПИоТ(Ответ, КодОшибки) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		эв_ЗаполнитьРезультатПроверкиТСПИоТ(Результат, Ответ);
	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"ЧекККМ.ПроверкаКодаМаркировкиТСПИоТ",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЧекККМ,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&Вместо("ЧекиВОчередиНаФискализацию")
Функция эв_ЧекиВОчередиНаФискализацию(КассаККМ = Неопределено, ОблачнаяККТ = Ложь) Экспорт
	
	ЧекиНаФискализацию = ПродолжитьВызов(КассаККМ, ОблачнаяККТ);
	эв_ИсключитьЧекиКассБезОборудования(ЧекиНаФискализацию);
	Возврат ЧекиНаФискализацию;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура эв_ДобавитьЧекБезОборудованияВОчередь(ДокументСсылка)
	
	Если эв_ЕстьЧекВОчереди(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляФискализации = Документы.ЧекККМ.ПолучитьДанныеДляФискализации(ДокументСсылка);
	Если ТипЗнч(ДанныеДляФискализации) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	РаспределеннаяФискализация.ДобавитьЧекВОчередьЧековККТ(ДанныеДляФискализации, , Ложь);
	
КонецПроцедуры

Функция эв_ЕстьЧекВОчереди(ДокументСсылка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОчередьЧековККТ.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.ОчередьЧековККТ КАК ОчередьЧековККТ
	|ГДЕ
	|	ОчередьЧековККТ.ДокументОснование = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура эв_ИсключитьЧекиКассБезОборудования(ЧекиНаФискализацию)
	
	Если ТипЗнч(ЧекиНаФискализацию) <> Тип("Массив") Или ЧекиНаФискализацию.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КассыККМ = Новый Массив;
	Для Каждого ЧекВОчереди Из ЧекиНаФискализацию Цикл
		КассаККМ = Неопределено;
		Если ТипЗнч(ЧекВОчереди) = Тип("Структура") Тогда
			ЧекВОчереди.Свойство("КассаККМ", КассаККМ);
		КонецЕсли;
		Если ЗначениеЗаполнено(КассаККМ) И КассыККМ.Найти(КассаККМ) = Неопределено Тогда
			КассыККМ.Добавить(КассаККМ);
		КонецЕсли;
	КонецЦикла;
	
	Если КассыККМ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КассыБезОборудования = эв_КассыБезПодключенияОборудования(КассыККМ);
	Если КассыБезОборудования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = ЧекиНаФискализацию.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ЧекВОчереди = ЧекиНаФискализацию[Индекс];
		КассаККМ = Неопределено;
		Если ТипЗнч(ЧекВОчереди) = Тип("Структура") Тогда
			ЧекВОчереди.Свойство("КассаККМ", КассаККМ);
		КонецЕсли;
		Если КассыБезОборудования.Получить(КассаККМ) <> Неопределено Тогда
			ЧекиНаФискализацию.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

Функция эв_КассыБезПодключенияОборудования(КассыККМ)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КассыККМ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	КассыККМ.Ссылка В (&КассыККМ)
	|	И КассыККМ.ИспользоватьБезПодключенияОборудования";
	Запрос.УстановитьПараметр("КассыККМ", КассыККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область ФискализацияАтолОнлайн

Функция эв_ЧекиОчередиДляФискализацииАтол()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОчередьЧековККТ.ДокументОснование КАК ДокументОснование,
	|	ОчередьЧековККТ.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ОчередьЧековККТ.СтатусЧека КАК СтатусЧека,
	|	ОчередьЧековККТ.КассаККМ КАК КассаККМ,
	|	ОчередьЧековККТ.ТипРасчета КАК ТипРасчета,
	|	ОчередьЧековККТ.Содержание КАК Содержание,
	|	ОчередьЧековККТ.ТекстОшибки КАК ТекстОшибки
	|ИЗ
	|	РегистрСведений.ОчередьЧековККТ КАК ОчередьЧековККТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК КассыККМ
	|		ПО ОчередьЧековККТ.КассаККМ = КассыККМ.Ссылка
	|ГДЕ
	|	КассыККМ.ИспользоватьБезПодключенияОборудования
	|	И ТИПЗНАЧЕНИЯ(ОчередьЧековККТ.ДокументОснование) = ТИП(Документ.ЧекККМ)
	|	И ОчередьЧековККТ.СтатусЧека В (
	|		ЗНАЧЕНИЕ(Перечисление.СтатусЧекаККТВОчереди.Новый),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусЧекаККТВОчереди.Ошибка),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусЧекаККТВОчереди.Фискализируется))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОчередьЧековККТ.Дата";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция эв_ОбработатьЧекОчередиАтол(СтрокаОчереди, КэшНастроек, КэшТокенов)
	
	Настройки = эв_НастройкиКассыАтол(СтрокаОчереди.КассаККМ, КэшНастроек);
	Если Не Настройки.Заполнены Тогда
		Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, Настройки.ТекстОшибки, Неопределено);
	КонецЕсли;
	
	ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
	Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
		Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, ДанныеТокена.ТекстОшибки, Неопределено);
	КонецЕсли;
	
	ИдентификаторДокумента = эв_ИдентификаторДокументаАтол(СтрокаОчереди.Содержание);
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Если СтрНачинаетсяС(СтрокаОчереди.ТекстОшибки, "АТОЛ 33:") Тогда
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, СтрокаОчереди.ТекстОшибки, Неопределено);
		КонецЕсли;
		
		ДокументОбъект = СтрокаОчереди.ДокументОснование.ПолучитьОбъект();
		Если ДокументОбъект = Неопределено Тогда
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди,
				НСтр("ru = 'Не удалось прочитать чек ККМ.'"), Неопределено);
		КонецЕсли;
		
		ЭтоВозврат = СтрокаОчереди.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
		ТелоДокумента = эв_ТелоДокументаАтол(ДокументОбъект, СтрокаОчереди.ИдентификаторЗаписи, ЭтоВозврат);
		Если ЗначениеЗаполнено(ТелоДокумента.ТекстОшибки) Тогда
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, ТелоДокумента.ТекстОшибки, "");
		КонецЕсли;
		
		Операция = ?(ЭтоВозврат, "sell_refund", "sell");
		Ответ = эв_ЗарегистрироватьДокументАтол(
			Настройки, ДанныеТокена.Токен, Операция, эв_ТекстJSON(ТелоДокумента.Тело), КэшТокенов);
		КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
		ИдентификаторДокумента = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ответ.Данные, "uuid")));
		Если КодОшибки <> 0 Или Не ЗначениеЗаполнено(ИдентификаторДокумента) Или ИдентификаторДокумента = "Неопределено" Тогда
			ТекстОшибки = эв_ТекстОшибкиАтол(Ответ.Данные);
			Если ПустаяСтрока(ТекстОшибки) Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'АТОЛ не зарегистрировал чек. Код состояния %1.'"), Ответ.КодСостояния);
			КонецЕсли;
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, ТекстОшибки, "");
		КонецЕсли;
		
		эв_ЗаписатьСостояниеЧекаВОчереди(
			СтрокаОчереди.ДокументОснование,
			СтрокаОчереди.ИдентификаторЗаписи,
			Перечисления.СтатусЧекаККТВОчереди.Фискализируется,
			"",
			"uuid:" + ИдентификаторДокумента,
			Неопределено);
	КонецЕсли;
	
	РезультатОжидания = эв_ДождатьсяРезультатаАтол(Настройки, ИдентификаторДокумента, КэшТокенов);
	Если РезультатОжидания.Статус = "done" Тогда
		Описание = эв_ОписаниеРезультатаФискализации(РезультатОжидания.Результат);
		эв_ЗаписатьФискальнуюОперациюАтол(СтрокаОчереди, РезультатОжидания.Результат);
		эв_ЗаписатьСостояниеЧекаВОчереди(
			СтрокаОчереди.ДокументОснование,
			СтрокаОчереди.ИдентификаторЗаписи,
			Перечисления.СтатусЧекаККТВОчереди.Фискализирован,
			"",
			Описание,
			РезультатОжидания.Результат);
		Возврат "done";
	КонецЕсли;
	
	Если РезультатОжидания.Статус = "fail" Или РезультатОжидания.Статус = "error" Тогда
		СодержаниеИдентификатора = Неопределено;
		Если РезультатОжидания.ПовторитьОтправку Тогда
			СодержаниеИдентификатора = "";
		КонецЕсли;
		Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, РезультатОжидания.ТекстОшибки, СодержаниеИдентификатора);
	КонецЕсли;
	
	эв_ЗаписатьСостояниеЧекаВОчереди(
		СтрокаОчереди.ДокументОснование,
		СтрокаОчереди.ИдентификаторЗаписи,
		Перечисления.СтатусЧекаККТВОчереди.Фискализируется,
		"",
		"uuid:" + ИдентификаторДокумента,
		Неопределено);
	Возврат "wait";
	
КонецФункции

Функция эв_ОшибкаЧекаАтол(СтрокаОчереди, ТекстОшибки, Содержание)
	
	эв_ЗаписатьСостояниеЧекаВОчереди(
		СтрокаОчереди.ДокументОснование,
		СтрокаОчереди.ИдентификаторЗаписи,
		Перечисления.СтатусЧекаККТВОчереди.Ошибка,
		ТекстОшибки,
		Содержание,
		Неопределено);
	эв_ЗаписатьОшибкуФискализацииАтол(СтрокаОчереди.ДокументОснование, ТекстОшибки);
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = '%1: %2'"), СтрокаОчереди.ДокументОснование, ТекстОшибки));
	Возврат "error";
	
КонецФункции

Функция эв_НастройкиКассыАтол(КассаККМ, КэшНастроек)
	
	Сохраненные = КэшНастроек.Получить(КассаККМ);
	Если Сохраненные <> Неопределено Тогда
		Возврат Сохраненные;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Заполнены", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Логин", "");
	Результат.Вставить("Пароль", "");
	Результат.Вставить("КодГруппы", "");
	Результат.Вставить("Адрес", "");
	Результат.Вставить("Соединение", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.Адрес КАК Адрес,
	|	Настройки.Логин КАК Логин,
	|	Настройки.Пароль КАК Пароль,
	|	Настройки.КодГруппы КАК КодГруппы
	|ИЗ
	|	РегистрСведений.эв_НастройкиAPIОнлайнКассы КАК Настройки
	|ГДЕ
	|	Настройки.КассаККМ = &КассаККМ";
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Логин = СокрЛП(Выборка.Логин);
		Результат.Пароль = СокрЛП(Выборка.Пароль);
		Результат.КодГруппы = СокрЛП(Выборка.КодГруппы);
		Результат.Адрес = СокрЛП(Выборка.Адрес);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Логин)
		И ЗначениеЗаполнено(Результат.Пароль)
		И ЗначениеЗаполнено(Результат.КодГруппы) Тогда
		Результат.Заполнены = Истина;
		Результат.Соединение = эв_ПараметрыСоединенияАтол(Результат.Адрес);
	Иначе
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Для кассы %1 не заполнены логин, пароль или код группы в настройках API онлайн-кассы.'"),
			КассаККМ);
	КонецЕсли;
	
	КэшНастроек.Вставить(КассаККМ, Результат);
	Возврат Результат;
	
КонецФункции

Функция эв_ПараметрыСоединенияАтол(АдресСервиса)
	
	Адрес = СокрЛП(АдресСервиса);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "https://online.atol.ru";
	КонецЕсли;
	Если НРег(Лев(Адрес, 7)) <> "http://" И НРег(Лев(Адрес, 8)) <> "https://" Тогда
		Адрес = "https://" + Адрес;
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
	Порт = СтруктураURI.Порт;
	ЗащищенноеСоединение = Неопределено;
	Если СтруктураURI.Схема = "https" Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		Если Порт = Неопределено Тогда
			Порт = 443;
		КонецЕсли;
	ИначеЕсли Порт = Неопределено Тогда
		Порт = 80;
	КонецЕсли;
	
	Путь = СтруктураURI.ПутьНаСервере;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Если Не СтрЗаканчиваетсяНа(НРег(Путь), "possystem/v5") Тогда
		Если ЗначениеЗаполнено(Путь) Тогда
			Путь = Путь + "/";
		КонецЕсли;
		Путь = Путь + "possystem/v5";
	КонецЕсли;
	Если Не СтрНачинаетсяС(Путь, "/") Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Сервер", СтруктураURI.Хост);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("ЗащищенноеСоединение", ЗащищенноеСоединение);
	Результат.Вставить("Путь", Путь);
	Возврат Результат;
	
КонецФункции

Функция эв_ТокенАтол(Настройки, КэшТокенов)
	
	Ключ = Настройки.Адрес + "|" + Настройки.Логин;
	Сохраненный = КэшТокенов.Получить(Ключ);
	Если Сохраненный <> Неопределено Тогда
		Возврат Сохраненный;
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("login", Настройки.Логин);
	Тело.Вставить("pass", Настройки.Пароль);
	Ответ = эв_ВыполнитьЗапросАтол(Настройки.Соединение, "POST", "/getToken", эв_ТекстJSON(Тело), "");
	
	Токен = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ответ.Данные, "token")));
	ТекстОшибки = "";
	Если Не ЗначениеЗаполнено(Токен) Или Токен = "Неопределено" Тогда
		Токен = "";
		ТекстОшибки = эв_ТекстОшибкиАтол(Ответ.Данные);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не получен токен АТОЛ. Код состояния %1.'"), Ответ.КодСостояния);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура("Токен, ТекстОшибки", Токен, ТекстОшибки);
	КэшТокенов.Вставить(Ключ, Результат);
	Возврат Результат;
	
КонецФункции

Процедура эв_СброситьТокенАтол(Настройки, КэшТокенов)
	
	КэшТокенов.Удалить(Настройки.Адрес + "|" + Настройки.Логин);
	
КонецПроцедуры

Функция эв_ЗарегистрироватьДокументАтол(Настройки, Токен, Операция, Тело, КэшТокенов, Повтор = Ложь)
	
	Путь = "/" + эв_КодироватьПараметрАтол(Настройки.КодГруппы) + "/" + Операция;
	Ответ = эв_ВыполнитьЗапросАтол(Настройки.Соединение, "POST", Путь, Тело, Токен);
	КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
	Если Не Повтор И (КодОшибки = 10 Или КодОшибки = 11) Тогда
		эв_СброситьТокенАтол(Настройки, КэшТокенов);
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Возврат эв_ЗарегистрироватьДокументАтол(Настройки, ДанныеТокена.Токен, Операция, Тело, КэшТокенов, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция эв_ДождатьсяРезультатаАтол(Настройки, ИдентификаторДокумента, КэшТокенов)
	
	Результат = Новый Структура("Статус, ТекстОшибки, Результат, ПовторитьОтправку", "wait", "", Неопределено, Ложь);
	Для НомерПопытки = 1 По 3 Цикл
		Если НомерПопытки > 1 Тогда
			эв_Пауза(2000);
		КонецЕсли;
		
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Результат.Статус = "error";
			Результат.ТекстОшибки = ДанныеТокена.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Ответ = эв_РезультатДокументаАтол(Настройки, ДанныеТокена.Токен, ИдентификаторДокумента, КэшТокенов);
		КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
		Статус = НРег(СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ответ.Данные, "status"))));
		Если Статус = "done" И КодОшибки = 0 Тогда
			Результат.Статус = "done";
			Результат.Результат = эв_РезультатФискализацииАтол(Ответ.Данные);
			Возврат Результат;
		КонецЕсли;
		Если Ответ.Данные = Неопределено Или КодОшибки = 34 Или (Статус = "wait" И КодОшибки = 0) Тогда
			Продолжить;
		КонецЕсли;
		Если КодОшибки <> 0 Или Статус = "fail" Тогда
			Результат.Статус = "fail";
			Результат.ПовторитьОтправку = Статус = "fail";
			Результат.ТекстОшибки = эв_ТекстОшибкиАтол(Ответ.Данные);
			Если ПустаяСтрока(Результат.ТекстОшибки) Тогда
				Результат.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'АТОЛ не фискализировал чек. Код состояния %1.'"), Ответ.КодСостояния);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_РезультатДокументаАтол(Настройки, Токен, ИдентификаторДокумента, КэшТокенов, Повтор = Ложь)
	
	Путь = "/" + эв_КодироватьПараметрАтол(Настройки.КодГруппы)
		+ "/report/" + эв_КодироватьПараметрАтол(ИдентификаторДокумента);
	Ответ = эв_ВыполнитьЗапросАтол(Настройки.Соединение, "GET", Путь, Неопределено, Токен);
	КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
	Если Не Повтор И (КодОшибки = 10 Или КодОшибки = 11) Тогда
		эв_СброситьТокенАтол(Настройки, КэшТокенов);
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Возврат эв_РезультатДокументаАтол(
				Настройки, ДанныеТокена.Токен, ИдентификаторДокумента, КэшТокенов, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция эв_ВыполнитьЗапросАтол(ПараметрыСоединения, Метод, Путь, Тело, Токен)
	
	Соединение = Новый HTTPСоединение(
		ПараметрыСоединения.Сервер,
		ПараметрыСоединения.Порт,
		Неопределено,
		Неопределено,
		Неопределено,
		60,
		ПараметрыСоединения.ЗащищенноеСоединение);
	Запрос = Новый HTTPЗапрос(ПараметрыСоединения.Путь + Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если ЗначениеЗаполнено(Токен) Тогда
		Запрос.Заголовки.Вставить("Token", Токен);
	КонецЕсли;
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	
	ОтветHTTP = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	ТекстОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", ОтветHTTP.КодСостояния);
	Результат.Вставить("Текст", ТекстОтвета);
	Результат.Вставить("Данные", Неопределено);
	Если ЗначениеЗаполнено(СокрЛП(ТекстОтвета)) Тогда
		Попытка
			Результат.Данные = эв_ПрочитатьОтветАтол(ТекстОтвета);
		Исключение
			Результат.Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ТелоДокументаАтол(ДокументОбъект, ИдентификаторЗаписи, ЭтоВозврат)
	
	Результат = Новый Структура("Тело, ТекстОшибки", Неопределено, "");
	Заказ = эв_ЗаказОснованиеЧека(ДокументОбъект);
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У чека не заполнен заказ-основание.'");
		Возврат Результат;
	КонецЕсли;
	
	ПочтаКомпании = эв_ПочтаКомпанииПоЗаказу(Заказ);
	Если Не СтрНайти(ПочтаКомпании, "@") > 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнена почта источника заказа, связанного с заказом-основанием чека.'");
		Возврат Результат;
	КонецЕсли;
	
	ИНН = эв_ТолькоЦифры(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Организация, "ИНН"));
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В организации чека не заполнен корректный ИНН.'");
		Возврат Результат;
	КонецЕсли;
	
	МестоРасчетов = эв_МестоРасчетовЧека(ДокументОбъект);
	Если ПустаяСтрока(МестоРасчетов) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить место расчетов чека.'");
		Возврат Результат;
	КонецЕсли;
	
	Позиции = эв_ПозицииДокументаАтол(ДокументОбъект, ЭтоВозврат);
	Если ЗначениеЗаполнено(Позиции.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Позиции.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Клиент = эв_КлиентЧекаАтол(ДокументОбъект, Заказ);
	Компания = Новый Структура;
	Компания.Вставить("email", Лев(ПочтаКомпании, 64));
	Компания.Вставить("sno", "osn");
	Компания.Вставить("inn", ИНН);
	Компания.Вставить("payment_address", МестоРасчетов);
	
	Чек = Новый Структура;
	Чек.Вставить("client", Клиент);
	Чек.Вставить("company", Компания);
	Чек.Вставить("items", Позиции.Позиции);
	Чек.Вставить("payments", эв_ОплатыДокументаАтол(ДокументОбъект, Позиции.Итог));
	Чек.Вставить("total", Позиции.Итог);
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Чек.Вставить("cashier", Лев(СокрЛП(Строка(ДокументОбъект.Ответственный)), 64));
	КонецЕсли;
	Если ДокументОбъект.РасчетВИнтернете Тогда
		Чек.Вставить("internet", Истина);
	КонецЕсли;
	ЧасоваяЗона = Цел(ДокументОбъект.ЧасоваяЗона);
	Если ЧасоваяЗона >= 1 И ЧасоваяЗона <= 11 Тогда
		Чек.Вставить("timezone", ЧасоваяЗона);
	КонецЕсли;
	
	ДатаДокумента = ДокументОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("timestamp", Формат(ДатаДокумента, "ДФ=dd.MM.yyyy HH:mm:ss"));
	Тело.Вставить("external_id", Лев(СокрЛП(ИдентификаторЗаписи), 128));
	Тело.Вставить("receipt", Чек);
	Результат.Тело = Тело;
	Возврат Результат;
	
КонецФункции

Функция эв_ПозицииДокументаАтол(ДокументОбъект, ЭтоВозврат)
	
	Результат = Новый Структура("Позиции, Итог, ТекстОшибки", Новый Массив, 0, "");
	ПризнакСпособаРасчета = Документы.ЧекККМ.ПризнакСпособаРасчета(ДокументОбъект);
	СпособРасчета = эв_ПризнакСпособаРасчетаАтол(ПризнакСпособаРасчета);
	ЭтоАванс = СпособРасчета = "advance" Или СпособРасчета = "full_prepayment" Или СпособРасчета = "prepayment";
	КодыМаркировки = эв_КодыМаркировкиДокумента(ДокументОбъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запасы.НомерСтроки КАК НомерСтроки,
	|	Запасы.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Запасы.Номенклатура.НаименованиеПолное, """") КАК НаименованиеПолное,
	|	ЕСТЬNULL(Запасы.Номенклатура.КатегорияНоменклатуры.Наименование, """") КАК Категория,
	|	Запасы.Номенклатура.ПризнакПредметаРасчета КАК ПризнакПредметаРасчета,
	|	ЕСТЬNULL(Запасы.Номенклатура.ПодакцизныйТовар, ЛОЖЬ) КАК ПодакцизныйТовар,
	|	Запасы.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА Запасы.Характеристика.НаименованиеДляПечати = """"
	|			ТОГДА Запасы.Характеристика.Наименование
	|		ИНАЧЕ Запасы.Характеристика.НаименованиеДляПечати
	|	КОНЕЦ, """") КАК Характеристика,
	|	Запасы.Количество КАК Количество,
	|	Запасы.Сумма КАК Сумма,
	|	Запасы.СуммаНДС КАК СуммаНДС,
	|	Запасы.Всего КАК Всего,
	|	Запасы.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(Запасы.СтавкаНДС.Ставка, 0) КАК СтавкаЧислом,
	|	ЕСТЬNULL(Запасы.СтавкаНДС.НеОблагается, ЛОЖЬ) КАК БезНДС,
	|	Запасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Запасы.КодМаркировки КАК КодМаркировки,
	|	Запасы.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Запасы.НеобходимостьВводаКодаМаркировки КАК НеобходимостьВводаКодаМаркировки,
	|	Запасы.Партия.Статус КАК СтатусПартии,
	|	Запасы.Партия.ВладелецПартии КАК ВладелецПартии
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество = 0 И Выборка.Всего = 0 И Выборка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Наименование = эв_НаименованиеПозицииАтол(Выборка);
		СерийныйТовар = СокрЛП(Выборка.Категория) = "Серийный";
		КодыСтроки = КодыМаркировки.Получить(Выборка.НомерСтроки);
		Если КодыСтроки = Неопределено Тогда
			КодыСтроки = Новый Массив;
		КонецЕсли;
		ПризнакПредметаРасчета = Выборка.ПризнакПредметаРасчета;
		Если Не ЗначениеЗаполнено(ПризнакПредметаРасчета) Тогда
			ПризнакПредметаРасчета = РозничныеПродажиСервер.ПолучитьПризнакПредметаРасчета(Выборка.Номенклатура);
		КонецЕсли;
		ТребуетсяКод = СерийныйТовар
			Или Выборка.НеобходимостьВводаКодаМаркировки
			Или ЗначениеЗаполнено(Выборка.КодМаркировки)
			Или ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ
			Или ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПодакцизныйТоварМаркируемыйСИИмеющийКМ;
		Если ТребуетсяКод И КодыСтроки.Количество() = 0 Тогда
			Если СерийныйТовар Тогда
				Результат.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Для товара ""%1"" не найден полный код маркировки в номерах упаковок чека.'"),
					Наименование);
			Иначе
				Результат.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Для товара ""%1"" не найден полный код маркировки в пуле кодов маркировки СУЗ.'"),
					Наименование);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		
		эв_ДобавитьПозицииСтрокиАтол(Результат.Позиции, Выборка, КодыСтроки, Наименование,
			ДокументОбъект.СуммаВключаетНДС, СпособРасчета, ЭтоАванс, ЭтоВозврат, ПризнакПредметаРасчета);
	КонецЦикла;
	
	Если Результат.Позиции.Количество() = 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В чеке нет товаров для фискализации.'");
		Возврат Результат;
	КонецЕсли;
	
	Итог = 0;
	Для Каждого Позиция Из Результат.Позиции Цикл
		Итог = Итог + Позиция.sum;
	КонецЦикла;
	Результат.Итог = Окр(Итог, 2);
	Возврат Результат;
	
КонецФункции

Процедура эв_ДобавитьПозицииСтрокиАтол(Позиции, СтрокаЧека, КодыСтроки, Наименование, СуммаВключаетНДС,
	СпособРасчета, ЭтоАванс, ЭтоВозврат, ПризнакПредметаРасчета)
	
	КоличествоЧастей = Макс(КодыСтроки.Количество(), 1);
	СуммаСтроки = Окр(?(СтрокаЧека.Всего <> 0, СтрокаЧека.Всего, СтрокаЧека.Сумма), 2);
	Если Не СуммаВключаетНДС И СтрокаЧека.Всего = 0 Тогда
		СуммаСтроки = Окр(СтрокаЧека.Сумма + СтрокаЧека.СуммаНДС, 2);
	КонецЕсли;
	КоличествоСтроки = СтрокаЧека.Количество;
	Если КоличествоСтроки <= 0 Тогда
		КоличествоСтроки = КоличествоЧастей;
	КонецЕсли;
	СуммаНДССтроки = Окр(СтрокаЧека.СуммаНДС, 2);
	ОстатокСуммы = СуммаСтроки;
	ОстатокНДС = СуммаНДССтроки;
	ОстатокКоличества = КоличествоСтроки;
	СпособСтроки = СпособРасчета;
	АвансСтроки = ЭтоАванс;
	Если СтрокаЧека.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПодарочныйСертификат Тогда
		СпособСтроки = "advance";
		АвансСтроки = Истина;
	КонецЕсли;
	ТипНДС = эв_ТипНДСАтол(СтрокаЧека.СтавкаЧислом, СтрокаЧека.БезНДС, ЗначениеЗаполнено(СтрокаЧека.СтавкаНДС), АвансСтроки);
	
	Для Индекс = 0 По КоличествоЧастей - 1 Цикл
		Если Индекс = КоличествоЧастей - 1 Тогда
			Количество = ОстатокКоличества;
			Сумма = ОстатокСуммы;
			СуммаНДС = ОстатокНДС;
		Иначе
			Количество = Окр(КоличествоСтроки / КоличествоЧастей, 6);
			Сумма = Окр(СуммаСтроки / КоличествоЧастей, 2);
			СуммаНДС = Окр(СуммаНДССтроки / КоличествоЧастей, 2);
			ОстатокКоличества = ОстатокКоличества - Количество;
			ОстатокСуммы = ОстатокСуммы - Сумма;
			ОстатокНДС = ОстатокНДС - СуммаНДС;
		КонецЕсли;
		Если Количество <= 0 Тогда
			Количество = 1;
		КонецЕсли;
		Если Количество = 1 Тогда
			Цена = Окр(Сумма, 2);
			Сумма = Цена;
		Иначе
			Цена = Окр(Сумма / Количество, 2);
			Сумма = Окр(Цена * Количество, 2);
		КонецЕсли;
		
		КодМаркировки = "";
		Если КодыСтроки.Количество() > Индекс Тогда
			КодМаркировки = КодыСтроки[Индекс];
		КонецЕсли;
		КодGS1M = эв_КодМаркировкиGS1M(КодМаркировки);
		ЕстьКод = ЗначениеЗаполнено(КодGS1M);
		
		Позиция = Новый Структура;
		Позиция.Вставить("name", Наименование);
		Позиция.Вставить("price", Цена);
		Позиция.Вставить("quantity", Количество);
		Позиция.Вставить("measure", эв_МераКоличестваАтол(СтрокаЧека.ЕдиницаИзмерения, ЕстьКод));
		Позиция.Вставить("sum", Сумма);
		Позиция.Вставить("payment_method", СпособСтроки);
		Позиция.Вставить("payment_object", эв_ПризнакПредметаРасчетаПозицииАтол(
			ПризнакПредметаРасчета, ЕстьКод, СтрокаЧека.ПодакцизныйТовар));
		Налог = Новый Структура;
		Налог.Вставить("type", ТипНДС);
		Если ТипНДС <> "none" Тогда
			Налог.Вставить("sum", Макс(Окр(СуммаНДС, 2), 0));
		КонецЕсли;
		Позиция.Вставить("vat", Налог);
		Если ЕстьКод Тогда
			Позиция.Вставить("mark_processing_mode", "0");
			Позиция.Вставить("mark_code", Новый Структура("gs1m", КодGS1M));
			Если ЭтоВозврат Тогда
				ПланируемыйСтатус = ?(Количество = 1, 3, 4);
			Иначе
				ПланируемыйСтатус = ?(Количество = 1, 1, 5);
			КонецЕсли;
			Позиция.Вставить("planned_status", ПланируемыйСтатус);
		КонецЕсли;
		эв_ДобавитьАгентаПозицииАтол(Позиция, СтрокаЧека);
		Позиции.Добавить(Позиция);
	КонецЦикла;
	
КонецПроцедуры

Функция эв_КодыМаркировкиДокумента(ДокументОбъект)
	
	Результат = Новый Соответствие;
	КодыСерийные = Новый Соответствие;
	КодыДляПула = Новый Массив;
	СтрокиПула = Новый Массив;
	КэшКатегорий = Новый Соответствие;
	
	Для Каждого СтрокаУпаковки Из ДокументОбъект.ор_НомераУпаковок Цикл
		Если Не ЗначениеЗаполнено(СтрокаУпаковки.ИдентификаторСтроки)
			Или Не ЗначениеЗаполнено(СтрокаУпаковки.ПолныйКодМаркировки) Тогда
			Продолжить;
		КонецЕсли;
		КодыСтроки = КодыСерийные.Получить(СтрокаУпаковки.ИдентификаторСтроки);
		Если КодыСтроки = Неопределено Тогда
			КодыСтроки = Новый Массив;
			КодыСерийные.Вставить(СтрокаУпаковки.ИдентификаторСтроки, КодыСтроки);
		КонецЕсли;
		КодыСтроки.Добавить(СтрокаУпаковки.ПолныйКодМаркировки);
	КонецЦикла;
	
	Для Каждого СтрокаЗапасов Из ДокументОбъект.Запасы Цикл
		Если эв_ТоварКатегорииСерийный(СтрокаЗапасов.Номенклатура, КэшКатегорий) Тогда
			КодыСтроки = КодыСерийные.Получить(СтрокаЗапасов.ор_ИдентификаторСтроки);
			Если КодыСтроки <> Неопределено Тогда
				Результат.Вставить(СтрокаЗапасов.НомерСтроки, КодыСтроки);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		КодМаркировки = СокрЛП(СтрокаЗапасов.КодМаркировки);
		Если ЗначениеЗаполнено(КодМаркировки) Тогда
			КодыДляПула.Добавить(КодМаркировки);
			СтрокиПула.Добавить(Новый Структура("НомерСтроки, КодМаркировки", СтрокаЗапасов.НомерСтроки, КодМаркировки));
		КонецЕсли;
	КонецЦикла;
	
	ПолныеКодыПула = эв_ПолныеКодыМаркировкиПула(КодыДляПула);
	Для Каждого СтрокаПула Из СтрокиПула Цикл
		ПолныйКод = ПолныеКодыПула.Получить(СтрокаПула.КодМаркировки);
		Если Не ЗначениеЗаполнено(ПолныйКод)
			И (СтрНачинаетсяС(СтрокаПула.КодМаркировки, "01") Или СтрДлина(СтрокаПула.КодМаркировки) > 31) Тогда
			ПолныйКод = СтрокаПула.КодМаркировки;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолныйКод) Тогда
			КодыСтроки = Новый Массив;
			КодыСтроки.Добавить(ПолныйКод);
			Результат.Вставить(СтрокаПула.НомерСтроки, КодыСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ТоварКатегорииСерийный(Номенклатура, КэшКатегорий)
	
	Признак = КэшКатегорий.Получить(Номенклатура);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Категория = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КатегорияНоменклатуры");
	Наименование = "";
	Если ЗначениеЗаполнено(Категория) Тогда
		Наименование = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Категория, "Наименование"));
	КонецЕсли;
	Признак = Наименование = "Серийный";
	КэшКатегорий.Вставить(Номенклатура, Признак);
	Возврат Признак;
	
КонецФункции

Функция эв_ПолныеКодыМаркировкиПула(КодыМаркировки)
	
	Результат = Новый Соответствие;
	Если КодыМаркировки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПулКодовМаркировкиСУЗ.КодМаркировки КАК КодМаркировки,
	|	ПулКодовМаркировкиСУЗ.ПолныйКодМаркировки КАК ПолныйКодМаркировки
	|ИЗ
	|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	|ГДЕ
	|	ПулКодовМаркировкиСУЗ.КодМаркировки В (&КодыМаркировки)
	|	И ПулКодовМаркировкиСУЗ.ПолныйКодМаркировки <> """"";
	Запрос.УстановитьПараметр("КодыМаркировки", КодыМаркировки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодМаркировки = СокрЛП(Выборка.КодМаркировки);
		Если Результат.Получить(КодМаркировки) = Неопределено Тогда
			Результат.Вставить(КодМаркировки, Выборка.ПолныйКодМаркировки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_КодМаркировкиGS1M(КодМаркировки)
	
	Код = СокрЛП(КодМаркировки);
	Код = СтрЗаменить(Код, Символы.ПС, "");
	Код = СтрЗаменить(Код, Символы.ВК, "");
	Если ПустаяСтрока(Код) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНачинаетсяС(Код, "01") Или СтрНайти(Код, Символ(29)) > 0 Тогда
		Возврат ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ШтрихкодВBase64(Код);
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

Функция эв_ОплатыДокументаАтол(ДокументОбъект, ИтогЧека)
	
	СуммаЭлектронно = 0;
	СуммаПредоплаты = 0;
	СуммаПостоплаты = 0;
	СуммаВстречного = 0;
	
	Для Каждого СтрокаОплаты Из ДокументОбъект.БезналичнаяОплата Цикл
		Если СтрокаОплаты.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.БанковскаяКарта
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.СБП
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.Кредит
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.СертификатНСПК Тогда
			СуммаЭлектронно = СуммаЭлектронно + СтрокаОплаты.Сумма;
		ИначеЕсли СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ПодарочныйСертификат Тогда
			СуммаПредоплаты = СуммаПредоплаты + СтрокаОплаты.Сумма;
		ИначеЕсли СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ОплатаВРассрочку Тогда
			СуммаПостоплаты = СуммаПостоплаты + СтрокаОплаты.Сумма;
		ИначеЕсли СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ВстречноеПредоставление
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.Бонусы Тогда
			СуммаВстречного = СуммаВстречного + СтрокаОплаты.Сумма;
		Иначе
			СуммаЭлектронно = СуммаЭлектронно + СтрокаОплаты.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	ОплатаДолга = ДокументОбъект.ОперацияСДенежнымиСредствами И ДокументОбъект.Предоплата.Количество() > 0;
	Если Не ОплатаДолга Тогда
		СуммаПредоплаты = СуммаПредоплаты + ДокументОбъект.Предоплата.Итог("СуммаРасчетов");
	КонецЕсли;
	
	СуммаБезналичных = Окр(СуммаЭлектронно + СуммаПредоплаты + СуммаПостоплаты + СуммаВстречного, 2);
	Итог = Окр(ИтогЧека, 2);
	СуммаНаличных = 0;
	Если СуммаБезналичных > Итог Тогда
		Избыток = СуммаБезналичных - Итог;
		Уменьшение = Мин(СуммаВстречного, Избыток);
		СуммаВстречного = СуммаВстречного - Уменьшение;
		Избыток = Избыток - Уменьшение;
		Уменьшение = Мин(СуммаПостоплаты, Избыток);
		СуммаПостоплаты = СуммаПостоплаты - Уменьшение;
		Избыток = Избыток - Уменьшение;
		Уменьшение = Мин(СуммаПредоплаты, Избыток);
		СуммаПредоплаты = СуммаПредоплаты - Уменьшение;
		Избыток = Избыток - Уменьшение;
		Уменьшение = Мин(СуммаЭлектронно, Избыток);
		СуммаЭлектронно = СуммаЭлектронно - Уменьшение;
	Иначе
		НужныНаличные = Итог - СуммаБезналичных;
		Если ДокументОбъект.ПолученоНаличными > НужныНаличные Тогда
			СуммаНаличных = Окр(ДокументОбъект.ПолученоНаличными, 2);
		Иначе
			СуммаНаличных = НужныНаличные;
		КонецЕсли;
	КонецЕсли;
	
	Оплаты = Новый Массив;
	эв_ДобавитьОплатуАтол(Оплаты, 0, СуммаНаличных);
	эв_ДобавитьОплатуАтол(Оплаты, 1, СуммаЭлектронно);
	эв_ДобавитьОплатуАтол(Оплаты, 2, СуммаПредоплаты);
	эв_ДобавитьОплатуАтол(Оплаты, 3, СуммаПостоплаты);
	эв_ДобавитьОплатуАтол(Оплаты, 4, СуммаВстречного);
	Если Оплаты.Количество() = 0 Тогда
		Оплата = Новый Структура;
		Оплата.Вставить("type", 1);
		Оплата.Вставить("sum", Итог);
		Оплаты.Добавить(Оплата);
	КонецЕсли;
	
	Возврат Оплаты;
	
КонецФункции

Процедура эв_ДобавитьОплатуАтол(Оплаты, ТипОплаты, Сумма)
	
	СуммаОплаты = Окр(Сумма, 2);
	Если СуммаОплаты <= 0 Тогда
		Возврат;
	КонецЕсли;
	Оплата = Новый Структура;
	Оплата.Вставить("type", ТипОплаты);
	Оплата.Вставить("sum", СуммаОплаты);
	Оплаты.Добавить(Оплата);
	
КонецПроцедуры

Функция эв_КлиентЧекаАтол(ДокументОбъект, Заказ)
	
	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Телефон, АдресЭП");
	Телефон = эв_ТелефонАтол(РеквизитыЗаказа.Телефон);
	Почта = СокрЛП(РеквизитыЗаказа.АдресЭП);
	Если Не СтрНайти(Почта, "@") > 0 Тогда
		Почта = "";
	КонецЕсли;
	Почта = Лев(Почта, 64);
	
	Клиент = Новый Структура;
	Если ЗначениеЗаполнено(Почта) Тогда
		Клиент.Вставить("email", Почта);
	КонецЕсли;
	Если ЗначениеЗаполнено(Телефон) Тогда
		Клиент.Вставить("phone", Телефон);
	КонецЕсли;
	Если Клиент.Количество() = 0 Тогда
		Клиент.Вставить("email", "none");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Сведения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.Контрагент, "НаименованиеПолное, ИНН");
		ИНН = эв_ТолькоЦифры(Сведения.ИНН);
		Если СтрДлина(ИНН) = 10 Или СтрДлина(ИНН) = 12 Тогда
			Клиент.Вставить("name", Лев(СокрЛП(Сведения.НаименованиеПолное), 256));
			Клиент.Вставить("inn", ИНН);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Клиент;
	
КонецФункции

Функция эв_ЗаказОснованиеЧека(ДокументОбъект)
	
	Если ЗначениеЗаполнено(ДокументОбъект.Заказ) Тогда
		Возврат ДокументОбъект.Заказ;
	КонецЕсли;
	
	Для Каждого СтрокаЗапасов Из ДокументОбъект.Запасы Цикл
		Если ЗначениеЗаполнено(СтрокаЗапасов.Заказ) Тогда
			Возврат СтрокаЗапасов.Заказ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
	
КонецФункции

Функция эв_ПочтаКомпанииПоЗаказу(Заказ)
	
	ВидЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "ВидЗаказа");
	Если Не ЗначениеЗаполнено(ВидЗаказа) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Источники.Почта КАК Почта
	|ИЗ
	|	Справочник.эв_ИсточникиЗаказов КАК Источники
	|ГДЕ
	|	Источники.Вид = &ВидЗаказа
	|	И НЕ Источники.ПометкаУдаления
	|	И Источники.Почта <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Источники.Активный УБЫВ,
	|	Источники.Код";
	Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Лев(СокрЛП(Выборка.Почта), 64);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция эв_МестоРасчетовЧека(ДокументОбъект)
	
	Если ЗначениеЗаполнено(ДокументОбъект.АдресСайта) Тогда
		Возврат Лев(СокрЛП(ДокументОбъект.АдресСайта), 256);
	КонецЕсли;
	
	Адрес = "";
	Если ЗначениеЗаполнено(ДокументОбъект.СтруктурнаяЕдиница) Тогда
		Адрес = ПечатьДокументовУНФ.КонтактнаяИнформация(
			ДокументОбъект.СтруктурнаяЕдиница,
			ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресСтруктурнойЕдиницы"));
		Если ПустаяСтрока(СокрЛП(Адрес)) Тогда
			Адрес = Строка(ДокументОбъект.СтруктурнаяЕдиница);
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Адрес)) И ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		Адрес = Строка(ДокументОбъект.Организация);
	КонецЕсли;
	
	Возврат Лев(СокрЛП(Адрес), 256);
	
КонецФункции

Функция эв_НаименованиеПозицииАтол(СтрокаЧека)
	
	Наименование = СокрЛП(СтрокаЧека.НаименованиеПолное);
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = Строка(СтрокаЧека.Номенклатура);
	КонецЕсли;
	Характеристика = СокрЛП(СтрокаЧека.Характеристика);
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Наименование = Наименование + " (" + Характеристика + ")";
	КонецЕсли;
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = НСтр("ru = 'Товар'");
	КонецЕсли;
	
	Возврат Лев(Наименование, 128);
	
КонецФункции

Процедура эв_ДобавитьАгентаПозицииАтол(Позиция, СтрокаЧека)
	
	Если ТипЗнч(СтрокаЧека.СтатусПартии) <> Тип("ПеречислениеСсылка.СтатусыПартий") Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаЧека.СтатусПартии <> Перечисления.СтатусыПартий.ТоварыНаКомиссии
		Или Не ЗначениеЗаполнено(СтрокаЧека.ВладелецПартии) Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаЧека.ВладелецПартии, "НаименованиеПолное, ИНН");
	ИНН = эв_ТолькоЦифры(Реквизиты.ИНН);
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат;
	КонецЕсли;
	
	Поставщик = Новый Структура;
	Поставщик.Вставить("name", Лев(СокрЛП(Реквизиты.НаименованиеПолное), 256));
	Поставщик.Вставить("inn", ИНН);
	Позиция.Вставить("agent_info", Новый Структура("type", "commission_agent"));
	Позиция.Вставить("supplier_info", Поставщик);
	
КонецПроцедуры

Функция эв_ПризнакПредметаРасчетаПозицииАтол(ПризнакПредметаРасчета, ЕстьКодМаркировки, ПодакцизныйТовар)
	
	КодПризнака = эв_КодПризнакаПредметаРасчетаАтол(ПризнакПредметаРасчета);
	Если ЕстьКодМаркировки Тогда
		Если КодПризнака = 2 Или КодПризнака = 30 Или КодПризнака = 31 Или ПодакцизныйТовар = Истина Тогда
			Возврат 31;
		КонецЕсли;
		Если КодПризнака <> 3 И КодПризнака <> 4 И КодПризнака <> 10 Тогда
			Возврат 33;
		КонецЕсли;
	ИначеЕсли КодПризнака = 33 Тогда
		Возврат 32;
	ИначеЕсли КодПризнака = 31 Тогда
		Возврат 30;
	КонецЕсли;
	
	Возврат КодПризнака;
	
КонецФункции

Функция эв_КодПризнакаПредметаРасчетаАтол(ПризнакПредметаРасчета)
	
	Признаки = Перечисления.ПризнакиПредметаРасчета;
	Если ПризнакПредметаРасчета = Признаки.Товар Тогда
		Возврат 1;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПодакцизныйТовар Тогда
		Возврат 2;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Работа Тогда
		Возврат 3;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Услуга Тогда
		Возврат 4;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.СтавкаАзартнойИгры Тогда
		Возврат 5;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВыигрышАзартнойИгры Тогда
		Возврат 6;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ЛотерейныйБилет Тогда
		Возврат 7;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВыигрышЛотереи Тогда
		Возврат 8;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПредоставлениеРИД Тогда
		Возврат 9;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПлатежВыплата Или ПризнакПредметаРасчета = Признаки.Платеж Тогда
		Возврат 10;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.АгентскоеВознаграждение Тогда
		Возврат 11;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.СоставнойПредметРасчета Тогда
		Возврат 12;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ИнойПредметРасчета Тогда
		Возврат 13;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ИмущественноеПраво Тогда
		Возврат 14;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВнереализационныйДоход Тогда
		Возврат 15;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.СтраховыеВзносы Тогда
		Возврат 16;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ТорговыйСбор Тогда
		Возврат 17;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.КурортныйСбор
		Или ПризнакПредметаРасчета = Признаки.ТуристическийНалог Тогда
		Возврат 18;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Залог Тогда
		Возврат 19;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Расход Тогда
		Возврат 20;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеПенсионноеСтрахованиеИП Тогда
		Возврат 21;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеПенсионноеСтрахование Тогда
		Возврат 22;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеМедицинскоеСтрахованиеИП Тогда
		Возврат 23;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеМедицинскоеСтрахование Тогда
		Возврат 24;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеСоциальноеСтрахование Тогда
		Возврат 25;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПлатежКазино Тогда
		Возврат 26;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВыдачаДенежныхСредств Или ПризнакПредметаРасчета = Признаки.Выплата Тогда
		Возврат 27;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПодакцизныйТоварМаркируемыйСИНеИмеющийКМ Тогда
		Возврат 30;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПодакцизныйТоварМаркируемыйСИИмеющийКМ Тогда
		Возврат 31;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ТоварМаркируемыйСИНеИмеющийКМ Тогда
		Возврат 32;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ТоварМаркируемыйСИИмеющийКМ Тогда
		Возврат 33;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

Функция эв_ПризнакСпособаРасчетаАтол(ПризнакСпособаРасчета)
	
	Признаки = Перечисления.ПризнакиСпособаРасчета;
	Если ПризнакСпособаРасчета = Признаки.ПредоплатаПолная Тогда
		Возврат "full_prepayment";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ПредоплатаЧастичная Тогда
		Возврат "prepayment";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.Аванс Тогда
		Возврат "advance";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ПередачаСЧастичнойОплатой Тогда
		Возврат "partial_payment";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ПередачаБезОплаты Тогда
		Возврат "credit";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ОплатаКредита Тогда
		Возврат "credit_payment";
	КонецЕсли;
	
	Возврат "full_payment";
	
КонецФункции

Функция эв_ТипНДСАтол(СтавкаЧислом, БезНДС, СтавкаЗаполнена, ЭтоАванс)
	
	Если Не СтавкаЗаполнена Или БезНДС Тогда
		Возврат "none";
	КонецЕсли;
	
	Ставка = Цел(СтавкаЧислом);
	Если Ставка = 0 Тогда
		Возврат "vat0";
	КонецЕсли;
	Если ЭтоАванс И (Ставка = 5 Или Ставка = 7 Или Ставка = 10 Или Ставка = 20 Или Ставка = 22) Тогда
		Возврат "vat" + Формат(100 + Ставка, "ЧГ=0");
	КонецЕсли;
	
	Возврат "vat" + Формат(Ставка, "ЧГ=0");
	
КонецФункции

Функция эв_МераКоличестваАтол(ЕдиницаИзмерения, ЕстьКодМаркировки)
	
	Если ЕстьКодМаркировки Или Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		Возврат 0;
	КонецЕсли;
	
	КодЕдиницы = "";
	Если ТипЗнч(ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
		Классификатор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ЕдиницаИзмерения, "ЕдиницаИзмеренияПоКлассификатору");
		Если ЗначениеЗаполнено(Классификатор) Тогда
			КодЕдиницы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Классификатор, "Код");
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		КодЕдиницы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Код");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СокрЛП(КодЕдиницы)) Тогда
		Возврат 0;
	КонецЕсли;
	
	Мера = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.МераКоличестваПредметаРасчетаПоКодуЕдиницыИзмерения(КодЕдиницы);
	КодМеры = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.КодМерыКоличестваПредметаРасчетаККТ(Мера);
	Если ТипЗнч(КодМеры) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат КодМеры;
	
КонецФункции

Функция эв_ТелефонАтол(Телефон)
	
	Цифры = эв_ТолькоЦифры(Телефон);
	Если ПустаяСтрока(Цифры) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(Цифры) = 11 И (Лев(Цифры, 1) = "7" Или Лев(Цифры, 1) = "8") Тогда
		Цифры = "7" + Сред(Цифры, 2);
	ИначеЕсли СтрДлина(Цифры) = 10 Тогда
		Цифры = "7" + Цифры;
	КонецЕсли;
	ТелефонАтол = "+" + Цифры;
	Если СтрДлина(ТелефонАтол) > 19 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ТелефонАтол;
	
КонецФункции

Функция эв_ТолькоЦифры(Текст)
	
	Результат = "";
	ИсходныйТекст = Строка(Текст);
	Для Индекс = 1 По СтрДлина(ИсходныйТекст) Цикл
		Символ = Сред(ИсходныйТекст, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ИдентификаторДокументаАтол(Содержание)
	
	Текст = СокрЛП(Содержание);
	Если Не СтрНачинаетсяС(Текст, "uuid:") Тогда
		Возврат "";
	КонецЕсли;
	Идентификатор = СокрЛП(Сред(Текст, 6));
	Если ПустаяСтрока(Идентификатор) Или Идентификатор = "sending" Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

Функция эв_РезультатФискализацииАтол(Данные)
	
	ПолезнаяНагрузка = эв_ЗначениеОтветаАтол(Данные, "payload");
	Результат = Новый Структура;
	Результат.Вставить("УникальныйИдентификатор", СокрЛП(Строка(эв_ЗначениеОтветаАтол(Данные, "uuid"))));
	Результат.Вставить("НомерФискальногоДокумента", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fiscal_document_number"));
	Результат.Вставить("ФискальныйПризнак", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fiscal_document_attribute"));
	Результат.Вставить("НомерФискальногоНакопителя", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fn_number"));
	Результат.Вставить("НомерСмены", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "shift_number"));
	Результат.Вставить("НомерЧека", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fiscal_receipt_number"));
	Результат.Вставить("ДатаЧека", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "receipt_datetime"));
	Результат.Вставить("АдресЧекаОФД", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "ofd_receipt_url"));
	Результат.Вставить("РегистрационныйНомерККТ", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "ecr_registration_number"));
	Возврат Результат;
	
КонецФункции

Функция эв_ОписаниеРезультатаФискализации(Результат)
	
	Возврат СтрШаблон(НСтр("ru = 'ФД %1, ФП %2, ФН %3'"),
		Результат.НомерФискальногоДокумента,
		Результат.ФискальныйПризнак,
		Результат.НомерФискальногоНакопителя);
	
КонецФункции

Функция эв_КодОшибкиАтол(Данные)
	
	Ошибка = эв_ЗначениеОтветаАтол(Данные, "error");
	Код = эв_ЗначениеОтветаАтол(Ошибка, "code");
	Если ТипЗнч(Код) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

Функция эв_ТекстОшибкиАтол(Данные)
	
	Ошибка = эв_ЗначениеОтветаАтол(Данные, "error");
	Если Ошибка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Текст = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ошибка, "text")));
	Если ПустаяСтрока(Текст) Или Текст = "Неопределено" Тогда
		Текст = НСтр("ru = 'Ошибка сервиса АТОЛ'");
	КонецЕсли;
	Код = эв_КодОшибкиАтол(Данные);
	Если Код <> 0 Тогда
		Возврат СтрШаблон("АТОЛ %1: %2", Формат(Код, "ЧГ=0"), Текст);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция эв_ЗначениеОтветаАтол(Данные, ИмяСвойства)
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные.Получить(ИмяСвойства);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_ТекстJSON(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция эв_ПрочитатьОтветАтол(ТекстОтвета)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина);
	
КонецФункции

Функция эв_КодироватьПараметрАтол(Значение)
	
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
	
КонецФункции

Процедура эв_ЗаписатьСостояниеЧекаВОчереди(ДокументОснование, ИдентификаторЗаписи, СтатусЧека, ТекстОшибки, Содержание, Результат)
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОчередьЧековККТ");
		ЭлементБлокировки.УстановитьЗначение("ДокументОснование", ДокументОснование);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗаписи", ИдентификаторЗаписи);
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.ОчередьЧековККТ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование);
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.СтатусЧека = СтатусЧека;
			Запись.ТекстОшибки = ТекстОшибки;
			Если Содержание <> Неопределено Тогда
				Запись.Содержание = Содержание;
			КонецЕсли;
			Если Результат <> Неопределено Тогда
				Запись.РезультатПакетнойОперации = Новый ХранилищеЗначения(Результат);
			КонецЕсли;
		КонецЦикла;
		НаборЗаписей.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура эв_ЗаписатьФискальнуюОперациюАтол(СтрокаОчереди, Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Не получен результат фискализации чека.'");
	КонецЕсли;
	
	ПараметрыЧека = эв_ПараметрыЧекаОчереди(СтрокаОчереди.ДокументОснование, СтрокаОчереди.ИдентификаторЗаписи);
	ДанныеЧека = ПараметрыЧека.ДанныеЧека;
	Если ТипЗнч(ДанныеЧека) <> Тип("Структура") Тогда
		ДанныеЧека = Новый Структура;
	КонецЕсли;
	
	Оплаты = эв_ОплатыФискальнойОперации(ДанныеЧека);
	СуммаЧека = Оплаты.Сумма;
	Если СуммаЧека = 0 Тогда
		СуммаЧека = ПараметрыЧека.Сумма;
	КонецЕсли;
	
	ДатаЧека = эв_ДатаЧекаАтол(Результат.ДатаЧека, ПараметрыЧека.ДатаЧека);
	Организация = эв_ЗначениеПараметраЧека(ДанныеЧека, "Организация", ПараметрыЧека.Организация);
	ТорговыйОбъект = эв_ЗначениеПараметраЧека(ДанныеЧека, "ТорговыйОбъект", ПараметрыЧека.ТорговыйОбъект);
	СубъектПерсональныхДанных = эв_ЗначениеПараметраЧека(
		ДанныеЧека, "СубъектПерсональныхДанных", ПараметрыЧека.СубъектПерсональныхДанных);
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ФискальныеОперации");
		ЭлементБлокировки.УстановитьЗначение("ДокументОснование", СтрокаОчереди.ДокументОснование);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗаписи", СтрокаОчереди.ИдентификаторЗаписи);
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.ФискальныеОперации.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументОснование.Установить(СтрокаОчереди.ДокументОснование);
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(СтрокаОчереди.ИдентификаторЗаписи);
		
		Запись = НаборЗаписей.Добавить();
		Запись.ДокументОснование = СтрокаОчереди.ДокументОснование;
		Запись.ИдентификаторЗаписи = СтрокаОчереди.ИдентификаторЗаписи;
		Запись.Дата = ДатаЧека;
		Запись.Организация = Организация;
		Запись.ТорговыйОбъект = ТорговыйОбъект;
		Запись.ТипДокумента = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек;
		Запись.ТипРасчета = СтрокаОчереди.ТипРасчета;
		Запись.НомерЧекаККМ = эв_ЧислоТСПИоТ(Результат.НомерЧека);
		Запись.НомерСменыККМ = эв_ЧислоТСПИоТ(Результат.НомерСмены);
		Запись.ФискальныйПризнак = эв_СтрокаРеквизитаТСПИоТ(Результат, "ФискальныйПризнак", 20);
		Запись.Сумма = СуммаЧека;
		Запись.ОплатаНаличные = Оплаты.Наличные;
		Запись.ОплатаЭлектронно = Оплаты.Электронно;
		Запись.ОплатаПредоплата = Оплаты.Предоплата;
		Запись.ОплатаПостоплата = Оплаты.Постоплата;
		Запись.ОплатаВстречноеПредоставление = Оплаты.ВстречноеПредоставление;
		Запись.АдресСайтаПроверки = эв_СтрокаРеквизитаТСПИоТ(Результат, "АдресЧекаОФД", 250);
		Запись.ЗаводскойНомерФН = эв_СтрокаРеквизитаТСПИоТ(Результат, "НомерФискальногоНакопителя", 20);
		Запись.РегистрационныйНомерККТ = эв_СтрокаРеквизитаТСПИоТ(Результат, "РегистрационныйНомерККТ", 20);
		Запись.ДополнительныйРеквизит = эв_СтрокаПараметраЧека(ДанныеЧека, "ДополнительныйРеквизит", 20);
		Запись.СубъектПерсональныхДанных = СубъектПерсональныхДанных;
		Запись.ЕдиныйЧек = эв_БулевоПараметраЧека(ДанныеЧека, "ЕдиныйЧек");
		Запись.ИдентификаторОплатыПлатежнойСистемы = эв_СтрокаПараметраЧека(
			ДанныеЧека, "ИдентификаторОплатыПлатежнойСистемы", 100);
		
		КорректируемыйДокумент = Неопределено;
		Если ДанныеЧека.Свойство("КорректируемыйДокумент", КорректируемыйДокумент) И ЗначениеЗаполнено(КорректируемыйДокумент) Тогда
			Запись.КорректируемыйДокумент = КорректируемыйДокумент;
		КонецЕсли;
		ТипПлатежнойСистемы = Неопределено;
		Если ДанныеЧека.Свойство("ТипПлатежнойСистемы", ТипПлатежнойСистемы)
			И ТипЗнч(ТипПлатежнойСистемы) = Тип("ПеречислениеСсылка.ТипыПлатежнойСистемыККТ") Тогда
			Запись.ТипПлатежнойСистемы = ТипПлатежнойСистемы;
		КонецЕсли;
		
		НаборЗаписей.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция эв_ПараметрыЧекаОчереди(ДокументОснование, ИдентификаторЗаписи)
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеЧека", Неопределено);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("ТорговыйОбъект", Неопределено);
	Результат.Вставить("Сумма", 0);
	Результат.Вставить("СубъектПерсональныхДанных", Неопределено);
	Результат.Вставить("ДатаЧека", ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОчередьЧековККТ.ДанныеЧека КАК ДанныеЧека,
	|	ОчередьЧековККТ.Организация КАК Организация,
	|	ОчередьЧековККТ.ТорговыйОбъект КАК ТорговыйОбъект,
	|	ОчередьЧековККТ.Сумма КАК Сумма,
	|	ОчередьЧековККТ.СубъектПерсональныхДанных КАК СубъектПерсональныхДанных
	|ИЗ
	|	РегистрСведений.ОчередьЧековККТ КАК ОчередьЧековККТ
	|ГДЕ
	|	ОчередьЧековККТ.ДокументОснование = &ДокументОснование
	|	И ОчередьЧековККТ.ИдентификаторЗаписи = &ИдентификаторЗаписи";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Результат, Выборка, "Организация, ТорговыйОбъект, Сумма, СубъектПерсональныхДанных");
	ДанныеЧека = Выборка.ДанныеЧека;
	Если ТипЗнч(ДанныеЧека) = Тип("ХранилищеЗначения") Тогда
		ДанныеЧека = ДанныеЧека.Получить();
	КонецЕсли;
	Если ТипЗнч(ДанныеЧека) = Тип("Структура") Тогда
		Результат.ДанныеЧека = ДанныеЧека;
		ДатаЧека = Неопределено;
		Если ДанныеЧека.Свойство("ДатаВремя", ДатаЧека) И ТипЗнч(ДатаЧека) = Тип("Дата") И ЗначениеЗаполнено(ДатаЧека) Тогда
			Результат.ДатаЧека = ДатаЧека;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ОплатыФискальнойОперации(ДанныеЧека)
	
	Результат = Новый Структура("Сумма, Наличные, Электронно, Предоплата, Постоплата, ВстречноеПредоставление", 0, 0, 0, 0, 0, 0);
	ТаблицаОплат = Неопределено;
	Если Не ДанныеЧека.Свойство("ТаблицаОплат", ТаблицаОплат) Или ТипЗнч(ТаблицаОплат) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаОплаты Из ТаблицаОплат Цикл
		Если ТипЗнч(СтрокаОплаты) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Сумма = 0;
		ТипОплаты = Неопределено;
		СтрокаОплаты.Свойство("Сумма", Сумма);
		СтрокаОплаты.Свойство("ТипОплаты", ТипОплаты);
		Если ТипЗнч(Сумма) <> Тип("Число") Тогда
			Сумма = 0;
		КонецЕсли;
		Если ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
			Результат.Электронно = Результат.Электронно + Сумма;
		ИначеЕсли ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
			Результат.Предоплата = Результат.Предоплата + Сумма;
		ИначеЕсли ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
			Результат.Постоплата = Результат.Постоплата + Сумма;
		ИначеЕсли ТипОплаты = Перечисления.ТипыОплатыККТ.ВстречноеПредоставление Тогда
			Результат.ВстречноеПредоставление = Результат.ВстречноеПредоставление + Сумма;
		Иначе
			Результат.Наличные = Результат.Наличные + Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Результат.Сумма = Результат.Наличные + Результат.Электронно + Результат.Предоплата
		+ Результат.Постоплата + Результат.ВстречноеПредоставление;
	Возврат Результат;
	
КонецФункции

Функция эв_ЗначениеПараметраЧека(ДанныеЧека, ИмяСвойства, ЗначениеПоУмолчанию)
	
	Значение = Неопределено;
	Если ДанныеЧека.Свойство(ИмяСвойства, Значение) И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция эв_СтрокаПараметраЧека(ДанныеЧека, ИмяСвойства, Длина)
	
	Значение = Неопределено;
	Если Не ДанныеЧека.Свойство(ИмяСвойства, Значение) Или ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Лев(СокрЛП(Значение), Длина);
	
КонецФункции

Функция эв_БулевоПараметраЧека(ДанныеЧека, ИмяСвойства)
	
	Значение = Неопределено;
	Если ДанныеЧека.Свойство(ИмяСвойства, Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция эв_ДатаЧекаАтол(Значение, ДатаПоУмолчанию)
	
	Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) >= 19 И Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
		Попытка
			Возврат Дата(
				Число(Сред(Текст, 7, 4)),
				Число(Сред(Текст, 4, 2)),
				Число(Сред(Текст, 1, 2)),
				Число(Сред(Текст, 12, 2)),
				Число(Сред(Текст, 15, 2)),
				Число(Сред(Текст, 18, 2)));
		Исключение
			Возврат ДатаПоУмолчанию;
		КонецПопытки;
	КонецЕсли;
	
	Возврат ДатаПоУмолчанию;
	
КонецФункции

Процедура эв_ЗаписатьОшибкуФискализацииАтол(ДокументОснование, ТекстОшибки)
	
	ЗаписьЖурналаРегистрации(
		"ЧекККМ.ОчередьЧековККТ",
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Документы.ЧекККМ,
		ДокументОснование,
		ТекстОшибки);
	
КонецПроцедуры

Функция эв_НовыйРезультатПроверкиКодаМаркировки()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("РазрешенаПродажа", Ложь);
	Результат.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ", "");
	Результат.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ", "");
	Результат.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО", "");
	Результат.Вставить("РазрешительныйРежимВерсияБазы", "");
	Результат.Вставить("ТекстОшибки", "");
	Возврат Результат;
	
КонецФункции

Функция эв_ПараметрыСоединенияТСПИоТ(АдресСервиса)
	
	ПараметрыСоединения = эв_ПараметрыСоединенияАтол(АдресСервиса);
	Путь = ПараметрыСоединения.Путь;
	Позиция = СтрНайти(НРег(Путь), "possystem/v5");
	Если Позиция > 0 Тогда
		Путь = Лев(Путь, Позиция - 1) + "tspiot/v1";
	Иначе
		Путь = "/tspiot/v1";
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Если Не СтрНачинаетсяС(Путь, "/") Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	ПараметрыСоединения.Путь = Путь;
	Возврат ПараметрыСоединения;
	
КонецФункции

Функция эв_ЗапросТСПИоТ(Настройки, Метод, ОтносительныйПуть, Тело, Токен, КэшТокенов, Повтор = Ложь)
	
	Путь = "/" + эв_КодироватьПараметрАтол(Настройки.КодГруппы) + ОтносительныйПуть;
	Ответ = эв_ВыполнитьЗапросАтол(Настройки.СоединениеТСПИоТ, Метод, Путь, Тело, Токен);
	КодОшибки = эв_КодОшибкиТСПИоТ(Ответ);
	Если Не Повтор И (КодОшибки = 10 Или КодОшибки = 11) Тогда
		эв_СброситьТокенАтол(Настройки, КэшТокенов);
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Возврат эв_ЗапросТСПИоТ(Настройки, Метод, ОтносительныйПуть, Тело, ДанныеТокена.Токен, КэшТокенов, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция эв_КодОшибкиТСПИоТ(Ответ)
	
	Если Ответ = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат эв_ЧислоТСПИоТ(эв_ЗначениеОтветаАтол(эв_ЗначениеОтветаАтол(Ответ.Данные, "error"), "code"));
	
КонецФункции

Функция эв_ЧислоТСПИоТ(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(СокрЛП(Значение)) Тогда
		Возврат 0;
	КонецЕсли;
	
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	Возврат ОписаниеЧисла.ПривестиЗначение(СокрЛП(Значение));
	
КонецФункции

Функция эв_ПовторитьЗапросТСПИоТ(Ответ, КодОшибки)
	
	Если Ответ <> Неопределено И Ответ.КодСостояния = 429 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат КодОшибки = 1 Или КодОшибки = 400 Или КодОшибки = 500 Или КодОшибки = 514;
	
КонецФункции

Функция эв_КодМаркировкиВBase64(КодМаркировки)
	
	Если эв_СтрокаВBase64(КодМаркировки) Тогда
		Возврат КодМаркировки;
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(КодМаркировки, КодировкаТекста.UTF8);
	Текст = Base64Строка(ДвоичныеДанные);
	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	Текст = СтрЗаменить(Текст, Символы.ПС, "");
	Возврат Текст;
	
КонецФункции

Функция эв_СтрокаВBase64(Текст)
	
	Длина = СтрДлина(Текст);
	Если Длина = 0 Или Длина % 4 <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По Длина Цикл
		КодСимвола = КодСимвола(Текст, НомерСимвола);
		ЭтоБукваИлиЦифра = (КодСимвола >= 48 И КодСимвола <= 57)
			Или (КодСимвола >= 65 И КодСимвола <= 90)
			Или (КодСимвола >= 97 И КодСимвола <= 122);
		Если Не ЭтоБукваИлиЦифра И КодСимвола <> 43 И КодСимвола <> 47 И КодСимвола <> 61 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция эв_ОписаниеОшибкиТСПИоТ(Данные)
	
	Ошибка = эв_ЗначениеОтветаАтол(Данные, "error");
	Описание = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ошибка, "description")));
	Если Описание = "" Или Описание = "Неопределено" Тогда
		Описание = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ошибка, "text")));
	КонецЕсли;
	Если Описание = "Неопределено" Тогда
		Описание = "";
	КонецЕсли;
	Если ПустаяСтрока(Описание) Тогда
		Описание = НСтр("ru = 'Не получен результат проверки кода маркировки в сервисе ТС ПИоТ.'");
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Процедура эв_ЗаполнитьРезультатПроверкиТСПИоТ(Результат, Ответ)
	
	Если Ответ = Неопределено Или Ответ.Данные = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не получен результат проверки кода маркировки в сервисе ТС ПИоТ.'");
		Возврат;
	КонецЕсли;
	
	КодОшибки = эв_КодОшибкиТСПИоТ(Ответ);
	Элементы = эв_ЗначениеОтветаАтол(Ответ.Данные, "result");
	Если ТипЗнч(Элементы) <> Тип("Массив") Или Элементы.Количество() = 0 Тогда
		Если КодОшибки = 203 Тогда
			Результат.Успех = Истина;
			Результат.РазрешенаПродажа = Истина;
		Иначе
			Результат.ТекстОшибки = эв_ОписаниеОшибкиТСПИоТ(Ответ.Данные);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Элемент = Элементы[0];
	Если эв_ЧислоТСПИоТ(эв_ЗначениеОтветаАтол(Элемент, "code")) <> 0 Тогда
		Описание = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Элемент, "description")));
		Если ПустаяСтрока(Описание) Или Описание = "Неопределено" Или НРег(Описание) = "ok" Тогда
			Описание = НСтр("ru = 'Сервис ТС ПИоТ не проверил код маркировки.'");
		КонецЕсли;
		Результат.ТекстОшибки = Описание;
		Возврат;
	КонецЕсли;
	
	Результат.РазрешительныйРежимИдентификаторЗапросаГИСМТ = эв_СтрокаРеквизитаТСПИоТ(Элемент, "req_id", 36);
	Результат.РазрешительныйРежимДатаЗапросаГИСМТ = эв_СтрокаРеквизитаТСПИоТ(Элемент, "req_timestamp", 14);
	Результат.РазрешительныйРежимИдентификаторЭкземпляраПО = эв_СтрокаРеквизитаТСПИоТ(Элемент, "inst", 36);
	Результат.РазрешительныйРежимВерсияБазы = эв_СтрокаРеквизитаТСПИоТ(Элемент, "version", 36);
	
	ПроверкаОфлайн = эв_ЗначениеОтветаАтол(Элемент, "is_checked_offline") = Истина;
	Сведения = эв_ЗначениеОтветаАтол(Элемент, "codes");
	Сведение = Неопределено;
	Если ТипЗнч(Сведения) = Тип("Массив") И Сведения.Количество() > 0 Тогда
		Сведение = Сведения[0];
	КонецЕсли;
	
	Если ПроверкаОфлайн Тогда
		Результат.РазрешенаПродажа = Не (Сведение <> Неопределено И эв_ЗначениеОтветаАтол(Сведение, "is_blocked") = Истина);
		Если Не Результат.РазрешенаПродажа Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Продажа товара заблокирована локальным модулем Честный знак.'");
		КонецЕсли;
	ИначеЕсли Сведение = Неопределено Или эв_ЗначениеОтветаАтол(Сведение, "can_be_sold") <> Истина Тогда
		Результат.РазрешенаПродажа = Ложь;
		Результат.ТекстОшибки = эв_ТекстЗапретаПродажиТСПИоТ(Сведение);
	Иначе
		Результат.РазрешенаПродажа = Истина;
	КонецЕсли;
	
	Если Результат.РазрешенаПродажа И Не ЗначениеЗаполнено(Результат.РазрешительныйРежимИдентификаторЗапросаГИСМТ) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Сервис ТС ПИоТ не вернул идентификатор запроса разрешительного режима.'");
		Возврат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	
КонецПроцедуры

Функция эв_СтрокаРеквизитаТСПИоТ(Элемент, ИмяСвойства, Длина)
	
	Значение = эв_ЗначениеОтветаАтол(Элемент, ИмяСвойства);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Текст = Формат(Значение, "ЧГ=0");
	Иначе
		Текст = СокрЛП(Строка(Значение));
	КонецЕсли;
	Если Текст = "Неопределено" Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Лев(Текст, Длина);
	
КонецФункции

Функция эв_ТекстЗапретаПродажиТСПИоТ(Сведение)
	
	Причины = Новый Массив;
	Если Сведение <> Неопределено Тогда
		ЗначенияПричин = эв_ЗначениеОтветаАтол(Сведение, "reason");
		Если ТипЗнч(ЗначенияПричин) = Тип("Массив") Тогда
			Для Каждого Причина Из ЗначенияПричин Цикл
				ТекстПричины = СокрЛП(Строка(Причина));
				Если ТекстПричины <> "" И ТекстПричины <> "Неопределено" Тогда
					Причины.Добавить(ТекстПричины);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СообщениеКода = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Сведение, "message")));
		Если СообщениеКода <> "" И СообщениеКода <> "Неопределено" И Причины.Найти(СообщениеКода) = Неопределено Тогда
			Причины.Добавить(СообщениеКода);
		КонецЕсли;
	КонецЕсли;
	Если Причины.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Продажа товара запрещена по результатам проверки кода маркировки.'");
	КонецЕсли;
	
	Возврат СтрСоединить(Причины, "; ");
	
КонецФункции

Процедура эв_Пауза(Миллисекунды)
	
	МоментОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунды;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментОкончания Цикл
	КонецЦикла;
	
КонецПроцедуры


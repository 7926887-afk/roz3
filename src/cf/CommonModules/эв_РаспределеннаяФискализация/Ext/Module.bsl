


#Область ПрограммныйИнтерфейс

// Ставит пробитый чек кассы без подключения оборудования в очередь ККТ
// для последующей фискализации в облачной кассе.
// Пока чек не пробит, запись этого документа из очереди удаляется.
// Для чека продажи признак пробития — статус «Пробит», для чека возврата — заполненный номер чека ККМ.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЧекККМ, ДокументОбъект.ЧекККМВозврат - записываемый чек.
//
Процедура эв_ПоставитьЧекБезОборудованияВОчередь(ДокументОбъект) Экспорт
	
	Если ДокументОбъект = Неопределено
		Или Не ЗначениеЗаполнено(ДокументОбъект.Ссылка)
		Или Не ЗначениеЗаполнено(ДокументОбъект.КассаККМ) Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьБезПодключенияОборудования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДокументОбъект.КассаККМ,
		"ИспользоватьБезПодключенияОборудования");
	Если ИспользоватьБезПодключенияОборудования <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	ЧекПробит = эв_ЧекБезОборудованияПробит(ДокументОбъект);
	Попытка
		Если ЧекПробит Тогда
			эв_ДобавитьЧекБезОборудованияВОчередь(ДокументОбъект.Ссылка);
		Иначе
			РаспределеннаяФискализация.УдалитьЧекИзОчереди(ДокументОбъект.Ссылка);
		КонецЕсли;
	Исключение
		ТекстСообщения = ?(ЧекПробит,
			НСтр("ru = 'Не удалось поставить чек в очередь фискализации. Подробности в журнале регистрации.'"),
			НСтр("ru = 'Не удалось убрать чек из очереди фискализации. Подробности в журнале регистрации.'"));
		ЗаписьЖурналаРегистрации(
			"ЧекККМ.ОчередьЧековККТ",
			УровеньЖурналаРегистрации.Ошибка,
			ДокументОбъект.Метаданные(),
			ДокументОбъект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

// Фискальный чек уходит в АТОЛ Онлайн при обработке очереди, после успеха документ помечается пробитым.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ЧекККМКоррекции, ДокументОбъект.ЧекККМКоррекции - чек коррекции.
//
// Возвращаемое значение:
//  Строка - сообщение для пользователя.
//
Функция эв_ПоставитьЧекКоррекцииБезОборудованияВОчередь(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументОбъект.ЧекККМКоррекции") Тогда
		ДокументСсылка = ДокументСсылка.Ссылка;
	КонецЕсли;
	Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ЧекККМКоррекции")
		Или Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат НСтр("ru = 'Чек коррекции не записан.'");
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументСсылка, "КассаККМ, ПробитЧек");
	Если Не ЗначениеЗаполнено(Реквизиты.КассаККМ) Тогда
		Возврат НСтр("ru = 'В чеке коррекции не заполнена касса ККМ.'");
	КонецЕсли;
	
	ИспользоватьБезПодключенияОборудования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Реквизиты.КассаККМ, "ИспользоватьБезПодключенияОборудования");
	Если ИспользоватьБезПодключенияОборудования <> Истина Тогда
		Возврат "";
	КонецЕсли;
	Если Реквизиты.ПробитЧек = Истина Тогда
		Возврат НСтр("ru = 'Чек коррекции уже пробит.'");
	КонецЕсли;
	Если эв_ЕстьЧекВОчереди(ДокументСсылка) Тогда
		Возврат НСтр("ru = 'Чек коррекции уже находится в очереди фискализации.'");
	КонецЕсли;
	
	Попытка
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ПараметрыЧека = эв_ПараметрыЧекаКоррекцииДляОчереди(ДокументОбъект);
		ИдентификаторЗаписи = РаспределеннаяФискализация.ДобавитьЧекВОчередьЧековККТ(ПараметрыЧека, , Ложь);
		Если Не ЗначениеЗаполнено(ИдентификаторЗаписи) Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось добавить чек коррекции в очередь.'");
		КонецЕсли;
		эв_УстановитьТипДокументаОчереди(
			ДокументСсылка,
			ИдентификаторЗаписи,
			Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ЧекККМ.ОчередьЧековККТ",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЧекККМКоррекции,
			ДокументСсылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат НСтр("ru = 'Не удалось поставить чек коррекции в очередь фискализации. Подробности в журнале регистрации.'");
	КонецПопытки;
	
	Возврат НСтр("ru = 'Чек коррекции поставлен в очередь фискализации АТОЛ Онлайн.'");
	
КонецФункции

// Ставит возврат оплаты на карту, введенный по операции эквайринга,
// в очередь фискализации чека «Возврат аванса» (sell_refund, признак способа расчета «аванс»).
// Касса ККМ документа должна работать без подключения оборудования.
// После успешной фискализации в АТОЛ документ помечается пробитым.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ОперацияПоПлатежнымКартам, ДокументОбъект.ОперацияПоПлатежнымКартам - возврат оплаты.
//
// Возвращаемое значение:
//  Строка - сообщение для пользователя. Пустая строка, если документ не относится к этому сценарию.
//
Функция эв_ПоставитьВозвратАвансаБезОборудованияВОчередь(ДокументСсылка) Экспорт
	
	ДокументОбъект = Неопределено;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументОбъект.ОперацияПоПлатежнымКартам") Тогда
		ДокументОбъект = ДокументСсылка;
		ДокументСсылка = ДокументОбъект.Ссылка;
	КонецЕсли;
	Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ОперацияПоПлатежнымКартам")
		Или Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат НСтр("ru = 'Возврат оплаты на карту не записан.'");
	КонецЕсли;
	
	Если ДокументОбъект = Неопределено Тогда
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	КонецЕсли;
	Если ДокументОбъект = Неопределено Или Не эв_ЭтоВозвратАванса(ДокументОбъект) Тогда
		Возврат "";
	КонецЕсли;
	ТекстЗапрета = эв_ТекстЗапретаВозвратаПослеОтгрузки(ДокументОбъект);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		Возврат ТекстЗапрета;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОбъект.КассаККМ) Тогда
		Возврат НСтр("ru = 'В возврате оплаты на карту не заполнена касса ККМ.'");
	КонецЕсли;
	
	ИспользоватьБезПодключенияОборудования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДокументОбъект.КассаККМ, "ИспользоватьБезПодключенияОборудования");
	Если ИспользоватьБезПодключенияОборудования <> Истина Тогда
		Возврат "";
	КонецЕсли;
	Если эв_ВозвратАвансаУжеФискализирован(ДокументСсылка) Тогда
		Возврат НСтр("ru = 'Чек возврата аванса уже пробит.'");
	КонецЕсли;
	Если эв_ЕстьЧекВОчереди(ДокументСсылка) Тогда
		Возврат НСтр("ru = 'Возврат аванса уже находится в очереди фискализации.'");
	КонецЕсли;
	
	Попытка
		ПараметрыЧека = эв_ПараметрыВозвратаАвансаДляОчереди(ДокументОбъект);
		Если ЗначениеЗаполнено(ПараметрыЧека.ТекстОшибки) Тогда
			Возврат ПараметрыЧека.ТекстОшибки;
		КонецЕсли;
		ИдентификаторЗаписи = РаспределеннаяФискализация.ДобавитьЧекВОчередьЧековККТ(ПараметрыЧека.Параметры, , Ложь);
		Если Не ЗначениеЗаполнено(ИдентификаторЗаписи) Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось добавить возврат аванса в очередь.'");
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			"ЧекККМ.ОчередьЧековККТ",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ОперацияПоПлатежнымКартам,
			ДокументСсылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат НСтр("ru = 'Не удалось поставить возврат аванса в очередь фискализации. Подробности в журнале регистрации.'");
	КонецПопытки;
	
	Возврат НСтр("ru = 'Возврат аванса поставлен в очередь фискализации АТОЛ Онлайн.'");
	
КонецФункции

// Фискализирует чеки регистра ОчередьЧековККТ в облачной кассе АТОЛ Онлайн (протокол v5).
// Берутся чеки ККМ, чеки возврата, чеки коррекции и возвраты аванса касс без подключения оборудования в статусах Новый, Ошибка и Фискализируется.
// Логин, пароль, код группы и адрес сервиса читаются из регистра эв_НастройкиAPIОнлайнКассы.
// Повторный запуск дочитывает результат чеков, которые сервис еще обрабатывает.
// Результат успешной фискализации записывается в регистр ФискальныеОперации по чеку очереди.
//
Процедура эв_ОбработатьОчередьЧековККТ() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЧекиОчереди = эв_ЧекиОчередиДляФискализацииАтол();
	Если ЧекиОчереди.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'В очереди нет чеков для фискализации в АТОЛ Онлайн.'"));
		Возврат;
	КонецЕсли;
	
	КэшНастроек = Новый Соответствие;
	КэшТокенов = Новый Соответствие;
	Фискализировано = 0;
	Ожидают = 0;
	Ошибок = 0;
	
	Для Каждого СтрокаОчереди Из ЧекиОчереди Цикл
		Попытка
			ИтогОбработки = эв_ОбработатьЧекОчередиАтол(СтрокаОчереди, КэшНастроек, КэшТокенов);
		Исключение
			ИтогОбработки = "error";
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			эв_ЗаписатьСостояниеЧекаВОчереди(
				СтрокаОчереди.ДокументОснование,
				СтрокаОчереди.ИдентификаторЗаписи,
				Перечисления.СтатусЧекаККТВОчереди.Ошибка,
				ТекстОшибки,
				Неопределено,
				Неопределено);
			эв_ЗаписатьОшибкуФискализацииАтол(СтрокаОчереди.ДокументОснование, ТекстОшибки);
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = '%1: %2'"), СтрокаОчереди.ДокументОснование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		
		Если ИтогОбработки = "done" Тогда
			Фискализировано = Фискализировано + 1;
		ИначеЕсли ИтогОбработки = "wait" Тогда
			Ожидают = Ожидают + 1;
		Иначе
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
		НСтр("ru = 'Очередь АТОЛ обработана. Фискализировано: %1. Ожидают результат: %2. Ошибки: %3.'"),
		Фискализировано,
		Ожидают,
		Ошибок));
	
КонецПроцедуры 
	
// Используется для кассы с признаком работы без подключения оборудования.
//
// Параметры:
//  КассаККМ - СправочникСсылка.КассыККМ - касса, для которой заданы настройки API.
//  КодМаркировки - Строка - код маркировки в формате GS1 или Base64.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - запрос выполнен и ответ сервиса разобран.
//   * РазрешенаПродажа - Булево - ПМСР разрешает продажу.
//   * РазрешительныйРежимИдентификаторЗапросаГИСМТ - Строка - req_id.
//   * РазрешительныйРежимДатаЗапросаГИСМТ - Строка - reqTimestamp.
//   * РазрешительныйРежимИдентификаторЭкземпляраПО - Строка - inst.
//   * РазрешительныйРежимВерсияБазы - Строка - version.
//   * ТекстОшибки - Строка - текст ошибки или причина запрета продажи.
//
Функция эв_ПроверитьКодМаркировкиТСПИоТ(КассаККМ, КодМаркировки) Экспорт
	
	Результат = эв_НовыйРезультатПроверкиКодаМаркировки();
	КодМаркировки = СокрЛП(КодМаркировки);
	Если Не ЗначениеЗаполнено(КассаККМ) Или Не ЗначениеЗаполнено(КодМаркировки) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнены касса или код маркировки для проверки.'");
		Возврат Результат;
	КонецЕсли;
	
	КэшНастроек = Новый Соответствие;
	КэшТокенов = Новый Соответствие;
	Настройки = эв_НастройкиКассыАтол(КассаККМ, КэшНастроек);
	Если Не Настройки.Заполнены Тогда
		Результат.ТекстОшибки = Настройки.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Настройки.Вставить("СоединениеТСПИоТ", эв_ПараметрыСоединенияТСПИоТ(Настройки.Адрес));
	
	Попытка
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Результат.ТекстОшибки = ДанныеТокена.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Коды = Новый Массив;
		Коды.Добавить(эв_КодМаркировкиВBase64(КодМаркировки));
		Тело = эв_ТекстJSON(Новый Структура("codes", Коды));
		Ответ = Неопределено;
		Для НомерПопытки = 1 По 3 Цикл
			Если НомерПопытки > 1 Тогда
				эв_Пауза(1000);
				ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
				Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
					Результат.ТекстОшибки = ДанныеТокена.ТекстОшибки;
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
			Ответ = эв_ЗапросТСПИоТ(Настройки, "POST", "/codes/check", Тело, ДанныеТокена.Токен, КэшТокенов);
			КодОшибки = эв_КодОшибкиТСПИоТ(Ответ);
			Если КодОшибки = 203 Тогда
				Результат.Успех = Истина;
				Результат.РазрешенаПродажа = Истина;
				Возврат Результат;
			КонецЕсли;
			Если Не эв_ПовторитьЗапросТСПИоТ(Ответ, КодОшибки) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		эв_ЗаполнитьРезультатПроверкиТСПИоТ(Результат, Ответ);
	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"ЧекККМ.ПроверкаКодаМаркировкиТСПИоТ",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЧекККМ,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&Вместо("ЧекиВОчередиНаФискализацию")
Функция эв_ЧекиВОчередиНаФискализацию(КассаККМ = Неопределено, ОблачнаяККТ = Ложь) Экспорт
	
	ЧекиНаФискализацию = ПродолжитьВызов(КассаККМ, ОблачнаяККТ);
	эв_ИсключитьЧекиКассБезОборудования(ЧекиНаФискализацию);
	Возврат ЧекиНаФискализацию;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура эв_ДобавитьЧекБезОборудованияВОчередь(ДокументСсылка)
	
	Если эв_ЕстьЧекВОчереди(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляФискализации = Документы.ЧекККМ.ПолучитьДанныеДляФискализации(ДокументСсылка);
	Если ТипЗнч(ДанныеДляФискализации) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	РаспределеннаяФискализация.ДобавитьЧекВОчередьЧековККТ(ДанныеДляФискализации, , Ложь);
	
КонецПроцедуры

Функция эв_ЧекБезОборудованияПробит(ДокументОбъект)
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМВозврат") Тогда
		Возврат ЗначениеЗаполнено(ДокументОбъект.НомерЧекаККМ);
	КонецЕсли;
	
	Возврат ДокументОбъект.Статус = Перечисления.СтатусыЧековККМ.Пробит;
	
КонецФункции

Функция эв_ЕстьЧекВОчереди(ДокументСсылка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОчередьЧековККТ.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.ОчередьЧековККТ КАК ОчередьЧековККТ
	|ГДЕ
	|	ОчередьЧековККТ.ДокументОснование = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура эв_ИсключитьЧекиКассБезОборудования(ЧекиНаФискализацию)
	
	Если ТипЗнч(ЧекиНаФискализацию) <> Тип("Массив") Или ЧекиНаФискализацию.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КассыККМ = Новый Массив;
	Для Каждого ЧекВОчереди Из ЧекиНаФискализацию Цикл
		КассаККМ = Неопределено;
		Если ТипЗнч(ЧекВОчереди) = Тип("Структура") Тогда
			ЧекВОчереди.Свойство("КассаККМ", КассаККМ);
		КонецЕсли;
		Если ЗначениеЗаполнено(КассаККМ) И КассыККМ.Найти(КассаККМ) = Неопределено Тогда
			КассыККМ.Добавить(КассаККМ);
		КонецЕсли;
	КонецЦикла;
	
	Если КассыККМ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КассыБезОборудования = эв_КассыБезПодключенияОборудования(КассыККМ);
	Если КассыБезОборудования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = ЧекиНаФискализацию.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ЧекВОчереди = ЧекиНаФискализацию[Индекс];
		КассаККМ = Неопределено;
		Если ТипЗнч(ЧекВОчереди) = Тип("Структура") Тогда
			ЧекВОчереди.Свойство("КассаККМ", КассаККМ);
		КонецЕсли;
		Если КассыБезОборудования.Получить(КассаККМ) <> Неопределено Тогда
			ЧекиНаФискализацию.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

Функция эв_КассыБезПодключенияОборудования(КассыККМ)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КассыККМ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	КассыККМ.Ссылка В (&КассыККМ)
	|	И КассыККМ.ИспользоватьБезПодключенияОборудования";
	Запрос.УстановитьПараметр("КассыККМ", КассыККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область ФискализацияАтолОнлайн

Функция эв_ЧекиОчередиДляФискализацииАтол()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОчередьЧековККТ.ДокументОснование КАК ДокументОснование,
	|	ОчередьЧековККТ.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	ОчередьЧековККТ.СтатусЧека КАК СтатусЧека,
	|	ОчередьЧековККТ.КассаККМ КАК КассаККМ,
	|	ОчередьЧековККТ.ТипРасчета КАК ТипРасчета,
	|	ОчередьЧековККТ.Содержание КАК Содержание,
	|	ОчередьЧековККТ.ТекстОшибки КАК ТекстОшибки
	|ИЗ
	|	РегистрСведений.ОчередьЧековККТ КАК ОчередьЧековККТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК КассыККМ
	|		ПО ОчередьЧековККТ.КассаККМ = КассыККМ.Ссылка
	|ГДЕ
	|	КассыККМ.ИспользоватьБезПодключенияОборудования
	|	И ТИПЗНАЧЕНИЯ(ОчередьЧековККТ.ДокументОснование) В (
	|		ТИП(Документ.ЧекККМ),
	|		ТИП(Документ.ЧекККМВозврат),
	|		ТИП(Документ.ЧекККМКоррекции),
	|		ТИП(Документ.ОперацияПоПлатежнымКартам))
	|	И ОчередьЧековККТ.СтатусЧека В (
	|		ЗНАЧЕНИЕ(Перечисление.СтатусЧекаККТВОчереди.Новый),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусЧекаККТВОчереди.Ошибка),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусЧекаККТВОчереди.Фискализируется))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОчередьЧековККТ.Дата";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция эв_ОбработатьЧекОчередиАтол(СтрокаОчереди, КэшНастроек, КэшТокенов)
	
	Настройки = эв_НастройкиКассыАтол(СтрокаОчереди.КассаККМ, КэшНастроек);
	Если Не Настройки.Заполнены Тогда
		Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, Настройки.ТекстОшибки, Неопределено);
	КонецЕсли;
	
	ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
	Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
		Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, ДанныеТокена.ТекстОшибки, Неопределено);
	КонецЕсли;
	
	ИдентификаторДокумента = эв_ИдентификаторДокументаАтол(СтрокаОчереди.Содержание);
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Если СтрНачинаетсяС(СтрокаОчереди.ТекстОшибки, "АТОЛ 33:") Тогда
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, СтрокаОчереди.ТекстОшибки, Неопределено);
		КонецЕсли;
		
		ДокументОбъект = СтрокаОчереди.ДокументОснование.ПолучитьОбъект();
		Если ДокументОбъект = Неопределено Тогда
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди,
				НСтр("ru = 'Не удалось прочитать документ фискализации.'"), Неопределено);
		КонецЕсли;
		
		Если эв_ЭтоЧекКоррекции(СтрокаОчереди.ДокументОснование) Тогда
			ТелоДокумента = эв_ТелоКоррекцииАтол(ДокументОбъект, СтрокаОчереди.ИдентификаторЗаписи);
			Операция = эв_ОперацияКоррекцииАтол(ДокументОбъект.ТипРасчета);
		ИначеЕсли эв_ЭтоВозвратАванса(ДокументОбъект) Тогда
			ТелоДокумента = эв_ТелоВозвратаАвансаАтол(ДокументОбъект, СтрокаОчереди.ИдентификаторЗаписи);
			Операция = "sell_refund";
		Иначе
			ЭтоВозврат = СтрокаОчереди.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств
				Или ТипЗнч(СтрокаОчереди.ДокументОснование) = Тип("ДокументСсылка.ЧекККМВозврат");
			ТелоДокумента = эв_ТелоДокументаАтол(ДокументОбъект, СтрокаОчереди.ИдентификаторЗаписи, ЭтоВозврат);
			Операция = ?(ЭтоВозврат, "sell_refund", "sell");
		КонецЕсли;

		Если ЗначениеЗаполнено(ТелоДокумента.ТекстОшибки) Тогда
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, ТелоДокумента.ТекстОшибки, "");
		КонецЕсли;
		
		Ответ = эв_ЗарегистрироватьДокументАтол(
			Настройки, ДанныеТокена.Токен, Операция, эв_ТекстJSON(ТелоДокумента.Тело), КэшТокенов);
		КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
		ИдентификаторДокумента = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ответ.Данные, "uuid")));
		Если КодОшибки <> 0 Или Не ЗначениеЗаполнено(ИдентификаторДокумента) Или ИдентификаторДокумента = "Неопределено" Тогда
			ТекстОшибки = эв_ТекстОшибкиАтол(Ответ.Данные);
			Если ПустаяСтрока(ТекстОшибки) Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'АТОЛ не зарегистрировал чек. Код состояния %1.'"), Ответ.КодСостояния);
			КонецЕсли;
			Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, ТекстОшибки, "");
		КонецЕсли;
		
		эв_ЗаписатьСостояниеЧекаВОчереди(
			СтрокаОчереди.ДокументОснование,
			СтрокаОчереди.ИдентификаторЗаписи,
			Перечисления.СтатусЧекаККТВОчереди.Фискализируется,
			"",
			"uuid:" + ИдентификаторДокумента,
			Неопределено);
	КонецЕсли;
	
	РезультатОжидания = эв_ДождатьсяРезультатаАтол(Настройки, ИдентификаторДокумента, КэшТокенов);
	Если РезультатОжидания.Статус = "done" Тогда
		Описание = эв_ОписаниеРезультатаФискализации(РезультатОжидания.Результат);
		эв_ЗаписатьФискальнуюОперациюАтол(СтрокаОчереди, РезультатОжидания.Результат);
		эв_ОтметитьЧекКоррекцииПробитым(СтрокаОчереди.ДокументОснование, РезультатОжидания.Результат);
		эв_ОтметитьВозвратАвансаПробитым(СтрокаОчереди.ДокументОснование, РезультатОжидания.Результат);
		эв_ЗаписатьСостояниеЧекаВОчереди(
			СтрокаОчереди.ДокументОснование,
			СтрокаОчереди.ИдентификаторЗаписи,
			Перечисления.СтатусЧекаККТВОчереди.Фискализирован,
			"",
			Описание,
			РезультатОжидания.Результат);
		Возврат "done";
	КонецЕсли;
	
	Если РезультатОжидания.Статус = "fail" Или РезультатОжидания.Статус = "error" Тогда
		СодержаниеИдентификатора = Неопределено;
		Если РезультатОжидания.ПовторитьОтправку Тогда
			СодержаниеИдентификатора = "";
		КонецЕсли;
		Возврат эв_ОшибкаЧекаАтол(СтрокаОчереди, РезультатОжидания.ТекстОшибки, СодержаниеИдентификатора);
	КонецЕсли;
	
	эв_ЗаписатьСостояниеЧекаВОчереди(
		СтрокаОчереди.ДокументОснование,
		СтрокаОчереди.ИдентификаторЗаписи,
		Перечисления.СтатусЧекаККТВОчереди.Фискализируется,
		"",
		"uuid:" + ИдентификаторДокумента,
		Неопределено);
	Возврат "wait";
	
КонецФункции

Функция эв_ОшибкаЧекаАтол(СтрокаОчереди, ТекстОшибки, Содержание)
	
	эв_ЗаписатьСостояниеЧекаВОчереди(
		СтрокаОчереди.ДокументОснование,
		СтрокаОчереди.ИдентификаторЗаписи,
		Перечисления.СтатусЧекаККТВОчереди.Ошибка,
		ТекстОшибки,
		Содержание,
		Неопределено);
	эв_ЗаписатьОшибкуФискализацииАтол(СтрокаОчереди.ДокументОснование, ТекстОшибки);
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = '%1: %2'"), СтрокаОчереди.ДокументОснование, ТекстОшибки));
	Возврат "error";
	
КонецФункции

Функция эв_НастройкиКассыАтол(КассаККМ, КэшНастроек)
	
	Сохраненные = КэшНастроек.Получить(КассаККМ);
	Если Сохраненные <> Неопределено Тогда
		Возврат Сохраненные;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Заполнены", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Логин", "");
	Результат.Вставить("Пароль", "");
	Результат.Вставить("КодГруппы", "");
	Результат.Вставить("Адрес", "");
	Результат.Вставить("Соединение", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.Адрес КАК Адрес,
	|	Настройки.Логин КАК Логин,
	|	Настройки.Пароль КАК Пароль,
	|	Настройки.КодГруппы КАК КодГруппы
	|ИЗ
	|	РегистрСведений.эв_НастройкиAPIОнлайнКассы КАК Настройки
	|ГДЕ
	|	Настройки.КассаККМ = &КассаККМ";
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Логин = СокрЛП(Выборка.Логин);
		Результат.Пароль = СокрЛП(Выборка.Пароль);
		Результат.КодГруппы = СокрЛП(Выборка.КодГруппы);
		Результат.Адрес = СокрЛП(Выборка.Адрес);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Логин)
		И ЗначениеЗаполнено(Результат.Пароль)
		И ЗначениеЗаполнено(Результат.КодГруппы) Тогда
		Результат.Заполнены = Истина;
		Результат.Соединение = эв_ПараметрыСоединенияАтол(Результат.Адрес);
	Иначе
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Для кассы %1 не заполнены логин, пароль или код группы в настройках API онлайн-кассы.'"),
			КассаККМ);
	КонецЕсли;
	
	КэшНастроек.Вставить(КассаККМ, Результат);
	Возврат Результат;
	
КонецФункции

Функция эв_ПараметрыСоединенияАтол(АдресСервиса)
	
	Адрес = СокрЛП(АдресСервиса);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "https://online.atol.ru";
	КонецЕсли;
	Если НРег(Лев(Адрес, 7)) <> "http://" И НРег(Лев(Адрес, 8)) <> "https://" Тогда
		Адрес = "https://" + Адрес;
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
	Порт = СтруктураURI.Порт;
	ЗащищенноеСоединение = Неопределено;
	Если СтруктураURI.Схема = "https" Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		Если Порт = Неопределено Тогда
			Порт = 443;
		КонецЕсли;
	ИначеЕсли Порт = Неопределено Тогда
		Порт = 80;
	КонецЕсли;
	
	Путь = СтруктураURI.ПутьНаСервере;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Если Не СтрЗаканчиваетсяНа(НРег(Путь), "possystem/v5") Тогда
		Если ЗначениеЗаполнено(Путь) Тогда
			Путь = Путь + "/";
		КонецЕсли;
		Путь = Путь + "possystem/v5";
	КонецЕсли;
	Если Не СтрНачинаетсяС(Путь, "/") Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Сервер", СтруктураURI.Хост);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("ЗащищенноеСоединение", ЗащищенноеСоединение);
	Результат.Вставить("Путь", Путь);
	Возврат Результат;
	
КонецФункции

Функция эв_ТокенАтол(Настройки, КэшТокенов)
	
	Ключ = Настройки.Адрес + "|" + Настройки.Логин;
	Сохраненный = КэшТокенов.Получить(Ключ);
	Если Сохраненный <> Неопределено Тогда
		Возврат Сохраненный;
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("login", Настройки.Логин);
	Тело.Вставить("pass", Настройки.Пароль);
	Ответ = эв_ВыполнитьЗапросАтол(Настройки.Соединение, "POST", "/getToken", эв_ТекстJSON(Тело), "");
	
	Токен = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ответ.Данные, "token")));
	ТекстОшибки = "";
	Если Не ЗначениеЗаполнено(Токен) Или Токен = "Неопределено" Тогда
		Токен = "";
		ТекстОшибки = эв_ТекстОшибкиАтол(Ответ.Данные);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не получен токен АТОЛ. Код состояния %1.'"), Ответ.КодСостояния);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура("Токен, ТекстОшибки", Токен, ТекстОшибки);
	КэшТокенов.Вставить(Ключ, Результат);
	Возврат Результат;
	
КонецФункции

Процедура эв_СброситьТокенАтол(Настройки, КэшТокенов)
	
	КэшТокенов.Удалить(Настройки.Адрес + "|" + Настройки.Логин);
	
КонецПроцедуры

Функция эв_ЗарегистрироватьДокументАтол(Настройки, Токен, Операция, Тело, КэшТокенов, Повтор = Ложь)
	
	Путь = "/" + эв_КодироватьПараметрАтол(Настройки.КодГруппы) + "/" + Операция;
	Ответ = эв_ВыполнитьЗапросАтол(Настройки.Соединение, "POST", Путь, Тело, Токен);
	КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
	Если Не Повтор И (КодОшибки = 10 Или КодОшибки = 11) Тогда
		эв_СброситьТокенАтол(Настройки, КэшТокенов);
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Возврат эв_ЗарегистрироватьДокументАтол(Настройки, ДанныеТокена.Токен, Операция, Тело, КэшТокенов, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция эв_ДождатьсяРезультатаАтол(Настройки, ИдентификаторДокумента, КэшТокенов)
	
	Результат = Новый Структура("Статус, ТекстОшибки, Результат, ПовторитьОтправку", "wait", "", Неопределено, Ложь);
	Для НомерПопытки = 1 По 3 Цикл
		Если НомерПопытки > 1 Тогда
			эв_Пауза(2000);
		КонецЕсли;
		
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если Не ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Результат.Статус = "error";
			Результат.ТекстОшибки = ДанныеТокена.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Ответ = эв_РезультатДокументаАтол(Настройки, ДанныеТокена.Токен, ИдентификаторДокумента, КэшТокенов);
		КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
		Статус = НРег(СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ответ.Данные, "status"))));
		Если Статус = "done" И КодОшибки = 0 Тогда
			Результат.Статус = "done";
			Результат.Результат = эв_РезультатФискализацииАтол(Ответ.Данные);
			Возврат Результат;
		КонецЕсли;
		Если Ответ.Данные = Неопределено Или КодОшибки = 34 Или (Статус = "wait" И КодОшибки = 0) Тогда
			Продолжить;
		КонецЕсли;
		Если КодОшибки <> 0 Или Статус = "fail" Тогда
			Результат.Статус = "fail";
			Результат.ПовторитьОтправку = Статус = "fail";
			Результат.ТекстОшибки = эв_ТекстОшибкиАтол(Ответ.Данные);
			Если ПустаяСтрока(Результат.ТекстОшибки) Тогда
				Результат.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'АТОЛ не фискализировал чек. Код состояния %1.'"), Ответ.КодСостояния);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_РезультатДокументаАтол(Настройки, Токен, ИдентификаторДокумента, КэшТокенов, Повтор = Ложь)
	
	Путь = "/" + эв_КодироватьПараметрАтол(Настройки.КодГруппы)
		+ "/report/" + эв_КодироватьПараметрАтол(ИдентификаторДокумента);
	Ответ = эв_ВыполнитьЗапросАтол(Настройки.Соединение, "GET", Путь, Неопределено, Токен);
	КодОшибки = эв_КодОшибкиАтол(Ответ.Данные);
	Если Не Повтор И (КодОшибки = 10 Или КодОшибки = 11) Тогда
		эв_СброситьТокенАтол(Настройки, КэшТокенов);
		ДанныеТокена = эв_ТокенАтол(Настройки, КэшТокенов);
		Если ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			Возврат эв_РезультатДокументаАтол(
				Настройки, ДанныеТокена.Токен, ИдентификаторДокумента, КэшТокенов, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция эв_ВыполнитьЗапросАтол(ПараметрыСоединения, Метод, Путь, Тело, Токен)
	
	Соединение = Новый HTTPСоединение(
		ПараметрыСоединения.Сервер,
		ПараметрыСоединения.Порт,
		Неопределено,
		Неопределено,
		Неопределено,
		60,
		ПараметрыСоединения.ЗащищенноеСоединение);
	Запрос = Новый HTTPЗапрос(ПараметрыСоединения.Путь + Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если ЗначениеЗаполнено(Токен) Тогда
		Запрос.Заголовки.Вставить("Token", Токен);
	КонецЕсли;
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	
	ОтветHTTP = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	ТекстОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", ОтветHTTP.КодСостояния);
	Результат.Вставить("Текст", ТекстОтвета);
	Результат.Вставить("Данные", Неопределено);
	Если ЗначениеЗаполнено(СокрЛП(ТекстОтвета)) Тогда
		Попытка
			Результат.Данные = эв_ПрочитатьОтветАтол(ТекстОтвета);
		Исключение
			Результат.Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ТелоДокументаАтол(ДокументОбъект, ИдентификаторЗаписи, ЭтоВозврат)
	
	Результат = Новый Структура("Тело, ТекстОшибки", Неопределено, "");
	Заказ = эв_ЗаказОснованиеЧека(ДокументОбъект);
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У чека не заполнен заказ-основание.'");
		Возврат Результат;
	КонецЕсли;
	
	ПочтаКомпании = эв_ПочтаКомпанииПоЗаказу(Заказ);
	Если Не СтрНайти(ПочтаКомпании, "@") > 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнена почта источника заказа, связанного с заказом-основанием чека.'");
		Возврат Результат;
	КонецЕсли;
	
	ИНН = эв_ТолькоЦифры(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Организация, "ИНН"));
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В организации чека не заполнен корректный ИНН.'");
		Возврат Результат;
	КонецЕсли;
	
	МестоРасчетов = эв_МестоРасчетовЧека(ДокументОбъект);
	Если ПустаяСтрока(МестоРасчетов) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить место расчетов чека.'");
		Возврат Результат;
	КонецЕсли;
	
	Позиции = эв_ПозицииДокументаАтол(ДокументОбъект, ЭтоВозврат);
	Если ЗначениеЗаполнено(Позиции.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Позиции.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Клиент = эв_КлиентЧекаАтол(ДокументОбъект, Заказ);
	Компания = Новый Структура;
	Компания.Вставить("email", Лев(ПочтаКомпании, 64));
	Компания.Вставить("sno", "osn");
	Компания.Вставить("inn", ИНН);
	Компания.Вставить("payment_address", МестоРасчетов);
	
	Чек = Новый Структура;
	Чек.Вставить("client", Клиент);
	Чек.Вставить("company", Компания);
	Чек.Вставить("items", Позиции.Позиции);
	Чек.Вставить("payments", эв_ОплатыДокументаАтол(ДокументОбъект, Позиции.Итог));
	Чек.Вставить("total", Позиции.Итог);
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Чек.Вставить("cashier", Лев(СокрЛП(Строка(ДокументОбъект.Ответственный)), 64));
	КонецЕсли;
	Если ДокументОбъект.РасчетВИнтернете Тогда
		Чек.Вставить("internet", Истина);
	КонецЕсли;
	ЧасоваяЗона = Цел(ДокументОбъект.ЧасоваяЗона);
	Если ЧасоваяЗона >= 1 И ЧасоваяЗона <= 11 Тогда
		Чек.Вставить("timezone", ЧасоваяЗона);
	КонецЕсли;
	
	ДатаДокумента = ДокументОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("timestamp", эв_МеткаВремениАтол(ДатаДокумента));
	Тело.Вставить("external_id", Лев(СокрЛП(ИдентификаторЗаписи), 128));
	Тело.Вставить("receipt", Чек);
	Результат.Тело = Тело;
	Возврат Результат;
	
КонецФункции

Функция эв_МеткаВремениАтол(ДатаДокумента)
	
	// ДФ=HH не дополняет час ведущим нулём, а шаблон АТОЛ требует две цифры: «09», а не «9».
	Возврат Формат(ДатаДокумента, "ДФ=dd.MM.yyyy") + " "
		+ Формат(Час(ДатаДокумента), "ЧЦ=2; ЧН=00; ЧВН=") + ":"
		+ Формат(Минута(ДатаДокумента), "ЧЦ=2; ЧН=00; ЧВН=") + ":"
		+ Формат(Секунда(ДатаДокумента), "ЧЦ=2; ЧН=00; ЧВН=");
	
	КонецФункции
	
Функция эв_ЭтоЧекКоррекции(ДокументСсылка)
	
	Возврат ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЧекККМКоррекции");
	
КонецФункции

Функция эв_ЭтоВозвратАванса(ДокументОбъект)
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам") Тогда
		ДокументОбъект = ДокументОбъект.ПолучитьОбъект();
	КонецЕсли;
	Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.ОперацияПоПлатежнымКартам") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОперацийЭквайринга.ВозвратОплатыПокупателю Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ТипЗнч(ДокументОбъект.ОперацияПоПлатежнымКартамШапка) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам")
		И ЗначениеЗаполнено(ДокументОбъект.ОперацияПоПлатежнымКартамШапка);
	
КонецФункции

Функция эв_ТекстЗапретаВозвратаПослеОтгрузки(ДокументОбъект) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам") Тогда
		ДокументОбъект = ДокументОбъект.ПолучитьОбъект();
	КонецЕсли;
	Если Не эв_ЭтоВозвратАванса(ДокументОбъект) Тогда
		Возврат "";
	КонецЕсли;
	
	ДокументыОплаты = Новый Массив;
	ДокументыОплаты.Добавить(ДокументОбъект.ОперацияПоПлатежнымКартамШапка);
	Заказы = Новый Массив;
	Для Каждого СтрокаПлатежа Из ДокументОбъект.РасшифровкаПлатежа Цикл
		Если ТипЗнч(СтрокаПлатежа.Документ) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам")
			И ЗначениеЗаполнено(СтрокаПлатежа.Документ) Тогда
			ДокументыОплаты.Добавить(СтрокаПлатежа.Документ);
		КонецЕсли;
		Если ТипЗнч(СтрокаПлатежа.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя")
			И ЗначениеЗаполнено(СтрокаПлатежа.Заказ)
			И Заказы.Найти(СтрокаПлатежа.Заказ) = Неопределено Тогда
			Заказы.Добавить(СтрокаПлатежа.Заказ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЗаказОплаты Из эв_ЗаказыДокументовОплаты(ДокументыОплаты) Цикл
		Если Заказы.Найти(ЗаказОплаты) = Неопределено Тогда
			Заказы.Добавить(ЗаказОплаты);
		КонецЕсли;
	КонецЦикла;
	
	ЧекОтгрузки = эв_ПробитыйЧекОтгрузки(ДокументыОплаты, Заказы);
	Если Не ЗначениеЗаполнено(ЧекОтгрузки) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрШаблон(
		НСтр("ru = 'Возврат оплаты на карту запрещен: товар уже отгружен, пробит %1.'"),
		ЧекОтгрузки);
	
КонецФункции

Функция эв_ЗаказыДокументовОплаты(ДокументыОплаты)
	
	Заказы = Новый Массив;
	Если ДокументыОплаты.Количество() = 0 Тогда
		Возврат Заказы;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Расшифровка.Заказ КАК Заказ
	|ИЗ
	|	Документ.ОперацияПоПлатежнымКартам.РасшифровкаПлатежа КАК Расшифровка
	|ГДЕ
	|	Расшифровка.Ссылка В (&ДокументыОплаты)
	|	И Расшифровка.Заказ ССЫЛКА Документ.ЗаказПокупателя
	|	И Расшифровка.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ДокументыОплаты", ДокументыОплаты);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказы.Добавить(Выборка.Заказ);
	КонецЦикла;
	
	Возврат Заказы;
	
КонецФункции

Функция эв_ПробитыйЧекОтгрузки(ДокументыОплаты, Заказы)
	
	УсловияСвязи = Новый Массив;
	Запрос = Новый Запрос;
	Если ДокументыОплаты.Количество() > 0 Тогда
		УсловияСвязи.Добавить(
		"Чек.Ссылка В
		|		(ВЫБРАТЬ
		|			Предоплата.Ссылка
		|		ИЗ
		|			Документ.ЧекККМ.Предоплата КАК Предоплата
		|		ГДЕ
		|			Предоплата.Документ В (&ДокументыОплаты))");
		Запрос.УстановитьПараметр("ДокументыОплаты", ДокументыОплаты);
	КонецЕсли;
	Если Заказы.Количество() > 0 Тогда
		УсловияСвязи.Добавить("Чек.Заказ В (&Заказы)");
		УсловияСвязи.Добавить(
		"Чек.Ссылка В
		|		(ВЫБРАТЬ
		|			Запасы.Ссылка
		|		ИЗ
		|			Документ.ЧекККМ.Запасы КАК Запасы
		|		ГДЕ
		|			Запасы.Заказ В (&Заказы))");
		Запрос.УстановитьПараметр("Заказы", Заказы);
	КонецЕсли;
	Если УсловияСвязи.Количество() = 0 Тогда
		Возврат Документы.ЧекККМ.ПустаяСсылка();
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Чек.Ссылка КАК Чек
	|ИЗ
	|	Документ.ЧекККМ КАК Чек
	|ГДЕ
	|	НЕ Чек.ПометкаУдаления
	|	И (Чек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	|		ИЛИ Чек.НомерЧекаККМ > 0)
	|	И НЕ Чек.ОперацияСДенежнымиСредствами
	|	И Чек.Ссылка В
	|		(ВЫБРАТЬ
	|			Запасы.Ссылка
	|		ИЗ
	|			Документ.ЧекККМ.Запасы КАК Запасы
	|		ГДЕ
	|			Запасы.Количество > 0
	|			ИЛИ Запасы.Сумма > 0)
	|	И (" + СтрСоединить(УсловияСвязи, "
	|		ИЛИ ") + ")";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Чек;
	КонецЕсли;
	
	Возврат Документы.ЧекККМ.ПустаяСсылка();
	
КонецФункции

Функция эв_ВозвратАвансаУжеФискализирован(ДокументСсылка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФискальныеОперации.ФискальныйПризнак КАК ФискальныйПризнак
	|ИЗ
	|	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	|ГДЕ
	|	ФискальныеОперации.ДокументОснование = &ДокументОснование
	|	И ФискальныеОперации.ФискальныйПризнак <> """"";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция эв_ПараметрыВозвратаАвансаДляОчереди(ДокументОбъект)
	
	Результат = Новый Структура("Параметры, ТекстОшибки", Неопределено, "");
	Позиции = эв_ПозицииВозвратаАванса(ДокументОбъект);
	Если ЗначениеЗаполнено(Позиции.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Позиции.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииЧека();
	ПараметрыЧека.ДокументОснование = ДокументОбъект.Ссылка;
	Если ЗначениеЗаполнено(ДокументОбъект.ИдентификаторЧекаВОчереди) Тогда
		ПараметрыЧека.ИдентификаторФискальнойЗаписи = СокрЛП(ДокументОбъект.ИдентификаторЧекаВОчереди);
	Иначе
		ПараметрыЧека.ИдентификаторФискальнойЗаписи = XMLСтрока(ДокументОбъект.Ссылка);
	КонецЕсли;
	ПараметрыЧека.КассаККМ = ДокументОбъект.КассаККМ;
	ПараметрыЧека.Организация = ДокументОбъект.Организация;
	ПараметрыЧека.ТорговыйОбъект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДокументОбъект.КассаККМ, "СтруктурнаяЕдиница");
	ПараметрыЧека.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	ПараметрыЧека.СистемаНалогообложения = РозничныеПродажиСервер.ПолучитьТипСистемыНалогообложенияККТ(
		ДокументОбъект.Организация,
		ПараметрыЧека.ТорговыйОбъект,
		ДокументОбъект.Дата,
		ДокументОбъект.СпециальныйНалоговыйРежим);
	ПараметрыЧека.АвтономнаяККТ = Истина;
	ПараметрыЧека.Электронно = Истина;
	ПараметрыЧека.Интернет = ДокументОбъект.РасчетВИнтернете = Истина;
	ПараметрыЧека.МестоРасчетов = эв_МестоРасчетовВозвратаАванса(ДокументОбъект);
	ПараметрыЧека.АдресРасчетов = ПараметрыЧека.МестоРасчетов;
	ПараметрыЧека.ОтправительEmail = эв_ПочтаКомпанииВозвратаАванса(ДокументОбъект);
	
	Если ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		ПараметрыЧека.ОрганизацияИНН = эв_ТолькоЦифры(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Организация, "ИНН"));
		ПараметрыЧека.ОрганизацияНазвание = СокрЛП(Строка(ДокументОбъект.Организация));
	КонецЕсли;
	Если ТипЗнч(ДокументОбъект.Контрагент) = Тип("СправочникСсылка.Контрагенты")
		И ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		ПараметрыЧека.СубъектПерсональныхДанных = ДокументОбъект.Контрагент;
	КонецЕсли;
	
	Клиент = эв_КлиентВозвратаАванса(ДокументОбъект);
	Если Клиент.Свойство("email") И Клиент.email <> "none" Тогда
		ПараметрыЧека.ПокупательEmail = Клиент.email;
	КонецЕсли;
	Если Клиент.Свойство("phone") Тогда
		ПараметрыЧека.ПокупательНомер = Клиент.phone;
	КонецЕсли;
	Если Клиент.Свойство("name") Тогда
		ПараметрыЧека.Получатель = Клиент.name;
	КонецЕсли;
	Если Клиент.Свойство("inn") Тогда
		ПараметрыЧека.ПолучательИНН = Клиент.inn;
	КонецЕсли;
	Если ДокументОбъект.СпособОплаты = Перечисления.СпособыОплатыЭквайринг.ОплатаСБП Тогда
		ПараметрыЧека.ТипПлатежнойСистемы = Перечисления.ТипыПлатежнойСистемыККТ.СистемаБыстрыхПлатежей;
		ПараметрыЧека.ИдентификаторОплатыПлатежнойСистемы = СокрЛП(ДокументОбъект.СсылочныйНомер);
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого СтрокаПозиции Из Позиции.Позиции Цикл
		Позиция = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыФискальнойСтрокиЧека();
		Позиция.ФискальнаяСтрока = "Товар";
		Позиция.НомерСтрокиТовара = НомерСтроки;
		Позиция.Наименование = СтрокаПозиции.Наименование;
		Позиция.Количество = 1;
		Позиция.Цена = СтрокаПозиции.Сумма;
		Позиция.ЦенаСоСкидками = СтрокаПозиции.Сумма;
		Позиция.Сумма = СтрокаПозиции.Сумма;
		Позиция.СуммаСкидок = 0;
		Позиция.НомерСекции = 1;
		Позиция.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.Аванс;
		Позиция.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата;
		Если СтрокаПозиции.СтавкаЗаполнена И Не СтрокаПозиции.БезНДС Тогда
			Позиция.СтавкаНДС = СтрокаПозиции.СтавкаНДСККТ;
			Позиция.СуммаНДС = СтрокаПозиции.СуммаНДС;
		КонецЕсли;
		ПараметрыЧека.ПозицииЧека.Добавить(Позиция);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Оплата = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыСтрокиОплаты(Позиции.Итог);
	Оплата.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно;
	ПараметрыЧека.ТаблицаОплат.Добавить(Оплата);
	
	Результат.Параметры = ПараметрыЧека;
	Возврат Результат;
	
КонецФункции

Функция эв_ПозицииВозвратаАванса(ДокументОбъект)
	
	Результат = Новый Структура("Позиции, Итог, ТекстОшибки", Новый Массив, 0, "");
	Наименование = эв_НаименованиеВозвратаАванса(ДокументОбъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расшифровка.СуммаПлатежа КАК СуммаПлатежа,
	|	Расшифровка.СуммаНДС КАК СуммаНДС,
	|	Расшифровка.ПризнакАванса КАК ПризнакАванса,
	|	Расшифровка.ПризнакСпособаРасчета КАК ПризнакСпособаРасчета,
	|	Расшифровка.Документ КАК Документ,
	|	Расшифровка.Заказ КАК Заказ,
	|	Расшифровка.СчетНаОплату КАК СчетНаОплату,
	|	Расшифровка.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(СтавкиНДС.Ставка, 0) КАК СтавкаЧислом,
	|	ЕСТЬNULL(СтавкиНДС.НеОблагается, ЛОЖЬ) КАК БезНДС
	|ИЗ
	|	Документ.ОперацияПоПлатежнымКартам.РасшифровкаПлатежа КАК Расшифровка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС
	|		ПО Расшифровка.СтавкаНДС = СтавкиНДС.Ссылка
	|ГДЕ
	|	Расшифровка.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Расшифровка.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	Группы = Новый Соответствие;
	ПорядокГрупп = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не эв_СтрокаВозвратаАванса(Выборка) Или Выборка.СуммаПлатежа <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтавкаЗаполнена = ЗначениеЗаполнено(Выборка.СтавкаНДС);
		БезНДС = Выборка.БезНДС = Истина Или Не СтавкаЗаполнена;
		Если БезНДС Тогда
			Ключ = "none";
		Иначе
			Ключ = Формат(Цел(Выборка.СтавкаЧислом), "ЧГ=0");
		КонецЕсли;
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("Наименование", Наименование);
			Группа.Вставить("Сумма", 0);
			Группа.Вставить("СуммаНДС", 0);
			Группа.Вставить("СтавкаЧислом", Цел(Выборка.СтавкаЧислом));
			Группа.Вставить("БезНДС", БезНДС);
			Группа.Вставить("СтавкаЗаполнена", СтавкаЗаполнена И Не БезНДС);
			Группа.Вставить("СтавкаНДСККТ", 0);
			Группы.Вставить(Ключ, Группа);
			ПорядокГрупп.Добавить(Ключ);
		КонецЕсли;
		Группа.Сумма = Группа.Сумма + Выборка.СуммаПлатежа;
		Группа.СуммаНДС = Группа.СуммаНДС + Выборка.СуммаНДС;
	КонецЦикла;
	
	Итог = 0;
	Для Каждого Ключ Из ПорядокГрупп Цикл
		Группа = Группы.Получить(Ключ);
		Группа.Сумма = Окр(Группа.Сумма, 2);
		Группа.СуммаНДС = Макс(Окр(Группа.СуммаНДС, 2), 0);
		Если Группа.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Группа.СтавкаЗаполнена Тогда
			Ставка = Группа.СтавкаЧислом;
			Если Ставка = 5 Или Ставка = 7 Или Ставка = 10 Или Ставка = 20 Или Ставка = 22 Тогда
				Группа.СтавкаНДСККТ = 100 + Ставка;
			Иначе
				Группа.СтавкаНДСККТ = Ставка;
			КонецЕсли;
		КонецЕсли;
		Результат.Позиции.Добавить(Группа);
		Итог = Итог + Группа.Сумма;
	КонецЦикла;
	
	Если Результат.Позиции.Количество() = 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В возврате оплаты на карту нет сумм аванса для фискализации.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Итог = Окр(Итог, 2);
	Возврат Результат;
	
КонецФункции

Функция эв_СтрокаВозвратаАванса(СтрокаПлатежа)
	
	Если СтрокаПлатежа.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.Аванс
		Или СтрокаПлатежа.ПризнакАванса = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПлатежа.Заказ) Или ЗначениеЗаполнено(СтрокаПлатежа.СчетНаОплату) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаПлатежа.Документ) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(СтрокаПлатежа.Документ);
	Возврат ТипДокумента = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам")
		Или ТипДокумента = Тип("ДокументСсылка.ПоступлениеВКассу")
		Или ТипДокумента = Тип("ДокументСсылка.РасходИзКассы")
		Или ТипДокумента = Тип("ДокументСсылка.ПоступлениеНаСчет")
		Или ТипДокумента = Тип("ДокументСсылка.РасходСоСчета");
	
КонецФункции

Функция эв_НаименованиеВозвратаАванса(ДокументОбъект)
	
	Наименование = НСтр("ru = 'Возврат аванса'");
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		ИмяКонтрагента = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ДокументОбъект.Контрагент, "НаименованиеПолное"));
		Если ЗначениеЗаполнено(ИмяКонтрагента) Тогда
			Наименование = Наименование + ": " + ИмяКонтрагента;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Лев(Наименование, 128);
	
КонецФункции

Функция эв_ТелоВозвратаАвансаАтол(ДокументОбъект, ИдентификаторЗаписи)
	
	Результат = Новый Структура("Тело, ТекстОшибки", Неопределено, "");
	ПочтаКомпании = эв_ПочтаКомпанииВозвратаАванса(ДокументОбъект);
	Если Не СтрНайти(ПочтаКомпании, "@") > 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнена почта отправителя чека: ни у источника заказа, ни у организации.'");
		Возврат Результат;
	КонецЕсли;
	
	ИНН = эв_ТолькоЦифры(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Организация, "ИНН"));
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В организации возврата аванса не заполнен корректный ИНН.'");
		Возврат Результат;
	КонецЕсли;
	
	СистемаНалогообложения = эв_СистемаНалогообложенияАтол(
		РозничныеПродажиСервер.ПолучитьТипСистемыНалогообложенияККТ(
			ДокументОбъект.Организация,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.КассаККМ, "СтруктурнаяЕдиница"),
			ДокументОбъект.Дата,
			ДокументОбъект.СпециальныйНалоговыйРежим));
	Если ПустаяСтрока(СистемаНалогообложения) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить систему налогообложения возврата аванса.'");
		Возврат Результат;
	КонецЕсли;
	
	МестоРасчетов = эв_МестоРасчетовВозвратаАванса(ДокументОбъект);
	Если ПустаяСтрока(МестоРасчетов) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить место расчетов возврата аванса.'");
		Возврат Результат;
	КонецЕсли;
	
	Позиции = эв_ПозицииВозвратаАванса(ДокументОбъект);
	Если ЗначениеЗаполнено(Позиции.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Позиции.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	ПозицииАтол = Новый Массив;
	Для Каждого СтрокаПозиции Из Позиции.Позиции Цикл
		ТипНДС = эв_ТипНДСАтол(
			СтрокаПозиции.СтавкаЧислом,
			СтрокаПозиции.БезНДС,
			СтрокаПозиции.СтавкаЗаполнена,
			Истина);
		Позиция = Новый Структура;
		Позиция.Вставить("name", СтрокаПозиции.Наименование);
		Позиция.Вставить("price", СтрокаПозиции.Сумма);
		Позиция.Вставить("quantity", 1);
		Позиция.Вставить("measure", 0);
		Позиция.Вставить("sum", СтрокаПозиции.Сумма);
		Позиция.Вставить("payment_method", "advance");
		Позиция.Вставить("payment_object", 10);
		Налог = Новый Структура;
		Налог.Вставить("type", ТипНДС);
		Если ТипНДС <> "none" Тогда
			Налог.Вставить("sum", СтрокаПозиции.СуммаНДС);
		КонецЕсли;
		Позиция.Вставить("vat", Налог);
		ПозицииАтол.Добавить(Позиция);
	КонецЦикла;
	
	Компания = Новый Структура;
	Компания.Вставить("email", ПочтаКомпании);
	Компания.Вставить("sno", СистемаНалогообложения);
	Компания.Вставить("inn", ИНН);
	Компания.Вставить("payment_address", МестоРасчетов);
	
	Оплаты = Новый Массив;
	эв_ДобавитьОплатуАтол(Оплаты, 1, Позиции.Итог);
	
	Чек = Новый Структура;
	Чек.Вставить("client", эв_КлиентВозвратаАванса(ДокументОбъект));
	Чек.Вставить("company", Компания);
	Чек.Вставить("items", ПозицииАтол);
	Чек.Вставить("payments", Оплаты);
	Чек.Вставить("total", Позиции.Итог);
	Кассир = эв_КассирВозвратаАванса(ДокументОбъект);
	Если ЗначениеЗаполнено(Кассир) Тогда
		Чек.Вставить("cashier", Кассир);
	КонецЕсли;
	Если ДокументОбъект.РасчетВИнтернете Тогда
		Чек.Вставить("internet", Истина);
	КонецЕсли;
	
	ДатаДокумента = ДокументОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("timestamp", эв_МеткаВремениАтол(ДатаДокумента));
	Тело.Вставить("external_id", Лев(СокрЛП(ИдентификаторЗаписи), 128));
	Тело.Вставить("receipt", Чек);
	Результат.Тело = Тело;
	Возврат Результат;
	
КонецФункции

Функция эв_КлиентВозвратаАванса(ДокументОбъект)
	
	Почта = СокрЛП(ДокументОбъект.АдресЭП);
	Если Не СтрНайти(Почта, "@") > 0 Тогда
		Почта = "";
	КонецЕсли;
	Почта = Лев(Почта, 64);
	Телефон = эв_ТелефонАтол(ДокументОбъект.Телефон);
	
	Клиент = Новый Структура;
	Если ЗначениеЗаполнено(Почта) Тогда
		Клиент.Вставить("email", Почта);
	КонецЕсли;
	Если ЗначениеЗаполнено(Телефон) Тогда
		Клиент.Вставить("phone", Телефон);
	КонецЕсли;
	Если Клиент.Количество() = 0 Тогда
		Клиент.Вставить("email", "none");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Сведения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ДокументОбъект.Контрагент, "НаименованиеПолное, ИНН");
		ИНН = эв_ТолькоЦифры(Сведения.ИНН);
		Если СтрДлина(ИНН) = 10 Или СтрДлина(ИНН) = 12 Тогда
			Клиент.Вставить("name", Лев(СокрЛП(Сведения.НаименованиеПолное), 256));
			Клиент.Вставить("inn", ИНН);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Клиент;
	
КонецФункции

Функция эв_ПочтаКомпанииВозвратаАванса(ДокументОбъект)
	
	Почта = "";
	Для Каждого СтрокаПлатежа Из ДокументОбъект.РасшифровкаПлатежа Цикл
		Если ТипЗнч(СтрокаПлатежа.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя")
			И ЗначениеЗаполнено(СтрокаПлатежа.Заказ) Тогда
			Почта = эв_ПочтаКомпанииПоЗаказу(СтрокаПлатежа.Заказ);
			Если СтрНайти(Почта, "@") > 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Не СтрНайти(Почта, "@") > 0
		И ТипЗнч(ДокументОбъект.ОперацияПоПлатежнымКартамШапка) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам")
		И ЗначениеЗаполнено(ДокументОбъект.ОперацияПоПлатежнымКартамШапка) Тогда
		ОснованиеОбъект = ДокументОбъект.ОперацияПоПлатежнымКартамШапка.ПолучитьОбъект();
		Если ОснованиеОбъект <> Неопределено Тогда
			Для Каждого СтрокаПлатежа Из ОснованиеОбъект.РасшифровкаПлатежа Цикл
				Если ТипЗнч(СтрокаПлатежа.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя")
					И ЗначениеЗаполнено(СтрокаПлатежа.Заказ) Тогда
					Почта = эв_ПочтаКомпанииПоЗаказу(СтрокаПлатежа.Заказ);
					Если СтрНайти(Почта, "@") > 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если Не СтрНайти(Почта, "@") > 0 И ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		Почта = СокрЛП(ПечатьДокументовУНФ.КонтактнаяИнформация(
			ДокументОбъект.Организация,
			Справочники.ВидыКонтактнойИнформации.EmailОрганизации));
	КонецЕсли;
	Если СтрНайти(Почта, "@") > 0 Тогда
		Возврат Лев(СокрЛП(Почта), 64);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция эв_МестоРасчетовВозвратаАванса(ДокументОбъект)
	
	Если ЗначениеЗаполнено(ДокументОбъект.АдресСайта) Тогда
		Возврат Лев(СокрЛП(ДокументОбъект.АдресСайта), 256);
	КонецЕсли;
	
	Адрес = "";
	СтруктурнаяЕдиница = Неопределено;
	Если ЗначениеЗаполнено(ДокументОбъект.КассаККМ) Тогда
		СтруктурнаяЕдиница = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ДокументОбъект.КассаККМ, "СтруктурнаяЕдиница");
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда
		Адрес = ПечатьДокументовУНФ.КонтактнаяИнформация(
			СтруктурнаяЕдиница,
			ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресСтруктурнойЕдиницы"));
		Если ПустаяСтрока(СокрЛП(Адрес)) Тогда
			Адрес = Строка(СтруктурнаяЕдиница);
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Адрес)) И ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		Адрес = Строка(ДокументОбъект.Организация);
	КонецЕсли;
	
	Возврат Лев(СокрЛП(Адрес), 256);
	
КонецФункции

Функция эв_КассирВозвратаАванса(ДокументОбъект)
	
	Кассир = "";
	Если ЗначениеЗаполнено(ДокументОбъект.ПодписьКассира) Тогда
		Кассир = СокрЛП(Строка(ДокументОбъект.ПодписьКассира));
	ИначеЕсли ЗначениеЗаполнено(ДокументОбъект.Автор) Тогда
		Кассир = СокрЛП(Строка(ДокументОбъект.Автор));
	КонецЕсли;
	
	Возврат Лев(Кассир, 64);
	
КонецФункции

Процедура эв_ОтметитьВозвратАвансаПробитым(ДокументСсылка, Результат)
	
	Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ОперацияПоПлатежнымКартам")
		Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Или Не эв_ЭтоВозвратАванса(ДокументОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.Статус = Перечисления.СтатусыЧековККМ.Пробит;
	НомерЧека = эв_ЧислоТСПИоТ(Результат.НомерЧека);
	НомерСмены = эв_ЧислоТСПИоТ(Результат.НомерСмены);
	Если НомерЧека > 0 И НомерЧека <= 99999999 Тогда
		ДокументОбъект.НомерЧекаККМ = НомерЧека;
	КонецЕсли;
	Если НомерСмены > 0 И НомерСмены <= 9999 Тогда
		ДокументОбъект.НомерСменыККМ = НомерСмены;
	КонецЕсли;
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();
	
КонецПроцедуры

Функция эв_ПараметрыЧекаКоррекцииДляОчереди(ДокументОбъект)
	
	ПараметрыЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииЧекаКоррекции();
	ПараметрыЧека.ДокументОснование = ДокументОбъект.Ссылка;
	ПараметрыЧека.ИдентификаторФискальнойЗаписи = XMLСтрока(ДокументОбъект.Ссылка);
	ПараметрыЧека.КассаККМ = ДокументОбъект.КассаККМ;
	ПараметрыЧека.Организация = ДокументОбъект.Организация;
	ПараметрыЧека.ТорговыйОбъект = ДокументОбъект.СтруктурнаяЕдиница;
	ПараметрыЧека.ТипРасчета = ДокументОбъект.ТипРасчета;
	ПараметрыЧека.СистемаНалогообложения = ДокументОбъект.СистемаНалогообложения;
	ПараметрыЧека.КорректируемыйДокумент = ДокументОбъект.ДокументОснование;
	ПараметрыЧека.ДополнительныйРеквизит = ДокументОбъект.ДополнительныйРеквизит;
	ПараметрыЧека.АвтономнаяККТ = Истина;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		ПараметрыЧека.ОрганизацияИНН = эв_ТолькоЦифры(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Организация, "ИНН"));
	КонецЕсли;
	Если ТипЗнч(ДокументОбъект.Покупатель) = Тип("СправочникСсылка.Контрагенты")
		Или ТипЗнч(ДокументОбъект.Покупатель) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ПараметрыЧека.СубъектПерсональныхДанных = ДокументОбъект.Покупатель;
	КонецЕсли;
	
	Для Каждого СтрокаПозиции Из ДокументОбъект.ПозицииЧека Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("ФискальнаяСтрока", "Товар");
		Позиция.Вставить("Наименование", эв_НаименованиеПредметаКоррекции(СтрокаПозиции.НаименованиеПредметаРасчета));
		Позиция.Вставить("Сумма", Окр(СтрокаПозиции.СуммаСоСкидками, 2));
		ПараметрыЧека.ПозицииЧека.Добавить(Позиция);
	КонецЦикла;
	
	Для Каждого СтрокаОплаты Из ДокументОбъект.Оплата Цикл
		Оплата = Новый Структура;
		Оплата.Вставить("ТипОплаты", СтрокаОплаты.ТипОплаты);
		Оплата.Вставить("Сумма", Окр(СтрокаОплаты.Сумма, 2));
		ПараметрыЧека.ТаблицаОплат.Добавить(Оплата);
	КонецЦикла;
	
	Возврат ПараметрыЧека;
	
КонецФункции

Процедура эв_УстановитьТипДокументаОчереди(ДокументСсылка, ИдентификаторЗаписи, ТипДокумента)
	
	УстановитьПривилегированныйРежим(Истина);
	НаборЗаписей = РегистрыСведений.ОчередьЧековККТ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументСсылка);
	НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
	НаборЗаписей.Прочитать();
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ТипДокумента = ТипДокумента;
	КонецЦикла;
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция эв_ОперацияКоррекцииАтол(ТипРасчета)
	
	ТипыРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами;
	Если ТипРасчета = ТипыРасчета.РасходДенежныхСредств Тогда
		Возврат "buy_correction";
	ИначеЕсли ТипРасчета = ТипыРасчета.ВозвратРасходаДенежныхСредств Тогда
		Возврат "buy_refund_correction";
	ИначеЕсли ТипРасчета = ТипыРасчета.ВозвратДенежныхСредств Тогда
		Возврат "sell_refund_correction";
	КонецЕсли;
	
	Возврат "sell_correction";
	
КонецФункции

Функция эв_ТелоКоррекцииАтол(ДокументОбъект, ИдентификаторЗаписи)
	
	Результат = Новый Структура("Тело, ТекстОшибки", Неопределено, "");
	ПочтаКомпании = эв_ПочтаКомпанииЧекаКоррекции(ДокументОбъект);
	Если Не СтрНайти(ПочтаКомпании, "@") > 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнена почта отправителя чека: ни у источника заказа-основания, ни у организации.'");
		Возврат Результат;
	КонецЕсли;
	
	ИНН = эв_ТолькоЦифры(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Организация, "ИНН"));
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В организации чека коррекции не заполнен корректный ИНН.'");
		Возврат Результат;
	КонецЕсли;
	
	СистемаНалогообложения = эв_СистемаНалогообложенияАтол(ДокументОбъект.СистемаНалогообложения);
	Если ПустаяСтрока(СистемаНалогообложения) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В чеке коррекции не заполнена система налогообложения.'");
		Возврат Результат;
	КонецЕсли;
	
	МестоРасчетов = эв_МестоРасчетовКоррекции(ДокументОбъект);
	Если ПустаяСтрока(МестоРасчетов) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить место расчетов чека коррекции.'");
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ДатаКоррекции) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнена дата корректируемого расчета.'");
		Возврат Результат;
	КонецЕсли;
	
	НомерОснования = Лев(СокрЛП(Строка(ДокументОбъект.НомерПредписания)), 32);
	КоррекцияПоПредписанию = ДокументОбъект.ТипКоррекции = 1;
	Если КоррекцияПоПредписанию И ПустаяСтрока(НомерОснования) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Для коррекции по предписанию не заполнен номер предписания.'");
		Возврат Результат;
	КонецЕсли;
	
	Операция = эв_ОперацияКоррекцииАтол(ДокументОбъект.ТипРасчета);
	ЭтоВозврат = Операция = "sell_refund_correction" Или Операция = "buy_refund_correction";
	Позиции = эв_ПозицииКоррекцииАтол(ДокументОбъект, ЭтоВозврат);
	Если ЗначениеЗаполнено(Позиции.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Позиции.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	СведенияОКоррекции = Новый Структура;
	СведенияОКоррекции.Вставить("type", ?(КоррекцияПоПредписанию, "instruction", "self"));
	СведенияОКоррекции.Вставить("base_date", Формат(ДокументОбъект.ДатаКоррекции, "ДФ=dd.MM.yyyy"));
	Если ЗначениеЗаполнено(НомерОснования) Тогда
		СведенияОКоррекции.Вставить("base_number", НомерОснования);
	КонецЕсли;
	
	Компания = Новый Структура;
	Компания.Вставить("email", ПочтаКомпании);
	Компания.Вставить("sno", СистемаНалогообложения);
	Компания.Вставить("inn", ИНН);
	Компания.Вставить("payment_address", МестоРасчетов);
	
	Чек = Новый Структура;
	Чек.Вставить("client", эв_КлиентКоррекцииАтол(ДокументОбъект));
	Чек.Вставить("company", Компания);
	Чек.Вставить("correction_info", СведенияОКоррекции);
	Чек.Вставить("items", Позиции.Позиции);
	Чек.Вставить("payments", эв_ОплатыКоррекцииАтол(ДокументОбъект, Позиции.Итог));
	Чек.Вставить("total", Позиции.Итог);
	Если ЗначениеЗаполнено(ДокументОбъект.Кассир) Тогда
		Чек.Вставить("cashier", Лев(СокрЛП(Строка(ДокументОбъект.Кассир)), 64));
	КонецЕсли;
	ИННКассира = эв_ТолькоЦифры(ДокументОбъект.КассирИНН);
	Если СтрДлина(ИННКассира) = 12 Тогда
		Чек.Вставить("cashier_inn", ИННКассира);
	КонецЕсли;
	ДополнительныйРеквизит = Лев(СокрЛП(ДокументОбъект.ДополнительныйРеквизит), 16);
	Если ЗначениеЗаполнено(ДополнительныйРеквизит) Тогда
		Чек.Вставить("additional_check_props", ДополнительныйРеквизит);
	КонецЕсли;
	Если ДокументОбъект.РасчетВИнтернете Тогда
		Чек.Вставить("internet", Истина);
	КонецЕсли;
	ЧасоваяЗона = Цел(ДокументОбъект.ЧасоваяЗона);
	Если ЧасоваяЗона >= 1 И ЧасоваяЗона <= 11 Тогда
		Чек.Вставить("timezone", ЧасоваяЗона);
	КонецЕсли;
	
	ДатаДокумента = ДокументОбъект.Дата;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("timestamp", эв_МеткаВремениАтол(ДатаДокумента));
	Тело.Вставить("external_id", Лев(СокрЛП(ИдентификаторЗаписи), 128));
	Тело.Вставить("correction", Чек);
	Результат.Тело = Тело;
	Возврат Результат;
	
КонецФункции

Функция эв_ПозицииКоррекцииАтол(ДокументОбъект, ЭтоВозврат)
	
	Результат = Новый Структура("Позиции, Итог, ТекстОшибки", Новый Массив, 0, "");
	СтавкиНДС = эв_СтавкиНДСКоррекции(ДокументОбъект);
	
	Для Каждого СтрокаПозиции Из ДокументОбъект.ПозицииЧека Цикл
		Если СтрокаПозиции.Количество = 0 И СтрокаПозиции.СуммаСоСкидками = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Наименование = эв_НаименованиеПредметаКоррекции(СтрокаПозиции.НаименованиеПредметаРасчета);
		КодМаркировки = СокрЛП(СтрокаПозиции.КодКонтрольнойМарки);
		Если ПустаяСтрока(КодМаркировки) Тогда
			КодМаркировки = СокрЛП(СтрокаПозиции.КонтрольныйИдентификационныйЗнак);
		КонецЕсли;
		КодGS1M = эв_КодМаркировкиGS1M(КодМаркировки);
		ЕстьКод = ЗначениеЗаполнено(КодGS1M);
		КодПредмета = эв_КодПризнакаПредметаРасчетаАтол(СтрокаПозиции.ПризнакПредметаРасчета);
		Если Не ЕстьКод И (КодПредмета = 31 Или КодПредмета = 33) Тогда
			Результат.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Для товара ""%1"" не заполнен код маркировки.'"),
				Наименование);
			Возврат Результат;
		КонецЕсли;
		
		Сумма = Окр(СтрокаПозиции.СуммаСоСкидками, 2);
		Количество = СтрокаПозиции.Количество;
		Если Количество <= 0 Или ЕстьКод Тогда
			Количество = 1;
		КонецЕсли;
		Если Количество = 1 Тогда
			Цена = Сумма;
		Иначе
			Цена = Окр(Сумма / Количество, 2);
			Сумма = Окр(Цена * Количество, 2);
		КонецЕсли;
		
		СпособРасчета = эв_ПризнакСпособаРасчетаАтол(СтрокаПозиции.ПризнакСпособаРасчета);
		ЭтоАванс = СпособРасчета = "advance" Или СпособРасчета = "full_prepayment" Или СпособРасчета = "prepayment";
		СтавкаЧислом = 0;
		БезНДС = Ложь;
		СтавкаЗаполнена = ЗначениеЗаполнено(СтрокаПозиции.СтавкаНДС);
		Если СтавкаЗаполнена Тогда
			РеквизитыСтавки = СтавкиНДС.Получить(СтрокаПозиции.СтавкаНДС);
			Если РеквизитыСтавки <> Неопределено Тогда
				СтавкаЧислом = РеквизитыСтавки.Ставка;
				БезНДС = РеквизитыСтавки.НеОблагается = Истина;
			КонецЕсли;
		КонецЕсли;
		ТипНДС = эв_ТипНДСАтол(СтавкаЧислом, БезНДС, СтавкаЗаполнена, ЭтоАванс);
		
		Позиция = Новый Структура;
		Позиция.Вставить("name", Наименование);
		Позиция.Вставить("price", Цена);
		Позиция.Вставить("quantity", Количество);
		Позиция.Вставить("measure", эв_МераКоличестваАтол(СтрокаПозиции.МераКоличестваПредметаРасчета, ЕстьКод));
		Позиция.Вставить("sum", Сумма);
		Позиция.Вставить("payment_method", СпособРасчета);
		Позиция.Вставить("payment_object", эв_ПризнакПредметаРасчетаПозицииАтол(
			СтрокаПозиции.ПризнакПредметаРасчета, ЕстьКод, КодПредмета = 2 Или КодПредмета = 30 Или КодПредмета = 31));
		Налог = Новый Структура;
		Налог.Вставить("type", ТипНДС);
		Если ТипНДС <> "none" Тогда
			Налог.Вставить("sum", Макс(Окр(СтрокаПозиции.СуммаНДС, 2), 0));
		КонецЕсли;
		Позиция.Вставить("vat", Налог);
		Если СтрокаПозиции.СуммаАкциза > 0 Тогда
			Позиция.Вставить("excise", Окр(СтрокаПозиции.СуммаАкциза, 2));
		КонецЕсли;
		КодСтраны = эв_ТолькоЦифры(СтрокаПозиции.КодСтраныПроисхожденияТовара);
		Если СтрДлина(КодСтраны) = 3 Тогда
			Позиция.Вставить("country_code", КодСтраны);
		КонецЕсли;
		НомерДекларации = Лев(СокрЛП(СтрокаПозиции.НомерТаможеннойДекларации), 32);
		Если ЗначениеЗаполнено(НомерДекларации) Тогда
			Позиция.Вставить("declaration_number", НомерДекларации);
		КонецЕсли;
		Если ЕстьКод Тогда
			Позиция.Вставить("mark_processing_mode", "0");
			Позиция.Вставить("mark_code", Новый Структура("gs1m", КодGS1M));
			Позиция.Вставить("planned_status", ?(ЭтоВозврат, 3, 1));
		КонецЕсли;
		эв_ДобавитьАгентаПозицииКоррекции(Позиция, СтрокаПозиции);
		Результат.Позиции.Добавить(Позиция);
	КонецЦикла;
	
	Если Результат.Позиции.Количество() = 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В чеке коррекции нет позиций для фискализации.'");
		Возврат Результат;
	КонецЕсли;
	
	Итог = 0;
	Для Каждого Позиция Из Результат.Позиции Цикл
		Итог = Итог + Позиция.sum;
	КонецЦикла;
	Результат.Итог = Окр(Итог, 2);
	Возврат Результат;
	
КонецФункции

Функция эв_СтавкиНДСКоррекции(ДокументОбъект)
	
	Ставки = Новый Массив;
	Для Каждого СтрокаПозиции Из ДокументОбъект.ПозицииЧека Цикл
		Если ЗначениеЗаполнено(СтрокаПозиции.СтавкаНДС) И Ставки.Найти(СтрокаПозиции.СтавкаНДС) = Неопределено Тогда
			Ставки.Добавить(СтрокаПозиции.СтавкаНДС);
		КонецЕсли;
	КонецЦикла;
	Если Ставки.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Ставки, "Ставка, НеОблагается");
	
КонецФункции

Функция эв_НаименованиеПредметаКоррекции(ПредметРасчета)
	
	Если ТипЗнч(ПредметРасчета) = Тип("Строка") Тогда
		Наименование = СокрЛП(ПредметРасчета);
	ИначеЕсли ТипЗнч(ПредметРасчета) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(ПредметРасчета) Тогда
		Наименование = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредметРасчета, "НаименованиеПолное"));
		Если ПустаяСтрока(Наименование) Тогда
			Наименование = Строка(ПредметРасчета);
		КонецЕсли;
	Иначе
		Наименование = СокрЛП(Строка(ПредметРасчета));
	КонецЕсли;
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = НСтр("ru = 'Товар'");
	КонецЕсли;
	
	Возврат Лев(Наименование, 128);
	
КонецФункции

Процедура эв_ДобавитьАгентаПозицииКоррекции(Позиция, СтрокаПозиции)
	
	ТипАгента = эв_ТипАгентаАтол(СтрокаПозиции.ПризнакАгентаПоПредметуРасчета);
	ИНН = эв_ТолькоЦифры(СтрокаПозиции.ДанныеПоставщикаИНН);
	Если ПустаяСтрока(ТипАгента) Или (СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12) Тогда
		Возврат;
	КонецЕсли;
	
	Поставщик = Новый Структура;
	Наименование = Лев(СокрЛП(СтрокаПозиции.ДанныеПоставщикаНаименование), 256);
	Если ЗначениеЗаполнено(Наименование) Тогда
		Поставщик.Вставить("name", Наименование);
	КонецЕсли;
	Поставщик.Вставить("inn", ИНН);
	Телефон = эв_ТелефонАтол(СтрокаПозиции.ДанныеПоставщикаТелефон);
	Если ЗначениеЗаполнено(Телефон) Тогда
		Телефоны = Новый Массив;
		Телефоны.Добавить(Телефон);
		Поставщик.Вставить("phones", Телефоны);
	КонецЕсли;
	Позиция.Вставить("agent_info", Новый Структура("type", ТипАгента));
	Позиция.Вставить("supplier_info", Поставщик);
	
КонецПроцедуры

Функция эв_ТипАгентаАтол(ПризнакАгента)
	
	Признаки = Перечисления.ПризнакиАгента;
	Если ПризнакАгента = Признаки.БанковскийПлатежныйАгент Тогда
		Возврат "bank_paying_agent";
	ИначеЕсли ПризнакАгента = Признаки.БанковскийПлатежныйСубагент Тогда
		Возврат "bank_paying_subagent";
	ИначеЕсли ПризнакАгента = Признаки.ПлатежныйАгент Тогда
		Возврат "paying_agent";
	ИначеЕсли ПризнакАгента = Признаки.ПлатежныйСубагент Тогда
		Возврат "paying_subagent";
	ИначеЕсли ПризнакАгента = Признаки.Поверенный Тогда
		Возврат "attorney";
	ИначеЕсли ПризнакАгента = Признаки.Комиссионер Тогда
		Возврат "commission_agent";
	ИначеЕсли ПризнакАгента = Признаки.Агент Тогда
		Возврат "another";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция эв_ОплатыКоррекцииАтол(ДокументОбъект, ИтогЧека)
	
	Оплаты = Новый Массив;
	Для Каждого СтрокаОплаты Из ДокументОбъект.Оплата Цикл
		эв_ДобавитьОплатуАтол(Оплаты, эв_ТипОплатыКоррекцииАтол(СтрокаОплаты.ТипОплаты), СтрокаОплаты.Сумма);
	КонецЦикла;
	Если Оплаты.Количество() = 0 Тогда
		Оплата = Новый Структура;
		Оплата.Вставить("type", 1);
		Оплата.Вставить("sum", Окр(ИтогЧека, 2));
		Оплаты.Добавить(Оплата);
	КонецЕсли;
	
	Возврат Оплаты;
	
КонецФункции

Функция эв_ТипОплатыКоррекцииАтол(ТипОплаты)
	
	ТипыОплаты = Перечисления.ТипыОплатыККТ;
	Если ТипОплаты = ТипыОплаты.Наличные Тогда
		Возврат 0;
	ИначеЕсли ТипОплаты = ТипыОплаты.Предоплата Тогда
		Возврат 2;
	ИначеЕсли ТипОплаты = ТипыОплаты.Постоплата Тогда
		Возврат 3;
	ИначеЕсли ТипОплаты = ТипыОплаты.ВстречноеПредоставление Тогда
		Возврат 4;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

Функция эв_КлиентКоррекцииАтол(ДокументОбъект)
	
	Почта = СокрЛП(ДокументОбъект.ПокупательEmail);
	Если Не СтрНайти(Почта, "@") > 0 Тогда
		Почта = "";
	КонецЕсли;
	Почта = Лев(Почта, 64);
	Телефон = эв_ТелефонАтол(ДокументОбъект.ПокупательНомер);
	
	Клиент = Новый Структура;
	Если ЗначениеЗаполнено(Почта) Тогда
		Клиент.Вставить("email", Почта);
	КонецЕсли;
	Если ЗначениеЗаполнено(Телефон) Тогда
		Клиент.Вставить("phone", Телефон);
	КонецЕсли;
	Если Клиент.Количество() = 0 Тогда
		Клиент.Вставить("email", "none");
	КонецЕсли;
	
	Наименование = "";
	Если ТипЗнч(ДокументОбъект.Покупатель) = Тип("Строка") Тогда
		Наименование = СокрЛП(ДокументОбъект.Покупатель);
	ИначеЕсли ТипЗнч(ДокументОбъект.Покупатель) = Тип("СправочникСсылка.Контрагенты")
		И ЗначениеЗаполнено(ДокументОбъект.Покупатель) Тогда
		Наименование = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Покупатель, "НаименованиеПолное"));
	ИначеЕсли ЗначениеЗаполнено(ДокументОбъект.Покупатель) Тогда
		Наименование = СокрЛП(Строка(ДокументОбъект.Покупатель));
	КонецЕсли;
	Если ЗначениеЗаполнено(Наименование) Тогда
		Клиент.Вставить("name", Лев(Наименование, 256));
	КонецЕсли;
	ИНН = эв_ТолькоЦифры(ДокументОбъект.ПокупательИНН);
	Если СтрДлина(ИНН) = 10 Или СтрДлина(ИНН) = 12 Тогда
		Клиент.Вставить("inn", ИНН);
	КонецЕсли;
	
	Возврат Клиент;
	
КонецФункции

Функция эв_ПочтаКомпанииЧекаКоррекции(ДокументОбъект)
	
	Почта = "";
	Основание = ДокументОбъект.ДокументОснование;
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЧекККМ")
		Или ТипЗнч(Основание) = Тип("ДокументСсылка.ЧекККМВозврат") Тогда
		Почта = эв_ПочтаКомпанииПоЗаказу(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Заказ"));
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Почта = эв_ПочтаКомпанииПоЗаказу(Основание);
	КонецЕсли;
	Если Не СтрНайти(Почта, "@") > 0 И ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		Почта = СокрЛП(ПечатьДокументовУНФ.КонтактнаяИнформация(
			ДокументОбъект.Организация,
			Справочники.ВидыКонтактнойИнформации.EmailОрганизации));
	КонецЕсли;
	Если СтрНайти(Почта, "@") > 0 Тогда
		Возврат Лев(СокрЛП(Почта), 64);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция эв_СистемаНалогообложенияАтол(СистемаНалогообложения)
	
	Системы = Перечисления.ТипыСистемНалогообложенияККТ;
	Если СистемаНалогообложения = Системы.ОСН Тогда
		Возврат "osn";
	ИначеЕсли СистемаНалогообложения = Системы.УСНДоход Тогда
		Возврат "usn_income";
	ИначеЕсли СистемаНалогообложения = Системы.УСНДоходРасход Тогда
		Возврат "usn_income_outcome";
	ИначеЕсли СистемаНалогообложения = Системы.ЕНВД Тогда
		Возврат "envd";
	ИначеЕсли СистемаНалогообложения = Системы.ЕСН Тогда
		Возврат "esn";
	ИначеЕсли СистемаНалогообложения = Системы.Патент Тогда
		Возврат "patent";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция эв_МестоРасчетовКоррекции(ДокументОбъект)
	
	Если ЗначениеЗаполнено(ДокументОбъект.МестоРасчетов) Тогда
		Возврат Лев(СокрЛП(ДокументОбъект.МестоРасчетов), 256);
	КонецЕсли;
	
	Возврат эв_МестоРасчетовЧека(ДокументОбъект);
	
КонецФункции

Функция эв_ОплатыЧекаКоррекции(ДокументСсылка)
	
	Результат = Новый Структура(
		"Сумма, Наличные, Электронно, Предоплата, Постоплата, ВстречноеПредоставление", 0, 0, 0, 0, 0, 0);
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыОплаты = Перечисления.ТипыОплатыККТ;
	Для Каждого СтрокаОплаты Из ДокументОбъект.Оплата Цикл
		Сумма = Окр(СтрокаОплаты.Сумма, 2);
		Если Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаОплаты.ТипОплаты = ТипыОплаты.Наличные Тогда
			Результат.Наличные = Результат.Наличные + Сумма;
		ИначеЕсли СтрокаОплаты.ТипОплаты = ТипыОплаты.Предоплата Тогда
			Результат.Предоплата = Результат.Предоплата + Сумма;
		ИначеЕсли СтрокаОплаты.ТипОплаты = ТипыОплаты.Постоплата Тогда
			Результат.Постоплата = Результат.Постоплата + Сумма;
		ИначеЕсли СтрокаОплаты.ТипОплаты = ТипыОплаты.ВстречноеПредоставление Тогда
			Результат.ВстречноеПредоставление = Результат.ВстречноеПредоставление + Сумма;
		Иначе
			Результат.Электронно = Результат.Электронно + Сумма;
		КонецЕсли;
	КонецЦикла;
	Результат.Сумма = Результат.Наличные + Результат.Электронно + Результат.Предоплата
		+ Результат.Постоплата + Результат.ВстречноеПредоставление;
	Возврат Результат;
	
КонецФункции

Процедура эв_ОтметитьЧекКоррекцииПробитым(ДокументСсылка, Результат)
	
	Если Не эв_ЭтоЧекКоррекции(ДокументСсылка) Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Или ДокументОбъект.ПробитЧек Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.ПробитЧек = Истина;
	НомерЧека = эв_ЧислоТСПИоТ(Результат.НомерЧека);
	НомерСмены = эв_ЧислоТСПИоТ(Результат.НомерСмены);
	Если НомерЧека > 0 Тогда
		ДокументОбъект.НомерЧека = НомерЧека;
	КонецЕсли;
	Если НомерСмены > 0 Тогда
		ДокументОбъект.НомерСмены = НомерСмены;
	КонецЕсли;
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();
	
КонецПроцедуры

Функция эв_ПозицииДокументаАтол(ДокументОбъект, ЭтоВозврат)
	
	Результат = Новый Структура("Позиции, Итог, ТекстОшибки", Новый Массив, 0, "");
	ПризнакСпособаРасчета = Документы.ЧекККМ.ПризнакСпособаРасчета(ДокументОбъект);
	СпособРасчета = эв_ПризнакСпособаРасчетаАтол(ПризнакСпособаРасчета);
	ЭтоАванс = СпособРасчета = "advance" Или СпособРасчета = "full_prepayment" Или СпособРасчета = "prepayment";
	КодыМаркировки = эв_КодыМаркировкиДокумента(ДокументОбъект);
	ЭтоЧекВозврата = ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМВозврат");
	ИсточникЗапасов = "Документ.ЧекККМ.Запасы";
	ПолеИдентификатораСтроки = "Запасы.ор_ИдентификаторСтроки";
	Если ЭтоЧекВозврата Тогда
		ИсточникЗапасов = "Документ.ЧекККМВозврат.Запасы";
		ПолеИдентификатораСтроки = "0";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запасы.НомерСтроки КАК НомерСтроки,
	|	Запасы.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Запасы.Номенклатура.НаименованиеПолное, """") КАК НаименованиеПолное,
	|	ЕСТЬNULL(Запасы.Номенклатура.КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров, """") КАК СерийныйТовар,
	|	Запасы.Номенклатура.ПризнакПредметаРасчета КАК ПризнакПредметаРасчета,
	|	ЕСТЬNULL(Запасы.Номенклатура.ПодакцизныйТовар, ЛОЖЬ) КАК ПодакцизныйТовар,
	|	Запасы.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА (ВЫРАЗИТЬ(Запасы.Характеристика.НаименованиеДляПечати КАК СТРОКА(1))) = """"
	|				ТОГДА Запасы.Характеристика.Наименование
	|			ИНАЧЕ ВЫРАЗИТЬ(Запасы.Характеристика.НаименованиеДляПечати КАК СТРОКА(128))
	|		КОНЕЦ, """") КАК Характеристика,
	|	Запасы.Количество КАК Количество,
	|	Запасы.Сумма КАК Сумма,
	|	Запасы.СуммаНДС КАК СуммаНДС,
	|	Запасы.Всего КАК Всего,
	|	Запасы.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(Запасы.СтавкаНДС.Ставка, 0) КАК СтавкаЧислом,
	|	ЕСТЬNULL(Запасы.СтавкаНДС.НеОблагается, ЛОЖЬ) КАК БезНДС,
	|	Запасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Запасы.КодМаркировки КАК КодМаркировки,
	|	ПолеИдентификатораСтроки КАК ИдентификаторСтроки,
	|	Запасы.НеобходимостьВводаКодаМаркировки КАК НеобходимостьВводаКодаМаркировки,
	|	Запасы.Партия.Статус КАК СтатусПартии,
	|	Запасы.Партия.ВладелецПартии КАК ВладелецПартии
	|ИЗ
	|	ИсточникЗапасов КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПолеИдентификатораСтроки", ПолеИдентификатораСтроки);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИсточникЗапасов", ИсточникЗапасов);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество = 0 И Выборка.Всего = 0 И Выборка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		СерийныйТовар = Выборка.СерийныйТовар;
		Наименование = эв_НаименованиеПозицииАтол(Выборка);
		КодыСтроки = КодыМаркировки.Получить(Выборка.НомерСтроки);
		Если КодыСтроки = Неопределено Тогда
			КодыСтроки = Новый Массив;
		КонецЕсли;
		ПризнакПредметаРасчета = Выборка.ПризнакПредметаРасчета;
		Если Не ЗначениеЗаполнено(ПризнакПредметаРасчета) Тогда
			ПризнакПредметаРасчета = РозничныеПродажиСервер.ПолучитьПризнакПредметаРасчета(Выборка.Номенклатура);
		КонецЕсли;
		ТребуетсяКод = Выборка.НеобходимостьВводаКодаМаркировки
			Или ЗначениеЗаполнено(Выборка.КодМаркировки)
			Или ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ
			Или ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПодакцизныйТоварМаркируемыйСИИмеющийКМ;
		Если ТребуетсяКод И КодыСтроки.Количество() = 0 Тогда
			Если СерийныйТовар Тогда
				Результат.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Для товара ""%1"" не найден полный код маркировки в номерах упаковок чека.'"),
					Наименование);
			Иначе
				Результат.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Для товара ""%1"" не найден полный код маркировки в пуле кодов маркировки СУЗ.'"),
					Наименование);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		
		эв_ДобавитьПозицииСтрокиАтол(Результат.Позиции, Выборка, КодыСтроки, Наименование,
			ДокументОбъект.СуммаВключаетНДС, СпособРасчета, ЭтоАванс, ЭтоВозврат, ПризнакПредметаРасчета);
	КонецЦикла;
	
	Если Результат.Позиции.Количество() = 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В чеке нет товаров для фискализации.'");
		Возврат Результат;
	КонецЕсли;
	
	Итог = 0;
	Для Каждого Позиция Из Результат.Позиции Цикл
		Итог = Итог + Позиция.sum;
	КонецЦикла;
	Результат.Итог = Окр(Итог, 2);
	Возврат Результат;
	
КонецФункции

Процедура эв_ДобавитьПозицииСтрокиАтол(Позиции, СтрокаЧека, КодыСтроки, Наименование, СуммаВключаетНДС,
	СпособРасчета, ЭтоАванс, ЭтоВозврат, ПризнакПредметаРасчета)
	
	КоличествоЧастей = Макс(КодыСтроки.Количество(), 1);
	СуммаСтроки = Окр(?(СтрокаЧека.Всего <> 0, СтрокаЧека.Всего, СтрокаЧека.Сумма), 2);
	Если Не СуммаВключаетНДС И СтрокаЧека.Всего = 0 Тогда
		СуммаСтроки = Окр(СтрокаЧека.Сумма + СтрокаЧека.СуммаНДС, 2);
	КонецЕсли;
	КоличествоСтроки = СтрокаЧека.Количество;
	Если КоличествоСтроки <= 0 Тогда
		КоличествоСтроки = КоличествоЧастей;
	КонецЕсли;
	СуммаНДССтроки = Окр(СтрокаЧека.СуммаНДС, 2);
	ОстатокСуммы = СуммаСтроки;
	ОстатокНДС = СуммаНДССтроки;
	ОстатокКоличества = КоличествоСтроки;
	СпособСтроки = СпособРасчета;
	АвансСтроки = ЭтоАванс;
	Если СтрокаЧека.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПодарочныйСертификат Тогда
		СпособСтроки = "advance";
		АвансСтроки = Истина;
	КонецЕсли;
	ТипНДС = эв_ТипНДСАтол(СтрокаЧека.СтавкаЧислом, СтрокаЧека.БезНДС, ЗначениеЗаполнено(СтрокаЧека.СтавкаНДС), АвансСтроки);
	
	Для Индекс = 0 По КоличествоЧастей - 1 Цикл
		Если Индекс = КоличествоЧастей - 1 Тогда
			Количество = ОстатокКоличества;
			Сумма = ОстатокСуммы;
			СуммаНДС = ОстатокНДС;
		Иначе
			Количество = Окр(КоличествоСтроки / КоличествоЧастей, 6);
			Сумма = Окр(СуммаСтроки / КоличествоЧастей, 2);
			СуммаНДС = Окр(СуммаНДССтроки / КоличествоЧастей, 2);
			ОстатокКоличества = ОстатокКоличества - Количество;
			ОстатокСуммы = ОстатокСуммы - Сумма;
			ОстатокНДС = ОстатокНДС - СуммаНДС;
		КонецЕсли;
		Если Количество <= 0 Тогда
			Количество = 1;
		КонецЕсли;
		Если Количество = 1 Тогда
			Цена = Окр(Сумма, 2);
			Сумма = Цена;
		Иначе
			Цена = Окр(Сумма / Количество, 2);
			Сумма = Окр(Цена * Количество, 2);
		КонецЕсли;
		
		КодМаркировки = Новый Структура;
		Если КодыСтроки.Количество() > Индекс Тогда
			КодМаркировки = КодыСтроки[Индекс];
		КонецЕсли; 
		
		ЕстьКод = Ложь;
		Если КодМаркировки.Свойство("ПолныйКодМаркировки") Тогда
			КодGS1M = эв_КодМаркировкиGS1M(КодМаркировки.ПолныйКодМаркировки);
			ЕстьКод = ЗначениеЗаполнено(КодGS1M);
		КонецЕсли;
		
		Позиция = Новый Структура;
		Позиция.Вставить("name", Наименование);
		Позиция.Вставить("price", Цена);
		Позиция.Вставить("quantity", Количество);
		Позиция.Вставить("measure", эв_МераКоличестваАтол(СтрокаЧека.ЕдиницаИзмерения, ЕстьКод));
		Позиция.Вставить("sum", Сумма);
		Позиция.Вставить("payment_method", СпособСтроки);
		Позиция.Вставить("payment_object", эв_ПризнакПредметаРасчетаПозицииАтол(
			ПризнакПредметаРасчета, ЕстьКод, СтрокаЧека.ПодакцизныйТовар));
		Налог = Новый Структура;
		Налог.Вставить("type", ТипНДС);
		Если ТипНДС <> "none" Тогда
			Налог.Вставить("sum", Макс(Окр(СуммаНДС, 2), 0));
		КонецЕсли;
		Позиция.Вставить("vat", Налог); 
		
		Если ЕстьКод Тогда
			
			Группы = Новый Структура; 
			Группы.Вставить("federal_id", "030");
			Группы.Вставить("date",       "21.11.2023");
			Группы.Вставить("number",     "1944");
			Если ЗначениеЗаполнено(КодМаркировки.РазрешительныйРежимИдентификаторЭкземпляраПО) Тогда
				value = СтрШаблон("UUID=%1&Time=%2&Inst=%3&Ver=%4", 
					КодМаркировки.РазрешительныйРежимИдентификаторЗапросаГИСМТ, 
					КодМаркировки.РазрешительныйРежимДатаЗапросаГИСМТ,
					КодМаркировки.РазрешительныйРежимИдентификаторЭкземпляраПО,
					КодМаркировки.РазрешительныйРежимВерсияБазы)
			ИНаче	
				value = СтрШаблон("UUID=%1&Time=%2", 
					КодМаркировки.РазрешительныйРежимИдентификаторЗапросаГИСМТ, 
					КодМаркировки.РазрешительныйРежимДатаЗапросаГИСМТ)
			КонецЕсли;
				
			Группы.Вставить("value", value);
			
			sectoral_item_props = Новый Массив;
			sectoral_item_props.Добавить(Группы);
			Позиция.Вставить("sectoral_item_props", sectoral_item_props);
			
			Позиция.Вставить("mark_processing_mode", "0");
			Позиция.Вставить("mark_code", Новый Структура("gs1m", КодGS1M));
			Если ЭтоВозврат Тогда
				ПланируемыйСтатус = ?(Количество = 1, 3, 4);
			Иначе
				ПланируемыйСтатус = ?(Количество = 1, 1, 5);
			КонецЕсли;
			Позиция.Вставить("planned_status", ПланируемыйСтатус);
		КонецЕсли;
		эв_ДобавитьАгентаПозицииАтол(Позиция, СтрокаЧека);
		Позиции.Добавить(Позиция);
	КонецЦикла;
	
КонецПроцедуры

Функция эв_КодыМаркировкиДокумента(ДокументОбъект)
	
	Результат = Новый Соответствие;
	КодыСерийные = Новый Соответствие;
	КодыИСМП     = Новый Соответствие;
	КодыДляПула = Новый Массив;
	СтрокиПула = Новый Массив;
	КэшКатегорийМДЛП = Новый Соответствие;
	КэшКатегорийИСМП = эв_ОбменСПорталамиСервер.КэшКатегорийМаркированныхТоваров();
	ЭтоЧекВозврата = ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМВозврат");
	
	Если Не ЭтоЧекВозврата Тогда
	Для Каждого СтрокаУпаковки Из ДокументОбъект.ор_НомераУпаковок Цикл
		Если Не ЗначениеЗаполнено(СтрокаУпаковки.ИдентификаторСтроки)
			Или Не ЗначениеЗаполнено(СтрокаУпаковки.ПолныйКодМаркировки) Тогда
			Продолжить;
		КонецЕсли;
		КодыСтроки = КодыСерийные.Получить(СтрокаУпаковки.ИдентификаторСтроки);
		Если КодыСтроки = Неопределено Тогда
			КодыСтроки = Новый Массив;
			КодыСерийные.Вставить(СтрокаУпаковки.ИдентификаторСтроки, КодыСтроки);
		КонецЕсли; 
		СтруктураКодаСтроки = Новый Структура;
		СтруктураКодаСтроки.Вставить("ПолныйКодМаркировки",СтрокаУпаковки.ПолныйКодМаркировки);
		СтруктураКодаСтроки.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ",СтрокаУпаковки.РазрешительныйРежимИдентификаторЗапросаГИСМТ);
		СтруктураКодаСтроки.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ",СтрокаУпаковки.РазрешительныйРежимДатаЗапросаГИСМТ);
		СтруктураКодаСтроки.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО",СтрокаУпаковки.РазрешительныйРежимИдентификаторЭкземпляраПО);
		СтруктураКодаСтроки.Вставить("РазрешительныйРежимВерсияБазы",СтрокаУпаковки.РазрешительныйРежимВерсияБазы);
		КодыСтроки.Добавить(СтруктураКодаСтроки);
	КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаУпаковки Из ДокументОбъект.АкцизныеМарки Цикл
		Если Не ЗначениеЗаполнено(СтрокаУпаковки.КлючСвязи)
			Или Не ЗначениеЗаполнено(СтрокаУпаковки.КодАкцизнойМарки) Тогда
			Продолжить;
		КонецЕсли;
		
		КодМаркировки = СокрЛП(СтрокаУпаковки.КодАкцизнойМарки);
		Если ЗначениеЗаполнено(КодМаркировки) Тогда
			
			КодыДляПула.Добавить(КодМаркировки); 
			
			СтруктураПула = Новый Структура;
			СтруктураПула.Вставить("КлючСвязи",  СтрокаУпаковки.КлючСвязи);
			СтруктураПула.Вставить("КодМаркировки",  КодМаркировки);
			СтруктураПула.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ",  СтрокаУпаковки.РазрешительныйРежимИдентификаторЗапросаГИСМТ);
			СтруктураПула.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ",  СтрокаУпаковки.РазрешительныйРежимДатаЗапросаГИСМТ);
			СтруктураПула.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО",  СтрокаУпаковки.РазрешительныйРежимИдентификаторЭкземпляраПО);
			СтруктураПула.Вставить("РазрешительныйРежимВерсияБазы",  СтрокаУпаковки.РазрешительныйРежимВерсияБазы);
			
			СтрокиПула.Добавить(СтруктураПула);
			
		КонецЕсли;
	КонецЦикла;
	
	ПолныеКодыПула = эв_ПолныеКодыМаркировкиПула(КодыДляПула);
	Для Каждого СтрокаПула Из СтрокиПула Цикл
		ПолныйКод = ПолныеКодыПула.Получить(СтрокаПула.КодМаркировки);
		Если Не ЗначениеЗаполнено(ПолныйКод)
			И (СтрНачинаетсяС(СтрокаПула.КодМаркировки, "01") Или СтрДлина(СтрокаПула.КодМаркировки) > 31) Тогда
			ПолныйКод = СтрокаПула.КодМаркировки;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолныйКод) Тогда
			
			КодыСтроки = КодыИСМП.Получить(СтрокаПула.КлючСвязи);
			
			Если КодыСтроки = Неопределено Тогда
				КодыСтроки = Новый Массив;
				КодыИСМП.Вставить(СтрокаПула.КлючСвязи, КодыСтроки);
			КонецЕсли; 
			
			СтруктураКодаСтроки = Новый Структура;
			СтруктураКодаСтроки.Вставить("ПолныйКодМаркировки",ПолныйКод);
			СтруктураКодаСтроки.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ",СтрокаПула.РазрешительныйРежимИдентификаторЗапросаГИСМТ);
			СтруктураКодаСтроки.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ",СтрокаПула.РазрешительныйРежимДатаЗапросаГИСМТ);
			СтруктураКодаСтроки.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО",СтрокаПула.РазрешительныйРежимИдентификаторЭкземпляраПО);
			СтруктураКодаСтроки.Вставить("РазрешительныйРежимВерсияБазы",СтрокаПула.РазрешительныйРежимВерсияБазы);
			КодыСтроки.Добавить(СтруктураКодаСтроки);

		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаЗапасов Из ДокументОбъект.Запасы Цикл
		
		Если эв_ОбменСПорталамиСервер.ТоварКатегорииСерийный(СтрокаЗапасов.Номенклатура, КэшКатегорийМДЛП) Тогда
			Если Не ЭтоЧекВозврата Тогда
				КодыСтроки = КодыСерийные.Получить(СтрокаЗапасов.ор_ИдентификаторСтроки);
				Если КодыСтроки <> Неопределено Тогда
					Результат.Вставить(СтрокаЗапасов.НомерСтроки, КодыСтроки);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли эв_ОбменСПорталамиСервер.ТоварКатегорииМаркированный(СтрокаЗапасов.Номенклатура, КэшКатегорийИСМП) Тогда
			КодыСтроки = КодыИСМП.Получить(СтрокаЗапасов.КлючСвязи);
			Если КодыСтроки <> Неопределено Тогда
				Результат.Вставить(СтрокаЗапасов.НомерСтроки, КодыСтроки);
			КонецЕсли;
		КонецЕсли; 

	КонецЦикла;
	
	Если ЭтоЧекВозврата Тогда
		эв_ДополнитьКодыМаркировкиВозврата(Результат, ДокументОбъект);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура эв_ДополнитьКодыМаркировкиВозврата(Результат, ДокументОбъект)
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ЧекККМ) Тогда
		Возврат;
	КонецЕсли;
	
	ЧекПродажи = ДокументОбъект.ЧекККМ.ПолучитьОбъект();
	Если ЧекПродажи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КодыПродажи = эв_КодыМаркировкиДокумента(ЧекПродажи);
	НомераСтрокПродажи = Новый Соответствие;
	Для Каждого СтрокаПродажи Из ЧекПродажи.Запасы Цикл
		Если ЗначениеЗаполнено(СтрокаПродажи.КлючСвязи)
			И НомераСтрокПродажи.Получить(СтрокаПродажи.КлючСвязи) = Неопределено Тогда
			НомераСтрокПродажи.Вставить(СтрокаПродажи.КлючСвязи, СтрокаПродажи.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаВозврата Из ДокументОбъект.Запасы Цикл
		Если Результат.Получить(СтрокаВозврата.НомерСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НомерСтрокиПродажи = НомераСтрокПродажи.Получить(СтрокаВозврата.КлючСвязи);
		Если НомерСтрокиПродажи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КодыСтроки = КодыПродажи.Получить(НомерСтрокиПродажи);
		Если КодыСтроки = Неопределено Или КодыСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(СтрокаВозврата.НомерСтроки, эв_КопияКодовМаркировки(КодыСтроки, СтрокаВозврата.Количество));
	КонецЦикла;
	
КонецПроцедуры

Функция эв_КопияКодовМаркировки(КодыСтроки, Количество)
	
	Копия = Новый Массив;
	Предел = КодыСтроки.Количество() - 1;
	Если Количество > 0 И Количество < КодыСтроки.Количество() Тогда
		Предел = Цел(Количество) - 1;
	КонецЕсли;
	Если Предел < 0 Тогда
		Возврат Копия;
	КонецЕсли;
	
	Для Индекс = 0 По Предел Цикл
		Копия.Добавить(КодыСтроки[Индекс]);
	КонецЦикла;
	
	Возврат Копия;
	
КонецФункции

Функция эв_ПолныеКодыМаркировкиПула(КодыМаркировки)
	
	Результат = Новый Соответствие;
	Если КодыМаркировки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПулКодовМаркировкиСУЗ.КодМаркировки КАК КодМаркировки,
	|	ПулКодовМаркировкиСУЗ.ПолныйКодМаркировки КАК ПолныйКодМаркировки
	|ИЗ
	|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	|ГДЕ
	|	ПулКодовМаркировкиСУЗ.КодМаркировки В (&КодыМаркировки)
	|	И ПулКодовМаркировкиСУЗ.ПолныйКодМаркировки <> """"";
	Запрос.УстановитьПараметр("КодыМаркировки", КодыМаркировки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодМаркировки = СокрЛП(Выборка.КодМаркировки);
		Если Результат.Получить(КодМаркировки) = Неопределено Тогда
			Результат.Вставить(КодМаркировки, Выборка.ПолныйКодМаркировки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_КодМаркировкиGS1M(КодМаркировки)
	
	Код = СокрЛП(КодМаркировки);
	Код = СтрЗаменить(Код, Символы.ПС, "");
	Код = СтрЗаменить(Код, Символы.ВК, "");
	Если ПустаяСтрока(Код) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНачинаетсяС(Код, "01") Или СтрНайти(Код, Символ(29)) > 0 Тогда
		Возврат ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ШтрихкодВBase64(Код);
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

Функция эв_ОплатыДокументаАтол(ДокументОбъект, ИтогЧека)
	
	СуммаЭлектронно = 0;
	СуммаПредоплаты = 0;
	СуммаПостоплаты = 0;
	СуммаВстречного = 0;
	
	Для Каждого СтрокаОплаты Из ДокументОбъект.БезналичнаяОплата Цикл
		Если СтрокаОплаты.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.БанковскаяКарта
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.СБП
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.Кредит
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.СертификатНСПК Тогда
			СуммаЭлектронно = СуммаЭлектронно + СтрокаОплаты.Сумма;
		ИначеЕсли СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ПодарочныйСертификат Тогда
			СуммаПредоплаты = СуммаПредоплаты + СтрокаОплаты.Сумма;
		ИначеЕсли СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ОплатаВРассрочку Тогда
			СуммаПостоплаты = СуммаПостоплаты + СтрокаОплаты.Сумма;
		ИначеЕсли СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ВстречноеПредоставление
			Или СтрокаОплаты.ВидОплаты = Перечисления.ВидыБезналичныхОплат.Бонусы Тогда
			СуммаВстречного = СуммаВстречного + СтрокаОплаты.Сумма;
		Иначе
			СуммаЭлектронно = СуммаЭлектронно + СтрокаОплаты.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	ОплатаДолга = ДокументОбъект.ОперацияСДенежнымиСредствами И ДокументОбъект.Предоплата.Количество() > 0;
	Если Не ОплатаДолга Тогда
		СуммаПредоплаты = СуммаПредоплаты + ДокументОбъект.Предоплата.Итог("СуммаРасчетов");
	КонецЕсли;
	
	СуммаБезналичных = Окр(СуммаЭлектронно + СуммаПредоплаты + СуммаПостоплаты + СуммаВстречного, 2);
	Итог = Окр(ИтогЧека, 2);
	СуммаНаличных = 0;
	Если СуммаБезналичных > Итог Тогда
		Избыток = СуммаБезналичных - Итог;
		Уменьшение = Мин(СуммаВстречного, Избыток);
		СуммаВстречного = СуммаВстречного - Уменьшение;
		Избыток = Избыток - Уменьшение;
		Уменьшение = Мин(СуммаПостоплаты, Избыток);
		СуммаПостоплаты = СуммаПостоплаты - Уменьшение;
		Избыток = Избыток - Уменьшение;
		Уменьшение = Мин(СуммаПредоплаты, Избыток);
		СуммаПредоплаты = СуммаПредоплаты - Уменьшение;
		Избыток = Избыток - Уменьшение;
		Уменьшение = Мин(СуммаЭлектронно, Избыток);
		СуммаЭлектронно = СуммаЭлектронно - Уменьшение;
	Иначе
		НужныНаличные = Итог - СуммаБезналичных;
		Если ДокументОбъект.ПолученоНаличными > НужныНаличные Тогда
			СуммаНаличных = Окр(ДокументОбъект.ПолученоНаличными, 2);
		Иначе
			СуммаНаличных = НужныНаличные;
		КонецЕсли;
	КонецЕсли;
	
	Оплаты = Новый Массив;
	эв_ДобавитьОплатуАтол(Оплаты, 0, СуммаНаличных);
	эв_ДобавитьОплатуАтол(Оплаты, 1, СуммаЭлектронно);
	эв_ДобавитьОплатуАтол(Оплаты, 2, СуммаПредоплаты);
	эв_ДобавитьОплатуАтол(Оплаты, 3, СуммаПостоплаты);
	эв_ДобавитьОплатуАтол(Оплаты, 4, СуммаВстречного);
	Если Оплаты.Количество() = 0 Тогда
		Оплата = Новый Структура;
		Оплата.Вставить("type", 1);
		Оплата.Вставить("sum", Итог);
		Оплаты.Добавить(Оплата);
	КонецЕсли;
	
	Возврат Оплаты;
	
КонецФункции

Процедура эв_ДобавитьОплатуАтол(Оплаты, ТипОплаты, Сумма)
	
	СуммаОплаты = Окр(Сумма, 2);
	Если СуммаОплаты <= 0 Тогда
		Возврат;
	КонецЕсли;
	Оплата = Новый Структура;
	Оплата.Вставить("type", ТипОплаты);
	Оплата.Вставить("sum", СуммаОплаты);
	Оплаты.Добавить(Оплата);
	
КонецПроцедуры

Функция эв_КлиентЧекаАтол(ДокументОбъект, Заказ)
	
	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Телефон, АдресЭП");
	Телефон = эв_ТелефонАтол(РеквизитыЗаказа.Телефон);
	Почта = СокрЛП(РеквизитыЗаказа.АдресЭП);
	Если Не СтрНайти(Почта, "@") > 0 Тогда
		Почта = "";
	КонецЕсли;
	Почта = Лев(Почта, 64);
	
	Клиент = Новый Структура;
	Если ЗначениеЗаполнено(Почта) Тогда
		Клиент.Вставить("email", Почта);
	КонецЕсли;
	Если ЗначениеЗаполнено(Телефон) Тогда
		Клиент.Вставить("phone", Телефон);
	КонецЕсли;
	Если Клиент.Количество() = 0 Тогда
		Клиент.Вставить("email", "none");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Сведения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.Контрагент, "НаименованиеПолное, ИНН");
		ИНН = эв_ТолькоЦифры(Сведения.ИНН);
		Если СтрДлина(ИНН) = 10 Или СтрДлина(ИНН) = 12 Тогда
			Клиент.Вставить("name", Лев(СокрЛП(Сведения.НаименованиеПолное), 256));
			Клиент.Вставить("inn", ИНН);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Клиент;
	
КонецФункции

Функция эв_ЗаказОснованиеЧека(ДокументОбъект)
	
	Если ЗначениеЗаполнено(ДокументОбъект.Заказ) Тогда
		Возврат ДокументОбъект.Заказ;
	КонецЕсли;
	
	Для Каждого СтрокаЗапасов Из ДокументОбъект.Запасы Цикл
		Если ЗначениеЗаполнено(СтрокаЗапасов.Заказ) Тогда
			Возврат СтрокаЗапасов.Заказ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
	
КонецФункции

Функция эв_ПочтаПокупателяИзЗаказа(ДокументОснование)
	
	Заказ = эв_ЗаказПокупателяДокументаФискализации(ДокументОснование);
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат "";
	КонецЕсли;
	
	Почта = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "АдресЭП"));
	Если Не СтрНайти(Почта, "@") > 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Лев(Почта, 64);
	
КонецФункции

Функция эв_ЗаказПокупателяДокументаФискализации(ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекККМ")
		Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекККМВозврат") Тогда
		ДокументОбъект = ДокументОснование.ПолучитьОбъект();
		Если ДокументОбъект = Неопределено Тогда
			Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
		КонецЕсли;
		Возврат эв_ЗаказОснованиеЧека(ДокументОбъект);
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекККМКоррекции") Тогда
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДокументОснование");
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Возврат Основание;
		КонецЕсли;
		Возврат эв_ЗаказПокупателяДокументаФискализации(Основание);
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам") Тогда
		Возврат эв_ЗаказОперацииПоПлатежнымКартам(ДокументОснование);
	КонецЕсли;
	
	Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
	
КонецФункции

Функция эв_ЗаказОперацииПоПлатежнымКартам(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Расшифровка.Заказ КАК Заказ
	|ИЗ
	|	Документ.ОперацияПоПлатежнымКартам.РасшифровкаПлатежа КАК Расшифровка
	|ГДЕ
	|	Расшифровка.Ссылка = &Ссылка
	|	И ТИПЗНАЧЕНИЯ(Расшифровка.Заказ) = ТИП(Документ.ЗаказПокупателя)
	|	И Расшифровка.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;
	
	Оплата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ОперацияПоПлатежнымКартамШапка");
	Если ТипЗнч(Оплата) = Тип("ДокументСсылка.ОперацияПоПлатежнымКартам") И ЗначениеЗаполнено(Оплата) Тогда
		Возврат эв_ЗаказОперацииПоПлатежнымКартам(Оплата);
	КонецЕсли;
	Если ТипЗнч(Оплата) = Тип("ДокументСсылка.ЧекККМ") И ЗначениеЗаполнено(Оплата) Тогда
		Возврат эв_ЗаказПокупателяДокументаФискализации(Оплата);
	КонецЕсли;
	
	Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
	
КонецФункции

Процедура эв_ЗаполнитьПочтуПокупателяИзЗаказа(ПараметрыЧека, ДокументОснование)
	
	Почта = эв_ПочтаПокупателяИзЗаказа(ДокументОснование);
	Если Не ЗначениеЗаполнено(Почта) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЧека.ПокупательEmail = Почта;
	
КонецПроцедуры

Функция эв_ПочтаКомпанииПоЗаказу(Заказ)
	
	ВидЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заказ, "ВидЗаказа");
	Если Не ЗначениеЗаполнено(ВидЗаказа) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Источники.Почта КАК Почта
	|ИЗ
	|	Справочник.эв_ИсточникиЗаказов КАК Источники
	|ГДЕ
	|	Источники.Вид = &ВидЗаказа
	|	И НЕ Источники.ПометкаУдаления
	|	И Источники.Почта <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Источники.Активный УБЫВ,
	|	Источники.Код";
	Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Лев(СокрЛП(Выборка.Почта), 64);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция эв_МестоРасчетовЧека(ДокументОбъект)
	
	Если ЗначениеЗаполнено(ДокументОбъект.АдресСайта) Тогда
		Возврат Лев(СокрЛП(ДокументОбъект.АдресСайта), 256);
	КонецЕсли;
	
	Адрес = "";
	Если ЗначениеЗаполнено(ДокументОбъект.СтруктурнаяЕдиница) Тогда
		Адрес = ПечатьДокументовУНФ.КонтактнаяИнформация(
			ДокументОбъект.СтруктурнаяЕдиница,
			ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресСтруктурнойЕдиницы"));
		Если ПустаяСтрока(СокрЛП(Адрес)) Тогда
			Адрес = Строка(ДокументОбъект.СтруктурнаяЕдиница);
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Адрес)) И ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		Адрес = Строка(ДокументОбъект.Организация);
	КонецЕсли;
	
	Возврат Лев(СокрЛП(Адрес), 256);
	
КонецФункции

Функция эв_НаименованиеПозицииАтол(СтрокаЧека)
	
	Наименование = СокрЛП(СтрокаЧека.НаименованиеПолное);
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = Строка(СтрокаЧека.Номенклатура);
	КонецЕсли;
	Характеристика = СокрЛП(СтрокаЧека.Характеристика);
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Наименование = Наименование + " (" + Характеристика + ")";
	КонецЕсли;
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = НСтр("ru = 'Товар'");
	КонецЕсли;
	
	Возврат Лев(Наименование, 128);
	
КонецФункции

Процедура эв_ДобавитьАгентаПозицииАтол(Позиция, СтрокаЧека)
	
	Если ТипЗнч(СтрокаЧека.СтатусПартии) <> Тип("ПеречислениеСсылка.СтатусыПартий") Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаЧека.СтатусПартии <> Перечисления.СтатусыПартий.ТоварыНаКомиссии
		Или Не ЗначениеЗаполнено(СтрокаЧека.ВладелецПартии) Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаЧека.ВладелецПартии, "НаименованиеПолное, ИНН");
	ИНН = эв_ТолькоЦифры(Реквизиты.ИНН);
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат;
	КонецЕсли;
	
	Поставщик = Новый Структура;
	Поставщик.Вставить("name", Лев(СокрЛП(Реквизиты.НаименованиеПолное), 256));
	Поставщик.Вставить("inn", ИНН);
	Позиция.Вставить("agent_info", Новый Структура("type", "commission_agent"));
	Позиция.Вставить("supplier_info", Поставщик);
	
КонецПроцедуры

Функция эв_ПризнакПредметаРасчетаПозицииАтол(ПризнакПредметаРасчета, ЕстьКодМаркировки, ПодакцизныйТовар)
	
	КодПризнака = эв_КодПризнакаПредметаРасчетаАтол(ПризнакПредметаРасчета);
	Если ЕстьКодМаркировки Тогда
		Если КодПризнака = 2 Или КодПризнака = 30 Или КодПризнака = 31 Или ПодакцизныйТовар = Истина Тогда
			Возврат 31;
		КонецЕсли;
		Если КодПризнака <> 3 И КодПризнака <> 4 И КодПризнака <> 10 Тогда
			Возврат 33;
		КонецЕсли;
	ИначеЕсли КодПризнака = 33 Тогда
		Возврат 32;
	ИначеЕсли КодПризнака = 31 Тогда
		Возврат 30;
	КонецЕсли;
	
	Возврат КодПризнака;
	
КонецФункции

Функция эв_КодПризнакаПредметаРасчетаАтол(ПризнакПредметаРасчета)
	
	Признаки = Перечисления.ПризнакиПредметаРасчета;
	Если ПризнакПредметаРасчета = Признаки.Товар Тогда
		Возврат 1;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПодакцизныйТовар Тогда
		Возврат 2;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Работа Тогда
		Возврат 3;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Услуга Тогда
		Возврат 4;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.СтавкаАзартнойИгры Тогда
		Возврат 5;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВыигрышАзартнойИгры Тогда
		Возврат 6;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ЛотерейныйБилет Тогда
		Возврат 7;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВыигрышЛотереи Тогда
		Возврат 8;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПредоставлениеРИД Тогда
		Возврат 9;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПлатежВыплата Или ПризнакПредметаРасчета = Признаки.Платеж Тогда
		Возврат 10;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.АгентскоеВознаграждение Тогда
		Возврат 11;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.СоставнойПредметРасчета Тогда
		Возврат 12;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ИнойПредметРасчета Тогда
		Возврат 13;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ИмущественноеПраво Тогда
		Возврат 14;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВнереализационныйДоход Тогда
		Возврат 15;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.СтраховыеВзносы Тогда
		Возврат 16;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ТорговыйСбор Тогда
		Возврат 17;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.КурортныйСбор
		Или ПризнакПредметаРасчета = Признаки.ТуристическийНалог Тогда
		Возврат 18;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Залог Тогда
		Возврат 19;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.Расход Тогда
		Возврат 20;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеПенсионноеСтрахованиеИП Тогда
		Возврат 21;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеПенсионноеСтрахование Тогда
		Возврат 22;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеМедицинскоеСтрахованиеИП Тогда
		Возврат 23;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеМедицинскоеСтрахование Тогда
		Возврат 24;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ОбязательноеСоциальноеСтрахование Тогда
		Возврат 25;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПлатежКазино Тогда
		Возврат 26;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ВыдачаДенежныхСредств Или ПризнакПредметаРасчета = Признаки.Выплата Тогда
		Возврат 27;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПодакцизныйТоварМаркируемыйСИНеИмеющийКМ Тогда
		Возврат 30;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ПодакцизныйТоварМаркируемыйСИИмеющийКМ Тогда
		Возврат 31;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ТоварМаркируемыйСИНеИмеющийКМ Тогда
		Возврат 32;
	ИначеЕсли ПризнакПредметаРасчета = Признаки.ТоварМаркируемыйСИИмеющийКМ Тогда
		Возврат 33;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

Функция эв_ПризнакСпособаРасчетаАтол(ПризнакСпособаРасчета)
	
	Признаки = Перечисления.ПризнакиСпособаРасчета;
	Если ПризнакСпособаРасчета = Признаки.ПредоплатаПолная Тогда
		Возврат "full_prepayment";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ПредоплатаЧастичная Тогда
		Возврат "prepayment";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.Аванс Тогда
		Возврат "advance";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ПередачаСЧастичнойОплатой Тогда
		Возврат "partial_payment";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ПередачаБезОплаты Тогда
		Возврат "credit";
	ИначеЕсли ПризнакСпособаРасчета = Признаки.ОплатаКредита Тогда
		Возврат "credit_payment";
	КонецЕсли;
	
	Возврат "full_payment";
	
КонецФункции

Функция эв_ТипНДСАтол(СтавкаЧислом, БезНДС, СтавкаЗаполнена, ЭтоАванс)
	
	Если Не СтавкаЗаполнена Или БезНДС Тогда
		Возврат "none";
	КонецЕсли;
	
	Ставка = Цел(СтавкаЧислом);
	Если Ставка = 0 Тогда
		Возврат "vat0";
	КонецЕсли;
	Если ЭтоАванс И (Ставка = 5 Или Ставка = 7 Или Ставка = 10 Или Ставка = 20 Или Ставка = 22) Тогда
		Возврат "vat" + Формат(100 + Ставка, "ЧГ=0");
	КонецЕсли;
	
	Возврат "vat" + Формат(Ставка, "ЧГ=0");
	
КонецФункции

Функция эв_МераКоличестваАтол(ЕдиницаИзмерения, ЕстьКодМаркировки)
	
	Если ЕстьКодМаркировки Или Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		Возврат 0;
	КонецЕсли;
	
	КодЕдиницы = "";
	Если ТипЗнч(ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
		Классификатор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ЕдиницаИзмерения, "ЕдиницаИзмеренияПоКлассификатору");
		Если ЗначениеЗаполнено(Классификатор) Тогда
			КодЕдиницы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Классификатор, "Код");
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		КодЕдиницы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Код");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СокрЛП(КодЕдиницы)) Тогда
		Возврат 0;
	КонецЕсли;
	
	Мера = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.МераКоличестваПредметаРасчетаПоКодуЕдиницыИзмерения(КодЕдиницы);
	КодМеры = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.КодМерыКоличестваПредметаРасчетаККТ(Мера);
	Если ТипЗнч(КодМеры) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат КодМеры;
	
КонецФункции

Функция эв_ТелефонАтол(Телефон)
	
	Цифры = эв_ТолькоЦифры(Телефон);
	Если ПустаяСтрока(Цифры) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(Цифры) = 11 И (Лев(Цифры, 1) = "7" Или Лев(Цифры, 1) = "8") Тогда
		Цифры = "7" + Сред(Цифры, 2);
	ИначеЕсли СтрДлина(Цифры) = 10 Тогда
		Цифры = "7" + Цифры;
	КонецЕсли;
	ТелефонАтол = "+" + Цифры;
	Если СтрДлина(ТелефонАтол) > 19 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ТелефонАтол;
	
КонецФункции

Функция эв_ТолькоЦифры(Текст)
	
	Результат = "";
	ИсходныйТекст = Строка(Текст);
	Для Индекс = 1 По СтрДлина(ИсходныйТекст) Цикл
		Символ = Сред(ИсходныйТекст, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция эв_ИдентификаторДокументаАтол(Содержание)
	
	Текст = СокрЛП(Содержание);
	Если Не СтрНачинаетсяС(Текст, "uuid:") Тогда
		Возврат "";
	КонецЕсли;
	Идентификатор = СокрЛП(Сред(Текст, 6));
	Если ПустаяСтрока(Идентификатор) Или Идентификатор = "sending" Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

Функция эв_РезультатФискализацииАтол(Данные)
	
	ПолезнаяНагрузка = эв_ЗначениеОтветаАтол(Данные, "payload");
	Результат = Новый Структура;
	Результат.Вставить("УникальныйИдентификатор", СокрЛП(Строка(эв_ЗначениеОтветаАтол(Данные, "uuid"))));
	Результат.Вставить("НомерФискальногоДокумента", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fiscal_document_number"));
	Результат.Вставить("ФискальныйПризнак", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fiscal_document_attribute"));
	Результат.Вставить("НомерФискальногоНакопителя", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fn_number"));
	Результат.Вставить("НомерСмены", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "shift_number"));
	Результат.Вставить("НомерЧека", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "fiscal_receipt_number"));
	Результат.Вставить("ДатаЧека", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "receipt_datetime"));
	Результат.Вставить("АдресЧекаОФД", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "ofd_receipt_url"));
	Результат.Вставить("РегистрационныйНомерККТ", эв_ЗначениеОтветаАтол(ПолезнаяНагрузка, "ecr_registration_number"));
	Возврат Результат;
	
КонецФункции

Функция эв_ОписаниеРезультатаФискализации(Результат)
	
	Возврат СтрШаблон(НСтр("ru = 'ФД %1, ФП %2, ФН %3'"),
		Результат.НомерФискальногоДокумента,
		Результат.ФискальныйПризнак,
		Результат.НомерФискальногоНакопителя);
	
КонецФункции

Функция эв_КодОшибкиАтол(Данные)
	
	Ошибка = эв_ЗначениеОтветаАтол(Данные, "error");
	Код = эв_ЗначениеОтветаАтол(Ошибка, "code");
	Если ТипЗнч(Код) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

Функция эв_ТекстОшибкиАтол(Данные)
	
	Ошибка = эв_ЗначениеОтветаАтол(Данные, "error");
	Если Ошибка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Текст = СокрЛП(Строка(эв_ЗначениеОтветаАтол(Ошибка, "text")));
	Если ПустаяСтрока(Текст) Или Текст = "Неопределено" Тогда
		Текст = НСтр("ru = 'Ошибка сервиса АТОЛ'");
	КонецЕсли;
	Код = эв_КодОшибкиАтол(Данные);
	Если Код <> 0 Тогда
		Возврат СтрШаблон("АТОЛ %1: %2", Формат(Код, "ЧГ=0"), Текст);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция эв_ЗначениеОтветаАтол(Данные, ИмяСвойства)
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные.Получить(ИмяСвойства);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция эв_ТекстJSON(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
	

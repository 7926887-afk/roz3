Процедура ЗаписатьСвязки(МассивСвязок)

	УникальныеСвязки = Новый Соответствие;
	Для Каждого ЭлементСвязки Из МассивСвязок Цикл

		КодАСНА = ЧислоИзJSON(ЗначениеПоляJSON(ЭлементСвязки, "nnt"));
		Если КодАСНА = 0 Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = эв_ОбменСПорталамиСервер.НоменклатураПоИдентификаторуПортала(ЗначениеПоляJSON(ЭлементСвязки, "sku"));
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		УникальныеСвязки.Вставить(Номенклатура, Формат(КодАСНА, "ЧГ="));

	КонецЦикла;

	Если УникальныеСвязки.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , ,
			"В связках АСНА нет sku, совпадающих с GUID номенклатуры. Локальные связки не изменены");
		Возврат;
	КонецЕсли;

	Набор = РегистрыСведений.эв_КодыНоменклатурыПорталов.СоздатьНаборЗаписей();
	Набор.Отбор.ВидИсточника.Установить(Перечисления.эв_ВидыИсточниковЗаказа.Асна);
	Для Каждого ЭлементСвязки Из УникальныеСвязки Цикл
		Запись = Набор.Добавить();
		Запись.ВидИсточника = Перечисления.эв_ВидыИсточниковЗаказа.Асна;
		Запись.Номенклатура = ЭлементСвязки.Ключ;
		Запись.КодПортала = ЭлементСвязки.Значение;
	КонецЦикла;
	Набор.Записать();


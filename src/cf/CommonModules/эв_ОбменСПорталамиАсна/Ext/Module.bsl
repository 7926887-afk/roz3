#Область ПрограммныйИнтерфейс

Функция ВыгрузитьОстатки(Источник, НастройкиAPI, ПолнаяВыгрузка) Экспорт

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не заполнены настройки API АСНА");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиAPI.Склад) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"У источника заказов не заполнен склад");
		Возврат Ложь;
	КонецЕсли;

	Если ПолнаяВыгрузка Или Не СвязкиЗаполнены() Тогда
		ЗагрузитьСвязки(Источник, НастройкиAPI);
	КонецЕсли;

	ТаблицаОстатков = ПолучитьОстаткиЦены(Источник, НастройкиAPI, ПолнаяВыгрузка);
	ТаблицаКОтправке = ТаблицаОстатков.СкопироватьКолонки();
	МассивОстатков = СформироватьМассивОстатков(ТаблицаОстатков, ТаблицаКОтправке);
	Если МассивОстатков.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("date", эв_ОбменСПорталамиСервер.ДатаISOСмещением(ТекущаяДатаСеанса()));
	ТелоЗапроса.Вставить("stocks", МассивОстатков);

	КодыУспеха = Новый Массив;
	КодыУспеха.Добавить(202);
	РезультатHTTP = ВыполнитьЗапросСТокеном(Источник, НастройкиAPI,
		?(ПолнаяВыгрузка, "POST", "PUT"),
		АдресРесурсаМагазина(НастройкиAPI, "/stocks"),
		ТелоЗапроса,
		?(ПолнаяВыгрузка, "stocksFull", "stocksInc"),
		КодыУспеха);

	Если Не РезультатHTTP.Успех Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			РезультатHTTP.ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	эв_ОбменСПорталамиСервер.ОбновитьСнимокОстатков(Источник, ТаблицаКОтправке, ПолнаяВыгрузка);
	Возврат Истина;

КонецФункции

Функция ЗагрузитьЗаказы(Источник, НастройкиAPI) Экспорт

	ТаблицаЗагруженных = НоваяТаблицаЗагруженныхЗаказов();

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не заполнены настройки API АСНА");
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиAPI.Склад) Тогда
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	Если Не СвязкиЗаполнены() Тогда
		ЗагрузитьСвязки(Источник, НастройкиAPI);
	КонецЕсли;

	ГраницаSince = ПрочитатьГраницуSince(Источник);
	АдресЗапроса = АдресРесурсаМагазина(НастройкиAPI, "/orders_exchanger?since=" + ЗакодироватьSince(ГраницаSince));

	КодыУспеха = Новый Массив;
	КодыУспеха.Добавить(200);
	РезультатHTTP = ВыполнитьЗапросСТокеном(Источник, НастройкиAPI, "GET", АдресЗапроса, Неопределено, "orders", КодыУспеха);
	Если Не РезультатHTTP.Успех Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			РезультатHTTP.ТекстОшибки);
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	ЗагрузитьЗаказыИзJSON(Источник, НастройкиAPI, РезультатHTTP.Json, ТаблицаЗагруженных); 
	Возврат ТаблицаЗагруженных;

КонецФункции

Функция ОтправитьСтатус(ПараметрыОчереди, НастройкиAPI) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Результат.ТекстОшибки = "Не заполнены настройки API АСНА";
		Возврат Результат;
	КонецЕсли;

	КодСтатуса = эв_ОбменСПорталамиСервер.КодСтатусаПортала(
		ПараметрыОчереди.ИсточникЗаказов, ПараметрыОчереди.СтатусЗаказа, ПараметрыОчереди.ЗаказПокупателя);
	КодЧислом = ЧислоИзJSON(КодСтатуса);
	Если КодЧислом = 0 И СокрЛП(КодСтатуса) <> "0" Тогда
		Результат.ТекстОшибки = "Не задан числовой код статуса портала для состояния заказа";
		Возврат Результат;
	КонецЕсли;

	Если ЭтоСтатусСайта(КодЧислом) Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	ИдентификаторЗаказа = эв_ОбменСПорталамиСервер.ИдентификаторЗаказаНаПортале(ПараметрыОчереди.ЗаказПокупателя);
	Если Не ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
		Результат.ТекстОшибки = "Не найден orderId заказа на портале";
		Возврат Результат;
	КонецЕсли;

	СтатусПортала = Новый Структура;
	СтатусПортала.Вставить("statusId", Строка(Новый УникальныйИдентификатор));
	СтатусПортала.Вставить("orderId", ИдентификаторЗаказа);
	СтатусПортала.Вставить("storeId", ИдентификаторАптеки(НастройкиAPI));
	СтатусПортала.Вставить("date", эв_ОбменСПорталамиСервер.ДатаISOСмещением(ТекущаяДатаСеанса()));

	СтрокиОтвета = Неопределено;
	Если КодЧислом = 200 Или КодЧислом = 201 Тогда
		РазборРезерва = СтрокиНезарезервированного(ПараметрыОчереди.ЗаказПокупателя, ИдентификаторЗаказа);
		Если РазборРезерва.ПолныйОтказ Тогда
			КодЧислом = 202;
		ИначеЕсли РазборРезерва.Строки.Количество() > 0 Тогда
			КодЧислом = 201;
			СтрокиОтвета = РазборРезерва.Строки;
		Иначе
			КодЧислом = 200;
		КонецЕсли;
	ИначеЕсли КодЧислом = 204 Тогда
		Если Не ЗначениеЗаполнено(ПараметрыОчереди.ДатаОкончанияРезерва) Тогда
			Результат.ТекстОшибки = "Для статуса 204 не заполнена дата сброса резерва";
			Возврат Результат;
		КонецЕсли;
		СтатусПортала.Вставить("rcDate", эв_ОбменСПорталамиСервер.ДатаISOСмещением(ПараметрыОчереди.ДатаОкончанияРезерва));
	ИначеЕсли КодЧислом = 212 Тогда
		Заметки = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОчереди.ЗаказПокупателя, "Заметки")));
		Если ЗначениеЗаполнено(Заметки) Тогда
			СтатусПортала.Вставить("cmnt", Заметки);
		КонецЕсли;
	КонецЕсли;

	СтатусПортала.Вставить("status", КодЧислом);

	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(СтатусПортала);
	ТелоЗапроса = Новый Структура("statuses", МассивСтатусов);
	Если СтрокиОтвета <> Неопределено Тогда
		ТелоЗапроса.Вставить("rows", СтрокиОтвета);
	КонецЕсли;

	КодыУспеха = Новый Массив;
	КодыУспеха.Добавить(201);
	РезультатHTTP = ВыполнитьЗапросСТокеном(ПараметрыОчереди.ИсточникЗаказов, НастройкиAPI, "PUT",
		АдресРесурсаМагазина(НастройкиAPI, "/orders_exchanger"), ТелоЗапроса, "setStatus", КодыУспеха,
		ПараметрыОчереди.ЗаказПокупателя);

	Результат.Успех = РезультатHTTP.Успех;
	Результат.ТекстОшибки = РезультатHTTP.ТекстОшибки;
	Возврат Результат;

КонецФункции

Функция ДанныеПодключенияКорректны(НастройкиAPI) Экспорт

	Если ТипЗнч(НастройкиAPI) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПолеЗаполнено(НастройкиAPI, "Адрес")
		И ПолеЗаполнено(НастройкиAPI, "Логин")
		И ПолеЗаполнено(НастройкиAPI, "Пароль");

КонецФункции

Функция ЗагрузитьСвязки(Источник, НастройкиAPI) Экспорт

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Возврат Ложь;
	КонецЕсли;

	АдресЗапроса = эв_ОбменСПорталамиСервер.БазовыйАдресAPI(НастройкиAPI) + "/v5/references/goods_links?names=false";
	КодыУспеха = Новый Массив;
	КодыУспеха.Добавить(200);
	РезультатHTTP = ВыполнитьЗапросСТокеном(Источник, НастройкиAPI, "GET", АдресЗапроса, Неопределено, "goodsLinks", КодыУспеха);
	Если Не РезультатHTTP.Успех Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			РезультатHTTP.ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(РезультатHTTP.Json) <> Тип("Массив") Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			"Ответ goods_links не является массивом");
		Возврат Ложь;
	КонецЕсли;

	Если РезультатHTTP.Json.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Справочник связок АСНА пуст, локальные связки не изменены");
		Возврат Истина;
	КонецЕсли;

	ЗаписатьСвязки(РезультатHTTP.Json);
	Возврат Истина;

КонецФункции

Процедура ВыгрузитьКаталогНоменклатуры() Экспорт

	Источники = ИсточникиАсна();
	Если Источники.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Нет активных источников заказов АСНА");
		Возврат;
	КонецЕсли;

	Для Каждого Источник Из Источники Цикл
		НастройкиAPI = эв_ОбменСПорталамиСервер.НастройкиAPIИсточника(Источник);
		ВыгрузитьКаталогИсточника(Источник, НастройкиAPI);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапросСТокеном(Источник, НастройкиAPI, Метод, Адрес, Тело, Контур, КодыУспеха, ЗаказПокупателя = Неопределено)

	Если Не ОбеспечитьТокен(Источник, НастройкиAPI, Ложь) Тогда
		Результат = Новый Структура("Успех, КодСостояния, Json, ТекстОтвета, ТекстОшибки", Ложь, 0, Неопределено, "", "Не получен токен АСНА");
		Возврат Результат;
	КонецЕсли;

	Результат = ВызватьМетодАСНА(Источник, НастройкиAPI, Метод, Адрес, Тело, Контур, КодыУспеха, ЗаказПокупателя);
	Если Результат.КодСостояния = 401 И ОбеспечитьТокен(Источник, НастройкиAPI, Истина) Тогда
		Результат = ВызватьМетодАСНА(Источник, НастройкиAPI, Метод, Адрес, Тело, Контур, КодыУспеха, ЗаказПокупателя);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВызватьМетодАСНА(Источник, НастройкиAPI, Метод, Адрес, Тело, Контур, КодыУспеха, ЗаказПокупателя)

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ИсточникЗаказов", Источник);
	ПараметрыЗапроса.Вставить("Метод", Метод);
	ПараметрыЗапроса.Вставить("Адрес", Адрес);
	ПараметрыЗапроса.Вставить("Контур", Контур);
	ПараметрыЗапроса.Вставить("Заголовки", ЗаголовкиПортала(НастройкиAPI));
	ПараметрыЗапроса.Вставить("КодыУспеха", КодыУспеха);
	Если Тело <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("Тело", Тело);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ПараметрыЗапроса.Вставить("ЗаказПокупателя", ЗаказПокупателя);
	КонецЕсли;

	Возврат эв_ОбменСПорталамиСервер.ВыполнитьЗапросHTTP(ПараметрыЗапроса);

КонецФункции

Функция ЗаголовкиПортала(НастройкиAPI)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Accept-Language", "ru");
	Заголовки.Вставить("Authorization", "Bearer " + НастройкиAPI.auth_token);
	Возврат Заголовки;

КонецФункции

Функция ОбеспечитьТокен(Источник, НастройкиAPI, Принудительно)

	Если Не Принудительно И ЗначениеЗаполнено(НастройкиAPI.auth_token) Тогда
		Возврат Истина;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	ТелоФормы = "client_id=" + КодироватьСтроку(ИдентификаторАптеки(НастройкиAPI), СпособКодированияСтроки.КодировкаURL)
		+ "&client_secret=" + КодироватьСтроку(НастройкиAPI.Пароль, СпособКодированияСтроки.КодировкаURL)
		+ "&grant_type=client_credentials";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ИсточникЗаказов", Источник);
	ПараметрыЗапроса.Вставить("Метод", "POST");
	ПараметрыЗапроса.Вставить("Адрес", "https://sso.asna.cloud:5000/connect/token");
	ПараметрыЗапроса.Вставить("Контур", "token");
	ПараметрыЗапроса.Вставить("Заголовки", Заголовки);
	ПараметрыЗапроса.Вставить("Данные", ТелоФормы);
	ПараметрыЗапроса.Вставить("ПарольДляМаскировки", НастройкиAPI.Пароль);

	РезультатHTTP = эв_ОбменСПорталамиСервер.ВыполнитьЗапросHTTP(ПараметрыЗапроса);
	Если Не РезультатHTTP.Успех Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			РезультатHTTP.ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	Токен = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(РезультатHTTP.Json, "access_token")));
	Если Не ЗначениеЗаполнено(Токен) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			"В ответе SSO нет access_token");
		Возврат Ложь;
	КонецЕсли;

	СохранитьТокен(Источник, Токен);
	НастройкиAPI.auth_token = Токен;
	Возврат Истина;

КонецФункции

Процедура СохранитьТокен(Источник, Токен)

	МенеджерЗаписи = РегистрыСведений.эв_НастройкиAPIИсточникаЗаказов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИсточникЗаказов = Источник;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Токен АСНА получен, но запись настроек API не найдена");
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.auth_token = Токен;
	МенеджерЗаписи.Записать();

КонецПроцедуры

Функция ИдентификаторАптеки(НастройкиAPI)

	Возврат СокрЛП(НастройкиAPI.Логин);

КонецФункции

Функция АдресРесурсаМагазина(НастройкиAPI, Хвост)

	Возврат эв_ОбменСПорталамиСервер.БазовыйАдресAPI(НастройкиAPI)
		+ "/v5/stores/"
		+ КодироватьСтроку(ИдентификаторАптеки(НастройкиAPI), СпособКодированияСтроки.КодировкаURL)
		+ Хвост;

КонецФункции

Функция ПолучитьОстаткиЦены(Источник, НастройкиAPI, ПолнаяВыгрузка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Связки.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(Связки.КодПортала) КАК КодАСНА
		|ПОМЕСТИТЬ ВТ_Связки
		|ИЗ
		|	РегистрСведений.эв_КодыНоменклатурыПорталов КАК Связки
		|ГДЕ
		|	Связки.ВидИсточника = ЗНАЧЕНИЕ(Перечисление.эв_ВидыИсточниковЗаказа.Асна)
		|
		|СГРУППИРОВАТЬ ПО
		|	Связки.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Склад
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, СтруктурнаяЕдиница = &Склад) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура,
		|	Остатки.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Резервы.Номенклатура КАК Номенклатура,
		|	Резервы.Характеристика КАК Характеристика,
		|	СУММА(Резервы.КоличествоОстаток) КАК РезервОстаток
		|ПОМЕСТИТЬ ВТ_Резервы
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(
		|			,
		|			СтруктурнаяЕдиница = &Склад
		|				И ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Резервы
		|
		|СГРУППИРОВАТЬ ПО
		|	Резервы.Номенклатура,
		|	Резервы.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Склад.Номенклатура КАК Номенклатура,
		|	ВТ_Склад.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0) < 0
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0)
		|	КОНЕЦ КАК ДоступныйОстаток,
		|	ЕСТЬNULL(ВТ_Склад.Номенклатура.Наименование, """") КАК Наименование,
		|	ЕСТЬNULL(ВТ_Склад.Номенклатура.ЦеноваяГруппа.Наименование, """") КАК ЦеноваяГруппаНаименование,
		|	ВЫБОР
		|		КОГДА ВТ_Склад.Номенклатура.ор_Производитель = ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка)
		|			ТОГДА """"
		|		ИНАЧЕ ЕСТЬNULL(ВТ_Склад.Номенклатура.ор_Производитель.Наименование, """")
		|	КОНЕЦ КАК Производитель,
		|	ЕСТЬNULL(ВТ_Склад.Номенклатура.ор_ЖНВЛС, ЛОЖЬ) КАК ЖНВЛС,
		|	ВТ_Склад.Характеристика.ор_СрокГодности КАК СрокГодности,
		|	ЕСТЬNULL(ВТ_Склад.Характеристика.ор_СерияПроизводителя, """") КАК Серия,
		|	ВТ_Связки.КодАСНА КАК КодАСНА
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	ВТ_Склад КАК ВТ_Склад
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Резервы КАК ВТ_Резервы
		|		ПО ВТ_Склад.Номенклатура = ВТ_Резервы.Номенклатура
		|			И ВТ_Склад.Характеристика = ВТ_Резервы.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Связки КАК ВТ_Связки
		|		ПО ВТ_Склад.Номенклатура = ВТ_Связки.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	Цены.Характеристика КАК Характеристика,
		|	МАКСИМУМ(Цены.Цена) КАК Цена
		|ПОМЕСТИТЬ ВТ_Цены
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦен = &ВидЦен) КАК Цены
		|
		|СГРУППИРОВАТЬ ПО
		|	Цены.Номенклатура,
		|	Цены.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Остатки.Номенклатура КАК Номенклатура,
		|	ВТ_Остатки.Характеристика КАК Характеристика,
		|	ВТ_Остатки.ДоступныйОстаток КАК ДоступныйОстаток,
		|	ВТ_Остатки.Наименование КАК Наименование,
		|	ВТ_Остатки.Производитель КАК Производитель,
		|	ВТ_Остатки.ЖНВЛС КАК ЖНВЛС,
		|	ВТ_Остатки.СрокГодности КАК СрокГодности,
		|	ВТ_Остатки.Серия КАК Серия,
		|	ВТ_Остатки.КодАСНА КАК КодАСНА,
		|	ВЫБОР
		|		КОГДА ВРЕГ(ВТ_Остатки.ЦеноваяГруппаНаименование) = ""ЭВАЛАР""
		|			ТОГДА ЕСТЬNULL(ЦеныБезХарактеристики.Цена, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЦеныСХарактеристикой.Цена, ЕСТЬNULL(ЦеныБезХарактеристики.Цена, 0))
		|	КОНЕЦ КАК Цена
		|ПОМЕСТИТЬ ВТ_Текущие
		|ИЗ
		|	ВТ_Остатки КАК ВТ_Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ЦеныБезХарактеристики
		|		ПО ВТ_Остатки.Номенклатура = ЦеныБезХарактеристики.Номенклатура
		|			И (ЦеныБезХарактеристики.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ЦеныСХарактеристикой
		|		ПО ВТ_Остатки.Номенклатура = ЦеныСХарактеристикой.Номенклатура
		|			И ВТ_Остатки.Характеристика = ЦеныСХарактеристикой.Характеристика
		|			И (ВРЕГ(ВТ_Остатки.ЦеноваяГруппаНаименование) <> ""ЭВАЛАР"")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Снимок.Номенклатура КАК Номенклатура,
		|	Снимок.Характеристика КАК Характеристика,
		|	Снимок.Цена КАК Цена,
		|	Снимок.ДоступныйОстаток КАК ДоступныйОстаток,
		|	ЕСТЬNULL(Снимок.Номенклатура.Наименование, """") КАК Наименование,
		|	ВЫБОР
		|		КОГДА Снимок.Номенклатура.ор_Производитель = ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка)
		|			ТОГДА """"
		|		ИНАЧЕ ЕСТЬNULL(Снимок.Номенклатура.ор_Производитель.Наименование, """")
		|	КОНЕЦ КАК Производитель,
		|	ЕСТЬNULL(Снимок.Номенклатура.ор_ЖНВЛС, ЛОЖЬ) КАК ЖНВЛС,
		|	Снимок.Характеристика.ор_СрокГодности КАК СрокГодности,
		|	ЕСТЬNULL(Снимок.Характеристика.ор_СерияПроизводителя, """") КАК Серия,
		|	ВТ_Связки.КодАСНА КАК КодАСНА
		|ПОМЕСТИТЬ ВТ_Снимок
		|ИЗ
		|	РегистрСведений.эв_ВыгруженныеОстаткиПорталов КАК Снимок
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Связки КАК ВТ_Связки
		|		ПО Снимок.Номенклатура = ВТ_Связки.Номенклатура
		|ГДЕ
		|	Снимок.ИсточникЗаказов = &Источник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_Текущие.Номенклатура, ВТ_Снимок.Номенклатура) КАК Номенклатура,
		|	ЕСТЬNULL(ВТ_Текущие.Характеристика, ВТ_Снимок.Характеристика) КАК Характеристика,
		|	ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) КАК ДоступныйОстаток,
		|	ЕСТЬNULL(ВТ_Текущие.Цена, ВТ_Снимок.Цена) КАК Цена,
		|	ЕСТЬNULL(ВТ_Текущие.Наименование, ВТ_Снимок.Наименование) КАК Наименование,
		|	ЕСТЬNULL(ВТ_Текущие.Производитель, ВТ_Снимок.Производитель) КАК Производитель,
		|	ЕСТЬNULL(ВТ_Текущие.ЖНВЛС, ВТ_Снимок.ЖНВЛС) КАК ЖНВЛС,
		|	ЕСТЬNULL(ВТ_Текущие.СрокГодности, ВТ_Снимок.СрокГодности) КАК СрокГодности,
		|	ЕСТЬNULL(ВТ_Текущие.Серия, ВТ_Снимок.Серия) КАК Серия,
		|	ЕСТЬNULL(ВТ_Текущие.КодАСНА, ВТ_Снимок.КодАСНА) КАК КодАСНА
		|ИЗ
		|	ВТ_Текущие КАК ВТ_Текущие
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Снимок КАК ВТ_Снимок
		|		ПО ВТ_Текущие.Номенклатура = ВТ_Снимок.Номенклатура
		|			И ВТ_Текущие.Характеристика = ВТ_Снимок.Характеристика
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ПолнаяВыгрузка
		|				ТОГДА ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) >= 1
		|			КОГДА ВТ_Снимок.Номенклатура ЕСТЬ NULL
		|				ТОГДА ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) >= 1
		|			ИНАЧЕ ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) <> ЕСТЬNULL(ВТ_Снимок.ДоступныйОстаток, 0)
		|					ИЛИ ЕСТЬNULL(ВТ_Текущие.Цена, 0) <> ЕСТЬNULL(ВТ_Снимок.Цена, 0)
		|		КОНЕЦ";

	Запрос.УстановитьПараметр("Склад", НастройкиAPI.Склад);
	Запрос.УстановитьПараметр("ВидЦен", НастройкиAPI.ВидЦен);
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("ПолнаяВыгрузка", ПолнаяВыгрузка);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция СформироватьМассивОстатков(ТаблицаОстатков, ТаблицаКОтправке)

	МассивОстатков = Новый Массив;
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл

		КодАСНА = ЧислоИзJSON(СтрокаОстатка.КодАСНА);
		Если КодАСНА = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоКОтправке = Цел(СтрокаОстатка.ДоступныйОстаток);
		Если КоличествоКОтправке < 0 Тогда
			КоличествоКОтправке = 0;
		КонецЕсли;

		ЦенаОтправки = 0;
		Если ЗначениеЗаполнено(СтрокаОстатка.Цена) Тогда
			ЦенаОтправки = Окр(СтрокаОстатка.Цена, 2);
		КонецЕсли;
		Если ЦенаОтправки <= 0 И КоличествоКОтправке > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЦенаОтправки <= 0 И КоличествоКОтправке = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаКОтправке = ТаблицаКОтправке.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКОтправке, СтрокаОстатка);
		Если КоличествоКОтправке = 0 Тогда
			СтрокаКОтправке.ДоступныйОстаток = 0;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаОстатка.Характеристика) Тогда
			ИдентификаторПартии = XMLСтрока(СтрокаОстатка.Характеристика);
		Иначе
			ИдентификаторПартии = XMLСтрока(СтрокаОстатка.Номенклатура);
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("prtId", Лев(ИдентификаторПартии, 50));
		Позиция.Вставить("nnt", КодАСНА);
		Позиция.Вставить("sku", Лев(XMLСтрока(СтрокаОстатка.Номенклатура), 50));
		Позиция.Вставить("qnt", КоличествоКОтправке);
		Позиция.Вставить("gnvls", СтрокаОстатка.ЖНВЛС = Истина);
		Позиция.Вставить("prcOptNds", ЦенаОтправки);
		Позиция.Вставить("prcRet", ЦенаОтправки);
		Если СтрокаОстатка.ЖНВЛС = Истина Тогда
			Позиция.Вставить("prcGnvlsMax", ЦенаОтправки);
		КонецЕсли;
		Производитель = СокрЛП(СтрокаОстатка.Производитель);
		Если ЗначениеЗаполнено(Производитель) Тогда
			Позиция.Вставить("man", Лев(Производитель, 255));
		КонецЕсли;
		Серия = СокрЛП(СтрокаОстатка.Серия);
		Если ЗначениеЗаполнено(Серия) Тогда
			Позиция.Вставить("series", Лев(Серия, 50));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаОстатка.СрокГодности) Тогда
			Позиция.Вставить("exp", эв_ОбменСПорталамиСервер.ДатаISOСмещением(НачалоДня(СтрокаОстатка.СрокГодности)));
		КонецЕсли;

		МассивОстатков.Добавить(Позиция);

	КонецЦикла;

	Возврат МассивОстатков;

КонецФункции

Процедура ЗагрузитьЗаказыИзJSON(Источник, НастройкиAPI, ДанныеJSON, ТаблицаЗагруженных)

	ЗаголовкиЗаказов = ЗначениеПоляJSON(ДанныеJSON, "headers");
	Если ТипЗнч(ЗаголовкиЗаказов) <> Тип("Массив") Тогда
		ЗаголовкиЗаказов = Новый Массив;
	КонецЕсли;

	СтрокиПоЗаказам = ИндексПоЗаказу(ЗначениеПоляJSON(ДанныеJSON, "rows"));
	СтатусыПоЗаказам = ИндексПоЗаказу(ЗначениеПоляJSON(ДанныеJSON, "statuses"));
	СостояниеПринято = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "200").ВидСтатуса;
	ПредупреждениеОСтатусе = Ложь;
	ГраницаОшибки = "";
	БылаОшибка = Ложь;
	ОбработанныеЗаказы = Новый Соответствие;

	ТаблицаЗаголовков = ТаблицаЗаголовковЗаказов(ЗаголовкиЗаказов);
	ТаблицаЗаголовков.Сортировать("ОтметкаВремени");

	Для Каждого СтрокаЗаголовка Из ТаблицаЗаголовков Цикл

		ИдентификаторЗаказа = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(СтрокаЗаголовка.Шапка, "orderId")));
		Если Не ОбработатьЗаголовокЗаказа(Источник, НастройкиAPI, СтрокаЗаголовка, СтрокиПоЗаказам, СтатусыПоЗаказам,
			ТаблицаЗагруженных, СостояниеПринято, ПредупреждениеОСтатусе) Тогда
			ГраницаОшибки = СтрокаЗаголовка.ОтметкаВремени;
			БылаОшибка = Истина;
			Прервать;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
			ОбработанныеЗаказы.Вставить(ИдентификаторЗаказа, Истина);
		КонецЕсли;

	КонецЦикла;

	Если Не БылаОшибка Тогда
		ПрименитьСтатусыБезЗаголовков(Источник, СтатусыПоЗаказам, ОбработанныеЗаказы, ТаблицаЗагруженных);
	КонецЕсли;

	Если БылаОшибка Тогда
		СохранитьГраницуSince(Источник, ОтметкаДоОшибки(ДанныеJSON, ГраницаОшибки));
	Иначе
		СохранитьГраницуSince(Источник, МаксимальнаяОтметкаВремени(ДанныеJSON));
	КонецЕсли;

КонецПроцедуры

Функция ОбработатьЗаголовокЗаказа(Источник, НастройкиAPI, СтрокаЗаголовка, СтрокиПоЗаказам, СтатусыПоЗаказам,
	ТаблицаЗагруженных, СостояниеПринято, ПредупреждениеОСтатусе)

	ШапкаЗаказа = СтрокаЗаголовка.Шапка;
	ИдентификаторЗаказа = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ШапкаЗаказа, "orderId")));
	НомерНаСайте = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ШапкаЗаказа, "num")));
	Если Не ЗначениеЗаполнено(НомерНаСайте) Или Не ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
		Возврат Истина;
	КонецЕсли;

	СтатусыЗаказа = СтатусыПоЗаказам.Получить(ИдентификаторЗаказа);
	СтрокиЗаказа = СтрокиПоЗаказам.Получить(ИдентификаторЗаказа);
	ПоследнийСтатус = ПоследнийСтатусЗаголовка(СтатусыЗаказа);
	СуществующийЗаказ = эв_ОбменСПорталамиСервер.НайтиЗаказПоНомеруНаСайте(НомерНаСайте, Источник);

	Если ЗначениеЗаполнено(СуществующийЗаказ) Тогда
		Если ПоследнийСтатус.Код = 111 Тогда
			ОтменитьЗаказПокупателем(СуществующийЗаказ, Источник, ПоследнийСтатус.Комментарий);
		ИначеЕсли ПоследнийСтатус.Код = 110 Тогда
			ПрименитьСтатусВыкупа(СуществующийЗаказ, Источник);
		ИначеЕсли ПоследнийСтатус.Код = 108 Тогда
			ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
				СтрШаблон("Заказ %1 отредактирован на сайте. Строки уже созданного заказа не перезаписываются", НомерНаСайте));
		КонецЕсли;
		ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, СуществующийЗаказ, НомерНаСайте, Ложь);
		Возврат Истина;
	КонецЕсли;

	Если ПоследнийСтатус.Код = 111 Тогда
		Возврат Истина;
	КонецЕсли;

	ДанныеЗаказа = РазобратьЗаказ(ШапкаЗаказа, ПоследнийСтатус, СтрокиЗаказа, ИдентификаторЗаказа, НомерНаСайте);
	Если ДанныеЗаказа.Товары.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			СтрШаблон("Заказ %1 не создан: нет строк с номенклатурой по связке nnt", НомерНаСайте));
		Возврат Истина;
	КонецЕсли;

	Попытка
		ЗаказСсылка = эв_ОбменСПорталамиСервер.СоздатьЗаказПортала(Источник, НастройкиAPI, ДанныеЗаказа);
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			СтрШаблон("Ошибка создания заказа %1: %2", НомерНаСайте, ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, ЗаказСсылка, НомерНаСайте, Истина);
	ПоставитьНовыйЗаказВОчереди(ЗаказСсылка, Источник, СостояниеПринято, ПоследнийСтатус.ДатаРезерва, ПредупреждениеОСтатусе);
	Если ПоследнийСтатус.Код = 110 Тогда
		ПрименитьСтатусВыкупа(ЗаказСсылка, Источник);
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция РазобратьЗаказ(ШапкаЗаказа, СтатусЗаказа, СтрокиЗаказа, ИдентификаторЗаказа, НомерНаСайте)

	ФИО = РазобратьФИО(СтрокаИзJSON(ЗначениеПоляJSON(ШапкаЗаказа, "name")));
	Доставка = ИнформацияДоставки(ШапкаЗаказа);
	НужнаДоставка = ЗначениеПоляJSON(ШапкаЗаказа, "delivery") = Истина;

	Комментарий = СтатусЗаказа.Комментарий;
	Если ЗначениеЗаполнено(Доставка.Комментарий) Тогда
		Комментарий = СокрЛП(Комментарий + " " + Доставка.Комментарий);
	КонецЕсли;

	Телефон = ПривестиТелефон(СтрокаИзJSON(ЗначениеПоляJSON(ШапкаЗаказа, "mPhone")));
	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Телефон = ПривестиТелефон(Доставка.Телефон);
	КонецЕсли;

	ПакетЗаказа = Новый Структура;
	Заголовки = Новый Массив;
	Заголовки.Добавить(ШапкаЗаказа);
	ПакетЗаказа.Вставить("headers", Заголовки);
	ПакетЗаказа.Вставить("rows", ?(ТипЗнч(СтрокиЗаказа) = Тип("Массив"), СтрокиЗаказа, Новый Массив));
	ПакетЗаказа.Вставить("statuses", Новый Массив);

	ТекстЗаказа = "";
	Попытка
		ТекстЗаказа = КоннекторHTTP.ОбъектВJson(ПакетЗаказа);
	Исключение
		ТекстЗаказа = "";
	КонецПопытки;

	ДанныеЗаказа = Новый Структура;
	ДанныеЗаказа.Вставить("НомерНаСайте", НомерНаСайте);
	ДанныеЗаказа.Вставить("ИдентификаторНаПортале", ИдентификаторЗаказа);
	ДанныеЗаказа.Вставить("Дата", ДатаИзJSON(ЗначениеПоляJSON(ШапкаЗаказа, "date")));
	ДанныеЗаказа.Вставить("Фамилия", ФИО.Фамилия);
	ДанныеЗаказа.Вставить("Имя", ФИО.Имя);
	ДанныеЗаказа.Вставить("Отчество", ФИО.Отчество);
	ДанныеЗаказа.Вставить("Почта", Доставка.Почта);
	ДанныеЗаказа.Вставить("Телефон", Телефон);
	ДанныеЗаказа.Вставить("Комментарий", Комментарий);
	ДанныеЗаказа.Вставить("ИсходныйПакетJSON", ТекстЗаказа);
	ДанныеЗаказа.Вставить("Товары", Новый Массив);
	ДанныеЗаказа.Вставить("ОплаченНаПортале", СтатусЗаказа.Код = 110);
	Если НужнаДоставка Тогда
		ДанныеЗаказа.Вставить("СпособДоставки", Перечисления.СпособыДоставки.Курьер);
		ДанныеЗаказа.Вставить("АдресДоставки", ?(ЗначениеЗаполнено(Доставка.Адрес), Доставка.Адрес, "Доставка"));
	Иначе
		ДанныеЗаказа.Вставить("СпособДоставки", Перечисления.СпособыДоставки.Самовывоз);
		ДанныеЗаказа.Вставить("АдресДоставки", "Самовывоз");
	КонецЕсли;

	Если ТипЗнч(СтрокиЗаказа) <> Тип("Массив") Тогда
		Возврат ДанныеЗаказа;
	КонецЕсли;

	КэшСерийныхВидов = Новый Соответствие;
	Для Каждого СтрокаПортала Из СтрокиЗаказа Цикл

		Номенклатура = НоменклатураПоКодуАСНА(ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "nnt")));
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		Цена = ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "prc"));
		Если Цена <= 0 Тогда
			Цена = ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "prcDsc"));
		КонецЕсли;

		СтрокаТовара = Новый Структура;
		СтрокаТовара.Вставить("ИдПозиции", СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(СтрокаПортала, "rowId"))));
		СтрокаТовара.Вставить("ИдТовара", Формат(ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "nnt")), "ЧГ="));
		СтрокаТовара.Вставить("ИмяТовара", Формат(ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "nnt")), "ЧГ="));
		СтрокаТовара.Вставить("Номенклатура", Номенклатура);
		СтрокаТовара.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		СтрокаТовара.Вставить("Количество", ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "qnt")));
		СтрокаТовара.Вставить("Цена", Цена);
		СтрокаТовара.Вставить("Серия", "");
		ДобавитьСтрокиТовараЗаказа(ДанныеЗаказа.Товары, СтрокаТовара, КэшСерийныхВидов);

	КонецЦикла;

	Возврат ДанныеЗаказа;

КонецФункции

Процедура ПоставитьНовыйЗаказВОчереди(ЗаказПокупателя, Источник, СостояниеПринято, ДатаРезерва, ПредупреждениеОСтатусе)

	Если Не ЗначениеЗаполнено(СостояниеПринято) Тогда
		Если Не ПредупреждениеОСтатусе Тогда
			ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
				"Не найден код статуса 200 в регистре кодов статусов портала");
			ПредупреждениеОСтатусе = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ДатаОкончания = ДатаРезерва;
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = Неопределено;
	КонецЕсли;

	НовыеЗаказы = Новый Массив;
	НовыеЗаказы.Добавить(Новый Структура("ЗаказПокупателя", ЗаказПокупателя));
	
	ДанныеКомплектуется = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "6");
	СостояниеЗаказа = ДанныеКомплектуется.ВидСтатуса;
	Если ЗначениеЗаполнено(СостояниеЗаказа) Тогда
    	эв_ОбменСПорталамиСервер.ПоставитьЗаказыВОчередьУстановкиСтатусаКомплектуется(НовыеЗаказы, СостояниеЗаказа);
	КонецЕсли;
	
	эв_ОбменСПорталамиСервер.ПоставитьЗаказВОчередьСтатусов(ЗаказПокупателя, Источник, СостояниеПринято, ДатаОкончания, Истина);

КонецПроцедуры

Процедура ОтменитьЗаказПокупателем(ЗаказПокупателя, Источник, Комментарий)

	Попытка
		эв_ОбменСПорталамиСервер.ОтменитьЗаказПортала(
			ЗаказПокупателя, Источник, Справочники.ПричиныОтменыЗаказа.ОтмененКлиентом, Комментарий);
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			СтрШаблон("Ошибка отмены заказа: %1", ОписаниеОшибки()));
		Возврат;
	КонецПопытки;

	СостояниеОтмены = эв_ОбменСПорталамиСервер.СостояниеОтменыЗаказа();
	Если ЗначениеЗаполнено(СостояниеОтмены) Тогда
		эв_ОбменСПорталамиСервер.ПоставитьЗаказВОчередьСтатусов(ЗаказПокупателя, Источник, СостояниеОтмены, , Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура ПрименитьСтатусВыкупа(ЗаказПокупателя, Источник)

	ДанныеВыкупа = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "110");
	Если Не ЗначениеЗаполнено(ДанныеВыкупа.ВидСтатуса) Тогда
		ДанныеВыкупа = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "210");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеВыкупа.ВидСтатуса) Тогда
		Возврат;
	КонецЕсли;

	Заказы = Новый Массив;
	Заказы.Добавить(Новый Структура("ЗаказПокупателя", ЗаказПокупателя));
	эв_ОбменСПорталамиСервер.ПоставитьЗаказыВОчередьУстановкиСтатусаКомплектуется(Заказы, ДанныеВыкупа.ВидСтатуса);
	эв_ОбменСПорталамиСервер.ПоставитьЗаказВОчередьСтатусов(ЗаказПокупателя, Источник, ДанныеВыкупа.ВидСтатуса, , Истина);

КонецПроцедуры

Процедура ПрименитьСтатусыБезЗаголовков(Источник, СтатусыПоЗаказам, ОбработанныеЗаказы, ТаблицаЗагруженных)

	Для Каждого ЭлементСтатуса Из СтатусыПоЗаказам Цикл

		Если ОбработанныеЗаказы.Получить(ЭлементСтатуса.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПоследнийСтатус = ПоследнийСтатусЗаголовка(ЭлементСтатуса.Значение);
		Если ПоследнийСтатус.Код <> 111 И ПоследнийСтатус.Код <> 110 Тогда
			Продолжить;
		КонецЕсли;

		ДанныеЗаказа = ЗаказПоИдентификаторуПортала(ЭлементСтатуса.Ключ);
		Если Не ЗначениеЗаполнено(ДанныеЗаказа.ЗаказПокупателя) Тогда
			Продолжить;
		КонецЕсли;

		Если ПоследнийСтатус.Код = 111 Тогда
			ОтменитьЗаказПокупателем(ДанныеЗаказа.ЗаказПокупателя, Источник, ПоследнийСтатус.Комментарий);
		Иначе
			ПрименитьСтатусВыкупа(ДанныеЗаказа.ЗаказПокупателя, Источник);
		КонецЕсли;
		ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, ДанныеЗаказа.ЗаказПокупателя, ДанныеЗаказа.НомерНаСайте, Ложь);

	КонецЦикла;

КонецПроцедуры

Функция ЗаказПоИдентификаторуПортала(ИдентификаторЗаказа)

	Результат = Новый Структура("ЗаказПокупателя, НомерНаСайте", Документы.ЗаказПокупателя.ПустаяСсылка(), "");
	Если Не ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказыСайта.ЗаказПокупателя КАК ЗаказПокупателя,
		|	ЗаказыСайта.НомерЗаказаНаСайте КАК НомерНаСайте
		|ИЗ
		|	РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыСайта
		|ГДЕ
		|	ЗаказыСайта.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторЗаказа);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ЗаказПокупателя = Выборка.ЗаказПокупателя;
		Результат.НомерНаСайте = СокрЛП(Выборка.НомерНаСайте);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СтрокиНезарезервированного(ЗаказПокупателя, ИдентификаторЗаказа)

	Результат = Новый Структура("Строки, ПолныйОтказ", Новый Массив, Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказыСайта.эв_ИсходныйПакет КАК ИсходныйПакет
		|ИЗ
		|	РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыСайта
		|ГДЕ
		|	ЗаказыСайта.ЗаказПокупателя = &ЗаказПокупателя
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Запасы.эв_ИдентификаторПозицииПортала КАК ИдПозиции,
		|	СУММА(Запасы.Количество) КАК Количество
		|ИЗ
		|	Документ.ЗаказПокупателя.Запасы КАК Запасы
		|ГДЕ
		|	Запасы.Ссылка = &ЗаказПокупателя
		|
		|СГРУППИРОВАТЬ ПО
		|	Запасы.эв_ИдентификаторПозицииПортала";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);

	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаПакета = Результаты[0].Выбрать();
	Если Не ВыборкаПакета.Следующий() Или ВыборкаПакета.ИсходныйПакет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстПакета = ВыборкаПакета.ИсходныйПакет.Получить();
	Если ТипЗнч(ТекстПакета) <> Тип("Строка") Или Не ЗначениеЗаполнено(ТекстПакета) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ПакетJSON = КоннекторHTTP.JsonВОбъект(ТекстПакета);
	Исключение
		Возврат Результат;
	КонецПопытки;

	СтрокиПортала = ЗначениеПоляJSON(ПакетJSON, "rows");
	Если ТипЗнч(СтрокиПортала) <> Тип("Массив") Или СтрокиПортала.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	КоличествоПоПозициям = Новый Соответствие;
	ВыборкаСтрок = Результаты[1].Выбрать();
	Пока ВыборкаСтрок.Следующий() Цикл
		ИдПозиции = ?(СокрЛП(ВыборкаСтрок.ИдПозиции) = "","0",СокрЛП(ВыборкаСтрок.ИдПозиции));
		КоличествоПоПозициям.Вставить(ИдПозиции, ВыборкаСтрок.Количество);
	КонецЦикла;

	ЕстьЗарезервированное = Ложь;
	ЕстьСтрокиЗаказа = Ложь;
	Для Каждого СтрокаПортала Из СтрокиПортала Цикл
		Если СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(СтрокаПортала, "orderId"))) <> ИдентификаторЗаказа
			И ЗначениеЗаполнено(ЗначениеПоляJSON(СтрокаПортала, "orderId")) Тогда
			Продолжить;
		КонецЕсли;

		ИдПозиции = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(СтрокаПортала, "rowId")));
		Если Не ЗначениеЗаполнено(ИдПозиции) Тогда
			Продолжить;
		КонецЕсли;
		ЕстьСтрокиЗаказа = Истина;
		КоличествоПортала = ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "qnt"));
		КоличествоФакт = КоличествоПоПозициям.Получить(ИдПозиции);
		Если КоличествоФакт = Неопределено Тогда
			КоличествоФакт = 0;
		КонецЕсли;
		Если КоличествоФакт > 0 Тогда
			ЕстьЗарезервированное = Истина;
		КонецЕсли;

		Незарезервировано = КоличествоПортала - КоличествоФакт;
		Если Незарезервировано <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаСборки = Новый Структура;
		СтрокаСборки.Вставить("rowId", ИдПозиции);
		СтрокаСборки.Вставить("qntUnrsv", Незарезервировано);
		Результат.Строки.Добавить(СтрокаСборки);
	КонецЦикла;

	Результат.ПолныйОтказ = ЕстьСтрокиЗаказа И Не ЕстьЗарезервированное;
	Возврат Результат;

КонецФункции

Функция ТаблицаЗаголовковЗаказов(ЗаголовкиЗаказов)

	ТаблицаЗаголовков = Новый ТаблицаЗначений;
	ТаблицаЗаголовков.Колонки.Добавить("ОтметкаВремени", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	ТаблицаЗаголовков.Колонки.Добавить("Шапка");

	Для Каждого ШапкаЗаказа Из ЗаголовкиЗаказов Цикл
		СтрокаТаблицы = ТаблицаЗаголовков.Добавить();
		СтрокаТаблицы.ОтметкаВремени = ОтметкаВремениОбъекта(ШапкаЗаказа);
		СтрокаТаблицы.Шапка = ШапкаЗаказа;
	КонецЦикла;

	Возврат ТаблицаЗаголовков;

КонецФункции

Функция ИндексПоЗаказу(МассивОбъектов)

	Индекс = Новый Соответствие;
	Если ТипЗнч(МассивОбъектов) <> Тип("Массив") Тогда
		Возврат Индекс;
	КонецЕсли;

	Для Каждого Элемент Из МассивОбъектов Цикл
		ИдентификаторЗаказа = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(Элемент, "orderId")));
		Если Не ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
			Продолжить;
		КонецЕсли;
		Список = Индекс.Получить(ИдентификаторЗаказа);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Индекс.Вставить(ИдентификаторЗаказа, Список);
		КонецЕсли;
		Список.Добавить(Элемент);
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция ПоследнийСтатусЗаголовка(СтатусыЗаказа)

	Результат = Новый Структура("Код, Комментарий, ДатаРезерва", 0, "", Дата(1, 1, 1));
	Если ТипЗнч(СтатусыЗаказа) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	ТаблицаСтатусов = Новый ТаблицаЗначений;
	ТаблицаСтатусов.Колонки.Добавить("ОтметкаВремени", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	ТаблицаСтатусов.Колонки.Добавить("ДатаСтатуса", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	ТаблицаСтатусов.Колонки.Добавить("Статус");

	Для Каждого СтатусЗаказа Из СтатусыЗаказа Цикл
		Если ЗначениеЗаполнено(ЗначениеПоляJSON(СтатусЗаказа, "rowId")) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = ТаблицаСтатусов.Добавить();
		СтрокаТаблицы.ОтметкаВремени = ОтметкаВремениОбъекта(СтатусЗаказа);
		СтрокаТаблицы.ДатаСтатуса = СтрокаИзJSON(ЗначениеПоляJSON(СтатусЗаказа, "date"));
		СтрокаТаблицы.Статус = СтатусЗаказа;
	КонецЦикла;

	Если ТаблицаСтатусов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ТаблицаСтатусов.Сортировать("ОтметкаВремени, ДатаСтатуса");
	Последний = ТаблицаСтатусов[ТаблицаСтатусов.Количество() - 1].Статус;
	Результат.Код = ЧислоИзJSON(ЗначениеПоляJSON(Последний, "status"));
	Результат.Комментарий = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(Последний, "cmnt")));
	Результат.ДатаРезерва = ДатаИзJSON(ЗначениеПоляJSON(Последний, "rcDate"), Истина);
	Возврат Результат;


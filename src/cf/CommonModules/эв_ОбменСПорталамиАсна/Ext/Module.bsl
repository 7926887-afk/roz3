Процедура ВыгрузитьКаталогИсточника(Источник, НастройкиAPI)

	Если Не ЗначениеЗаполнено(НастройкиAPI.Склад) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Каталог не отправлен: у источника не заполнен склад");
		Возврат;
	КонецЕсли;

	Если Не ПолеЗаполнено(НастройкиAPI, "АдресФТП")
		Или Не ПолеЗаполнено(НастройкиAPI, "ЛогинФТП")
		Или Не ПолеЗаполнено(НастройкиAPI, "ПарольФТП") Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Каталог не отправлен: не заполнены настройки FTP");
		Возврат;
	КонецЕсли;

	ИмяФайла = СформироватьФайлКаталога(Источник, НастройкиAPI.Склад);
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОтправитьФайлНаФТП(НастройкиAPI, ИмяФайла, "nomenclature.dbf");
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Информация, , Источник,
			"Каталог номенклатуры отправлен на FTP");
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			СтрШаблон("Ошибка отправки каталога на FTP: %1", ОписаниеОшибки()));
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);

КонецПроцедуры

Функция СформироватьФайлКаталога(Источник, Склад)

	ТаблицаКаталога = ТаблицаКаталога(Склад);
	ИмяФайла = КаталогВременныхФайлов() + "tempdb.dbf";
	УдалитьФайлы(ИмяФайла);

	ФайлДБФ = Новый XBase;
	ФайлДБФ.Кодировка = КодировкаXBase.ANSI;
	ФайлДБФ.Поля.Добавить("ID", "S", 36);
	ФайлДБФ.Поля.Добавить("Name", "S", 100);
	ФайлДБФ.Поля.Добавить("Producer", "S", 150);
	ФайлДБФ.Поля.Добавить("Country", "S", 60);
	ФайлДБФ.Поля.Добавить("EAN", "S", 150);

	Попытка
		ФайлДБФ.СоздатьФайл(ИмяФайла);
		Штрихкоды = ШтрихкодыКаталога(ТаблицаКаталога);
		Записано = 0;
		Для Каждого СтрокаКаталога Из ТаблицаКаталога Цикл
			Производитель = СокрЛП(СтрокаКаталога.Производитель);
			ШтрихкодыПозиции = Штрихкоды.Получить(СтрокаКаталога.Номенклатура);
			Если ШтрихкодыПозиции = Неопределено Или ШтрихкодыПозиции.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(Производитель) Тогда
				Продолжить;
			КонецЕсли;

			ФайлДБФ.Добавить();
			ФайлДБФ.ID = Лев(XMLСтрока(СтрокаКаталога.Номенклатура), 36);
			ФайлДБФ.Name = Лев(СокрЛП(СтрокаКаталога.Наименование), 100);
			ФайлДБФ.Producer = Лев(Производитель, 150);
			ФайлДБФ.Country = Лев(СокрЛП(СтрокаКаталога.Страна), 60);
			ФайлДБФ.EAN = Лев(СтрСоединить(ШтрихкодыПозиции, ","), 150);
			ФайлДБФ.Записать();
			Записано = Записано + 1;
		КонецЦикла;
		ФайлДБФ.ЗакрытьФайл();
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Ошибка, , Источник,
			СтрШаблон("Ошибка формирования каталога: %1", ОписаниеОшибки()));
		Попытка
			ФайлДБФ.ЗакрытьФайл();
		Исключение
		КонецПопытки;
		УдалитьФайлы(ИмяФайла);
		Возврат "";
	КонецПопытки;

	Если Записано = 0 Тогда
		УдалитьФайлы(ИмяФайла);
		ЗаписьЖурналаРегистрации("Обмен с порталами.АСНА", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Каталог пуст: нет позиций с производителем и штрихкодом");
		Возврат "";
	КонецЕсли;

	Возврат ИмяФайла;

КонецФункции

Функция ТаблицаКаталога(Склад)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(ЕСТЬNULL(Остатки.Номенклатура.Наименование, """")) КАК Наименование,
		|	МАКСИМУМ(ЕСТЬNULL(Остатки.Номенклатура.ор_Производитель.Наименование, """")) КАК Производитель,
		|	МАКСИМУМ(ЕСТЬNULL(Остатки.Номенклатура.СтранаПроисхождения.Наименование, """")) КАК Страна
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, СтруктурнаяЕдиница = &Склад) КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура";
	Запрос.УстановитьПараметр("Склад", Склад);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ШтрихкодыКаталога(ТаблицаКаталога)

	Результат = Новый Соответствие;
	Если ТаблицаКаталога.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Штрихкоды.Номенклатура КАК Номенклатура,
		|	Штрихкоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Номенклатура В (&Номенклатура)
		|	И Штрихкоды.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|	И (ДЛИНАСТРОКИ(Штрихкоды.Штрихкод) = 12
		|		ИЛИ ДЛИНАСТРОКИ(Штрихкоды.Штрихкод) = 13)";
	Запрос.УстановитьПараметр("Номенклатура", ТаблицаКаталога.ВыгрузитьКолонку("Номенклатура"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Штрихкод = СокрЛП(Выборка.Штрихкод);
		Если СтрДлина(Штрихкод) <> 12 И СтрДлина(Штрихкод) <> 13 Тогда
			Продолжить;
		КонецЕсли;
		Список = Результат.Получить(Выборка.Номенклатура);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Выборка.Номенклатура, Список);
		КонецЕсли;
		Если Список.Найти(Штрихкод) = Неопределено Тогда
			Список.Добавить(Штрихкод);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ОтправитьФайлНаФТП(НастройкиAPI, ИмяЛокальногоФайла, ИмяНаСервере)

	ПараметрыФТП = РазобратьАдресФТП(НастройкиAPI.АдресФТП);
	Соединение = Новый FTPСоединение(
		ПараметрыФТП.Сервер,
		ПараметрыФТП.Порт,
		СокрЛП(НастройкиAPI.ЛогинФТП),
		СокрЛП(НастройкиAPI.ПарольФТП),
		,
		Истина,
		120);
	Соединение.Записать(ИмяЛокальногоФайла, ПараметрыФТП.Путь + ИмяНаСервере);

КонецПроцедуры

Функция РазобратьАдресФТП(Адрес)

	Текст = СокрЛП(Адрес);
	Если СтрНачинаетсяС(НРег(Текст), "ftp://") Тогда
		Текст = Сред(Текст, 7);
	КонецЕсли;

	ПозицияСлеша = СтрНайти(Текст, "/");
	Хост = Текст;
	Путь = "/";
	Если ПозицияСлеша > 0 Тогда
		Хост = Лев(Текст, ПозицияСлеша - 1);
		Путь = Сред(Текст, ПозицияСлеша);
		Если Не СтрЗаканчиваетсяНа(Путь, "/") Тогда
			Путь = Путь + "/";
		КонецЕсли;
	КонецЕсли;

	Порт = 21;
	ПозицияДвоеточия = СтрНайти(Хост, ":");
	Если ПозицияДвоеточия > 0 Тогда
		ОписаниеПорта = Сред(Хост, ПозицияДвоеточия + 1);
		Хост = Лев(Хост, ПозицияДвоеточия - 1);
		Попытка
			Порт = Число(ОписаниеПорта);
		Исключение
			Порт = 21;
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("Сервер, Порт, Путь", Хост, Порт, Путь);

КонецФункции

Процедура ДобавитьСтрокиТовараЗаказа(Товары, СтрокаТовара, КэшСерийныхВидов)

	КоличествоШтук = Цел(СтрокаТовара.Количество);
	Если КоличествоШтук < 2
		Или СтрокаТовара.Количество <> КоличествоШтук
		Или Не эв_ОбменСПорталамиСервер.ТоварКатегорииСерийный(СтрокаТовара.Номенклатура, КэшСерийныхВидов) Тогда
		Товары.Добавить(СтрокаТовара);
		Возврат;
	КонецЕсли;

	СуммаКопеек = Окр(Окр(СтрокаТовара.Цена * СтрокаТовара.Количество, 2) * 100, 0);
	ЦенаКопеек = Цел(СуммаКопеек / КоличествоШтук);
	ОстатокКопеек = СуммаКопеек - ЦенаКопеек * КоличествоШтук;

	Для Номер = 1 По КоличествоШтук Цикл
		КопеекСтроки = ЦенаКопеек;
		Если Номер > КоличествоШтук - ОстатокКопеек Тогда
			КопеекСтроки = КопеекСтроки + 1;
		КонецЕсли;
		Товары.Добавить(КопияСтрокиТовара(СтрокаТовара, 1, КопеекСтроки / 100));
	КонецЦикла;

КонецПроцедуры

Функция КопияСтрокиТовара(СтрокаТовара, Количество, Цена)

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из СтрокаТовара Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Копия.Количество = Количество;
	Копия.Цена = Цена;
	Возврат Копия;

КонецФункции

Функция РазобратьФИО(ПолноеИмя)

	Результат = Новый Структура("Имя, Фамилия, Отчество", "", "", "");
	ЧастиИмени = СтрРазделить(СокрЛП(ПолноеИмя), " ", Ложь);
	Если ЧастиИмени.Количество() > 0 Тогда
		Результат.Имя = ЧастиИмени[0];
	КонецЕсли;
	Если ЧастиИмени.Количество() > 1 Тогда
		Результат.Фамилия = ЧастиИмени[1];
	КонецЕсли;
	Если ЧастиИмени.Количество() > 2 Тогда
		ОтчествоЧасти = Новый Массив;
		Для Индекс = 2 По ЧастиИмени.Количество() - 1 Цикл
			ОтчествоЧасти.Добавить(ЧастиИмени[Индекс]);
		КонецЦикла;
		Результат.Отчество = СтрСоединить(ОтчествоЧасти, " ");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПривестиТелефон(Телефон)

	Цифры = "";
	Для НомерСимвола = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, НомерСимвола, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) = 11 И Лев(Цифры, 1) = "8" Тогда
		Цифры = "7" + Сред(Цифры, 2);
	ИначеЕсли СтрДлина(Цифры) = 10 Тогда
		Цифры = "7" + Цифры;
	КонецЕсли;

	Возврат Цифры;

КонецФункции


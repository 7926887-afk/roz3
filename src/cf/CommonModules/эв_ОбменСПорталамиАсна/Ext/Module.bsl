Функция СтрокаИзJSON(ЗначениеПоля)

	Если ЗначениеПоля = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(ЗначениеПоля));

КонецФункции

Функция ЧислоИзJSON(ЗначениеПоля)

	Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
		Возврат ЗначениеПоля;
	КонецЕсли;
	Попытка
		Возврат Число(ЗначениеПоля);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ДатаИзJSON(ЗначениеПоля, ПустаяЕслиНет = Ложь)

	Если ТипЗнч(ЗначениеПоля) = Тип("Дата") Тогда
		Возврат ЗначениеПоля;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
		Если ПустаяЕслиНет Тогда
			Возврат Дата(1, 1, 1);
		КонецЕсли;
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;
	Попытка
		Возврат ПрочитатьДатуJSON(Строка(ЗначениеПоля), ФорматДатыJSON.ISO);
	Исключение
		Если ПустаяЕслиНет Тогда
			Возврат Дата(1, 1, 1);
		КонецЕсли;
		Возврат ТекущаяДатаСеанса();
	КонецПопытки;

КонецФункции


		|	Логи.Период УБЫВ";
	Запрос.УстановитьПараметр("ИсточникЗаказов", Источник);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Адрес) Тогда
		Возврат СокрЛП(Выборка.Адрес);
	КонецЕсли;

	Возврат эв_ОбменСПорталамиСервер.ДатаISOСмещением(Дата(2026, 10, 1));


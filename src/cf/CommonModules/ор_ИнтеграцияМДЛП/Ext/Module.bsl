	Запрос.УстановитьПараметр("СтруктурнаяЕдиница"           , СтруктураОрганизации.МестоДеятельности);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеЗапасов КАК Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОВыбытииМДЛП КАК Уведомление
	|		ПО Документ.Ссылка = Уведомление.Основание
	|ГДЕ
	|	Уведомление.Ссылка ЕСТЬ NULL
	|	И НЕ Документ.ПометкаУдаления
	|	И Документ.Проведен
	|	И Документ.Организация = &Организация
	|	И ВЫБОР
	|			КОГДА &ИспользоватьМестаДеятельности
	|				ТОГДА Документ.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|						ИЛИ &СтруктурнаяЕдиница = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МассивДокументов = Новый Массив;
	
	Для Каждого Строка Из Результат Цикл
		МассивДокументов.Добавить(Строка.Ссылка);
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

Функция ПолучитьСписокВыбораДляСвязыванияУведомленияОбОприходованииМДЛП(СтруктураПараметров) Экспорт
	
	ОрганизацияМДЛП       = СтруктураПараметров.ОрганизацияМДЛП;
	МестоДеятельностиМДЛП = СтруктураПараметров.МестоДеятельностиМДЛП;
	
	СтруктураОрганизации  = ПолучитьОрганизациюИМестоДеятельности(ОрганизацияМДЛП, МестоДеятельностиМДЛП, Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"                  , СтруктураОрганизации.Организация);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница"           , СтруктураОрганизации.МестоДеятельности);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОприходованиеЗапасов КАК Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОприходованииМДЛП КАК Уведомление
	|		ПО Документ.Ссылка = Уведомление.Основание
	|ГДЕ
	|	Уведомление.Ссылка ЕСТЬ NULL
	|	И НЕ Документ.ПометкаУдаления
	|	И Документ.Проведен
	|	И Документ.Организация = &Организация
	|	И ВЫБОР
	|			КОГДА &ИспользоватьМестаДеятельности
	|				ТОГДА Документ.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|						ИЛИ &СтруктурнаяЕдиница = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МассивДокументов = Новый Массив;
	
	Для Каждого Строка Из Результат Цикл
		МассивДокументов.Добавить(Строка.Ссылка);
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

Функция ПолучитьСписокВыбораДляСвязыванияИнвентаризацияПотребительскихУпаковокМДЛП(СтруктураПараметров) Экспорт
	

	|ИЗ
	|	втТовары КАК втТовары";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка                      = Результат[0].Выгрузить();
	РезультатТовары                     = Результат[2].Выгрузить();
	РезультатНомера                     = Результат[3].Выгрузить();
	
	Шапка = РезультатШапка[0];
	
	ДокументОбъект.НомерВходящегоДокумента = Шапка.НомерВходящегоДокумента;
	ДокументОбъект.ДатаВходящегоДокумента  = Шапка.ДатаВходящегоДокумента;
	
	СтруктураОрганизации = ПолучитьОрганизациюИМестоДеятельности(Шапка.ОрганизацияМДЛП, Шапка.МестоДеятельностиМДЛП, Истина);
	
	ДокументОбъект.Организация        = СтруктураОрганизации.Организация;
	ДокументОбъект.СтруктурнаяЕдиница = СтруктураОрганизации.МестоДеятельности;
	ДокументОбъект.СуммаВключаетНДС   = Истина;
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;
	
	НуженПересчетКоличества = Ложь;
	Для Каждого Строка Из РезультатТовары Цикл
		НоваяСтрока = ДокументОбъект.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Количество = Строка.КоличествоУпаковок;
		
		Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура.ВидСтавкиНДС) Тогда
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(НоваяСтрока.Номенклатура.ВидСтавкиНДС, ТекущаяДатаСеанса());
		Иначе
			Если ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
				НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(ДокументОбъект.Организация.ВидСтавкиНДСПоУмолчанию, ТекущаяДатаСеанса());
			КонецЕсли;
		КонецЕсли;
		
		Если Строка.Количество <> Строка.КоличествоНомеров Тогда
			НоваяСтрока.Количество = Строка.КоличествоНомеров/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.ЕдиницаИзмерения);
			
			НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
			СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
			
			НоваяСтрока.СуммаНДС = ?(ДокументОбъект.СуммаВключаетНДС, 
				НоваяСтрока.Сумма - (НоваяСтрока.Сумма) / ((СтавкаНДС + 100) / 100),
				НоваяСтрока.Сумма * СтавкаНДС / 100);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.ор_НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
КонецПроцедуры


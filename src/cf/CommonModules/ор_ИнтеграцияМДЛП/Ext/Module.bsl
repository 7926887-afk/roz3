		|ИЗ
		|	Документ.УведомлениеОПеремещенииМДЛП.ТранспортныеУпаковки КАК ОформленныеТранспортныеУпаковки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
		|		ПО (ОформленныеДокументы.Ссылка = ОформленныеТранспортныеУпаковки.Ссылка)
		|ГДЕ
		|	НЕ ОформленныеТранспортныеУпаковки.Отклонено
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки
		|ИЗ
		|	ТоварыКОформлению КАК ТоварыКОформлению
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыКОформлению.НомерУпаковки";
		
	ИначеЕсли МетаданныеУведомления = Метаданные.Документы.УведомлениеОПовторномВводеВОборотМДЛП
		ИЛИ МетаданныеУведомления = Метаданные.Документы.УведомлениеОРозничнойПродажеМДЛП Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаДокументы.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ОформленныеДокументы
		|ИЗ
		|	Документ.УведомлениеОПовторномВводеВОборотМДЛП КАК ТаблицаДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
		|		ПО (Статусы.Документ = ТаблицаДокументы.Ссылка)
		|ГДЕ
		|	ТаблицаДокументы.Основание = &ДокументОснование
		|	И НЕ ТаблицаДокументы.ПометкаУдаления
		|	И НЕ(ТаблицаДокументы.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
		|				И Статусы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.Закрыто))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОформленныеУпаковки.НомерКиЗ КАК НомерУпаковки
		|ПОМЕСТИТЬ ТоварыКОформлению
		|ИЗ
		|	Документ.УведомлениеОПовторномВводеВОборотМДЛП.НомераУпаковок КАК ОформленныеУпаковки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПовторномВводеВОборотМДЛП.Товары КАК ОформленныеТовары
		|		ПО (ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка)
		|			И (ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
		|		ПО (ОформленныеДокументы.Ссылка = ОформленныеТовары.Ссылка)
		|ГДЕ
		|	НЕ ОформленныеУпаковки.Отклонено
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки
		|ИЗ
		|	ТоварыКОформлению КАК ТоварыКОформлению
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыКОформлению.НомерУпаковки";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.УведомлениеОПовторномВводеВОборотМДЛП", МетаданныеУведомления.ПолноеИмя());
		
	ИначеЕсли МетаданныеУведомления = Метаданные.Документы.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаДокументы.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ОформленныеДокументы
		|ИЗ
		|	Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП КАК ТаблицаДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
		|		ПО (Статусы.Документ = ТаблицаДокументы.Ссылка)
		|ГДЕ
		|	ТаблицаДокументы.Основание = &ДокументОснование
		|	И НЕ ТаблицаДокументы.ПометкаУдаления
		|	И НЕ ТаблицаДокументы.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОформленныеУпаковки.НомерКиЗ КАК НомерУпаковки
		|ПОМЕСТИТЬ ТоварыКОформлению
		|ИЗ
		|	Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП.НомераУпаковок КАК ОформленныеУпаковки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП.Товары КАК ОформленныеТовары
		|		ПО (ОформленныеТовары.Ссылка = ОформленныеУпаковки.Ссылка)
		|			И (ОформленныеТовары.ИдентификаторСтроки = ОформленныеУпаковки.ИдентификаторСтроки)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОформленныеДокументы КАК ОформленныеДокументы
		|		ПО (ОформленныеДокументы.Ссылка = ОформленныеТовары.Ссылка)
		|ГДЕ
		|	НЕ ОформленныеУпаковки.Отклонено
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыКОформлению.НомерУпаковки КАК НомерУпаковки
		|ИЗ
		|	ТоварыКОформлению КАК ТоварыКОформлению
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыКОформлению.НомерУпаковки";
		
	Иначе
		Возврат СписокНомеровУпаковок;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат СписокНомеровУпаковок;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокНомеровУпаковок.Добавить(Выборка.НомерУпаковки);
	КонецЦикла;
	
	Возврат СписокНомеровУпаковок;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиПроверкиИЗаполнения

Процедура ЗаполнитьПустойИднтификаторСтроки(Объект, ИмяТЧТовары = "Запасы", ИмяРеквизитаИдентификатор = "ор_ИдентификаторСтроки") Экспорт
	
	Для Каждого СтрокаТЧ Из Объект[ИмяТЧТовары] Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизитаИдентификатор]) Тогда
			СтрокаТЧ[ИмяРеквизитаИдентификатор] = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНеиспользуемыеНомераУпаковок(Объект, ИмяТЧТовары = "Запасы", ИмяТЧСерии = "ор_НомераУпаковок") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчНомераУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	ТаблицаНомеровУпаковок КАК тчНомераУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаТоваров КАК тчТовары
	|			ПО тчНомераУпаковок.ИдентификаторСтроки = тчТовары.ор_ИдентификаторСтроки
	|ГДЕ
	|	тчТовары.ор_ИдентификаторСтроки ЕСТЬ NULL
	|	ИЛИ тчТовары.ор_СтатусЗаполненияУпаковок = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	тчНомераУпаковок.ИдентификаторСтроки";
	Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,"ор_ИдентификаторСтроки, ор_СтатусЗаполненияУпаковок"));
	Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Выгрузить(,"ИдентификаторСтроки"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = Объект[ИмяТЧСерии].НайтиСтроки(Новый Структура("ИдентификаторСтроки", Выборка.ИдентификаторСтроки));
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			Объект[ИмяТЧСерии].Удалить(Строка);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьПризнакиЕстьМаркируемаяПродукция(Объект, ИмяТЧТовары = "Запасы", ИмяТЧСерии = "ор_НомераУпаковок", ЗапретитьВводНомеров = Ложь) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ор_ЕстьМаркируемаяПродукция", Ложь);
	
	Если НЕ ЗапретитьВводНомеров Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
		|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
		|ПОМЕСТИТЬ ТаблицаТоваров
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерКИЗ
		|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
		|ИЗ
		|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тчТовары.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки
		|ИЗ
		|	ТаблицаТоваров КАК тчТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
		|		ПО тчТовары.ор_ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
		|ГДЕ
		|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
		|	И НЕ тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL";
		
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,"ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки"));
		
		СтруктураВозврата.ор_ЕстьМаркируемаяПродукция = НЕ Запрос.Выполнить().Пустой();
		
		ЕстьТранспортныеУпаковки = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ор_ТранспортныеУпаковки");
		
		Если ЕстьТранспортныеУпаковки Тогда
			Если Объект.ор_ТранспортныеУпаковки.Количество() > 0 И НЕ СтруктураВозврата.ор_ЕстьМаркируемаяПродукция Тогда
				СтруктураВозврата.ор_ЕстьМаркируемаяПродукция = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Процедура ПроверитьЗаполнениеНомеровУпаковок(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "") Экспорт
	
	КонтролироватьКоличествоНомеровУпаковок = Истина;
	
	ДатаОбъекта = Неопределено;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПриходнаяНакладная")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.РасходнаяНакладная")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.СписаниеЗапасов")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ПеремещениеЗапасов")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ПриходныйОрдер")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.РасходныйОрдер")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ЧекККМ")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ОприходованиеЗапасов")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.КомплектацияЗапасов") Тогда
		Если Объект.Ссылка.Пустая() Тогда
			ДатаОбъекта = ТекущаяДата();
		Иначе
			ДатаОбъекта = Объект.Дата;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("ОбработкаОбъект.РабочееМестоКассира") Тогда
		ДатаОбъекта = Объект.Дата;
	Иначе
		ДатаОбъекта = ТекущаяДата();
	КонецЕсли;
	
	Если ДатаОбъекта < ПолучитьДатуНачалаМаркировкиТоваров() Тогда
		КонтролироватьКоличествоНомеровУпаковок = Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПриходнаяНакладная")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.РасходнаяНакладная") Тогда
		КонтролироватьКоличествоНомеровУпаковок = Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПриходныйОрдер")
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		КонтролироватьКоличествоНомеровУпаковок = Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РасходныйОрдер")
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		КонтролироватьКоличествоНомеровУпаковок = Ложь;
	КонецЕсли;
	
	ЕстьПолеТранспортныеУпаковки = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ор_ТранспортныеУпаковки");
	
	ЕстьТранспортныеУпаковки = Ложь;
	Если ЕстьПолеТранспортныеУпаковки Тогда
		Если Объект.ор_ТранспортныеУпаковки.Количество() > 0 Тогда
			ЕстьТранспортныеУпаковки = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров1
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ТаблицаТоваров.Количество * ТаблицаТоваров.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТаблицаТоваров.Количество
	|	КОНЕЦ КАК Количество,
	|	ТаблицаТоваров.Количество КАК КоличествоУпаковок,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	ТаблицаТоваров1 КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерКИЗ
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.Номенклатура КАК Номенклатура,
	|	тчТовары.Характеристика КАК Характеристика,
	|	тчТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	тчТовары.Количество КАК Количество,
	|	тчТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	СУММА(ВЫБОР
	|			КОГДА тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК КоличествоНомеровУпаковок
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
	|		ПО тчТовары.ор_ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	тчТовары.НомерСтроки,
	|	тчТовары.Номенклатура,
	|	тчТовары.Характеристика,
	|	тчТовары.ЕдиницаИзмерения,
	|	тчТовары.Количество,
	|	тчТовары.КоличествоУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.Номенклатура КАК Номенклатура,
	|	втТаблица.Характеристика КАК Характеристика,
	|	втТаблица.Количество КАК Количество,
	|	втТаблица.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТаблица.КоличествоНомеровУпаковок КАК КоличествоНомеровУпаковок,
	|	втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок,
	|	ВЫБОР
	|		КОГДА втТаблица.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|				И втТаблица.Количество < втТаблица.КоличествоУпаковок
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоБлистер
	|ИЗ
	|	втТаблица КАК втТаблица
	|ГДЕ
	|	ВЫБОР
	|			КОГДА втТаблица.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|					И втТаблица.Количество < втТаблица.КоличествоУпаковок
	|				ТОГДА втТаблица.КоличествоНомеровУпаковок <> 1
	|						ИЛИ втТаблица.КоличествоУпаковок > втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок
	|			ИНАЧЕ втТаблица.Количество <> втТаблица.КоличествоНомеровУпаковок
	|					ИЛИ втТаблица.КоличествоНомеровУпаковок = 0
	|		КОНЕЦ";
	
	СписокКолонок = "НомерСтроки,Номенклатура,Характеристика,ЕдиницаИзмерения,Количество,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок";
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,СписокКолонок));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,СписокКолонок));
	КонецЕсли;
	
	Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки"));
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ШаблонОбщий                    = НСтр("ru = 'В строке ""%НомерСтроки%"" для товара ""%Товар%"" '");
	ШаблонНомерВведенНеправильно   = НСтр("ru = 'указано по номерам упаковок %КоличествоНомеровУпаковок%. Необходимо указать %КоличествоТоваров%. Исправьте номера упаковок.'");
	ШаблонКолБлистеровНеправильное = НСтр("ru = 'указано количество %КоличествоУпаковок%. Максимальное количество %КоличествоПервичныхУпаковок%.'");
	
	Если ВыдаватьСообщения Тогда
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ЭтоБлистер Тогда
				
				Если Выборка.КоличествоУпаковок > Выборка.КоличествоПервичныхУпаковок
					ИЛИ Выборка.КоличествоНомеровУпаковок > 1
					ИЛИ КонтролироватьКоличествоНомеровУпаковок И НЕ ЕстьТранспортныеУпаковки Тогда
					
					ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
					ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
					
					Если Выборка.КоличествоНомеровУпаковок <> 1 Тогда
						ТекстСообщенияТело = СтрЗаменить(ШаблонНомерВведенНеправильно, "%КоличествоНомеровУпаковок%", Выборка.КоличествоНомеровУпаковок);
						ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоТоваров%", 1);
					Иначе
						ТекстСообщенияТело = СтрЗаменить(ШаблонКолБлистеровНеправильное, "%КоличествоУпаковок%",Выборка.КоличествоУпаковок);
						ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоПервичныхУпаковок%",Выборка.КоличествоПервичныхУпаковок);
					КонецЕсли;
					
					ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
					
					Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, Выборка.НомерСтроки, "НомерСтроки");
					
					#Если ТолстыйКлиентОбычноеПриложение Тогда
						Отказ = Истина;
					#Иначе
						ОбщегоНазначения.СообщитьПользователю(
							ТекстСообщения,
							Объект,
							Поле,
							"Объект",
							Отказ);
					#КонецЕсли
					
				КонецЕсли;
				
			Иначе
				
				Если Выборка.Количество < Выборка.КоличествоНомеровУпаковок
					ИЛИ КонтролироватьКоличествоНомеровУпаковок И НЕ ЕстьТранспортныеУпаковки Тогда
					
					ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
					ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
					
					ТекстСообщенияТело = СтрЗаменить(ШаблонНомерВведенНеправильно, "%КоличествоНомеровУпаковок%",Выборка.КоличествоНомеровУпаковок);
					ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоТоваров%",Выборка.Количество);
					
					ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
					
					Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, Выборка.НомерСтроки, "НомерСтроки");
					
					#Если ТолстыйКлиентОбычноеПриложение Тогда
						Отказ = Истина;
					#Иначе
						ОбщегоНазначения.СообщитьПользователю(
							ТекстСообщения,
							Объект,
							Поле,
							"Объект",
							Отказ);
					#КонецЕсли
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		Если Не Запрос.Выполнить().Пустой() Тогда
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ЭтоБлистер Тогда
					
					Если Выборка.КоличествоУпаковок > Выборка.КоличествоПервичныхУпаковок
						ИЛИ Выборка.КоличествоНомеровУпаковок > 1
						ИЛИ КонтролироватьКоличествоНомеровУпаковок И НЕ ЕстьТранспортныеУпаковки Тогда
						
						ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
						ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
						
						Если Выборка.КоличествоНомеровУпаковок <> 1 Тогда
							ТекстСообщенияТело = СтрЗаменить(ШаблонНомерВведенНеправильно, "%КоличествоНомеровУпаковок%", Выборка.КоличествоНомеровУпаковок);
							ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоТоваров%", 1);
						Иначе
							ТекстСообщенияТело = СтрЗаменить(ШаблонКолБлистеровНеправильное, "%КоличествоУпаковок%",Выборка.КоличествоУпаковок);
							ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоПервичныхУпаковок%",Выборка.КоличествоПервичныхУпаковок);
						КонецЕсли;
						
						ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
						
					КонецЕсли;
					
				Иначе
					
					Если Выборка.Количество < Выборка.КоличествоНомеровУпаковок
						ИЛИ КонтролироватьКоличествоНомеровУпаковок И НЕ ЕстьТранспортныеУпаковки Тогда
						
						ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
						ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
						
						ТекстСообщенияТело = СтрЗаменить(ШаблонНомерВведенНеправильно, "%КоличествоНомеровУпаковок%",Выборка.КоличествоНомеровУпаковок);
						ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоТоваров%",Выборка.Количество);
						
						ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
						
						Отказ = Истина;
						Прервать;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДублиНомеровУпаковок(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "") Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерКИЗ
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчНомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	1 КАК Количество
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
	|		ПО тчТовары.ор_ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL";
	
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,"НомерСтроки,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,"НомерСтроки,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	КонецЕсли;
	
	Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки"));
	КонецЕсли;
	
	ТаблицаДублей = Запрос.Выполнить().Выгрузить();
	врТаблицаДублей = ТаблицаДублей.Скопировать();
	врТаблицаДублей.Свернуть("НомерКИЗ","Количество");
	
	Если ВыдаватьСообщения Тогда
		Для Каждого Строка Из врТаблицаДублей Цикл
			Если Строка.Количество > 1 Тогда
				
				НайденныеСтрокиДублейКиз = ТаблицаДублей.НайтиСтроки(Новый Структура("НомерКИЗ", Строка.НомерКИЗ));
				НомерСтрокиДубля = 0;
				Для Каждого СтрокаДубля Из НайденныеСтрокиДублейКиз Цикл
					Если СтрокаДубля.НомерСтроки > НомерСтрокиДубля Тогда
						НомерСтрокиДубля = СтрокаДубля.НомерСтроки;
					КонецЕсли;
				КонецЦикла;
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" дублируется номер упаковки %НомерКИЗ%. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", НомерСтрокиДубля);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерКИЗ%"   , Строка.НомерКИЗ);
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, НомерСтрокиДубля, "НомерСтроки");
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						Объект,
						Поле,
						"Объект",
						Отказ);
				#КонецЕсли
				
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Строка Из врТаблицаДублей Цикл
			Если Строка.Количество > 1 Тогда
				
				НайденныеСтрокиДублейКиз = ТаблицаДублей.НайтиСтроки(Новый Структура("НомерКИЗ", Строка.НомерКИЗ));
				НомерСтрокиДубля = 0;
				Для Каждого СтрокаДубля Из НайденныеСтрокиДублейКиз Цикл
					Если СтрокаДубля.НомерСтроки > НомерСтрокиДубля Тогда
						НомерСтрокиДубля = СтрокаДубля.НомерСтроки;
					КонецЕсли;
				КонецЦикла;
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" дублируется номер упаковки %НомерКИЗ%. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", НомерСтрокиДубля);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерКИЗ%"   , Строка.НомерКИЗ);
				
				Отказ = Истина;
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеТранспортныхУпаковок(Объект,
	Отказ,
	ИмяТЧТУ = "ор_ТранспортныеУпаковки",
	ИмяТЧСоставТУ = "ор_СоставТранспортныхУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "",
	ПроверятьЦенуТУ = Истина) Экспорт
	
	Если ПроверятьЦенуТУ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
		|	ТаблицаТоваров.Цена КАК Цена,
		|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ ТаблицаТоваров
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНомеровУпаковок.ИдентификаторСтроки
		|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
		|ИЗ
		|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тчТовары.НомерСтроки КАК НомерСтроки,
		|	тчТовары.НомерУпаковки КАК НомерУпаковки,
		|	тчТовары.Цена КАК Цена,
		|	СУММА(ВЫБОР
		|			КОГДА тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК КоличествоНомеровУпаковок
		|ПОМЕСТИТЬ втТаблица
		|ИЗ
		|	ТаблицаТоваров КАК тчТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
		|		ПО тчТовары.ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
		|
		|СГРУППИРОВАТЬ ПО
		|	тчТовары.НомерСтроки,
		|	тчТовары.НомерУпаковки,
		|	тчТовары.Цена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТаблица.НомерСтроки КАК НомерСтроки,
		|	втТаблица.НомерУпаковки КАК НомерУпаковки
		|ИЗ
		|	втТаблица КАК втТаблица
		|ГДЕ
		|	втТаблица.КоличествоНомеровУпаковок = 0
		|	И втТаблица.Цена = 0";
		
		
		Если ТипЗнч(Объект[ИмяТЧТУ]) = Тип("ТаблицаЗначений") Тогда
			Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТУ].Скопировать(,"НомерСтроки,НомерУпаковки,ИдентификаторСтроки,Цена"));
		Иначе
			Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТУ].Выгрузить(,"НомерСтроки,НомерУпаковки,ИдентификаторСтроки,Цена"));
		КонецЕсли;
		
		Если ТипЗнч(Объект[ИмяТЧСоставТУ]) = Тип("ТаблицаЗначений") Тогда
			Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСоставТУ].Скопировать(,"ИдентификаторСтроки"));
		Иначе
			Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСоставТУ].Выгрузить(,"ИдентификаторСтроки"));
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если ВыдаватьСообщения Тогда
			
			Пока Выборка.Следующий() Цикл
				
				ТекстСообщения = НСтр("ru = 'Для транспортной упаковки ""%НомерУпаковки%"" не заполнена цена. Заполните цену транспортной упакови.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%",Выборка.НомерУпаковки);
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТУ, Выборка.НомерСтроки, "Цена");
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						Объект,
						Поле,
						"Объект",
						Отказ);
				#КонецЕсли
				
			КонецЦикла;
		Иначе
			Если Не Запрос.Выполнить().Пустой() Тогда
				
				Пока Выборка.Следующий() Цикл
					
					ТекстСообщения = НСтр("ru = 'Для транспортной упаковки ""%НомерУпаковки%"" не заполнен цена. Заполните цену транспортной упакови.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%",Выборка.НомерУпаковки);
					
					Прервать;
				КонецЦикла;
				
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.НомерУпаковки КАК НомерУпаковки,
	|	1 КАК Количество
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары";
	
	Если ТипЗнч(Объект[ИмяТЧТУ]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТУ].Скопировать(,"НомерСтроки,НомерУпаковки"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТУ].Выгрузить(,"НомерСтроки,НомерУпаковки"));
	КонецЕсли;
	
	ТаблицаДублей = Запрос.Выполнить().Выгрузить();
	врТаблицаДублей = ТаблицаДублей.Скопировать();
	врТаблицаДублей.Свернуть("НомерУпаковки","Количество");
	
	Если ВыдаватьСообщения Тогда
		Для Каждого Строка Из врТаблицаДублей Цикл
			Если Строка.Количество > 1 Тогда
				
				НайденныеСтрокиДублейКиз = ТаблицаДублей.НайтиСтроки(Новый Структура("НомерУпаковки",Строка.НомерУпаковки));
				НомерСтрокиДубля = 0;
				Для Каждого СтрокаДубля Из НайденныеСтрокиДублейКиз Цикл
					Если СтрокаДубля.НомерСтроки > НомерСтрокиДубля Тогда
						НомерСтрокиДубля = СтрокаДубля.НомерСтроки;
					КонецЕсли;
				КонецЦикла;
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" дублируется номер транспортной упаковки %НомерУпаковки%. Исправьте транспортные номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , НомерСтрокиДубля);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Строка.НомерУпаковки);
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТУ, НомерСтрокиДубля, "НомерУпаковки");
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						Объект,
						Поле,
						"Объект",
						Отказ);
				#КонецЕсли
				
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Строка Из врТаблицаДублей Цикл
			Если Строка.Количество > 1 Тогда
				
				НайденныеСтрокиДублейКиз = ТаблицаДублей.НайтиСтроки(Новый Структура("НомерУпаковки",Строка.НомерУпаковки));
				НомерСтрокиДубля = 0;
				Для Каждого СтрокаДубля Из НайденныеСтрокиДублейКиз Цикл
					Если СтрокаДубля.НомерСтроки > НомерСтрокиДубля Тогда
						НомерСтрокиДубля = СтрокаДубля.НомерСтроки;
					КонецЕсли;
				КонецЦикла;
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" дублируется номер транспортной упаковки %НомерУпаковки%. Исправьте транспортные номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , НомерСтрокиДубля);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Строка.НомерУпаковки);
				
				Отказ = Истина;
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеGTIN(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ИмяТЧСостав = "ор_СоставТранспортныхУпаковок") Экспорт
	
	втТовары = Объект[ИмяТЧТовары].Выгрузить(,"НомерСтроки,Номенклатура,Характеристика");
	втТовары.Колонки.Добавить("GTIN", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(14)));
	втТовары.Очистить();
	
	Для Каждого Строка Из Объект[ИмяТЧТовары] Цикл
		
		Если НЕ (ЗначениеЗаполнено(Строка.Номенклатура) И ЗначениеЗаполнено(Строка.Характеристика))
			ИЛИ Строка.ор_СтатусЗаполненияУпаковок = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеУпаковки = Объект[ИмяТЧСерии].НайтиСтроки(Новый структура("ИдентификаторСтроки",Строка.ор_ИдентификаторСтроки));
		Если НайденныеУпаковки.Количество() > 0 Тогда
			НоваяСтрока = втТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.GTIN = Лев(НайденныеУпаковки[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из Объект[ИмяТЧСостав] Цикл
		
		Если НЕ (ЗначениеЗаполнено(Строка.Номенклатура) И ЗначениеЗаполнено(Строка.Характеристика) И ЗначениеЗаполнено(Строка.GTIN)) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = втТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	ДанныеGTIN = Новый Соответствие;
	Для Каждого СтрокаТабличнойЧасти Из втТовары Цикл
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.GTIN) И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Номенклатура) Тогда
			ПолученныйGTIN = ДанныеGTIN[СтрокаТабличнойЧасти.GTIN];
			Если ПолученныйGTIN = Неопределено Тогда
				ДанныеGTIN.Вставить(СтрокаТабличнойЧасти.GTIN, Новый Структура("Номенклатура", СтрокаТабличнойЧасти.Номенклатура));
			ИначеЕсли ПолученныйGTIN.Номенклатура <> СтрокаТабличнойЧасти.Номенклатура Тогда
				ТекстСообщения = НСтр("ru = 'В документе есть строки с одним и тем же GTIN %GTIN% для разной номенклатуры.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%GTIN%", СтрокаТабличнойЧасти.GTIN);
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				#КонецЕсли
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.GTIN КАК GTIN
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.Номенклатура КАК Номенклатура,
	|	тчТовары.Характеристика КАК Характеристика,
	|	Штрихкоды.Штрихкод КАК GTIN
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|		ПО тчТовары.Номенклатура = Штрихкоды.Номенклатура
	|			И тчТовары.Характеристика = Штрихкоды.Характеристика
	|			И тчТовары.GTIN <> Штрихкоды.Штрихкод
	|			И (Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения)
	|			И (Штрихкоды.Партия = &Партия)
	|ИТОГИ ПО
	|	Номенклатура,
	|	Характеристика";
	
	Запрос.УстановитьПараметр("ТаблицаТовары"   , втТовары);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("Партия"          , Справочники.ПартииНоменклатуры.ПустаяСсылка());
	
	ВыборкаПоНоменклатуре = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоНоменклатуре.Следующий() Цикл
		
		ВыборкаПоХарактеристике = ВыборкаПоНоменклатуре.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоХарактеристике.Следующий() Цикл
			
			ВыборкаПоGTIN = ВыборкаПоХарактеристике.Выбрать();
			
			МассивGTIN = Новый Массив;
			Пока ВыборкаПоGTIN.Следующий() Цикл
				Если НЕ ор_ИнтеграцияМДЛПКлиентСервер.ЭтоGTIN(ВыборкаПоGTIN.GTIN) Тогда
					Продолжить;
				КонецЕсли;
				МассивGTIN.Добавить(ВыборкаПоGTIN.GTIN);
			КонецЦикла;
			
			Если МассивGTIN.Количество() > 0 Тогда
				
				Если МассивGTIN.Количество() > 1 Тогда
					ТекстСообщения = НСтр("ru = 'В регистре ""Штрихкоды"" для ""%Товар%"" уже существуют записи с другими GTIN.'");
				Иначе
					ТекстСообщения = НСтр("ru = 'В регистре ""Штрихкоды"" для ""%Товар%""  уже существует запись с другим GTIN %GTIN%.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%GTIN%", МассивGTIN[0]);
				КонецЕсли;
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Товар%", ПредставлениеНоменклатуры(ВыборкаПоНоменклатуре.Номенклатура, ВыборкаПоХарактеристике.Характеристика));
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				#КонецЕсли
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьУпаковкиНоменклатуры(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "",
	ПроверятьТолькоБлистеры = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.Номенклатура КАК Номенклатура,
	|	тчТовары.Характеристика КАК Характеристика,
	|	тчТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕдиницыИзмерения.ор_КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок,
	|	ЕдиницыИзмерения.Коэффициент КАК Коэффициент
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО тчТовары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|ГДЕ
	|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0";
		
	КолонкиТовары = "НомерСтроки,Номенклатура,Характеристика,ЕдиницаИзмерения,ор_СтатусЗаполненияУпаковок";
	
	Запрос.УстановитьПараметр("ТаблицаТовары" , Объект[ИмяТЧТовары].Выгрузить(,КолонкиТовары));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ВыдаватьСообщения Тогда
		
		Пока Выборка.Следующий() Цикл
			
			Если ПроверятьТолькоБлистеры И Выборка.Коэффициент > 1 Тогда
				Продолжить;
			КонецЕсли;
			
			Если (Выборка.КоличествоПервичныхУпаковок - Цел(Выборка.КоличествоПервичныхУпаковок)) > 0 Тогда
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" для товара ""%Товар%"" указана единица измерения ""%ЕдиницаИзмерения%"" с некорректным количеством первичных упаковок ""%Количество%"".'");
				ТекстСообщения = ТекстСообщения + " " + НСтр("ru = 'Количество первичных упаковок должно быть целым числом'");
				
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"     , Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Товар%"           , ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЕдиницаИзмерения%", Выборка.ЕдиницаИзмерения);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%"      , Выборка.КоличествоПервичныхУпаковок);
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, Выборка.НомерСтроки, "Упаковка");
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						Объект,
						Поле,
						"Объект",
						Отказ);
				#КонецЕсли
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		Если Не Запрос.Выполнить().Пустой() Тогда
			
			Пока Выборка.Следующий() Цикл
				
				Если ПроверятьТолькоБлистеры И Выборка.Коэффициент > 1 Тогда
					Продолжить;
				КонецЕсли;
				
				Если (Выборка.КоличествоПервичныхУпаковок - Цел(Выборка.КоличествоПервичныхУпаковок)) > 0 Тогда
					
					ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" для товара ""%Товар%"" указана единица измерения ""%ЕдиницаИзмерения%"" с некорректным количеством первичных упаковок ""%Количество%"".'");
					ТекстСообщения = ТекстСообщения + " " + НСтр("ru = 'Количество первичных упаковок должно быть целым числом'");
					
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"     , Выборка.НомерСтроки);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Товар%"           , ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЕдиницаИзмерения%", Выборка.ЕдиницаИзмерения);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%"      , Выборка.КоличествоПервичныхУпаковок);
					
					Отказ = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеНомеровУпаковокУведомлениеДробноеКоличество(Объект, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ТаблицаТоваров.КоличествоПервичныхУпаковокВоВторичной КАК КоличествоПервичныхУпаковокВоВторичной,
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерУпаковки
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.Номенклатура КАК Номенклатура,
	|	тчТовары.Характеристика КАК Характеристика,
	|	тчТовары.Количество КАК Количество,
	|	тчТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	СУММА(ВЫБОР
	|			КОГДА ТаблицаНомеровУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК КоличествоНомеровУпаковок,
	|	СУММА(ВЫБОР
	|			КОГДА ТаблицаНомеровУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ТаблицаНомеровУпаковок.КоличествоПервичныхУпаковок = 0
	|						ТОГДА тчТовары.КоличествоПервичныхУпаковокВоВторичной
	|					ИНАЧЕ ТаблицаНомеровУпаковок.КоличествоПервичныхУпаковок
	|				КОНЕЦ
	|		КОНЕЦ) КАК КоличествоПервичныхУпаковок
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|		ПО тчТовары.ИдентификаторСтроки = ТаблицаНомеровУпаковок.ИдентификаторСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	тчТовары.НомерСтроки,
	|	тчТовары.Номенклатура,
	|	тчТовары.Характеристика,
	|	тчТовары.Количество,
	|	тчТовары.КоличествоУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.Количество КАК Количество,
	|	втТаблица.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТаблица.КоличествоНомеровУпаковок КАК КоличествоНомеровУпаковок,
	|	втТаблица.КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок
	|ИЗ
	|	втТаблица КАК втТаблица
	|ГДЕ
	|	ВЫБОР
	|			КОГДА втТаблица.КоличествоПервичныхУпаковок = 0
	|				ТОГДА втТаблица.Количество <> втТаблица.КоличествоНомеровУпаковок
	|			ИНАЧЕ втТаблица.КоличествоУпаковок <> втТаблица.КоличествоПервичныхУпаковок
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ТаблицаТовары", Объект.Товары.Выгрузить());
	Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект.НомераУпаковок.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ШаблонСообщения = НСтр("ru = 'Количество товара (%1) отличается от количества номеров упаковок (%2).'");
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КоличествоПервичныхУпаковок = 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ШаблонСообщения, Выборка.Количество, Выборка.КоличествоНомеровУпаковок);
		Иначе
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ШаблонСообщения, Выборка.КоличествоУпаковок, Выборка.КоличествоПервичныхУпаковок);
		КонецЕсли;
		
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Запасы", Выборка.НомерСтроки, "КоличествоУпаковок");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект, Поле,, Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеНомеровУпаковокПриРозничнойПродаже(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "",
	ЭтоПодарки = Ложь) Экспорт
	
	КонтролироватьКоличествоНомеровУпаковок = Истина;
	
	ДатаОбъекта = Неопределено;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ЧекККМ") Тогда
		Если Объект.Ссылка.Пустая() Тогда
			ДатаОбъекта = ТекущаяДата();
		Иначе
			ДатаОбъекта = Объект.Дата;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("ОбработкаОбъект.РабочееМестоКассира") Тогда
		ДатаОбъекта = Объект.Дата;
	Иначе
		ДатаОбъекта = ТекущаяДата();
	КонецЕсли;
	
	Если ДатаОбъекта < ПолучитьДатуНачалаМаркировкиТоваров() Тогда
		КонтролироватьКоличествоНомеровУпаковок = Ложь;
	КонецЕсли;
	
	Если КонтролироватьКоличествоНомеровУпаковок Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.Характеристика КАК Характеристика,
		|	ТаблицаТоваров.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
		|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|	КОНЕЦ КАК ЕдиницаИзмерения,
		|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
		|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
		|ПОМЕСТИТЬ ТаблицаТоваров1
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА ТаблицаТоваров.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|			ТОГДА ТаблицаТоваров.Количество * ТаблицаТоваров.ЕдиницаИзмерения.Коэффициент
		|		ИНАЧЕ ТаблицаТоваров.Количество
		|	КОНЕЦ КАК Количество,
		|	ТаблицаТоваров.Количество КАК КоличествоУпаковок,
		|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
		|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
		|ПОМЕСТИТЬ ТаблицаТоваров
		|ИЗ
		|	ТаблицаТоваров1 КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерУпаковки
		|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
		|ИЗ
		|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тчТовары.НомерСтроки КАК НомерСтроки,
		|	тчТовары.Номенклатура КАК Номенклатура,
		|	тчТовары.Характеристика КАК Характеристика,
		|	тчТовары.Количество КАК Количество,
		|	тчТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	тчТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СУММА(ВЫБОР
		|			КОГДА ТаблицаНомеровУпаковок.ИдентификаторСтроки ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК КоличествоНомеровУпаковок
		|ПОМЕСТИТЬ втТаблица
		|ИЗ
		|	ТаблицаТоваров КАК тчТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
		|		ПО тчТовары.ор_ИдентификаторСтроки = ТаблицаНомеровУпаковок.ИдентификаторСтроки
		|ГДЕ
		|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	тчТовары.НомерСтроки,
		|	тчТовары.Номенклатура,
		|	тчТовары.Характеристика,
		|	тчТовары.ЕдиницаИзмерения,
		|	тчТовары.Количество,
		|	тчТовары.КоличествоУпаковок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТаблица.НомерСтроки КАК НомерСтроки,
		|	втТаблица.Номенклатура КАК Номенклатура,
		|	втТаблица.Характеристика КАК Характеристика,
		|	втТаблица.Количество КАК Количество,
		|	втТаблица.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	втТаблица.КоличествоУпаковок КАК КоличествоУпаковок,
		|	втТаблица.КоличествоНомеровУпаковок КАК КоличествоНомеровУпаковок,
		|	втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок
		|ИЗ
		|	втТаблица КАК втТаблица
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ЭтоПодарки
		|				ТОГДА втТаблица.Количество <> втТаблица.КоличествоНомеровУпаковок
		|						ИЛИ втТаблица.КоличествоНомеровУпаковок = 0
		|			ИНАЧЕ ВЫБОР
		|					КОГДА втТаблица.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|						ТОГДА втТаблица.Количество <> втТаблица.КоличествоНомеровУпаковок
		|								ИЛИ втТаблица.КоличествоНомеровУпаковок <> 1
		|					ИНАЧЕ втТаблица.КоличествоНомеровУпаковок <> 1
		|							ИЛИ втТаблица.КоличествоУпаковок > втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок
		|				КОНЕЦ
		|		КОНЕЦ";
		
		КолонкиТовары = "НомерСтроки,Номенклатура,Характеристика,ЕдиницаИзмерения,Количество,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок";
		
		Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
			Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,КолонкиТовары));
		Иначе
			Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,КолонкиТовары));
		КонецЕсли;
		
		Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
			Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки"));
		Иначе
			Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки"));
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ЭтоПодарки", ЭтоПодарки);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		ШаблонОбщий                    = НСтр("ru = 'В строке ""%НомерСтроки%"" для товара ""%Товар%"" '");
		ШаблонПодарки                  = НСтр("ru = 'указано по номерам упаковок %КоличествоНомеровУпаковок%. Необходимо указать %КоличествоТоваров%. Исправьте номера упаковок.'");
		ШаблонНомерВведенНеправильно   = НСтр("ru = 'указано по номерам упаковок %КоличествоНомеровУпаковок%. Необходимо указать 1 номер упаковки.'");
		ШаблонКолНеправильное          = НСтр("ru = 'указано количество %Количество%. Максимальное количество 1.'");
		ШаблонКолБлистеровНеправильное = НСтр("ru = 'указано количество %КоличествоУпаковок%. Максимальное количество %КоличествоПервичныхУпаковок%.'");
		
		Если ВыдаватьСообщения Тогда
			
			Пока Выборка.Следующий() Цикл
				
				ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
				ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
				
				Если ЭтоПодарки Тогда
					ТекстСообщенияТело = СтрЗаменить(ШаблонПодарки, "%КоличествоНомеровУпаковок%",Выборка.КоличествоНомеровУпаковок);
					ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоТоваров%",Выборка.Количество);
					
				ИначеЕсли Выборка.КоличествоНомеровУпаковок <> 1 Тогда
					ТекстСообщенияТело = СтрЗаменить(ШаблонНомерВведенНеправильно, "%КоличествоНомеровУпаковок%", Выборка.КоличествоНомеровУпаковок);
					
				ИначеЕсли НЕ ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения)
					ИЛИ ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения)
					И Выборка.Количество > 1
					И Выборка.КоличествоПервичныхУпаковок < 1 Тогда
					ТекстСообщенияТело = СтрЗаменить(ШаблонКолНеправильное, "%Количество%", Выборка.Количество);
					
				Иначе
					ТекстСообщенияТело = СтрЗаменить(ШаблонКолБлистеровНеправильное, "%КоличествоУпаковок%",Выборка.КоличествоУпаковок);
					ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоПервичныхУпаковок%",Выборка.КоличествоПервичныхУпаковок);
					
				КонецЕсли;
				
				ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, Выборка.НомерСтроки, "НомерСтроки");
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						Объект,
						Поле,
						"Объект",
						Отказ);
				#КонецЕсли
				
			КонецЦикла;
		Иначе
			Если Не Запрос.Выполнить().Пустой() Тогда
				
				Пока Выборка.Следующий() Цикл
					
					ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
					ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
					
					Если ЭтоПодарки Тогда
						ТекстСообщенияТело = СтрЗаменить(ШаблонПодарки, "%КоличествоНомеровУпаковок%",Выборка.КоличествоНомеровУпаковок);
						ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоТоваров%",Выборка.Количество);
						
					ИначеЕсли Выборка.КоличествоНомеровУпаковок <> 1 Тогда
						ТекстСообщенияТело = СтрЗаменить(ШаблонНомерВведенНеправильно, "%КоличествоНомеровУпаковок%", Выборка.КоличествоНомеровУпаковок);
						
					ИначеЕсли НЕ ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения)
						ИЛИ ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения)
						И Выборка.Количество > 1
						И Выборка.КоличествоПервичныхУпаковок < 1 Тогда
						ТекстСообщенияТело = СтрЗаменить(ШаблонКолНеправильное, "%Количество%", Выборка.Количество);
						
					Иначе
						ТекстСообщенияТело = СтрЗаменить(ШаблонКолБлистеровНеправильное, "%КоличествоУпаковок%",Выборка.КоличествоУпаковок);
						ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоПервичныхУпаковок%",Выборка.КоличествоПервичныхУпаковок);
						
					КонецЕсли;
					
					ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
					
					Прервать;
				КонецЦикла;
				
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОстатокНомеровУпаковокПриРозничнойПродаже(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "",
	ЭтоПодарки = Ложь) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров1
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ТаблицаТоваров.Количество * ТаблицаТоваров.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТаблицаТоваров.Количество
	|	КОНЕЦ КАК Количество,
	|	ТаблицаТоваров.Количество КАК КоличествоУпаковок,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаТоваров.СтатусЗаполненияУпаковок КАК СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	ТаблицаТоваров1 КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки КАК КлючУпаковки,
	|	ВЫБОР
	|		КОГДА СУММА(Доли.ДоляУпаковки) >= 1
	|			ТОГДА 0
	|		ИНАЧЕ 1.005 - СУММА(Доли.ДоляУпаковки)
	|	КОНЕЦ КАК ДоляУпаковки
	|ПОМЕСТИТЬ ОстаткиДолейУпаковок
	|ИЗ
	|	ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаТоваров КАК ТаблицаТоваров
	|		ПО ТаблицаНомеровУпаковок.ИдентификаторСтроки = ТаблицаТоваров.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДолиУпаковокМДЛП КАК Доли
	|		ПО (Доли.НомерУпаковки = ТаблицаНомеровУпаковок.НомерУпаковки)
	|			И (Доли.КлючУпаковки = ТаблицаНомеровУпаковок.КлючУпаковки)
	|			И (ВЫБОР
	|				КОГДА &ЕстьДокументРезерва
	|					ТОГДА Доли.ДокументРезерва <> &ДокументРезерва
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаНомеровУпаковок.НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки КАК КлючУпаковки,
	|	ВЫБОР
	|		КОГДА СУММА(Доли.ДоляУпаковки) >= 1
	|			ТОГДА 0
	|		ИНАЧЕ 1.005 - СУММА(Доли.ДоляУпаковки)
	|	КОНЕЦ КАК ДоляУпаковкиРеестра
	|ПОМЕСТИТЬ ОстаткиДолейУпаковокРеестра
	|ИЗ
	|	ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаТоваров КАК ТаблицаТоваров
	|		ПО ТаблицаНомеровУпаковок.ИдентификаторСтроки = ТаблицаТоваров.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеестрВыбытияУпаковокМДЛП КАК Доли
	|		ПО (Доли.НомерУпаковки = ТаблицаНомеровУпаковок.НомерУпаковки)
	|			И (Доли.КлючУпаковки = ТаблицаНомеровУпаковок.КлючУпаковки)
	|			И (ВЫБОР
	|				КОГДА &ЕстьДокументРезерва
	|					ТОГДА Доли.ДокументРезерва <> &ДокументРезерва
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|ГДЕ
	|	Доли.СтатусВыбытия <> ЗНАЧЕНИЕ(Перечисление.СтатусыВыбытияУпаковокМДЛП.ОтклоненВыводИзОборота)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаНомеровУпаковок.НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки КАК КлючУпаковки,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОстаткиДолейУпаковок.ДоляУпаковки, 1) > ЕСТЬNULL(ОстаткиДолейУпаковокРеестра.ДоляУпаковкиРеестра, 1)
	|			ТОГДА ЕСТЬNULL(ОстаткиДолейУпаковокРеестра.ДоляУпаковкиРеестра, 1)
	|		ИНАЧЕ ЕСТЬNULL(ОстаткиДолейУпаковок.ДоляУпаковки, 1)
	|	КОНЕЦ КАК ОстатокДоляУпаковки
	|ПОМЕСТИТЬ втНомераУпаковок
	|ИЗ
	|	ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДолейУпаковок КАК ОстаткиДолейУпаковок
	|		ПО ТаблицаНомеровУпаковок.НомерУпаковки = ОстаткиДолейУпаковок.НомерУпаковки
	|			И ТаблицаНомеровУпаковок.КлючУпаковки = ОстаткиДолейУпаковок.КлючУпаковки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДолейУпаковокРеестра КАК ОстаткиДолейУпаковокРеестра
	|		ПО ТаблицаНомеровУпаковок.НомерУпаковки = ОстаткиДолейУпаковокРеестра.НомерУпаковки
	|			И ТаблицаНомеровУпаковок.КлючУпаковки = ОстаткиДолейУпаковокРеестра.КлючУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	СУММА(ВЫБОР
	|			КОГДА втНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК КоличествоНомеровУпаковок
	|ПОМЕСТИТЬ втТаблицаНомеровУпаковок
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНомераУпаковок КАК втНомераУпаковок
	|		ПО ТаблицаТоваров.ИдентификаторСтроки = втНомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТоваров.СтатусЗаполненияУпаковок <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА &ЭтоПодарки
	|			ТОГДА 1
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ТаблицаТоваров.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|					ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.КоличествоУпаковок / ТаблицаТоваров.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК ЧИСЛО(10, 5))
	|				ИНАЧЕ 1
	|			КОНЕЦ
	|	КОНЕЦ КАК ДоляУпаковки,
	|	ТаблицаТоваров.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	втНомераУпаковок.ОстатокДоляУпаковки КАК ОстатокДоляУпаковки,
	|	втНомераУпаковок.НомерУпаковки КАК НомерУпаковки
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТаблицаНомеровУпаковок КАК втТаблицаНомеровУпаковок
	|		ПО ТаблицаТоваров.ИдентификаторСтроки = втТаблицаНомеровУпаковок.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНомераУпаковок КАК втНомераУпаковок
	|		ПО ТаблицаТоваров.ИдентификаторСтроки = втНомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТоваров.СтатусЗаполненияУпаковок <> 0
	|	И втТаблицаНомеровУпаковок.КоличествоНомеровУпаковок > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерСтроки КАК НомерСтроки,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Количество КАК Количество,
	|	втТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	втТовары.ДоляУпаковки КАК ДоляУпаковки,
	|	втТовары.ОстатокДоляУпаковки КАК ОстатокДоляУпаковки,
	|	втТовары.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	втТовары КАК втТовары
	|ГДЕ
	|	втТовары.ДоляУпаковки > втТовары.ОстатокДоляУпаковки";
	
	КолонкиТовары = "НомерСтроки,ЕдиницаИзмерения,Количество,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок";
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,КолонкиТовары));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,КолонкиТовары));
	КонецЕсли;
	
	Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
		НомераУпаковок = Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки");
	Иначе
		НомераУпаковок = Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки");
	КонецЕсли;
	
	НомераУпаковок.Колонки.Добавить("КлючУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	Для Каждого Строка Из НомераУпаковок Цикл
		Строка.КлючУпаковки = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(Строка.НомерКиЗ);
	КонецЦикла;
	Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", НомераУпаковок);
	
	Запрос.УстановитьПараметр("ЕстьДокументРезерва", ЗначениеЗаполнено(Объект.Ссылка));
	Запрос.УстановитьПараметр("ДокументРезерва"    , Объект.Ссылка);
	Запрос.УстановитьПараметр("ЭтоПодарки"         , ЭтоПодарки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ШаблонЕстьОстаток = НСтр("ru = 'В строке ""%НомерСтроки%"" остаток частично израсходованной упаковки %НомерУпаковки% меньше требуемого.'");
	ШаблонНетОстатка  = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которого нет в наличии.'");
	
	Если ВыдаватьСообщения Тогда
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ОстатокДоляУпаковки > 0 Тогда
				ТекстСообщения = СтрЗаменить(ШаблонЕстьОстаток, "%НомерСтроки%", Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
			Иначе
				ТекстСообщения = СтрЗаменить(ШаблонНетОстатка, "%НомерСтроки%", Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
			КонецЕсли;
			
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, Выборка.НомерСтроки, "НомерСтроки");
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Отказ = Истина;
			#Иначе
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					Объект,
					Поле,
					"Объект",
					Отказ);
			#КонецЕсли
			
		КонецЦикла;
	Иначе
		Если Не Запрос.Выполнить().Пустой() Тогда
			
			Пока Выборка.Следующий() Цикл
				Если Выборка.ОстатокДоляУпаковки > 0 Тогда
					ТекстСообщения = СтрЗаменить(ШаблонЕстьОстаток, "%НомерСтроки%", Выборка.НомерСтроки);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
				Иначе
					ТекстСообщения = СтрЗаменить(ШаблонНетОстатка, "%НомерСтроки%", Выборка.НомерСтроки);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
				КонецЕсли;
				Прервать;
			КонецЦикла;
			
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДублиНомеровУпаковокПриРозничнойПродаже(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "") Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерКИЗ
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчНомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	1 КАК Количество
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
	|		ПО тчТовары.ор_ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL";
	
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,"НомерСтроки,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,"НомерСтроки,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	КонецЕсли;
	
	Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки"));
	КонецЕсли;
	
	ТаблицаДублей = Запрос.Выполнить().Выгрузить();
	врТаблицаДублей = ТаблицаДублей.Скопировать();
	врТаблицаДублей.Свернуть("НомерКИЗ","Количество");
	
	Если ВыдаватьСообщения Тогда
		Для Каждого Строка Из врТаблицаДублей Цикл
			Если Строка.Количество > 1 Тогда
				
				НайденныеСтрокиДублейКиз = ТаблицаДублей.НайтиСтроки(Новый Структура("НомерКИЗ", Строка.НомерКИЗ));
				НомерСтрокиДубля = 0;
				Для Каждого СтрокаДубля Из НайденныеСтрокиДублейКиз Цикл
					Если СтрокаДубля.НомерСтроки > НомерСтрокиДубля Тогда
						НомерСтрокиДубля = СтрокаДубля.НомерСтроки;
					КонецЕсли;
				КонецЦикла;
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" дублируется номер упаковки %НомерКИЗ%. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", НомерСтрокиДубля);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерКИЗ%"   , Строка.НомерКИЗ);
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, НомерСтрокиДубля, "НомерСтроки");
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						Объект,
						Поле,
						"Объект",
						Отказ);
				#КонецЕсли
				
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Строка Из врТаблицаДублей Цикл
			Если Строка.Количество > 1 Тогда
				
				НайденныеСтрокиДублейКиз = ТаблицаДублей.НайтиСтроки(Новый Структура("НомерКИЗ", Строка.НомерКИЗ));
				НомерСтрокиДубля = 0;
				Для Каждого СтрокаДубля Из НайденныеСтрокиДублейКиз Цикл
					Если СтрокаДубля.НомерСтроки > НомерСтрокиДубля Тогда
						НомерСтрокиДубля = СтрокаДубля.НомерСтроки;
					КонецЕсли;
				КонецЦикла;
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" дублируется номер упаковки %НомерКИЗ%. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", НомерСтрокиДубля);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерКИЗ%"   , Строка.НомерКИЗ);
				
				Отказ = Истина;
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтатусыНомеровУпаковокПриРозничнойПродаже(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "") Экспорт
	
	Если НЕ ПолучитьПризнакКонтролироватьСтатусыКИЗ() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	&Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.СтруктурнаяЕдиница КАК Справочник.СтруктурныеЕдиницы)
	|		ИНАЧЕ &СтруктурнаяЕдиница
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчНомераУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	тчНомераУпаковок.КлючУпаковки КАК КлючУпаковки,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
	|		ПО тчТовары.ор_ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО тчТовары.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (СубъектыОбращенияМДЛП.СобственнаяОрганизация)
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА тчТовары.СтруктурнаяЕдиница = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|ГДЕ
	|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.НомерУпаковки КАК НомерУпаковки,
	|	ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") КАК НомерГрупповойУпаковки
	|ИЗ
	|	втТаблица КАК втТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УпаковкиМДЛП КАК СтатусыУпаковок
	|		ПО втТаблица.МестоДеятельности = СтатусыУпаковок.МестоДеятельности
	|			И втТаблица.НомерУпаковки = СтатусыУпаковок.НомерУпаковки
	|			И втТаблица.КлючУпаковки = СтатусыУпаковок.КлючУпаковки
	|ГДЕ
	|	(НЕ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|			ИЛИ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|				И ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") <> """"
	|			ИЛИ ВЫБОР
	|				КОГДА СтатусыУпаковок.ДокументРезерва ЕСТЬ NULL
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ СтатусыУпаковок.ДокументРезерва <> НЕОПРЕДЕЛЕНО
	|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,"НомерСтроки,СтруктурнаяЕдиница,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,"НомерСтроки,СтруктурнаяЕдиница,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	КонецЕсли;
	
	Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
		втНомераУпаковок = Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки");
	Иначе
		втНомераУпаковок = Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки");
	КонецЕсли;
	втНомераУпаковок.Колонки.Добавить("КлючУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	Для Каждого Строка Из втНомераУпаковок Цикл
		Строка.КлючУпаковки = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(Строка.НомерКИЗ);
	КонецЦикла;
	Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", втНомераУпаковок);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ВыдаватьСообщения Тогда
		
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.НомерГрупповойУпаковки) Тогда
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которая вложена в групповую упаковку %КодУпаковки%. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерГрупповойУпаковки);
			Иначе
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которого нет в наличии. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
			КонецЕсли;
			
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, Выборка.НомерСтроки, "НомерСтроки");
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Отказ = Истина;
			#Иначе
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					Объект,
					Поле,
					"Объект",
					Отказ);
			#КонецЕсли
			
		КонецЦикла;
	Иначе
		Если Не Запрос.Выполнить().Пустой() Тогда
			
			Пока Выборка.Следующий() Цикл
				
				Если ЗначениеЗаполнено(Выборка.НомерГрупповойУпаковки) Тогда
					ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которая вложена в групповую упаковку %КодУпаковки%. Исправьте номера упаковок.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , Выборка.НомерСтроки);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерГрупповойУпаковки);
				Иначе
					ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которого нет в наличии. Исправьте номера упаковок.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , Выборка.НомерСтроки);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
				КонецЕсли;
				
				Прервать;
			КонецЦикла;
			
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСкладыВРозничнойПродаже(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ИмяТЧСерии = "ор_НомераУпаковок",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "") Экспорт
	
	ВедетсяМаркировка = ПолучитьПризнакВеденияУчетаМаркировки();
	
	Если НЕ ВедетсяМаркировка Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ОперацияСДенежнымиСредствами  Тогда
		Возврат;
	КонецЕсли;
	
	//Если Объект.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда
	//	Возврат;
	//КонецЕсли;
	
	ИспользоватьМестаДеятельности = ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	&Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА ТаблицаТоваров.СтруктурнаяЕдиница
	|		ИНАЧЕ &СтруктурнаяЕдиница
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ втТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерУпаковки
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ТаблицаТоваров.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	втТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
	|		ПО ТаблицаТоваров.ор_ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	тчТовары.Организация КАК Организация,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО тчТовары.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА тчТовары.СтруктурнаяЕдиница = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(втТаблица.НомерСтроки) КАК НомерСтроки,
	|	втТаблица.Организация КАК Организация,
	|	втТаблица.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
	|ИЗ
	|	втТаблица КАК втТаблица
	|ГДЕ
	|	втТаблица.МестоДеятельности = ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблица.Организация,
	|	втТаблица.СтруктурнаяЕдиница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втТаблица.МестоДеятельности КАК МестоДеятельности
	|ИЗ
	|	втТаблица КАК втТаблица
	|ГДЕ
	|	втТаблица.МестоДеятельности <> ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ИспользоватьМестаДеятельности);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,"НомерСтроки,СтруктурнаяЕдиница,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,"НомерСтроки,СтруктурнаяЕдиница,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	КонецЕсли;
	
	Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки"));
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	Если ВыдаватьСообщения Тогда
		
		Выборка = Результат[5].Выбрать();
		
		Если Выборка.Количество() > 1 Тогда
			
			ТекстСообщения = НСтр("ru = 'В одном чеке могут быть маркируемые товары по одному месту деятельности МДЛП. Проверьте настройки соответствия МДЛП.'");
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Отказ = Истина;
			#Иначе
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			#КонецЕсли
			
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = Результат[4].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ИспользоватьМестаДеятельности Тогда
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" выбран склад ""%Склад%"" для которого не настроено место деятельности МДЛП.'");
				
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Склад%"      , Выборка.СтруктурнаяЕдиница);
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧТовары, Выборка.НомерСтроки, "СтруктурнаяЕдиница");
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						Объект,
						Поле,
						"Объект",
						Отказ);
				#КонецЕсли
			Иначе
				
				ТекстСообщения = НСтр("ru = 'Для организации ""%Организация%"" не настроено место деятельности МДЛП.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Выборка.Организация);
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Отказ = Истина;
				#Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				#КонецЕсли
				
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		
		Выборка = Результат[5].Выбрать();
		
		Если Выборка.Количество() > 1 Тогда
			
			ТекстСообщения = НСтр("ru = 'В одном чеке, пробиваемом в ККТ с передачей данных, могут пробиваться маркируемые товары по одному месту деятельности МДЛП. Проверьте настройки соответствия МДЛП.'");
			
			Отказ = Истина;
			
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Если Не Результат[4].Пустой() Тогда
			
			Выборка = Результат[4].Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если ИспользоватьМестаДеятельности Тогда
					ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" выбран склад ""%Склад%"" для которого не настроено место деятельности МДЛП.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Склад%"      , Выборка.СтруктурнаяЕдиница);
				Иначе
					ТекстСообщения = НСтр("ru = 'Для организации ""%Организация%"" не настроено место деятельности МДЛП.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Выборка.Организация);
				КонецЕсли;
				
				Прервать;
				
			КонецЦикла;
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДанныеРецептовПриРозничнойПродаже(Объект,
	Отказ,
	ИмяТЧТовары = "Запасы",
	ВыдаватьСообщения = Истина,
	ТекстСообщения = "") Экспорт
	
	Если ЭтоКассаСФФД12(Объект.КассаККМ) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.ор_НомерСерииРецепта КАК ор_НомерСерииРецепта,
	|	ТаблицаТоваров.ор_НомерРецепта КАК ор_НомерРецепта,
	|	ТаблицаТоваров.ор_ДатаРегистрацииРецепта КАК ор_ДатаРегистрацииРецепта,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.ор_НомерСерииРецепта КАК ор_НомерСерииРецепта,
	|	тчТовары.ор_НомерРецепта КАК ор_НомерРецепта,
	|	тчТовары.ор_ДатаРегистрацииРецепта КАК ор_ДатаРегистрацииРецепта
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|ГДЕ
	|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И тчТовары.ор_ДатаРегистрацииРецепта <> &ПустаяДатаРецепта
	|
	|СГРУППИРОВАТЬ ПО
	|	тчТовары.ор_НомерСерииРецепта,
	|	тчТовары.ор_НомерРецепта,
	|	тчТовары.ор_ДатаРегистрацииРецепта";
	
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать());
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПустаяДатаРецепта", Дата(1,1,1));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 1 Тогда
		
		Если ВыдаватьСообщения Тогда
			
			ТекстСообщения = НСтр("ru = 'При использовании ККТ с версией ФФД ниже 1.2 в одном чеке можно вводить данные только одного рецепта. Исправьте данные по рецептам.'");
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Отказ = Истина;
			#Иначе
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					,
					,
					,
					Отказ);
			#КонецЕсли
			
		Иначе
			
			ТекстСообщения = НСтр("ru = 'При использовании ККТ с версией ФФД ниже 1.2 в одном чеке можно вводить данные только одного рецепта. Исправьте данные по рецептам.'");
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоПродажаУпаковокНеВОборотеВРежимеПредупреждения(Объект, НомераУпаковокНеВОбороте) Экспорт
	
	ИмяТЧТовары = "Запасы";
	ИмяТЧСерии = "ор_НомераУпаковок";
	
	ПродажаУпаковокНеВОборотеВРежимеПредупреждения = Ложь;
	
	Если НомераУпаковокНеВОбороте = Неопределено Тогда
		НомераУпаковокНеВОбороте = Новый Структура;
	КонецЕсли;
	
	Если НЕ ПолучитьПризнакПредупреждатьСтатусыКИЗ() Тогда
		Возврат ПродажаУпаковокНеВОборотеВРежимеПредупреждения;
	КонецЕсли;
	
	Если Объект.ОперацияСДенежнымиСредствами  Тогда
		Возврат ПродажаУпаковокНеВОборотеВРежимеПредупреждения;
	КонецЕсли;
	
	//Если Объект.ВидОперации <> Перечисления.ВидыОперацийЧекККМ.Продажа Тогда 
	//	Возврат ПродажаУпаковокНеВОборотеВРежимеПредупреждения;
	//КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	&Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.СтруктурнаяЕдиница КАК Справочник.СтруктурныеЕдиницы)
	|		ИНАЧЕ &СтруктурнаяЕдиница
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ТаблицаТоваров.ор_ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	ТаблицаТоваров.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНомеровУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаНомеровУпаковок.НомерКИЗ КАК НомерУпаковки,
	|	ТаблицаНомеровУпаковок.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ ТаблицаНомеровУпаковок
	|ИЗ
	|	&ТаблицаНомеровУпаковок КАК ТаблицаНомеровУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.Номенклатура КАК Номенклатура,
	|	тчТовары.Характеристика КАК Характеристика,
	|	тчНомераУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	тчНомераУпаковок.КлючУпаковки КАК КлючУпаковки,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНомеровУпаковок КАК тчНомераУпаковок
	|		ПО тчТовары.ор_ИдентификаторСтроки = тчНомераУпаковок.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО тчТовары.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (СубъектыОбращенияМДЛП.СобственнаяОрганизация)
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА тчТовары.СтруктурнаяЕдиница = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|ГДЕ
	|	тчТовары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ тчНомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.Номенклатура КАК Номенклатура,
	|	втТаблица.Характеристика КАК Характеристика,
	|	втТаблица.НомерУпаковки КАК НомерУпаковки,
	|	ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") КАК НомерГрупповойУпаковки,
	|	ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) КАК Статус
	|ИЗ
	|	втТаблица КАК втТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УпаковкиМДЛП КАК СтатусыУпаковок
	|		ПО втТаблица.МестоДеятельности = СтатусыУпаковок.МестоДеятельности
	|			И втТаблица.НомерУпаковки = СтатусыУпаковок.НомерУпаковки
	|			И втТаблица.КлючУпаковки = СтатусыУпаковок.КлючУпаковки
	|ГДЕ
	|	(НЕ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|			ИЛИ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|				И ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") <> """"
	|			ИЛИ ВЫБОР
	|				КОГДА СтатусыУпаковок.ДокументРезерва ЕСТЬ NULL
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ СтатусыУпаковок.ДокументРезерва <> НЕОПРЕДЕЛЕНО
	|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);
	
	Если ТипЗнч(Объект[ИмяТЧТовары]) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Скопировать(,"НомерСтроки,Номенклатура,Характеристика,СтруктурнаяЕдиница,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧТовары].Выгрузить(,"НомерСтроки,Номенклатура,Характеристика,СтруктурнаяЕдиница,ор_ИдентификаторСтроки,ор_СтатусЗаполненияУпаковок"));
	КонецЕсли;
	
	Если ТипЗнч(Объект[ИмяТЧСерии]) = Тип("ТаблицаЗначений") Тогда
		втНомераУпаковок = Объект[ИмяТЧСерии].Скопировать(,"НомерКИЗ,ИдентификаторСтроки");
	Иначе
		втНомераУпаковок = Объект[ИмяТЧСерии].Выгрузить(,"НомерКИЗ,ИдентификаторСтроки");
	КонецЕсли;
	втНомераУпаковок.Колонки.Добавить("КлючУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	Для Каждого Строка Из втНомераУпаковок Цикл
		Строка.КлючУпаковки = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(Строка.НомерКИЗ);
	КонецЦикла;
	Запрос.УстановитьПараметр("ТаблицаНомеровУпаковок", втНомераУпаковок);
	
	ТекстКизовВУпаковке = "";
	ТекстКизовОтсутствуют = "";
	ТекстКизовНеПриняты = "";
	ШаблонСтроки = НСтр("ru = 'Строка №%НомерСтроки% %Товар% %НомерУпаковки%'");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПродажаУпаковокНеВОборотеВРежимеПредупреждения = Истина;
		
		Если ЗначениеЗаполнено(Выборка.Статус) И Выборка.Статус = Перечисления.СтатусыУпаковокМДЛП.ВУпаковке Тогда
			
			ТекстСтроки = СтрЗаменить(ШаблонСтроки, "%НомерСтроки%", Выборка.НомерСтроки);
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%Товар%", ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%НомерУпаковки%", Выборка.НомерУпаковки);
			
			Если ТекстКизовВУпаковке = "" Тогда
				ТекстКизовВУпаковке = НСтр("ru = 'Требуется завершение операции расформирования для:'") + Символы.ПС;
			КонецЕсли;
			ТекстКизовВУпаковке = ТекстКизовВУпаковке + ТекстСтроки + Символы.ПС;
			
		ИначеЕсли ЗначениеЗаполнено(Выборка.Статус) Тогда
			
			ТекстСтроки = СтрЗаменить(ШаблонСтроки, "%НомерСтроки%", Выборка.НомерСтроки);
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%Товар%", ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%НомерУпаковки%", Выборка.НомерУпаковки);
			
			Если ТекстКизовНеПриняты = "" Тогда
				ТекстКизовНеПриняты = НСтр("ru = 'Требуется завершение операции приемки для:'") + Символы.ПС;
			КонецЕсли;
			ТекстКизовНеПриняты = ТекстКизовНеПриняты + ТекстСтроки + Символы.ПС;
			
		Иначе
			
			ТекстСтроки = СтрЗаменить(ШаблонСтроки, "%НомерСтроки%", Выборка.НомерСтроки);
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%Товар%", ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%НомерУпаковки%", Выборка.НомерУпаковки);
			
			Если ТекстКизовОтсутствуют = "" Тогда
				ТекстКизовОтсутствуют = НСтр("ru = 'Требуется выполнение операции приемки для:'") + Символы.ПС;;
			КонецЕсли;
			ТекстКизовОтсутствуют = ТекстКизовОтсутствуют + ТекстСтроки + Символы.ПС;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстВопроса = НСтр("ru = 'В чеке найдены позиции, для которых не завершены (или не выполнены) операции приемки или расформирования транспортных упаковок в рамках обмена с системой МДЛП.'") + Символы.ПС;
	ТекстВопроса = ТекстВопроса + НСтр("ru = 'Рекомендуем завершить эти операции перед выполнением розничной продажи.'") + Символы.ПС;
	ТекстВопроса = ТекстВопроса + Символы.ПС; //Отступ
	ТекстВопроса = ТекстВопроса + НСтр("ru = 'Продолжить пробитие чека?'") + Символы.ПС;
	
	ТекстВопроса = ТекстВопроса + Символы.ПС; //Отступ
	ТекстВопроса = ТекстВопроса + ТекстКизовОтсутствуют + Символы.ПС;
	ТекстВопроса = ТекстВопроса + ТекстКизовНеПриняты + Символы.ПС;
	ТекстВопроса = ТекстВопроса + ТекстКизовВУпаковке + Символы.ПС;
	
	НомераУпаковокНеВОбороте.Вставить("ЗаголовокИнформации", НСтр("ru = 'Продажа упаковок маркируемых товаров'"));
	НомераУпаковокНеВОбороте.Вставить("ТекстВопроса", ТекстВопроса);
	
	Возврат ПродажаУпаковокНеВОборотеВРежимеПредупреждения;
	
КонецФункции

Процедура ПроверитьНомераУпаковокТоваровРМК(Форма, КонтрольМДЛППройден, ТекстОшибки) Экспорт
	
	Отказ = Ложь;
	
	Если НЕ Отказ Тогда
		ПроверитьКоличествоВторичныхУпаковокРМК(Форма, Отказ, ТекстОшибки);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПроверитьЗаполнениеКоличестваБлистеровРМК(Форма, Отказ, ТекстОшибки);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПроверитьОстатокНомеровУпаковокРМК(Форма, Отказ, ТекстОшибки);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПроверитьСтатусыНомеровУпаковокРМК(Форма, Отказ, ТекстОшибки);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПроверитьУпаковкиНоменклатурыРМК(Форма, Отказ, ТекстОшибки);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПроверитьСкладыВРозничнойПродажеРМК(Форма, Отказ, ТекстОшибки);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПроверитьРецептыВРозничнойПродажеРМК(Форма, Отказ, ТекстОшибки);
	КонецЕсли;
	
	Если Отказ Тогда
		КонтрольМДЛППройден = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеКоличестваБлистеровРМК(Форма, Отказ, ТекстСообщения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.Упаковка) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.Упаковка КАК Справочник.ЕдиницыИзмерения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.Номенклатура КАК Номенклатура,
	|	втТаблица.Характеристика КАК Характеристика,
	|	втТаблица.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок
	|ИЗ
	|	ТаблицаТоваров КАК втТаблица
	|ГДЕ
	|	втТаблица.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	И втТаблица.КоличествоУпаковок > втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок";
	
	Товары = Форма.Объект.Товары.Выгрузить();
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура)
			И ЗначениеЗаполнено(Строка.Характеристика)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			НоваяСтрока = ТоварыМДЛП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ШаблонОбщий                    = НСтр("ru = 'В строке ""%НомерСтроки%"" для товара ""%Товар%"" '");
	ШаблонКолБлистеровНеправильное = НСтр("ru = 'указано количество %КоличествоУпаковок%. Максимальное количество %КоличествоПервичныхУпаковок%.'");
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		
		Пока Выборка.Следующий() Цикл
			
			ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
			ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
			
			ТекстСообщенияТело = СтрЗаменить(ШаблонКолБлистеровНеправильное, "%КоличествоУпаковок%",Выборка.КоличествоУпаковок);
			ТекстСообщенияТело = СтрЗаменить(ТекстСообщенияТело, "%КоличествоПервичныхУпаковок%",Выборка.КоличествоПервичныхУпаковок);
			
			ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
			
			Отказ = Истина;
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКоличествоВторичныхУпаковокРМК(Форма, Отказ, ТекстСообщения) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.Упаковка) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.Упаковка КАК Справочник.ЕдиницыИзмерения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.Номенклатура КАК Номенклатура,
	|	втТаблица.Характеристика КАК Характеристика,
	|	втТаблица.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок
	|ИЗ
	|	ТаблицаТоваров КАК втТаблица
	|ГДЕ
	|	втТаблица.КоличествоУпаковок > 1
	|	И (втТаблица.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ИЛИ втТаблица.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок <= 1)";
	
	Товары = Форма.Объект.Товары.Выгрузить();
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура)
			И ЗначениеЗаполнено(Строка.Характеристика)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			НоваяСтрока = ТоварыМДЛП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ШаблонОбщий           = НСтр("ru = 'В строке ""%НомерСтроки%"" для товара ""%Товар%"" '");
	ШаблонКолНеправильное = НСтр("ru = 'указано количество %Количество%. Максимальное количество 1.'");
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщенияОбщий = СтрЗаменить(ШаблонОбщий, "%НомерСтроки%", Выборка.НомерСтроки);
		ТекстСообщенияОбщий = СтрЗаменить(ТекстСообщенияОбщий, "%Товар%",ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
		
		ТекстСообщенияТело = СтрЗаменить(ШаблонКолНеправильное, "%Количество%",Выборка.КоличествоУпаковок);
		
		ТекстСообщения = ТекстСообщенияОбщий + ТекстСообщенияТело;
		
		Отказ = Истина;
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьОстатокНомеровУпаковокРМК(Форма, Отказ, ТекстСообщения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.Упаковка) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.Упаковка КАК Справочник.ЕдиницыИзмерения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.НомерКИЗ КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ ТаблицаТоваров1
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ТаблицаТоваров.Количество * ТаблицаТоваров.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТаблицаТоваров.Количество
	|	КОНЕЦ КАК Количество,
	|	ТаблицаТоваров.Количество КАК КоличествоУпаковок,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	ТаблицаТоваров1 КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки,
	|	ВЫБОР
	|		КОГДА СУММА(Доли.ДоляУпаковки) >= 1
	|			ТОГДА 0
	|		ИНАЧЕ 1.005 - СУММА(Доли.ДоляУпаковки)
	|	КОНЕЦ КАК ДоляУпаковки
	|ПОМЕСТИТЬ ОстаткиДолейУпаковок
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДолиУпаковокМДЛП КАК Доли
	|		ПО (Доли.НомерУпаковки = ТаблицаТоваров.НомерУпаковки)
	|			И (Доли.КлючУпаковки = ТаблицаТоваров.КлючУпаковки)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки,
	|	ВЫБОР
	|		КОГДА СУММА(Доли.ДоляУпаковки) >= 1
	|			ТОГДА 0
	|		ИНАЧЕ 1.005 - СУММА(Доли.ДоляУпаковки)
	|	КОНЕЦ КАК ДоляУпаковкиРеестра
	|ПОМЕСТИТЬ ОстаткиДолейУпаковокРеестра
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеестрВыбытияУпаковокМДЛП КАК Доли
	|		ПО (Доли.НомерУпаковки = ТаблицаТоваров.НомерУпаковки)
	|			И (Доли.КлючУпаковки = ТаблицаТоваров.КлючУпаковки)
	|ГДЕ
	|	Доли.СтатусВыбытия <> ЗНАЧЕНИЕ(Перечисление.СтатусыВыбытияУпаковокМДЛП.ОтклоненВыводИзОборота)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОстаткиДолейУпаковок.ДоляУпаковки, 1) > ЕСТЬNULL(ОстаткиДолейУпаковокРеестра.ДоляУпаковкиРеестра, 1)
	|			ТОГДА ЕСТЬNULL(ОстаткиДолейУпаковокРеестра.ДоляУпаковкиРеестра, 1)
	|		ИНАЧЕ ЕСТЬNULL(ОстаткиДолейУпаковок.ДоляУпаковки, 1)
	|	КОНЕЦ КАК ОстатокДоляУпаковки
	|ПОМЕСТИТЬ втНомераУпаковок
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДолейУпаковок КАК ОстаткиДолейУпаковок
	|		ПО ТаблицаТоваров.НомерУпаковки = ОстаткиДолейУпаковок.НомерУпаковки
	|			И ТаблицаТоваров.КлючУпаковки = ОстаткиДолейУпаковок.КлючУпаковки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДолейУпаковокРеестра КАК ОстаткиДолейУпаковокРеестра
	|		ПО ТаблицаТоваров.НомерУпаковки = ОстаткиДолейУпаковокРеестра.НомерУпаковки
	|			И ТаблицаТоваров.КлючУпаковки = ОстаткиДолейУпаковокРеестра.КлючУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.КоличествоУпаковок / ТаблицаТоваров.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК ЧИСЛО(10, 5))
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ДоляУпаковки,
	|	ТаблицаТоваров.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	втНомераУпаковок.ОстатокДоляУпаковки КАК ОстатокДоляУпаковки,
	|	втНомераУпаковок.НомерУпаковки КАК НомерУпаковки
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНомераУпаковок КАК втНомераУпаковок
	|		ПО ТаблицаТоваров.НомерУпаковки = втНомераУпаковок.НомерУпаковки
	|			И ТаблицаТоваров.КлючУпаковки = втНомераУпаковок.КлючУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерСтроки КАК НомерСтроки,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Количество КАК Количество,
	|	втТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	втТовары.ДоляУпаковки КАК ДоляУпаковки,
	|	втТовары.ОстатокДоляУпаковки КАК ОстатокДоляУпаковки,
	|	втТовары.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	втТовары КАК втТовары
	|ГДЕ
	|	втТовары.ДоляУпаковки > втТовары.ОстатокДоляУпаковки";
	
	Товары = Форма.Объект.Товары.Выгрузить();
	
	СимволGS1 = ОбщегоНазначенияБПОКлиентСервер.РазделительGS1();
	Разделитель = ОбщегоНазначенияБПОКлиентСервер.ЭкранированныйСимволGS1();
	
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	ТоварыМДЛП.Колонки.Добавить("НомерКИЗ", ОбщегоНазначения.ОписаниеТипаСтрока(27));
	ТоварыМДЛП.Колонки.Добавить("КлючУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.КодМаркировки)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			
			КодМаркировкиОригинал = СтрЗаменить(Строка.КодМаркировки, Разделитель, СимволGS1);
			СтруктураМаркировкиМДЛП = ор_ИнтеграцияМДЛПКлиентСервер.РазобратьШтрихкодПоТипу(КодМаркировкиОригинал);
			
			Если СтруктураМаркировкиМДЛП.Свойство("МаркированныйТовар") Тогда
				НоваяСтрока = ТоварыМДЛП.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.НомерКИЗ = СтруктураМаркировкиМДЛП.Данные.sgtin;
				НоваяСтрока.КлючУпаковки = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(НоваяСтрока.НомерКиЗ);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ШаблонЕстьОстаток = НСтр("ru = 'В строке ""%НомерСтроки%"" остаток частично израсходованной упаковки %НомерУпаковки% меньше требуемого.'");
	ШаблонНетОстатка  = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которого нет в наличии.'");
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ОстатокДоляУпаковки > 0 Тогда
				ТекстСообщения = СтрЗаменить(ШаблонЕстьОстаток, "%НомерСтроки%", Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
			Иначе
				ТекстСообщения = СтрЗаменить(ШаблонНетОстатка, "%НомерСтроки%", Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
			КонецЕсли;
			
			Отказ = Истина;
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтатусыНомеровУпаковокРМК(Форма, Отказ, ТекстСообщения) Экспорт
	
	Если НЕ ПолучитьПризнакКонтролироватьСтатусыКИЗ() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКассККМ.Организация КАК Организация,
	|	ТаблицаКассККМ.КассаККМ КАК КассаККМ
	|ПОМЕСТИТЬ ТаблицаКассККМ
	|ИЗ
	|	&ТаблицаКассККМ КАК ТаблицаКассККМ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ТаблицаТоваров.ТорговыйОбъект КАК ТорговыйОбъект,
	|	ТаблицаТоваров.НомерКИЗ КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ТорговыйОбъект = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(СпрКассыККМ.СтруктурнаяЕдиница, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))
	|		ИНАЧЕ ТаблицаТоваров.ТорговыйОбъект
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ втТаблицаТоваров
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКассККМ КАК ТаблицаКассККМ
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК СпрКассыККМ
	|			ПО ТаблицаКассККМ.КассаККМ = СпрКассыККМ.Ссылка
	|		ПО ТаблицаТоваров.Организация = ТаблицаКассККМ.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	втТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО ТаблицаТоваров.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (СубъектыОбращенияМДЛП.СобственнаяОрганизация)
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА ТаблицаТоваров.СтруктурнаяЕдиница = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.НомерУпаковки КАК НомерУпаковки,
	|	ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") КАК НомерГрупповойУпаковки
	|ИЗ
	|	втТаблица КАК втТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УпаковкиМДЛП КАК СтатусыУпаковок
	|		ПО втТаблица.МестоДеятельности = СтатусыУпаковок.МестоДеятельности
	|			И втТаблица.НомерУпаковки = СтатусыУпаковок.НомерУпаковки
	|			И втТаблица.КлючУпаковки = СтатусыУпаковок.КлючУпаковки
	|ГДЕ
	|	(НЕ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|			ИЛИ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|				И ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") <> """"
	|			ИЛИ ВЫБОР
	|				КОГДА СтатусыУпаковок.ДокументРезерва ЕСТЬ NULL
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ СтатусыУпаковок.ДокументРезерва <> НЕОПРЕДЕЛЕНО
	|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("ТаблицаКассККМ", Форма.ТаблицаКассККМОрганизаций.Выгрузить());
	
	Товары = Форма.Объект.Товары.Выгрузить();
	
	СимволGS1 = ОбщегоНазначенияБПОКлиентСервер.РазделительGS1();
	Разделитель = ОбщегоНазначенияБПОКлиентСервер.ЭкранированныйСимволGS1();
	
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	ТоварыМДЛП.Колонки.Добавить("НомерКИЗ", ОбщегоНазначения.ОписаниеТипаСтрока(27));
	ТоварыМДЛП.Колонки.Добавить("КлючУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.КодМаркировки)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			
			КодМаркировкиОригинал = СтрЗаменить(Строка.КодМаркировки, Разделитель, СимволGS1);
			СтруктураМаркировкиМДЛП = ор_ИнтеграцияМДЛПКлиентСервер.РазобратьШтрихкодПоТипу(КодМаркировкиОригинал);
			
			Если СтруктураМаркировкиМДЛП.Свойство("МаркированныйТовар") Тогда
				НоваяСтрока = ТоварыМДЛП.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.НомерКИЗ = СтруктураМаркировкиМДЛП.Данные.sgtin;
				НоваяСтрока.КлючУпаковки = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(НоваяСтрока.НомерКиЗ);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.НомерГрупповойУпаковки) Тогда
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которая вложена в групповую упаковку %КодУпаковки%. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерГрупповойУпаковки);
			Иначе
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" указан номер упаковки %НомерУпаковки%, которого нет в наличии. Исправьте номера упаковок.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"  , Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерУпаковки%", Выборка.НомерУпаковки);
			КонецЕсли;
			
			Отказ = Истина;
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьУпаковкиНоменклатурыРМК(Форма, Отказ, ТекстСообщения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаТоваров.Упаковка) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаТоваров.Упаковка КАК Справочник.ЕдиницыИзмерения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.Номенклатура КАК Номенклатура,
	|	тчТовары.Характеристика КАК Характеристика,
	|	тчТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕдиницыИзмерения.ор_КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок,
	|	ЕдиницыИзмерения.Коэффициент КАК Коэффициент
	|ИЗ
	|	ТаблицаТоваров КАК тчТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО тчТовары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка";
	
	Товары = Форма.Объект.Товары.Выгрузить();
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура)
			И ЗначениеЗаполнено(Строка.Характеристика)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			
			НоваяСтрока = ТоварыМДЛП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		
		Пока Выборка.Следующий() Цикл
			
			Если (Выборка.КоличествоПервичныхУпаковок - Цел(Выборка.КоличествоПервичныхУпаковок)) > 0 Тогда
				
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" для товара ""%Товар%"" указана единица измерения ""%ЕдиницаИзмерения%"" с некорректным количеством первичных упаковок ""%Количество%"".'");
				ТекстСообщения = ТекстСообщения + " " + НСтр("ru = 'Количество первичных упаковок должно быть целым числом'");
				
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%"     , Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Товар%"           , ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЕдиницаИзмерения%", Выборка.ЕдиницаИзмерения);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%"      , Выборка.КоличествоПервичныхУпаковок);
				
				Отказ = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСкладыВРозничнойПродажеРМК(Форма, Отказ, ТекстСообщения) Экспорт
	
	ВедетсяМаркировка = ПолучитьПризнакВеденияУчетаМаркировки();
	
	Если НЕ ВедетсяМаркировка Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьМестаДеятельности = ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКассККМ.Организация КАК Организация,
	|	ТаблицаКассККМ.КассаККМ КАК КассаККМ
	|ПОМЕСТИТЬ ТаблицаКассККМ
	|ИЗ
	|	&ТаблицаКассККМ КАК ТаблицаКассККМ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ТаблицаТоваров.СистемаНалогообложения КАК СистемаНалогообложения,
	|	ТаблицаТоваров.ТорговыйОбъект КАК ТорговыйОбъект
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ТаблицаТоваров.СистемаНалогообложения КАК СистемаНалогообложения,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ТорговыйОбъект = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(СпрКассыККМ.СтруктурнаяЕдиница, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))
	|		ИНАЧЕ ТаблицаТоваров.ТорговыйОбъект
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ЕСТЬNULL(СпрКассыККМ.ПодключаемоеОборудование, ЗНАЧЕНИЕ(Справочник.ПодключаемоеОборудование.ПустаяСсылка)) КАК ПодключаемоеОборудование,
	|	ЕСТЬNULL(СпрКассыККМ.ор_МДЛПОтправлятьДанныеМаркируемыхТоваровЧерезОФД, ЛОЖЬ) КАК ОтправлятьЧерезОФД
	|ПОМЕСТИТЬ втТаблицаТоваров
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКассККМ КАК ТаблицаКассККМ
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК СпрКассыККМ
	|			ПО ТаблицаКассККМ.КассаККМ = СпрКассыККМ.Ссылка
	|		ПО ТаблицаТоваров.Организация = ТаблицаКассККМ.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчТовары.НомерСтроки КАК НомерСтроки,
	|	тчТовары.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	тчТовары.Организация КАК Организация,
	|	тчТовары.СистемаНалогообложения КАК СистемаНалогообложения,
	|	тчТовары.ПодключаемоеОборудование КАК ПодключаемоеОборудование,
	|	тчТовары.ОтправлятьЧерезОФД КАК ОтправлятьЧерезОФД,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	втТаблицаТоваров КАК тчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО тчТовары.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА тчТовары.СтруктурнаяЕдиница = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(втТаблица.НомерСтроки) КАК НомерСтроки,
	|	втТаблица.Организация КАК Организация,
	|	втТаблица.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
	|ИЗ
	|	втТаблица КАК втТаблица
	|ГДЕ
	|	втТаблица.МестоДеятельности = ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблица.Организация,
	|	втТаблица.СтруктурнаяЕдиница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.Организация КАК Организация,
	|	втТаблица.СистемаНалогообложения КАК СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование КАК ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД КАК ОтправлятьЧерезОФД,
	|	втТаблица.МестоДеятельности КАК МестоДеятельности
	|ПОМЕСТИТЬ втТаблица1
	|ИЗ
	|	втТаблица КАК втТаблица
	|ГДЕ
	|	втТаблица.МестоДеятельности <> ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблица.Организация,
	|	втТаблица.СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД,
	|	втТаблица.МестоДеятельности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.Организация КАК Организация,
	|	втТаблица.СистемаНалогообложения КАК СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование КАК ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД КАК ОтправлятьЧерезОФД,
	|	Сумма(1) КАК Количество
	|ИЗ
	|	втТаблица1 КАК втТаблица
	|ГДЕ
	|	втТаблица.МестоДеятельности <> ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблица.Организация,
	|	втТаблица.СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД";
	
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ИспользоватьМестаДеятельности);
	Запрос.УстановитьПараметр("ТаблицаКассККМ", Форма.ТаблицаКассККМОрганизаций.Выгрузить());
	
	
	Товары = Форма.Объект.Товары.Выгрузить();
	
	СимволGS1 = ОбщегоНазначенияБПОКлиентСервер.РазделительGS1();
	Разделитель = ОбщегоНазначенияБПОКлиентСервер.ЭкранированныйСимволGS1();
	
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	ТоварыМДЛП.Колонки.Добавить("НомерКИЗ", ОбщегоНазначения.ОписаниеТипаСтрока(27));
	ТоварыМДЛП.Колонки.Добавить("КлючУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.КодМаркировки)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			
			НоваяСтрока = ТоварыМДЛП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Если Не Результат[6].Пустой() Тогда
		
		Выборка = Результат[6].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ОтправлятьЧерезОФД
				И Выборка.Количество > 1 Тогда
				
				Если ЗначениеЗаполнено(Выборка.ПодключаемоеОборудование)
					И МенеджерОборудованияВызовСервера.ФискальноеУстройствоПоддерживаетПроверкуКодовМаркировки(Выборка.ПодключаемоеОборудование) Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстСообщения = НСтр("ru = 'В чеке по организации ""%Организация%"" можно подбирать маркируемые товары только по одному месту деятельности МДЛП. Проверьте настройки соответствия МДЛП.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Выборка.Организация);
				
				Отказ = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Результат[4].Пустой() Тогда
		
		Выборка = Результат[4].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ИспользоватьМестаДеятельности Тогда
				ТекстСообщения = НСтр("ru = 'В строке ""%НомерСтроки%"" выбран склад ""%Склад%"" для которого не настроено место деятельности МДЛП.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Склад%"      , Выборка.СтруктурнаяЕдиница);
			Иначе
				ТекстСообщения = НСтр("ru = 'Для организации ""%Организация%"" не настроено место деятельности МДЛП.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Выборка.Организация);
			КонецЕсли;
			
			Отказ = Истина;
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьРецептыВРозничнойПродажеРМК(Форма, Отказ, ТекстСообщения) Экспорт
	
	ВедетсяМаркировка = ПолучитьПризнакВеденияУчетаМаркировки();
	
	Если НЕ ВедетсяМаркировка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКассККМ.Организация КАК Организация,
	|	ТаблицаКассККМ.КассаККМ КАК КассаККМ
	|ПОМЕСТИТЬ ТаблицаКассККМ
	|ИЗ
	|	&ТаблицаКассККМ КАК ТаблицаКассККМ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ТаблицаТоваров.СистемаНалогообложения КАК СистемаНалогообложения,
	|	ТаблицаТоваров.ТорговыйОбъект КАК ТорговыйОбъект,
	|	ТаблицаТоваров.ор_НомерСерииРецепта КАК ор_НомерСерииРецепта,
	|	ТаблицаТоваров.ор_НомерРецепта КАК ор_НомерРецепта,
	|	ТаблицаТоваров.ор_ДатаРегистрацииРецепта КАК ор_ДатаРегистрацииРецепта
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ТаблицаТоваров.СистемаНалогообложения КАК СистемаНалогообложения,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ТорговыйОбъект = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(СпрКассыККМ.СтруктурнаяЕдиница, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))
	|		ИНАЧЕ ТаблицаТоваров.ТорговыйОбъект
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ЕСТЬNULL(СпрКассыККМ.ПодключаемоеОборудование, ЗНАЧЕНИЕ(Справочник.ПодключаемоеОборудование.ПустаяСсылка)) КАК ПодключаемоеОборудование,
	|	ЕСТЬNULL(СпрКассыККМ.ор_МДЛПОтправлятьДанныеМаркируемыхТоваровЧерезОФД, ЛОЖЬ) КАК ОтправлятьЧерезОФД,
	|	ТаблицаТоваров.ор_НомерСерииРецепта КАК ор_НомерСерииРецепта,
	|	ТаблицаТоваров.ор_НомерРецепта КАК ор_НомерРецепта,
	|	ТаблицаТоваров.ор_ДатаРегистрацииРецепта КАК ор_ДатаРегистрацииРецепта
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКассККМ КАК ТаблицаКассККМ
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК СпрКассыККМ
	|			ПО ТаблицаКассККМ.КассаККМ = СпрКассыККМ.Ссылка
	|		ПО ТаблицаТоваров.Организация = ТаблицаКассККМ.Организация
	|ГДЕ
	|	ТаблицаТоваров.ор_ДатаРегистрацииРецепта <> &ПустаяДатаРецепта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.Организация КАК Организация,
	|	втТаблица.СистемаНалогообложения КАК СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование КАК ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД КАК ОтправлятьЧерезОФД,
	|	втТаблица.ор_НомерСерииРецепта КАК ор_НомерСерииРецепта,
	|	втТаблица.ор_НомерРецепта КАК ор_НомерРецепта,
	|	втТаблица.ор_ДатаРегистрацииРецепта КАК ор_ДатаРегистрацииРецепта
	|ПОМЕСТИТЬ втТаблицаГруппа
	|ИЗ
	|	втТаблица КАК втТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблица.Организация,
	|	втТаблица.СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД,
	|	втТаблица.ор_НомерСерииРецепта,
	|	втТаблица.ор_НомерРецепта,
	|	втТаблица.ор_ДатаРегистрацииРецепта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.Организация КАК Организация,
	|	втТаблица.СистемаНалогообложения КАК СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование КАК ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД КАК ОтправлятьЧерезОФД,
	|	Сумма(1) КАК Количество
	|ИЗ
	|	втТаблицаГруппа КАК втТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблица.Организация,
	|	втТаблица.СистемаНалогообложения,
	|	втТаблица.ПодключаемоеОборудование,
	|	втТаблица.ОтправлятьЧерезОФД";
	
	Запрос.УстановитьПараметр("ТаблицаКассККМ", Форма.ТаблицаКассККМОрганизаций.Выгрузить());
	Запрос.УстановитьПараметр("ПустаяДатаРецепта", Дата(1,1,1));
	
	Товары = Форма.Объект.Товары.Выгрузить();
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.КодМаркировки)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			НоваяСтрока = ТоварыМДЛП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ОтправлятьЧерезОФД
			И Выборка.Количество > 1 Тогда
			
			Если ЗначениеЗаполнено(Выборка.ПодключаемоеОборудование)
				И МенеджерОборудованияВызовСервера.ФискальноеУстройствоПоддерживаетПроверкуКодовМаркировки(Выборка.ПодключаемоеОборудование) Тогда
				Продолжить;
			КонецЕсли;
			
			ТекстСообщения = НСтр("ru = 'При использовании ККТ с версией ФФД ниже 1.2 в одном чеке можно вводить данные только одного рецепта. Исправьте данные по рецептам.'");
			//ТекстСообщения = НСтр("ru = 'При использовании ККТ с версией ФФД ниже 1.2 в одном чеке можно вводить данные только одного рецепта. Исправьте данные по рецептам по организации ""%Организация%"".'");
			//ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Выборка.Организация);
			
			Отказ = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоПродажаУпаковокНеВОборотеВРежимеПредупрежденияРМК(Форма, НомераУпаковокНеВОбороте, ПризнакЗапрета) Экспорт
	
	ПродажаУпаковокНеВОборотеВРежимеПредупреждения = Ложь;
	
	Если НомераУпаковокНеВОбороте = Неопределено Тогда
		НомераУпаковокНеВОбороте = Новый Структура;
	КонецЕсли;
	
	Если НЕ ПолучитьПризнакПредупреждатьСтатусыКИЗ() Тогда
		Возврат ПродажаУпаковокНеВОборотеВРежимеПредупреждения;
	КонецЕсли;
	
	Если ПризнакЗапрета Тогда
		Возврат ПродажаУпаковокНеВОборотеВРежимеПредупреждения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКассККМ.Организация КАК Организация,
	|	ТаблицаКассККМ.КассаККМ КАК КассаККМ
	|ПОМЕСТИТЬ ТаблицаКассККМ
	|ИЗ
	|	&ТаблицаКассККМ КАК ТаблицаКассККМ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ТаблицаТоваров.ТорговыйОбъект КАК ТорговыйОбъект,
	|	ТаблицаТоваров.НомерКИЗ КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.ТорговыйОбъект = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(СпрКассыККМ.СтруктурнаяЕдиница, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка))
	|		ИНАЧЕ ТаблицаТоваров.ТорговыйОбъект
	|	КОНЕЦ КАК СтруктурнаяЕдиница,
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки
	|ПОМЕСТИТЬ втТаблицаТоваров
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКассККМ КАК ТаблицаКассККМ
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК СпрКассыККМ
	|			ПО ТаблицаКассККМ.КассаККМ = СпрКассыККМ.Ссылка
	|		ПО ТаблицаТоваров.Организация = ТаблицаКассККМ.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаТоваров.КлючУпаковки КАК КлючУпаковки,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	втТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО ТаблицаТоваров.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (СубъектыОбращенияМДЛП.СобственнаяОрганизация)
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА ТаблицаТоваров.СтруктурнаяЕдиница = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.НомерСтроки КАК НомерСтроки,
	|	втТаблица.Номенклатура КАК Номенклатура,
	|	втТаблица.Характеристика КАК Характеристика,
	|	втТаблица.НомерУпаковки КАК НомерУпаковки,
	|	ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") КАК НомерГрупповойУпаковки,
	|	ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) КАК Статус
	|ИЗ
	|	втТаблица КАК втТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УпаковкиМДЛП КАК СтатусыУпаковок
	|		ПО втТаблица.МестоДеятельности = СтатусыУпаковок.МестоДеятельности
	|			И втТаблица.НомерУпаковки = СтатусыУпаковок.НомерУпаковки
	|			И втТаблица.КлючУпаковки = СтатусыУпаковок.КлючУпаковки
	|ГДЕ
	|	(НЕ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|			ИЛИ ЕСТЬNULL(СтатусыУпаковок.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|				И ЕСТЬNULL(СтатусыУпаковок.НомерГрупповойУпаковки, """") <> """"
	|			ИЛИ ВЫБОР
	|				КОГДА СтатусыУпаковок.ДокументРезерва ЕСТЬ NULL
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ СтатусыУпаковок.ДокументРезерва <> НЕОПРЕДЕЛЕНО
	|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("ТаблицаКассККМ", Форма.ТаблицаКассККМОрганизаций.Выгрузить());
	
	Товары = Форма.Объект.Товары.Выгрузить();
	
	СимволGS1 = ОбщегоНазначенияБПОКлиентСервер.РазделительGS1();
	Разделитель = ОбщегоНазначенияБПОКлиентСервер.ЭкранированныйСимволGS1();
	
	ТоварыМДЛП = Товары.Скопировать();
	ТоварыМДЛП.Очистить();
	ТоварыМДЛП.Колонки.Добавить("НомерКИЗ", ОбщегоНазначения.ОписаниеТипаСтрока(27));
	ТоварыМДЛП.Колонки.Добавить("КлючУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	Для Каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.КодМаркировки)
			И ор_ИнтеграцияМДЛП.ПроверитьНоменклатуруМаркировки(Строка.Номенклатура)
			И ор_ИнтеграцияМДЛП.ПроверитьХарактеристикуМаркировки(Строка.Характеристика) Тогда
			
			КодМаркировкиОригинал = СтрЗаменить(Строка.КодМаркировки, Разделитель, СимволGS1);
			СтруктураМаркировкиМДЛП = ор_ИнтеграцияМДЛПКлиентСервер.РазобратьШтрихкодПоТипу(КодМаркировкиОригинал);
			
			Если СтруктураМаркировкиМДЛП.Свойство("МаркированныйТовар") Тогда
				НоваяСтрока = ТоварыМДЛП.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.НомерКИЗ = СтруктураМаркировкиМДЛП.Данные.sgtin;
				НоваяСтрока.КлючУпаковки = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(НоваяСтрока.НомерКиЗ);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТоварыМДЛП);
	
	ТекстКизовВУпаковке = "";
	ТекстКизовОтсутствуют = "";
	ТекстКизовНеПриняты = "";
	ШаблонСтроки = НСтр("ru = 'Строка №%НомерСтроки% %Товар% %НомерУпаковки%'");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПродажаУпаковокНеВОборотеВРежимеПредупреждения = Истина;
		
		Если ЗначениеЗаполнено(Выборка.Статус) И Выборка.Статус = Перечисления.СтатусыУпаковокМДЛП.ВУпаковке Тогда
			
			ТекстСтроки = СтрЗаменить(ШаблонСтроки, "%НомерСтроки%", Выборка.НомерСтроки);
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%Товар%", ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%НомерУпаковки%", Выборка.НомерУпаковки);
			
			Если ТекстКизовВУпаковке = "" Тогда
				ТекстКизовВУпаковке = НСтр("ru = 'Требуется завершение операции расформирования для:'") + Символы.ПС;
			КонецЕсли;
			ТекстКизовВУпаковке = ТекстКизовВУпаковке + ТекстСтроки + Символы.ПС;
			
		ИначеЕсли ЗначениеЗаполнено(Выборка.Статус) Тогда
			
			ТекстСтроки = СтрЗаменить(ШаблонСтроки, "%НомерСтроки%", Выборка.НомерСтроки);
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%Товар%", ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%НомерУпаковки%", Выборка.НомерУпаковки);
			
			Если ТекстКизовНеПриняты = "" Тогда
				ТекстКизовНеПриняты = НСтр("ru = 'Требуется завершение операции приемки для:'") + Символы.ПС;
			КонецЕсли;
			ТекстКизовНеПриняты = ТекстКизовНеПриняты + ТекстСтроки + Символы.ПС;
			
		Иначе
			
			ТекстСтроки = СтрЗаменить(ШаблонСтроки, "%НомерСтроки%", Выборка.НомерСтроки);
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%Товар%", ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
			ТекстСтроки = СтрЗаменить(ТекстСтроки, "%НомерУпаковки%", Выборка.НомерУпаковки);
			
			Если ТекстКизовОтсутствуют = "" Тогда
				ТекстКизовОтсутствуют = НСтр("ru = 'Требуется выполнение операции приемки для:'") + Символы.ПС;;
			КонецЕсли;
			ТекстКизовОтсутствуют = ТекстКизовОтсутствуют + ТекстСтроки + Символы.ПС;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстВопроса = НСтр("ru = 'В чеке найдены позиции, для которых не завершены (или не выполнены) операции приемки или расформирования транспортных упаковок в рамках обмена с системой МДЛП.'") + Символы.ПС;
	ТекстВопроса = ТекстВопроса + НСтр("ru = 'Рекомендуем завершить эти операции перед выполнением розничной продажи.'") + Символы.ПС;
	ТекстВопроса = ТекстВопроса + Символы.ПС; //Отступ
	ТекстВопроса = ТекстВопроса + НСтр("ru = 'Продолжить пробитие чека?'") + Символы.ПС;
	
	ТекстВопроса = ТекстВопроса + Символы.ПС; //Отступ
	ТекстВопроса = ТекстВопроса + ТекстКизовОтсутствуют + Символы.ПС;
	ТекстВопроса = ТекстВопроса + ТекстКизовНеПриняты + Символы.ПС;
	ТекстВопроса = ТекстВопроса + ТекстКизовВУпаковке + Символы.ПС;
	
	НомераУпаковокНеВОбороте.Вставить("ЗаголовокИнформации", НСтр("ru = 'Продажа упаковок маркируемых товаров'"));
	НомераУпаковокНеВОбороте.Вставить("ТекстВопроса", ТекстВопроса);
	
	Возврат ПродажаУпаковокНеВОборотеВРежимеПредупреждения;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиОткрытияДопФорм

#Область ВводНомеровУпаковок

Функция ПолучитьПараметрыФормыВводаНомеровУпаковок(Объект, Форма, ПараметрыФормыУказания, ИспользоватьТранспортныеУпаковки = Ложь) Экспорт
	
	ИмяТЧТовары   = ПараметрыФормыУказания.ИмяТЧТовары;
	ИмяТЧСерии    = ПараметрыФормыУказания.ИмяТЧСерии;
	ИмяТЧТУ       = ПараметрыФормыУказания.ИмяТЧТУ;
	ИмяТЧСоставТУ = ПараметрыФормыУказания.ИмяТЧСоставТУ;
	
	ТекущиеДанныеИдентификатор = ПараметрыФормыУказания.ТекущиеДанныеИдентификатор;
	
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	// Если нужно будет изменять количество, то данные формы нужно заблокировать.
	// Если заблокировать не удастся - вылетит исключение.
	Форма.ЗаблокироватьДанныеФормыДляРедактирования();
	
	ТекущиеДанные = Объект[ИмяТЧТовары].НайтиПоИдентификатору(ТекущиеДанныеИдентификатор);
	
	СтруктураПоиска = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ор_ИдентификаторСтроки);
	НайденныеСтрокиНомеров = Объект[ИмяТЧСерии].НайтиСтроки(СтруктураПоиска);
	
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("НомерКИЗ", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(27)));
	ТаблицаНомеров.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаНомеров.Колонки.Добавить("ПолныйКодМаркировки", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(200)));
	ТаблицаНомеров.Колонки.Добавить("РазрешительныйРежимИдентификаторЗапросаГИСМТ", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаНомеров.Колонки.Добавить("РазрешительныйРежимДатаЗапросаГИСМТ", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(14)));
	ТаблицаНомеров.Колонки.Добавить("РазрешительныйРежимИдентификаторЭкземпляраПО", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаНомеров.Колонки.Добавить("РазрешительныйРежимВерсияБазы", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	
	Для Каждого СтрокаМассива Из НайденныеСтрокиНомеров Цикл
		НоваяСтрока = ТаблицаНомеров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	СтруктураТаблиц = Новый Структура;
	СтруктураТаблиц.Вставить("ТаблицаНомеров", ТаблицаНомеров);
	
	Если ИспользоватьТранспортныеУпаковки Тогда
		
		ТранспортныеУпаковки = Новый ТаблицаЗначений;
		ТранспортныеУпаковки.Колонки.Добавить("НомерУпаковки", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(18)));
		ТранспортныеУпаковки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,0)));
		
		СтруктураПоискаСостава = Новый Структура("ИдентификаторСтрокиТовара", ТекущиеДанные.ор_ИдентификаторСтроки);
		НайденныеСтрокиСостава = Объект[ИмяТЧСоставТУ].НайтиСтроки(СтруктураПоискаСостава);
		
		Для Каждого СтрокаСостава Из НайденныеСтрокиСостава Цикл
			СтруктураПоискаТУ = Новый Структура("ИдентификаторСтроки", СтрокаСостава.ИдентификаторСтроки);
			НайденныеСтрокиТУ = Объект[ИмяТЧТУ].НайтиСтроки(СтруктураПоискаТУ);
			Если НайденныеСтрокиТУ.Количество() > 0 Тогда
				НоваяСтрока = ТранспортныеУпаковки.Добавить();
				НоваяСтрока.НомерУпаковки = НайденныеСтрокиТУ[0].НомерУпаковки;
				НоваяСтрока.Количество = СтрокаСостава.Количество;
			КонецЕсли;
		КонецЦикла;
		
		ТранспортныеУпаковки.Свернуть("НомерУпаковки","Количество");
		СтруктураТаблиц.Вставить("ТранспортныеУпаковки", ТранспортныеУпаковки);
		
	КонецЕсли;
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(СтруктураТаблиц, УникальныйИдентификаторФормы);
	
	ПараметрыФормыУказания.Вставить("Номенклатура"          , ТекущиеДанные.Номенклатура);
	ПараметрыФормыУказания.Вставить("Характеристика"        , ТекущиеДанные.Характеристика);
	
	Количество = ТекущиеДанные.Количество * ПолучитьКоэффициентЕдиницыИзмерения(ТекущиеДанные.ЕдиницаИзмерения);
	ПараметрыФормыУказания.Вставить("Количество"            , Количество);
	ПараметрыФормыУказания.Вставить("ор_ИдентификаторСтроки", ТекущиеДанные.ор_ИдентификаторСтроки);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "ор_НомерСерииРецепта") Тогда
		ПараметрыФормыУказания.Вставить("НомерСерииРецепта", ТекущиеДанные.ор_НомерСерииРецепта);
		ПараметрыФормыУказания.Вставить("НомерРецепта", ТекущиеДанные.ор_НомерРецепта);
		ПараметрыФормыУказания.Вставить("ДатаРегистрацииРецепта", ТекущиеДанные.ор_ДатаРегистрацииРецепта);
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ор_ДатаРегистрацииРецепта) Тогда
			рСтруктураПоиска = Новый Структура("Номенклатура", ТекущиеДанные.Номенклатура);
			рНайденныеСтрокиТоваров = Объект[ИмяТЧТовары].НайтиСтроки(рСтруктураПоиска);
			
			Для Каждого рСтрокаМассива Из рНайденныеСтрокиТоваров Цикл
				Если ЗначениеЗаполнено(рСтрокаМассива.ор_ДатаРегистрацииРецепта) Тогда
					СтруктураРецепта = Новый Структура();
					СтруктураРецепта.Вставить("ДатаРегистрацииРецепта", рСтрокаМассива.ор_ДатаРегистрацииРецепта);
					СтруктураРецепта.Вставить("НомерРецепта", рСтрокаМассива.ор_НомерРецепта);
					СтруктураРецепта.Вставить("НомерСерииРецепта", рСтрокаМассива.ор_НомерСерииРецепта);
					ПараметрыФормыУказания.Вставить("ДанныеПредыдущегоРецепта",СтруктураРецепта);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормыУказания.Вставить("ИспользоватьТранспортныеУпаковки", ИспользоватьТранспортныеУпаковки);
	ПараметрыФормыУказания.Вставить("АдресВоВременномХранилище",АдресВоВременномХранилище);
	ПараметрыФормыУказания.Вставить("ТекущиеДанныеИдентификатор",ТекущиеДанныеИдентификатор);
	
	ИмяФормы = "ОбщаяФорма.ор_МДЛПФормаВводаНомеровУпаковок";
	ПараметрыФормыУказания.Вставить("ИмяФормы", ИмяФормы);
	
	Возврат ПараметрыФормыУказания;
	
КонецФункции

Процедура ЗаполнитьНомераУпаковок(Объект, ДополнительныеПараметры, Форма) Экспорт
	
	Результат                  = ДополнительныеПараметры.Результат;
	ТекущиеДанныеИдентификатор = ДополнительныеПараметры.ТекущиеДанныеИдентификатор;
	ИмяТЧТовары                = ДополнительныеПараметры.ИмяТЧТовары;
	ИмяТЧСерии                 = ДополнительныеПараметры.ИмяТЧСерии;
	ИмяТЧТУ                    = ДополнительныеПараметры.ИмяТЧТУ;
	ИмяТЧСоставТУ              = ДополнительныеПараметры.ИмяТЧСоставТУ;
	
	СтруктураТаблиц = ПолучитьИзВременногоХранилища(Результат.АдресВоВременномХранилище);
	
	ТекущиеДанные = Объект[ИмяТЧТовары].НайтиПоИдентификатору(ТекущиеДанныеИдентификатор);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "ор_НомерСерииРецепта") Тогда
		ТекущиеДанные.ор_НомерСерииРецепта = СтруктураТаблиц.НомерСерииРецепта;
		ТекущиеДанные.ор_НомерРецепта = СтруктураТаблиц.НомерРецепта;
		ТекущиеДанные.ор_ДатаРегистрацииРецепта = СтруктураТаблиц.ДатаРегистрацииРецепта;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ор_ИдентификаторСтроки);
	НайденныеСтрокиНомеров = Объект[ИмяТЧСерии].НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаМассива Из НайденныеСтрокиНомеров Цикл
		Объект[ИмяТЧСерии].Удалить(СтрокаМассива);
	КонецЦикла;
	
	ТаблицаНомеров = СтруктураТаблиц.ТаблицаНомеров;
	Для Каждого СтрокаМассива Из ТаблицаНомеров Цикл
		НоваяСтрока = Объект[ИмяТЧСерии].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
		НоваяСтрока.ИдентификаторСтроки = ТекущиеДанные.ор_ИдентификаторСтроки;
	КонецЦикла;
	
	Если ДополнительныеПараметры.ИспользоватьТранспортныеУпаковки Тогда
		
		// Удаляем строки состава по идентификатору строки товара.
		СтруктураПоискаСоставТУ = Новый Структура("ИдентификаторСтрокиТовара",ТекущиеДанные.ор_ИдентификаторСтроки);
		НайденныеСтрокиСоставаТУ = Объект[ИмяТЧСоставТУ].НайтиСтроки(СтруктураПоискаСоставТУ);
		Для Каждого СтрокаСоставаТУ Из НайденныеСтрокиСоставаТУ Цикл
			Объект[ИмяТЧСоставТУ].Удалить(СтрокаСоставаТУ);
		КонецЦикла;
		
		ТранспортныеУпаковки = СтруктураТаблиц.ТранспортныеУпаковки;
		Для Каждого СтрокаТУ Из ТранспортныеУпаковки Цикл
			
			СтруктураПоискаТУ = Новый Структура("НомерУпаковки", СтрокаТУ.НомерУпаковки);
			НайденныеСтрокиТУ = Объект[ИмяТЧТУ].НайтиСтроки(СтруктураПоискаТУ);
			
			Если НайденныеСтрокиТУ.Количество() > 0 Тогда
				СтрокаТУДокумент = НайденныеСтрокиТУ[0];
			Иначе
				СтрокаТУДокумент = Объект[ИмяТЧТУ].Добавить();
				СтрокаТУДокумент.НомерУпаковки = СтрокаТУ.НомерУпаковки;
				СтрокаТУДокумент.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			
			СтрокаСоставТУДокумент = Объект[ИмяТЧСоставТУ].Добавить();
			СтрокаСоставТУДокумент.Номенклатура   = ТекущиеДанные.Номенклатура;
			СтрокаСоставТУДокумент.Характеристика = ТекущиеДанные.Характеристика;
			СтрокаСоставТУДокумент.GTIN           = Результат.GTIN;
			СтрокаСоставТУДокумент.НомерСерии     = ТекущиеДанные.Характеристика.ор_СерияПроизводителя;
			СтрокаСоставТУДокумент.Количество     = СтрокаТУ.Количество;
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "Цена") Тогда
				Если ТекущиеДанные.Количество = 0 Тогда
					СтрокаСоставТУДокумент.Цена     = 0;
					СтрокаСоставТУДокумент.СуммаНДС = 0;
				Иначе
					СтрокаСоставТУДокумент.Цена     = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
					СтрокаСоставТУДокумент.СуммаНДС = ТекущиеДанные.СуммаНДС / ТекущиеДанные.Количество;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаСоставТУДокумент.ИдентификаторСтроки = СтрокаТУДокумент.ИдентификаторСтроки;
			СтрокаСоставТУДокумент.ИдентификаторСтрокиТовара = ТекущиеДанные.ор_ИдентификаторСтроки;
			
		КонецЦикла;
		
		ЗаполнитьТУПоСостауТУ(Объект, ИмяТЧТУ, ИмяТЧСоставТУ);
		
	КонецЕсли;
	
	ЗапрещенВводНесколькихУпаковок = ДополнительныеПараметры.Свойство("ЗапрещенВводНесколькихУпаковок");
	
	Если ЗапрещенВводНесколькихУпаковок Тогда
		Если ТекущиеДанные.Количество <> Результат.Количество
			И (ТекущиеДанные.Количество = 0
			ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ЕдиницаИзмерения)
			ИЛИ (ЗначениеЗаполнено(ТекущиеДанные.ЕдиницаИзмерения)
			и ТипЗнч(ТекущиеДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения"))) Тогда
			ТекущиеДанные.Количество = Результат.Количество;
		КонецЕсли;
	Иначе
		Если ТекущиеДанные.Количество <> Результат.Количество
			И Результат.Количество > 0
			И Результат.Количество > ТекущиеДанные.Количество Тогда
			ТекущиеДанные.Количество = Результат.Количество;
			Если ЗначениеЗаполнено(ТекущиеДанные.ЕдиницаИзмерения)
				И ТипЗнч(ТекущиеДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
				ТекущиеДанные.ЕдиницаИзмерения = ТекущиеДанные.Номенклатура.ЕдиницаИзмерения;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Форма.Модифицированность = Истина;
	
КонецПроцедуры

Функция ПолучитьПараметрыФормыЗаполненияНомеровУпаковок(Объект, Форма, ПараметрыФормыУказания, ИспользоватьТранспортныеУпаковки = Истина) Экспорт
	
	ИмяТЧТовары   = ПараметрыФормыУказания.ИмяТЧТовары;
	ИмяТЧСерии    = ПараметрыФормыУказания.ИмяТЧСерии;
	ИмяТЧТУ       = ПараметрыФормыУказания.ИмяТЧТУ;
	ИмяТЧСоставТУ = ПараметрыФормыУказания.ИмяТЧСоставТУ;
	
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	// Если нужно будет изменять количество, то данные формы нужно заблокировать.
	// Если заблокировать не удастся - вылетит исключение.
	Форма.ЗаблокироватьДанныеФормыДляРедактирования();
	
	// ВыгружаемТовары
	ТаблицаТоваров = Объект[ИмяТЧТовары].Выгрузить();
	Если ТаблицаТоваров.Количество() = 0 Тогда
		ПараметрыФормыУказания.Вставить("Отказ");
		Возврат ПараметрыФормыУказания;
	КонецЕсли;
	
	// Получаем количество единиц товара
	Для Каждого Строка Из ТаблицаТоваров Цикл
		Строка.Количество = Строка.Количество * ПолучитьКоэффициентЕдиницыИзмерения(Строка.ЕдиницаИзмерения);
	КонецЦикла;
	
	// Выгружаем таблицы
	ТаблицаНомеров = Объект[ИмяТЧСерии].Выгрузить();
	Если ИспользоватьТранспортныеУпаковки Тогда
		ТаблицаТУ = Объект[ИмяТЧТУ].Выгрузить();
		ТаблицаСоставТУ = Объект[ИмяТЧСоставТУ].Выгрузить();
	КонецЕсли;
	
	// формируем параметры
	Структурапараметров = Новый Структура;
	Структурапараметров.Вставить("ТаблицаТоваров", ТаблицаТоваров);
	Структурапараметров.Вставить("ТаблицаНомеров", ТаблицаНомеров);
	
	Если ИспользоватьТранспортныеУпаковки Тогда
		Структурапараметров.Вставить("ТаблицаТУ", ТаблицаТУ);
		Структурапараметров.Вставить("ТаблицаСоставТУ", ТаблицаСоставТУ);
	КонецЕсли;
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Структурапараметров, УникальныйИдентификаторФормы);
	
	ПараметрыФормыУказания.Вставить("АдресВоВременномХранилище", АдресВоВременномХранилище);
	ПараметрыФормыУказания.Вставить("ИмяФормы", "ОбщаяФорма.ор_МДЛПЗаполнитьНомераУпаковок");
	ПараметрыФормыУказания.Вставить("ИспользоватьТранспортныеУпаковки", ИспользоватьТранспортныеУпаковки);
	
	Возврат ПараметрыФормыУказания;
	
КонецФункции

Процедура ЗаполнитьТоварыИНомераУпаковок(Объект, ДополнительныеПараметры, Форма, СтруктураДействий = Неопределено) Экспорт
	
	Результат   = ДополнительныеПараметры.Результат;
	ИмяТЧТовары = ДополнительныеПараметры.ИмяТЧТовары;
	ИмяТЧСерии  = ДополнительныеПараметры.ИмяТЧСерии;
	ИмяТЧТУ       = ДополнительныеПараметры.ИмяТЧТУ;
	ИмяТЧСоставТУ = ДополнительныеПараметры.ИмяТЧСоставТУ;
	
	Структурапараметров = ПолучитьИзВременногоХранилища(Результат.АдресВоВременномХранилище);
	ТаблицаТоваров = Структурапараметров.ТаблицаТоваров;
	ТаблицаНомеров = Структурапараметров.ТаблицаНомеров;
	ТаблицаТУ = Структурапараметров.ТаблицаТУ;
	ТаблицаСоставТУ = Структурапараметров.ТаблицаСоставТУ;
	
	// Заполнение номеров упаковок
	Объект[ИмяТЧСерии].Очистить();
	Для Каждого СтрокаМассива Из ТаблицаНомеров Цикл
		НоваяСтрока = Объект[ИмяТЧСерии].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	Если ДополнительныеПараметры.ИспользоватьТранспортныеУпаковки Тогда
		
		// Удаляем строки состава ТУ по идентификатору строки товара.
		Для Каждого СтрокаТоваров Из Объект[ИмяТЧТовары] Цикл
			СтруктураПоискаСоставТУ = Новый Структура("ИдентификаторСтрокиТовара",СтрокаТоваров.ор_ИдентификаторСтроки);
			НайденныеСтрокиСоставаТУ = Объект[ИмяТЧСоставТУ].НайтиСтроки(СтруктураПоискаСоставТУ);
			Для Каждого СтрокаСоставаТУ Из НайденныеСтрокиСоставаТУ Цикл
				Объект[ИмяТЧСоставТУ].Удалить(СтрокаСоставаТУ);
			КонецЦикла;
		КонецЦикла;
		
		// Добавляем новые ТУ
		Для Каждого СтрокаТУ Из ТаблицаТУ Цикл
			СтруктураПоискаТУ = Новый Структура("НомерУпаковки", СтрокаТУ.НомерУпаковки);
			НайденныеСтрокиТУ = Объект[ИмяТЧТУ].НайтиСтроки(СтруктураПоискаТУ);
			Если НайденныеСтрокиТУ.Количество() = 0 Тогда
				НоваяСтрока = Объект[ИмяТЧТУ].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТУ);
			КонецЕсли;
		КонецЦикла;
		
		// Добавляем состав ТУ
		Для Каждого СтрокаМассива Из ТаблицаСоставТУ Цикл
			НоваяСтрока = Объект[ИмяТЧСоставТУ].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "Цена") Тогда
				НайденныеСтроки = Объект[ИмяТЧТовары].НайтиСтроки(Новый Структура("ор_ИдентификаторСтроки", НоваяСтрока.ИдентификаторСтрокиТовара));
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекущиеДанныеТовара = НайденныеСтроки[0];
					Если ТекущиеДанныеТовара.Количество = 0 Тогда
						НоваяСтрока.Цена     = 0;
						НоваяСтрока.СуммаНДС = 0;
					Иначе
						НоваяСтрока.Цена     = ТекущиеДанныеТовара.Сумма / ТекущиеДанныеТовара.Количество;
						НоваяСтрока.СуммаНДС = ТекущиеДанныеТовара.СуммаНДС / ТекущиеДанныеТовара.Количество;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ЗаполнитьТУПоСостауТУ(Объект, ИмяТЧТУ, ИмяТЧСоставТУ);
		
	КонецЕсли;
	
	// Заполнение товаров
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		НайденныеСтроки = Объект[ИмяТЧТовары].НайтиСтроки(Новый Структура("ор_ИдентификаторСтроки", СтрокаТоваров.ор_ИдентификаторСтроки));
		ТекущиеДанные = НайденныеСтроки[0];
		Если ТекущиеДанные.Количество <> СтрокаТоваров.Количество
			И СтрокаТоваров.Количество > 0 Тогда
			ТекущиеДанные.Количество = СтрокаТоваров.Количество;
			Если ТипЗнч(ТекущиеДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
				ТекущиеДанные.ЕдиницаИзмерения = ТекущиеДанные.Номенклатура.ЕдиницаИзмерения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Форма.Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеНомеровУпаковокПоУведомлению

Функция ПолучитьПараметрыФормыЗаполненияНомеровУпаковокПоУведомлению(Объект, Форма, ПараметрыФормыУказания) Экспорт
	
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	// Если нужно будет изменять количество, то данные формы нужно заблокировать.
	// Если заблокировать не удастся - вылетит исключение.
	Форма.ЗаблокироватьДанныеФормыДляРедактирования();
	
	// формируем параметры
	Структурапараметров = Новый Структура;
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Структурапараметров, УникальныйИдентификаторФормы);
	
	ПараметрыФормыУказания.Вставить("АдресВоВременномХранилище",АдресВоВременномХранилище);
	ПараметрыФормыУказания.Вставить("ОснованиеСсылка", Объект.Ссылка);
	ПараметрыФормыУказания.Вставить("ИмяФормы", "ОбщаяФорма.ор_МДЛПЗаполнитьПоУведомлению");
	
	Возврат ПараметрыФормыУказания;
	
КонецФункции

Процедура ЗаполнитьТоварыИНомераУпаковокПоУведомлению(Объект, ДополнительныеПараметры, Форма) Экспорт
	
	Результат     = ДополнительныеПараметры.Результат;
	ИмяТЧТовары   = ДополнительныеПараметры.ИмяТЧТовары;
	ИмяТЧСерии    = ДополнительныеПараметры.ИмяТЧСерии;
	ИмяТЧТУ       = ДополнительныеПараметры.ИмяТЧТУ;
	ИмяТЧСоставТУ = ДополнительныеПараметры.ИмяТЧСоставТУ;
	
	Структурапараметров = ПолучитьИзВременногоХранилища(Результат.АдресВоВременномХранилище);
	
	ТаблицаТоваров = Структурапараметров.ТаблицаТоваров;
	ТаблицаНомеров = Структурапараметров.ТаблицаНомеров;
	ТаблицаТранспортныхУпаковок = Структурапараметров.ТаблицаТранспортныхУпаковок;
	ТаблицаСоставаТранспортныхУпаковок = Структурапараметров.ТаблицаСоставаТранспортныхУпаковок;
	
	// Заполнение товаров
	Объект[ИмяТЧТовары].Очистить();
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		НоваяСтрока = Объект[ИмяТЧТовары].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваров);
		НоваяСтрока.ор_ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
		НоваяСтрока.Количество = СтрокаТоваров.КоличествоУпаковок;
	КонецЦикла;
	
	// Заполнение номеров упаковок
	Объект[ИмяТЧСерии].Очистить();
	Для Каждого СтрокаМассива Из ТаблицаНомеров Цикл
		НоваяСтрока = Объект[ИмяТЧСерии].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	// Заполнение номеров упаковок
	Объект[ИмяТЧТУ].Очистить();
	Для Каждого СтрокаМассива Из ТаблицаТранспортныхУпаковок Цикл
		НоваяСтрока = Объект[ИмяТЧТУ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	// Заполнение номеров упаковок
	Объект[ИмяТЧСоставТУ].Очистить();
	Для Каждого СтрокаМассива Из ТаблицаСоставаТранспортныхУпаковок Цикл
		НоваяСтрока = Объект[ИмяТЧСоставТУ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
		НоваяСтрока.НомерСерии = СтрокаМассива.СерияПроизводителя;
	КонецЦикла;
	
	Для Каждого Строка Из ТаблицаСоставаТранспортныхУпаковок Цикл
		НоваяСтрока = Объект[ИмяТЧТовары].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ор_ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЦикла;
	
	ЗаполнитьТУПоСостауТУ(Объект, ИмяТЧТУ, ИмяТЧСоставТУ);
	
	Форма.Модифицированность = Истина;
	
КонецПроцедуры

Функция ПолучитьПараметрыФормыСопоставленияНомеровУпаковокПоУведомлению(Объект, Форма, ПараметрыФормыУказания, ЭтоУведомление = Ложь) Экспорт
	
	ИмяТЧТовары   = ПараметрыФормыУказания.ИмяТЧТовары;
	ИмяТЧСерии    = ПараметрыФормыУказания.ИмяТЧСерии;
	ИмяТЧТУ       = ПараметрыФормыУказания.ИмяТЧТУ;
	ИмяТЧСоставТУ = ПараметрыФормыУказания.ИмяТЧСоставТУ;
	
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	// Если нужно будет изменять количество, то данные формы нужно заблокировать.
	// Если заблокировать не удастся - вылетит исключение.
	Форма.ЗаблокироватьДанныеФормыДляРедактирования();
	
	// формируем параметры
	Структурапараметров = Новый Структура;
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Структурапараметров, УникальныйИдентификаторФормы);
	
	ПараметрыФормыУказания.Вставить("АдресВоВременномХранилище",АдресВоВременномХранилище);
	Если ЭтоУведомление Тогда
		ПараметрыФормыУказания.Вставить("УведомлениеСсылка", Объект.Ссылка);
	Иначе
		ПараметрыФормыУказания.Вставить("ОснованиеСсылка", Объект.Ссылка);
	КонецЕсли;
	ПараметрыФормыУказания.Вставить("ФормаОткрытаИзУведомления", ЭтоУведомление);
	ПараметрыФормыУказания.Вставить("ИмяФормы", "ОбщаяФорма.ор_МДЛПСопоставленияНомераУпаковокПоУведомлению");
	
	Возврат ПараметрыФормыУказания;
	
КонецФункции

Процедура СопоставитьТоварыИНомераУпаковокПоУведомлению(Объект, ДополнительныеПараметры, Форма) Экспорт
	
	Результат   = ДополнительныеПараметры.Результат;
	
	ИмяТЧСерии    = ДополнительныеПараметры.ИмяТЧСерии;
	ИмяТЧТУ       = ДополнительныеПараметры.ИмяТЧТУ;
	ИмяТЧСоставТУ = ДополнительныеПараметры.ИмяТЧСоставТУ;
	
	Структурапараметров = ПолучитьИзВременногоХранилища(Результат.АдресВоВременномХранилище);
	ТаблицаНомеров                     = Структурапараметров.ТаблицаНомеров;
	ТаблицаТранспортныхУпаковок        = Структурапараметров.ТаблицаТранспортныхУпаковок;
	ТаблицаСоставаТранспортныхУпаковок = Структурапараметров.ТаблицаСоставаТранспортныхУпаковок;
	
	// Заполнение номеров упаковок
	Объект[ИмяТЧСерии].Очистить();
	Для Каждого СтрокаМассива Из ТаблицаНомеров Цикл
		НоваяСтрока = Объект[ИмяТЧСерии].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	// Заполнение номеров упаковок
	Объект[ИмяТЧТУ].Очистить();
	Для Каждого СтрокаМассива Из ТаблицаТранспортныхУпаковок Цикл
		НоваяСтрока = Объект[ИмяТЧТУ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	// Заполнение номеров упаковок
	Объект[ИмяТЧСоставТУ].Очистить();
	Для Каждого СтрокаМассива Из ТаблицаСоставаТранспортныхУпаковок Цикл
		НоваяСтрока = Объект[ИмяТЧСоставТУ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	ЗаполнитьТУПоСостауТУ(Объект, ИмяТЧТУ, ИмяТЧСоставТУ);
	
	Форма.Модифицированность = Результат.МодифицированностьВладельца;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСоставаТранспортнойУпаковки

Функция ПолучитьПараметрыФормыЗаполненияСоставаТранспортнойУпаковки(Объект, Форма, ПараметрыФормыУказания) Экспорт
	
	ИмяТЧТовары   = ПараметрыФормыУказания.ИмяТЧТовары;
	ИмяТЧСерии    = ПараметрыФормыУказания.ИмяТЧСерии;
	ИмяТЧТУ       = ПараметрыФормыУказания.ИмяТЧТУ;
	ИмяТЧСоставТУ = ПараметрыФормыУказания.ИмяТЧСоставТУ;
	
	ТекущиеДанныеИдентификатор = ПараметрыФормыУказания.ТекущиеДанныеИдентификатор;
	
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	// Если нужно будет изменять количество, то данные формы нужно заблокировать.
	// Если заблокировать не удастся - вылетит исключение.
	Форма.ЗаблокироватьДанныеФормыДляРедактирования();
	
	ТекущиеДанные = Объект[ИмяТЧТУ].НайтиПоИдентификатору(ТекущиеДанныеИдентификатор);
	
	ЭтоОрдер = Ложь;
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПриходныйОрдер")
		ИЛИ ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		ЭтоОрдер = Истина;
	КонецЕсли;
	
	СуммаВключаетНДС = Ложь;
	
	Если НЕ ЭтоОрдер Тогда
		СтруктурапересчетаНДС = Новый Структура;
		СтруктурапересчетаНДС.Вставить("Дата" , Объект.Дата);
		СтруктурапересчетаНДС.Вставить("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиница);
		СтруктурапересчетаНДС.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
		СтруктурапересчетаНДС.Вставить("Организация"    , Объект.Организация);
		СтруктурапересчетаНДС.Вставить("НалогообложениеНДС", Объект.НалогообложениеНДС);
		СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	КонецЕсли;
	
	ТаблицаТоваров = Объект[ИмяТЧТовары].Выгрузить();
	
	МассивСтрокДляУдаления = Новый Массив;
	
	Для Каждого Строка Из ТаблицаТоваров Цикл
		
		Если НЕ Строка.Номенклатура.КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров Тогда
			МассивСтрокДляУдаления.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Строка.Характеристика) Тогда
			МассивСтрокДляУдаления.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		
		Строка.Количество = Строка.Количество * ПолучитьКоэффициентЕдиницыИзмерения(Строка.ЕдиницаИзмерения);
		
		ПересчитыватьСуммы = Ложь;
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтроки", Строка.ор_ИдентификаторСтроки);
		НайденныеСтрокиНомеров = Объект[ИмяТЧСерии].НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтрокиНомеров.Количество() > 0 Тогда
			Строка.Количество = Строка.Количество - НайденныеСтрокиНомеров.Количество();
			ПересчитыватьСуммы = Истина;
		КонецЕсли;
		
		Если Строка.Количество <= 0 Тогда
			МассивСтрокДляУдаления.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТовара", Строка.ор_ИдентификаторСтроки);
		НайденныеСтрокиНомеров = Объект[ИмяТЧСоставТУ].НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаСостава Из НайденныеСтрокиНомеров Цикл
			
			СтруктураПоискаТУ = Новый Структура("ИдентификаторСтроки", СтрокаСостава.ИдентификаторСтроки);
			НайденныеСтрокиТУ = Объект[ИмяТЧТУ].НайтиСтроки(СтруктураПоискаТУ);
			
			Если НайденныеСтрокиТУ.Количество() > 0 И НайденныеСтрокиТУ[0].НомерУпаковки <> ТекущиеДанные.НомерУпаковки  Тогда
				Строка.Количество = Строка.Количество - СтрокаСостава.Количество;
				ПересчитыватьСуммы = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Строка.Количество <= 0 Тогда
			МассивСтрокДляУдаления.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЭтоОрдер И ПересчитыватьСуммы Тогда
			ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(Строка, СтруктурапересчетаНДС);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементМассива Из МассивСтрокДляУдаления Цикл
		ТаблицаТоваров.Удалить(ЭлементМассива);
	КонецЦикла;
	
	Если ТаблицаТоваров.Количество() = 0 Тогда
		ПараметрыФормыУказания.Вставить("ТекстОшибки", НСтр("ru = 'Нет данных для заполнения.'"));
		ПараметрыФормыУказания.Вставить("Отказ");
		Возврат ПараметрыФормыУказания;
	КонецЕсли;
	
	// формируем параметры
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ТаблицаТоваров, УникальныйИдентификаторФормы);
	
	ПараметрыФормыУказания.Вставить("НомерУпаковки"            , ТекущиеДанные.НомерУпаковки);
	ПараметрыФормыУказания.Вставить("ИдентификаторСтроки"      , ТекущиеДанные.ИдентификаторСтроки);
	
	ПараметрыФормыУказания.Вставить("АдресВоВременномХранилище" , АдресВоВременномХранилище);
	ПараметрыФормыУказания.Вставить("ТекущиеДанныеИдентификатор", ТекущиеДанныеИдентификатор);
	ПараметрыФормыУказания.Вставить("СуммаВключаетНДС"          , СуммаВключаетНДС);
	ПараметрыФормыУказания.Вставить("ЭтоОрдер"                  , ЭтоОрдер);
	ПараметрыФормыУказания.Вставить("ИмяФормы"                  , "ОбщаяФорма.ор_МДЛПЗаполнениеСоставаТранспортнойУпаковки");
	
	Возврат ПараметрыФормыУказания;
	
КонецФункции

Процедура ЗаполнитьСоставТранспортныхУпаковок(Объект, ДополнительныеПараметры, Форма, СтруктураДействий = Неопределено) Экспорт
	
	Результат                  = ДополнительныеПараметры.Результат;
	ТекущиеДанныеИдентификатор = ДополнительныеПараметры.ТекущиеДанныеИдентификатор;
	
	ИмяТЧТУ       = ДополнительныеПараметры.ИмяТЧТУ;
	ИмяТЧСоставТУ = ДополнительныеПараметры.ИмяТЧСоставТУ;
	
	ТекущиеДанные = Объект[ИмяТЧТУ].НайтиПоИдентификатору(ТекущиеДанныеИдентификатор);
	
	// Удаляем строки состава ТУ
	СтруктураПоиска = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	НайденныеСтрокиСостава = Объект[ИмяТЧСоставТУ].НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаМассива Из НайденныеСтрокиСостава Цикл
		Объект[ИмяТЧСоставТУ].Удалить(СтрокаМассива);
	КонецЦикла;
	
	ТаблицаСостава = ПолучитьИзВременногоХранилища(Результат.АдресВоВременномХранилище);
	
	Для Каждого СтрокаМассива Из ТаблицаСостава Цикл
		НоваяСтрока = Объект[ИмяТЧСоставТУ].Добавить();
		
		НоваяСтрока.Номенклатура   = СтрокаМассива.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаМассива.Характеристика;
		НоваяСтрока.GTIN           = СтрокаМассива.GTIN;
		НоваяСтрока.НомерСерии     = СтрокаМассива.НомерСерии;
		НоваяСтрока.Количество     = СтрокаМассива.Количество;
		
		Если СтрокаМассива.Количество = 0 Тогда
			НоваяСтрока.Цена           = 0;
			НоваяСтрока.СуммаНДС       = 0;
		ИначеЕсли СтрокаМассива.КоличествоВТоварах = 0 Тогда
			НоваяСтрока.Цена           = 0;
			НоваяСтрока.СуммаНДС       = 0;
		Иначе
			НоваяСтрока.Цена           = СтрокаМассива.Сумма / СтрокаМассива.КоличествоВТоварах;
			НоваяСтрока.СуммаНДС       = СтрокаМассива.СуммаНДС / СтрокаМассива.КоличествоВТоварах;
		КонецЕсли;
		
		НоваяСтрока.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
		НоваяСтрока.ИдентификаторСтрокиТовара = СтрокаМассива.ор_ИдентификаторСтроки;
		
	КонецЦикла;
	
	ЗаполнитьТУПоСостауТУ(Объект, ИмяТЧТУ, ИмяТЧСоставТУ);
	
КонецПроцедуры

Процедура ЗаполнитьТУПоСостауТУ(Объект, ИмяТЧТУ, ИмяТЧСоставТУ)
	
	Для Каждого СтрокаТУ Из Объект[ИмяТЧТУ] Цикл
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТУ, "Цена") Тогда
			
			НайденныеСтрокиСостава = Объект[ИмяТЧСоставТУ].НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТУ.ИдентификаторСтроки));
			
			Если НайденныеСтрокиСостава.Количество() > 1 Тогда
				СтрокаТУ.Цена = 0;
				СтрокаТУ.СуммаНДС = 0;
			ИначеЕсли НайденныеСтрокиСостава.Количество() = 1 Тогда
				СтрокаТУ.Цена = НайденныеСтрокиСостава[0].Цена;
				СтрокаТУ.СуммаНДС = НайденныеСтрокиСостава[0].СуммаНДС;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


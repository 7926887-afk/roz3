	Запрос.УстановитьПараметр("СписокНомеровУпаковок" , СписокНомеровУпаковок);
	Запрос.УстановитьПараметр("Ссылка"                , ДанныеЗаполнения);
	Запрос.УстановитьПараметр("ОснованиеСсылка"       , ОснованиеСсылка);
	Запрос.УстановитьПараметр("ЭтоОрдер"              , ЭтоОрдер);
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка                      = Результат[0].Выгрузить();
	РезультатТовары                     = Результат[3].Выгрузить();
	РезультатНомера                     = Результат[4].Выгрузить();
	РезультатТранспортныеУпаковки       = Результат[5].Выгрузить();
	РезультатСоставТранспортныхУпаковок = Результат[6].Выгрузить();
	РезультатТоварыДляОрдера            = Результат[7].Выгрузить();
	
	Шапка = РезультатШапка[0];
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДокументОбъект.Основание = ОснованиеСсылка;
	
	Если Шапка.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратКомитенту Тогда
		ДокументОбъект.Операция = Перечисления.ОперацииОтгрузкиМДЛП.ОтгрузкаВРамкахАгентскогоДоговора;
		ДокументОбъект.ТипОперации = Перечисления.ТипыОперацийОтгрузкиМДЛП.Возврат;
	ИначеЕсли Шапка.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратПоставщику Тогда
		ДокументОбъект.Операция = Перечисления.ОперацииОтгрузкиМДЛП.Возврат;
		ДокументОбъект.ТипОперации = Перечисления.ТипыОперацийОтгрузкиМДЛП.Возврат;
	Иначе
		ДокументОбъект.Операция = Перечисления.ОперацииОтгрузкиМДЛП.Продажа;
		ДокументОбъект.ТипОперации = Перечисления.ТипыОперацийОтгрузкиМДЛП.Продажа;
	КонецЕсли;
	
	ДокументОбъект.ТипДоговора            = Перечисления.ТипыДоговоровМДЛП.КупляПродажа;
	ДокументОбъект.ИсточникФинансирования = Перечисления.ИсточникиФинансированияМДЛП.СобственныеСредства;
	ДокументОбъект.СхемаАкцептования      = Перечисления.СхемыАкцептованияМДЛП.ПрямойПорядок;
	
	СтруктураОрганизацииМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Организация, Шапка.СтруктурнаяЕдиница, Истина);
	СтруктураКонтрагентаМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Контрагент, Справочники.СтруктурныеЕдиницы.ПустаяСсылка(), Ложь);
	
	ДокументОбъект.Организация                      = СтруктураОрганизацииМДЛП.Организация;
	ДокументОбъект.МестоДеятельности                = СтруктураОрганизацииМДЛП.МестоДеятельности;
	ДокументОбъект.Грузополучатель                  = СтруктураКонтрагентаМДЛП.Организация;
	ДокументОбъект.МестоДеятельностиГрузополучателя = СтруктураКонтрагентаМДЛП.МестоДеятельности;
	
	Для Каждого Строка Из РезультатТовары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.КоличествоНомеровУпаковок <> НоваяСтрока.Количество
			ИЛИ ЭтоОрдер Тогда
			
			Если ЭтоОрдер Тогда
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
				СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
				СтруктураПоиска.Вставить("Упаковка", Строка.Упаковка);
				
				НайденныеСтроки = РезультатТоварыДляОрдера.НайтиСтроки(СтруктураПоиска);
				
				Если НайденныеСтроки.Количество() = 1 Тогда
					НайденнаяСтрока = НайденныеСтроки[0];
					НоваяСтрока.Цена = НайденнаяСтрока.Цена;
					Строка.СтавкаНДС = НайденнаяСтрока.СтавкаНДС;
				КонецЕсли;
				
			КонецЕсли;
			
			НоваяСтрока.Количество = Строка.КоличествоНомеровУпаковок;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.Упаковка);
			
			НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
			СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(Строка.СтавкаНДС);
			
			НоваяСтрока.СуммаНДС = ?(Шапка.СуммаВключаетНДС, 
									  НоваяСтрока.Сумма - (НоваяСтрока.Сумма) / ((СтавкаНДС + 100) / 100),
									  НоваяСтрока.Сумма * СтавкаНДС / 100);
			
		КонецЕсли;
		
		Если НЕ Шапка.СуммаВключаетНДС И НоваяСтрока.СуммаНДС <> 0 Тогда
			
			НоваяСтрока.Сумма = НоваяСтрока.Сумма + НоваяСтрока.СуммаНДС;
			НоваяСтрока.Цена  = Окр(НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок, 2);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	КонецЦикла;
	
	Для Каждого Строка Из РезультатТранспортныеУпаковки Цикл
		НоваяСтрока = ДокументОбъект.ТранспортныеУпаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	КонецЦикла;
	
	Для Каждого Строка Из РезультатСоставТранспортныхУпаковок Цикл
		НоваяСтрока = ДокументОбъект.СоставТранспортныхУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если НЕ Шапка.СуммаВключаетНДС И НоваяСтрока.СуммаНДС <> 0 Тогда
			
			Сумма = Строка.Сумма + Строка.СуммаНДС;
			НоваяСтрока.Цена  = Окр(Сумма / Строка.Количество, 2);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛППоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		ОснованиеСсылка = ДанныеЗаполнения.ДокументОснование;
		ЭтоОрдер = Истина;
	Иначе
		ОснованиеСсылка = ДанныеЗаполнения;
		ЭтоОрдер = Ложь;
	КонецЕсли;
	
	СписокНомеровУпаковок = ПолучитьСписокНомеровУпаковкоУведомленийПоОснованию(ОснованиеСсылка, Метаданные.Документы.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Шапка.Номер КАК НомерДокумента,
	|	Шапка.Дата КАК ДатаДокумента,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.Дата КАК Дата,
	|	Шапка.ВидОперации КАК ВидОперации
	|ИЗ
	|	Документ.РасходнаяНакладная КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &ОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	ВЫРАЗИТЬ(Товары.Сумма / Товары.Количество КАК ЧИСЛО(15, 2)) КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).ор_КоличествоПервичныхУпаковок
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПервичныхУпаковокВоВторичной,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПервичныхУпаковок,
	|	1 КАК КоличествоНомеровУпаковок
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.РасходнаяНакладная.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В (&СписокНомеровУпаковок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Количество,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ,
	|	Товары.ЕдиницаИзмерения,
	|	0,
	|	0,
	|	0,
	|	НЕОПРЕДЕЛЕНО,
	|	Товары.ор_ИдентификаторСтроки,
	|	НомераУпаковок.НомерКИЗ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).ор_КоличествоПервичныхУпаковок
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	1
	|ИЗ
	|	Документ.РасходныйОрдер.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдер.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В (&СписокНомеровУпаковок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.Цена КАК Цена,
	|	втТовары.СуммаНДС КАК СуммаНДС,
	|	втТовары.СтавкаНДС КАК СтавкаНДС,
	|	втТовары.Сумма КАК Сумма,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	втТовары.КоличествоПервичныхУпаковокВоВторичной КАК КоличествоПервичныхУпаковокВоВторичной,
	|	СУММА(втТовары.КоличествоНомеровУпаковок) КАК КоличествоНомеровУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика,
	|	втТовары.Количество,
	|	втТовары.КоличествоУпаковок,
	|	втТовары.Упаковка,
	|	втТовары.Цена,
	|	втТовары.СуммаНДС,
	|	втТовары.СтавкаНДС,
	|	втТовары.Сумма,
	|	втТовары.КоличествоПервичныхУпаковокВоВторичной,
	|	втТовары.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерКИЗ КАК НомерКИЗ,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	втТовары.Цена КАК Цена,
	|	втТовары.СуммаНДС КАК СуммаНДС,
	|	втТовары.КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	ВЫРАЗИТЬ(Товары.Сумма / Товары.Количество КАК ЧИСЛО(15, 2)) КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.РасходнаяНакладная.Запасы КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &ОснованиеСсылка
	|	И &ЭтоОрдер";
	Запрос.УстановитьПараметр("СписокНомеровУпаковок" , СписокНомеровУпаковок);
	Запрос.УстановитьПараметр("Ссылка"                , ДанныеЗаполнения);
	Запрос.УстановитьПараметр("ОснованиеСсылка"       , ОснованиеСсылка);
	Запрос.УстановитьПараметр("ЭтоОрдер"              , ЭтоОрдер);
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка           = Результат[0].Выгрузить();
	РезультатТовары          = Результат[2].Выгрузить();
	РезультатНомера          = Результат[3].Выгрузить();
	РезультатТоварыДляОрдера = Результат[4].Выгрузить();
	
	Шапка = РезультатШапка[0];
	
	ДокументОбъект.Основание = ОснованиеСсылка;
	СтруктураОрганизацииМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Организация, Шапка.СтруктурнаяЕдиница, Истина);
	СтруктураКонтрагентаМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Контрагент, Справочники.СтруктурныеЕдиницы.ПустаяСсылка(), Ложь);
	
	ДокументОбъект.Организация            = СтруктураОрганизацииМДЛП.Организация;
	ДокументОбъект.МестоДеятельности      = СтруктураОрганизацииМДЛП.МестоДеятельности;
	ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	
	ИдентификаторДокумента = Новый УникальныйИдентификатор;
	
	НоваяСтрокаДокументапродажи = ДокументОбъект.ДокументыПродажи.Добавить();
	НоваяСтрокаДокументапродажи.НомерДокумента         = Шапка.НомерДокумента;
	НоваяСтрокаДокументапродажи.ДатаДокумента          = Шапка.ДатаДокумента;
	НоваяСтрокаДокументапродажи.ИдентификаторДокумента = ИдентификаторДокумента;
	
	Для Каждого Строка Из РезультатТовары Цикл
		
		Если Строка.КоличествоНомеровУпаковок <> Строка.Количество
			ИЛИ ЭтоОрдер Тогда
			
			Если ЭтоОрдер Тогда
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
				СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
				СтруктураПоиска.Вставить("Упаковка", Строка.Упаковка);
				
				НайденныеСтроки = РезультатТоварыДляОрдера.НайтиСтроки(СтруктураПоиска);
				
				Если НайденныеСтроки.Количество() = 1 Тогда
					НайденнаяСтрока = НайденныеСтроки[0];
					Строка.Цена = НайденнаяСтрока.Цена;
					Строка.СтавкаНДС = НайденнаяСтрока.СтавкаНДС;
				КонецЕсли;
				
			КонецЕсли;
			
			Строка.Количество = Строка.КоличествоНомеровУпаковок;
			Строка.КоличествоУпаковок = Строка.Количество/ПолучитьКоэффициентЕдиницыИзмерения(Строка.Упаковка);
			
			Строка.Сумма = Строка.Цена * Строка.КоличествоУпаковок;
			СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(Строка.СтавкаНДС);
			
			Строка.СуммаНДС = ?(Шапка.СуммаВключаетНДС, 
				Строка.Сумма - (Строка.Сумма) / ((СтавкаНДС + 100) / 100),
				Строка.Сумма * СтавкаНДС / 100);
			
		КонецЕсли;
		
		Если НЕ Шапка.СуммаВключаетНДС И Строка.СуммаНДС <> 0 Тогда
			
			Строка.Сумма = Строка.Сумма + Строка.СуммаНДС;
			Строка.Цена  = Окр(Строка.Сумма / Строка.КоличествоУпаковок, 2);
			
		КонецЕсли;
		
	КонецЦикла;

	Для Каждого Строка Из РезультатТовары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.ИдентификаторДокумента = ИдентификаторДокумента;
		
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		
		НайденныеСтроки = РезультатТовары.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			НоваяСтрока.Цена = НайденнаяСтрока.Цена;
		КонецЕсли;
		
	КонецЦикла;
	
	ИменаКолонок = "ИдентификаторСтроки,СуммаНДС";
	РезультатНомераСвернутая = РезультатТовары.Скопировать(,ИменаКолонок);
	РезультатНомераСвернутая.Свернуть(ИменаКолонок);
	Для Каждого СтрокаСвернутая Из РезультатНомераСвернутая Цикл
		
		СуммаНДСОбщая = СтрокаСвернутая.СуммаНДС;
		СуммаНДСРасчетная = 0;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ИдентификаторСтроки", СтрокаСвернутая.ИдентификаторСтроки);
		НайденныеСтроки = ДокументОбъект.НомераУпаковок.НайтиСтроки(СтруктураПоиска);
		
		КоличествоСтрок      = НайденныеСтроки.Количество();
		КоличествоОбработано = 0;
		
		Если КоличествоСтрок = 1 Тогда
			НайденныеСтроки[0].СуммаНДС = СуммаНДСОбщая;
			Продолжить;
		КонецЕсли;
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			КоличествоОбработано = КоличествоОбработано + 1;
			
			Если КоличествоОбработано = КоличествоСтрок Тогда
				Строка.СуммаНДС = СуммаНДСОбщая - СуммаНДСРасчетная;
			Иначе
				Строка.СуммаНДС = Формат(СуммаНДСОбщая/КоличествоСтрок, "ЧЦ=15; ЧДЦ=2");
				СуммаНДСРасчетная = СуммаНДСРасчетная + Строка.СуммаНДС;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУведомлениеОВыбытииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокНомеровУпаковок = ПолучитьСписокНомеровУпаковкоУведомленийПоОснованию(ДанныеЗаполнения, Метаданные.Документы.УведомлениеОВыбытииМДЛП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Шапка.Номер КАК НомерДокумента,
	|	Шапка.Дата КАК ДатаДокумента,
	|	Шапка.Организация КАК Организация,
	|	Шапка.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
	|ИЗ
	|	Документ.СписаниеЗапасов КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Шапка.Номер,
	|	Шапка.Дата,
	|	Шапка.Организация,
	|	Шапка.СтруктурнаяЕдиница
	|ИЗ
	|	Документ.ор_ИзготовлениеЛекарственныхФорм КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Шапка.Номер,
	|	Шапка.Дата,
	|	Шапка.Организация,
	|	Шапка.СтруктурнаяЕдиница
	|ИЗ
	|	Документ.КомплектацияЗапасов КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	// 1
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок,
	|	НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	1 КАК КоличествоНомеровУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ор_КоличествоПервичныхУпаковок
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.СписаниеЗапасов.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЗапасов.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В(&СписокНомеровУпаковок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Количество,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ,
	|	Товары.ЕдиницаИзмерения,
	|	Товары.ор_ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок,
	|	НомераУпаковок.НомерКИЗ,
	|	1,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	Документ.ор_ИзготовлениеЛекарственныхФорм.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ор_ИзготовлениеЛекарственныхФорм.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В(&СписокНомеровУпаковок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Количество,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ,
	|	Товары.ЕдиницаИзмерения,
	|	Товары.ор_ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок,
	|	НомераУпаковок.НомерКИЗ,
	|	1,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	Документ.КомплектацияЗапасов.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КомплектацияЗапасов.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В(&СписокНомеровУпаковок)
	|;
	|
	// 2
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ПОМЕСТИТЬ втТранспортныеУпаковки
	|ИЗ
	|	Документ.СписаниеЗапасов.ор_ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|ГДЕ
	|	ТранспортныеУпаковки.Ссылка = &Ссылка
	|	И НЕ ТранспортныеУпаковки.НомерУпаковки В(&СписокНомеровУпаковок)
	|;
	|
	// 3 товары
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Сумма(втТовары.КоличествоНомеровУпаковок) КАК КоличествоНомеровУпаковок,
	|	втТовары.ор_КоличествоПервичныхУпаковок КАК ор_КоличествоПервичныхУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика,
	|	втТовары.Количество,
	|	втТовары.КоличествоУпаковок,
	|	втТовары.Упаковка,
	|	втТовары.ИдентификаторСтроки,
	|	втТовары.ор_КоличествоПервичныхУпаковок
	|;
	|
	// 4 номера упаковок
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерКИЗ КАК НомерКИЗ,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	// 5 танспортные упаковки
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	втТранспортныеУпаковки КАК ТранспортныеУпаковки
	|";
	
	Запрос.УстановитьПараметр("СписокНомеровУпаковок"        , СписокНомеровУпаковок);
	Запрос.УстановитьПараметр("Ссылка"                       , ДанныеЗаполнения);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка                      = Результат[0].Выгрузить();
	РезультатТовары                     = Результат[3].Выгрузить();
	РезультатНомера                     = Результат[4].Выгрузить();
	РезультатТранспортныеУпаковки       = Результат[5].Выгрузить();
	
	Шапка = РезультатШапка[0];
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДокументОбъект.Операция = Перечисления.ОперацииВыбытияМДЛП.ВыводПоРазличнымПричинам;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КомплектацияЗапасов") Тогда
		ДокументОбъект.ТипВыводаИзОборота = Перечисления.ВидыВыводаИзОборотаМДЛП.ПроизводствоМедицинскихИзделий;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ор_ИзготовлениеЛекарственныхФорм") Тогда
		ДокументОбъект.ТипВыводаИзОборота = Перечисления.ВидыВыводаИзОборотаМДЛП.ПроизводствоМедицинскихПрепаратов;
	КонецЕсли;
	
	СтруктураОрганизацииМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Организация, Шапка.СтруктурнаяЕдиница, Истина);
	ДокументОбъект.Организация       = СтруктураОрганизацииМДЛП.Организация;
	ДокументОбъект.МестоДеятельности = СтруктураОрганизацииМДЛП.МестоДеятельности;
	
	ДокументОбъект.Основание = ДанныеЗаполнения;
	ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	
	Для Каждого Строка Из РезультатТовары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		СписаниеБлистера = ЗначениеЗаполнено(Строка.Упаковка) И Строка.Количество < Строка.КоличествоУпаковок;
		
		Если НЕ СписаниеБлистера И Строка.КоличествоНомеровУпаковок <> НоваяСтрока.Количество Тогда
			НоваяСтрока.Количество = Строка.КоличествоНомеровУпаковок;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.Упаковка);
		КонецЕсли;
		
		Если СписаниеБлистера Тогда
			НоваяСтрока.КоличествоПервичныхУпаковокВоВторичной = Строка.ор_КоличествоПервичныхУпаковок;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		Если ЗначениеЗаполнено(Строка.Упаковка) И Строка.Количество < Строка.КоличествоУпаковок Тогда
			НоваяСтрока.КоличествоПервичныхУпаковок = Строка.КоличествоУпаковок;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из РезультатТранспортныеУпаковки Цикл
		НоваяСтрока = ДокументОбъект.ТранспортныеУпаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУведомлениеПередачеНаУничтожениеПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокНомеровУпаковок = ПолучитьСписокНомеровУпаковкоУведомленийПоОснованию(ДанныеЗаполнения, Метаданные.Документы.УведомлениеОПередачеНаУничтожениеМДЛП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Шапка.Номер КАК НомерДокумента,
	|	Шапка.Дата КАК ДатаДокумента,
	|	Шапка.Организация КАК Организация,
	|	Шапка.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
	|ИЗ
	|	Документ.СписаниеЗапасов КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	// 1
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок,
	|	НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	1 КАК КоличествоНомеровУпаковок
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.СписаниеЗапасов.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЗапасов.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В(&СписокНомеровУпаковок)
	|;
	|
	// 2
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ПОМЕСТИТЬ втТранспортныеУпаковки
	|ИЗ
	|	Документ.СписаниеЗапасов.ор_ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|ГДЕ
	|	ТранспортныеУпаковки.Ссылка = &Ссылка
	|	И НЕ ТранспортныеУпаковки.НомерУпаковки В(&СписокНомеровУпаковок)
	|;
	|
	// 3 товары
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Сумма(втТовары.КоличествоНомеровУпаковок) КАК КоличествоНомеровУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика,
	|	втТовары.Количество,
	|	втТовары.КоличествоУпаковок,
	|	втТовары.Упаковка,
	|	втТовары.ИдентификаторСтроки
	|;
	|
	// 4 номера упаковок
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерКИЗ КАК НомерКИЗ,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	// 5 танспортные упаковки
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	втТранспортныеУпаковки КАК ТранспортныеУпаковки
	|";
	
	Запрос.УстановитьПараметр("СписокНомеровУпаковок"        , СписокНомеровУпаковок);
	Запрос.УстановитьПараметр("Ссылка"                       , ДанныеЗаполнения);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка                      = Результат[0].Выгрузить();
	РезультатТовары                     = Результат[3].Выгрузить();
	РезультатНомера                     = Результат[4].Выгрузить();
	РезультатТранспортныеУпаковки       = Результат[5].Выгрузить();
	
	Шапка = РезультатШапка[0];
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	СтруктураОрганизацииМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Организация, Шапка.СтруктурнаяЕдиница, Истина);
	ДокументОбъект.Организация       = СтруктураОрганизацииМДЛП.Организация;
	ДокументОбъект.МестоДеятельности = СтруктураОрганизацииМДЛП.МестоДеятельности;
	
	ДокументОбъект.Основание = ДанныеЗаполнения;
	ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	
	Для Каждого Строка Из РезультатТовары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.КоличествоНомеровУпаковок <> НоваяСтрока.Количество Тогда
			НоваяСтрока.Количество = Строка.КоличествоНомеровУпаковок;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.Упаковка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из РезультатТранспортныеУпаковки Цикл
		НоваяСтрока = ДокументОбъект.ТранспортныеУпаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


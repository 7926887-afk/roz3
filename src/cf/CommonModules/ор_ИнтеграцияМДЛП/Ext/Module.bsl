	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУведомлениеОПеремещенииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ДокументОрдера, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокНомеровУпаковок = ПолучитьСписокНомеровУпаковкоУведомленийПоОснованию(ДанныеЗаполнения, Метаданные.Документы.УведомлениеОПеремещенииМДЛП);
	
	СписокОрдеров = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ДокументОрдера) Тогда
		СписокОрдеров.Добавить(ДокументОрдера);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		ЗапрашиваемыеРеквизиты = Новый Структура;
		ЗапрашиваемыеРеквизиты.Вставить("ОрдерныйСклад", "СтруктурнаяЕдиница.ОрдерныйСклад");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, ЗапрашиваемыеРеквизиты);
		
		Если ЗначенияРеквизитов.ОрдерныйСклад Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	РасходныйОрдер.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РасходныйОрдер КАК РасходныйОрдер
			|ГДЕ
			|	РасходныйОрдер.ДокументОснование = &ДокументОснование";
			Запрос.УстановитьПараметр("ДокументОснование", ДанныеЗаполнения);
			
			Результат = Запрос.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Пока Выборка.Следующий() Цикл
					СписокОрдеров.Добавить(Выборка.Ссылка);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Шапка.Номер КАК НомерДокумента,
	|	Шапка.Дата КАК ДатаДокумента,
	|	Шапка.Организация КАК Организация,
	|	Шапка.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Шапка.СтруктурнаяЕдиницаПолучатель КАК СтруктурнаяЕдиницаПолучатель
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок,
	|	НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	1 КАК КоличествоНомеровУпаковок
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.ПеремещениеЗапасов.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПеремещениеЗапасов.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В (&СписокНомеровУпаковок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Количество,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ,
	|	Товары.ЕдиницаИзмерения,
	|	Товары.ор_ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок,
	|	НомераУпаковок.НомерКИЗ,
	|	1
	|ИЗ
	|	Документ.РасходныйОрдер.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдер.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка В (&СписокОрдеров)
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И НЕ НомераУпаковок.НомерКИЗ В (&СписокНомеровУпаковок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ПОМЕСТИТЬ втТранспортныеУпаковки
	|ИЗ
	|	Документ.ПеремещениеЗапасов.ор_ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|ГДЕ
	|	ТранспортныеУпаковки.Ссылка = &Ссылка
	|	И НЕ ТранспортныеУпаковки.НомерУпаковки В (&СписокНомеровУпаковок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки
	|ИЗ
	|	Документ.РасходныйОрдер.ор_ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|ГДЕ
	|	ТранспортныеУпаковки.Ссылка В (&СписокОрдеров)
	|	И НЕ ТранспортныеУпаковки.НомерУпаковки В (&СписокНомеровУпаковок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	СУММА(втТовары.КоличествоНомеровУпаковок) КАК КоличествоНомеровУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика,
	|	втТовары.Количество,
	|	втТовары.КоличествоУпаковок,
	|	втТовары.Упаковка,
	|	втТовары.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерКИЗ КАК НомерКИЗ,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	втТранспортныеУпаковки КАК ТранспортныеУпаковки";
	
	Запрос.УстановитьПараметр("СписокНомеровУпаковок", СписокНомеровУпаковок);
	Запрос.УстановитьПараметр("Ссылка"               , ДанныеЗаполнения);
	Запрос.УстановитьПараметр("СписокОрдеров"        , СписокОрдеров);
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка                      = Результат[0].Выгрузить();
	РезультатТовары                     = Результат[3].Выгрузить();
	РезультатНомера                     = Результат[4].Выгрузить();
	РезультатТранспортныеУпаковки       = Результат[5].Выгрузить();
	
	Шапка = РезультатШапка[0];
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	СтруктураОрганизацииОтправителяМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Организация, Шапка.СтруктурнаяЕдиница, Истина);
	ДокументОбъект.Организация       = СтруктураОрганизацииОтправителяМДЛП.Организация;
	ДокументОбъект.МестоДеятельности = СтруктураОрганизацииОтправителяМДЛП.МестоДеятельности;
	
	СтруктураОрганизацииПолучателяМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(Шапка.Организация, Шапка.СтруктурнаяЕдиницаПолучатель, Истина);
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		ДокументОбъект.Организация = СтруктураОрганизацииПолучателяМДЛП.Организация;
	КонецЕсли;
	ДокументОбъект.МестоДеятельностиПолучатель = СтруктураОрганизацииПолучателяМДЛП.МестоДеятельности;
	
	ДокументОбъект.Основание = ДанныеЗаполнения;
	ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	
	Если ЗначениеЗаполнено(ДокументОбъект.МестоДеятельностиПолучатель) Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.МестоДеятельностиПолучатель, "ВестиУчетВЭтойИБ") Тогда
			ДокументОбъект.Операция = Перечисления.ОперацииПеремещенияМДЛП.Перемещение;
		Иначе
			ДокументОбъект.Операция = Перечисления.ОперацииПеремещенияМДЛП.РасходныйОрдер;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Строка Из РезультатТовары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.КоличествоНомеровУпаковок <> НоваяСтрока.Количество Тогда
			НоваяСтрока.Количество = Строка.КоличествоНомеровУпаковок;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.Упаковка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из РезультатТранспортныеУпаковки Цикл
		НоваяСтрока = ДокументОбъект.ТранспортныеУпаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУведомлениеОФактеУничтоженияПоПередачеНаУничтожение(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//ОбщегоНазначенияРТ.ПроверитьВозможностьВводаНаОсновании(ДанныеЗаполнения);
	
	СписокНомеровУпаковок = ПолучитьСписокНомеровУпаковкоУведомленийПоОснованию(ДанныеЗаполнения, Метаданные.Документы.УведомлениеОФактеУничтоженияМДЛП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УведомлениеОФактеУничтоженияМДЛП.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УведомлениеОФактеУничтоженияМДЛП КАК УведомлениеОФактеУничтоженияМДЛП
	|ГДЕ
	|	УведомлениеОФактеУничтоженияМДЛП.Основание = &Основание";
	Запрос.УстановитьПараметр("Основание", ДанныеЗаполнения);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		ТекстОшибки = НСтр("ru='По документу %1 уже существуют документы о факте уничтожения. Ввод на основании документа невозможен'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ДанныеЗаполнения);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ДокументОбъект.Основание = ДанныеЗаполнения;
	ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект,ДанныеЗаполнения,"Организация, МестоДеятельности,Контрагент,КонтрагентИНН,КонтрагентКПП,КонтрагентФизическоеЛицо");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.GTIN КАК GTIN,
	|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	1 КАК КоличествоНомеровУпаковок
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.УведомлениеОПередачеНаУничтожениеМДЛП.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОПередачеНаУничтожениеМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И Товары.Ссылка.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ПринятоГИСМ)
	|	И НЕ НомераУпаковок.НомерКИЗ В(&СписокНомеровУпаковок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ПОМЕСТИТЬ втТранспортныеУпаковки
	|ИЗ
	|	Документ.УведомлениеОПередачеНаУничтожениеМДЛП.ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|ГДЕ
	|	ТранспортныеУпаковки.Ссылка = &Ссылка
	|	И ТранспортныеУпаковки.Ссылка.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ПринятоГИСМ)
	|	И НЕ ТранспортныеУпаковки.НомерУпаковки В(&СписокНомеровУпаковок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.GTIN КАК GTIN,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Сумма(втТовары.КоличествоНомеровУпаковок) КАК КоличествоНомеровУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика,
	|	втТовары.Количество,
	|	втТовары.КоличествоУпаковок,
	|	втТовары.Упаковка,
	|	втТовары.GTIN,
	|	втТовары.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерКИЗ КАК НомерКИЗ,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	втТранспортныеУпаковки КАК втТранспортныеУпаковки";
	
	Запрос.УстановитьПараметр("СписокНомеровУпаковок"        , СписокНомеровУпаковок);
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатТовары               = Результат[2].Выгрузить();
	РезультатНомера               = Результат[3].Выгрузить();
	РезультатТранспортныеУпаковки = Результат[4].Выгрузить();
	
	Для Каждого Строка Из РезультатТовары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.КоличествоНомеровУпаковок <> НоваяСтрока.Количество Тогда
			НоваяСтрока.Количество = Строка.КоличествоНомеровУпаковок;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.Упаковка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из РезультатТранспортныеУпаковки Цикл
		НоваяСтрока = ДокументОбъект.ТранспортныеУпаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУведомлениеОРозничнойПродажеПоЧекуККМ(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА Товары.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА Товары.СтруктурнаяЕдиница
	|		ИНАЧЕ Товары.Ссылка.СтруктурнаяЕдиница
	|	КОНЕЦ КАК Склад
	|ПОМЕСТИТЬ втОрганизации
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка.Организация,
	|	ВЫБОР
	|		КОГДА Товары.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА Товары.СтруктурнаяЕдиница
	|		ИНАЧЕ Товары.Ссылка.СтруктурнаяЕдиница
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.Организация, ЗНАЧЕНИЕ(Справочник.ОрганизацииМДЛП.ПустаяСсылка)) КАК Организация,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ИЗ
	|	втОрганизации КАК втОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО втОрганизации.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА втОрганизации.Склад = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ СубъектыОбращенияМДЛП.ОбъектМестаДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	
	ВыборкаМесто = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаМесто.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаМесто.Следующий();
	ОрганизацияМДЛП = ВыборкаМесто.Организация;
	МестоДеятельностиМДЛП = ВыборкаМесто.МестоДеятельности;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекККМ.Ссылка КАК Основание,
	|	ЧекККМ.Номер КАК НомерДокумента,
	|	ЧекККМ.Дата КАК ДатаДокумента
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.Сумма КАК Цена,
	|	Товары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки,
	|	Товары.СуммаСкидкиОплатыБонусом КАК СуммаСкидкиОплатыБонусом,
	|	Товары.СуммаСкидкиНаценки КАК СуммаРучнойСкидки,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).ор_КоличествоПервичныхУпаковок
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПервичныхУпаковокВоВторичной
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЧекККМор_НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	ЧекККМор_НомераУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ втНомера
	|ИЗ
	|	Документ.ЧекККМ.ор_НомераУпаковок КАК ЧекККМор_НомераУпаковок
	|ГДЕ
	|	ЧекККМор_НомераУпаковок.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	втТовары.КоличествоПервичныхУпаковокВоВторичной КАК КоличествоПервичныхУпаковокВоВторичной
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНомера.НомерКИЗ КАК НомерКИЗ,
	|	втНомера.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	втТовары.Цена КАК Цена,
	|	втТовары.Количество КАК Количество,
	|	втТовары.СуммаНДС КАК СуммаНДС,
	|	втТовары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки,
	|	втТовары.СуммаСкидкиОплатыБонусом КАК СуммаСкидкиОплатыБонусом,
	|	втТовары.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(втТовары.Упаковка) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА втТовары.КоличествоУпаковок
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПервичныхУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНомера КАК втНомера
	|		ПО втТовары.ИдентификаторСтроки = втНомера.ИдентификаторСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	Результат = Запрос.ВыполнитьПакет();
	
	РезультатШапка  = Результат[0].Выгрузить();
	РезультатТовары = Результат[3].Выгрузить();
	РезультатНомера = Результат[4].Выгрузить();
	РезультатНомераСвернутая = Результат[4].Выгрузить();
	
	Шапка = РезультатШапка[0];
	
	ДокументОбъект.Основание         = Шапка.Основание;
	ДокументОбъект.Организация       = ОрганизацияМДЛП;
	ДокументОбъект.МестоДеятельности = МестоДеятельностиМДЛП;
	ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	
	ИдентификаторДокумента = Новый УникальныйИдентификатор;
	
	НоваяСтрокаДокументапродажи = ДокументОбъект.ДокументыПродажи.Добавить();
	НоваяСтрокаДокументапродажи.ВидДокумента           = Перечисления.ВидыДокументовПродажиМДЛП.Чек;
	НоваяСтрокаДокументапродажи.НомерДокумента         = Шапка.НомерДокумента;
	НоваяСтрокаДокументапродажи.ДатаДокумента          = Шапка.ДатаДокумента;
	НоваяСтрокаДокументапродажи.ИдентификаторДокумента = ИдентификаторДокумента;
	
	Для Каждого Строка Из РезультатТовары Цикл
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ИдентификаторДокумента = ИдентификаторДокумента;
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	РезультатНомераСвернутая.Свернуть("ИдентификаторСтроки,СуммаНДС");
	
	Для Каждого СтрокаСвернутая Из РезультатНомераСвернутая Цикл
		
		СуммаНДСОбщая = СтрокаСвернутая.СуммаНДС;
		СуммаНДСРасчетная = 0;
		
		НайденныеСтроки = ДокументОбъект.НомераУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаСвернутая.ИдентификаторСтроки));
		
		КоличествоСтрок      = НайденныеСтроки.Количество();
		КоличествоОбработано = 0;
		
		Если КоличествоСтрок = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			КоличествоОбработано = КоличествоОбработано + 1;
			
			Если КоличествоОбработано = КоличествоСтрок Тогда
				Строка.СуммаНДС = СуммаНДСОбщая - СуммаНДСРасчетная;
			Иначе
				Строка.СуммаНДС = Формат(СуммаНДСОбщая/КоличествоСтрок, "ЧЦ=15; ЧДЦ=2");
				СуммаНДСРасчетная = СуммаНДСРасчетная + Строка.СуммаНДС;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПриходнаяНакладнаяПоУведомлениюОПриеме(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УведомлениеОПриемкеМДЛП.НомерДокумента КАК НомерВходящегоДокумента,
	|	УведомлениеОПриемкеМДЛП.ДатаДокумента КАК ДатаВходящегоДокумента,
	|	УведомлениеОПриемкеМДЛП.Организация КАК ОрганизацияМДЛП,
	|	УведомлениеОПриемкеМДЛП.МестоДеятельности КАК МестоДеятельностиМДЛП,
	|	УведомлениеОПриемкеМДЛП.Грузоотправитель КАК ГрузоотправительМДЛП,
	|	УведомлениеОПриемкеМДЛП.МестоДеятельностиГрузоотправителя КАК МестоДеятельностиГрузоотправителяМДЛП
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП КАК УведомлениеОПриемкеМДЛП
	|ГДЕ
	|	УведомлениеОПриемкеМДЛП.Ссылка = &Ссылка
	|;
	|
	// 1
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Упаковка КАК ЕдиницаИзмерения,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.GTIN КАК GTIN,
	|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	1 КАК КоличествоНомеров
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|	И (НомераУпаковок.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.Подтвердить)
	|	ИЛИ НомераУпаковок.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.Подтверждено))
	|;
	|
	// 2
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки,
	|	ТранспортныеУпаковки.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТранспортныеУпаковки.Цена КАК ЦенаУпаковки,
	|	ТранспортныеУпаковки.СуммаНДС КАК СуммаНДСУпаковки,
	|	СоставТранспортныхУпаковок.Номенклатура КАК Номенклатура,
	|	СоставТранспортныхУпаковок.Характеристика КАК Характеристика,
	|	СоставТранспортныхУпаковок.GTIN КАК GTIN,
	|	СоставТранспортныхУпаковок.НомерСерии КАК НомерСерии,
	|	СоставТранспортныхУпаковок.Количество КАК Количество,
	|	СоставТранспортныхУпаковок.Цена КАК Цена,
	|	СоставТранспортныхУпаковок.СуммаНДС КАК СуммаНДС,
	|	СоставТранспортныхУпаковок.Сумма КАК Сумма
	|ПОМЕСТИТЬ втТранспортныеУпаковки
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП.СоставТранспортныхУпаковок КАК СоставТранспортныхУпаковок
	|		ПО ТранспортныеУпаковки.Ссылка = СоставТранспортныхУпаковок.Ссылка
	|			И ТранспортныеУпаковки.ИдентификаторСтроки = СоставТранспортныхУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	ТранспортныеУпаковки.Ссылка = &Ссылка
	|	И (ТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.Подтвердить)
	|	ИЛИ ТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.Подтверждено))
	|;
	|
	// 3 товары
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	втТовары.Цена КАК Цена,
	|	втТовары.СуммаНДС КАК СуммаНДС,
	|	втТовары.Сумма КАК Сумма,
	|	втТовары.ИдентификаторСтроки КАК ор_ИдентификаторСтроки,
	|	Сумма(КоличествоНомеров) КАК КоличествоНомеров
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика,
	|	втТовары.Количество,
	|	втТовары.КоличествоУпаковок,
	|	втТовары.ЕдиницаИзмерения,
	|	втТовары.Цена,
	|	втТовары.СуммаНДС,
	|	втТовары.Сумма,
	|	втТовары.ИдентификаторСтроки
	|;
	|
	// 4 номера упаковок
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерКИЗ КАК НомерКИЗ,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	// 5 танспортные упаковки
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.НомерУпаковки КАК НомерУпаковки,
	|	ТранспортныеУпаковки.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТранспортныеУпаковки.ЦенаУпаковки КАК Цена,
	|	ТранспортныеУпаковки.СуммаНДСУпаковки КАК СуммаНДС
	|ИЗ
	|	втТранспортныеУпаковки КАК ТранспортныеУпаковки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТранспортныеУпаковки.НомерУпаковки,
	|	ТранспортныеУпаковки.ИдентификаторСтроки,
	|	ТранспортныеУпаковки.ЦенаУпаковки,
	|	ТранспортныеУпаковки.СуммаНДСУпаковки
	|;
	|
	// 6 состав транспортных упаковок
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортныеУпаковки.Номенклатура КАК Номенклатура,
	|	ТранспортныеУпаковки.Характеристика КАК Характеристика,
	|	ТранспортныеУпаковки.GTIN КАК GTIN,
	|	ТранспортныеУпаковки.НомерСерии КАК НомерСерии,
	|	ТранспортныеУпаковки.Количество КАК Количество,
	|	ТранспортныеУпаковки.Цена КАК Цена,
	|	ТранспортныеУпаковки.СуммаНДС КАК СуммаНДС,
	|	ТранспортныеУпаковки.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТранспортныеУпаковки.Сумма КАК Сумма
	|ИЗ
	|	втТранспортныеУпаковки КАК ТранспортныеУпаковки
	|ГДЕ
	|	НЕ ТранспортныеУпаковки.Номенклатура ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка                      = Результат[0].Выгрузить();
	РезультатТовары                     = Результат[3].Выгрузить();
	РезультатНомера                     = Результат[4].Выгрузить();
	РезультатТранспортныеУпаковки       = Результат[5].Выгрузить();
	РезультатСоставТранспортныхУпаковок = Результат[6].Выгрузить();
	
	Шапка = РезультатШапка[0];
	
	ДокументОбъект.НомерВходящегоДокумента = Шапка.НомерВходящегоДокумента;
	ДокументОбъект.ДатаВходящегоДокумента  = Шапка.ДатаВходящегоДокумента;
	
	СтруктураОрганизации = ПолучитьОрганизациюИМестоДеятельности(Шапка.ОрганизацияМДЛП, Шапка.МестоДеятельностиМДЛП, Истина);
	СтруктураКонтрагента = ПолучитьОрганизациюИМестоДеятельности(Шапка.ГрузоотправительМДЛП, Шапка.МестоДеятельностиГрузоотправителяМДЛП, Ложь);
	
	ДокументОбъект.Организация        = СтруктураОрганизации.Организация;
	ДокументОбъект.СтруктурнаяЕдиница = СтруктураОрганизации.МестоДеятельности;
	ДокументОбъект.Контрагент         = СтруктураКонтрагента.Организация;
	ДокументОбъект.СуммаВключаетНДС = Истина;
	
	Если ДанныеЗаполнения.Операция = Перечисления.ОперацииПриемкиМДЛП.ПоступлениеВРамкахАгентскогоДоговора
		ИЛИ ДанныеЗаполнения.Операция = Перечисления.ОперацииПриемкиМДЛП.Поступление
		И ДанныеЗаполнения.ТипДоговора = Перечисления.ТипыДоговоровМДЛП.Комиссия Тогда
		
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПриемНаКомиссию;
		
		ЗапросДоговор = Новый Запрос;
		ЗапросДоговор.Текст =
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.ПризнакАгента = &ПризнакАгента
		|	И ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Контрагент";
		ЗапросДоговор.УстановитьПараметр("Организация"  , ДокументОбъект.Организация);
		ЗапросДоговор.УстановитьПараметр("ПризнакАгента", Перечисления.ПризнакиАгента.Комиссионер);
		ЗапросДоговор.УстановитьПараметр("Контрагент"   , ДокументОбъект.Контрагент);
		
		ВыборкаДоговор = ЗапросДоговор.Выполнить().Выбрать();
		
		Если ВыборкаДоговор.Количество() = 1 Тогда
			ВыборкаДоговор.Следующий();
			ДокументОбъект.Договор = ВыборкаДоговор.Ссылка;
		КонецЕсли;
		
	ИначеЕсли ДанныеЗаполнения.Операция = Перечисления.ОперацииПриемкиМДЛП.Поступление
		ИЛИ ДанныеЗаполнения.Операция = Перечисления.ОперацииПриемкиМДЛП.ПоступлениеНаРанееНеЗарегистрированноеМестоДеятельности Тогда
		
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика;
		
	ИначеЕсли ДанныеЗаполнения.Операция = Перечисления.ОперацииПриемкиМДЛП.ВозвратОтПокупателя
		ИЛИ ДанныеЗаполнения.Операция = Перечисления.ОперацииПриемкиМДЛП.ВозвратПриостановленныхЛП Тогда
		
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя;
		
	КонецЕсли;
	
	НуженПересчетКоличества = Ложь;
	Для Каждого Строка Из РезультатТовары Цикл
		НоваяСтрока = ДокументОбъект.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Количество = Строка.КоличествоУпаковок;
		
		Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура.ВидСтавкиНДС) Тогда
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(НоваяСтрока.Номенклатура.ВидСтавкиНДС, ТекущаяДатаСеанса());
		Иначе
			Если ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
				НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(ДокументОбъект.Организация.ВидСтавкиНДСПоУмолчанию, ТекущаяДатаСеанса());
			КонецЕсли;
		КонецЕсли;
		
		Если Строка.Количество <> Строка.КоличествоНомеров Тогда
			НоваяСтрока.Количество = Строка.КоличествоНомеров/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.ЕдиницаИзмерения);
			
			НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
			СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
			
			НоваяСтрока.СуммаНДС = ?(ДокументОбъект.СуммаВключаетНДС, 
									  НоваяСтрока.Сумма - (НоваяСтрока.Сумма) / ((СтавкаНДС + 100) / 100),
									  НоваяСтрока.Сумма * СтавкаНДС / 100);
		КонецЕсли;
		НоваяСтрока.Всего = НоваяСтрока.Сумма + ?(ДокументОбъект.СуммаВключаетНДС, 0, НоваяСтрока.СуммаНДС);
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.ор_НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из РезультатТранспортныеУпаковки Цикл
		НоваяСтрока = ДокументОбъект.ор_ТранспортныеУпаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из РезультатСоставТранспортныхУпаковок Цикл
		НоваяСтрока = ДокументОбъект.ор_СоставТранспортныхУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из РезультатСоставТранспортныхУпаковок Цикл
		
		НоваяСтрока = ДокументОбъект.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ор_ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		
		Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура.ВидСтавкиНДС) Тогда
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(НоваяСтрока.Номенклатура.ВидСтавкиНДС, ТекущаяДатаСеанса());
		Иначе
			Если ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
				НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(ДокументОбъект.Организация.ВидСтавкиНДСПоУмолчанию, ТекущаяДатаСеанса());
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
			НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если НЕ (ЗначениеЗаполнено(НоваяСтрока.Цена) И ЗначениеЗаполнено(НоваяСтрока.Количество)) Тогда
			НоваяСтрока.Сумма = 0;
			НоваяСтрока.СуммаНДС = 0;
			НоваяСтрока.Всего = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРасходнаяНакладнаяПоУведомлениюОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабДокументыПродажи.НомерДокумента КАК НомерВходящегоДокумента,
	|	ТабДокументыПродажи.ДатаДокумента КАК ДатаВходящегоДокумента,
	|	УведомлениеОПриемкеМДЛП.Организация КАК ОрганизацияМДЛП,
	|	УведомлениеОПриемкеМДЛП.МестоДеятельности КАК МестоДеятельностиМДЛП
	|ИЗ
	|	Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП КАК УведомлениеОПриемкеМДЛП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП.ДокументыПродажи КАК ТабДокументыПродажи
	|		ПО УведомлениеОПриемкеМДЛП.Ссылка = ТабДокументыПродажи.Ссылка
	|ГДЕ
	|	УведомлениеОПриемкеМДЛП.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Упаковка КАК ЕдиницаИзмерения,
	|	НомераУпаковок.Цена КАК Цена,
	|	НомераУпаковок.СуммаНДС КАК СуммаНДС,
	|	Товары.GTIN КАК GTIN,
	|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	НомераУпаковок.НомерКиЗ КАК НомерКИЗ,
	|	1 КАК КоличествоНомеров
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,

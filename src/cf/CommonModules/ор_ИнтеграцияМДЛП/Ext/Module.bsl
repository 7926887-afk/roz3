#Область ПроцедурыИФункцииФормированияИОтправкиУведомленияОРозничнойПродажеПередПробитиемЧека

Процедура ИзменитьСтатусыУпаковокУведомленияККМОффлайн(ТаблицаКизов, ООРПСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекВерсияСхемы = ИнтеграцияМДЛП.ИспользуемаяВерсияСхемОбмена();
	
	Если НЕ (ОбщегоНазначенияКлиентСервер.СравнитьВерсииБезНомераСборки(ТекВерсияСхемы + ".0", "1.29.0") > 0) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаКизов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	вЗапрос = Новый Запрос;
	вЗапрос.УстановитьПараметр("ТаблицаКизов", ТаблицаКизов);
	вЗапрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	вЗапрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКизов.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаКизов.ДоляУпаковки КАК ДоляУпаковки
	|ПОМЕСТИТЬ втНомераУпаковок
	|ИЗ
	|	&ТаблицаКизов КАК ТаблицаКизов";
	
	вЗапрос.Выполнить();
	ИнтеграцияМДЛП.ДобавитьКлючиУпаковок(вЗапрос.МенеджерВременныхТаблиц, "втНомераУпаковок");
	
	вЗапрос.Текст =
	"ВЫБРАТЬ
	|	втНомераУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	СУММА(втНомераУпаковок.ДоляУпаковки) КАК ДоляУпаковки,
	|	УпаковкиМДЛП.МестоДеятельности КАК МестоДеятельности
	|ИЗ
	|	втНомераУпаковок КАК втНомераУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УпаковкиМДЛП КАК УпаковкиМДЛП
	|		ПО втНомераУпаковок.НомерУпаковки = УпаковкиМДЛП.НомерУпаковки
	|		И втНомераУпаковок.КлючУпаковки = УпаковкиМДЛП.КлючУпаковки
	|ГДЕ
	|	НЕ УпаковкиМДЛП.МестоДеятельности ЕСТЬ NULL
	|	И УпаковкиМДЛП.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)
	|
	|СГРУППИРОВАТЬ ПО
	|	УпаковкиМДЛП.МестоДеятельности,
	|	втНомераУпаковок.НомерУпаковки
	|ИТОГИ ПО
	|	МестоДеятельности";
	
	РезультатЗапроса = вЗапрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// +ор интеграция МДЛП
	вТаблицаКизов = Новый ТаблицаЗначений;
	вТаблицаКизов.Колонки.Добавить("НомерУпаковки", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(27)));
	вТаблицаКизов.Колонки.Добавить("ДоляУпаковки",  Новый ОписаниеТипов("Число",, Новый КвалификаторыЧисла(6,5)));
	// -ор интеграция МДЛП
	
	ВыборкаПоместам = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоместам.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаПоместам.МестоДеятельности) Тогда
			Продолжить;
		КонецЕсли;
		
		вТаблицаКизов.Очистить();
		ВыборкаДетальная = ВыборкаПоместам.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			НовыйКиз = вТаблицаКизов.Добавить();
			НовыйКиз.НомерУпаковки = ВыборкаДетальная.НомерУпаковки;
			Если ВыборкаДетальная.ДоляУпаковки > 1 Тогда
				НовыйКиз.ДоляУпаковки = 1;
			Иначе
				НовыйКиз.ДоляУпаковки  = ВыборкаДетальная.ДоляУпаковки;
			КонецЕсли;
		КонецЦикла;
		
		Если вТаблицаКизов.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НомераУпаковок.НомерУпаковки КАК НомерУпаковки,
		|	НомераУпаковок.ДоляУпаковки КАК ДоляУпаковки,
		|	ЛОЖЬ КАК ГрупповаяУпаковка,
		|	""НомераУпаковок"" КАК ИмяТабличнойЧасти,
		|	""НомерКиЗ"" КАК ИмяПоля
		|ПОМЕСТИТЬ НомераУпаковок
		|ИЗ
		|	&НомераУпаковок КАК НомераУпаковок";
		
		Запрос.УстановитьПараметр("НомераУпаковок", вТаблицаКизов);
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Выполнить();
		
		ИнтеграцияМДЛП.ДобавитьКлючиУпаковок(Запрос.МенеджерВременныхТаблиц);
		
		ПараметрыОперации = ИнтеграцияМДЛП.ПараметрыОперацииИзмененияСтатусаУпаковок();
		ПараметрыОперации.ИсходныйСтатус = Перечисления.СтатусыУпаковокМДЛП.ВОбороте;
		ПараметрыОперации.НовыйСтатус    = Перечисления.СтатусыУпаковокМДЛП.ВыбылаИзОборота;
		ПараметрыОперации.Владелец       = Справочники.ОрганизацииМДЛП.ПустаяСсылка();
		
		ПараметрыОперации.ДатаОперации      = ООРПСсылка.Дата;
		ПараметрыОперации.ДокументРезерва   = ООРПСсылка;
		ПараметрыОперации.МестоДеятельности = ВыборкаПоместам.МестоДеятельности;
		
		ИнтеграцияМДЛП.ЗарезервироватьУпаковки(Запрос.МенеджерВременныхТаблиц, ПараметрыОперации);
		ИнтеграцияМДЛП.УстановитьНовыйСтатус(Запрос.МенеджерВременныхТаблиц, ПараметрыОперации);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьСтатусыУпаковокУведомления(ЧекККМСсылка, ТекстСообщения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекВерсияСхемы = ИнтеграцияМДЛП.ИспользуемаяВерсияСхемОбмена();
	
	Если НЕ (ОбщегоНазначенияКлиентСервер.СравнитьВерсииБезНомераСборки(ТекВерсияСхемы + ".0", "1.29.0") > 0) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЧекККМСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка.Дата КАК Дата,
	|	Товары.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА Товары.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА Товары.СтруктурнаяЕдиница
	|		ИНАЧЕ Товары.Ссылка.СтруктурнаяЕдиница
	|	КОНЕЦ КАК СтруктурнаяЕдиница
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|			И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка.Дата,
	|	Товары.Ссылка.Организация,
	|	ВЫБОР
	|		КОГДА Товары.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА Товары.СтруктурнаяЕдиница
	|		ИНАЧЕ Товары.Ссылка.СтруктурнаяЕдиница
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Дата КАК Дата,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ИЗ
	|	втТаблица КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО Товары.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (СубъектыОбращенияМДЛП.СобственнаяОрганизация)
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА Товары.СтруктурнаяЕдиница = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ СубъектыОбращенияМДЛП.ОбъектМестаДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("Ссылка", ЧекККМСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ТекстСообщения = НСтр("ru = 'Нет данных для изменения статуса'");
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		ТекстСообщения = НСтр("ru = 'Некорректные данные для изменения статуса'");
		Возврат;
	КонецЕсли;
	
	Выборка.Следующий();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЧекККМСсылка);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ПолучитьПризнакКонтролироватьСтатусыКИЗ() Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НомераУпаковок.НомерСтроки КАК НомерСтроки,
		|	НомераУпаковок.НомерКИЗ КАК НомерУпаковки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
		|			ТОГДА ВЫРАЗИТЬ(Товары.Количество / Товары.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК ЧИСЛО(10, 5))
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДоляУпаковки,
		|	ЛОЖЬ КАК ГрупповаяУпаковка,
		|	""НомераУпаковок"" КАК ИмяТабличнойЧасти,
		|	""НомерКиЗ"" КАК ИмяПоля
		|ПОМЕСТИТЬ НомераУпаковок
		|ИЗ
		|	Документ.ЧекККМ.ор_НомераУпаковок КАК НомераУпаковок
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Запасы КАК Товары
		|		ПО НомераУпаковок.Ссылка = Товары.Ссылка
		|			И НомераУпаковок.ИдентификаторСтроки = Товары.ор_ИдентификаторСтроки
		|ГДЕ
		|	НомераУпаковок.Ссылка = &Ссылка
		|	И НЕ Товары.ор_ИдентификаторСтроки ЕСТЬ NULL
		|	И Товары.ор_СтатусЗаполненияУпаковок <> 0";
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НомераУпаковок.НомерСтроки КАК НомерСтроки,
		|	НомераУпаковок.НомерКИЗ КАК НомерУпаковки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
		|			ТОГДА ВЫРАЗИТЬ(Товары.Количество / Товары.ЕдиницаИзмерения.ор_КоличествоПервичныхУпаковок КАК ЧИСЛО(10, 5))
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДоляУпаковки
		|ПОМЕСТИТЬ втНомераУпаковок
		|ИЗ
		|	Документ.ЧекККМ.ор_НомераУпаковок КАК НомераУпаковок
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Запасы КАК Товары
		|		ПО НомераУпаковок.Ссылка = Товары.Ссылка
		|			И НомераУпаковок.ИдентификаторСтроки = Товары.ор_ИдентификаторСтроки
		|ГДЕ
		|	НомераУпаковок.Ссылка = &Ссылка
		|	И НЕ Товары.ор_ИдентификаторСтроки ЕСТЬ NULL
		|	И Товары.ор_СтатусЗаполненияУпаковок <> 0";
		
		Запрос.Выполнить();
		ИнтеграцияМДЛП.ДобавитьКлючиУпаковок(Запрос.МенеджерВременныхТаблиц, "втНомераУпаковок");
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	втНомераУпаковок.НомерСтроки КАК НомерСтроки,
		|	втНомераУпаковок.НомерУпаковки КАК НомерУпаковки,
		|	втНомераУпаковок.ДоляУпаковки КАК ДоляУпаковки,
		|	ЛОЖЬ КАК ГрупповаяУпаковка,
		|	""НомераУпаковок"" КАК ИмяТабличнойЧасти,
		|	""НомерКиЗ"" КАК ИмяПоля
		|ПОМЕСТИТЬ НомераУпаковок
		|ИЗ
		|	втНомераУпаковок КАК втНомераУпаковок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УпаковкиМДЛП КАК УпаковкиМДЛП
		|		ПО втНомераУпаковок.НомерУпаковки = УпаковкиМДЛП.НомерУпаковки
		|			И втНомераУпаковок.КлючУпаковки = УпаковкиМДЛП.КлючУпаковки
		|			И УпаковкиМДЛП.МестоДеятельности = &МестоДеятельностиКонтроль
		|ГДЕ
		|	ЕстьNULL(УпаковкиМДЛП.Статус,ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыУпаковокМДЛП.ВОбороте)";
		
		Запрос.УстановитьПараметр("МестоДеятельностиКонтроль", Выборка.МестоДеятельности);
		
	КонецЕсли;
	
	Запрос.Выполнить();
	
	ИнтеграцияМДЛП.ДобавитьКлючиУпаковок(Запрос.МенеджерВременныхТаблиц);
	
	ПараметрыОперации = ИнтеграцияМДЛП.ПараметрыОперацииИзмененияСтатусаУпаковок();
	ПараметрыОперации.ИсходныйСтатус = Перечисления.СтатусыУпаковокМДЛП.ВОбороте;
	ПараметрыОперации.НовыйСтатус    = Перечисления.СтатусыУпаковокМДЛП.ВыбылаИзОборота;
	ПараметрыОперации.Владелец       = Справочники.ОрганизацииМДЛП.ПустаяСсылка();
	
	ПараметрыОперации.ДатаОперации      = Выборка.Дата;
	ПараметрыОперации.ДокументРезерва   = ЧекККМСсылка;
	ПараметрыОперации.МестоДеятельности = Выборка.МестоДеятельности;
	
	ИнтеграцияМДЛП.ЗарезервироватьУпаковки(Запрос.МенеджерВременныхТаблиц, ПараметрыОперации);
	ИнтеграцияМДЛП.УстановитьНовыйСтатус(Запрос.МенеджерВременныхТаблиц, ПараметрыОперации);
	
КонецПроцедуры

Процедура СоздатьИОтправитьУведомлениеОРозничнойПродаже(ЧекККМСсылка, ТекстСообщения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокУведомлений = СоздатьУведомленияОРозничнойПродажеМДЛП(ЧекККМСсылка, ТекстСообщения, Истина);
	Если СписокУведомлений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Уведомление Из СписокУведомлений Цикл
		
		РезультатОперации = ИнтеграцияМДЛПВызовСервера.ПодготовитьСообщенияКПередаче(
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Уведомление.Значение),
				ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияПоВзаимодействиюМДЛП.ПередайтеДанные"),,Истина);
				
		Для Каждого СтрокаРезультата Из РезультатОперации.Изменения Цикл
			Если ЗначениеЗаполнено(СтрокаРезультата.ТекстОшибки) Тогда
				ТекстСообщения = ?(ТекстСообщения = "", "", Символы.ПС) + СтрокаРезультата.ТекстОшибки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьУведомленияОРозничнойПродажеМДЛП(ЧекККМСсылка, ТекстСообщения = "", ТолькоПроведенные = Ложь)Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокУведомлений = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА Товары.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА Товары.СтруктурнаяЕдиница
	|		ИНАЧЕ Товары.Ссылка.СтруктурнаяЕдиница
	|	КОНЕЦ КАК Склад
	|ПОМЕСТИТЬ втОрганизации
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО Товары.Ссылка = НомераУпаковок.Ссылка
	|		И Товары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И НЕ НомераУпаковок.ИдентификаторСтроки ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка.Организация,
	|	ВЫБОР
	|		КОГДА Товары.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ТОГДА Товары.СтруктурнаяЕдиница
	|		ИНАЧЕ Товары.Ссылка.СтруктурнаяЕдиница
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.Организация, ЗНАЧЕНИЕ(Справочник.ОрганизацииМДЛП.ПустаяСсылка)) КАК Организация,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности
	|ИЗ
	|	втОрганизации КАК втОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО втОрганизации.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА втОрганизации.Склад = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ СубъектыОбращенияМДЛП.ОбъектМестаДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.Организация, ЗНАЧЕНИЕ(Справочник.ОрганизацииМДЛП.ПустаяСсылка)) КАК Организация,
	|	ЕСТЬNULL(СубъектыОбращенияМДЛП.МестоДеятельности, ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)) КАК МестоДеятельности,
	|	втОрганизации.Склад КАК Склад
	|ИЗ
	|	втОрганизации КАК втОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО втОрганизации.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|			И (ВЫБОР
	|				КОГДА &ИспользоватьМестаДеятельности
	|					ТОГДА втОрганизации.Склад = СубъектыОбращенияМДЛП.ОбъектМестаДеятельности
	|				ИНАЧЕ СубъектыОбращенияМДЛП.ОбъектМестаДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			КОНЕЦ)";
	Запрос.УстановитьПараметр("Ссылка", ЧекККМСсылка);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	Результ         = РезультатПакет[1].Выгрузить();
	РезультатСклады = РезультатПакет[2].Выгрузить();
	
	Для Каждого СтрокаИдентификатор Из Результ Цикл
		
		СписокСкладов = Новый СписокЗначений;
		Для Каждого СтрокаСклады Из РезультатСклады Цикл
			Если СтрокаИдентификатор.МестоДеятельности = СтрокаСклады.МестоДеятельности Тогда
				СписокСкладов.Добавить(СтрокаСклады.Склад);
			КонецЕсли;
		КонецЦикла;
		
		УведомлениеОбъект = Документы.УведомлениеОРозничнойПродажеМДЛП.СоздатьДокумент();
		ЗаполнитьУведомлениеОРозничнойПродаже(УведомлениеОбъект, ЧекККМСсылка, СписокСкладов, СтрокаИдентификатор.Организация, СтрокаИдентификатор.МестоДеятельности);
		УведомлениеОбъект.Дата = ТекущаяДата();
		УведомлениеОбъект.УстановитьНовыйНомер();
		
		Попытка
			УведомлениеОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если НЕ ТолькоПроведенные Тогда
			СписокУведомлений.Добавить(УведомлениеОбъект.Ссылка);
		КонецЕсли;
		
		Попытка
			УведомлениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Если ТолькоПроведенные Тогда
				СписокУведомлений.Добавить(УведомлениеОбъект.Ссылка);
			КонецЕсли;
		Исключение
			ТекстСообщения = ?(ТекстСообщения = "", "", Символы.ПС) + НСтр("ru = 'Не удалось провести уведомление ""'") + Строка(УведомлениеОбъект.Ссылка) + """";
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат СписокУведомлений;
	
КонецФункции

Процедура ЗаполнитьУведомлениеОРозничнойПродаже(ДокументОбъект, ДанныеЗаполнения, СписокСкладов, ОрганизацияМДЛП, МестоДеятельностиМДЛП)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекККМ.Ссылка КАК Основание,
	|	ЧекККМ.Номер КАК НомерДокумента,
	|	ЧекККМ.Дата КАК ДатаДокумента
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА Товары.Количество * ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.Сумма КАК Цена,
	|	Товары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки,
	|	Товары.СуммаСкидкиОплатыБонусом КАК СуммаСкидкиОплатыБонусом,
	|	Товары.СуммаСкидкиНаценки КАК СуммаРучнойСкидки,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.ор_ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Товары.ор_СтатусЗаполненияУпаковок КАК ор_СтатусЗаполненияУпаковок,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Товары.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА ВЫРАЗИТЬ(Товары.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).ор_КоличествоПервичныхУпаковок
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПервичныхУпаковокВоВторичной
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.ЧекККМ.Запасы КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
	|		ПО Товары.Ссылка = ЧекККМ.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.ор_СтатусЗаполненияУпаковок <> 0
	|	И ВЫБОР
	|			КОГДА Товары.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|				ТОГДА Товары.СтруктурнаяЕдиница В (&СписокСкладов)
	|			ИНАЧЕ ЧекККМ.СтруктурнаяЕдиница В (&СписокСкладов)
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЧекККМор_НомераУпаковок.НомерКИЗ КАК НомерКИЗ,
	|	ЧекККМор_НомераУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ втНомера
	|ИЗ
	|	Документ.ЧекККМ.ор_НомераУпаковок КАК ЧекККМор_НомераУпаковок
	|ГДЕ
	|	ЧекККМор_НомераУпаковок.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.Количество КАК Количество,
	|	втТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	втТовары.Упаковка КАК Упаковка,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	втТовары.КоличествоПервичныхУпаковокВоВторичной КАК КоличествоПервичныхУпаковокВоВторичной
	|ИЗ
	|	втТовары КАК втТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНомера.НомерКИЗ КАК НомерКИЗ,
	|	втНомера.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	втТовары.Цена КАК Цена,
	|	втТовары.Количество КАК Количество,
	|	втТовары.СуммаНДС КАК СуммаНДС,
	|	втТовары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки,
	|	втТовары.СуммаСкидкиОплатыБонусом КАК СуммаСкидкиОплатыБонусом,
	|	втТовары.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(втТовары.Упаковка) = ТИП(Справочник.ЕдиницыИзмерения)
	|			ТОГДА втТовары.КоличествоУпаковок
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПервичныхУпаковок
	|ИЗ
	|	втТовары КАК втТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНомера КАК втНомера
	|		ПО втТовары.ИдентификаторСтроки = втНомера.ИдентификаторСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("СписокСкладов", СписокСкладов);
	
	Результат = Запрос.ВыполнитьПакет();
	
	РезультатШапка  = Результат[0].Выгрузить();
	РезультатТовары = Результат[3].Выгрузить();
	РезультатНомера = Результат[4].Выгрузить();
	РезультатНомераСвернутая = Результат[4].Выгрузить();
	
	Шапка = РезультатШапка[0];
	
	ДокументОбъект.Основание         = Шапка.Основание;
	ДокументОбъект.Организация       = ОрганизацияМДЛП;
	ДокументОбъект.МестоДеятельности = МестоДеятельностиМДЛП;
	ДокументОбъект.СостояниеПодтверждения = Перечисления.СостоянияПодтвержденияМДЛП.КПередаче;
	
	ИдентификаторДокумента = Новый УникальныйИдентификатор;
	
	НоваяСтрокаДокументапродажи = ДокументОбъект.ДокументыПродажи.Добавить();
	НоваяСтрокаДокументапродажи.ВидДокумента           = Перечисления.ВидыДокументовПродажиМДЛП.Чек;
	НоваяСтрокаДокументапродажи.НомерДокумента         = Шапка.НомерДокумента;
	НоваяСтрокаДокументапродажи.ДатаДокумента          = Шапка.ДатаДокумента;
	НоваяСтрокаДокументапродажи.ИдентификаторДокумента = ИдентификаторДокумента;
	
	Для Каждого Строка Из РезультатТовары Цикл
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ИдентификаторДокумента = ИдентификаторДокумента;
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	РезультатНомераСвернутая.Свернуть("ИдентификаторСтроки,СуммаНДС");
	
	Для Каждого СтрокаСвернутая Из РезультатНомераСвернутая Цикл
		
		СуммаНДСОбщая = СтрокаСвернутая.СуммаНДС;
		СуммаНДСРасчетная = 0;
		
		НайденныеСтроки = ДокументОбъект.НомераУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаСвернутая.ИдентификаторСтроки));
		
		КоличествоСтрок      = НайденныеСтроки.Количество();
		КоличествоОбработано = 0;
		
		Если КоличествоСтрок = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			КоличествоОбработано = КоличествоОбработано + 1;
			
			Если КоличествоОбработано = КоличествоСтрок Тогда
				Строка.СуммаНДС = СуммаНДСОбщая - СуммаНДСРасчетная;
			Иначе
				Строка.СуммаНДС = Формат(СуммаНДСОбщая/КоличествоСтрок, "ЧЦ=15; ЧДЦ=2");
				СуммаНДСРасчетная = СуммаНДСРасчетная + Строка.СуммаНДС;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
		НайденныеНомераУпаковок = ДокументОбъект.НомераУпаковок.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеНомераУпаковок.Количество() > 0 Тогда
			Строка.GTIN = Лев(НайденныеНомераУпаковок[0].НомерКИЗ, 14);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеСтатусУведомления(УведомлениеСсылка) Экспорт
	
	Возврат ИнтеграцияМДЛП.ТекущийСтатусУведомления(УведомлениеСсылка);
	
КонецФункции

Функция ПолучитьРеквизитЕстьМаркируемаяПродукция(ЧекККМСсылка) Экспорт
	
	Возврат ЧекККМСсылка.ор_ЕстьМаркируемаяПродукция;
	
КонецФункции

Процедура ЗаполнитьДанныеШапкиПередПробитиемЧека(ОбщиеПараметры, РеквизитыДокумента, РеквизитыКассыККМ) Экспорт
	
	ДокументСМДЛП = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(РеквизитыДокумента, "ор_ЕстьМаркируемаяПродукция");
	
	Если НЕ ДокументСМДЛП Тогда
		Возврат
	КонецЕсли;
	
	// тег 1084
	ПередаватьДанныеМаркировкиЧерезОФД = ор_ИнтеграцияМДЛП.ПолучитьПризнакПередачиДанныхМаркировкиЧерезОФД()
										И РеквизитыКассыККМ.ор_МДЛПОтправлятьДанныеМаркируемыхТоваровЧерезОФД
										И НЕ РеквизитыДокумента.ОперацияСДенежнымиСредствами
										//И НЕ РеквизитыДокумента.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат
										И РеквизитыДокумента.ор_ЕстьМаркируемаяПродукция;
	Если ПередаватьДанныеМаркировкиЧерезОФД Тогда
		
		Если ЗначениеЗаполнено(ОбщиеПараметры.Организация) Тогда
			вОрганизация = ОбщиеПараметры.Организация;
		Иначе
			вОрганизация = РеквизитыДокумента.Организация;
		КонецЕсли;
		
		ИдМестаДеятельностиМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(вОрганизация, РеквизитыКассыККМ.СтруктурнаяЕдиница, Истина).Идентификатор;
		
		СтруктураПользователяМДЛП = ИнтеграцияМДЛПКлиентСервер.ОписаниеДанныхПараметраДополнительныйРеквизитПользователяМДЛП();
		СтруктураПользователяМДЛП.ИдентификаторМестаДеятельностиМДЛП = ИдМестаДеятельностиМДЛП;
		
		СтруктураПользователяМДЛП.НомерСерииРецепта = РеквизитыДокумента.ор_НомерСерииРецепта;
		СтруктураПользователяМДЛП.НомерРецепта = РеквизитыДокумента.ор_НомерРецепта;
		СтруктураПользователяМДЛП.ДатаРегистрацииРецепта = РеквизитыДокумента.ор_ДатаРегистрацииРецепта;
		
		СтруктураДополнительныйРеквизитПользователя = ИнтеграцияМДЛПКлиентСервер.СформироватьПараметрДополнительныйРеквизитПользователяМДЛП(СтруктураПользователяМДЛП);
		
		ОбщиеПараметры.ДополнительныйРеквизитПользователя.Наименование = СтруктураДополнительныйРеквизитПользователя.Наименование;
		ОбщиеПараметры.ДополнительныйРеквизитПользователя.Значение     = СтруктураДополнительныйРеквизитПользователя.Значение;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеСтрокиПередПробитиемЧека(СтрокаПозицииЧека, СтрокаТЧ, ОбщиеПараметры) Экспорт
	
	ЕстьНомерКИЗ = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "НомерКИЗ");
	
	Если ЕстьНомерКИЗ И ЗначениеЗаполнено(СтрокаТЧ.НомерКИЗ) Тогда
		
		ЭтоДробнаяПродажа = Ложь;
		Если ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаИзмерения) И ТипЗнч(СтрокаТЧ.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
			ЭтоДробнаяПродажа = Истина;
		КонецЕсли;
		
		ГлобальныйИдентификаторТорговойЕдиницы = Лев(СтрокаТЧ.НомерКИЗ, 14);
		СерийныйНомер                          = Сред(СтрокаТЧ.НомерКИЗ, 15);
		
		СтрокаПозицииЧека.Штрихкод = "(01)" + ГлобальныйИдентификаторТорговойЕдиницы + "(21)" + СерийныйНомер;
		
		// тег 1162
		СтрокаПозицииЧека.ДанныеКодаТоварнойНоменклатуры.ТипМаркировки                          = Перечисления.ТипыМаркировкиККТ.ЛекарственныеПрепараты;
		СтрокаПозицииЧека.ДанныеКодаТоварнойНоменклатуры.ГлобальныйИдентификаторТорговойЕдиницы = ГлобальныйИдентификаторТорговойЕдиницы;
		СтрокаПозицииЧека.ДанныеКодаТоварнойНоменклатуры.СерийныйНомер                          = СерийныйНомер;
		КодТовара = МенеджерОборудованияМаркировкаКлиентСервер.СформироватьКодТовараДляDataMatrixGS1(ГлобальныйИдентификаторТорговойЕдиницы, СерийныйНомер);
		СтрокаПозицииЧека.ДанныеКодаТоварнойНоменклатуры.РеквизитКодаТовара = КодТовара.РеквизитКодаТовара;
		
		// тег 1191
		СтруктураПредметаРасчетаМДЛП = ИнтеграцияМДЛПКлиентСервер.ОписаниеДанныхПараметраДополнительныйРеквизитПредметаРасчетаМДЛП();
		Если ЭтоДробнаяПродажа Тогда
			СтруктураПредметаРасчетаМДЛП.КоличествоОтпущенныхПервичныхУпаковок           = СтрокаТЧ.Количество;
			СтруктураПредметаРасчетаМДЛП.КоличествоПервичныхУпаковокВМаркируемойУпаковке = СтрокаТЧ.ор_КоличествоПервичныхУпаковок;
		КонецЕсли;
		СтрокаПозицииЧека.ДополнительныйРеквизит = ИнтеграцияМДЛПКлиентСервер.СформироватьПараметрДополнительныйРеквизитПредметаРасчетаМДЛП(СтруктураПредметаРасчетаМДЛП);
		
		// ффд 1.2
		// тег 1260
		
		ИдМестаДеятельностиМДЛП = ПолучитьОрганизациюИМестоДеятельностиМДЛП(ОбщиеПараметры.Организация, СтрокаТЧ.СтруктурнаяЕдиница, Истина).Идентификатор;
		
		СтруктураТега1265МДЛП = ИнтеграцияМДЛПКлиентСервер.ОписаниеДанныхПараметраЗначениеОтраслевогоРеквизитаМДЛП();
		СтруктураТега1265МДЛП.ИдентификаторМестаДеятельностиМДЛП = ИдМестаДеятельностиМДЛП;
		
		СтруктураТега1265МДЛП.НомерСерииРецепта = СтрокаТЧ.ор_НомерСерииРецепта;
		СтруктураТега1265МДЛП.НомерРецепта = СтрокаТЧ.ор_НомерРецепта;
		СтруктураТега1265МДЛП.ДатаРегистрацииРецепта = СтрокаТЧ.ор_ДатаРегистрацииРецепта;
		
		СтруктураТега1265МДЛП.ИдентификаторЗапроса      = СтрокаТЧ.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
		СтруктураТега1265МДЛП.ВременнаяМетка            = СтрокаТЧ.РазрешительныйРежимДатаЗапросаГИСМТ;
		СтруктураТега1265МДЛП.ИдентификаторЭкземпляраПО = СтрокаТЧ.РазрешительныйРежимИдентификаторЭкземпляраПО;
		СтруктураТега1265МДЛП.ВерсияБазыЧерногоСписка   = СтрокаТЧ.РазрешительныйРежимВерсияБазы;
		
		ЗначениеТега1265МДЛП = ИнтеграцияМДЛПКлиентСервер.СформироватьПараметрЗначениеОтраслевогоРеквизитаМДЛП(СтруктураТега1265МДЛП);
		СтрокаПозицииЧека.ОтраслевойРеквизит = ИнтеграцияМДЛПКлиентСервер.СформироватьПараметрОтраслевойРеквизитМДЛП(ЗначениеТега1265МДЛП);
		
		// тег 1291
		Если ЭтоДробнаяПродажа Тогда
			СтруктураТега1291МДЛП = ИнтеграцияМДЛПКлиентСервер.ОписаниеДанныхПараметраДробноеКоличествоТовараМДЛП();
			СтруктураТега1291МДЛП.КоличествоОтпущенныхПервичныхУпаковок = СтрокаТЧ.Количество;
			СтруктураТега1291МДЛП.КоличествоПервичныхУпаковокВМаркируемойУпаковке = СтрокаТЧ.ор_КоличествоПервичныхУпаковок;
			СтрокаПозицииЧека.ДробноеКоличество = ИнтеграцияМДЛПКлиентСервер.СформироватьПараметрыДробногоКоличестваТовараМДЛП(СтруктураТега1291МДЛП);
		КонецЕсли;
		
		Если ор_ИнтеграцияМДЛП.ПолучитьПризнакКонтролироватьКодыМаркировкиСредствамиККТ() Тогда
			
			Количество = СтрокаТЧ.Количество * ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТЧ.ЕдиницаИзмерения);
			
			РезультатРаспределенияШтрихкодов = НовыйРезультатРаспределенияШтрихкодовПоТоварам();
			РезультатРаспределенияШтрихкодов.Вставить("Количество",           Количество);
			РезультатРаспределенияШтрихкодов.Вставить("КоличествоУпаковок",   СтрокаТЧ.Количество);
			РезультатРаспределенияШтрихкодов.Вставить("Штрихкод",             СтрокаПозицииЧека.Штрихкод);
			РезультатРаспределенияШтрихкодов.Вставить("ВидПродукции",         Перечисления.ВидыПродукцииИС.ПустаяСсылка());
			РезультатРаспределенияШтрихкодов.Вставить("ВидУпаковки",          Перечисления.ВидыУпаковокИС.Потребительская);
			РезультатРаспределенияШтрихкодов.Вставить("КодМаркировки",        СтрокаПозицииЧека.Штрихкод);
			РезультатРаспределенияШтрихкодов.Вставить("ПолныйКодМаркировки",  СтрокаТЧ.ПолныйКодМаркировки);
			РезультатРаспределенияШтрихкодов.Вставить("СоставКодаМаркировки", Неопределено);
			РезультатРаспределенияШтрихкодов.Вставить("ШтрихкодУпаковки",     Неопределено);
			РезультатРаспределенияШтрихкодов.Вставить("ТипШтрихкода",         Перечисления.ТипыШтрихкодов.GS1_DataMatrix);
			// КодЕдиницыИзмерения не нужно заполнять. Возникает ошибка программирования реквизита 2108.
			РезультатРаспределенияШтрихкодов.Вставить("КодЕдиницыИзмерения",  Неопределено);
			
			РезультатРаспределенияШтрихкодов.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ", СтрокаТЧ.РазрешительныйРежимИдентификаторЗапросаГИСМТ);
			РезультатРаспределенияШтрихкодов.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ",          СтрокаТЧ.РазрешительныйРежимДатаЗапросаГИСМТ);
			РезультатРаспределенияШтрихкодов.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО", СтрокаТЧ.РазрешительныйРежимИдентификаторЭкземпляраПО);
			РезультатРаспределенияШтрихкодов.Вставить("РазрешительныйРежимВерсияБазы",                СтрокаТЧ.РазрешительныйРежимВерсияБазы);
			
			Если ЭтоДробнаяПродажа Тогда
				
				ДробноеКоличествоМДЛП = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДробноеКоличество();
				ДробноеКоличествоМДЛП.Числитель = СтрокаТЧ.Количество;
				ДробноеКоличествоМДЛП.Знаменатель = СтрокаТЧ.ор_КоличествоПервичныхУпаковок;
				
				МераКоличестваМДЛП = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.МераКоличестваПредметаРасчетаПоКодуЕдиницыИзмерения(СтрокаПозицииЧека.КодЕдиницыИзмерения);
				
				ДробнаяПродажаМДЛП = Новый Структура;
				ДробнаяПродажаМДЛП.Вставить("ДробноеКоличествоМДЛП", ДробноеКоличествоМДЛП);
				ДробнаяПродажаМДЛП.Вставить("МераКоличестваМДЛП"   , МераКоличестваМДЛП);
				
				РезультатРаспределенияШтрихкодов.Вставить("ДробнаяПродажаМДЛП", ДробнаяПродажаМДЛП);
				
			КонецЕсли;
			
			СтрокаПозицииЧека.РезультатРаспределенияШтрихкодовМДЛП = РезультатРаспределенияШтрихкодов;
			ПолныйКодМаркировки = СтрокаТЧ.ПолныйКодМаркировки;
			Если ЗначениеЗаполнено(ПолныйКодМаркировки) Тогда
				СтрокаПозицииЧека.ШтрихкодBase64 = ПолныйКодМаркировки;
				СтрокаПозицииЧека.КонтрольнаяМарка = ПолныйКодМаркировки;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ор_ИнтеграцияМДЛП.ПолучитьФлагМаркируемогоТовара(СтрокаТЧ.Номенклатура) Тогда
		
		Если ЗначениеЗаполнено(СтрокаПозицииЧека.Штрихкод) Тогда
			СтруктураМаркировкиМДЛП = ор_ИнтеграцияМДЛПКлиентСервер.РазобратьШтрихкодПоТипу(СтрокаПозицииЧека.Штрихкод, Ложь);
			Если СтруктураМаркировкиМДЛП.Свойство("МаркированныйТовар") Тогда
				СтрокаПозицииЧека.Штрихкод = Сред(СтруктураМаркировкиМДЛП.Данные.GTIN, 2);
			КонецЕсли;
		КонецЕсли;
		
		// Если товар маркируемый, но в характеристике не стоит признак маркировки 
		// и у товара признак предмета расчета макируемый, то ставим признак предмета расчета обычного товара
		Если СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ Тогда
			СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Новый результат распределения штрихкодов по товарам.
// 
// Возвращаемое значение:
//  Структура - Данные о коде маркировки:
// * Количество                     - Число  - Количество базовых единиц.
// * КоличествоУпаковок             - Число  - Устарел. Количество упаковок.
// * Штрихкод                       - Строка - Строковое представление кода маркиаровки.
// * ВидПродукции                   - ПеречислениеСсылка.ВидыПродукцииИС         - Вид продукции.
// * ВидУпаковки                    - ПеречислениеСсылка.ВидыУпаковокИС          - Вид упаковки.
// * ШтрихкодУпаковки               - СправочникСсылка.ШтрихкодыУпаковокТоваров  - Штрихкод упаковки.
// * КодМаркировки                  - Строка               - Нормализованный код маркировки.
// * ПолныйКодМаркировки            - Строка, Неопределено - Полный код маркировки (base64).
// * СоставКодаМаркировки           - Структура            - Состав кода маркировки.
// * ЧастичноеВыбытие               - Булево               - Признак частичного выбытия части упаковки.
// * ЕмкостьПотребительскойУпаковки - Число                - Знаменатель значения частичного выбытия.
// * ТекстОшибки                    - Строка, Неопределено - Текст ошибки распределения.
// * КодЕдиницыИзмерения            - Строка, Неопределено - Код единицы измерения частично выбытия.
// * ЧастичноеВыбытиеКоличество     - Число, Неопределено  - Числитель частичного выбытия.
// * РазрешительныйРежимИдентификаторЗапросаГИСМТ - ОпределяемыйТип.УникальныйИдентификаторИС - Идентификатор запроса ГИС МТ
// * РазрешительныйРежимДатаЗапросаГИСМТ - Строка - Дата получения идентификатора ГИС МТ в формате timestamp
// * РазрешительныйРежимИдентификаторЭкземпляраПО - ОпределяемыйТип.УникальныйИдентификаторИС - Идентификатор локального модуля ГИС МТ
// * РазрешительныйРежимВерсияБазы - ОпределяемыйТип.УникальныйИдентификаторИС - Идентификатор базы данных локального модуля ГИС МТ.
//
Функция НовыйРезультатРаспределенияШтрихкодовПоТоварам()
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Количество",                                   0);
	ВозвращаемоеЗначение.Вставить("КоличествоПотребительскихУпаковок",            0);
	ВозвращаемоеЗначение.Вставить("КоличествоУпаковок",                           0);
	ВозвращаемоеЗначение.Вставить("Штрихкод",                                     "");
	ВозвращаемоеЗначение.Вставить("ВидПродукции",                                 Неопределено);
	ВозвращаемоеЗначение.Вставить("ВидУпаковки",                                  Неопределено);
	ВозвращаемоеЗначение.Вставить("КодМаркировки",                                Неопределено);
	ВозвращаемоеЗначение.Вставить("ПолныйКодМаркировки",                          Неопределено);
	ВозвращаемоеЗначение.Вставить("СоставКодаМаркировки",                         Неопределено);
	ВозвращаемоеЗначение.Вставить("ШтрихкодУпаковки",                             Неопределено);
	ВозвращаемоеЗначение.Вставить("ТипШтрихкода",                                 Неопределено);
	ВозвращаемоеЗначение.Вставить("ЕмкостьПотребительскойУпаковки",               0);
	ВозвращаемоеЗначение.Вставить("ЧастичноеВыбытие",                             Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",                                  Неопределено);
	ВозвращаемоеЗначение.Вставить("ЗапрещеноИгнорироватьОшибку",                  Неопределено);
	ВозвращаемоеЗначение.Вставить("КодЕдиницыИзмерения",                          Неопределено);
	ВозвращаемоеЗначение.Вставить("ЧастичноеВыбытиеКоличество",                   0);
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ", "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ",          "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО", "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимВерсияБазы",                "");
	ВозвращаемоеЗначение.Вставить("ЧастичноеВыбытиеОстаток",                      Неопределено);
	ВозвращаемоеЗначение.Вставить("ЧастичноеВыбытиеКомментарий",                  Неопределено);
	ВозвращаемоеЗначение.Вставить("МинимальнаяРозничнаяЦена",                     0);
	ВозвращаемоеЗначение.Вставить("Сумма",                                        0);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ЭтоКассаСФФД12(КассаККМ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КассаККМ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПодключаемоеОборудование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ, "ПодключаемоеОборудование");
	
	Возврат ОборудованиеЧекопечатающиеУстройстваВызовСервера.ФискальноеУстройствоПоддерживаетПроверкуКодовМаркировки(ПодключаемоеОборудование);
	
КонецФункции

Процедура ЗаполнитьДанныеРецептаДляККТ105(Объект, ИмяТЧТовары = "Запасы") Экспорт
	
	// Для ккт < 1.2 заполняем данные по рецепту в шапку.
	
	Если ЭтоКассаСФФД12(Объект.КассаККМ) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект[ИмяТЧТовары] Цикл
		Если ЗначениеЗаполнено(Строка.ор_ДатаРегистрацииРецепта) Тогда
			Объект.ор_НомерСерииРецепта      = Строка.ор_НомерСерииРецепта;
			Объект.ор_НомерРецепта           = Строка.ор_НомерРецепта;
			Объект.ор_ДатаРегистрацииРецепта = Строка.ор_ДатаРегистрацииРецепта;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииНовогоРМК

// Заполняет таблицу данными о переданных товарах.
// Таблица должна содержать данные для заполнения табличной части "Товары" обработки "РабочееМестоКассира".
//
// Параметры:
//  МассивТоваров - Массив - массив, в котором содержится список товаров.
//  ТаблицаТовары - ТаблицаЗначений - таблица, в которую необходимо поместить информацию по товарам.
//
Процедура ЗаполнитьТаблицуТовары(ТаблицаТовары, ТекущийВыбор, ЗапретитьВводНомеров = Ложь) Экспорт
	
	Если ЗапретитьВводНомеров Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ВестиСведенияДляМониторингаДвиженияЛекарственныхПрепаратов") Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = ТекущийВыбор.Номенклатура;
	Если ТекущийВыбор.Свойство("Характеристика") Тогда
		Характеристика = ТекущийВыбор.Характеристика;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номенклатура)
		И ЗначениеЗаполнено(Характеристика)
		и ПроверитьНоменклатуруМаркировки(Номенклатура)
		и ПроверитьХарактеристикуМаркировки(Характеристика) Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаТовары Цикл
			СтрокаТаблицы.Маркируемый = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбновления

Процедура ЗаполнитьКонтрольСтатусовКИЗПриПробитииЧерезРМК() Экспорт
	

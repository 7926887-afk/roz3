	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика,
	|	втТовары.Количество,
	|	втТовары.КоличествоУпаковок,
	|	втТовары.ЕдиницаИзмерения,
	|	втТовары.ИдентификаторСтроки
	|;
	|
	// 3 номера упаковок
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерКИЗ КАК НомерКИЗ,
	|	втТовары.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	втТовары КАК втТовары";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	Результат = Запрос.ВыполнитьПакет();
	РезультатШапка                      = Результат[0].Выгрузить();
	РезультатТовары                     = Результат[2].Выгрузить();
	РезультатНомера                     = Результат[3].Выгрузить();
	
	Шапка = РезультатШапка[0];
	
	СтруктураОрганизации = ПолучитьОрганизациюИМестоДеятельности(Шапка.ОрганизацияМДЛП, Шапка.МестоДеятельностиМДЛП, Истина);
	
	ДокументОбъект.Организация        = СтруктураОрганизации.Организация;
	ДокументОбъект.СтруктурнаяЕдиница = СтруктураОрганизации.МестоДеятельности;
	
	НуженПересчетКоличества = Ложь;
	Для Каждого Строка Из РезультатТовары Цикл
		НоваяСтрока = ДокументОбъект.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Количество = Строка.КоличествоУпаковок;
		Если Строка.Количество <> Строка.КоличествоНомеров Тогда
			НоваяСтрока.Количество = Строка.КоличествоНомеров/ПолучитьКоэффициентЕдиницыИзмерения(НоваяСтрока.ЕдиницаИзмерения);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из РезультатНомера Цикл
		НоваяСтрока = ДокументОбъект.ор_НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
КонецПроцедуры


#Область ПроцедурыИФункцииСозданияУпаковокМаркируемыхТоваров

Процедура ор_ЗаписатьУпаковкиМаркируемыхТоваровОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	ТипИсточника = ТипЗнч(Источник);
	
	Если ТипИсточника = Тип("ДокументОбъект.ПриходнаяНакладная")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ОприходованиеЗапасов") Тогда
		ЗаписатьУпаковкиМаркируемыхТоваровПоступление(Источник.Ссылка);
	Иначе
		ЗаписатьУпаковкиМаркируемыхТоваровУведомление(Источник.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьУпаковкиМаркируемыхТоваровПоступление(Поступление)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	НомераУпаковок.НомерКИЗ КАК НомерУпаковки
	|ПОМЕСТИТЬ УпаковкиУведомления
	|ИЗ
	|	Документ.ПриходнаяНакладная.Запасы КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО (НомераУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (НомераУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Поступление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика,
	|	НомераУпаковок.НомерКИЗ
	|ИЗ
	|	Документ.ОприходованиеЗапасов.Запасы КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОприходованиеЗапасов.ор_НомераУпаковок КАК НомераУпаковок
	|		ПО (НомераУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (НомераУпаковок.ИдентификаторСтроки = ТаблицаТовары.ор_ИдентификаторСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Поступление";
	
	Запрос.УстановитьПараметр("Поступление", Поступление);
	
	Запрос.Выполнить();
	
	ИнтеграцияМДЛП.ДобавитьКлючиУпаковок(Запрос.МенеджерВременныхТаблиц, "УпаковкиУведомления");
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкиУведомления.Номенклатура КАК Номенклатура,
	|	УпаковкиУведомления.Характеристика КАК Характеристика,
	|	УпаковкиУведомления.НомерУпаковки КАК НомерУпаковки,
	|	УпаковкиМаркируемыхТоваров.Ссылка КАК Упаковка
	|ИЗ
	|	УпаковкиУведомления КАК УпаковкиУведомления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ор_МДЛПУпаковкиМаркируемыхТоваров КАК УпаковкиМаркируемыхТоваров
	|		ПО (УпаковкиМаркируемыхТоваров.НомерУпаковки = УпаковкиУведомления.НомерУпаковки)
	|			И (УпаковкиМаркируемыхТоваров.КлючУпаковки = УпаковкиУведомления.КлючУпаковки)
	|ГДЕ
	|	(УпаковкиМаркируемыхТоваров.Ссылка ЕСТЬ NULL
	|			ИЛИ УпаковкиМаркируемыхТоваров.Номенклатура <> УпаковкиУведомления.Номенклатура
	|			ИЛИ УпаковкиМаркируемыхТоваров.Характеристика <> УпаковкиУведомления.Характеристика)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ (ЗначениеЗаполнено(Выборка.Номенклатура) И ЗначениеЗаполнено(Выборка.Характеристика)) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Упаковка) Тогда
			УпаковкаМаркируемогоТоваров = Выборка.Упаковка.ПолучитьОбъект();
		Иначе
			УпаковкаМаркируемогоТоваров = Справочники.ор_МДЛПУпаковкиМаркируемыхТоваров.СоздатьЭлемент();
			УпаковкаМаркируемогоТоваров.НомерУпаковки = Выборка.НомерУпаковки;
		КонецЕсли;
		
		УпаковкаМаркируемогоТоваров.Номенклатура   = Выборка.Номенклатура;
		УпаковкаМаркируемогоТоваров.Характеристика = Выборка.Характеристика;
		
		УпаковкаМаркируемогоТоваров.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьУпаковкиМаркируемыхТоваровУведомление(Уведомление)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	НомераУпаковок.НомерКИЗ КАК НомерУпаковки
	|ПОМЕСТИТЬ УпаковкиУведомления
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.Товары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ПО (НомераУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (НомераУпаковок.ИдентификаторСтроки = ТаблицаТовары.ИдентификаторСтроки)
	|			И (НомераУпаковок.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.Подтверждено))
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Уведомление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика,
	|	НомераУпаковок.НомерКИЗ
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП.СоставТранспортныхУпаковок КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ПО (НомераУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (НомераУпаковок.ИдентификаторСтроки = ТаблицаТовары.ИдентификаторСтрокиУпаковки)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП.ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|		ПО (ТранспортныеУпаковки.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТранспортныеУпаковки.ИдентификаторСтроки = ТаблицаТовары.ИдентификаторСтроки)
	|			И (ТранспортныеУпаковки.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.Подтверждено))
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Уведомление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика,
	|	НомераУпаковок.НомерКИЗ
	|ИЗ
	|	Документ.УведомлениеОПеремещенииМДЛП.Товары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПеремещенииМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ПО (НомераУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (НомераУпаковок.ИдентификаторСтроки = ТаблицаТовары.ИдентификаторСтроки)
	|			И (НомераУпаковок.Ссылка.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ПринятоГИСМ))
	|			И (НЕ НомераУпаковок.Отклонено)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Уведомление
	|	И ТаблицаТовары.Ссылка.Операция = &Операция
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика,
	|	НомераУпаковок.НомерКИЗ
	|ИЗ
	|	Документ.УведомлениеОПеремещенииМДЛП.СоставТранспортныхУпаковок КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПеремещенииМДЛП.НомераУпаковок КАК НомераУпаковок
	|		ПО (НомераУпаковок.Ссылка = ТаблицаТовары.Ссылка)
	|			И (НомераУпаковок.ИдентификаторСтроки = ТаблицаТовары.ИдентификаторСтрокиУпаковки)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОПеремещенииМДЛП.ТранспортныеУпаковки КАК ТранспортныеУпаковки
	|		ПО (ТранспортныеУпаковки.Ссылка = ТаблицаТовары.Ссылка)
	|			И (ТранспортныеУпаковки.ИдентификаторСтроки = ТаблицаТовары.ИдентификаторСтроки)
	|			И (ТранспортныеУпаковки.Ссылка.СостояниеПодтверждения = ЗНАЧЕНИЕ(Перечисление.СостоянияПодтвержденияМДЛП.ПринятоГИСМ))
	|			И (НЕ ТранспортныеУпаковки.Отклонено)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Уведомление
	|	И ТаблицаТовары.Ссылка.Операция = &Операция
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика,
	|	НомераУпаковок.НомерКИЗ
	|ИЗ
	|	Документ.УведомлениеОбОприходованииМДЛП.Товары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОприходованииМДЛП.НомераУпаковок КАК НомераУпаковок

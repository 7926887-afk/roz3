Процедура РазрешительныйРежимМиграцияНастроекМДЛП() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Переносим данные по токена разрешительного режима.
	ПараметрыЗапроса = РазрешительныйРежимМДЛПКлиентСервер.ПараметрыЗапросаКлючаСессииГИСМТРозница();
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеКлючаСессии.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.ДанныеКлючаСессииИСМП КАК ДанныеКлючаСессии
	|ГДЕ
	|	ДанныеКлючаСессии.ИмяПараметраСеанса = &ИмяПараметраСеанса
	|");
	
	Запрос.УстановитьПараметр("ИмяПараметраСеанса", ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ИмяДанныхКлючаСессии(Перечисления.ТипыТокеновАвторизации.ИСМПРозница));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		НаборЗаписей = РегистрыСведений.ДанныеКлючаСессииМДЛП.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИмяПараметраКлючаСессии.Установить(ПараметрыЗапроса.ИмяПараметраКлючаСессии, Истина);
		
		ЗаписьНабора = НаборЗаписей.Добавить();
		ЗаписьНабора.ИмяПараметраКлючаСессии = ПараметрыЗапроса.ИмяПараметраКлючаСессии;
		
		ДанныеКлючаСессии = Новый Соответствие;
		ДанныеИСМП = Выборка.Данные.Получить();
		Если ДанныеИСМП <> Неопределено Тогда
			Для Каждого КлючИЗначение Из ДанныеИСМП Цикл
				ОрганизацияМДЛП = ИнтеграцияМДЛПВызовСервера.ОрганизацияМДЛППоОрганизации(КлючИЗначение.Ключ);
				Если ЗначениеЗаполнено(ОрганизацияМДЛП) Тогда
					ДанныеКлючаСессии.Вставить(ОрганизацияМДЛП, КлючИЗначение.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ЗаписьНабора.Данные = Новый ХранилищеЗначения(ДанныеКлючаСессии);
		
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	
	// Переносим данные по CDN-площадкам.
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СостоянияCDNПлощадокИСМП.АдресПлощадки КАК АдресПлощадки,
	|	СостоянияCDNПлощадокИСМП.СреднееВремяПроверкиКМ КАК СреднееВремяПроверкиКМ,
	|	СостоянияCDNПлощадокИСМП.СреднееВремяОтвета КАК СреднееВремяОтвета,
	|	СостоянияCDNПлощадокИСМП.ДатаНедоступнаДоУниверсальная КАК ДатаНедоступнаДоУниверсальная,
	|	СостоянияCDNПлощадокИСМП.ДатаОбновленияУниверсальная КАК ДатаОбновленияУниверсальная,
	|	СостоянияCDNПлощадокИСМП.Сервер КАК Сервер,
	|	СостоянияCDNПлощадокИСМП.Порт КАК Порт,
	|	СостоянияCDNПлощадокИСМП.ЗащищенноеСоединение КАК ЗащищенноеСоединение
	|ИЗ
	|	РегистрСведений.СостоянияCDNПлощадокИСМП КАК СостоянияCDNПлощадокИСМП");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяЗапись = РегистрыСведений.СостоянияCDNПлощадокМДЛП.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
		НоваяЗапись.Записать(Истина);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура КопированиеНастроекЛокальныхМодулейИзПодсистемыИСМП() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Переносим данные по токена разрешительного режима.
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СубъектыОбращенияМДЛП.Организация КАК Организация,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.РабочееМесто КАК РабочееМесто,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.Приоритет КАК Приоритет,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.АдресПодключенияЛМ КАК АдресПодключенияЛМ,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.Логин КАК Логин,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.ОбменНаСервере КАК ОбменНаСервере,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.Таймаут КАК Таймаут,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.СерверПодключенияЛМ КАК СерверПодключенияЛМ,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.ПортПодключенияЛМ КАК ПортПодключенияЛМ,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.ЗащищенноеСоединение КАК ЗащищенноеСоединение,
	|	НастройкиПодключенияЛокальныхМодулейИСМП.ХешСумма КАК ХешСумма
	|ИЗ
	|	РегистрСведений.НастройкиПодключенияЛокальныхМодулейИСМП КАК НастройкиПодключенияЛокальныхМодулейИСМП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|		ПО НастройкиПодключенияЛокальныхМодулейИСМП.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
	|ГДЕ
	|	СубъектыОбращенияМДЛП.СобственнаяОрганизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	РабочееМесто,
	|	Приоритет
	|ИТОГИ ПО
	|	Организация,
	                      |	РабочееМесто");
	
	ВыборкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоОрганизации.Следующий() Цикл
		
		ВыборкаПоРабочемуМесту = ВыборкаПоОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоРабочемуМесту.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.НастройкиПодключенияЛокальныхМодулейМДЛП.СоздатьНаборЗаписей();
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			
			НаборЗаписей.Отбор.Организация.Установить(ВыборкаПоОрганизации.Организация, Истина);
			НаборЗаписей.Отбор.РабочееМесто.Установить(ВыборкаПоРабочемуМесту.РабочееМесто, Истина);
			
			Приоритет = 0;
			СписокАдресов = Новый Массив;
			Выборка = ВыборкаПоРабочемуМесту.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Если СписокАдресов.Найти(Выборка.АдресПодключенияЛМ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаписьНабора = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(ЗаписьНабора, Выборка);
				ЗаписьНабора.Приоритет = Приоритет;
				Приоритет = Приоритет + 1;
				
				СписокАдресов.Добавить(Выборка.АдресПодключенияЛМ);
				
			КонецЦикла;
			
			Попытка
				НаборЗаписей.Записать(Истина);
			Исключение
				ТекстСообщения = НСтр("ru= 'Не удалось перенести настройки подключения к локальным модулям из подсистемы ИСМП в подсистему МДЛП по причине: %Причина%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,,, ТекстСообщения);
			КонецПопытки;
			
		КонецЦикла;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


#Область ОбработчикиСобытийДокументов

// Вызывается при вводе документа на основании, при выполнении метода Заполнить или при интерактивном вводе нового.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - заполняемый документ,
//  ДанныеЗаполнения - Произвольный - значение, которое используется как основание для заполнения,
//  ТекстЗаполнения - Строка, Неопределено - текст, используемый для заполнения документа,
//  СтандартнаяОбработка - Булево - признак выполнения стандартной (системной) обработки события.
//
Процедура ОбработкаЗаполнения(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОприходованииМДЛП") Тогда
			ЗаполнитьУведомлениеОбОприходованииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		Иначе
			ЗаполнитьУведомлениеОПриемеПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОприходованииМДЛП") Тогда
			ЗаполнитьУведомлениеОбОприходованииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП") Тогда
			ЗаполнитьУведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛППоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
		Иначе
			ЗаполнитьУведомлениеОбОтгрузкеПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СписаниеЗапасов")
		И  ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОВыбытииМДЛП") Тогда
		ЗаполнитьУведомлениеОВыбытииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ор_ИзготовлениеЛекарственныхФорм")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОВыбытииМДЛП") Тогда
		ЗаполнитьУведомлениеОВыбытииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КомплектацияЗапасов")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОВыбытииМДЛП") Тогда
		ЗаполнитьУведомлениеОВыбытииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СписаниеЗапасов")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОПередачеНаУничтожениеМДЛП") Тогда
		ЗаполнитьУведомлениеПередачеНаУничтожениеПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		ЗаполнитьУведомлениеОПеремещенииПоОснованию(ДокументОбъект, ДанныеЗаполнения, Неопределено, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
		
		Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
			ЗаполнитьУведомлениеОПеремещенииПоОснованию(ДокументОбъект, ДанныеЗаполнения.ДокументОснование, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОприходованииМДЛП") Тогда
			ЗаполнитьУведомлениеОбОприходованииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		Иначе
			ЗаполнитьУведомлениеОПриемеПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		
		Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
			ЗаполнитьУведомлениеОПеремещенииПоОснованию(ДокументОбъект, ДанныеЗаполнения.ДокументОснование, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОприходованииМДЛП") Тогда
			ЗаполнитьУведомлениеОбОприходованииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП") Тогда
			ЗаполнитьУведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛППоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
		Иначе
			ЗаполнитьУведомлениеОбОтгрузкеПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УведомлениеОПередачеНаУничтожениеМДЛП") Тогда
		ЗаполнитьУведомлениеОФактеУничтоженияПоПередачеНаУничтожение(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОприходованиеЗапасов")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОПовторномВводеВОборотМДЛП") Тогда
		ЗаполнитьУведомлениеОПовторномВводеВОборотПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОприходованиеЗапасов")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.УведомлениеОбОприходованииМДЛП") Тогда
		ЗаполнитьУведомлениеОбОприходованииПоОснованию(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекККМ") Тогда
		ЗаполнитьУведомлениеОРозничнойПродажеПоЧекуККМ(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УведомлениеОПриемкеМДЛП")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная") Тогда
		ЗаполнитьПриходнаяНакладнаяПоУведомлениюОПриеме(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УведомлениеОВыбытииМДЛП")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СписаниеЗапасов") Тогда
		ЗаполнитьСписаниеТоваровПоУведомлениюОВыбытии(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УведомлениеОбОприходованииМДЛП")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОприходованиеЗапасов") Тогда
		ЗаполнитьОприходованиеЗапасовПоУведомлениеОбОприходованииМДЛП(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИнвентаризацияПотребительскихУпаковокМДЛП")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ИнвентаризацияЗапасов") Тогда
		ЗаполнитьИнвентаризацияЗапасовПоИнвентаризацияПотребительскихУпаковокМДЛП(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УведомлениеОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП")
		И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходнаяНакладная") Тогда
		ЗаполнитьРасходнаяНакладнаяПоУведомлениюОбОтпускеЛППоДокументамОтличнымОтЧекаМДЛП(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается расширением формы при необходимости проверки заполнения реквизитов
// при записи или при проведении документа в форме,
// а также при выполнении метода ПроверитьЗаполнение.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - проверяемый документ,
//  Отказ - Булево - признак отказа от проведения документа,
//  ПроверяемыеРеквизиты - Массив - массив путей к реквизитам, для которых будет выполнена проверка заполнения,
//  НепроверяемыеРеквизиты - Массив - массив путей к реквизитам, для которых не будет выполнена проверка заполнения.
//
Процедура ОбработкаПроверкиЗаполнения(ДокументОбъект, Отказ, ПроверяемыеРеквизиты, НепроверяемыеРеквизиты = Неопределено) Экспорт
	
	Если НепроверяемыеРеквизиты = Неопределено Тогда
		НепроверяемыеРеквизиты = Новый Массив;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОприходованиеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПеремещениеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходныйОрдер")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходнаяНакладная")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходныйОрдер")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КомплектацияЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СписаниеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМ") Тогда
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОприходованиеЗапасов")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПеремещениеЗапасов")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходныйОрдер")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходнаяНакладная")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходныйОрдер")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КомплектацияЗапасов")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм")
			ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СписаниеЗапасов") Тогда
			ПроверитьЗаполнениеНомеровУпаковок(ДокументОбъект, Отказ);
			ПроверитьДублиНомеровУпаковок(ДокументОбъект, Отказ);
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная") Тогда
			ПроверитьЗаполнениеGTIN(ДокументОбъект, Отказ);
			ПроверитьЗаполнениеТранспортныхУпаковок(ДокументОбъект, Отказ);
			//ПроверитьКомиссионныеТовары(ДокументОбъект, Отказ);
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходныйОрдер") Тогда
			Если ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
				ПроверитьЗаполнениеGTIN(ДокументОбъект, Отказ);
			КонецЕсли;
			ПроверитьЗаполнениеТранспортныхУпаковок(ДокументОбъект, Отказ,,,,, Ложь);
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходнаяНакладная") Тогда
			ПроверитьЗаполнениеТранспортныхУпаковок(ДокументОбъект, Отказ);
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходныйОрдер") Тогда
			ПроверитьЗаполнениеТранспортныхУпаковок(ДокументОбъект, Отказ,,,,, Ложь);
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СписаниеЗапасов") Тогда
			ПроверитьУпаковкиНоменклатуры(ДокументОбъект, Отказ,,,, Истина);
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм") Тогда
			ПроверитьУпаковкиНоменклатуры(ДокументОбъект, Отказ,,,, Истина);
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМ") Тогда
			ПроверитьЗаполнениеНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ);
			ПроверитьЗаполнениеНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ, "Подарки", "ор_НомераУпаковокПодарков",,, Истина);
			
			ПроверитьОстатокНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ);
			ПроверитьОстатокНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ, "Подарки", "ор_НомераУпаковокПодарков",,, Истина);
			
			ПроверитьДублиНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ);
			ПроверитьДублиНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ, "Подарки", "ор_НомераУпаковокПодарков");
			
			ПроверитьСтатусыНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ);
			ПроверитьСтатусыНомеровУпаковокПриРозничнойПродаже(ДокументОбъект, Отказ, "Подарки", "ор_НомераУпаковокПодарков");
			
			ПроверитьСкладыВРозничнойПродаже(ДокументОбъект, Отказ);
			ПроверитьУпаковкиНоменклатуры(ДокументОбъект, Отказ);
			
			ПроверитьДанныеРецептовПриРозничнойПродаже(ДокументОбъект, Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Возникает перед выполнением записи документа. Вызывается после начала транзакции записи, но до начала записи документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - записываемый документ,
//  Отказ - Булево - признак отказа от записи,
//  РежимЗаписи - РежимЗаписиДокумента - текущий режим записи документа,
//  РежимПроведения - РежимПроведенияДокумента - текущий режим проведения документа.
//
Процедура ПередЗаписью(ДокументОбъект, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОприходованиеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПеремещениеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходныйОрдер")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходнаяНакладная")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходныйОрдер")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КомплектацияЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СписаниеЗапасов") Тогда
		УдалитьНеиспользуемыеНомераУпаковок(ДокументОбъект);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗаполнитьПризнакиЕстьМаркируемаяПродукция(ДокументОбъект));
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМ") Тогда
		УдалитьНеиспользуемыеНомераУпаковок(ДокументОбъект);
		УдалитьНеиспользуемыеНомераУпаковок(ДокументОбъект, "Подарки", "ор_НомераУпаковокПодарков");
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗаполнитьПризнакиЕстьМаркируемаяПродукция(ДокументОбъект,,, ДокументОбъект.ОперацияСДенежнымиСредствами));
		ЗаполнитьДанныеРецептаДляККТ105(ДокументОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Возникает перед выполнением копирования документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - записываемый документ,
//  ОбъектКопирования -  ДокументСсылка - копируемый документ.
//
Процедура ПриКопировании(ДокументОбъект, ОбъектКопирования) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОприходованиеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПеремещениеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходнаяНакладная")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходныйОрдер")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходнаяНакладная")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходныйОрдер")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КомплектацияЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.СписаниеЗапасов")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ор_ИзготовлениеЛекарственныхФорм")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМ") Тогда
		
		ДокументОбъект.ор_НомераУпаковок.Очистить();
		ДокументОбъект.ор_ЕстьМаркируемаяПродукция = Ложь;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ор_НомераУпаковокПодарков") Тогда
			ДокументОбъект.ор_НомераУпаковокПодарков.Очистить();
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ор_ТранспортныеУпаковки") Тогда
			ДокументОбъект.ор_ТранспортныеУпаковки.Очистить();
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ор_СоставТранспортныхУпаковок") Тогда
			ДокументОбъект.ор_СоставТранспортныхУпаковок.Очистить();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СозданиеКомандыРегистрацииGTIN

// Процедура - Создать команду регистрации GTINНа форме
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения - форма клиентского приложения
//
Процедура СоздатьКомандуРегистрацииGTINНаФорме(Форма) Экспорт
	
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ШтрихкодыНоменклатуры) Тогда
		Возврат;
	КонецЕсли;
	
	МассивКоманд = ПолучитьКомандыРегистрацииGTIN();
	
	Для Каждого Команда Из МассивКоманд Цикл
		Если Форма.ИмяФормы <> Команда.ИмяФормы Тогда
			Продолжить;
		КонецЕсли;
		СоздатьКомандуРегистрацииGTIN(Форма, Команда);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти // СозданиеКомандыРегистрацииGTIN

// См. РаботаСоШтрихкодамиПереопределяемый.ДобавитьТекстЗапросаШтрихкодыУпаковокТоваров.
Процедура ДобавитьТекстЗапросаШтрихкодыУпаковокТоваров(ФильтрПоискаПоШтрихкоду, МассивЗапросов) Экспорт
	
	СУсловиемПоиска = ФильтрПоискаПоШтрихкоду.Количество() > 0;
	
	Если СУсловиемПоиска И НЕ ФильтрПоискаПоШтрихкоду.Свойство("Номенклатура") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Штрихкоды.НомерУпаковки,
	|	Штрихкоды.Номенклатура,
	|	Штрихкоды.Характеристика,
	|	Значение(Справочник.ЕдиницыИзмерения.ПустаяСсылка),
	|	Значение(Справочник.СерииНоменклатуры.ПустаяСсылка),
	|	Значение(Справочник.ПартииНоменклатуры.ПустаяСсылка),
	|	1,
	|	НЕОПРЕДЕЛЕНО
	|ИЗ
	|	Справочник.ор_МДЛПУпаковкиМаркируемыхТоваров КАК Штрихкоды";
	
	Если СУсловиемПоиска Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ Штрихкоды.НомерУпаковки = &НомерУпаковкиSGTIN И Штрихкоды.КлючУпаковки = &КлючУпаковкиSGTIN";
	КонецЕсли;
	
	МассивЗапросов.Добавить(ТекстЗапроса);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияПоШтриходамМДЛП(ДанныеПоШтрихкодам, ПараметрыСканирования) Экспорт
	
	ДанныеКодовМаркировки = ДанныеПоШтрихкодам.ДанныеКодовМаркировки;
	Если ДанныеКодовМаркировки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ор_ИнтеграцияМДЛПКлиентСерверПовтИсп.ПолучитьПризнакВеденияУчетаМаркировки() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиДляУточнения = Новый ТаблицаЗначений;
	СтрокиДляУточнения.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200)));
	СтрокиДляУточнения.Колонки.Добавить("НомерУпаковки", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(27)));
	СтрокиДляУточнения.Колонки.Добавить("КлючУпаковки", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	
	Для Каждого СтрокаДанных Из ДанныеКодовМаркировки Цикл
		СтрокаДанных.ЭтоПродукцияМДЛП = Ложь;
		Если ЗначениеЗаполнено(СтрокаДанных.Номенклатура)
			И ПроверитьНоменклатуруМаркировки(СтрокаДанных.Номенклатура) Тогда
			
			Если ЗначениеЗаполнено(СтрокаДанных.Характеристика)
				И ПроверитьХарактеристикуМаркировки(СтрокаДанных.Характеристика) Тогда
				СтрокаДанных.ЭтоПродукцияМДЛП = Истина;
			Иначе
				
				НоваяСтрока = СтрокиДляУточнения.Добавить();
				НоваяСтрока.НомерУпаковки = СтрокаДанных.SGTIN;
				НоваяСтрока.КлючУпаковки  = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(СтрокаДанных.SGTIN);
				НоваяСтрока.Штрихкод      = СтрокаДанных.ШтрихкодBase64;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокиДляУточнения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТЗSGTIN.НомерУпаковки КАК НомерУпаковки,
	|	ТЗSGTIN.КлючУпаковки КАК КлючУпаковки,
	|	ТЗSGTIN.ШтрихКод КАК ШтрихКод
	|ПОМЕСТИТЬ ВременнаяТаблицаSGTIN
	|ИЗ
	|	&ТЗSGTIN КАК ТЗSGTIN
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблицаSGTIN.ШтрихКод КАК Штрихкод,
	|	УпаковкиМаркируемыхТоваров.Номенклатура КАК Номенклатура,
	|	УпаковкиМаркируемыхТоваров.Характеристика КАК Характеристика
	|ИЗ
	|	Справочник.ор_МДЛПУпаковкиМаркируемыхТоваров КАК УпаковкиМаркируемыхТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВременнаяТаблицаSGTIN КАК ВременнаяТаблицаSGTIN
	|		ПО УпаковкиМаркируемыхТоваров.НомерУпаковки = ВременнаяТаблицаSGTIN.НомерУпаковки
	|			И УпаковкиМаркируемыхТоваров.КлючУпаковки = ВременнаяТаблицаSGTIN.КлючУпаковки
	|			И (НЕ УпаковкиМаркируемыхТоваров.ПометкаУдаления)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО УпаковкиМаркируемыхТоваров.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО УпаковкиМаркируемыхТоваров.Характеристика = СпрХарактеристикиНоменклатуры.Ссылка
	|ГДЕ
	|	СпрНоменклатура.КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров
	|	И ЕСТЬNULL(СпрХарактеристикиНоменклатуры.ор_МаркируемыйТовар, ЛОЖЬ)");
	Запрос.УстановитьПараметр("ТЗSGTIN", СтрокиДляУточнения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НайденныеСтроки = ДанныеКодовМаркировки.НайтиСтроки(Новый Структура("ШтрихкодBase64", Выборка.Штрихкод));
		Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
			СтрокаДанных.ЭтоПродукцияМДЛП = Истина;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает данные настроек Локального модуля Честный знак по подключаемому оборудованию
//
// Параметры:
//  МассивПодключаемогоОборудования - СправочникСсылка.ПодключаемоеОборудование
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   ПодключаемоеОборудование - СправочникСсылка.ПодключаемоеОборудование
//   АдресЛокальногоМодуля    - Строка
//   Настроено                - Булево
//
Функция НастройкиЛокальногоМодуляЧестныйЗнакПоФискальнымУстройствам(МассивПодключаемогоОборудования) Экспорт
	
	РезультатНастройкиЛМЧЗ = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПодключаемоеОборудование.Ссылка КАК ПодключаемоеОборудование,
		|	ПодключаемоеОборудование.Организация КАК Организация,
		|	СубъектыОбращенияМДЛП.Организация КАК ОрганизацияМДЛП,
		|	ПодключаемоеОборудование.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТ_СписокПодключаемогоОборудования
		|ИЗ
		|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
		|		ПО ПодключаемоеОборудование.Организация = СубъектыОбращенияМДЛП.ОрганизацияКонтрагент
		|ГДЕ
		|	ПодключаемоеОборудование.Ссылка В(&МассивСсылок)
		|	И ЕСТЬNULL(СубъектыОбращенияМДЛП.СобственнаяОрганизация, ЛОЖЬ) = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СписокПодключаемогоОборудования.ПодключаемоеОборудование КАК ПодключаемоеОборудование,
		|	НастройкиПодключенияЛокальныхМодулейИСМП.АдресПодключенияЛМ КАК АдресЛокальногоМодуля,
		|	НЕ НастройкиПодключенияЛокальныхМодулейИСМП.Приоритет ЕСТЬ NULL КАК Настроено
		|ИЗ
		|	ВТ_СписокПодключаемогоОборудования КАК ВТ_СписокПодключаемогоОборудования
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПодключенияЛокальныхМодулейМДЛП КАК НастройкиПодключенияЛокальныхМодулейИСМП
		|		ПО ВТ_СписокПодключаемогоОборудования.ОрганизацияМДЛП = НастройкиПодключенияЛокальныхМодулейИСМП.Организация
		|			И (ВТ_СписокПодключаемогоОборудования.РабочееМесто = НастройкиПодключенияЛокальныхМодулейИСМП.РабочееМесто
		|				ИЛИ НастройкиПодключенияЛокальныхМодулейИСМП.РабочееМесто = &ПустоеЗначениеРабочееМесто)";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивПодключаемогоОборудования);
	Запрос.УстановитьПараметр("ПустоеЗначениеРабочееМесто", Справочники.РабочиеМеста.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Подключение = Новый Структура("Настроено, АдресЛокальногоМодуля",
			ВыборкаДетальныеЗаписи.Настроено, ВыборкаДетальныеЗаписи.АдресЛокальногоМодуля);
			
		РезультатНастройкиЛМЧЗ.Вставить(ВыборкаДетальныеЗаписи.ПодключаемоеОборудование, Подключение);
		
	КонецЦикла;
	
	Возврат РезультатНастройкиЛМЧЗ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроцедурыИФункцииПолученияСписковВозможныхДокументовСопоставления

Функция ПолучитьСписокВыбораУведомленний(Ссылка, СтруктурнаяЕдиницаПоУмолчанию = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Организация        = Неопределено;
	Контрагент         = Неопределено;
	НомерДокумента     = Неопределено;
	ДатаДокумента      = Неопределено;
	ОснованиеСсылка    = Неопределено;
	СтруктурнаяЕдиница = Неопределено;
	
	Если ЗначениеЗаполнено(СтруктурнаяЕдиницаПоУмолчанию) Тогда
		СтруктурнаяЕдиница = СтруктурнаяЕдиницаПоУмолчанию;
	КонецЕсли;
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		
		СтруктураРеквизитов = Новый Структура();
		СтруктураРеквизитов.Вставить("ДокументОснование");
		СтруктураРеквизитов.Вставить("СтруктурнаяЕдиница");
		
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СтруктураРеквизитов);
		
		Если ТипЗнч(Реквизиты.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ОснованиеСсылка = Реквизиты.ДокументОснование;
		СтруктурнаяЕдиница           = Реквизиты.СтруктурнаяЕдиница;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
		
		СтруктураРеквизитов = Новый Структура();
		СтруктураРеквизитов.Вставить("ДокументОснование");
		СтруктураРеквизитов.Вставить("СтруктурнаяЕдиница");
		
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СтруктураРеквизитов);
		
		СтруктурнаяЕдиница = Реквизиты.СтруктурнаяЕдиница;
		
		Если ТипЗнч(Реквизиты.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
			Возврат Неопределено;
			
		ИначеЕсли ТипЗнч(Реквизиты.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			
			Поступление = ПолучитьПоступлениеТоваровПоЗаказуПоставщику(Реквизиты.ДокументОснование);
			
			Если Поступление = Неопределено Тогда
				Возврат Неопределено;
			Иначе
				ОснованиеСсылка = Поступление;
			КонецЕсли;
			
		Иначе
			ОснованиеСсылка = Реквизиты.ДокументОснование;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		
		Поступление = ПолучитьПоступлениеТоваровПоЗаказуПоставщику(Ссылка);
		
		Если Поступление = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			ОснованиеСсылка = Поступление;
		КонецЕсли;
		
	Иначе
		ОснованиеСсылка = Ссылка;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОснованиеСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.РасходнаяНакладная")Тогда
		ЭтоОтгрузка = Истина;
	ИначеЕсли ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		ЭтоОтгрузка = Ложь;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура();
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("СтруктурнаяЕдиница");
	СтруктураРеквизитов.Вставить("Контрагент");
	Если ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		СтруктураРеквизитов.Вставить("НомерВходящегоДокумента");
		СтруктураРеквизитов.Вставить("ДатаВходящегоДокумента");
	Иначе
		СтруктураРеквизитов.Вставить("Номер");
		СтруктураРеквизитов.Вставить("Дата");
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, СтруктураРеквизитов);
	
	Организация = Реквизиты.Организация;
	Контрагент  = Реквизиты.Контрагент;
	
	Если НЕ ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда
		СтруктурнаяЕдиница = Реквизиты.СтруктурнаяЕдиница;
	КонецЕсли;
	
	Если ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		НомерДокумента = Реквизиты.НомерВходящегоДокумента;
		ДатаДокумента  = Реквизиты.ДатаВходящегоДокумента;
	Иначе
		НомерДокумента = Реквизиты.Номер;
		ДатаДокумента  = Реквизиты.Дата;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Ссылка"        ,     ОснованиеСсылка);
	СтруктураПараметров.Вставить("Организация"   ,     Организация);
	СтруктураПараметров.Вставить("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	СтруктураПараметров.Вставить("Контрагент"    ,     Контрагент);
	СтруктураПараметров.Вставить("НомерДокумента",     НомерДокумента);
	СтруктураПараметров.Вставить("ДатаДокумента" ,     ДатаДокумента);
	
	Если ЭтоОтгрузка Тогда
		ТаблицаУведомлений = ор_ИнтеграцияМДЛП.ПолучитьТаблицуВыбораУведомленийОтгрузки(СтруктураПараметров);
	Иначе
		ТаблицаУведомлений = ор_ИнтеграцияМДЛП.ПолучитьТаблицуВыбораУведомленийПриемки(СтруктураПараметров);
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ОснованиеСсылка"   , ОснованиеСсылка);
	СтруктураВозврата.Вставить("ТаблицаУведомлений", ТаблицаУведомлений);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьСписокВыбораОснований(Ссылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.УведомлениеОПриемкеМДЛП") Тогда
		
		СтруктураРеквизитов = Новый Структура();
		СтруктураРеквизитов.Вставить("НомерДокумента");
		СтруктураРеквизитов.Вставить("ДатаДокумента");
		СтруктураРеквизитов.Вставить("Операция");
		СтруктураРеквизитов.Вставить("Организация");
		СтруктураРеквизитов.Вставить("МестоДеятельности");
		СтруктураРеквизитов.Вставить("Грузоотправитель");
		СтруктураРеквизитов.Вставить("МестоДеятельностиГрузоотправителя");
		СтруктураРеквизитов.Вставить("ТипДоговора");
		СтруктураРеквизитов.Вставить("ТипОперации");
		
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СтруктураРеквизитов);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НомерДокумента"                  , Реквизиты.НомерДокумента);
		СтруктураПараметров.Вставить("ДатаДокумента"                   , Реквизиты.ДатаДокумента);
		СтруктураПараметров.Вставить("Операция"                        , Реквизиты.Операция);
		СтруктураПараметров.Вставить("ОрганизацияМДЛП"                 , Реквизиты.Организация);
		СтруктураПараметров.Вставить("МестоДеятельностиОрганизацииМДЛП", Реквизиты.МестоДеятельности);
		СтруктураПараметров.Вставить("КонтрагентМДЛП"                  , Реквизиты.Грузоотправитель);
		СтруктураПараметров.Вставить("МестоДеятельностиКонтрагентаМДЛП", Реквизиты.МестоДеятельностиГрузоотправителя);
		СтруктураПараметров.Вставить("ТипДоговора"                     , Реквизиты.ТипДоговора);
		СтруктураПараметров.Вставить("ТипОперации"                     , Реквизиты.ТипОперации);
		
	Иначе
		
		СтруктураРеквизитов = Новый Структура();
		СтруктураРеквизитов.Вставить("НомерДокумента");
		СтруктураРеквизитов.Вставить("ДатаДокумента");
		СтруктураРеквизитов.Вставить("Операция");
		СтруктураРеквизитов.Вставить("Организация");
		СтруктураРеквизитов.Вставить("МестоДеятельности");
		СтруктураРеквизитов.Вставить("Грузополучатель");
		СтруктураРеквизитов.Вставить("МестоДеятельностиГрузополучателя");
		СтруктураРеквизитов.Вставить("ТипДоговора");
		СтруктураРеквизитов.Вставить("ТипОперации");
		
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СтруктураРеквизитов);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НомерДокумента"                  , Реквизиты.НомерДокумента);
		СтруктураПараметров.Вставить("ДатаДокумента"                   , Реквизиты.ДатаДокумента);
		СтруктураПараметров.Вставить("Операция"                        , Реквизиты.Операция);
		СтруктураПараметров.Вставить("ОрганизацияМДЛП"                 , Реквизиты.Организация);
		СтруктураПараметров.Вставить("МестоДеятельностиОрганизацииМДЛП", Реквизиты.МестоДеятельности);
		СтруктураПараметров.Вставить("КонтрагентМДЛП"                  , Реквизиты.Грузополучатель);
		СтруктураПараметров.Вставить("МестоДеятельностиКонтрагентаМДЛП", Реквизиты.МестоДеятельностиГрузополучателя);
		СтруктураПараметров.Вставить("ТипДоговора"                     , Реквизиты.ТипДоговора);
		СтруктураПараметров.Вставить("ТипОперации"                     , Реквизиты.ТипОперации);
		
	КонецЕсли;
	
	Возврат ПолучитьТаблицуВыбораОснований(СтруктураПараметров);
	
КонецФункции

Функция ПолучитьТаблицуВыбораУведомленийПриемки(СтруктураПараметров) Экспорт
	
	Организация        = СтруктураПараметров.Организация;
	СтруктурнаяЕдиница = СтруктураПараметров.СтруктурнаяЕдиница;
	Контрагент         = СтруктураПараметров.Контрагент;
	НомерДокумента     = СтруктураПараметров.НомерДокумента;
	ДатаДокумента      = СтруктураПараметров.ДатаДокумента;
	Ссылка             = СтруктураПараметров.Ссылка;
	
	СтруктураОрганизацииМДЛП = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Организация, СтруктурнаяЕдиница, Истина);
	ОрганизацияМДЛП                  = СтруктураОрганизацииМДЛП.Организация;
	МестоДеятельностиОрганизацииМДЛП = СтруктураОрганизацииМДЛП.МестоДеятельности;
	
	СтруктураКонтрагентаМДЛП = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Контрагент, Справочники.СтруктурныеЕдиницы.ПустаяСсылка(), Ложь);
	КонтрагентМДЛП                   = СтруктураКонтрагентаМДЛП.Организация;
	МестоДеятельностиКонтрагентаМДЛП = СтруктураКонтрагентаМДЛП.МестоДеятельности;
	
	ЭтоКомиссионноеПоступление = Ложь;
	
	Операция = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходнаяНакладная")
		И Ссылка.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПриемНаКомиссию Тогда
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ПоступлениеВРамкахАгентскогоДоговора);
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.Поступление);
		ЭтоКомиссионноеПоступление = Истина;
	ИначеЕсли ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходнаяНакладная")
		И Ссылка.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика Тогда
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.Поступление);
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ПоступлениеНаРанееНеЗарегистрированноеМестоДеятельности);
		
	ИначеЕсли ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходнаяНакладная")
		И Ссылка.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя Тогда
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ВозвратОтПокупателя);
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ВозвратПриостановленныхЛП);
		
	ИначеЕсли ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходнаяНакладная")
		И Ссылка.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика Тогда
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.Поступление);
		Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ПоступлениеНаРанееНеЗарегистрированноеМестоДеятельности);
		
	ИначеЕсли СтруктураПараметров.Свойство("ЭтоВозврат") И ТипЗнч(СтруктураПараметров.ЭтоВозврат) = Тип("Булево") Тогда
		
		Если СтруктураПараметров.ЭтоВозврат Тогда
			Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ВозвратОтПокупателя);
			Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ВозвратПриостановленныхЛП);
		Иначе
			Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.Поступление);
			Операция.Добавить(Перечисления.ОперацииПриемкиМДЛП.ПоступлениеНаРанееНеЗарегистрированноеМестоДеятельности);
		КонецЕсли;
		
	КонецЕсли;
	
	СписокОснований = Новый СписокЗначений;
	СписокОснований.Добавить(Ссылка);
	СписокОснований.Добавить(Неопределено);
	СписокОснований.Добавить(Документы.ПриходнаяНакладная.ПустаяСсылка());
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ОснованиеСсылка"                 , Ссылка);
	Запрос.УстановитьПараметр("СписокОснований"                 , СписокОснований);
	Запрос.УстановитьПараметр("НомерДокумента"                  , НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента"                   , НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("Операция"                        , Операция);
	Запрос.УстановитьПараметр("ОрганизацияМДЛП"                 , ОрганизацияМДЛП);
	Запрос.УстановитьПараметр("МестоДеятельностиОрганизацииМДЛП", МестоДеятельностиОрганизацииМДЛП);
	Запрос.УстановитьПараметр("КонтрагентМДЛП"                  , КонтрагентМДЛП);
	Запрос.УстановитьПараметр("МестоДеятельностиКонтрагентаМДЛП", МестоДеятельностиКонтрагентаМДЛП);
	Запрос.УстановитьПараметр("ЭтоКомиссионноеПоступление"      , ЭтоКомиссионноеПоступление);
	
	МестоДеятельностиКонтрагентаМДЛППустое = НЕ ЗначениеЗаполнено(МестоДеятельностиКонтрагентаМДЛП);
	Запрос.УстановитьПараметр("МестоДеятельностиКонтрагентаМДЛППустое", МестоДеятельностиКонтрагентаМДЛППустое);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УведомлениеОПриемкеМДЛП.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА УведомлениеОПриемкеМДЛП.Основание = &ОснованиеСсылка
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК УжеСопоставлен,
	|	ЕСТЬNULL(Статусы.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.пустаяСсылка)) КАК Статус,
	|	УведомлениеОПриемкеМДЛП.НомерДокумента КАК НомерДокумента,
	|	УведомлениеОПриемкеМДЛП.ДатаДокумента КАК ДатаДокумента,
	|	УведомлениеОПриемкеМДЛП.Номер КАК Номер,
	|	УведомлениеОПриемкеМДЛП.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА УведомлениеОПриемкеМДЛП.НомерДокумента = &НомерДокумента
	|				И УведомлениеОПриемкеМДЛП.ДатаДокумента = &ДатаДокумента
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НомерИДатаСоответствует,
	|	УведомлениеОПриемкеМДЛП.СхемаАкцептования КАК СхемаАкцептования
	|ИЗ
	|	Документ.УведомлениеОПриемкеМДЛП КАК УведомлениеОПриемкеМДЛП
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|		ПО УведомлениеОПриемкеМДЛП.Ссылка = Статусы.Документ
	|ГДЕ
	|	НЕ УведомлениеОПриемкеМДЛП.ПометкаУдаления
	|	И УведомлениеОПриемкеМДЛП.Основание В(&СписокОснований)
	|	И УведомлениеОПриемкеМДЛП.Организация = &ОрганизацияМДЛП
	|	И УведомлениеОПриемкеМДЛП.МестоДеятельности = &МестоДеятельностиОрганизацииМДЛП
	|	И УведомлениеОПриемкеМДЛП.Грузоотправитель = &КонтрагентМДЛП
	|	И ВЫБОР
	|			КОГДА &МестоДеятельностиКонтрагентаМДЛППустое
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ УведомлениеОПриемкеМДЛП.МестоДеятельностиГрузоотправителя = &МестоДеятельностиКонтрагентаМДЛП
	|		КОНЕЦ
	|	И УведомлениеОПриемкеМДЛП.Операция В(&Операция)
	|	И ВЫБОР
	|			КОГДА &ЭтоКомиссионноеПоступление
	|				ТОГДА УведомлениеОПриемкеМДЛП.Операция = ЗНАЧЕНИЕ(Перечисление.ОперацииПриемкиМДЛП.ПоступлениеВРамкахАгентскогоДоговора)
	|						ИЛИ УведомлениеОПриемкеМДЛП.Операция = ЗНАЧЕНИЕ(Перечисление.ОперацииПриемкиМДЛП.Поступление)
	|							И УведомлениеОПриемкеМДЛП.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровМДЛП.Комиссия)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуВыбораУведомленийОтгрузки(СтруктураПараметров) Экспорт
	
	Организация        = СтруктураПараметров.Организация;
	СтруктурнаяЕдиница = СтруктураПараметров.СтруктурнаяЕдиница;
	Контрагент         = СтруктураПараметров.Контрагент;
	НомерДокумента     = СтруктураПараметров.НомерДокумента;
	ДатаДокумента      = СтруктураПараметров.ДатаДокумента;
	Ссылка             = СтруктураПараметров.Ссылка;
	
	СтруктураОрганизацииМДЛП = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Организация, СтруктурнаяЕдиница, Истина);
	ОрганизацияМДЛП                  = СтруктураОрганизацииМДЛП.Организация;
	МестоДеятельностиОрганизацииМДЛП = СтруктураОрганизацииМДЛП.МестоДеятельности;
	
	СтруктураКонтрагентаМДЛП = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Контрагент, Справочники.СтруктурныеЕдиницы.ПустаяСсылка(), Ложь);
	КонтрагентМДЛП                   = СтруктураКонтрагентаМДЛП.Организация;
	МестоДеятельностиКонтрагентаМДЛП = СтруктураКонтрагентаМДЛП.МестоДеятельности;
	
	ЭтоКомиссионныйВозврат = Ложь;
	
	Операция = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.РасходнаяНакладная")
		И Ссылка.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю Тогда
		Операция.Добавить(Перечисления.ОперацииОтгрузкиМДЛП.Продажа);
		
	ИначеЕсли ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.РасходнаяНакладная")
		И Ссылка.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратКомитенту Тогда
		Операция.Добавить(Перечисления.ОперацииОтгрузкиМДЛП.ОтгрузкаВРамкахАгентскогоДоговора);
		ЭтоКомиссионныйВозврат = Истина;
		
	ИначеЕсли ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.РасходнаяНакладная")
		И Ссылка.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратПоставщику Тогда
		Операция.Добавить(Перечисления.ОперацииОтгрузкиМДЛП.Возврат);
		Операция.Добавить(Перечисления.ОперацииОтгрузкиМДЛП.ВозвратПриостановленныхЛП);
		
	ИначеЕсли СтруктураПараметров.Свойство("ЭтоВозврат") И ТипЗнч(СтруктураПараметров.ЭтоВозврат) = Тип("Булево") Тогда
		
		Если СтруктураПараметров.ЭтоВозврат Тогда
			Операция.Добавить(Перечисления.ОперацииОтгрузкиМДЛП.Возврат);
			Операция.Добавить(Перечисления.ОперацииОтгрузкиМДЛП.ВозвратПриостановленныхЛП);
		Иначе
			Операция.Добавить(Перечисления.ОперацииОтгрузкиМДЛП.Продажа);
		КонецЕсли;
		
	КонецЕсли;
	
	СписокОснований = Новый СписокЗначений;
	СписокОснований.Добавить(Ссылка);
	СписокОснований.Добавить(Неопределено);
	СписокОснований.Добавить(Документы.РасходнаяНакладная.ПустаяСсылка());
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ОснованиеСсылка"                 , Ссылка);
	Запрос.УстановитьПараметр("СписокОснований"                 , СписокОснований);
	Запрос.УстановитьПараметр("НомерДокумента"                  , НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента"                   , НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("Операция"                        , Операция);
	Запрос.УстановитьПараметр("ОрганизацияМДЛП"                 , ОрганизацияМДЛП);
	Запрос.УстановитьПараметр("МестоДеятельностиОрганизацииМДЛП", МестоДеятельностиОрганизацииМДЛП);
	Запрос.УстановитьПараметр("КонтрагентМДЛП"                  , КонтрагентМДЛП);
	Запрос.УстановитьПараметр("МестоДеятельностиКонтрагентаМДЛП", МестоДеятельностиКонтрагентаМДЛП);
	Запрос.УстановитьПараметр("ЭтоКомиссионныйВозврат"          , ЭтоКомиссионныйВозврат);
	
	МестоДеятельностиКонтрагентаМДЛППустое = НЕ ЗначениеЗаполнено(МестоДеятельностиКонтрагентаМДЛП);
	Запрос.УстановитьПараметр("МестоДеятельностиКонтрагентаМДЛППустое", МестоДеятельностиКонтрагентаМДЛППустое);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УведомлениеОбОтгрузкеМДЛП.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА УведомлениеОбОтгрузкеМДЛП.Основание = &ОснованиеСсылка
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК УжеСопоставлен,
	|	ЕСТЬNULL(Статусы.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияМДЛП.пустаяСсылка)) КАК Статус,
	|	УведомлениеОбОтгрузкеМДЛП.НомерДокумента КАК НомерДокумента,
	|	УведомлениеОбОтгрузкеМДЛП.ДатаДокумента КАК ДатаДокумента,
	|	УведомлениеОбОтгрузкеМДЛП.Номер КАК Номер,
	|	УведомлениеОбОтгрузкеМДЛП.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА УведомлениеОбОтгрузкеМДЛП.НомерДокумента = &НомерДокумента
	|				И УведомлениеОбОтгрузкеМДЛП.ДатаДокумента = &ДатаДокумента
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НомерИДатаСоответствует,
	|	УведомлениеОбОтгрузкеМДЛП.СхемаАкцептования КАК СхемаАкцептования
	|ИЗ
	|	Документ.УведомлениеОбОтгрузкеМДЛП КАК УведомлениеОбОтгрузкеМДЛП
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияМДЛП КАК Статусы
	|		ПО УведомлениеОбОтгрузкеМДЛП.Ссылка = Статусы.Документ
	|ГДЕ
	|	НЕ УведомлениеОбОтгрузкеМДЛП.ПометкаУдаления
	|	И УведомлениеОбОтгрузкеМДЛП.Основание В(&СписокОснований)
	|	И УведомлениеОбОтгрузкеМДЛП.Организация = &ОрганизацияМДЛП
	|	И УведомлениеОбОтгрузкеМДЛП.МестоДеятельности = &МестоДеятельностиОрганизацииМДЛП
	|	И УведомлениеОбОтгрузкеМДЛП.Грузополучатель = &КонтрагентМДЛП
	|	И ВЫБОР
	|			КОГДА &МестоДеятельностиКонтрагентаМДЛППустое
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ УведомлениеОбОтгрузкеМДЛП.МестоДеятельностиГрузополучателя = &МестоДеятельностиКонтрагентаМДЛП
	|		КОНЕЦ
	|	И УведомлениеОбОтгрузкеМДЛП.Операция В(&Операция)
	|	И ВЫБОР
	|			КОГДА &ЭтоКомиссионныйВозврат
	|				ТОГДА УведомлениеОбОтгрузкеМДЛП.ТипОперации = ЗНАЧЕНИЕ(Перечисление.ТипыОперацийОтгрузкиМДЛП.Возврат)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуВыбораОснований(СтруктураПараметров) Экспорт
	
	НомерДокумента                   = СтруктураПараметров.НомерДокумента;
	ДатаДокумента                    = СтруктураПараметров.ДатаДокумента;
	Операция                         = СтруктураПараметров.Операция;
	ОрганизацияМДЛП                  = СтруктураПараметров.ОрганизацияМДЛП;
	МестоДеятельностиОрганизацииМДЛП = СтруктураПараметров.МестоДеятельностиОрганизацииМДЛП;
	КонтрагентМДЛП                   = СтруктураПараметров.КонтрагентМДЛП;
	МестоДеятельностиКонтрагентаМДЛП = СтруктураПараметров.МестоДеятельностиКонтрагентаМДЛП;
	ТипДоговора                      = СтруктураПараметров.ТипДоговора;
	ТипОперации                      = СтруктураПараметров.ТипОперации;
	
	СтруктураОрганизации = ПолучитьОрганизациюИМестоДеятельности(ОрганизацияМДЛП, МестоДеятельностиОрганизацииМДЛП, Истина);
	СтруктураКонтрагента = ПолучитьОрганизациюИМестоДеятельности(КонтрагентМДЛП, МестоДеятельностиКонтрагентаМДЛП, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"                  , СтруктураОрганизации.Организация);
	Запрос.УстановитьПараметр("МестоДеятельности"            , СтруктураОрганизации.МестоДеятельности);
	Запрос.УстановитьПараметр("Контрагент"                   , СтруктураКонтрагента.Организация);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("НомерДокумента"               , НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента"                , ДатаДокумента);
	
	ЭтоРасход = Ложь;
	ЭтоПриход = Ложь;
	ОперацияЗапасов = Новый СписокЗначений;
	
	Если Операция =  Перечисления.ОперацииПриемкиМДЛП.ВозвратОтПокупателя
		ИЛИ Операция =  Перечисления.ОперацииПриемкиМДЛП.ВозвратПриостановленныхЛП Тогда
		
		ОперацияЗапасов.Добавить(Перечисления.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя);
		ЭтоПриход = Истина;
		
	ИначеЕсли Операция = Перечисления.ОперацииПриемкиМДЛП.Поступление
		И ТипДоговора <> Перечисления.ТипыДоговоровМДЛП.Комиссия
		ИЛИ Операция = Перечисления.ОперацииПриемкиМДЛП.ПоступлениеНаРанееНеЗарегистрированноеМестоДеятельности Тогда
		
		ОперацияЗапасов.Добавить(Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика);
		ЭтоПриход = Истина;
		
	ИначеЕсли Операция = Перечисления.ОперацииПриемкиМДЛП.ПоступлениеВРамкахАгентскогоДоговора
		ИЛИ Операция = Перечисления.ОперацииПриемкиМДЛП.Поступление
		И ТипДоговора = Перечисления.ТипыДоговоровМДЛП.Комиссия Тогда
		
		ОперацияЗапасов.Добавить(Перечисления.ВидыОперацийПриходнаяНакладная.ПриемНаКомиссию);
		ЭтоПриход = Истина;
		
	ИначеЕсли Операция = Перечисления.ОперацииОтгрузкиМДЛП.Продажа Тогда
		
		ОперацияЗапасов.Добавить(Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю);
		ЭтоРасход = Истина;
		
	ИначеЕсли Операция = Перечисления.ОперацииОтгрузкиМДЛП.Возврат
		ИЛИ Операция = Перечисления.ОперацииОтгрузкиМДЛП.ВозвратПриостановленныхЛП Тогда
		
		ОперацияЗапасов.Добавить(Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратПоставщику);
		ЭтоРасход = Истина;
		
	ИначеЕсли Операция = Перечисления.ОперацииОтгрузкиМДЛП.ОтгрузкаВРамкахАгентскогоДоговора
		И ТипОперации = Перечисления.ТипыОперацийОтгрузкиМДЛП.Возврат Тогда
		
		ОперацияЗапасов.Добавить(Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратКомитенту);
		ЭтоРасход = Истина;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОперацияЗапасов", ОперацияЗапасов);
	
	Если ЭтоПриход Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПриходнаяНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП КАК УведомлениеОПриемкеМДЛП
		|		ПО ПриходнаяНакладная.Ссылка = УведомлениеОПриемкеМДЛП.Основание
		|ГДЕ
		|	УведомлениеОПриемкеМДЛП.Ссылка ЕСТЬ NULL
		|	И НЕ ПриходнаяНакладная.ПометкаУдаления
		|	И ПриходнаяНакладная.ВидОперации В(&ОперацияЗапасов)
		|	И ПриходнаяНакладная.Номер = &НомерДокумента
		|	И НАЧАЛОПЕРИОДА(ПриходнаяНакладная.Дата, ДЕНЬ) = &ДатаДокумента
		|	И ПриходнаяНакладная.Организация = &Организация
		|	И ПриходнаяНакладная.Контрагент = &Контрагент
		|	И ВЫБОР
		|			КОГДА &ИспользоватьМестаДеятельности
		|				ТОГДА ПриходнаяНакладная.СтруктурнаяЕдиница = &МестоДеятельности
		|						ИЛИ &МестоДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И НЕ ПриходнаяНакладная.СтруктурнаяЕдиница.ОрдерныйСклад
		|";
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество() = 0 Тогда
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПриходнаяНакладная.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОПриемкеМДЛП КАК УведомлениеОПриемкеМДЛП
			|		ПО ПриходнаяНакладная.Ссылка = УведомлениеОПриемкеМДЛП.Основание
			|ГДЕ
			|	УведомлениеОПриемкеМДЛП.Ссылка ЕСТЬ NULL
			|	И НЕ ПриходнаяНакладная.ПометкаУдаления
			|	И ПриходнаяНакладная.ВидОперации В(&ОперацияЗапасов)
			|	И ПриходнаяНакладная.Организация = &Организация
			|	И ПриходнаяНакладная.Контрагент = &Контрагент
			|	И ВЫБОР
			|			КОГДА &ИспользоватьМестаДеятельности
			|				ТОГДА ПриходнаяНакладная.СтруктурнаяЕдиница = &МестоДеятельности
			|						ИЛИ &МестоДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|	И НЕ ПриходнаяНакладная.СтруктурнаяЕдиница.ОрдерныйСклад
			|";
			Результат = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
		
	ИначеЕсли ЭтоРасход Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходнаяНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РасходнаяНакладная КАК РасходнаяНакладная
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОтгрузкеМДЛП КАК УведомлениеОбОтгрузкеМДЛП
		|		ПО РасходнаяНакладная.Ссылка = УведомлениеОбОтгрузкеМДЛП.Основание
		|ГДЕ
		|	УведомлениеОбОтгрузкеМДЛП.Ссылка ЕСТЬ NULL
		|	И НЕ РасходнаяНакладная.ПометкаУдаления
		|	И РасходнаяНакладная.ВидОперации В(&ОперацияЗапасов)
		|	И РасходнаяНакладная.Номер = &НомерДокумента
		|	И НАЧАЛОПЕРИОДА(РасходнаяНакладная.Дата, ДЕНЬ) = &ДатаДокумента
		|	И РасходнаяНакладная.Организация = &Организация
		|	И РасходнаяНакладная.Контрагент = &Контрагент
		|	И ВЫБОР
		|			КОГДА &ИспользоватьМестаДеятельности
		|				ТОГДА РасходнаяНакладная.СтруктурнаяЕдиница = &МестоДеятельности
		|						ИЛИ &МестоДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И НЕ РасходнаяНакладная.СтруктурнаяЕдиница.ОрдерныйСклад
		|";
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество() = 0 Тогда
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходнаяНакладная.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РасходнаяНакладная КАК РасходнаяНакладная
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОбОтгрузкеМДЛП КАК УведомлениеОбОтгрузкеМДЛП
			|		ПО РасходнаяНакладная.Ссылка = УведомлениеОбОтгрузкеМДЛП.Основание
			|ГДЕ
			|	УведомлениеОбОтгрузкеМДЛП.Ссылка ЕСТЬ NULL
			|	И НЕ РасходнаяНакладная.ПометкаУдаления
			|	И РасходнаяНакладная.ВидОперации В(&ОперацияЗапасов)
			|	И РасходнаяНакладная.Организация = &Организация
			|	И РасходнаяНакладная.Контрагент = &Контрагент
			|	И ВЫБОР
			|			КОГДА &ИспользоватьМестаДеятельности
			|				ТОГДА РасходнаяНакладная.СтруктурнаяЕдиница = &МестоДеятельности
			|						ИЛИ &МестоДеятельности = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|	И НЕ РасходнаяНакладная.СтруктурнаяЕдиница.ОрдерныйСклад
			|";
			Результат = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокВыбораДляСвязыванияПеремещенияТоваров(Ссылка) Экспорт
	
	СписокДокументов = Новый СписокЗначений;
	
	СтруктураРеквизитов = Новый Структура();
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("СтруктурнаяЕдиница");
	СтруктураРеквизитов.Вставить("СтруктурнаяЕдиницаПолучатель");
	СтруктураРеквизитов.Вставить("Номер");
	СтруктураРеквизитов.Вставить("Дата");
	
	СтруктураПараметров = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СтруктураРеквизитов);
	
	Организация                   = СтруктураПараметров.Организация;
	СтруктурнаяЕдиницаОтправитель = СтруктураПараметров.СтруктурнаяЕдиница;
	СтруктурнаяЕдиницаПолучатель  = СтруктураПараметров.СтруктурнаяЕдиницаПолучатель;
	НомерДокумента                = СтруктураПараметров.Номер;
	ДатаДокумента                 = СтруктураПараметров.Дата;
	
	СтруктураОрганизацииМДЛП = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Организация, СтруктурнаяЕдиницаОтправитель, Истина);
	ОрганизацияМДЛП                  = СтруктураОрганизацииМДЛП.Организация;
	МестоДеятельностиОрганизацииМДЛП = СтруктураОрганизацииМДЛП.МестоДеятельности;
	
	СтруктураОрганизацииПолучателяМДЛП = ор_ИнтеграцияМДЛП.ПолучитьОрганизациюИМестоДеятельностиМДЛП(Организация, СтруктурнаяЕдиницаПолучатель, Истина);
	ОрганизацияПолучательМДЛП                  = СтруктураОрганизацииПолучателяМДЛП.Организация;
	МестоДеятельностиОрганизацииПолучателяМДЛП = СтруктураОрганизацииПолучателяМДЛП.МестоДеятельности;
	
	Если ЗначениеЗаполнено(СтруктураОрганизацииМДЛП.Организация) И ЗначениеЗаполнено(СтруктураОрганизацииПолучателяМДЛП.Организация)
		И НЕ СтруктураОрганизацииМДЛП.ВестиУчетВЭтойИБ И СтруктураОрганизацииПолучателяМДЛП.ВестиУчетВЭтойИБ Тогда
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("НомерДокумента"                            , НомерДокумента);
		Запрос.УстановитьПараметр("ДатаДокумента"                             , НачалоДня(ДатаДокумента));
		Запрос.УстановитьПараметр("Операция"                                  , Перечисления.ОперацииПеремещенияМДЛП.ПриходныйОрдер);
		Запрос.УстановитьПараметр("ОрганизацияМДЛП"                           , ОрганизацияМДЛП);
		Запрос.УстановитьПараметр("МестоДеятельностиОрганизацииМДЛП"          , МестоДеятельностиОрганизацииМДЛП);
		Запрос.УстановитьПараметр("МестоДеятельностиОрганизацииПолучателяМДЛП", МестоДеятельностиОрганизацииПолучателяМДЛП);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УведомлениеОПеремещенииМДЛП.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УведомлениеОПеремещенииМДЛП КАК УведомлениеОПеремещенииМДЛП
		|ГДЕ
		|	НЕ УведомлениеОПеремещенииМДЛП.ПометкаУдаления
		|	И УведомлениеОПеремещенииМДЛП.НомерДокумента = &НомерДокумента
		|	И УведомлениеОПеремещенииМДЛП.ДатаДокумента = &ДатаДокумента
		|	И УведомлениеОПеремещенииМДЛП.Организация = &ОрганизацияМДЛП
		|	И УведомлениеОПеремещенииМДЛП.МестоДеятельности = &МестоДеятельностиОрганизацииМДЛП
		|	И УведомлениеОПеремещенииМДЛП.МестоДеятельностиПолучатель = &МестоДеятельностиОрганизацииПолучателяМДЛП
		|	И УведомлениеОПеремещенииМДЛП.Операция = &Операция";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СписокДокументов.Добавить(Выборка.Ссылка);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СписокДокументов;
	
КонецФункции

Функция СвязатьПеремещениеСУведомлением(ПеремещениеСсылка, УведомлениеСсылка, ТекстСообщения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	УведомлениеОбъект = УведомлениеСсылка.ПолучитьОбъект();
	УведомлениеОбъект.Основание             = ПеремещениеСсылка;
	
	Попытка
		УведомлениеОбъект.Записать();
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСообщения = НСтр("ru='Не удалось перезаписать уведомление МДЛП:'") + Строка(УведомлениеСсылка);
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекстОшибки;
		Возврат Ложь;
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьСписокВыбораДляСвязыванияУведомленияОПеремещенииТоваров(СтруктураПараметров) Экспорт
	
	НомерДокумента                  = СтруктураПараметров.НомерДокумента;
	ДатаДокумента                   = СтруктураПараметров.ДатаДокумента;
	ОрганизацияМДЛП                 = СтруктураПараметров.ОрганизацияМДЛП;
	МестоДеятельностиМДЛП           = СтруктураПараметров.МестоДеятельностиМДЛП;
	МестоДеятельностиПолучательМДЛП = СтруктураПараметров.МестоДеятельностиПолучательМДЛП;
	ЭтоОрдер                        = СтруктураПараметров.ЭтоОрдер;
	
	СтруктураОрганизации           = ПолучитьОрганизациюИМестоДеятельности(ОрганизацияМДЛП, МестоДеятельностиМДЛП, Истина);
	СтруктураОрганизацииПолучателя = ПолучитьОрганизациюИМестоДеятельности(ОрганизацияМДЛП, МестоДеятельностиПолучательМДЛП, Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"                  , СтруктураОрганизации.Организация);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница"           , СтруктураОрганизации.МестоДеятельности);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиницаПолучатель" , СтруктураОрганизацииПолучателя.МестоДеятельности);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("НомерДокумента"               , НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента"                , ДатаДокумента);
	Запрос.УстановитьПараметр("ЭтоОрдер"                     , ЭтоОрдер);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПеремещениеЗапасов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК ПеремещениеЗапасов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОПеремещенииМДЛП КАК УведомлениеОПеремещенииМДЛП
	|		ПО ПеремещениеЗапасов.Ссылка = УведомлениеОПеремещенииМДЛП.Основание
	|ГДЕ
	|	НЕ &ЭтоОрдер
	|	И УведомлениеОПеремещенииМДЛП.Ссылка ЕСТЬ NULL
	|	И НЕ ПеремещениеЗапасов.ПометкаУдаления
	|	И ПеремещениеЗапасов.Номер = &НомерДокумента
	|	И НАЧАЛОПЕРИОДА(ПеремещениеЗапасов.Дата, ДЕНЬ) = &ДатаДокумента
	|	И ПеремещениеЗапасов.Организация = &Организация
	|	И ВЫБОР
	|			КОГДА &ИспользоватьМестаДеятельности
	|				ТОГДА ПеремещениеЗапасов.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|						ИЛИ &СтруктурнаяЕдиница = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ИспользоватьМестаДеятельности
	|				ТОГДА ПеремещениеЗапасов.СтруктурнаяЕдиницаПолучатель = &СтруктурнаяЕдиницаПолучатель
	|						ИЛИ &СтруктурнаяЕдиницаПолучатель = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МассивДокументов = Новый Массив;
	
	Для Каждого Строка Из Результат Цикл
		МассивДокументов.Добавить(Строка.Ссылка);
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

Функция ПолучитьСписокВыбораДляСвязыванияУведомленияОВыбытииТоваров(СтруктураПараметров) Экспорт
	
	ОрганизацияМДЛП       = СтруктураПараметров.ОрганизацияМДЛП;
	МестоДеятельностиМДЛП = СтруктураПараметров.МестоДеятельностиМДЛП;
	Операция              = СтруктураПараметров.Операция;
	ТипВыводаИзОборота    = СтруктураПараметров.ТипВыводаИзОборота;
	
	СтруктураОрганизации  = ПолучитьОрганизациюИМестоДеятельности(ОрганизацияМДЛП, МестоДеятельностиМДЛП, Истина);
	
	Запрос = Новый Запрос;

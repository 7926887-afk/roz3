Процедура СоздатьКомандуРегистрацииGTIN(Форма, Команда)
	
	Если Команда.ПроверятьТабЧасть И Форма.Элементы.Найти(Команда.ИмяТабличнойЧасти) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементРодителя = Форма.Элементы.Найти(Команда.ИмяРодителя);
	Если ЭлементРодителя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементПорядка = Неопределено;
	Если Команда.Свойство("ИмяЭлементаПорядка") Тогда
		ЭлементПорядка = Форма.Элементы.Найти(Команда.ИмяЭлементаПорядка);
	КонецЕсли;
	
	ИмяКоманды = Команда.ИмяТабличнойЧасти + "ЗарегистрироватьGTIN";
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Заголовок = НСтр("ru = 'Зарегистрировать GTIN'");
	НоваяКоманда.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	
	НовыйЭлемент = Форма.Элементы.Вставить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементРодителя, ЭлементПорядка);
	НовыйЭлемент.Вид        = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.ТолькоВоВсехДействиях = Команда.ТолькоВоВсехДействиях;
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьФлагМаркируемогоТовара(Владелец) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Владелец) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Владелец)=Тип("СправочникСсылка.Номенклатура") Тогда
		КатегорияНоменклатуры = Владелец.КатегорияНоменклатуры;
	ИначеЕсли ТипЗнч(Владелец)=Тип("СправочникСсылка.КатегорииНоменклатуры") Тогда
		КатегорияНоменклатуры = Владелец;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПолучитьФункциональнуюОпцию("ВестиСведенияДляМониторингаДвиженияЛекарственныхПрепаратов")
		И КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров;
	
КонецФункции

Функция ПроверитьНоменклатуруМаркировки(Номенклатура) Экспорт
	
	Возврат ПолучитьФлагМаркируемогоТовара(Номенклатура.КатегорияНоменклатуры);
	
КонецФункции

Функция ПроверитьХарактеристикуМаркировки(Характеристика) Экспорт
	
	ФлагМаркируемогоТовара = ПолучитьФлагМаркируемогоТовара(Характеристика.Владелец);
	
	Если ФлагМаркируемогоТовара Тогда
		Возврат Характеристика.ор_МаркируемыйТовар;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьФлагМаркируемогоТовараХарактеристики(Характеристика) Экспорт
	
	Возврат Характеристика.ор_МаркируемыйТовар;
	
КонецФункции

Функция ПолучитьКоэффициентЕдиницыИзмерения(ЕдиницаИзмерения) Экспорт
	
	Если ЗначениеЗаполнено(ЕдиницаИзмерения) И ТипЗнч(ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
		Возврат ЕдиницаИзмерения.Коэффициент;
	Иначе
		Возврат 1;
	КонецЕсли;
	
КонецФункции

Процедура ПолучитьСлужебныеРеквизитыМДЛП(СтруктураДанные) Экспорт
	
	ИспользоватьНомераУпаковок = Истина;
	
	Если НЕ СтруктураДанные.Свойство("ЗапретитьВводНомеров") Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураДанные.ЗапретитьВводНомеров Тогда
		ИспользоватьНомераУпаковок = Ложь;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ВестиСведенияДляМониторингаДвиженияЛекарственныхПрепаратов") Тогда
		ИспользоватьНомераУпаковок = Ложь;
	КонецЕсли;
	
	Если НЕ СтруктураДанные.Номенклатура.КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров Тогда
		ИспользоватьНомераУпаковок = Ложь;
	КонецЕсли;
	
	Если ИспользоватьНомераУпаковок
		И СтруктураДанные.Свойство("Характеристика")
		И ЗначениеЗаполнено(СтруктураДанные.Характеристика) Тогда
		СтруктураДанные.Вставить("ИспользоватьНомераУпаковок", СтруктураДанные.Характеристика.ор_МаркируемыйТовар);
	Иначе
		СтруктураДанные.Вставить("ИспользоватьНомераУпаковок", Ложь);
	КонецЕсли;
	
	СтруктураДанные.Вставить("ор_ИдентификаторСтроки", Строка(Новый УникальныйИдентификатор));
	
КонецПроцедуры

Функция ЭтоМаркируемыйТовар(Характеристика, ЗапретитьВводНомеров = Ложь) Экспорт
	
	ИспользоватьНомераУпаковок = Истина;
	
	Если ЗапретитьВводНомеров Тогда
		ИспользоватьНомераУпаковок = Ложь;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ВестиСведенияДляМониторингаДвиженияЛекарственныхПрепаратов") Тогда
		ИспользоватьНомераУпаковок = Ложь;
	КонецЕсли;
	
	Если ИспользоватьНомераУпаковок И ЗначениеЗаполнено(Характеристика) Тогда
		ИспользоватьНомераУпаковок = Характеристика.ор_МаркируемыйТовар;
	Иначе
		ИспользоватьНомераУпаковок = Ложь;
	КонецЕсли;
	
	Возврат ИспользоватьНомераУпаковок;
	
КонецФункции

Функция ПолучитьДокументУведомлениеПоОснованию(Основание, ИмяДокумента) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Уведомление.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ." + ИмяДокумента + " КАК Уведомление
	               |ГДЕ
	               |	Уведомление.Основание = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Основание);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьСписокУведомленийПоОснованию(Основание, ИмяДокумента) Экспорт
	
	СписокДокументов = Новый СписокЗначений;
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат СписокДокументов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Уведомление.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ." + ИмяДокумента + " КАК Уведомление
	               |ГДЕ
	               |	Уведомление.Основание = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Основание);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокДокументов.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат СписокДокументов;
	
КонецФункции

Процедура ПроверитьЗаполнениеНоменклатуры(Объект, МассивНепроверяемыхРеквизитов, Отказ) Экспорт
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.УдалитьЗапросСоставаУпаковкиМДЛП") Тогда
		Возврат;
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов.Добавить("Товары.Номенклатура");
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.УведомлениеОПриемкеМДЛП") ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.УведомлениеОбОтгрузкеМДЛП") Тогда
		
		ЭтоПриемка = ТипЗнч(Объект) = Тип("ДокументОбъект.УведомлениеОПриемкеМДЛП");
		
		Запрос = Новый Запрос;
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНомеров.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТаблицаНомеров.СостояниеПодтверждения КАК СостояниеПодтверждения
		|ПОМЕСТИТЬ втНомера
		|ИЗ
		|	&ТаблицаНомеров КАК ТаблицаНомеров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.НомерСтроки КАК НомерСтроки,
		|	втТовары.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ СтрокиСОшибками
		|ИЗ
		|	втТовары КАК втТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ втНомера КАК втНомера
		|		ПО втТовары.ИдентификаторСтроки = втНомера.ИдентификаторСтроки
		|ГДЕ
		|	втТовары.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И втНомера.СостояниеПодтверждения <> &Состояние
		|
		|СГРУППИРОВАТЬ ПО
		|	втТовары.НомерСтроки,
		|	втТовары.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтрокиСОшибками.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	СтрокиСОшибками КАК СтрокиСОшибками";
		
		Запрос.Текст = ТекстЗапроса;
		
		Если ЭтоПриемка Тогда
			Запрос.УстановитьПараметр("Состояние", Перечисления.СостоянияПодтвержденияМДЛП.Отказаться);
		Иначе
			Запрос.УстановитьПараметр("Состояние", Перечисления.СостоянияПодтвержденияМДЛП.Отозвать);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ТаблицаТоваров", Объект.Товары.Выгрузить(,"НомерСтроки,Номенклатура,ИдентификаторСтроки"));
		Запрос.УстановитьПараметр("ТаблицаНомеров", Объект.НомераУпаковок.Выгрузить(,"ИдентификаторСтроки,СостояниеПодтверждения"));
		
	Иначе
		
		Запрос = Новый Запрос;
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.НомерСтроки КАК НомерСтроки,
		|	втТовары.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ СтрокиСОшибками
		|ИЗ
		|	втТовары КАК втТовары
		|ГДЕ
		|	втТовары.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	втТовары.НомерСтроки,
		|	втТовары.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтрокиСОшибками.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	СтрокиСОшибками КАК СтрокиСОшибками";
		
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("ТаблицаТоваров", Объект.Товары.Выгрузить(,"НомерСтроки,Номенклатура"));
		
	КонецЕсли;
	
	ШаблонСообщения = НСтр("ru='Не заполнена колонка ""%Номенклатура%"" в строке %НомерСтроки% списка ""%ТаблицаТовары%"".'");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%Номенклатура%", "Номенклатура");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТаблицаТовары%", "Товары");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
		
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Запасы", Выборка.НомерСтроки, "Номенклатура");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,Поле,"Объект",Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеНоменклатурыТранспортнойУпаковки(Объект, МассивНепроверяемыхРеквизитов, Отказ) Экспорт
	
	ЭтоПриемка = ТипЗнч(Объект) = Тип("ДокументОбъект.УведомлениеОПриемкеМДЛП");
	ЭтоПеремещенеи = ТипЗнч(Объект) = Тип("ДокументОбъект.УведомлениеОПеремещенииМДЛП");
	
	МассивНепроверяемыхРеквизитов.Добавить("СоставТранспортныхУпаковок.Номенклатура");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНомеров.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	&СостояниеПодтверждения КАК СостояниеПодтверждения
	|ПОМЕСТИТЬ втНомера
	|ИЗ
	|	&ТаблицаНомеров КАК ТаблицаНомеров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.НомерСтроки КАК НомерСтроки,
	|	втТовары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ СтрокиСОшибками
	|ИЗ
	|	втНомера КАК втНомера
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТовары КАК втТовары
	|		ПО втНомера.ИдентификаторСтроки = втТовары.ИдентификаторСтроки
	|ГДЕ
	|	втТовары.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И &ПроверкаСостояниеПодтверждения
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.НомерСтроки,
	|	втТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиСОшибками.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	СтрокиСОшибками КАК СтрокиСОшибками";
	
	Запрос.УстановитьПараметр("ТаблицаНомеров",  Объект.ТранспортныеУпаковки.Выгрузить());
	Запрос.УстановитьПараметр("ТаблицаТоваров",  Объект.СоставТранспортныхУпаковок.Выгрузить());
	
	Если ЭтоПеремещенеи Тогда
		
		Запрос.УстановитьПараметр("СостояниеПодтверждения", Перечисления.СостоянияПодтвержденияМДЛП.ПустаяСсылка());
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПроверкаСостояниеПодтверждения", "Истина");
		
	Иначе
		
		Если ЭтоПриемка Тогда
			Запрос.УстановитьПараметр("Состояние", Перечисления.СостоянияПодтвержденияМДЛП.Отказаться);
		Иначе
			Запрос.УстановитьПараметр("Состояние", Перечисления.СостоянияПодтвержденияМДЛП.Отозвать);
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СостояниеПодтверждения", "ТаблицаНомеров.СостояниеПодтверждения");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПроверкаСостояниеПодтверждения", "втНомера.СостояниеПодтверждения <> &Состояние");
		
	КонецЕсли;
	
	ШаблонСообщения = НСтр("ru='Не заполнена колонка ""%Номенклатура%"" в строке %НомерСтроки% списка ""%ТаблицаТовары%"".'");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%Номенклатура%", "Номенклатура");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТаблицаТовары%", "Состав транспортных упаковок");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
		
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставТранспортныхУпаковок", Выборка.НомерСтроки, "Номенклатура");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,Поле,"Объект",Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОрганизациюИМестоДеятельностиМДЛП(Организация, МестоДеятельности, СобственнаяОрганизация = Истина) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Организация"      , Справочники.ОрганизацииМДЛП.ПустаяСсылка());
	СтруктураВозврата.Вставить("МестоДеятельности", Справочники.МестаДеятельностиМДЛП.ПустаяСсылка());
	СтруктураВозврата.Вставить("Идентификатор"    , "");
	СтруктураВозврата.Вставить("ВестиУчетВЭтойИБ" , Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СубъектыОбращенияМДЛП.Организация КАК Организация,
	|	СубъектыОбращенияМДЛП.МестоДеятельности КАК МестоДеятельности,
	|	СубъектыОбращенияМДЛП.МестоДеятельности.Идентификатор КАК Идентификатор,
	|	СубъектыОбращенияМДЛП.МестоДеятельности.ВестиУчетВЭтойИБ КАК ВестиУчетВЭтойИБ
	|ИЗ
	|	РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|ГДЕ
	|	СубъектыОбращенияМДЛП.ОрганизацияКонтрагент = &Организация
	|	И СубъектыОбращенияМДЛП.СобственнаяОрганизация = &СобственнаяОрганизация
	|	И (ВЫБОР
	|			КОГДА &ИспользоватьМестаДеятельности
	|				ТОГДА СубъектыОбращенияМДЛП.ОбъектМестаДеятельности = &МестоДеятельности
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ)
	|";
	
	Запрос.УстановитьПараметр("Организация"                  , Организация);
	Запрос.УстановитьПараметр("ИспользоватьМестаДеятельности", ПолучитьПризнакИспользоватьМестаДеятельностиОрганизаций());
	Запрос.УстановитьПараметр("МестоДеятельности"            , МестоДеятельности);
	Запрос.УстановитьПараметр("СобственнаяОрганизация"       , СобственнаяОрганизация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.Организация       = Выборка.Организация;
		СтруктураВозврата.МестоДеятельности = Выборка.МестоДеятельности;
		СтруктураВозврата.Идентификатор     = Выборка.Идентификатор;
		СтруктураВозврата.ВестиУчетВЭтойИБ  = Выборка.ВестиУчетВЭтойИБ;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьОрганизациюИМестоДеятельности(ОрганизацияМДЛП, МестоДеятельностиМДЛП, СобственнаяОрганизация = Истина) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Организация"      , Справочники.Организации.ПустаяСсылка());
	СтруктураВозврата.Вставить("МестоДеятельности", Справочники.СтруктурныеЕдиницы.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СубъектыОбращенияМДЛП.ОрганизацияКонтрагент КАК Организация,
	|	СубъектыОбращенияМДЛП.ОбъектМестаДеятельности КАК МестоДеятельности
	|ИЗ
	|	РегистрСведений.СубъектыОбращенияМДЛП КАК СубъектыОбращенияМДЛП
	|ГДЕ
	|	СубъектыОбращенияМДЛП.Организация = &Организация
	|	И СубъектыОбращенияМДЛП.СобственнаяОрганизация = &СобственнаяОрганизация
	|	И ВЫБОР
	|			КОГДА &СобственнаяОрганизация
	|				ТОГДА СубъектыОбращенияМДЛП.МестоДеятельности = &МестоДеятельности
	|			ИНАЧЕ СубъектыОбращенияМДЛП.МестоДеятельности = &МестоДеятельности
	|					ИЛИ СубъектыОбращенияМДЛП.МестоДеятельности = ЗНАЧЕНИЕ(Справочник.МестаДеятельностиМДЛП.ПустаяСсылка)
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("Организация"                  , ОрганизацияМДЛП);
	Запрос.УстановитьПараметр("МестоДеятельности"            , МестоДеятельностиМДЛП);
	Запрос.УстановитьПараметр("СобственнаяОрганизация"       , СобственнаяОрганизация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.Организация       = Выборка.Организация;
		СтруктураВозврата.МестоДеятельности = Выборка.МестоДеятельности;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Процедура ЗаполнитьНоменклатуруХарактеристикуПоGTIN(Объект, ТекущаяСтрока, ТолькоНоменклатуру = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.GTIN) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура)
		И НЕ ЗначениеЗаполнено(ТекущаяСтрока.Характеристика)
		И НЕ ТолькоНоменклатуру Тогда
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки);
		НайденныеСтроки = Объект.НомераУпаковок.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("НомерУпаковки", НайденныеСтроки[0].НомерКИЗ);
			Запрос.УстановитьПараметр("КлючУпаковки", ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(НайденныеСтроки[0].НомерКИЗ));
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	&НомерУпаковки КАК НомерУпаковки,
			|	&КлючУпаковки КАК КлючУпаковки
			|ПОМЕСТИТЬ втТовары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	УпаковкиМаркируемыхТоваров.Номенклатура КАК Номенклатура,
			|	УпаковкиМаркируемыхТоваров.Характеристика КАК Характеристика
			|ИЗ
			|	втТовары КАК втТовары
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ор_МДЛПУпаковкиМаркируемыхТоваров КАК УпаковкиМаркируемыхТоваров
			|		ПО втТовары.НомерУпаковки = УпаковкиМаркируемыхТоваров.НомерУпаковки
			|			И втТовары.КлючУпаковки = УпаковкиМаркируемыхТоваров.КлючУпаковки";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекущаяСтрока.Номенклатура = Выборка.Номенклатура;
				ТекущаяСтрока.Характеристика = Выборка.Характеристика;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("GTIN", ТекущаяСтрока.GTIN);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
		Запрос.УстановитьПараметр("Партия"          , Справочники.ПартииНоменклатуры.ПустаяСсылка());
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	&GTIN КАК GTIN
		|ПОМЕСТИТЬ втТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.GTIN КАК GTIN,
		|	Штрихкоды.Номенклатура КАК Номенклатура
		|ИЗ
		|	втТовары КАК втТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|		ПО втТовары.GTIN = Штрихкоды.Штрихкод
		|			И (Штрихкоды.Номенклатура ССЫЛКА Справочник.Номенклатура)
		|			И (Штрихкоды.Номенклатура.КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров)
		|			И (Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения)
		|			И (Штрихкоды.Партия = &Партия)
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура)
		|ПО
		|	GTIN";
		
		Результат = Запрос.Выполнить();
		
		ВыборкаПоGTIN = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если ВыборкаПоGTIN.Следующий() Тогда
			Если ВыборкаПоGTIN.Номенклатура = 1 Тогда
				ВыборкаПоТоварам = ВыборкаПоGTIN.Выбрать();
				Если ВыборкаПоТоварам.Следующий() Тогда
					ТекущаяСтрока.Номенклатура = ВыборкаПоТоварам.Номенклатура;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиНоменклатруПоGTIN(GTIN) Экспорт
	
	Если НЕ ЗначениеЗаполнено(GTIN) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &GTIN
	|	И Штрихкоды.Номенклатура ССЫЛКА Справочник.Номенклатура
	|	И Штрихкоды.Номенклатура.КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров
	|	И Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения
	|	И Штрихкоды.Партия = &Партия";
	Запрос.УстановитьПараметр("GTIN"            , GTIN);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("Партия"          , Справочники.ПартииНоменклатуры.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Выборка.Номенклатура;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиНоменклатуруПоНомеруИКлючуУпаковки(Данные) Экспорт
	
	Если Не Данные.Свойство("GTIN")
		И Не Данные.Свойство("SGTIN") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ор_МДЛПУпаковкиМаркируемыхТоваров.Номенклатура КАК Номенклатура,
	|	ор_МДЛПУпаковкиМаркируемыхТоваров.Характеристика КАК Характеристика
	|ИЗ
	|	Справочник.ор_МДЛПУпаковкиМаркируемыхТоваров КАК ор_МДЛПУпаковкиМаркируемыхТоваров
	|ГДЕ
	|	ор_МДЛПУпаковкиМаркируемыхТоваров.НомерУпаковки = &НомерУпаковки
	|	И ор_МДЛПУпаковкиМаркируемыхТоваров.КлючУпаковки = &КлючУпаковки";
	
	Запрос.УстановитьПараметр("НомерУпаковки", 	Данные.SGTIN);
	Запрос.УстановитьПараметр("КлючУпаковки", 	ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(Данные.SGTIN));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		СтруктураВозврата = Новый Структура();
		СтруктураВозврата.Вставить("Номенклатура", 	 ВыборкаДетальныеЗаписи.Номенклатура);
		СтруктураВозврата.Вставить("Характеристика", ВыборкаДетальныеЗаписи.Характеристика);
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиХарактеристикуПоСерииИСроку(Номенклатура, Данные) Экспорт
	
	Если НЕ Данные.Свойство("Серия") ИЛИ НЕ Данные.Свойство("ГоденДо") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
	|ГДЕ
	|	Номенклатура.Ссылка = &Номенклатура
	|	И ХарактеристикиНоменклатуры.ор_СерияПроизводителя = &ор_СерияПроизводителя
	|	И ХарактеристикиНоменклатуры.ор_СрокГодности = &ор_СрокГодности";
	
	Запрос.УстановитьПараметр("ор_СерияПроизводителя", Данные.Серия);
	Запрос.УстановитьПараметр("ор_СрокГодности"      , Данные.ГоденДо);
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Выборка.Характеристика;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ИспользуетсяОрдернаяСхемаПриемкиОтгрузки(ОснованиеСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОснованиеСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура();
	
	Если ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.ПриходнаяНакладная")
		ИЛИ ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		СтруктураРеквизитов.Вставить("ОрдерныйСклад", "СтруктурнаяЕдиница.ОрдерныйСклад");
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, СтруктураРеквизитов);
	
	Возврат Реквизиты.ОрдерныйСклад;
	
КонецФункции

Функция ПолучитьОснованиеПоСылке(Ссылка) Экспорт
	
	ДокументОснованиессылка = Неопределено;
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
		
		ЗапрашиваемыеРеквизитыДокумента = Новый Структура;
		ЗапрашиваемыеРеквизитыДокумента.Вставить("ДокументОснование");
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ЗапрашиваемыеРеквизитыДокумента);
		
		Если ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
			ДокументОснованиеСсылка = РеквизитыДокумента.ДокументОснование;
			
		ИначеЕсли ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			
			Поступление = ПолучитьПоступлениеТоваровПоЗаказуПоставщику(РеквизитыДокумента.ДокументОснование);
			
			Если Поступление <> Неопределено Тогда
				ДокументОснованиеСсылка = Поступление;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		
		ЗапрашиваемыеРеквизитыДокумента = Новый Структура;
		ЗапрашиваемыеРеквизитыДокумента.Вставить("ДокументОснование");
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ЗапрашиваемыеРеквизитыДокумента);
		
		Если ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
			
			ДокументОснованиессылка = РеквизитыДокумента.ДокументОснование;
			
		ИначеЕсли ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
			
			ДокументОснованиессылка = РеквизитыДокумента.ДокументОснование;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДокументОснованиессылка = Неопределено Тогда
		ДокументОснованиессылка = Ссылка;
	КонецЕсли;
	
	Возврат ДокументОснованиессылка
	
КонецФункции

Функция ПолучитьСписокСостоянийПодтверждения(ДобавитьОтказы = Ложь) Экспорт
	
	СписокСостояний = Новый СписокЗначений;
	СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.Подтвердить);
	СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.Подтверждено);
	СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.КПередаче);
	СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.ПринятоГИСМ);
	
	СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.АктуализироватьДанныеОбУпаковках);
	СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.ДанныеОбУпаковкахАктуализированы);
	
	СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.ОприходованоНовымВладельцем);
	
	Если ДобавитьОтказы Тогда
		СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.Отозвать);
		СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.Отказаться);
		СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.НеТребуется);
		СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.ОтклоненоГИСМ);
		
		СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.ОтказатьсяОтклоненоГИСМ);
		СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.ОтозватьОтклоненоГИСМ);
		СписокСостояний.Добавить(Перечисления.СостоянияПодтвержденияМДЛП.ПодтвердитьОтклоненоГИСМ);
	КонецЕсли;
	
	Возврат СписокСостояний;
	
КонецФункции

Функция СтатусДоступенДляЗаполнения(Статус) Экспорт
	
	Если Статус = Перечисления.СтатусыИнформированияМДЛП.ПринятоИзМДЛП
		ИЛИ Статус = Перечисления.СтатусыИнформированияМДЛП.Закрыто
		ИЛИ Статус = Перечисления.СтатусыИнформированияМДЛП.Принято
		ИЛИ Статус = Перечисления.СтатусыИнформированияМДЛП.ОприходованоНовымВладельцем
		ИЛИ Статус = Перечисления.СтатусыИнформированияМДЛП.ЧастичноПринято
		ИЛИ Статус = Перечисления.СтатусыИнформированияМДЛП.Черновик Тогда
		
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция НайтиGTINПоНоменклатре(Номенклатура, Характеристика) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК GTIN
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Номенклатура = &Номенклатура
	|	И Штрихкоды.Характеристика = &Характеристика
	|	И Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения
	|	И Штрихкоды.Партия = &Партия
	|
	|СГРУППИРОВАТЬ ПО
	|	Штрихкоды.Штрихкод";
	Запрос.УстановитьПараметр("Номенклатура"    , Номенклатура);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("Партия"          , Справочники.ПартииНоменклатуры.ПустаяСсылка());
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		
		Запрос.УстановитьПараметр("Характеристика", Характеристика);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДанныеGTIN = Новый Соответствие;
		ПоследнееЗначениеВыборки = "";
		Пока Выборка.Следующий() Цикл
			Если ор_ИнтеграцияМДЛПКлиентСервер.ЭтоGTIN(Выборка.GTIN)
				И МенеджерОборудованияКлиентСервер.ПроверитьКорректностьGTIN(Выборка.GTIN) Тогда
				ЗначениеGTIN = ДанныеGTIN[Выборка.GTIN];
				Если ЗначениеGTIN = Неопределено Тогда
					ДанныеGTIN.Вставить(Выборка.GTIN);
					ПоследнееЗначениеВыборки = Выборка.GTIN;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ДанныеGTIN.Количество() > 1 Тогда
			Возврат Неопределено;
		ИначеЕсли ДанныеGTIN.Количество() = 1 Тогда
			Возврат ПоследнееЗначениеВыборки;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДанныеGTIN = Новый Соответствие;
	ПоследнееЗначениеВыборки = "";
	Пока Выборка.Следующий() Цикл
		Если ор_ИнтеграцияМДЛПКлиентСервер.ЭтоGTIN(Выборка.GTIN)
			И МенеджерОборудованияКлиентСервер.ПроверитьКорректностьGTIN(Выборка.GTIN) Тогда
			ЗначениеGTIN = ДанныеGTIN[Выборка.GTIN];
			Если ЗначениеGTIN = Неопределено Тогда
				ДанныеGTIN.Вставить(Выборка.GTIN);
				ПоследнееЗначениеВыборки = Выборка.GTIN;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеGTIN.Количество() = 1 Тогда
		Возврат ПоследнееЗначениеВыборки;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ПриЗагрузкеУведомленияЗаполнитьКоличествоУпаковок(Объект, ИмяТЧ = "Товары") Экспорт
	
	Для Каждого СтрокаТовара Из Объект[ИмяТЧ] Цикл
		
		СтрокаТовара.КоличествоУпаковок = СтрокаТовара.Количество / ПолучитьКоэффициентЕдиницыИзмерения(СтрокаТовара.Упаковка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗагрузкеУведомленияЗаполнитьНоменклатуруХарактеристику(Объект, ИмяТЧТовары = "Товары", ТолькоНоменклатуру = Ложь) Экспорт
	
	вТаблицаТовары = Объект[ИмяТЧТовары].Выгрузить(, "НомерСтроки, GTIN");
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТиповСтрокаНомерУпаковки = Новый ОписаниеТипов(МассивТипов, , Новый КвалификаторыСтроки(27));
	ОписаниеТиповСтрокаКлючУпаковки = Новый ОписаниеТипов(МассивТипов, , Новый КвалификаторыСтроки(100));
	вТаблицаТовары.Колонки.Добавить("НомерУпаковки", ОписаниеТиповСтрокаНомерУпаковки);
	вТаблицаТовары.Колонки.Добавить("КлючУпаковки", ОписаниеТиповСтрокаКлючУпаковки);
	
	вТаблицаТовары.Очистить();
	
	Для Каждого СтрокаТовара Из Объект[ИмяТЧТовары] Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			И НЕ ЗначениеЗаполнено(СтрокаТовара.Характеристика)
			И НЕ ТолькоНоменклатуру Тогда
			СтруктураПоиска = Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки);
			НайденныеСтроки = Объект.НомераУпаковок.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НоваяСтрока = вТаблицаТовары.Добавить();
				НоваяСтрока.НомерСтроки = СтрокаТовара.НомерСтроки;
				НоваяСтрока.НомерУпаковки = НайденныеСтроки[0].НомерКИЗ;
				НоваяСтрока.КлючУпаковки = ИнтеграцияМДЛПКлиентСервер.ПолучитьКлючУпаковки(НайденныеСтроки[0].НомерКИЗ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если вТаблицаТовары.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаТовары.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТовары.НомерУпаковки КАК НомерУпаковки,
		|	ТаблицаТовары.КлючУпаковки КАК КлючУпаковки
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.НомерСтроки КАК НомерСтроки,
		|	УпаковкиМаркируемыхТоваров.Номенклатура КАК Номенклатура,
		|	УпаковкиМаркируемыхТоваров.Характеристика КАК Характеристика
		|ИЗ
		|	втТовары КАК втТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ор_МДЛПУпаковкиМаркируемыхТоваров КАК УпаковкиМаркируемыхТоваров
		|		ПО втТовары.НомерУпаковки = УпаковкиМаркируемыхТоваров.НомерУпаковки
		|			И втТовары.КлючУпаковки = УпаковкиМаркируемыхТоваров.КлючУпаковки";
		
		Запрос.УстановитьПараметр("ТаблицаТовары", вТаблицаТовары);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТаблицы = Объект[ИмяТЧТовары][Выборка.НомерСтроки - 1];
			СтрокаТаблицы.Номенклатура = Выборка.Номенклатура;
			СтрокаТаблицы.Характеристика = Выборка.Характеристика;
		КонецЦикла;
	КонецЕсли;
	
	вТаблицаТовары.Очистить();
	
	Для Каждого СтрокаТовара Из Объект[ИмяТЧТовары] Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			НоваяСтрока = вТаблицаТовары.Добавить();
			НоваяСтрока.НомерСтроки = СтрокаТовара.НомерСтроки;
			НоваяСтрока.GTIN = СтрокаТовара.GTIN;
		КонецЕсли;
	КонецЦикла;
	
	Если вТаблицаТовары.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаТовары.НомерСтроки КАК НомерСтроки,
		|	ТаблицаТовары.GTIN КАК GTIN
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.НомерСтроки КАК НомерСтроки,
		|	Штрихкоды.Номенклатура КАК Номенклатура
		|ИЗ
		|	втТовары КАК втТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|		ПО втТовары.GTIN = Штрихкоды.Штрихкод
		|			И (Штрихкоды.Номенклатура ССЫЛКА Справочник.Номенклатура)
		|			И (Штрихкоды.Номенклатура.КатегорияНоменклатуры.ор_УчетМаркируемыхТоваров)
		|			И (Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения)
		|			И (Штрихкоды.Партия = &Партия)
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура)
		|ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("ТаблицаТовары"   , вТаблицаТовары);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
		Запрос.УстановитьПараметр("Партия"          , Справочники.ПартииНоменклатуры.ПустаяСсылка());
		
		Результат = Запрос.Выполнить();
		
		ВыборкаПоНомерСтроки = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПоНомерСтроки.Следующий() Цикл
			Если ВыборкаПоНомерСтроки.Номенклатура = 1 Тогда
				ВыборкаПоТоварам = ВыборкаПоНомерСтроки.Выбрать();
				Если ВыборкаПоТоварам.Следующий() Тогда
					СтрокаТаблицы = Объект[ИмяТЧТовары][ВыборкаПоТоварам.НомерСтроки - 1];
					СтрокаТаблицы.Номенклатура = ВыборкаПоТоварам.Номенклатура;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого СтрокаТовара Из Объект[ИмяТЧТовары] Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			ор_ИнтеграцияМДЛПКлиентСервер.ЗаполнитьСлужебныеРеквизитыНоменклатуры(СтрокаТовара);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьМассивТоваровДляРегистрацииGTIN(МассивТоваров) Экспорт
	
	втТовары = Новый ТаблицаЗначений;
	втТовары.Колонки.Добавить("GTIN", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(14)));
	втТовары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	втТовары.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Для Каждого СтрокаМассива Из МассивТоваров Цикл
		НоваяСтрока = втТовары.Добавить();
		НоваяСтрока.GTIN           = СтрокаМассива.GTIN;
		НоваяСтрока.Номенклатура   = СтрокаМассива.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаМассива.Характеристика;
	КонецЦикла;
	
	НовыйМассивТоваров = Новый Массив;
	
	ОбработатьТаблицуТоваровДляРегистрацииGTIN(втТовары);
	
	Для Каждого Строка Из втТовары Цикл
		СтруктураСтроки = Новый Структура("ДляХарактеристики,GTIN,Номенклатура,Характеристика");
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, Строка);
		НовыйМассивТоваров.Добавить(СтруктураСтроки);
	КонецЦикла;
	
	МассивТоваров = НовыйМассивТоваров;
	
КонецПроцедуры

Процедура ОбработатьТаблицуТоваровДляРегистрацииGTIN(ТоварыРегистрацииGTIN) Экспорт
	
	Если ТоварыРегистрацииGTIN.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаТовары.GTIN КАК GTIN,
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ТаблицаТовары.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.GTIN КАК GTIN,
		|	втТовары.Номенклатура КАК Номенклатура,
		|	втТовары.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ втТоварыБезШК
		|ИЗ
		|	втТовары КАК втТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|		ПО втТовары.GTIN = Штрихкоды.Штрихкод
		|			И втТовары.Номенклатура = Штрихкоды.Номенклатура
		|			И (втТовары.Характеристика = Штрихкоды.Характеристика
		|				ИЛИ Штрихкоды.Характеристика = &ПустаяХарактеристика)
		|			И (Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения)
		|			И (Штрихкоды.Партия = &Партия)
		|ГДЕ
		|	Штрихкоды.Штрихкод ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	втТовары.GTIN,
		|	втТовары.Номенклатура,
		|	втТовары.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК GTIN,
		|	Штрихкоды.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ втШтрихкодыПоGTIN
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТоварыБезШК КАК втТоварыБезШК
		|		ПО Штрихкоды.Штрихкод = втТоварыБезШК.GTIN
		|			И Штрихкоды.Номенклатура = втТоварыБезШК.Номенклатура
		|			И (Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения)
		|			И (Штрихкоды.Партия = &Партия)
		|			И Штрихкоды.Характеристика <> втТоварыБезШК.Характеристика
		|			И (Штрихкоды.Характеристика <> &ПустаяХарактеристика)
		|
		|СГРУППИРОВАТЬ ПО
		|	Штрихкоды.Штрихкод,
		|	Штрихкоды.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Штрихкоды.Номенклатура КАК Номенклатура,
		|	Штрихкоды.Штрихкод КАК GTIN,
		|	ВЫБОР
		|			КОГДА Штрихкоды.Характеристика = &ПустаяХарактеристика
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ КАК ДляХарактеристики
		|ПОМЕСТИТЬ втШтрихкодыПоНоменклатуреВременная
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТоварыБезШК КАК втТоварыБезШК
		|		ПО Штрихкоды.Номенклатура = втТоварыБезШК.Номенклатура
		|			И (Штрихкоды.ЕдиницаИзмерения = &ЕдиницаИзмерения)
		|			И (Штрихкоды.Партия = &Партия)
		|;
		|";
		
		Запрос.УстановитьПараметр("ТаблицаТовары"       , ТоварыРегистрацииGTIN);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения"    , Справочники.ЕдиницыИзмерения.ПустаяСсылка());
		Запрос.УстановитьПараметр("Партия"              , Справочники.ПартииНоменклатуры.ПустаяСсылка());
		Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Выполнить();
		
		ОтобратьТолькоGTIN(Запрос.МенеджерВременныхТаблиц, "втШтрихкодыПоНоменклатуреВременная");
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	втШтрихкодыПоНоменклатуреВременная.Номенклатура КАК Номенклатура,
		|	МИНИМУМ(втШтрихкодыПоНоменклатуреВременная.ДляХарактеристики) КАК ДляХарактеристики
		|ПОМЕСТИТЬ втШтрихкодыПоНоменклатуре
		|ИЗ
		|	втШтрихкодыПоНоменклатуреВременная КАК втШтрихкодыПоНоменклатуреВременная
		|
		|СГРУППИРОВАТЬ ПО
		|	втШтрихкодыПоНоменклатуреВременная.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТоварыБезШК.GTIN КАК GTIN,
		|	втТоварыБезШК.Номенклатура КАК Номенклатура,
		|	втТоварыБезШК.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА НЕ втШтрихкодыПоGTIN.GTIN ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ВЫБОР
		|				КОГДА НЕ втШтрихкодыПоНоменклатуре.Номенклатура ЕСТЬ NULL
		|					ТОГДА втШтрихкодыПоНоменклатуре.ДляХарактеристики
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|	КОНЕЦ КАК ДляХарактеристики
		|ИЗ
		|	втТоварыБезШК КАК втТоварыБезШК
		|		ЛЕВОЕ СОЕДИНЕНИЕ втШтрихкодыПоGTIN КАК втШтрихкодыПоGTIN
		|		ПО втТоварыБезШК.GTIN = втШтрихкодыПоGTIN.GTIN
		|			И втТоварыБезШК.Номенклатура = втШтрихкодыПоGTIN.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ втШтрихкодыПоНоменклатуре КАК втШтрихкодыПоНоменклатуре
		|		ПО втТоварыБезШК.Номенклатура = втШтрихкодыПоНоменклатуре.Номенклатура";
		
		ТоварыРегистрацииGTIN = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтобратьТолькоGTIN(МенеджерВременныхТаблиц, ИмяТаблицы = "втШтрихкоды") Экспорт
	
	МассивДляУдаления = Новый Массив;
	ТаблицаGTIN = МенеджерВременныхТаблиц.Таблицы[ИмяТаблицы].ПолучитьДанные().Выгрузить();
	
	Для Каждого Строка Из ТаблицаGTIN Цикл
		Если НЕ ор_ИнтеграцияМДЛПКлиентСервер.ЭтоGTIN(Строка.GTIN) Тогда
			МассивДляУдаления.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из МассивДляУдаления Цикл
		ТаблицаGTIN.Удалить(Строка);
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить("
	|УНИЧТОЖИТЬ #ИмяТаблицы
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ #ИмяТаблицы
	|ИЗ
	|	&ТаблицаGTIN КАК ТаблицаGTIN
	|", "#ИмяТаблицы", ИмяТаблицы);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаGTIN", ТаблицаGTIN);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СверткаИнформационнойБазыПометитьДокументНаУдаление(ИмяДокумента,ДокументОбъект) Экспорт
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("СверткаИнформационнойБазыПометитьДокументНаУдалениеМДЛП");
	
КонецПроцедуры

Функция РазрешеноУдалениеПриСвертке(Объект) Экспорт
	
	Результат = Ложь;
	
	ЕстьДополнительныеСвойства = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДополнительныеСвойства");
	
	Если НЕ ЕстьДополнительныеСвойства Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДополнительныеСвойства = Объект.ДополнительныеСвойства;
	
	Если НЕ ТипЗнч(ДополнительныеСвойства) = Тип("Структура")
		И НЕ ДополнительныеСвойства.Свойство("СверткаИнформационнойБазыПометитьДокументНаУдалениеМДЛП") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекущийСтатус = ИнтеграцияМДЛП.ТекущийСтатусУведомления(Объект.Ссылка);
	СтатусМДЛП = ТекущийСтатус.Статус;
	
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.УведомлениеОбОтгрузкеМДЛП")
		ИЛИ ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.УведомлениеОПриемкеМДЛП") Тогда
		
		Если СтатусМДЛП = Перечисления.СтатусыИнформированияМДЛП.Закрыто Тогда
			Результат = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.УведомлениеВладельцаОбОприходованииМДЛП") Тогда
		
		Если СтатусМДЛП = Перечисления.СтатусыИнформированияМДЛП.Закрыто Тогда
			Результат = Истина;
		КонецЕсли;
		
	Иначе
		
		Если СтатусМДЛП = Перечисления.СтатусыИнформированияМДЛП.Закрыто
			ИЛИ СтатусМДЛП = Перечисления.СтатусыИнформированияМДЛП.Принято Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНоменклатуры(НоменклатураПредставление, ХарактеристикаПредставление, СерияПредставление = "") Экспорт

	СтрПредставление = СокрЛП(НоменклатураПредставление);

	Если ЗначениеЗаполнено(ХарактеристикаПредставление) И НЕ ХарактеристикаПредставление = "<>" Тогда
		СтрПредставление = СтрПредставление + " / " + СокрЛП(ХарактеристикаПредставление);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СерияПредставление)Тогда
		СтрПредставление = СтрПредставление + " / " + СокрЛП(СерияПредставление);
	КонецЕсли;

	Возврат СтрПредставление;

КонецФункции

Функция ПолучитьПоступлениеТоваровПоЗаказуПоставщику(ЗаказПоставщику) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриходнаяНакладная.Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
	|ГДЕ
	|	ПриходнаяНакладная.Заказ = &ЗаказПоставщику
	|	И НЕ ПриходнаяНакладная.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|	И ПриходнаяНакладная.Проведен";
	
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция УведомлениеОбщийТекстЗапросаОформите(Уведомление) Экспорт
	
	Основания = Новый Массив;
	Для Каждого ТипОснования Из Уведомление.Реквизиты.Основание.Тип.Типы() Цикл
		
		Если ОбщегоНазначения.ЭтоСсылка(ТипОснования) Тогда
			Основания.Добавить(Метаданные.НайтиПоТипу(ТипОснования));
		КонецЕсли;
		
	КонецЦикла;
	
	Если Основания.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтатусыОформления.Основание) КАК КоличествоДокументов
	|ИЗ
	|	РегистрСведений.СтатусыОформленияДокументовМДЛП КАК СтатусыОформления
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СтатусыОформленияДокументовМДЛП КАК ДругиеУведомленияПоОснованию
	|	ПО
	|		ДругиеУведомленияПоОснованию.Основание = СтатусыОформления.Основание
	|		И ДругиеУведомленияПоОснованию.СтатусОформления <> ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовМДЛП.НеОформлено)
	|		И НЕ ДругиеУведомленияПоОснованию.Документ В (&СовместноВводимыеУведомления)
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СубъектыОбращенияМДЛП КАК ОрганизацииМДЛП
	|	ПО
	|		ОрганизацииМДЛП.ОрганизацияКонтрагент = СтатусыОформления.Организация
	|		И ОрганизацииМДЛП.ОбъектМестаДеятельности = СтатусыОформления.МестоДеятельности
	|//СОЕДИНЕНИЯ
	|ГДЕ
	|	СтатусыОформления.Документ = &Уведомление
	|	И СтатусыОформления.СтатусОформления В (
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовМДЛП.НеОформлено),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовМДЛП.ОформленоЧастично)
	|	)
	|	И ДругиеУведомленияПоОснованию.Основание ЕСТЬ NULL
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ ОрганизацииМДЛП.Организация = &Организация)
	|	И (&МестоДеятельности = НЕОПРЕДЕЛЕНО ИЛИ ОрганизацииМДЛП.МестоДеятельности = &МестоДеятельности)
	|//УСЛОВИЯ
	|";
	
	Соединения = "";
	УсловияСсылка = Новый Массив;
	
	Для Каждого Основание Из Основания Цикл
		
		Если Не ПравоДоступа("Чтение", Основание) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяТаблицы = Основание.ПолноеИмя();
		Псевдоним  = Основание.Имя;
		
		Соединения = Соединения + СтрШаблон("
			|	ЛЕВОЕ СОЕДИНЕНИЕ
			|		%1 КАК %2
			|	ПО
			|		%2.Ссылка = СтатусыОформления.Основание
			|",
			ИмяТаблицы,
			Псевдоним);
		УсловияСсылка.Добавить(СтрШаблон("%1.Ссылка ЕСТЬ НЕ NULL", Псевдоним));
		
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Уведомление", СтрШаблон("ЗНАЧЕНИЕ(%1.ПустаяСсылка)", Уведомление.ПолноеИмя()));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СовместноВводимыеУведомления", СтрШаблон("ЗНАЧЕНИЕ(%1.ПустаяСсылка)", Уведомление.ПолноеИмя()));
	
	Если Не ПустаяСтрока(Соединения) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//СОЕДИНЕНИЯ", Соединения);
	КонецЕсли;
	
	Если УсловияСсылка.Количество() > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//УСЛОВИЯ", СтрШаблон("И (%1)", СтрСоединить(УсловияСсылка, " ИЛИ ")) + Символы.ПС + "//УСЛОВИЯ");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ПроверитьЗаполнениеХарактеристик(Объект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверки = Неопределено) Экспорт
	
	Перем СуффиксДопРеквизита;
	Перем ИмяТЧ;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПроверки <> Неопределено Тогда
		
		ПараметрыПроверки.Свойство("ИмяТЧ",ИмяТЧ);
		ПараметрыПроверки.Свойство("СуффиксДопРеквизита",СуффиксДопРеквизита);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяТЧ) Тогда
		ИмяТЧ = "Товары";
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов.Добавить(ИмяТЧ+".Характеристика");
	
	Если ЗначениеЗаполнено(СуффиксДопРеквизита) Тогда
		МассивНепроверяемыхРеквизитов.Добавить(ИмяТЧ+".Характеристика"+СуффиксДопРеквизита);
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("УправляемаяФорма") Тогда
		МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	Иначе
		МетаданныеОбъекта = Объект.Метаданные();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.НомерСтроки,";
	Если ЗначениеЗаполнено(СуффиксДопРеквизита) Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|	ТаблицаТоваров.Номенклатура"+СуффиксДопРеквизита+" КАК Номенклатура"+СуффиксДопРеквизита+",
	|	ТаблицаТоваров.Характеристика"+СуффиксДопРеквизита+" КАК Характеристика"+СуффиксДопРеквизита+",";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ СтрокиСОшибками
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|ГДЕ
	|	ТаблицаТоваров.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	Если ЗначениеЗаполнено(СуффиксДопРеквизита) Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|	ИЛИ ТаблицаТоваров.Характеристика"+СуффиксДопРеквизита+" = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиСОшибками.НомерСтроки,";
	Если ЗначениеЗаполнено(СуффиксДопРеквизита) Тогда
		ТекстЗапроса = ТекстЗапроса + "	
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура" + СуффиксДопРеквизита +" КАК Справочник.Номенклатура).ИспользоватьХарактеристики)
		|			И СтрокиСОшибками.Характеристика"+СуффиксДопРеквизита+" = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НеЗаполненаХарактеристика" + СуффиксДопРеквизита +",";
		
		// Получение признака использования характеристик.
		ТекстЗапроса = ТекстЗапроса + "	
		|	ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура" + СуффиксДопРеквизита +" КАК Справочник.Номенклатура).ИспользоватьХарактеристики КАК ИспользуетсяХарактеристики" + СуффиксДопРеквизита +",";
		
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "	
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура КАК Справочник.Номенклатура).ИспользоватьХарактеристики
	|			И СтрокиСОшибками.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НеЗаполненаХарактеристика
	// Получение признака использования характеристик.
	|	,ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура КАК Справочник.Номенклатура).ИспользоватьХарактеристики КАК ИспользуетсяХарактеристики
	|ИЗ
	|	СтрокиСОшибками КАК СтрокиСОшибками
	|ГДЕ
	|	ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура КАК Справочник.Номенклатура).ИспользоватьХарактеристики
	| 	И СтрокиСОшибками.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	Если ЗначениеЗаполнено(СуффиксДопРеквизита) Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|	ИЛИ ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура" + СуффиксДопРеквизита +" КАК Справочник.Номенклатура).ИспользоватьХарактеристики
	|	И СтрокиСОшибками.Характеристика"+СуффиксДопРеквизита+" = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	СтрокаДопРеквизитов = ?(Не ЗначениеЗаполнено(СуффиксДопРеквизита), "", ",Номенклатура"+СуффиксДопРеквизита+",Характеристика"+СуффиксДопРеквизита);
	
	Если Не ПараметрыПроверки = Неопределено Тогда
		СписокСтрок = Неопределено;
		ОтборПроверяемыхСтрок = Неопределено;
		ЕстьСписокСтрок = ПараметрыПроверки.Свойство("СписокСтрок",СписокСтрок);
		ЕстьОтборПроверяемыхСтрок = ПараметрыПроверки.Свойство("ОтборПроверяемыхСтрок",ОтборПроверяемыхСтрок);
		
		Если СписокСтрок = Неопределено 
			И ЕстьОтборПроверяемыхСтрок 
			И (Не ОтборПроверяемыхСтрок = Неопределено) 
			И ОтборПроверяемыхСтрок.Количество() >0 Тогда
			
			ОтборСтрокДляПроверки = ПараметрыПроверки.ОтборПроверяемыхСтрок;
		Иначе
			ОтборСтрокДляПроверки = СписокСтрок;
		КонецЕсли;
		
		Если ОтборСтрокДляПроверки = Неопределено Тогда
			Запрос.УстановитьПараметр("ТаблицаТоваров",  Объект[ИмяТЧ].Выгрузить(,"НомерСтроки,Номенклатура,Характеристика"+СтрокаДопРеквизитов));
		Иначе
			Запрос.УстановитьПараметр("ТаблицаТоваров",
			Объект[ИмяТЧ].Выгрузить(ОтборСтрокДляПроверки, "НомерСтроки,Номенклатура,Характеристика"+СтрокаДопРеквизитов));
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр("ТаблицаТоваров",  Объект[ИмяТЧ].Выгрузить(,"НомерСтроки,Номенклатура,Характеристика"+СтрокаДопРеквизитов));
	КонецЕсли;
	
	ШаблонСообщения = НСтр("ru='Не заполнена колонка ""%Характеристика%"" в строке %НомерСтроки% списка ""%ТаблицаТовары%"".'");
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПредставлениеТЧ                      = МетаданныеОбъекта.ТабличныеЧасти[ИмяТЧ].Синоним;
	ПредставлениеРеквизитаХарактеристика = МетаданныеОбъекта.ТабличныеЧасти[ИмяТЧ].Реквизиты.Характеристика.Синоним;
	ПредставлениеРеквизитаХарактеристикаДоп = МетаданныеОбъекта.ТабличныеЧасти[ИмяТЧ].Реквизиты["Характеристика"+СуффиксДопРеквизита].Синоним;
	
	ИгнорироватьНезаполненныеСерии = ПараметрыПроверки <> Неопределено И ПараметрыПроверки.Свойство("ИгнорироватьОбязательноеЗаполнениеХарактеристикСерий");
	
	Пока Выборка.Следующий() Цикл
		
		// Добавляем обработку проверки заполнения характеристик для товара не являющегося ЛС.
		Если ИгнорироватьНезаполненныеСерии Тогда
			ОшибкаЗаполненияХарактеристик     =  НЕ Выборка.ИспользуетсяХарактеристики И Выборка.НеЗаполненаХарактеристика;
			ОшибкаЗаполненияХарактеристикСуфф = НЕ ПустаяСтрока(СуффиксДопРеквизита) И НЕ Выборка["ИспользуетсяХарактеристики" + СуффиксДопРеквизита] И Выборка["НеЗаполненаХарактеристика" + СуффиксДопРеквизита];
		Иначе
			ОшибкаЗаполненияХарактеристик     = Выборка.НеЗаполненаХарактеристика;
			ОшибкаЗаполненияХарактеристикСуфф = НЕ ПустаяСтрока(СуффиксДопРеквизита) И Выборка["НеЗаполненаХарактеристика" + СуффиксДопРеквизита];
		КонецЕсли;
		
		Если ОшибкаЗаполненияХарактеристик Тогда
			
			ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%Характеристика%", ПредставлениеРеквизитаХарактеристика);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТаблицаТовары%", ПредставлениеТЧ);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
			
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, Выборка.НомерСтроки, "Характеристика");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,Поле,"Объект",Отказ);
		КонецЕсли;
		
		Если ОшибкаЗаполненияХарактеристикСуфф Тогда
			
			ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%Характеристика%", ПредставлениеРеквизитаХарактеристикаДоп);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТаблицаТовары%", ПредставлениеТЧ);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
			
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, Выборка.НомерСтроки, "Характеристика"+СуффиксДопРеквизита);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,Поле,"Объект",Отказ);
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьПризнакХарактеристикиИспользуются(ТекущаяСтрока) Экспорт
	
	Номенклатура = ТекущаяСтрока.Номенклатура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.ИспользоватьХарактеристики КАК ИспользованиеХарактеристик
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ТекущаяСтрока[Номенклатура]);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ТекущаяСтрока.ХарактеристикиИспользуются = Выборка.ИспользованиеХарактеристик;
	Иначе
		ТекущаяСтрока.ХарактеристикиИспользуются = Ложь;
	КонецЕсли
	
КонецПроцедуры

#КонецОбласти


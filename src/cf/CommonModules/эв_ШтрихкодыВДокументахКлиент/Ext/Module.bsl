

#Область ПрограммныйИнтерфейс

// Заполняет программный реквизит штрихкода в строке табличной части
// из регистра сведений ШтрихкодыНоменклатуры по номенклатуре и характеристике.
//
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции - строка табличной части с номенклатурой.
//
Процедура ЗаполнитьШтрихкодСтроки(СтрокаТаблицы) Экспорт
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = "эв_Штрихкод";
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, ИмяРеквизита)
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "Номенклатура") Тогда
		Возврат;
	КонецЕсли;
	
	Характеристика = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "Характеристика") Тогда
		Характеристика = СтрокаТаблицы.Характеристика;
	КонецЕсли;
	
	ИмяРеквизитаКлюч = "эв_ШтрихкодКлюч";
	Ключ = КлючШтрихкода(СтрокаТаблицы.Номенклатура, Характеристика);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, ИмяРеквизитаКлюч)
		И СтрокаТаблицы[ИмяРеквизитаКлюч] = Ключ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		СтрокаТаблицы[ИмяРеквизита] = "";
	Иначе
		СтрокаТаблицы[ИмяРеквизита] = эв_ШтрихкодыВДокументах.ШтрихкодПоНоменклатуре(
			СтрокаТаблицы.Номенклатура,
			Характеристика);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, ИмяРеквизитаКлюч) Тогда
		СтрокаТаблицы[ИмяРеквизитаКлюч] = Ключ;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючШтрихкода(Номенклатура, Характеристика)
	
	Возврат КлючСсылки(Номенклатура) + "/" + КлючСсылки(Характеристика);
	
КонецФункции

Функция КлючСсылки(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	// На клиенте XMLСтрока не преобразует ссылку и падает с "Ошибка преобразования данных XML".
	// Строка УИД совпадает с результатом XMLСтрока(Ссылка) на сервере.
	Возврат Строка(Ссылка.УникальныйИдентификатор());
	
КонецФункции

#КонецОбласти

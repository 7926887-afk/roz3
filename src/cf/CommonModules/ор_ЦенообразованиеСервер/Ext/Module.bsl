		|	МАКСИМУМ(РозничныйВидЦен),
		|	МАКСИМУМ(ЭтоРозничныйСклад)
		|ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("ДатаСогласованияЦен",ДокументОбъект.ор_ДатаСогласованияЦенЖНВЛП);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаПоступление);
		Запрос.УстановитьПараметр("ЦенаПроизводителяСНДС", Справочники.ВидыЦен.ЦенаПроизводителя.ЦенаВключаетНДС);
		
		СписокТиповСкладов = Новый Массив;
		СписокТиповСкладов.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Розница);
		Запрос.УстановитьПараметр("СписокТиповСкладов", СписокТиповСкладов);
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент    = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы+1;
		
		// Вывод заголовка документа.
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок|ОбщаяШирина");
		ОбластьЗаголовок.Параметры.Заполнить(МассивОбъектов);
		ОбластьЗаголовок.Параметры.ПредставлениеПоставщика = СсылкаНаПоступление.Контрагент;
		ОбластьЗаголовок.Параметры.ПредставлениеПолучателя = СсылкаНаПоступление.Организация;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		// Вывод шапки ТЧ.
		
		ОбластьШапкаТаблицы = Новый ТабличныйДокумент;
		
		ОбластьМакетаШапкаТовар                     = Макет.ПолучитьОбласть("ШапкаТаблицы|Товар");
		ОбластьМакетаШапкаЦенаПервогоПоставщика     = Макет.ПолучитьОбласть("ШапкаТаблицы|ЦенаПервогоПоставщика");
		ОбластьМакетаШапкаЦенаСледующегоПоставщика  = Макет.ПолучитьОбласть("ШапкаТаблицы|ЦенаСледующегоПоставщика");
		ОбластьМакетаШапкаНаценкаПоставщика         = Макет.ПолучитьОбласть("ШапкаТаблицы|НаценкаПоставщика");
		ОбластьМакетаШапкаНаценкаПоставщикаОбщая    = Макет.ПолучитьОбласть("ШапкаТаблицы|НаценкаПоставщикаОбщая");
		ОбластьМакетаШапкаРозница                   = Макет.ПолучитьОбласть("ШапкаТаблицы|Розница");
		
		ОбластьШапкаТаблицы.Вывести(ОбластьМакетаШапкаТовар);
		ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаЦенаПервогоПоставщика);
		
		КолвоДопЗвеньев = 0;
		Для Каждого СтрокаТЧ ИЗ СсылкаНаПоступление.ОптовыеЗвенья Цикл
			Если СтрокаТЧ.ПорядокЗвена > КолвоДопЗвеньев Тогда
				КолвоДопЗвеньев = СтрокаТЧ.ПорядокЗвена;
			КонецЕсли;
		КонецЦикла;
		КолвоДопЗвеньев = КолвоДопЗвеньев - 1;
		КолвоДопЗвеньев = Макс(КолвоДопЗвеньев,0);
		
		ИспользуетсяУСНЕНВДУПоставщика    = НЕ СсылкаНаПоступление.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
		НалогообложениеНДСОрганизации     = НалогиУНФ.НалогообложениеНДС(СсылкаНаПоступление.Организация, СсылкаНаПоступление.СтруктурнаяЕдиница, СсылкаНаПоступление.Дата);
		ИспользуетсяУСНЕНВДУОрганизации   = НЕ НалогообложениеНДСОрганизации = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
		НастройкиНДСОрганизации           = НалогиУНФ.НастройкиНДСОрганизации(СсылкаНаПоступление.Организация, СсылкаНаПоступление.Дата);
		СистемаНалогообложенияОрганизации = 
			РегистрыСведений.СистемыНалогообложенияОрганизаций.ОпределитьСистемуНалогообложенияОрганизации(СсылкаНаПоступление.Организация, СсылкаНаПоступление.Дата);
		
		Для Сч = 0 По КолвоДопЗвеньев Цикл
			
			ОбластьМакетаШапкаНаценкаПоставщика.Параметры.НомерКолонки12 = 12+5*Сч;
			ОбластьМакетаШапкаНаценкаПоставщика.Параметры.НомерКолонки13 = 13+5*Сч;
			
			ОбластьМакетаШапкаЦенаСледующегоПоставщика.Параметры.НомерКолонки14 = 14+5*Сч;
			ОбластьМакетаШапкаЦенаСледующегоПоставщика.Параметры.НомерКолонки15 = 15+5*Сч;
			ОбластьМакетаШапкаЦенаСледующегоПоставщика.Параметры.НомерКолонки16 = 16+5*Сч;
			
			ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаНаценкаПоставщика);
			ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаЦенаСледующегоПоставщика);
			
		КонецЦикла;
		
		Сч = ?((Сч-1)<0, Сч, Сч-1);
		
		ОбластьМакетаШапкаНаценкаПоставщикаОбщая.Параметры.НомерКолонки17 = 17+5*Сч;
		ОбластьМакетаШапкаНаценкаПоставщикаОбщая.Параметры.НомерКолонки18 = 18+5*Сч;
		
		ОбластьМакетаШапкаРозница.Параметры.НомерКолонки19 = 19+5*Сч;
		ОбластьМакетаШапкаРозница.Параметры.НомерКолонки20 = 20+5*Сч;
		
		// Заполним параметры шапки таблицы для следующего листа
		// ОбластьМакетаШапкаРозница.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы.
		
		ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаНаценкаПоставщикаОбщая);
		ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаРозница);
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		// Создаем массив для проверки вывода.
		МассивВыводимыхОбластей = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			
			// Печать из приходной накладной.
			Если Выборка.ЭтоРозничныйСклад Тогда
				
				Если РозничныйТипЦен = Неопределено Тогда
					РозничныйТипЦен = Выборка.РозничныйВидЦен;
					СтруктураТаблицПредельныхНаценок = Новый Структура;
					СтруктураТаблицПредельныхНаценок.Вставить("ор_ДиапазоныНаценокНСиПТВ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РозничныйТипЦен, "ор_ДиапазоныНаценокНСиПТВ").Выгрузить());
					СтруктураТаблицПредельныхНаценок.Вставить("ор_ДиапазоныНаценокЖНВЛП",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РозничныйТипЦен, "ор_ДиапазоныНаценокЖНВЛП").Выгрузить());
				КонецЕсли;
				
				// Для вычесления предельной розничной цены необходимо понять, являемся мы плательщиками НДС
				// Для этого вытащим налогообложения из формул расчета ЖНВЛП и НСиПТВ.
				ор_ПараметрыРасчетаФормулРозиничнойЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РозничныйТипЦен, "ор_ПараметрыРасчетаФормул").Выгрузить();
				СистиемаНалогообложенияЖНВЛП  = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.ОСН");
				СистиемаНалогообложенияНСиПТВ = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.ОСН");
				
				ВариантРасчета = Перечисления.ор_ВидыДополнительныхАлгоритмовРасчетаЦен.ЖНВЛП;
				НайденнаяСтрока = ор_ПараметрыРасчетаФормулРозиничнойЦены.Найти(ВариантРасчета, "ВариантРасчета");
				Если НайденнаяСтрока <> Неопределено Тогда
					СистиемаНалогообложенияЖНВЛП = НайденнаяСтрока.СистемаНалогообложения;
				КонецЕсли;
				
				ВариантРасчета = Перечисления.ор_ВидыДополнительныхАлгоритмовРасчетаЦен.НСиПТВ;
				НайденнаяСтрока = ор_ПараметрыРасчетаФормулРозиничнойЦены.Найти(ВариантРасчета, "ВариантРасчета");
				Если НайденнаяСтрока <> Неопределено Тогда
					СистиемаНалогообложенияНСиПТВ = НайденнаяСтрока.СистемаНалогообложения;
				КонецЕсли;
				
				// Вытащим значение ставки НДС розничной цены.
				СтавкаНДСРозничнойЦены         = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РозничныйТипЦен, "ор_СтавкаНДС");
				ЗначениеСтавкиНДСРозничнойЦены = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтавкаНДСРозничнойЦены);
				
				ЭтоУСНЖНВЛП = СистиемаНалогообложенияЖНВЛП = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.УСНДоход")
					ИЛИ СистиемаНалогообложенияЖНВЛП = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.УСНДоходРасход");
					
				ЭтоУСННСиПТВ = СистиемаНалогообложенияНСиПТВ = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.УСНДоход")
					ИЛИ СистиемаНалогообложенияНСиПТВ = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.УСНДоходРасход");
					
				// Цена поставщика без НДС используется только в ОСН и УСН с общими ставками.
				НеобходимаЦенаПоставщикаБезНДСЖНВЛП = СистиемаНалогообложенияЖНВЛП = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.ОСН")
					ИЛИ (ЭтоУСНЖНВЛП И ЗначениеСтавкиНДСРозничнойЦены = 10);
					
				НеобходимаЦенаПоставщикаБезНДСНСиПТВ = СистиемаНалогообложенияНСиПТВ = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.ОСН")
					ИЛИ (ЭтоУСННСиПТВ И ЗначениеСтавкиНДСРозничнойЦены = 10);
					
			КонецЕсли;
			
			ОбластьСтрокаТаблицы = Новый ТабличныйДокумент;
			
			ОбластьМакетаСтрокаТовар = Макет.ПолучитьОбласть("Строка|Товар");
			ОбластьМакетаСтрокаТовар.Параметры.МНН = Выборка.МНН;
			ОбластьМакетаСтрокаТовар.Параметры.ТоварНаименование = Выборка.Номенклатура;
			ОбластьМакетаСтрокаТовар.Параметры.ХарактеристикаНаименование = Выборка.Характеристика;
			ОбластьМакетаСтрокаТовар.Параметры.Производитель = Выборка.Производитель;
			ОбластьМакетаСтрокаТовар.Параметры.ОтпускнаяЦена = Выборка.ЦенаЖНВЛП;
			ОбластьМакетаСтрокаТовар.Параметры.ФактическаяЦенаБезНДС = Выборка.ЦенаПроизводителяБезНДС;
			ОбластьМакетаСтрокаТовар.Параметры.ФактическаяЦенаСНДС = Выборка.ЦенаПроизводителяСНДС;
			ОбластьМакетаСтрокаТовар.Параметры.ДатаРеализации = Выборка.ДатаРеализации;
			ОбластьСтрокаТаблицы.Вывести(ОбластьМакетаСтрокаТовар);
			
			ДетальнаяВыборка = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			// Получение начальных цен.
			Если Выборка.ЦенаЖНВЛП > 0 И Выборка.ЦенаЖНВЛП < Выборка.ЦенаПроизводителяБезНДС Тогда
				лБазоваяЦена = Выборка.ЦенаЖНВЛП;
			Иначе
				лБазоваяЦена = Выборка.ЦенаПроизводителяБезНДС;
			КонецЕсли;
			лПредыдущаяЦенаБезНДС = Выборка.ЦенаПроизводителяБезНДС;
			лПредыдущаяЦенаСНДС   = Выборка.ЦенаПроизводителяСНДС;
			лПредыдущийУСНЕНВД = Ложь;
			
			СчетчикПоставщиков = 1;
			СуммаОптовыхНаценок = 0;
			
			// Вывод цен поставщиков по звеньям.
			Пока ДетальнаяВыборка.Следующий() Цикл
				Если НЕ Выборка.ЗакупкаУПроизводителя И ДетальнаяВыборка.ПорядокЗвена <> NULL Тогда
					
					Если СчетчикПоставщиков = 1 Тогда
						ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаПервогоПоставщика");
					Иначе
						ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаСледующегоПоставщика");
					КонецЕсли;
					ОбластьНаценка = Макет.ПолучитьОбласть("Строка|НаценкаПоставщика");
					
					Если ДетальнаяВыборка.УСНЕНВД Тогда
						лНаценка = ДетальнаяВыборка.СуммаНаценки;
						ОбластьЦена.Параметры.ЦенаПоставщика       = ДетальнаяВыборка.ЦенаПоставщикаСНДС;
						ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = "-";
						ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = "-";
					Иначе
						лНаценка = ДетальнаяВыборка.СуммаНаценки;
						ОбластьЦена.Параметры.ЦенаПоставщика       = "-";
						ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = ДетальнаяВыборка.ЦенаПоставщикаБезНДС;
						ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = ДетальнаяВыборка.ЦенаПоставщикаСНДС;
					КонецЕсли;
					СуммаОптовыхНаценок = СуммаОптовыхНаценок + лНаценка;
					
					ОбластьНаценка.Параметры.ПроцентНаценки    = ?(лНаценка>0 И лБазоваяЦена>0,ДетальнаяВыборка.ПроцентНаценки,"-");
					ОбластьНаценка.Параметры.СуммаНаценки      = ?(лНаценка>0,лНаценка,"-");
					
					лПредыдущаяЦенаБезНДС = ДетальнаяВыборка.ЦенаПоставщикаБезНДС;
					лПредыдущаяЦенаСНДС = ДетальнаяВыборка.ЦенаПоставщикаСНДС;
					лПредыдущийУСНЕНВД = ДетальнаяВыборка.УСНЕНВД;
					
					Если СчетчикПоставщиков > 1 Тогда
						ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценка);
					КонецЕсли;
					ОбластьСтрокаТаблицы.Присоединить(ОбластьЦена);
					
					СчетчикПоставщиков = СчетчикПоставщиков + 1;
					
				КонецЕсли;
			КонецЦикла;
			
			// Вывод цены последнего поставщика.
			Если Не Выборка.ЗакупкаУПроизводителя Тогда
				
				Если СчетчикПоставщиков = 1 Тогда
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаПервогоПоставщика");
				Иначе
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаСледующегоПоставщика");
				КонецЕсли;
				ОбластьНаценка = Макет.ПолучитьОбласть("Строка|НаценкаПоставщика");
				Если ИспользуетсяУСНЕНВДУПоставщика Тогда
					лНаценка = Выборка.ЦенаИзДокумента - лПредыдущаяЦенаСНДС;
					ОбластьЦена.Параметры.ЦенаПоставщика       = Выборка.ЦенаИзДокумента;
					ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = "-";
					ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = "-";
					ОбластьНаценка.Параметры.ПроцентНаценки    = ?(лНаценка>0 И лБазоваяЦена>0,лНаценка/лБазоваяЦена*100,"-");
					ОбластьНаценка.Параметры.СуммаНаценки      = ?(лНаценка>0,лНаценка,"-");
					лПредыдущаяЦенаБезНДС = Выборка.ЦенаБезНДС;
					лПредыдущаяЦенаСНДС = Выборка.ЦенаИзДокумента;
				Иначе
					Если лПредыдущийУСНЕНВД Тогда
						лНаценка = Выборка.ЦенаБезНДС - лПредыдущаяЦенаСНДС;
					Иначе
						лНаценка = Выборка.ЦенаБезНДС - лПредыдущаяЦенаБезНДС;
					КонецЕсли;
					ОбластьЦена.Параметры.ЦенаПоставщика       = "-";
					ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = Выборка.ЦенаБезНДС;
					ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = Выборка.ЦенаСНДС;
					ОбластьНаценка.Параметры.ПроцентНаценки    = ?(лНаценка>0 И лБазоваяЦена>0,лНаценка/лБазоваяЦена*100,"-");
					ОбластьНаценка.Параметры.СуммаНаценки      = ?(лНаценка>0,лНаценка,"-");
					лПредыдущаяЦенаБезНДС = Выборка.ЦенаБезНДС;
					лПредыдущаяЦенаСНДС = Выборка.ЦенаСНДС;
				КонецЕсли;
				СуммаОптовыхНаценок = СуммаОптовыхНаценок + лНаценка;
				
				Если СчетчикПоставщиков > 1 Тогда
					ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценка);
				КонецЕсли;
				ОбластьСтрокаТаблицы.Присоединить(ОбластьЦена);
				СчетчикПоставщиков = СчетчикПоставщиков + 1;
				
			КонецЕсли;
			
			// Отрисовка пустых недостающих колонок
			// +2, потому-что нужно минимум отрисовать 2 звена (звено первого поставщика и звено следующего),
			// а КолвоДопЗвеньев начинается с 0.
			// Т.е. если КолвоДопЗвеньев = 0, то в шапке отрисовано два звена, если = 1, то отрисовано три звена.
			Пока СчетчикПоставщиков <= КолвоДопЗвеньев+2 Цикл
				
				Если СчетчикПоставщиков = 1 Тогда
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаПервогоПоставщика");
				Иначе
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаСледующегоПоставщика");
				КонецЕсли;
				ОбластьНаценка = Макет.ПолучитьОбласть("Строка|НаценкаПоставщика");
				ОбластьНаценка.Параметры.ПроцентНаценки    = "-";
				ОбластьНаценка.Параметры.СуммаНаценки      = "-";
				ОбластьЦена.Параметры.ЦенаПоставщика       = "-";
				ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = "-";
				ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = "-";
				Если СчетчикПоставщиков > 1 Тогда
					ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценка);
				КонецЕсли;
				ОбластьСтрокаТаблицы.Присоединить(ОбластьЦена);
				СчетчикПоставщиков = СчетчикПоставщиков + 1;
				
			КонецЦикла;
			
			// Вывод общей наценки.
			ОбластьНаценкаПоставщикаОбщая = Макет.ПолучитьОбласть("Строка|НаценкаПоставщикаОбщая");
			ОбластьНаценкаПоставщикаОбщая.Параметры.ПроцентНаценки = ?(СуммаОптовыхНаценок>0 И лБазоваяЦена>0,СуммаОптовыхНаценок*100/лБазоваяЦена,"-");
			ОбластьНаценкаПоставщикаОбщая.Параметры.СуммаНаценки   = ?(СуммаОптовыхНаценок>0,СуммаОптовыхНаценок,"-");
			ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценкаПоставщикаОбщая);
			
			// Вывод розницы.
			ВывестиПустуюОбластьРозница = Ложь;
			ОбластьЦенаРозница = Макет.ПолучитьОбласть("Строка|Розница");
			Если Выборка.ЭтоРозничныйСклад И РозничныйТипЦен <> Неопределено  Тогда
				НеобходимаЦенаПоставщикаБезНДС 
					= ?(Выборка.ЭтоНСИПТВ, НеобходимаЦенаПоставщикаБезНДСНСиПТВ, НеобходимаЦенаПоставщикаБезНДСЖНВЛП);
				ЭтоУСН 
					= ?(Выборка.ЭтоНСИПТВ, ЭтоУСННСиПТВ, ЭтоУСНЖНВЛП);
				
				// Для расчета предельной розничной цены всегда используется цена производителя без НДС.
				ЦенаПроизводителяДляРасчета = Выборка.ЦенаПроизводителяБезНДС;
				
				ЗакупочнаяЦенаДляРасчета = ?(НеобходимаЦенаПоставщикаБезНДС, лПредыдущаяЦенаБезНДС, лПредыдущаяЦенаСНДС);
				
				ПредельнаяНаценка = ПолучитьПредельнуюНаценкуЖНВЛСПоДипазонам(СтруктураТаблицПредельныхНаценок, ЦенаПроизводителяДляРасчета, Выборка.ЭтоНСИПТВ);
				
				Если ПредельнаяНаценка <> Неопределено Тогда
					
					РозничнаяЦенаПредельная = (ЗакупочнаяЦенаДляРасчета + (ЦенаПроизводителяДляРасчета * (ПредельнаяНаценка / 100)))*((ЗначениеСтавкиНДСРозничнойЦены+100)/100);
					
					// Обрезаем предельную цену до 2-х знаков после запятой, чтобы СКД не округляло.
					РозничнаяЦенаПредельная = Цел(РозничнаяЦенаПредельная * 100) / 100;
					
					ОбластьЦенаРозница.Параметры.ЦенаРозницаПредельнаяУСН  = ?(ЭтоУСН, РозничнаяЦенаПредельная, "-");
					ОбластьЦенаРозница.Параметры.ЦенаРозницаПредельнаяСНДС = ?(ЭтоУСН, "-", РозничнаяЦенаПредельная);;
				Иначе
					ВывестиПустуюОбластьРозница = Истина;
				КонецЕсли;
			Иначе
				ВывестиПустуюОбластьРозница = Истина;
			КонецЕсли;
			Если ВывестиПустуюОбластьРозница Тогда
				ОбластьЦенаРозница.Параметры.ЦенаРозницаПредельнаяУСН  = "-";
				ОбластьЦенаРозница.Параметры.ЦенаРозницаПредельнаяСНДС = "-";
			КонецЕсли;
			ОбластьСтрокаТаблицы.Присоединить(ОбластьЦенаРозница);
			
			// В массив добавляем две строки потому что баг платформы(?)
			// при добавлении одной в массив или при передаче области напрямую
			// .ПроверитьВывод() отрабатывает некорректно и считает, что облась помещается
			// из-за этого происходил разрыв страницы.
			МассивВыводимыхОбластей.Очистить();
			МассивВыводимыхОбластей.Добавить(ОбластьСтрокаТаблицы);
			МассивВыводимыхОбластей.Добавить(ОбластьСтрокаТаблицы);
			
			
			// Завершение вывода строки таблицы.
			Если Не ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
			
		КонецЦикла;
		
		// Выводим подвал.
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.ФИОПолучателя = ДокументОбъект.Автор;
		Если Не ТабличныйДокумент.ПроверитьВывод(ОбластьПодвал) Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// Выводим Примечания.
		ОбластьПримечания = Макет.ПолучитьОбласть("Примечания");
		Если Не ТабличныйДокумент.ПроверитьВывод(ОбластьПримечания) Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьПримечания);
		
		// Ширина макета: 200, ширина колонок: 0.88.
		Если ТабличныйДокумент.ШиринаТаблицы>200 Тогда
			ТабличныйДокумент.область("C201:C"+Формат(ТабличныйДокумент.ШиринаТаблицы,"ЧГ=")).ШиринаКолонки=0.88;
		КонецЕсли;
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДокументОбъект.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьПротоколСогласованияЦен2019()

Функция ПолучитьПредельнуюНаценкуЖНВЛСПоДипазонам(СтруктураТаблицПредельныхНаценок, ЦенаПроизводителя, ЭтоНСИПТВ) Экспорт
	
	Если ЭтоНСИПТВ Тогда
		ИмяТаблицыПредельныхНаценок = "ор_ДиапазоныНаценокНСиПТВ";
	Иначе
		ИмяТаблицыПредельныхНаценок = "ор_ДиапазоныНаценокЖНВЛП";
	КонецЕсли;
	
	ТаблицаДиапазонов = СтруктураТаблицПредельныхНаценок[ИмяТаблицыПредельныхНаценок];
	ПредельнаяНаценка = Неопределено;
	Для Каждого ТекущийИнтервал Из ТаблицаДиапазонов Цикл
		
		Если ЦенаПроизводителя > ТекущийИнтервал.ВерхняяГраница Тогда
			Продолжить;
		КонецЕсли;
		
		ПредельнаяНаценка = ТекущийИнтервал.ЗначениеНаценки;
		Прервать;
		
	КонецЦикла;
	Возврат ПредельнаяНаценка;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Процедура формирует данные для заполнения документа установки цен на основании документа приходной накладной
//
//  Параметры:
// - СтруктураПараметровЗаполнения - Структура, формируемая структура параметров заполнения;
// - ПриходнаяНакладная            - ДокументСсылка.ПриходнаяНакладная, документ, на основании которого формируется структура;
// - ДокументУстановкаЦенСсылка    - ДокументСсылка.УстановкаЦенНоменклатуры, документ установки цен;
//
Процедура СформироватьСтруктуруПараметровЗаполненияДокументаУстановкиЦен(СтруктураПараметровЗаполнения, ПриходнаяНакладная, ДокументУстановкаЦенСсылка)
	
	// Реквизиты
	СтруктураПараметровЗаполнения.Вставить("ДокументОснование",  ПриходнаяНакладная);
	СтруктураПараметровЗаполнения.Вставить("Автор",              Пользователи.ТекущийПользователь());
	СтруктураПараметровЗаполнения.Вставить("Комментарий",       "Документ сформирован автоматически при проведении документа <" + ПриходнаяНакладная + ">.");
	// ор ++
	СтруктураПараметровЗаполнения.Вставить("ор_ДатаСогласованияЦенЖНВЛП", ПриходнаяНакладная.ор_ДатаСогласованияЦенЖНВЛП);
	// ор --
	
	Если ЗначениеЗаполнено(ДокументУстановкаЦенСсылка) И ЗначениеЗаполнено(ДокументУстановкаЦенСсылка.Дата) Тогда
		СтруктураПараметровЗаполнения.Вставить("Дата", ДокументУстановкаЦенСсылка.Дата - 1);
	Иначе
		СтруктураПараметровЗаполнения.Вставить("Дата", ПриходнаяНакладная.Дата + 1);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьДеревоОперандов(КэшЗначений, МассивВидовЦен)
	
	ДеревоРезультата = Новый ДеревоЗначений;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДеревоРезультата", ДеревоРезультата);
	СтруктураПараметров.Вставить("МассивВидовЦен", МассивВидовЦен);
	СтруктураПараметров.Вставить("ВключаяЦеныНоменклатуры", Истина);
	СтруктураПараметров.Вставить("ВключаяЦеныКонтрагентов", Ложь);
	СтруктураПараметров.Вставить("ВидыЦенВыбраныПриЗаполнении", КэшЗначений.ВидыЦенВыбраныПриЗаполнении);
	СтруктураПараметров.Вставить("УникальныйИдентификаторФормы", Неопределено);
	
	Документы.УстановкаЦенНоменклатуры.ПолучитьДеревоВидовЦен(СтруктураПараметров);
	
	Возврат СтруктураПараметров;
	
КонецФункции

Процедура ЗаполнитьПодчиненныеВидыЦен(СтрокаВидаЦенРодитель, МассивПодчиненныхЦен)
	
	Если СтрокаВидаЦенРодитель.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаВидаЦен Из СтрокаВидаЦенРодитель.Строки Цикл
		
		Если СтрокаВидаЦен.Использование Тогда
			МассивПодчиненныхЦен.Добавить(СтрокаВидаЦен.ВидЦен);
		КонецЕсли;
		ЗаполнитьПодчиненныеВидыЦен(СтрокаВидаЦен, МассивПодчиненныхЦен);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКэшЗначенийВидамиЦен(КэшЗначений, ВидыЦен)
	
	ВыбранныеРаннееВидыЦен = КэшЗначений.ВыбранныеВидыЦен;
	КэшЗначений.ВыбранныеВидыЦен = Новый Соответствие;
	
	Для каждого ГруппаВидовЦен Из ВидыЦен.Строки Цикл
		
		Для каждого СтрокаБазовогоВидаЦен Из ГруппаВидовЦен.Строки Цикл
			
			ПодчиненныеВидыЦен = ЗаполнитьКэшЗначенийПодчиненнымиВидамиЦен(КэшЗначений, СтрокаБазовогоВидаЦен);
			
			Если СтрокаБазовогоВидаЦен.Использование 
				Или ПодчиненныеВидыЦен.Количество() > 0 Тогда
				
				СтрокаБазовогоВидаЦен.Использование = Истина;
				КэшЗначений.ВыбранныеВидыЦен.Вставить(СтрокаБазовогоВидаЦен.ВидЦен, ПодчиненныеВидыЦен); 
				
				Отключена = КэшЗначений.ОтключенныеВидыЦен.Найти(СтрокаБазовогоВидаЦен.ВидЦен);
				Если Отключена <> Неопределено Тогда

					КэшЗначений.ОтключенныеВидыЦен.Удалить(Отключена);
					
				КонецЕсли;
				
			Иначе
				
				ПодчиненныеВидыЦен = Новый Массив;
				ЗаполнитьПодчиненныеВидыЦен(СтрокаБазовогоВидаЦен, ПодчиненныеВидыЦен);
				
				Отключена = КэшЗначений.ОтключенныеВидыЦен.Найти(СтрокаБазовогоВидаЦен.ВидЦен);
				Если Отключена = Неопределено Тогда
					
					КэшЗначений.ОтключенныеВидыЦен.Добавить(СтрокаБазовогоВидаЦен.ВидЦен);
					
				КонецЕсли;
				
			КонецЕсли;
			
			ДобавитьВКэшОтключенныеВидыЦенПоРодителю(СтрокаБазовогоВидаЦен, КэшЗначений);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьКэшЗначенийПодчиненнымиВидамиЦен(КэшЗначений, Знач СтрокаБазовогоВидаЦен)
	
	Перем Найдено, ПодчиненныеВидыЦен, СтрокаВидаЦен;
	
	СоответствиеВидовЦен = Новый Соответствие;
	Для каждого СтрокаВидаЦен Из СтрокаБазовогоВидаЦен.Строки Цикл
		
		ПодчиненныеВидыЦен = ЗаполнитьКэшЗначенийПодчиненнымиВидамиЦен(КэшЗначений, СтрокаВидаЦен);
		
		Если СтрокаВидаЦен.Использование 
			Или ПодчиненныеВидыЦен.Количество() > 0 Тогда
			
			СтрокаВидаЦен.Использование = Истина;
			СоответствиеВидовЦен.Вставить(СтрокаВидаЦен.ВидЦен, ПодчиненныеВидыЦен);
			
			Найдено = КэшЗначений.ОтключенныеВидыЦен.Найти(СтрокаВидаЦен.ВидЦен);
			Если Найдено <> Неопределено Тогда
				КэшЗначений.ОтключенныеВидыЦен.Удалить(Найдено);
			КонецЕсли;
			
		Иначе
			
			Найдено = КэшЗначений.ОтключенныеВидыЦен.Найти(СтрокаВидаЦен.ВидЦен);
			Если Найдено = Неопределено Тогда
				КэшЗначений.ОтключенныеВидыЦен.Добавить(СтрокаВидаЦен.ВидЦен);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	Возврат СоответствиеВидовЦен;

КонецФункции

Процедура ДобавитьВКэшОтключенныеВидыЦенПоРодителю(СтрокаБазовогоВидаЦен, КэшЗначений)
	
	Для каждого ПодчиненныйВидЦен Из СтрокаБазовогоВидаЦен.Строки Цикл
		
		Если ПодчиненныйВидЦен.Использование Тогда
			
			Отключена = КэшЗначений.ОтключенныеВидыЦен.Найти(ПодчиненныйВидЦен.ВидЦен);
			Если Отключена <> Неопределено Тогда
				
				КэшЗначений.ОтключенныеВидыЦен.Удалить(Отключена);
				
			КонецЕсли;
			
		Иначе
			
			Отключена = КэшЗначений.ОтключенныеВидыЦен.Найти(ПодчиненныйВидЦен.ВидЦен);
			Если Отключена = Неопределено Тогда
				
				КэшЗначений.ОтключенныеВидыЦен.Добавить(ПодчиненныйВидЦен.ВидЦен);
				
			КонецЕсли;
			
		КонецЕсли; 
		
		ДобавитьВКэшОтключенныеВидыЦенПоРодителю(ПодчиненныйВидЦен, КэшЗначений)
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗапасыСВидамиЦен(ДокументОбъект, СтруктураПараметровЗаполнения)
	
	// Заполнение табличной части.
	ДокументОбъект.Запасы.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриходнаяНакладнаяЗапасы.Номенклатура КАК Номенклатура,
	|	ПриходнаяНакладнаяЗапасы.Характеристика КАК Характеристика,
	|	ПриходнаяНакладнаяЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	// ор ++
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПриходнаяНакладнаяЗапасы.Ссылка.СуммаВключаетНДС
	|				ТОГДА ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя
	|			ИНАЧЕ ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя + ПриходнаяНакладнаяЗапасы.СтавкаНДС.Ставка / 100 * ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя
	|		КОНЕЦ) КАК ЦенаПроизводителя,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПриходнаяНакладнаяЗапасы.ор_ДатаСогласованияЦенЖНВЛПСтроки = &ПустаяДата
	|				ТОГДА ПриходнаяНакладная.ор_ДатаСогласованияЦенЖНВЛП
	|			ИНАЧЕ ПриходнаяНакладнаяЗапасы.ор_ДатаСогласованияЦенЖНВЛПСтроки
	|		КОНЕЦ) КАК ор_ДатаСогласованияЦенЖНВЛП,
	// ор --
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПриходнаяНакладнаяЗапасы.Ссылка.СуммаВключаетНДС
	|				ТОГДА ПриходнаяНакладнаяЗапасы.Цена
	|			ИНАЧЕ ПриходнаяНакладнаяЗапасы.Цена + ПриходнаяНакладнаяЗапасы.СтавкаНДС.Ставка / 100 * ПриходнаяНакладнаяЗапасы.Цена
	|		КОНЕЦ) КАК Цена,
	|	МИНИМУМ(ПриходнаяНакладнаяЗапасы.НомерСтроки) КАК НомерСтроки,
	|	ПриходнаяНакладнаяЗапасы.Ссылка.Курс КАК Курс,
	|	ПриходнаяНакладнаяЗапасы.Ссылка.Кратность КАК Кратность,
	|	ПриходнаяНакладнаяЗапасы.Ссылка.ВалютаДокумента КАК ВалютаДокумента
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|	Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
	// ор ++
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
	|		ПО ПриходнаяНакладнаяЗапасы.Ссылка = ПриходнаяНакладная.Ссылка
	// ор --
	|ГДЕ
	|	ПриходнаяНакладнаяЗапасы.Ссылка = &ДокументОснование
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриходнаяНакладнаяЗапасы.Номенклатура,
	|	ПриходнаяНакладнаяЗапасы.Характеристика,
	|	ПриходнаяНакладнаяЗапасы.ЕдиницаИзмерения,
	|	ПриходнаяНакладнаяЗапасы.Ссылка.Курс,
	|	ПриходнаяНакладнаяЗапасы.Ссылка.Кратность,
	|	ПриходнаяНакладнаяЗапасы.Ссылка.ВалютаДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриходнаяНакладнаяРасходы.Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	|	ПриходнаяНакладнаяРасходы.ЕдиницаИзмерения,
	// ор ++
	|	0,
	|	МАКСИМУМ(&ПустаяДата),
	// ор --
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПриходнаяНакладнаяРасходы.Ссылка.СуммаВключаетНДС
	|				ТОГДА ПриходнаяНакладнаяРасходы.Цена
	|			ИНАЧЕ ПриходнаяНакладнаяРасходы.Цена + ПриходнаяНакладнаяРасходы.СтавкаНДС.Ставка / 100 * ПриходнаяНакладнаяРасходы.Цена
	|		КОНЕЦ),
	|	МИНИМУМ(ПриходнаяНакладнаяРасходы.НомерСтроки),
	|	ПриходнаяНакладнаяРасходы.Ссылка.Курс,
	|	ПриходнаяНакладнаяРасходы.Ссылка.Кратность,
	|	ПриходнаяНакладнаяРасходы.Ссылка.ВалютаДокумента
	|ИЗ
	|	Документ.ПриходнаяНакладная.Расходы КАК ПриходнаяНакладнаяРасходы
	|ГДЕ
	|	ПриходнаяНакладнаяРасходы.Ссылка = &ДокументОснование
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриходнаяНакладнаяРасходы.Номенклатура,
	|	ПриходнаяНакладнаяРасходы.ЕдиницаИзмерения,
	|	ПриходнаяНакладнаяРасходы.Ссылка.Курс,
	|	ПриходнаяНакладнаяРасходы.Ссылка.Кратность,
	|	ПриходнаяНакладнаяРасходы.Ссылка.ВалютаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыЦен.Ссылка КАК ВидЦены
	|ПОМЕСТИТЬ ВидыЦен
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	ВидыЦен.Ссылка В(&ВидыЦен)
	// ор ++
	|	ИЛИ ВидыЦен.Ссылка = &ЦенаПроизводителя
	// ор --
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаНоменклатуры.Характеристика КАК Характеристика,
	|	ТаблицаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	// ор ++
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВидыЦен.ВидЦены, &ПустойВидЦен) = &ЦенаПроизводителя
	|			ТОГДА ТаблицаНоменклатуры.ЦенаПроизводителя
	|		ИНАЧЕ ТаблицаНоменклатуры.Цена
	|	КОНЕЦ КАК Цена,
	|	ТаблицаНоменклатуры.ор_ДатаСогласованияЦенЖНВЛП КАК ор_ДатаСогласованияЦенЖНВЛП,
	// ор --
	|	ЕСТЬNULL(ВидыЦен.ВидЦены, НЕОПРЕДЕЛЕНО) КАК ВидЦены,
	|	ТаблицаНоменклатуры.Курс КАК КурсОснования,
	|	ТаблицаНоменклатуры.Кратность КАК КратностьОснования,
	|	ТаблицаНоменклатуры.ВалютаДокумента КАК ВалютаОснования,
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) КАК КурсВидаЦены,
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 1) КАК КратностьВидаЦены
	|ИЗ
	|	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВидыЦен КАК ВидыЦен
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаСреза, ) КАК КурсыВалютСрезПоследних
	|			ПО ВидыЦен.ВидЦены.ВалютаЦены = КурсыВалютСрезПоследних.Валюта
	|		ПО (ИСТИНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаНоменклатуры.НомерСтроки
	|ИТОГИ ПО
	|	Номенклатура,
	|	ВидЦены,
	|	ЕдиницаИзмерения";

	Запрос.УстановитьПараметр("ДокументОснование", СтруктураПараметровЗаполнения.ДокументОснование);
	Запрос.УстановитьПараметр("ВидыЦен", ДокументОбъект.ВидыЦенЗаполнятьИзОснования());
	Запрос.УстановитьПараметр("ДатаСреза", СтруктураПараметровЗаполнения.ДокументОснование.Дата);
	// ор ++
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.УстановитьПараметр("ПустойВидЦен", Справочники.ВидыЦен.ПустаяСсылка());
	Запрос.УстановитьПараметр("ЦенаПроизводителя", Справочники.ВидыЦен.ЦенаПроизводителя);
	// ор --
	
	Результат = Запрос.Выполнить();
	
	ОбработатьРезультатЗапросаЗаполнения(Результат, ДокументОбъект);
		
КонецПроцедуры

Процедура ОбработатьРезультатЗапросаЗаполнения(Знач Результат, ДокументОбъект)
	
	Перем Запись, СтрокаТаблицы, ТаблицаЗаполнения;
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
		
	ДеревоЗаполнения = Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПоказыватьХарактеристики = Ложь;
	
	Для каждого СтрокаНоменклатуры Из ДеревоЗаполнения.Строки Цикл
		
		Для каждого СтрокаВидаЦены Из СтрокаНоменклатуры.Строки Цикл 
		
			Для каждого СтрокаЕдиницы Из СтрокаВидаЦены.Строки Цикл
				
				Для каждого СтрокаДетали Из СтрокаЕдиницы.Строки Цикл
					
					Запись = ДокументОбъект.Запасы.Добавить();
					Запись.Номенклатура = СтрокаНоменклатуры.Номенклатура;
					Запись.ВидЦены = СтрокаВидаЦены.ВидЦены;
					Запись.Характеристика = СтрокаДетали.Характеристика;
					Запись.ЕдиницаИзмерения = СтрокаЕдиницы.ЕдиницаИзмерения;
					
					Если Запись.ВидЦены <> Неопределено
						И (Запись.ВидЦены.ТипВидаЦен = Перечисления.ТипыВидовЦен.ПроизвольныйЗапрос
						Или Запись.ВидЦены.ТипВидаЦен = Перечисления.ТипыВидовЦен.Расширение) Тогда
						
						Запись.Цена = 0;
					
					Иначе
						
						Запись.Цена = СтрокаДетали.Цена;
						
					КонецЕсли;
					
					// ор ++
					Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДетали, "ор_ДатаСогласованияЦенЖНВЛП") Тогда
						Запись.ор_ДатаСогласованияЦенЖНВЛПСтроки = СтрокаДетали.ор_ДатаСогласованияЦенЖНВЛП;
					КонецЕсли;
					// ор --
					
					Если Не ПоказыватьХарактеристики Тогда
						
						ДокументОбъект.ПоказыватьХарактеристики = ЗначениеЗаполнено(Запись.Характеристика);
						
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЦикла;
			
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры

// Процедура выполняет заполнение документа установки цен данными из структуры
//
//  Параметры:
// - ДокументОбъект                - ДокументОбъект.УстановкаЦенНоменклатуры, заполняемый документ;
// - СтруктураПараметровЗаполнения - Структура, структура, хранящая параметры заполнения;
//
Процедура ЗаполнитьДаннымиДокументУстановкиЦен(ДокументОбъект, СтруктураПараметровЗаполнения)
	
	ДокументОбъект.Дата = СтруктураПараметровЗаполнения.ДокументОснование.Дата - 1;
	
	// Реквизиты.
	ДокументОбъект.Автор             = СтруктураПараметровЗаполнения.Автор;
	ДокументОбъект.Комментарий       = СтруктураПараметровЗаполнения.Комментарий;
	ДокументОбъект.ДокументОснование = СтруктураПараметровЗаполнения.ДокументОснование;
	
	ДокументОбъект.ПоказыватьНовуюЦену       = Истина;
	ДокументОбъект.ПоказыватьОтклонениеЦен   = Истина;
	ДокументОбъект.ПоказыватьДействующуюЦену = Истина;
	ДокументОбъект.ПоказыватьЗависимыеЦены   = Истина;
	ДокументОбъект.СлужебныйНовыйФормат      = Истина;
	
	ЗаполнитьЗапасыСВидамиЦен(ДокументОбъект, СтруктураПараметровЗаполнения);
	
	// ор ++
	ДокументОбъект.ор_ДатаСогласованияЦенЖНВЛП = СтруктураПараметровЗаполнения.ор_ДатаСогласованияЦенЖНВЛП;
	// ор --
	
	МассивВидовЦен = Новый Массив;
	
	Если ДокументОбъект.Запасы.Количество() > 0 Тогда
		ТаблицаВидовЦен = ДокументОбъект.Запасы;
		МассивВидовЦен = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаВидовЦен.ВыгрузитьКолонку("ВидЦены"));
	КонецЕсли;
	
	КэшЗначений = Новый Структура;
	КэшЗначений.Вставить("ВыбранныеВидыЦен", Новый Соответствие);
	КэшЗначений.Вставить("ОтключенныеВидыЦен", Новый Массив);
	КэшЗначений.Вставить("ВидыЦенВыбраныПриЗаполнении", МассивВидовЦен.Количество() > 0 И ЗначениеЗаполнено(МассивВидовЦен[0]));
	КэшЗначений.Вставить("НовыеВидыЦен", Новый Массив);
	КэшЗначений.Вставить("ДоИзмененияНоменклатура", ПоместитьВоВременноеХранилище(Новый ТаблицаЗначений, Новый УникальныйИдентификатор));
	КэшЗначений.Вставить("ДоИзмененияХарактеристики", ПоместитьВоВременноеХранилище(Новый ТаблицаЗначений, Новый УникальныйИдентификатор));
	КэшЗначений.Вставить("МаксимальныйКлючСвязи", 0);
	КэшЗначений.Вставить("ПроизвольныйЗапрос", Перечисления.ТипыВидовЦен.ПроизвольныйЗапрос);
	КэшЗначений.Вставить("КурсыВалютДокумента", КурсыВалютДокумента(ДокументОбъект.Дата));
	КэшЗначений.Вставить("ФОУчетВалютныхОпераций", ПолучитьФункциональнуюОпцию("УчетВалютныхОпераций"));
	
	СтруктураПараметров = ЗаполнитьДеревоОперандов(КэшЗначений, МассивВидовЦен);
	
	Если ДокументОбъект.Запасы.Количество()>0 
		И КэшЗначений.ВидыЦенВыбраныПриЗаполнении Тогда
		
		ДеревоЦен = СтруктураПараметров.ДеревоРезультата;
				
		ЗаполнитьКэшЗначенийВидамиЦен(КэшЗначений, ДеревоЦен);
		
		ТЗНоменклатура = Новый ТаблицаЗначений();
		ТЗХарактеристики = Новый ТаблицаЗначений();
		
		СоздатьКопииТаблицЗначенийДляРасчетаЦен(ТЗНоменклатура, ТЗХарактеристики);
		ИзменитьСоставРеквизитовИЭлементовТабличнойЧасти(ТЗНоменклатура, КэшЗначений, "ТЧНоменклатура");
		ИзменитьСоставРеквизитовИЭлементовТабличнойЧасти(ТЗХарактеристики, КэшЗначений, "ТЧХарактеристики");
		
		Запасы = ДокументОбъект.Запасы.Выгрузить();
		ЦенообразованиеСервер.ИзменитьЦенуВТаблицеПоПорогамСрабатывания(Запасы, КэшЗначений.ВыбранныеВидыЦен, ДокументОбъект.Дата);
		ДокументОбъект.Запасы.Загрузить(Запасы);
		
		ЗаполнитьТаблицуНоменклатурыИХарактеристикПоДокументу(
			Истина,
			Ложь,
			ТЗНоменклатура,
			ТЗХарактеристики,
			ДокументОбъект,
			КэшЗначений,
			ДеревоЦен);
			
		ПоместитьВТЧЗапасы(ДокументОбъект, КэшЗначений, ТЗНоменклатура, ТЗХарактеристики);
		
	КонецЕсли;
	
КонецПроцедуры

Функция КурсыВалютДокумента(Дата)

	Возврат Документы.УстановкаЦенНоменклатуры.КурсыВалютДокумента(Дата);

КонецФункции

Функция СформироватьТаблицуЗапасовПоТабличнымЧастям(ТекущийОбъект, МассивСтрокЦен, ТЗНоменклатура, ТЗХарактеристики)
	
	Возврат Документы.УстановкаЦенНоменклатуры.СформироватьТаблицуЗапасовПоТабличнымЧастям(
		ТекущийОбъект,
		ТЗНоменклатура,
		ТЗХарактеристики,
		МассивСтрокЦен);

КонецФункции

Процедура ПоместитьВТЧЗапасы(ДокументОбъект, КэшЗначений, ТЗНоменклатура, ТЗХарактеристики)
	
	ДокументОбъект.Запасы.Очистить();
	МассивВыбранныхВидовЦен = Новый Массив; 
	
	ЗаполнитьМассивВыбранныхВидовЦен(МассивВыбранныхВидовЦен, КэшЗначений.ВыбранныеВидыЦен);
	
	ДокументОбъект.Запасы.Загрузить(
		СформироватьТаблицуЗапасовПоТабличнымЧастям(
		ДокументОбъект,
		МассивВыбранныхВидовЦен,
		ТЗНоменклатура,
		ТЗХарактеристики));
	
КонецПроцедуры

Процедура ЗаполнитьМассивВыбранныхВидовЦен(МассивВыбранныхВидовЦен, ВыбранныеВидыЦен)
	
	Для каждого СтрокаВидаЦен Из ВыбранныеВидыЦен Цикл
		
		Если МассивВыбранныхВидовЦен.Найти(СтрокаВидаЦен.Ключ) = Неопределено Тогда
			МассивВыбранныхВидовЦен.Добавить(СтрокаВидаЦен.Ключ);
		КонецЕсли;
		
		ЗаполнитьМассивВыбранныхВидовЦен(МассивВыбранныхВидовЦен, СтрокаВидаЦен.Значение); 
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТаблицуНоменклатурыИХарактеристикПоДокументу(
	ПересчитыватьЦены = Истина,
	Сортировать = Истина,
	ТЗНоменклатура,
	ТЗХарактеристики,
	ДокументОбъект,
	КэшЗначений,
	ДеревоЦен)
	
	ТЗНоменклатура.Очистить();
	ТЗХарактеристики.Очистить();
	АдресВременногоХранилища = Документы.УстановкаЦенНоменклатуры.РазобратьМассивНоменклатурыИХарактеристикПоДокументу(
								ДокументОбъект.Запасы, 
								ДокументОбъект.ПоказыватьХарактеристики, 
								ДокументОбъект.ПоказыватьНедействительныеХарактеристики);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПересчитыватьЦены", 	ПересчитыватьЦены);
	ДополнительныеПараметры.Вставить("Сортировать", 		Сортировать);
	ДополнительныеПараметры.Вставить("КэшЗначений", 		КэшЗначений);
	ДополнительныеПараметры.Вставить("ДокументОбъект", 		ДокументОбъект);
	ДополнительныеПараметры.Вставить("ДеревоЦен", 			ДеревоЦен);
	ДополнительныеПараметры.Вставить("ТЗНоменклатура", 		ТЗНоменклатура);
	ДополнительныеПараметры.Вставить("ТЗХарактеристики", 	ТЗХарактеристики);
	
	Результат = Новый Структура;
	Результат.Вставить("ВыборПроизведен", Истина);
	Результат.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	
	ОбработатьРезультатЗаполненияНаСервере(Результат, ДополнительныеПараметры);
	 	
КонецПроцедуры

Процедура ДобавитьНоменклатуру(СтруктураТаблицДанных, ДополнительныеПараметры)
	
	КэшЗначений      = ДополнительныеПараметры.КэшЗначений;
	ДокументОбъект   = ДополнительныеПараметры.ДокументОбъект;
	ДеревоЦен        = ДополнительныеПараметры.ДеревоЦен;
	
	ТЗНоменклатура   = ДополнительныеПараметры.ТЗНоменклатура;
	ТЗХарактеристики = ДополнительныеПараметры.ТЗХарактеристики;
	
	ПараметрыКопирования = Новый Структура;
	ПараметрыКопирования.Вставить("ИменаКолонокКопирования",              Неопределено);
	ПараметрыКопирования.Вставить("ИменаКолонокИсключений",               Неопределено);
	ПараметрыКопирования.Вставить("ВыбранныеВидыЦен",                     КэшЗначений.ВыбранныеВидыЦен);
	ПараметрыКопирования.Вставить("ЗаполнитьТекущиеЦены",                 Истина);
	ПараметрыКопирования.Вставить("ИмяТабличнойЧасти",                    "");
	ПараметрыКопирования.Вставить("МаксимальныйКлючСвязи",                КэшЗначений.МаксимальныйКлючСвязи);
	ПараметрыКопирования.Вставить("МаксимальныйКлючСвязиПослеДобавления", КэшЗначений.МаксимальныйКлючСвязи);
	ПараметрыКопирования.Вставить("ПоДокументу",                          Ложь);
	ПараметрыКопирования.Вставить("ТаблицаЦен",                           ?(СтруктураТаблицДанных.Свойство("ТаблицаЦен"), СтруктураТаблицДанных.ТаблицаЦен, Неопределено));
	ПараметрыКопирования.Вставить("Период",                               ДокументОбъект.Дата);
	ПараметрыКопирования.Вставить("ПараметрыВидовЦенСКД",                 ПолучитьСтруктуруПараметровВидовЦенСКД(ДеревоЦен, КэшЗначений, ДокументОбъект));
	ПараметрыКопирования.Вставить("ВключаяХарактеристики",                ДокументОбъект.УстанавливатьХарактеристикамБезЦен);
	ПараметрыКопирования.Вставить("Автор",                                ДокументОбъект.Автор);
	ПараметрыКопирования.Вставить("ПересчитыватьЦены",                    ДополнительныеПараметры.ПересчитыватьЦены);
	ПараметрыКопирования.Вставить("Сортировать",                          ДополнительныеПараметры.Сортировать);
	ПараметрыКопирования.Вставить("КурсыВалютДокумента",                  КэшЗначений.КурсыВалютДокумента);
	ПараметрыКопирования.Вставить("ФОУчетВалютныхОпераций",               КэшЗначений.ФОУчетВалютныхОпераций);
	ПараметрыКопирования.Вставить("ОтображатьНаценку",                    Ложь);
	ПараметрыКопирования.Вставить("ЭтоНовый",                             Истина);
	ПараметрыКопирования.Вставить("ЭтоАвтоформированиеЦен",               Истина);
	ПараметрыКопирования.Вставить("ЗаполнятьНаОснованиеПрихода",          Истина);
	
	// Массив накладных
	МассивНакладных = Новый Массив;
	МассивНакладных.Добавить(ДокументОбъект.ДокументОснование);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("МассивПриходныхНакладных"  , МассивНакладных);
	СтруктураПараметров.Вставить("ИспользоватьХарактеристики", ДокументОбъект.ПоказыватьХарактеристики);
	СтруктураПараметров.Вставить("МассивВидовЦен"            , ДокументОбъект.ВидыЦенЗаполнятьИзОснования());
	
	АдресВременногоХранилища = ""; 
	
	// Таблица цен по документу основания.
	Документы.УстановкаЦенНоменклатуры.ПолучитьНоменклатуруПоПриходнымНакладным(
		СтруктураПараметров, АдресВременногоХранилища);
	
	СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	Если СтруктураРезультат <> Неопределено Тогда
		
		СтруктураТаблицДанных.Вставить("ТаблицаЦен", СтруктураРезультат.ТаблицаЦен);
		ПараметрыКопирования.Вставить("ТаблицаЦен", СтруктураРезультат.ТаблицаЦен);
		
	КонецЕсли;
	
	Если СтруктураТаблицДанных.ТаблицаНоменклатуры.Количество() > 0 Тогда
		
		ПараметрыКопирования.Вставить("ДокументОснование", ДокументОбъект.ДокументОснование);
		
		ПараметрыКопирования.ИмяТабличнойЧасти = "ТЧНоменклатура";
		
		СоздатьКопиюТекущихДанных(ТЗНоменклатура.Скопировать(), КэшЗначений.ДоИзмененияНоменклатура);
		Документы.УстановкаЦенНоменклатуры.КопироватьДобавлениемСтрокТаблицЗначений(
												СтруктураТаблицДанных.ТаблицаНоменклатуры,
												ТЗНоменклатура,
												ПараметрыКопирования);
		
		Если СтруктураТаблицДанных.ТаблицаХарактеристик.Количество() > 0 Тогда
			
			ПараметрыКопирования.ИмяТабличнойЧасти = "ТЧХарактеристики";
			
			СоздатьКопиюТекущихДанных(ТЗХарактеристики.Скопировать(), КэшЗначений.ДоИзмененияХарактеристики);
			Документы.УстановкаЦенНоменклатуры.КопироватьДобавлениемСтрокТаблицЗначений(
												СтруктураТаблицДанных.ТаблицаХарактеристик,
												ТЗХарактеристики,
												ПараметрыКопирования);
			
		КонецЕсли;
		
		КэшЗначений.МаксимальныйКлючСвязи = ПараметрыКопирования.МаксимальныйКлючСвязиПослеДобавления;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьКопиюТекущихДанных(ТаблицаДанных, АдресВоВременномХранилище)
	
	ПоместитьВоВременноеХранилище(ТаблицаДанных, АдресВоВременномХранилище);
	
КонецПроцедуры

Функция ПолучитьСтруктуруПараметровВидовЦенСКД(ДеревоЦен, КэшЗначений, ДокументОбъект)
	
	ВидЦеныПроизвольныйЗапросСтрокой = НСтр("ru = 'Произвольный запрос'");
	Структура = Новый Структура;
	Для каждого СтрокаТипВидовЦен Из ДеревоЦен.Строки Цикл
		
		Для каждого СтрокаВидЦены Из СтрокаТипВидовЦен.Строки Цикл
			
			Если СтрокаВидЦены.ВидЦен.ТипВидаЦен = КэшЗначений.ПроизвольныйЗапрос
				И СтрокаВидЦены.Использование Тогда
				
				СтруктураНастройки = Новый Структура;
				СтруктураНастройки.Вставить("АдресСхемыКомпоновкиДанных",         СтрокаВидЦены.АдресСхемыКомпоновкиДанных);
				СтруктураНастройки.Вставить("АдресНастроекСхемыКомпоновкиДанных", СтрокаВидЦены.АдресНастроекСхемыКомпоновкиДанных);
				СтруктураНастройки.Вставить("ВидЦен",                             СтрокаВидЦены.ВидЦен);
				СтруктураНастройки.Вставить("СхемаКомпоновкиДанных",              ПолучитьИзВременногоХранилища(СтрокаВидЦены.АдресСхемыКомпоновкиДанных));
				СтруктураНастройки.Вставить("НастройкиСхемыКомпоновкиДанных",     ПолучитьИзВременногоХранилища(СтрокаВидЦены.АдресНастроекСхемыКомпоновкиДанных));
				
				СтруктураНастройки.Вставить("ДокументОснование",                  ДокументОбъект.ДокументОснование);
				СтруктураНастройки.Вставить("ДатаДокумента",                      ДокументОбъект.Дата);
				СтруктураНастройки.Вставить("ЭтоВводНаОсновании",                 ЗначениеЗаполнено(ДокументОбъект.ДокументОснование));
				
				Структура.Вставить(СтрокаВидЦены.ВидЦен.ИдентификаторФормул, СтруктураНастройки);
				
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЦикла;
	Возврат Структура;
	
КонецФункции

Процедура ОбработатьРезультатЗаполненияНаСервере(Результат, ДополнительныеПараметры)
		
	Если ЗначениеЗаполнено(Результат.АдресВременногоХранилища) Тогда
				
		СтруктураТаблицДанных = ПолучитьИзВременногоХранилища(Результат.АдресВременногоХранилища);
		Если ЗначениеЗаполнено(СтруктураТаблицДанных) Тогда
			ДобавитьНоменклатуру(СтруктураТаблицДанных, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменитьСоставРеквизитовИЭлементовТабличнойЧасти(ТЗ, КэшЗначений, ИмяТЗ)
	
	КэшЗначений.НовыеВидыЦен.Очистить();
	Для каждого ВыбранныйВидЦенСоответствие Из КэшЗначений.ВыбранныеВидыЦен Цикл
		ИспользоватьВидЦенВТабличнойЧасти(ТЗ, ВыбранныйВидЦенСоответствие, КэшЗначений, ИмяТЗ);
	КонецЦикла;
	
КонецПроцедуры

Процедура ИспользоватьВидЦенВТабличнойЧасти(ТЗ, ВыбранныйВидЦенСоответствие, КэшЗначений, ИмяТЗ)
	ДобавитьРеквизитыИЭлементыТабличнойЧастиПоВидуЦен(ТЗ, ВыбранныйВидЦенСоответствие, КэшЗначений, ИмяТЗ);
КонецПроцедуры

Процедура ДобавитьРеквизитыИЭлементыТабличнойЧастиПоВидуЦен(ТЗ, ВыбранныйВидЦенСоответствие, КэшЗначений, ИмяТЗ)
	
	ВыбранныйВидЦен		= ВыбранныйВидЦенСоответствие.Ключ;
	ПодчиненныеВидыЦен	= ВыбранныйВидЦенСоответствие.Значение;
	
	ИмяТабличнойЧасти	= ИмяТЗ;
	ПрефиксРеквизитов	= ИмяТабличнойЧасти + ВыбранныйВидЦен.ИдентификаторФормул;
	ТипЧислоПлюс 		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	ТипЧислоЛюбое 		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	ТипБулево			= Новый ОписаниеТипов("Булево");
	ТипВалюта			= Новый ОписаниеТипов("СправочникСсылка.Валюты");
	
	МассивТипов			= Новый	 Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.ЕдиницыИзмерения"));
	МассивТипов.Добавить(Тип("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	
	ТипЕдИзмерения		= Новый ОписаниеТипов(МассивТипов);
	
	МассивРеквизитов 	= Новый Массив; 

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИмяТабличнойЧасти",	ИмяТабличнойЧасти);
	СтруктураПараметров.Вставить("МассивРеквизитов",	МассивРеквизитов);
	СтруктураПараметров.Вставить("ПрефиксРеквизитов",	ПрефиксРеквизитов);
	СтруктураПараметров.Вставить("ТипБулево",			ТипБулево);
	СтруктураПараметров.Вставить("ТипЕдИзмерения",		ТипЕдИзмерения);
	СтруктураПараметров.Вставить("ТипЧислоЛюбое",		ТипЧислоЛюбое);
	СтруктураПараметров.Вставить("ТипЧислоПлюс",		ТипЧислоПлюс);
	СтруктураПараметров.Вставить("ТипВалюта", 			ТипВалюта);
	
	ДобавитьРеквизитыТабличнойЧастиОсновногоВидаЦенПоВидуЦен(СтруктураПараметров, ТЗ);
	
	Если ПодчиненныеВидыЦен.Количество() > 0 Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ИмяТабличнойЧасти",	ИмяТабличнойЧасти);
		СтруктураПараметров.Вставить("МассивРеквизитов",	МассивРеквизитов);
		СтруктураПараметров.Вставить("ТипЕдИзмерения",		ТипЕдИзмерения);
		СтруктураПараметров.Вставить("ТипЧислоЛюбое",		ТипЧислоЛюбое);
		СтруктураПараметров.Вставить("ТипЧислоПлюс",		ТипЧислоПлюс);
		СтруктураПараметров.Вставить("ТипБулево",			ТипБулево);
		СтруктураПараметров.Вставить("ТипВалюта", 			ТипВалюта);
		
		ДобавитьРеквизитыИЭлементыТабличнойЧастиЗависимыхВидовЦенПоВидуЦен(ПодчиненныеВидыЦен, СтруктураПараметров, ТЗ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьРеквизитыТабличнойЧастиОсновногоВидаЦенПоВидуЦен(СтруктураПараметров, ТЗ)
	
	Перем
	ИмяРеквизитаДельта,
	ИмяРеквизитаДо,
	ИмяРеквизитаЕдИзмерения,
	ИмяРеквизитаЦенаНовая,
	ИмяРеквизитаЦенуИзменили;
	
	ИмяТабличнойЧасти 	= СтруктураПараметров.ИмяТабличнойЧасти;
	МассивРеквизитов 	= СтруктураПараметров.МассивРеквизитов;
	ПрефиксРеквизитов 	= СтруктураПараметров.ПрефиксРеквизитов;
	ТипБулево 			= СтруктураПараметров.ТипБулево;
	ТипЕдИзмерения 		= СтруктураПараметров.ТипЕдИзмерения;
	ТипЧислоЛюбое 		= СтруктураПараметров.ТипЧислоЛюбое;
	ТипЧислоПлюс 		= СтруктураПараметров.ТипЧислоПлюс;
	ТипВалюта			= СтруктураПараметров.ТипВалюта;
	
	ИмяРеквизитаДо = ПрефиксРеквизитов + "_ЦенаДо";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаДо,
		ТипЧислоПлюс,
		НСтр("ru ='Цена старая'"));
		
	ИмяРеквизитаВалютаДо = ПрефиксРеквизитов + "_ВалютаДо";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаВалютаДо,
		ТипБулево,
		НСтр("ru ='Валюта до'"));
		
	ИмяРеквизитаВалютаВидимость = ПрефиксРеквизитов + "_ВалютаВидимость";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаВалютаВидимость,
		ТипВалюта,
		НСтр("ru ='Валюта видимость'"));
		
	ИмяРеквизитаВалютаНовая = ПрефиксРеквизитов + "_ВалютаНовая";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаВалютаНовая,
		ТипВалюта,
		НСтр("ru ='Валюта'"));
		
	ИмяРеквизитаВалютаДельта = ПрефиксРеквизитов + "_ВалютаДельта";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаВалютаДельта,
		ТипВалюта,
		НСтр("ru ='Валюта'"));
		
	ИмяРеквизитаДельтаКартинка = ПрефиксРеквизитов + "_ДельтаКартинка";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаДельтаКартинка,
		ТипЧислоЛюбое,
		НСтр("ru ='Дельта картинка'"));
		
	ИмяРеквизитаДельта = ПрефиксРеквизитов + "_Дельта";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаДельта,
		ТипЧислоЛюбое,
		"Δ");
		
	ИмяРеквизитаЦенаНовая = ПрефиксРеквизитов + "_ЦенаНовая";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаЦенаНовая,
		ТипЧислоПлюс,
		НСтр("ru ='Цена новая'"));
		
	ИмяРеквизитаЦенуИзменили = ПрефиксРеквизитов + "_ЦенуИзменили";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаЦенуИзменили,
		ТипБулево,
		НСтр("ru ='_Служебный'"));
		
	ИмяРеквизитаЕдИзмерения = ПрефиксРеквизитов + "_ЕдИзм";
	ТЗ.Колонки.Добавить(
		ИмяРеквизитаЕдИзмерения,
		ТипЕдИзмерения,
		НСтр("ru ='Ед. изм.'"));
		
КонецПроцедуры

Процедура ДобавитьРеквизитыИЭлементыТабличнойЧастиЗависимыхВидовЦенПоВидуЦен(Знач ПодчиненныеВидыЦен, СтруктураПараметров, ТЗ)
	
	МассивРеквизитов  = СтруктураПараметров.МассивРеквизитов;
	ИмяТабличнойЧасти = СтруктураПараметров.ИмяТабличнойЧасти;
	
	Для каждого ЗависимаяЦена Из ПодчиненныеВидыЦен Цикл
		
		ИдентификаторФормул = ЗависимаяЦена.Ключ.ИдентификаторФормул;
		
		ИмяРеквизитаЦенаДо 				= ИдентификаторФормул + "_ЦенаДо";
		ИмяРеквизитаДельта				= ИдентификаторФормул + "_Дельта";
		ИмяРеквизитаЦенаНовая			= ИдентификаторФормул + "_ЦенаНовая";
		ИмяРеквизитаЕдиницаИзмерения	= ИдентификаторФормул + "_ЕдИзм";
		ИмяРеквизитаЦенуИзменили		= ИдентификаторФормул + "_ЦенуИзменили";
		ИмяРеквизитаВалютаДо 			= ИдентификаторФормул + "_ВалютаДо";
		ИмяРеквизитаВалютаВидимость 	= ИдентификаторФормул + "_ВалютаВидимость";
		ИмяРеквизитаВалютаНовая 		= ИдентификаторФормул + "_ВалютаНовая";
		ИмяРеквизитаВалютаДельта 		= ИдентификаторФормул + "_ВалютаДельта";
		ИмяРеквизитаДельтаКартинка		= ИдентификаторФормул + "_ДельтаКартинка";
		
		МассивРеквизитов.Очистить();
		
		СтруктураПараметров.Вставить("ИмяРеквизитаДельта", ИмяРеквизитаДельта);
		СтруктураПараметров.Вставить("ИмяРеквизитаЦенаДо", ИмяРеквизитаЦенаДо);
		СтруктураПараметров.Вставить("ИмяРеквизитаЕдиницаИзмерения", ИмяРеквизитаЕдиницаИзмерения);
		СтруктураПараметров.Вставить("ИмяРеквизитаЦенаНовая", ИмяРеквизитаЦенаНовая);
		СтруктураПараметров.Вставить("ИмяРеквизитаЦенуИзменили", ИмяРеквизитаЦенуИзменили);
		СтруктураПараметров.Вставить("ИмяРеквизитаВалютаДо", ИмяРеквизитаВалютаДо);
		СтруктураПараметров.Вставить("ИмяРеквизитаВалютаВидимость", ИмяРеквизитаВалютаВидимость);
		СтруктураПараметров.Вставить("ИмяРеквизитаВалютаНовая", ИмяРеквизитаВалютаНовая);
		СтруктураПараметров.Вставить("ИмяРеквизитаВалютаДельта", ИмяРеквизитаВалютаДельта);
		СтруктураПараметров.Вставить("ИмяРеквизитаДельтаКартинка", ИмяРеквизитаДельтаКартинка);
		
		ДобавитьРеквизитыТабличнойЧастиЗависимыхВидовЦенПоВидуЦен(СтруктураПараметров, ТЗ);
		
		Если ЗависимаяЦена.Значение.Количество() > 0 Тогда
			ДобавитьРеквизитыИЭлементыТабличнойЧастиЗависимыхВидовЦенПоВидуЦен(ЗависимаяЦена.Значение, СтруктураПараметров, ТЗ);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры 

Процедура ДобавитьРеквизитыТабличнойЧастиЗависимыхВидовЦенПоВидуЦен(Знач СтруктураПараметров, ТЗ)
	
	ИмяТабличнойЧасти 				= СтруктураПараметров.ИмяТабличнойЧасти;
	МассивРеквизитов 				= СтруктураПараметров.МассивРеквизитов;
	ИмяРеквизитаДельта 				= СтруктураПараметров.ИмяРеквизитаДельта;
	ИмяРеквизитаЦенаДо 				= СтруктураПараметров.ИмяРеквизитаЦенаДо;
	ИмяРеквизитаВалютаДо 			= СтруктураПараметров.ИмяРеквизитаВалютаДо;
	ИмяРеквизитаВалютаВидимость 	= СтруктураПараметров.ИмяРеквизитаВалютаВидимость;
	ИмяРеквизитаВалютаНовая 		= СтруктураПараметров.ИмяРеквизитаВалютаНовая;
	ИмяРеквизитаВалютаДельта 		= СтруктураПараметров.ИмяРеквизитаВалютаДельта;
	ИмяРеквизитаДельтаКартинка 		= СтруктураПараметров.ИмяРеквизитаДельтаКартинка;
	
	ИмяРеквизитаЕдиницаИзмерения 	= СтруктураПараметров.ИмяРеквизитаЕдиницаИзмерения;
	ИмяРеквизитаЦенаНовая 			= СтруктураПараметров.ИмяРеквизитаЦенаНовая;
	ИмяРеквизитаЦенуИзменили 		= СтруктураПараметров.ИмяРеквизитаЦенуИзменили;
	ТипЕдИзмерения 					= СтруктураПараметров.ТипЕдИзмерения;
	ТипЧислоЛюбое 					= СтруктураПараметров.ТипЧислоЛюбое;
	ТипЧислоПлюс 					= СтруктураПараметров.ТипЧислоПлюс;
	ТипБулево 						= СтруктураПараметров.ТипБулево;
	ТипВалюта 						= СтруктураПараметров.ТипВалюта;
	
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаЦенаДо, 			ТипЧислоПлюс, 	НСтр("ru ='Цена старая'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаВалютаДо, 			ТипВалюта, 		НСтр("ru ='Валюта до'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаВалютаВидимость, 	ТипБулево, 		НСтр("ru ='Валюта видимость'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаВалютаНовая, 		ТипВалюта, 		НСтр("ru ='Валюта'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаВалютаДельта, 		ТипВалюта, 		НСтр("ru ='Валюта'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаДельтаКартинка, 	ТипЧислоЛюбое, 	НСтр("ru ='Картинка'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаДельта, 			ТипЧислоЛюбое, 	"Δ");
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаЦенаНовая, 			ТипЧислоПлюс, 	НСтр("ru ='Цена новая'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаЦенуИзменили,		ТипБулево, 		НСтр("ru ='_Служебный'"));
	ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяТабличнойЧасти + ИмяРеквизитаЕдиницаИзмерения, 	ТипЕдИзмерения, НСтр("ru ='Ед. изм.'"));
	
КонецПроцедуры

Процедура ДобавитьКолонкуВТаблицуЗначений(ТЗ, ИмяКолонки, Тип, Заголовок)
	
	Если ТЗ.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ТЗ.Колонки.Добавить(ИмяКолонки, Тип, Заголовок);
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьКопииТаблицЗначенийДляРасчетаЦен(ТЗНоменклатура, ТЗХарактеристики)
	
	#Область ТЗНоменклатура
		СоздатьОбщиеРеквизитыТаблицЗначений(ТЗНоменклатура);
	#КонецОбласти
	
	#Область ТЗХарактеристики
		СоздатьОбщиеРеквизитыТаблицЗначений(ТЗХарактеристики);
		
		ТЗХарактеристики.Колонки.Добавить(
			"Характеристика",
			Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	#КонецОбласти
	
КонецПроцедуры

Процедура СоздатьОбщиеРеквизитыТаблицЗначений(ТЗ)
	
	ТЗ.Колонки.Добавить(
		"Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));


#Область ПрограммныйИнтерфейс

// Процедура выполняет формирование нового документа установки цен на основании документа поступления товаров. 
// Если документ установки цен был создан ранее, то выполняется его переформирование
//
// Параметры:
//  ПриходнаяНакладная	 - ДокументСсылка.ПриходнаяНакладная - документ-основание для установки цен;
//
Процедура СформироватьДокументУстановкиЦенНаОснованииПриходной(ПриходнаяНакладная) Экспорт
	
	Если Не НужноФормироватьДокументУстановкиЦен(ПриходнаяНакладная.Запасы) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Поиск документов, созданных на основании.
	// Выбираем все документы, даже помеченные на удаление.
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УстановкаЦенНоменклатуры.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	УстановкаЦенНоменклатуры.ДокументОснование = &ПриходнаяНакладная
	|	И УстановкаЦенНоменклатуры.Дата = &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	УстановкаЦенНоменклатуры.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ПриходнаяНакладная", ПриходнаяНакладная);
	Запрос.УстановитьПараметр("Дата", ПриходнаяНакладная.Дата - 1);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДокументУстановкаЦенСсылка = Неопределено;
	Если Выборка.Количество() > 0 Тогда
		Выборка.Следующий();
		ДокументУстановкаЦенСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУстановкаЦенСсылка) Тогда
		ДокументУстановкаЦенОбъект = ДокументУстановкаЦенСсылка.ПолучитьОбъект();
		ДокументУстановкаЦенОбъект.ПометкаУдаления = Ложь;
	Иначе
		ДокументУстановкаЦенОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	КонецЕсли;
	
	СтруктураПараметровЗаполнения = Новый Структура;
	СформироватьСтруктуруПараметровЗаполненияДокументаУстановкиЦен(
				СтруктураПараметровЗаполнения,
				ПриходнаяНакладная,
				ДокументУстановкаЦенСсылка);

	ЗаполнитьДаннымиДокументУстановкиЦен(ДокументУстановкаЦенОбъект, СтруктураПараметровЗаполнения);
	ДокументУстановкаЦенОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Функция - Проверка цен ЖНВЛС в документе
//
// Параметры:
//  СсылкаДокумент	 - ДокументСсылка - ссылка на документ, для которого осуществляется проверка цен.
// 
// Возвращаемое значение:
//  Булево - Признак проверки. Истина - проверка не пройдена, иначе ложь.
//
Функция ПроверитьЦеныЖНВЛС(СсылкаДокумент) Экспорт
	
	КонтролироватьЖНВЛС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеНастройки("ор_КонтролироватьЦеныПроизводителяНаЖНВЛС");
	Если НЕ КонтролироватьЖНВЛС Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипОбъекта = ТипЗнч(СсылкаДокумент);
	Если ТипОбъекта = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		ВнешнийИсточник = СсылкаДокумент.ПолучитьОбъект().Запасы;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВнешнийИсточник.НомерСтроки КАК НомерСтроки,
	|	ВнешнийИсточник.Номенклатура КАК Ссылка,
	|	ВнешнийИсточник.Характеристика КАК Серия,
	|	ВнешнийИсточник.ор_ЦенаПроизводителя КАК Цена,
	|	ВнешнийИсточник.ор_ДатаСогласованияЦенЖНВЛПСтроки КАК ДатаСогласованияЦенСтроки
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&ТЧДокумента КАК ВнешнийИсточник
	|ГДЕ
	|	НЕ ВнешнийИсточник.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыИПроизводители.НомерСтроки КАК НомерСтроки,
	|	ТоварыИПроизводители.Ссылка КАК Номенклатура,
	|	ТоварыИПроизводители.Производитель КАК Производитель,
	|	ТоварыИПроизводители.Цена,
	|	ТоварыИПроизводители.ДатаСогласованияЦенСтроки КАК ДатаСогласованияЦенСтроки,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК ЦенаРуб,
	|	ЕСТЬNULL(Цены.ДатаРегистрацииЦены, ДАТАВРЕМЯ(1,1,1)) КАК ДатаРегистрацииЦены,
	|	ВЫБОР
	|		КОГДА Цены.Действует
	|			ТОГДА 1
	|		КОГДА НЕ Цены.Действует
	|			ТОГДА 0
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК Действует,
	|	ЕСТЬNULL(Цены.Производитель, ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка)) КАК ПроизводительИзРеестра
	|ИЗ
	|	(ВЫБРАТЬ
	|		Товары.НомерСтроки КАК НомерСтроки,
	|		Товары.Ссылка КАК Ссылка,
	|		Товары.Цена КАК Цена,
	|		ВЫБОР
	|			КОГДА Серии.ор_Производитель ЕСТЬ NULL 
	|					ИЛИ Серии.ор_Производитель = ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка)
	|				ТОГДА Номенклатура.ор_Производитель
	|			ИНАЧЕ Серии.ор_Производитель
	|		КОНЕЦ КАК Производитель,
	|		Товары.ДатаСогласованияЦенСтроки КАК ДатаСогласованияЦенСтроки
	|	ИЗ
	|		Товары КАК Товары
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|			ПО Товары.Ссылка = Номенклатура.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК Серии
	|			ПО Товары.Серия = Серии.Ссылка
	|	ГДЕ
	|		Номенклатура.ор_ЖНВЛС) КАК ТоварыИПроизводители
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ор_РеестрЦенПроизводителейНаЖНВЛП КАК Цены
	|		ПО (ТоварыИПроизводители.Ссылка = Цены.Номенклатура
	|					И ТоварыИПроизводители.Производитель = Цены.Производитель
	|				ИЛИ ТоварыИПроизводители.Ссылка = Цены.Номенклатура
	|					И ЕСТЬNULL(Цены.Производитель, ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	Действует УБЫВ
	|ИТОГИ
	|	СУММА(ЦенаРуб) / КОЛИЧЕСТВО(ЦенаРуб) КАК ЦенаРуб,
	|	СУММА(Действует) / КОЛИЧЕСТВО(Действует) КАК Действует
	|ПО
	|	НомерСтроки");
	Запрос.УстановитьПараметр("ТЧДокумента", ВнешнийИсточник);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстСообщения = "";
	
	ТаблицаПоЦенам = Новый ТаблицаЗначений;
	ТаблицаПоЦенам.Колонки.Добавить("НомерСтроки");
	ТаблицаПоЦенам.Колонки.Добавить("Номенклатура");
	ТаблицаПоЦенам.Колонки.Добавить("Производитель");
	ТаблицаПоЦенам.Колонки.Добавить("Цена");
	ТаблицаПоЦенам.Колонки.Добавить("ЦенаРуб");
	ТаблицаПоЦенам.Колонки.Добавить("ДатаРегистрацииЦены");
	ТаблицаПоЦенам.Колонки.Добавить("Действует");
	ТаблицаПоЦенам.Колонки.Добавить("ПроизводительИзРеестра");
	
	ВыборкаЖНВЛС = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЖНВЛС.Следующий() Цикл
		
		Выборка = ВыборкаЖНВЛС.Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДатаСогласованияЦенСтроки) Тогда
			ДатаСогласованияЦен = Выборка.ДатаСогласованияЦенСтроки;
		Иначе
			ДатаСогласованияЦен = СсылкаДокумент.ор_ДатаСогласованияЦенЖНВЛП;
		КонецЕсли;
		
		Выборка.Сбросить();
		
		ТаблицаПоЦенам.Очистить();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаПоЦенам.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
		ТаблицаПоЦенам.Сортировать("ЦенаРуб Возр");
		
		// Сначала ищем цену по такому же производителю.
		НоменклатураСтроки = ТаблицаПоЦенам[0].Номенклатура;
		ПроизводительНоменклатуры = ТаблицаПоЦенам[0].Производитель;
		
		МассивНужныхСтрок = ТаблицаПоЦенам.НайтиСтроки(Новый Структура("ПроизводительИзРеестра", ПроизводительНоменклатуры));
		
		Если ЗначениеЗаполнено(ДатаСогласованияЦен) Тогда
			// Необходимо удалить строки с датой регистрации цен меньшей, чем дата согласования.
			СкорректироватьМассивСУчетомДатыСогласованияЦен(МассивНужныхСтрок, ДатаСогласованияЦен);
		КонецЕсли;
		
		Если МассивНужныхСтрок.Количество() = 0 Тогда
			// Поищем по пустому производителю.
			МассивНужныхСтрок = ТаблицаПоЦенам.НайтиСтроки(Новый Структура("ПроизводительИзРеестра", Справочники.ор_Производители.ПустаяСсылка()));
			
			Если ЗначениеЗаполнено(ДатаСогласованияЦен) Тогда
				// Необходимо удалить строки с датой регистрации цен меньшей, чем дата согласования.
				СкорректироватьМассивСУчетомДатыСогласованияЦен(МассивНужныхСтрок, ДатаСогласованияЦен);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаСогласованияЦен) И МассивНужныхСтрок.Количество() = 0 Тогда
			// Для этого ЖНВЛС не нашли цену, будем ругаться.
			
			Если НЕ ЗначениеЗаполнено(ПроизводительНоменклатуры) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 - не удалось определить производителя для определения цены в реестре ЖНВЛП.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					НоменклатураСтроки);
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - не удалось определить цену в реестре ЖНВЛП.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					НоменклатураСтроки,
					ПроизводительНоменклатуры);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		СуммаПараметровДействует = 0;
		СуммаЦен = 0;
		Для Каждого ЭлементМассива Из МассивНужныхСтрок Цикл
			СуммаПараметровДействует = СуммаПараметровДействует + ЭлементМассива.Действует;
			СуммаЦен = СуммаЦен + ЭлементМассива.ЦенаРуб;
		КонецЦикла;
		ЦенаДействует = СуммаПараметровДействует / МассивНужныхСтрок.Количество();
		ЦенаРубВРегистре = СуммаЦен / МассивНужныхСтрок.Количество();
		
		Если ЦенаДействует = -1 Тогда
			// Для этого ЖНВЛС не нашли цену, будем ругаться.
			Если НЕ ЗначениеЗаполнено(МассивНужныхСтрок[0].Производитель) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 - не удалось определить производителя для определения цены в реестре ЖНВЛП.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					МассивНужныхСтрок[0].Номенклатура);
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - не удалось определить цену в реестре ЖНВЛП.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					МассивНужныхСтрок[0].Номенклатура,
					МассивНужныхСтрок[0].Производитель);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Если МассивНужныхСтрок[0].ЦенаРуб = 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - не указана цена производителя.'"),
				ТекстСообщения,
				Символы.ПС,
				ВыборкаЖНВЛС.НомерСтроки,
				МассивНужныхСтрок[0].Номенклатура,
				МассивНужныхСтрок[0].Производитель);
			Продолжить;
		КонецЕсли;
		
		Если ЦенаДействует = 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - найдена недействующая цена в реестре ЖНВЛП.'"),
				ТекстСообщения,
				Символы.ПС,
				ВыборкаЖНВЛС.НомерСтроки,
				МассивНужныхСтрок[0].Номенклатура,
				МассивНужныхСтрок[0].Производитель);
			Продолжить;
		КонецЕсли;
		
		НайденнаяПоДатеСтрока = Неопределено;
		Если ЦенаДействует = 1 И МассивНужныхСтрок.Количество() > 1 Тогда
			
			Если ЗначениеЗаполнено(ДатаСогласованияЦен) Тогда
				
				БлижайшаяДатаРегистрации = Неопределено;
				НайденоНесколькоСтрок = Ложь;
				Для Каждого ТекСтрока Из МассивНужныхСтрок Цикл
					Если БлижайшаяДатаРегистрации = Неопределено Тогда
						БлижайшаяДатаРегистрации = ТекСтрока.ДатаРегистрацииЦены;
						НайденнаяПоДатеСтрока = ТекСтрока;
					ИначеЕсли БлижайшаяДатаРегистрации = ТекСтрока.ДатаРегистрацииЦены Тогда
						НайденоНесколькоСтрок = Истина;
					ИначеЕсли ТекСтрока.ДатаРегистрацииЦены > БлижайшаяДатаРегистрации Тогда
						БлижайшаяДатаРегистрации = ТекСтрока.ДатаРегистрацииЦены;
						НайденнаяПоДатеСтрока = ТекСтрока;
						НайденоНесколькоСтрок = Ложь;
					КонецЕсли;
				КонецЦикла;
				
				Если НайденоНесколькоСтрок Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - найдено несколько действующий цен в реестре ЖНВЛП.'"),
						ТекстСообщения,
						Символы.ПС,
						ВыборкаЖНВЛС.НомерСтроки,
						МассивНужныхСтрок[0].Номенклатура,
						МассивНужныхСтрок[0].Производитель);
					Продолжить;
				КонецЕсли;
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - найдено несколько действующий цен в реестре ЖНВЛП.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					МассивНужныхСтрок[0].Номенклатура,
					МассивНужныхСтрок[0].Производитель);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ НайденнаяПоДатеСтрока = Неопределено Тогда
			
			Цена = НайденнаяПоДатеСтрока.Цена;
			Если Цена > НайденнаяПоДатеСтрока.ЦенаРуб Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - цена %6 превышает установленную %7.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					НайденнаяПоДатеСтрока.Номенклатура,
					НайденнаяПоДатеСтрока.Производитель,
					Цена,
					НайденнаяПоДатеСтрока.ЦенаРуб);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		МассивДействующихЦен = Новый Массив;
		
		Если ЦенаДействует > 0 Тогда
			
			ДействующаяЦенаРубВРегистре = 0;
			Для Каждого ЭлементМассива Из МассивНужныхСтрок Цикл
				Если ЭлементМассива.Действует = 1 Тогда
					МассивДействующихЦен.Добавить(ЭлементМассива);
					ДействующаяЦенаРубВРегистре = ДействующаяЦенаРубВРегистре + ЭлементМассива.ЦенаРуб;
				КонецЕсли;
			КонецЦикла;
			
			Если МассивДействующихЦен.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДействующаяЦенаРубВРегистре = ДействующаяЦенаРубВРегистре / МассивДействующихЦен.Количество();
			
			Если НЕ ДействующаяЦенаРубВРегистре = МассивДействующихЦен[0].ЦенаРуб Тогда
				
				Если ЗначениеЗаполнено(ДатаСогласованияЦен) Тогда
					БлижайшаяДатаРегистрации = Неопределено;
					НайденоНесколькоСтрок = Ложь;
					Для Каждого ТекСтрока Из МассивДействующихЦен Цикл
						Если БлижайшаяДатаРегистрации = Неопределено Тогда
							БлижайшаяДатаРегистрации = ТекСтрока.ДатаРегистрацииЦены;
							НайденнаяПоДатеСтрока = ТекСтрока;
						ИначеЕсли БлижайшаяДатаРегистрации = ТекСтрока.ДатаРегистрацииЦены Тогда
							НайденоНесколькоСтрок = Истина;
						ИначеЕсли ТекСтрока.ДатаРегистрацииЦены > БлижайшаяДатаРегистрации Тогда
							БлижайшаяДатаРегистрации = ТекСтрока.ДатаРегистрацииЦены;
							НайденнаяПоДатеСтрока = ТекСтрока;
							НайденоНесколькоСтрок = Ложь;
						КонецЕсли;
					КонецЦикла;
					
					Если НайденоНесколькоСтрок Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - найдено несколько действующий цен в реестре ЖНВЛП.'"),
							ТекстСообщения,
							Символы.ПС,
							ВыборкаЖНВЛС.НомерСтроки,
							МассивДействующихЦен[0].Номенклатура,
							МассивДействующихЦен[0].Производитель);
						Продолжить;
					КонецЕсли;
				Иначе
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - найдено несколько действующий цен в реестре ЖНВЛП.'"),
						ТекстСообщения,
						Символы.ПС,
						ВыборкаЖНВЛС.НомерСтроки,
						МассивДействующихЦен[0].Номенклатура,
						МассивДействующихЦен[0].Производитель);
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ НайденнаяПоДатеСтрока = Неопределено Тогда
			
			Цена = НайденнаяПоДатеСтрока.Цена;
			
			Если Цена > НайденнаяПоДатеСтрока.ЦенаРуб Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - цена %6 превышает установленную %7.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					НайденнаяПоДатеСтрока.Номенклатура,
					НайденнаяПоДатеСтрока.Производитель,
					Цена,
					НайденнаяПоДатеСтрока.ЦенаРуб);
				Продолжить;
			КонецЕсли;
			
		Иначе
			
			Цена = МассивДействующихЦен[0].Цена;
			Если Цена > МассивДействующихЦен[0].ЦенаРуб Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2Строка %3 Номенклатура: %4 Производитель: %5 - цена %6 превышает установленную %7.'"),
					ТекстСообщения,
					Символы.ПС,
					ВыборкаЖНВЛС.НомерСтроки,
					МассивДействующихЦен[0].Номенклатура,
					МассивДействующихЦен[0].Производитель,
					Цена,
					МассивДействующихЦен[0].ЦенаРуб);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТекстСообщения = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'При проверке цен на ЖНВЛП обнаружены ошибки:'") + ТекстСообщения);
	
	Возврат Истина;
	
КонецФункции

// Скорректировать массив с учетом даты согласования цен.
//
// Параметры:
//  МассивНужныхСтрок	 - Массив	 - массив строк цен реестра производителей на ЖНВЛП.
//  ДатаСогласованияЦен	 - Дата	 - дата согласования цен ЖНВЛС.
//
Процедура СкорректироватьМассивСУчетомДатыСогласованияЦен(МассивНужныхСтрок, ДатаСогласованияЦен) Экспорт
	
	ТекущийИндекс = МассивНужныхСтрок.Количество()- 1;
	Пока ТекущийИндекс >=0 Цикл
		Если МассивНужныхСтрок[ТекущийИндекс].ДатаРегистрацииЦены > ДатаСогласованияЦен Тогда 
			МассивНужныхСтрок.Удалить(ТекущийИндекс);
		КонецЕсли;
		
		ТекущийИндекс = ТекущийИндекс - 1;
	КонецЦикла;
	
КонецПроцедуры

// Поиск цены в реестре цен производителя.
//
// Параметры:
//  ТаблицаРеестровыхЦен	 - ТаблицаЗначений	 - записи реестра цен производителя.
//  НоменклатураДокумента	 - СправочникСсылка.Номенклатура	 - номенклатура для которой происходит поиск.
//  ДатаСогласованияЦенЖНВЛП - Дата	 - дата согласования.
// 
// Возвращаемое значение:
//   - СтрокаТаблицыЗначений, Неопределено - найденная строка реестра.
//
Функция ПолучитьЦенуРеестра(ТаблицаРеестровыхЦен, НоменклатураДокумента, ДатаСогласованияЦенЖНВЛП) Экспорт
	
	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("Номенклатура", НоменклатураДокумента);
	ПараметрыОтбора.Вставить("Действует", 1);
	ПараметрыОтбора.Вставить("ПроизводительИзРеестра", НоменклатураДокумента.ор_Производитель);
	
	МассивИменСвойствОтборов = Новый Массив;
	МассивИменСвойствОтборов.Добавить("Номенклатура,Действует,ПроизводительИзРеестра");
	// Если с производителем действующую цену не нашли, попробуем без производителя поискать.
	МассивИменСвойствОтборов.Добавить("Номенклатура,Действует");
	// Попробуем найти хоть что-то с указанным производителем.
	МассивИменСвойствОтборов.Добавить("Номенклатура,ПроизводительИзРеестра");
	// Попробуем найти хоть что-то с указанной номенклатурой.
	МассивИменСвойствОтборов.Добавить("Номенклатура");
	
	Для Каждого ТекущиеИменаСвойствОтобора Из МассивИменСвойствОтборов Цикл
		
		ТекущиеОтборы = Новый Структура(ТекущиеИменаСвойствОтобора);
		ЗаполнитьЗначенияСвойств(ТекущиеОтборы, ПараметрыОтбора);
		
		МассивНайденныхСтрок = ТаблицаРеестровыхЦен.НайтиСтроки(ПараметрыОтбора);
	
		Если МассивНайденныхСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаСогласованияЦенЖНВЛП) Тогда
			
			СкорректироватьМассивСУчетомДатыСогласованияЦен(МассивНайденныхСтрок, ДатаСогласованияЦенЖНВЛП);
			Если МассивНайденныхСтрок.Количество() > 0 Тогда
				НайденнаяСтрока = ПолучитьСтрокуСМаксимальнойДатойРегистрацииЦены(МассивНайденныхСтрок);
				Возврат НайденнаяСтрока;
			КонецЕсли;
			
		Иначе
			Возврат МассивНайденныхСтрок[0];
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Заполнение печатной формы протокола согласования цен 2019.
//
// Параметры:
//  МассивОбъектов	 - Массив	 - массив документов для печати.
//  ОбъектыПечати - СписокЗначений - выходной параметр, соответствие между объектами и именами областей в табличных
//                                   документах, заполняется автоматически
//                                   при вызове УправлениеПечатью.ЗадатьОбластьПечатиДокумента:
//   * Значение - ЛюбаяСсылка - ссылка из коллекции МассивОбъектов,
//   * Представление - Строка - имя области с объектом в табличных документах;
//  Макет			 - ТабличныйДокумент	 - печатная форма протокола согласования цен.
//  ПараметрыПечати	 - Структура	 - дополнительные параметры печати.
// 
// Возвращаемое значение:
//   - ТабличныйДокумент.
//
Функция ПечатьПротоколСогласованияЦен2019(МассивОбъектов, ОбъектыПечати, Макет, ПараметрыПечати = Неопределено) Экспорт
	
	РозничныйТипЦен = Неопределено;
	Если ПараметрыПечати <> Неопределено Тогда
		РозничныйТипЦен = ПараметрыПечати.ВидЦен;
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ор_ПротоколСогласованияЦен2019";
	
	ТабличныйДокумент.ПолеСлева = 5;
	ТабличныйДокумент.ПолеСправа = 6;
	ТабличныйДокумент.РазмерКолонтитулаСверху = 0;
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 0;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	// Получим вспомогательные данные для формирования табличного документа
	ФорматВыводаСуммы = "ЧЦ=15; ЧДЦ=2";
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДокументОбъект Из МассивОбъектов Цикл
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры") Тогда
			
			Если ДокументОбъект.ДокументОснование = Неопределено
				ИЛИ ТипЗнч(ДокументОбъект.ДокументОснование) <> Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
				Продолжить;
			КонецЕсли;
			СсылкаНаПоступление = ДокументОбъект.ДокументОснование;
			
		Иначе
			СсылкаНаПоступление = ДокументОбъект;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходнаяНакладнаяЗапасы.Номенклатура КАК Номенклатура,
		|	ПриходнаяНакладнаяЗапасы.Характеристика КАК Характеристика,
		|	МАКСИМУМ(ЕСТЬNULL(ор_РеестрЦенПроизводителейНаЖНВЛП.ДатаРегистрацииЦены, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаРегистрацииЦены
		|ПОМЕСТИТЬ РеестрЦен
		|ИЗ
		|	Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ор_РеестрЦенПроизводителейНаЖНВЛП КАК ор_РеестрЦенПроизводителейНаЖНВЛП
		|		ПО ПриходнаяНакладнаяЗапасы.Номенклатура = ор_РеестрЦенПроизводителейНаЖНВЛП.Номенклатура
		|ГДЕ
		|	ПриходнаяНакладнаяЗапасы.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА ПриходнаяНакладнаяЗапасы.ор_ДатаСогласованияЦенЖНВЛПСтроки = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ор_РеестрЦенПроизводителейНаЖНВЛП.ДатаРегистрацииЦены <= &ДатаСогласованияЦен
		|			ИНАЧЕ ор_РеестрЦенПроизводителейНаЖНВЛП.ДатаРегистрацииЦены <= ПриходнаяНакладнаяЗапасы.ор_ДатаСогласованияЦенЖНВЛПСтроки
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ПриходнаяНакладнаяЗапасы.Номенклатура,
		|	ПриходнаяНакладнаяЗапасы.Характеристика
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриходнаяНакладнаяЗапасы.Номенклатура КАК Номенклатура,
		|	ПриходнаяНакладнаяЗапасы.Номенклатура.ор_МНН КАК МНН,
		|	ПриходнаяНакладнаяЗапасы.Цена КАК ЦенаИзДокумента,
		|	ВЫБОР
		|		КОГДА ПриходнаяНакладнаяЗапасы.Ссылка.СуммаВключаетНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.Цена * 100 / (СтавкиНДС.Ставка + 100) КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.Цена
		|	КОНЕЦ КАК ЦенаБезНДС,
		|	ВЫБОР
		|		КОГДА НЕ ПриходнаяНакладнаяЗапасы.Ссылка.СуммаВключаетНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.Цена * (СтавкиНДС.Ставка + 100) / 100 КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.Цена
		|	КОНЕЦ КАК ЦенаСНДС,
		|	ПриходнаяНакладнаяЗапасы.Характеристика КАК Характеристика,
		|	ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя КАК ЦенаПроизводителяИзДокумента,
		|	ВЫБОР
		|		КОГДА &ЦенаПроизводителяСНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя * 100 / (СтавкиНДС.Ставка + 100) КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя
		|	КОНЕЦ КАК ЦенаПроизводителяБезНДС,
		|	ВЫБОР
		|		КОГДА НЕ &ЦенаПроизводителяСНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя * (СтавкиНДС.Ставка + 100) / 100 КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя
		|	КОНЕЦ КАК ЦенаПроизводителяСНДС,
		|	ПриходнаяНакладнаяЗапасы.ор_ДатаРеализации КАК ДатаРеализации,
		|	ПриходнаяНакладнаяЗапасы.ор_ЗакупкаУПроизводителя КАК ЗакупкаУПроизводителя,
		|	ПриходнаяНакладнаяЗапасы.КлючСвязи КАК КлючСвязи,
		|	ПриходнаяНакладнаяЗапасы.НомерСтроки КАК НомерСтроки,
		|	МАКСИМУМ(ЕСТЬNULL(РеестрЦенНаЖНВЛС.ДатаРегистрацииЦены, 0)) КАК ДатаРегистрацииЦены,
		|	ЕСТЬNULL(ор_РеестрЦенПроизводителейНаЖНВЛП.Цена, 0) КАК ЦенаЖНВЛП,
		|	ПриходнаяНакладнаяЗапасы.СтавкаНДС КАК СтавкаНДС
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РеестрЦен КАК РеестрЦенНаЖНВЛС
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ор_РеестрЦенПроизводителейНаЖНВЛП КАК ор_РеестрЦенПроизводителейНаЖНВЛП
		|			ПО (ор_РеестрЦенПроизводителейНаЖНВЛП.Номенклатура = РеестрЦенНаЖНВЛС.Номенклатура)
		|				И (ор_РеестрЦенПроизводителейНаЖНВЛП.ДатаРегистрацииЦены = РеестрЦенНаЖНВЛС.ДатаРегистрацииЦены)
		|		ПО ПриходнаяНакладнаяЗапасы.Номенклатура = РеестрЦенНаЖНВЛС.Номенклатура
		|			И ПриходнаяНакладнаяЗапасы.Характеристика = РеестрЦенНаЖНВЛС.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС
		|		ПО ПриходнаяНакладнаяЗапасы.СтавкаНДС = СтавкиНДС.Ссылка
		|ГДЕ
		|	ПриходнаяНакладнаяЗапасы.Ссылка = &Ссылка
		|	И ПриходнаяНакладнаяЗапасы.Номенклатура.ор_ЖНВЛС = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	ПриходнаяНакладнаяЗапасы.Номенклатура,
		|	ПриходнаяНакладнаяЗапасы.Номенклатура.ор_МНН,
		|	ВЫБОР
		|		КОГДА ПриходнаяНакладнаяЗапасы.Ссылка.СуммаВключаетНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.Цена * 100 / (СтавкиНДС.Ставка + 100) КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.Цена
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА НЕ ПриходнаяНакладнаяЗапасы.Ссылка.СуммаВключаетНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.Цена * (СтавкиНДС.Ставка + 100) / 100 КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.Цена
		|	КОНЕЦ,
		|	ПриходнаяНакладнаяЗапасы.Характеристика,
		|	ПриходнаяНакладнаяЗапасы.КлючСвязи,
		|	ПриходнаяНакладнаяЗапасы.НомерСтроки,
		|	ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя,
		|	ВЫБОР
		|		КОГДА &ЦенаПроизводителяСНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя * 100 / (СтавкиНДС.Ставка + 100) КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА НЕ &ЦенаПроизводителяСНДС
		|				И НЕ СтавкиНДС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫРАЗИТЬ(ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя * (СтавкиНДС.Ставка + 100) / 100 КАК ЧИСЛО(15, 2))
		|		ИНАЧЕ ПриходнаяНакладнаяЗапасы.ор_ЦенаПроизводителя
		|	КОНЕЦ,
		|	ПриходнаяНакладнаяЗапасы.ор_ДатаРеализации,
		|	ПриходнаяНакладнаяЗапасы.ор_ЗакупкаУПроизводителя,
		|	ЕСТЬNULL(ор_РеестрЦенПроизводителейНаЖНВЛП.Цена, 0),
		|	ПриходнаяНакладнаяЗапасы.СтавкаНДС,
		|	ПриходнаяНакладнаяЗапасы.Цена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриходнаяНакладнаяОптовыеЗвенья.КлючСвязи КАК КлючСвязи,
		|	ПриходнаяНакладнаяОптовыеЗвенья.ПорядокЗвена КАК ПорядокЗвена,
		|	ПриходнаяНакладнаяОптовыеЗвенья.Цена КАК ЦенаБезНДС,
		|	ПриходнаяНакладнаяОптовыеЗвенья.ПроцентНаценки КАК ПроцентНаценки,
		|	ПриходнаяНакладнаяОптовыеЗвенья.СуммаНаценки КАК СуммаНаценки,
		|	ПриходнаяНакладнаяОптовыеЗвенья.Поставщик КАК Поставщик,
		|	ПриходнаяНакладнаяОптовыеЗвенья.УСНЕНВД КАК УСНЕНВД,
		|	ПриходнаяНакладнаяОптовыеЗвенья.ЦенаСНДС КАК ЦенаСНДС
		|ПОМЕСТИТЬ ОптовыеЗвенья
		|ИЗ
		|	Документ.ПриходнаяНакладная.ОптовыеЗвенья КАК ПриходнаяНакладнаяОптовыеЗвенья
		|ГДЕ
		|	ПриходнаяНакладнаяОптовыеЗвенья.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.МНН КАК МНН,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.ЦенаИзДокумента КАК ЦенаИзДокумента,
		|	Товары.ЦенаБезНДС КАК ЦенаБезНДС,
		|	Товары.ЦенаСНДС КАК ЦенаСНДС,
		|	ВЫБОР
		|		КОГДА Товары.Характеристика.ор_Производитель = ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка)
		|			ТОГДА Товары.Номенклатура.ор_Производитель
		|		ИНАЧЕ Товары.Характеристика.ор_Производитель
		|	КОНЕЦ КАК Производитель,
		|	Товары.ЦенаПроизводителяИзДокумента КАК ЦенаПроизводителяИзДокумента,
		|	Товары.ЦенаПроизводителяБезНДС КАК ЦенаПроизводителяБезНДС,
		|	Товары.ЦенаПроизводителяСНДС КАК ЦенаПроизводителяСНДС,
		|	Товары.ДатаРеализации КАК ДатаРеализации,
		|	Товары.ЗакупкаУПроизводителя КАК ЗакупкаУПроизводителя,
		|	ОптовыеЗвенья.ПорядокЗвена КАК ПорядокЗвена,
		|	ЕСТЬNULL(ОптовыеЗвенья.ЦенаБезНДС, 0) КАК ЦенаПоставщикаБезНДС,
		|	ЕСТЬNULL(ОптовыеЗвенья.ПроцентНаценки, 0) КАК ПроцентНаценки,
		|	ЕСТЬNULL(ОптовыеЗвенья.СуммаНаценки, 0) КАК СуммаНаценки,
		|	ЕСТЬNULL(ОптовыеЗвенья.Поставщик, 0) КАК Поставщик,
		|	ЕСТЬNULL(ОптовыеЗвенья.КлючСвязи, 0) КАК КлючСвязи,
		|	ЕСТЬNULL(ОптовыеЗвенья.УСНЕНВД, ЛОЖЬ) КАК УСНЕНВД,
		|	ЕСТЬNULL(ОптовыеЗвенья.ЦенаСНДС, 0) КАК ЦенаПоставщикаСНДС,
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.ДатаРегистрацииЦены КАК ДатаРегистрацииЦены,
		|	Товары.ЦенаЖНВЛП КАК ЦенаЖНВЛП,
		|	Товары.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОптовыеЗвенья КАК ОптовыеЗвенья
		|		ПО Товары.КлючСвязи = ОптовыеЗвенья.КлючСвязи
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|ИТОГИ
		|	МАКСИМУМ(Номенклатура),
		|	МАКСИМУМ(МНН),
		|	МАКСИМУМ(Характеристика),
		|	МАКСИМУМ(ЦенаИзДокумента),
		|	МАКСИМУМ(ЦенаБезНДС),
		|	МАКСИМУМ(ЦенаСНДС),
		|	МАКСИМУМ(Производитель),
		|	МАКСИМУМ(ЦенаПроизводителяИзДокумента),
		|	МАКСИМУМ(ЦенаПроизводителяБезНДС),
		|	МАКСИМУМ(ЦенаПроизводителяСНДС),
		|	МАКСИМУМ(ДатаРеализации),
		|	МАКСИМУМ(ЗакупкаУПроизводителя),
		|	МАКСИМУМ(КлючСвязи),
		|	МАКСИМУМ(ЦенаЖНВЛП),
		|	МАКСИМУМ(СтавкаНДС)
		|ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("ДатаСогласованияЦен",ДокументОбъект.ор_ДатаСогласованияЦенЖНВЛП);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаПоступление);
		Запрос.УстановитьПараметр("ЦенаПроизводителяСНДС", Справочники.ВидыЦен.ЦенаПроизводителя.ЦенаВключаетНДС);
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент    = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы+1;
		
		// Вывод заголовка документа.
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок|ОбщаяШирина");
		ОбластьЗаголовок.Параметры.Заполнить(МассивОбъектов);
		ОбластьЗаголовок.Параметры.ПредставлениеПоставщика = СсылкаНаПоступление.Контрагент;
		ОбластьЗаголовок.Параметры.ПредставлениеПолучателя = СсылкаНаПоступление.Организация;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		// Вывод шапки ТЧ.
		
		ОбластьШапкаТаблицы = Новый ТабличныйДокумент;
		
		ОбластьМакетаШапкаТовар                     = Макет.ПолучитьОбласть("ШапкаТаблицы|Товар");
		ОбластьМакетаШапкаЦенаПервогоПоставщика     = Макет.ПолучитьОбласть("ШапкаТаблицы|ЦенаПервогоПоставщика");
		ОбластьМакетаШапкаЦенаСледующегоПоставщика  = Макет.ПолучитьОбласть("ШапкаТаблицы|ЦенаСледующегоПоставщика");
		ОбластьМакетаШапкаНаценкаПоставщика         = Макет.ПолучитьОбласть("ШапкаТаблицы|НаценкаПоставщика");
		ОбластьМакетаШапкаНаценкаПоставщикаОбщая    = Макет.ПолучитьОбласть("ШапкаТаблицы|НаценкаПоставщикаОбщая");
		ОбластьМакетаШапкаРозница                   = Макет.ПолучитьОбласть("ШапкаТаблицы|Розница");
		
		ОбластьШапкаТаблицы.Вывести(ОбластьМакетаШапкаТовар);
		ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаЦенаПервогоПоставщика);
		
		КолвоДопЗвеньев = 0;
		Для Каждого СтрокаТЧ ИЗ СсылкаНаПоступление.ОптовыеЗвенья Цикл
			Если СтрокаТЧ.ПорядокЗвена > КолвоДопЗвеньев Тогда
				КолвоДопЗвеньев = СтрокаТЧ.ПорядокЗвена;
			КонецЕсли;
		КонецЦикла;
		КолвоДопЗвеньев = КолвоДопЗвеньев - 1;
		КолвоДопЗвеньев = Макс(КолвоДопЗвеньев,0);
		
		ИспользуетсяУСНЕНВДУПоставщика = НЕ СсылкаНаПоступление.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
		НалогообложениеНДСОрганизации = НалогиУНФ.НалогообложениеНДС(СсылкаНаПоступление.Организация, СсылкаНаПоступление.СтруктурнаяЕдиница, СсылкаНаПоступление.Дата);
		ИспользуетсяУСНЕНВДУОрганизации = НЕ НалогообложениеНДСОрганизации = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
		
		Для Сч = 0 По КолвоДопЗвеньев Цикл
			
			ОбластьМакетаШапкаНаценкаПоставщика.Параметры.НомерКолонки12 = 12+5*Сч;
			ОбластьМакетаШапкаНаценкаПоставщика.Параметры.НомерКолонки13 = 13+5*Сч;
			
			ОбластьМакетаШапкаЦенаСледующегоПоставщика.Параметры.НомерКолонки14 = 14+5*Сч;
			ОбластьМакетаШапкаЦенаСледующегоПоставщика.Параметры.НомерКолонки15 = 15+5*Сч;
			ОбластьМакетаШапкаЦенаСледующегоПоставщика.Параметры.НомерКолонки16 = 16+5*Сч;
			
			ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаНаценкаПоставщика);
			ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаЦенаСледующегоПоставщика);
			
		КонецЦикла;
		
		Сч = ?((Сч-1)<0, Сч, Сч-1);
		
		ОбластьМакетаШапкаНаценкаПоставщикаОбщая.Параметры.НомерКолонки17 = 17+5*Сч;
		ОбластьМакетаШапкаНаценкаПоставщикаОбщая.Параметры.НомерКолонки18 = 18+5*Сч;
		
		ОбластьМакетаШапкаРозница.Параметры.НомерКолонки19 = 19+5*Сч;
		ОбластьМакетаШапкаРозница.Параметры.НомерКолонки20 = 20+5*Сч;
		ОбластьМакетаШапкаРозница.Параметры.НомерКолонки21 = 21+5*Сч;
		ОбластьМакетаШапкаРозница.Параметры.НомерКолонки22 = 22+5*Сч;
		
		// Заполним параметры шапки таблицы для следующего листа
		// ОбластьМакетаШапкаРозница.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы.
		
		ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаНаценкаПоставщикаОбщая);
		ОбластьШапкаТаблицы.Присоединить(ОбластьМакетаШапкаРозница);
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		// Создаем массив для проверки вывода.
		МассивВыводимыхОбластей = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			
			ОбластьСтрокаТаблицы = Новый ТабличныйДокумент;
			
			ОбластьМакетаСтрокаТовар = Макет.ПолучитьОбласть("Строка|Товар");
			ОбластьМакетаСтрокаТовар.Параметры.МНН = Выборка.МНН;
			ОбластьМакетаСтрокаТовар.Параметры.ТоварНаименование = Выборка.Номенклатура;
			ОбластьМакетаСтрокаТовар.Параметры.ХарактеристикаНаименование = Выборка.Характеристика;
			ОбластьМакетаСтрокаТовар.Параметры.Производитель = Выборка.Производитель;
			ОбластьМакетаСтрокаТовар.Параметры.ОтпускнаяЦена = Выборка.ЦенаЖНВЛП;
			ОбластьМакетаСтрокаТовар.Параметры.ФактическаяЦенаБезНДС = Выборка.ЦенаПроизводителяБезНДС;
			ОбластьМакетаСтрокаТовар.Параметры.ФактическаяЦенаСНДС = Выборка.ЦенаПроизводителяСНДС;
			ОбластьМакетаСтрокаТовар.Параметры.ДатаРеализации = Выборка.ДатаРеализации;
			ОбластьСтрокаТаблицы.Вывести(ОбластьМакетаСтрокаТовар);
			
			ДетальнаяВыборка = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			// Получение начальных цен.
			Если Выборка.ЦенаЖНВЛП > 0 И Выборка.ЦенаЖНВЛП < Выборка.ЦенаПроизводителяБезНДС Тогда
				лБазоваяЦена = Выборка.ЦенаЖНВЛП;
			Иначе
				лБазоваяЦена = Выборка.ЦенаПроизводителяБезНДС;
			КонецЕсли;
			лПредыдущаяЦенаБезНДС = Выборка.ЦенаПроизводителяБезНДС;
			лПредыдущаяЦенаСНДС   = Выборка.ЦенаПроизводителяСНДС;
			лПредыдущийУСНЕНВД = Ложь;
			
			СчетчикПоставщиков = 1;
			СуммаОптовыхНаценок = 0;
			
			// Вывод цен поставщиков по звеньям.
			Пока ДетальнаяВыборка.Следующий() Цикл
				Если НЕ Выборка.ЗакупкаУПроизводителя И ДетальнаяВыборка.ПорядокЗвена <> NULL Тогда
					
					Если СчетчикПоставщиков = 1 Тогда
						ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаПервогоПоставщика");
					Иначе
						ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаСледующегоПоставщика");
					КонецЕсли;
					ОбластьНаценка = Макет.ПолучитьОбласть("Строка|НаценкаПоставщика");
					
					Если ДетальнаяВыборка.УСНЕНВД Тогда
						лНаценка = ДетальнаяВыборка.СуммаНаценки;
						ОбластьЦена.Параметры.ЦенаПоставщика       = ДетальнаяВыборка.ЦенаПоставщикаСНДС;
						ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = "-";
						ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = "-";
					Иначе
						лНаценка = ДетальнаяВыборка.СуммаНаценки;
						ОбластьЦена.Параметры.ЦенаПоставщика       = "-";
						ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = ДетальнаяВыборка.ЦенаПоставщикаБезНДС;
						ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = ДетальнаяВыборка.ЦенаПоставщикаСНДС;
					КонецЕсли;
					СуммаОптовыхНаценок = СуммаОптовыхНаценок + лНаценка;
					
					ОбластьНаценка.Параметры.ПроцентНаценки    = ?(лНаценка>0 И лБазоваяЦена>0,ДетальнаяВыборка.ПроцентНаценки,"-");
					ОбластьНаценка.Параметры.СуммаНаценки      = ?(лНаценка>0,лНаценка,"-");
					
					лПредыдущаяЦенаБезНДС = ДетальнаяВыборка.ЦенаПоставщикаБезНДС;
					лПредыдущаяЦенаСНДС = ДетальнаяВыборка.ЦенаПоставщикаСНДС;
					лПредыдущийУСНЕНВД = ДетальнаяВыборка.УСНЕНВД;
					
					Если СчетчикПоставщиков > 1 Тогда
						ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценка);
					КонецЕсли;
					ОбластьСтрокаТаблицы.Присоединить(ОбластьЦена);
					
					СчетчикПоставщиков = СчетчикПоставщиков + 1;
					
				КонецЕсли;
			КонецЦикла;
			
			// Вывод цены последнего поставщика.
			Если Не Выборка.ЗакупкаУПроизводителя Тогда
				
				Если СчетчикПоставщиков = 1 Тогда
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаПервогоПоставщика");
				Иначе
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаСледующегоПоставщика");
				КонецЕсли;
				ОбластьНаценка = Макет.ПолучитьОбласть("Строка|НаценкаПоставщика");
				Если ИспользуетсяУСНЕНВДУПоставщика Тогда
					лНаценка = Выборка.ЦенаИзДокумента - лПредыдущаяЦенаСНДС;
					ОбластьЦена.Параметры.ЦенаПоставщика       = Выборка.ЦенаИзДокумента;
					ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = "-";
					ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = "-";
					ОбластьНаценка.Параметры.ПроцентНаценки    = ?(лНаценка>0 И лБазоваяЦена>0,лНаценка/лБазоваяЦена*100,"-");
					ОбластьНаценка.Параметры.СуммаНаценки      = ?(лНаценка>0,лНаценка,"-");
					лПредыдущаяЦенаБезНДС = Выборка.ЦенаБезНДС;
					лПредыдущаяЦенаСНДС = Выборка.ЦенаИзДокумента;
				Иначе
					Если лПредыдущийУСНЕНВД Тогда
						лНаценка = Выборка.ЦенаБезНДС - лПредыдущаяЦенаСНДС;
					Иначе
						лНаценка = Выборка.ЦенаБезНДС - лПредыдущаяЦенаБезНДС;
					КонецЕсли;
					ОбластьЦена.Параметры.ЦенаПоставщика       = "-";
					ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = Выборка.ЦенаБезНДС;
					ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = Выборка.ЦенаСНДС;
					ОбластьНаценка.Параметры.ПроцентНаценки    = ?(лНаценка>0 И лБазоваяЦена>0,лНаценка/лБазоваяЦена*100,"-");
					ОбластьНаценка.Параметры.СуммаНаценки      = ?(лНаценка>0,лНаценка,"-");
					лПредыдущаяЦенаБезНДС = Выборка.ЦенаБезНДС;
					лПредыдущаяЦенаСНДС = Выборка.ЦенаСНДС;
				КонецЕсли;
				СуммаОптовыхНаценок = СуммаОптовыхНаценок + лНаценка;
				
				Если СчетчикПоставщиков > 1 Тогда
					ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценка);
				КонецЕсли;
				ОбластьСтрокаТаблицы.Присоединить(ОбластьЦена);
				СчетчикПоставщиков = СчетчикПоставщиков + 1;
				
			КонецЕсли;
			
			// Отрисовка пустых недостающих колонок
			// +2, потому-что нужно минимум отрисовать 2 звена (звено первого поставщика и звено следующего),
			// а КолвоДопЗвеньев начинается с 0.
			// Т.е. если КолвоДопЗвеньев = 0, то в шапке отрисовано два звена, если = 1, то отрисовано три звена.
			Пока СчетчикПоставщиков <= КолвоДопЗвеньев+2 Цикл
				
				Если СчетчикПоставщиков = 1 Тогда
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаПервогоПоставщика");
				Иначе
					ОбластьЦена = Макет.ПолучитьОбласть("Строка|ЦенаСледующегоПоставщика");
				КонецЕсли;
				ОбластьНаценка = Макет.ПолучитьОбласть("Строка|НаценкаПоставщика");
				ОбластьНаценка.Параметры.ПроцентНаценки    = "-";
				ОбластьНаценка.Параметры.СуммаНаценки      = "-";
				ОбластьЦена.Параметры.ЦенаПоставщика       = "-";
				ОбластьЦена.Параметры.ЦенаПоставщикаБезНДС = "-";
				ОбластьЦена.Параметры.ЦенаПоставщикаСНДС   = "-";
				Если СчетчикПоставщиков > 1 Тогда
					ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценка);
				КонецЕсли;
				ОбластьСтрокаТаблицы.Присоединить(ОбластьЦена);
				СчетчикПоставщиков = СчетчикПоставщиков + 1;
				
			КонецЦикла;
			
			// Вывод общей наценки.
			ОбластьНаценкаПоставщикаОбщая = Макет.ПолучитьОбласть("Строка|НаценкаПоставщикаОбщая");
			ОбластьНаценкаПоставщикаОбщая.Параметры.ПроцентНаценки = ?(СуммаОптовыхНаценок>0 И лБазоваяЦена>0,СуммаОптовыхНаценок*100/лБазоваяЦена,"-");
			ОбластьНаценкаПоставщикаОбщая.Параметры.СуммаНаценки   = ?(СуммаОптовыхНаценок>0,СуммаОптовыхНаценок,"-");
			ОбластьСтрокаТаблицы.Присоединить(ОбластьНаценкаПоставщикаОбщая);
			
			// Вывод розницы.
			ВывестиПустуюОбластьРозница = Ложь;
			ОбластьЦенаРозница = Макет.ПолучитьОбласть("Строка|Розница");
			Если РозничныйТипЦен <> Неопределено Тогда
				// Поиск цены товара по виду цены.
				ТЗЦен = ДокументОбъект.Запасы.Выгрузить();
				Отбор = Новый Структура;
				Отбор.Вставить("ВидЦены", РозничныйТипЦен);
				Отбор.Вставить("Номенклатура", Выборка.Номенклатура);
				Отбор.Вставить("Характеристика", Выборка.Характеристика);
				НайденныйТовар = ТЗЦен.НайтиСтроки(Отбор);
				
				// Определяем настройку ЕНВД из вида цены по ЖНВЛП.
				ТаблицаПараметров = РозничныйТипЦен.ор_ПараметрыРасчетаФормул.Выгрузить();
				НайденнаяСтрокаПараметра = ТаблицаПараметров.Найти(Перечисления.ор_ВидыДополнительныхАлгоритмовРасчетаЦен.ЖНВЛП, "ВариантРасчета");
				Если НайденнаяСтрокаПараметра <> Неопределено Тогда
					ИспользуетсяУСНЕНВДУОрганизации = НайденнаяСтрокаПараметра.СистемаНалогообложения <> Перечисления.ТипыСистемНалогообложенияККТ.ОСН;
				КонецЕсли;
				
				Если НайденныйТовар.Количество() <> 0 Тогда
					
					Если ЗначениеЗаполнено(НайденныйТовар[0].Цена) Тогда
						
						Если ИспользуетсяУСНЕНВДУОрганизации Тогда
							// Получаем цену.
							ЦенаОтгрузкиРозницаСНДС = НайденныйТовар[0].Цена;
							// Заполняем нужную колонку области розница.
							ОбластьЦенаРозница.Параметры.ЦенаРозница       = ЦенаОтгрузкиРозницаСНДС;
							ОбластьЦенаРозница.Параметры.ЦенаРозницаБезНДС = "-";
							// Получаем и заполняем наценку розницы.
							лНаценка = ЦенаОтгрузкиРозницаСНДС - лПредыдущаяЦенаСНДС;
							
							ОбластьЦенаРозница.Параметры.ПроцентНаценки    = ?(лНаценка>0 И лБазоваяЦена>0,лНаценка/лБазоваяЦена*100,"-");
							ОбластьЦенаРозница.Параметры.СуммаНаценки      = ?(лНаценка>0,лНаценка,"-");
						Иначе
							// Получаем цену без НДС.
							Если (НайденныйТовар[0].ВидЦены.ЦенаВключаетНДС) Тогда
								Ставка = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(Выборка.СтавкаНДС);
								ЦенаОтгрузкиРозницаБезНДС = НайденныйТовар[0].Цена * 100 / (Ставка + 100);
							Иначе
								ЦенаОтгрузкиРозницаБезНДС = НайденныйТовар[0].Цена;
							КонецЕсли;
							// Заполняем нужную колонку области розница.
							ОбластьЦенаРозница.Параметры.ЦенаРозница       = "-";
							ОбластьЦенаРозница.Параметры.ЦенаРозницаБезНДС = ЦенаОтгрузкиРозницаБезНДС;
							// Получаем и заполняем наценку розницы.
							Если ИспользуетсяУСНЕНВДУПоставщика Тогда
								лНаценка = ЦенаОтгрузкиРозницаБезНДС - лПредыдущаяЦенаСНДС;
							Иначе
								лНаценка = ЦенаОтгрузкиРозницаБезНДС - лПредыдущаяЦенаБезНДС;
							КонецЕсли;
							
							ОбластьЦенаРозница.Параметры.ПроцентНаценки = ?(лНаценка>0 И лБазоваяЦена>0,лНаценка/лБазоваяЦена*100,"-");
							ОбластьЦенаРозница.Параметры.СуммаНаценки   = ?(лНаценка>0,лНаценка,"-");
						КонецЕсли;
						
					Иначе
						ВывестиПустуюОбластьРозница = Истина;
					КонецЕсли;
				Иначе
					ВывестиПустуюОбластьРозница = Истина;
				КонецЕсли;
			Иначе
				ВывестиПустуюОбластьРозница = Истина;
			КонецЕсли;
			Если ВывестиПустуюОбластьРозница Тогда
				ОбластьЦенаРозница.Параметры.ПроцентНаценки    = "-";
				ОбластьЦенаРозница.Параметры.СуммаНаценки      = "-";
				ОбластьЦенаРозница.Параметры.ЦенаРозница       = "-";
				ОбластьЦенаРозница.Параметры.ЦенаРозницаБезНДС = "-";
			КонецЕсли;
			ОбластьСтрокаТаблицы.Присоединить(ОбластьЦенаРозница);
			
			
			// В массив добавляем две строки потому что баг платформы(?)
			// при добавлении одной в массив или при передаче области напрямую
			// .ПроверитьВывод() отрабатывает некорректно и считает, что облась помещается
			// из-за этого происходил разрыв страницы.
			МассивВыводимыхОбластей.Очистить();
			МассивВыводимыхОбластей.Добавить(ОбластьСтрокаТаблицы);
			МассивВыводимыхОбластей.Добавить(ОбластьСтрокаТаблицы);
			
			
			// Завершение вывода строки таблицы.
			Если Не ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
			
		КонецЦикла;
		
		// Выводим подвал.
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.ФИОПолучателя = ДокументОбъект.Автор;
		Если Не ТабличныйДокумент.ПроверитьВывод(ОбластьПодвал) Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// Выводим Примечания.
		ОбластьПримечания = Макет.ПолучитьОбласть("Примечания");
		Если Не ТабличныйДокумент.ПроверитьВывод(ОбластьПримечания) Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьПримечания);
		
		// Ширина макета: 200, ширина колонок: 0.88.
		Если ТабличныйДокумент.ШиринаТаблицы>200 Тогда
			ТабличныйДокумент.область("C201:C"+Формат(ТабличныйДокумент.ШиринаТаблицы,"ЧГ=")).ШиринаКолонки=0.88;
		КонецЕсли;
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДокументОбъект.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьПротоколСогласованияЦен2019()

// Заполнение печатной формы протокола согласования цен 2025.
//
// Параметры:
//  МассивОбъектов	 - Массив	 - массив документов для печати.
//  ОбъектыПечати - СписокЗначений - выходной параметр, соответствие между объектами и именами областей в табличных
//                                   документах, заполняется автоматически
//                                   при вызове УправлениеПечатью.ЗадатьОбластьПечатиДокумента:
//   * Значение - ЛюбаяСсылка - ссылка из коллекции МассивОбъектов,
//   * Представление - Строка - имя области с объектом в табличных документах;
//  Макет			 - ТабличныйДокумент	 - печатная форма протокола согласования цен.
//  ПараметрыПечати	 - Структура	 - дополнительные параметры печати.
// 
// Возвращаемое значение:
//   - ТабличныйДокумент.
//
Функция ПечатьПротоколСогласованияЦен2025(МассивОбъектов, ОбъектыПечати, Макет, ПараметрыПечати = Неопределено) Экспорт
	
	РозничныйТипЦен = Неопределено;
	Если ПараметрыПечати <> Неопределено Тогда
		РозничныйТипЦен = ПараметрыПечати.ВидЦен;
	КонецЕсли;
	
	Если РозничныйТипЦен <> Неопределено Тогда
		СтруктураТаблицПредельныхНаценок = Новый Структура;
		СтруктураТаблицПредельныхНаценок.Вставить("ор_ДиапазоныНаценокНСиПТВ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РозничныйТипЦен, "ор_ДиапазоныНаценокНСиПТВ").Выгрузить());
		СтруктураТаблицПредельныхНаценок.Вставить("ор_ДиапазоныНаценокЖНВЛП",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РозничныйТипЦен, "ор_ДиапазоныНаценокЖНВЛП").Выгрузить());
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ор_ПротоколСогласованияЦен2019";
	
	ТабличныйДокумент.ПолеСлева = 5;
	ТабличныйДокумент.ПолеСправа = 6;
	ТабличныйДокумент.РазмерКолонтитулаСверху = 0;
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 0;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	// Получим вспомогательные данные для формирования табличного документа
	ФорматВыводаСуммы = "ЧЦ=15; ЧДЦ=2";
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДокументОбъект Из МассивОбъектов Цикл
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры") Тогда
			
			Если ДокументОбъект.ДокументОснование = Неопределено
				ИЛИ ТипЗнч(ДокументОбъект.ДокументОснование) <> Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
				Продолжить;
			КонецЕсли;
			СсылкаНаПоступление = ДокументОбъект.ДокументОснование;
			
		Иначе
			СсылкаНаПоступление = ДокументОбъект;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходнаяНакладная.Ссылка КАК Ссылка,
		|	ПриходнаяНакладная.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
		|ПОМЕСТИТЬ втДанныеШапки
		|ИЗ
		|	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
		|ГДЕ
		|	ПриходнаяНакладная.Ссылка = &Ссылка
		|	И ПриходнаяНакладная.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанныеШапки.Ссылка КАК Ссылка,

		"ЕдиницаИзмеренияШаблон",
		Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения, СправочникСсылка.ЕдиницыИзмерения"));
	ТЗ.Колонки.Добавить(
		"ЦенаНоваяШаблон",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,2)));
	ТЗ.Колонки.Добавить(
		"УИДСтрокиДанных",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,0, ДопустимыйЗнак.Неотрицательный)));
	ТЗ.Колонки.Добавить(
		"ИндексКартинки",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1,0, ДопустимыйЗнак.Неотрицательный)));
	ТЗ.Колонки.Добавить(
		"КлючСвязи",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,0)));
	ТЗ.Колонки.Добавить(
		"ПроверятьЗаполнениеХарактеристики",
		Новый ОписаниеТипов("Булево"));
	ТЗ.Колонки.Добавить(
		"ПустаяКолонка",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1,0)));
	ТЗ.Колонки.Добавить(
		"Лупа",
		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1,0)));
	ТЗ.Колонки.Добавить(
		"ИспользоватьХарактеристики",
		Новый ОписаниеТипов("Булево"));
	// ор ++
	ТЗ.Колонки.Добавить(
		"ор_ДатаСогласованияЦенЖНВЛПСтроки",
		Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	// ор --

КонецПроцедуры

Функция ПолучитьСтрокуСМаксимальнойДатойРегистрацииЦены(МассивНужныхСтрок)
	
	НайденнаяПоДатеСтрока = МассивНужныхСтрок[0];
	БлижайшаяДатаРегистрации = МассивНужныхСтрок[0].ДатаРегистрацииЦены;
	Для Каждого ТекСтрока Из МассивНужныхСтрок Цикл
		Если ТекСтрока.ДатаРегистрацииЦены > БлижайшаяДатаРегистрации Тогда
			БлижайшаяДатаРегистрации = ТекСтрока.ДатаРегистрацииЦены;
			НайденнаяПоДатеСтрока = ТекСтрока;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НайденнаяПоДатеСтрока;
	
КонецФункции

Функция НужноФормироватьДокументУстановкиЦен(Запасы)
	
	Для Каждого Строка Из Запасы Цикл
		Если Не ЦенообразованиеСерверПовтИсп.НоменклатураЗапрещенаКУстановкеЦены(Строка.Номенклатура) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


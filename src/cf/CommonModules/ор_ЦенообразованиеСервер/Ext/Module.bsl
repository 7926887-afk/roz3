		|	Товары.ЦенаБезНДС КАК ЦенаБезНДС,
		|	Товары.ЦенаСНДС КАК ЦенаСНДС,
		|	ВЫБОР
		|		КОГДА Товары.Характеристика.ор_Производитель = ЗНАЧЕНИЕ(Справочник.ор_Производители.ПустаяСсылка)
		|			ТОГДА Товары.Номенклатура.ор_Производитель
		|		ИНАЧЕ Товары.Характеристика.ор_Производитель
		|	КОНЕЦ КАК Производитель,
		|	Товары.ЦенаПроизводителяИзДокумента КАК ЦенаПроизводителяИзДокумента,
		|	Товары.ЦенаПроизводителяБезНДС КАК ЦенаПроизводителяБезНДС,
		|	Товары.ЦенаПроизводителяСНДС КАК ЦенаПроизводителяСНДС,
		|	Товары.ДатаРеализации КАК ДатаРеализации,
		|	Товары.ЗакупкаУПроизводителя КАК ЗакупкаУПроизводителя,
		|	ОптовыеЗвенья.ПорядокЗвена КАК ПорядокЗвена,
		|	ЕСТЬNULL(ОптовыеЗвенья.ЦенаБезНДС, 0) КАК ЦенаПоставщикаБезНДС,
		|	ЕСТЬNULL(ОптовыеЗвенья.ПроцентНаценки, 0) КАК ПроцентНаценки,
		|	ЕСТЬNULL(ОптовыеЗвенья.СуммаНаценки, 0) КАК СуммаНаценки,
		|	ЕСТЬNULL(ОптовыеЗвенья.Поставщик, 0) КАК Поставщик,
		|	ЕСТЬNULL(ОптовыеЗвенья.КлючСвязи, 0) КАК КлючСвязи,
		|	ЕСТЬNULL(ОптовыеЗвенья.УСНЕНВД, ЛОЖЬ) КАК УСНЕНВД,
		|	ЕСТЬNULL(ОптовыеЗвенья.ЦенаСНДС, 0) КАК ЦенаПоставщикаСНДС,
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.ДатаРегистрацииЦены КАК ДатаРегистрацииЦены,
		|	Товары.ЦенаЖНВЛП КАК ЦенаЖНВЛП,
		|	Товары.СтавкаНДС КАК СтавкаНДС,
		|	Товары.ЭтоНСИПТВ КАК ЭтоНСИПТВ,
		|	Товары.РозничныйВидЦен КАК РозничныйВидЦен,
		|	Товары.ЭтоРозничныйСклад КАК ЭтоРозничныйСклад
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОптовыеЗвенья КАК ОптовыеЗвенья
		|		ПО Товары.КлючСвязи = ОптовыеЗвенья.КлючСвязи
		|
		|УПОРЯДОЧИТЬ ПО

// Возвращает параметры необходимые для выполнения проверки КМ офлайн (на локальном модуле ЧЗ).
//
// Возвращаемое значение:
//   УникальныйИдентификатор            - УникальныйИдентификатор - идентификатор формы объекта, в котором выполняется проверка,
//                                        или новый уникальный идентификатор, к которому можно подключить длительную операцию.
//   Организация                        - СправочникСсылка.ОрганизацииМДЛП - организация по которой выполняется проверка КМ.
//   НомерФискальногоНакопителя         - Строка - заводской номер фискального накопителя, позволяющий идентифицировать конкретную кассу
//                                        с аутентификационным токеном и в случае подозрительной активности заблокировать конкретную кассу,
//                                        а не весь токен полностью (блокировка на стороне ГИС МТ).
//   ВыполнятьПроверкуНаЛокальномМодуле - Булево - признак необходимости выполнения офлайн проверки (на локальном модуле ЧЗ).
//                                        Выставляется по умолчанию по дате начела действия офлайн проверки разрешительного режима.
//   РабочееМесто                       - СправочникСсылка.РабочиеМеста, Неопределено - рабочее место, подключенное к локальному модулю.
//                                        Неопределено - если локальный модуль используется на сервере.
//   ДанныеДляПроверки                  - Массив - данные для проверки КМ.
//                                        См. НовыйЭлементДанныхДляПроверкиНаЛокальномМодуле().
//   РезультатПроверки                  - Структура - результаты проверки КМ.
//                                        См. НовыйРезультатПроверкиКМНаЛокальномМодуле().
//
Функция ПараметрыПроверкиКМНаЛокальномМодуле() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("УникальныйИдентификатор"   , Неопределено);
	ВозвращаемоеЗначение.Вставить("Организация"               , ПредопределенноеЗначение("Справочник.ОрганизацииМДЛП.ПустаяСсылка"));
	ВозвращаемоеЗначение.Вставить("НомерФискальногоНакопителя", "");
	
	ВозвращаемоеЗначение.Вставить("ВыполнятьПроверкуНаЛокальномМодуле", ПродукцияПодлежитОбязательнойОфлайнПроверкеПередРозничнойПродажей());
	
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	ВозвращаемоеЗначение.Вставить("РабочееМесто", Неопределено);
	#Иначе
	ВозвращаемоеЗначение.Вставить("РабочееМесто", МенеджерОборудованияКлиент.РабочееМестоКлиента());
	#КонецЕсли
	
	ВозвращаемоеЗначение.Вставить("ДанныеДляПроверки"         , Новый Массив);
	
	ВозвращаемоеЗначение.Вставить("РезультатПроверки"         , НовыйРезультатПроверкиКМНаЛокальномМодуле());
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает структуру элемента проверки КМ офлайн (на локальном модуле ЧЗ).
//
// Возвращаемое значение:
//  ПолныйКодМаркировки   - Строка - полный код маркировки в формате Base64.
//  ИдентификаторЭлемента - Строка - идентификатор по которому можно будет получить элемент проверки из общего результата проверки КМ.
//
Функция НовыйЭлементДанныхДляПроверкиНаЛокальномМодуле() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПолныйКодМаркировки"  , "");
	ВозвращаемоеЗначение.Вставить("ИдентификаторЭлемента", СокрЛП(Новый УникальныйИдентификатор));
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


// Возвращает описание результата проверки КМ офлайн (на локальном модуле ЧЗ).
//
// Возвращаемое значение:
//  ЕстьОшибки                     - Булево - признак наличия критических ошибок выполнения проверки КМ.
//  ТекстОшибки                    - Строка - текст критических ошибок выполнения проверки КМ.
//  ОтсутствуютУстановленныеЛМ     - Булево - признак отсутствия установленных локальных модулей ЧЗ.
//  НезавершеннаяНастройкаЛМ       - Булево - признак незавершенной настройки локального модуля ЧЗ.
//  НекорректныеДанныеАвторизации  - Булево - признак некорректных данных авторизации на локальном модуле ЧЗ.
//  ОтсутствиеСинхронизацииЛМ      - Булево - признак отсутствия синхронизации с локальным модулем ЧЗ.
//  ТребуетсяПроверкаНаКлиенте     - Булево - признак необходимости проверки КМ на клиенте.
//  ДанныеПроверки                 - Соответствие - коллекция результатов проверки кодов маркировки.
//   * Ключ - ИдентификаторЭлемента из коллекции ДанныеДляПроверки параметров проверки КМ
//            (см. функции ПараметрыПроверкиКМНаЛокальномМодуле и НовыйЭлементДанныхДляПроверкиНаЛокальномМодуле).
//   * Значение - Структура - результат проверки конкретного кода маркировки (см. функцию НовыйРезультатЭлементаПроверкиКМНаЛокальномМодуле).
//
Функция НовыйРезультатПроверкиКМНаЛокальномМодуле() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки" , Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки", "");
	
	ВозвращаемоеЗначение.Вставить("ОтсутствуютУстановленныеЛМ", Ложь);
	ВозвращаемоеЗначение.Вставить("НезавершеннаяНастройкаЛМ", Ложь);
	ВозвращаемоеЗначение.Вставить("НекорректныеДанныеАвторизации", Ложь);
	ВозвращаемоеЗначение.Вставить("ОтсутствиеСинхронизацииЛМ", Ложь);
	
	ВозвращаемоеЗначение.Вставить("ТребуетсяПроверкаНаКлиенте", Ложь);
	
	ВозвращаемоеЗначение.Вставить("ДанныеПроверки", Новый Соответствие);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает описание результата офлайн проверки конкретного кода маркировки.
//
// Возвращаемое значение:
//  ЕстьОшибки                   - Булево - признак наличия ошибок проверки КМ.
//  ТекстОшибки                  - Строка - текст ошибки проверки КМ.
//  ПредставлениеРезультата      - Строка - представление результата проверки КМ (если ЕстьОшибки, то ТекстОшибки).
//  ПолныйКодМаркировки          - Строка - полный код маркировки в формате Base64.
//  ТребуетсяПолныйКодМаркировки - Булево - признак необходимости получения полного кода маркировки.
//  ДанныеПроверкиКМПолучены     - Булево - признак получения даннях проверки КМ (Ложь, если проверка не выполнена).
//  См. также РезультатЭлементаПроверкиКМПоУмолчанию()
//
Функция НовыйРезультатЭлементаПроверкиКМНаЛокальномМодуле() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки"             , Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки"            , "");
	ВозвращаемоеЗначение.Вставить("ПредставлениеРезультата", "");
	
	ВозвращаемоеЗначение.Вставить("ПолныйКодМаркировки"    , "");
	
	ВозвращаемоеЗначение.Вставить("ТребуетсяПолныйКодМаркировки", Ложь);
	
	ВозвращаемоеЗначение.Вставить("ДанныеПроверкиКМПолучены", Ложь);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, РезультатЭлементаПроверкиКМПоУмолчанию());
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


// Возвращает результат проверки кодов маркировки офлайн (на локальном модуле ЧЗ).
//
// Параметры:
//  ПараметрыПроверкиКМ - Структура - См. ПараметрыПроверкиКМНаЛокальномМодуле.
//
// Возвращаемое значение:
//  РезультатПроверки - Структура - см. НовыйРезультатПроверкиКМНаЛокальномМодуле.
//
Функция ПроверитьКМНаЛокальномМодуле(ПараметрыПроверкиКМ) Экспорт
	
	ПараметрыВыполненияПроверки = Новый Структура;
	
	ПодготовитьПараметрыВыполненияПроверкиКМ(ПараметрыВыполненияПроверки, ПараметрыПроверкиКМ);
	
	РезультатПроверки = ПараметрыВыполненияПроверки.РезультатПроверки;
	
	Если Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаЛокальномМодуле Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатОфлайнЗапроса = ДанныеЛокальногоМодуля(
		ПараметрыВыполненияПроверки.ДанныеДляПроверки,
		ПараметрыВыполненияПроверки.Организация,
		ПараметрыВыполненияПроверки.НомерФискальногоНакопителя,
		ПараметрыВыполненияПроверки.РабочееМесто);
	
	ЗаполнитьРезультатПроверкиИзРезультатаЗапроса(РезультатПроверки, РезультатОфлайнЗапроса);
	
	Возврат РезультатПроверки;
	
КонецФункции


#Область ПроверкаКодаМаркировки

// Возвращает параметры, необходимые для выполнения проверки КМ.
//
// Параметры:
// Возвращаемое значение:
//  См. ПараметрыПроверкиКМОнлайн().
//  См. ПараметрыПроверкиКМНаЛокальномМодуле().
//
Функция ПараметрыПроверкиКМНаКлиентеНаСервере() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, ПараметрыПроверкиКМОнлайн(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, ПараметрыПроверкиКМНаЛокальномМодуле(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, ИнтеграцияТСПИоТМДЛПКлиентСервер.ПараметрыПроверкиКМНаТСПИоТ(), Истина);
	
	// ор ++
	ВозвращаемоеЗначение.Вставить("ККТФФД12МДЛП", Неопределено);
	// ор --
	ВозвращаемоеЗначение.Вставить("РезультатПроверки", НовыйРезультатПроверкиКМНаКлиентеНаСервере());
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает структуру элемента проверки КМ.
//
// Возвращаемое значение:
//  ВозвращаемоеЗначение - Структура - описание элемента проверки КМ.
//   См. НовыйЭлементДанныхДляПроверкиОнлайн().
//   См. НовыйЭлементДанныхДляПроверкиНаЛокальномМодуле().
//
Функция НовыйЭлементДанныхДляПроверкиНаКлиентеНаСервере() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, НовыйЭлементДанныхДляПроверкиОнлайн(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, НовыйЭлементДанныхДляПроверкиНаЛокальномМодуле(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, ИнтеграцияТСПИоТМДЛПКлиентСервер.НовыйЭлементДанныхДляПроверкиНаТСПИоТ(), Истина);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает описание результата проверки КМ.
//
// Возвращаемое значение:
//  ВозвращаемоеЗначение - Структура - описание элемента проверки КМ.
//   См. НовыйРезультатПроверкиКМОнлайн().
//   См. НовыйРезультатПроверкиКМНаЛокальномМодуле().
//
Функция НовыйРезультатПроверкиКМНаКлиентеНаСервере() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, НовыйРезультатПроверкиКМОнлайн(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, НовыйРезультатПроверкиКМНаЛокальномМодуле(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, ИнтеграцияТСПИоТМДЛПКлиентСервер.НовыйРезультатПроверкиКМНаТСПИоТ(), Истина);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает описание результата проверки конкретного кода маркировки.
//
//  ВозвращаемоеЗначение - Структура - описание элемента проверки КМ.
//   См. НовыйРезультатЭлементаПроверкиКМОнлайн().
//   См. НовыйРезультатЭлементаПроверкиКМНаЛокальномМодуле().
//
Функция НовыйРезультатЭлементаПроверкиКМНаКлиентеНаСервере() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, НовыйРезультатЭлементаПроверкиКМОнлайн(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, НовыйРезультатЭлементаПроверкиКМНаЛокальномМодуле(), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, ИнтеграцияТСПИоТМДЛПКлиентСервер.НовыйРезультатЭлементаПроверкиКМНаТСПИоТ(), Истина);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает результат онлайн и офлайн проверки КМ по умолчанию, для передачи на кассовое оборудование или в логи проверки КМ.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//   * Заблокирован                                 - Булево - признак заблокированного кода маркировки.
//   * РазрешительныйРежимИдентификаторЗапросаГИСМТ - Строка - уникальный идентификатор квитанции.
//   * РазрешительныйРежимДатаЗапросаГИСМТ          - Строка - метка времени (универсальная UNIX дата) формирования запроса.
//   * РазрешительныйРежимАдресСервера              - Строка - адрес площадки онлайн проверки или адрес подключения локального модуля ЧЗ.
//   * РазрешительныйРежимТелоЗапросаJSON           - Строка - тело запроса проверки КМ.
//   * РазрешительныйРежимТелоОтветаJSON            - Строка - тело ответа проверки КМ.
//   * РазрешительныйРежимКодОтвета                 - Строка - код состояния.
//   * РазрешительныйРежимИдентификаторЭкземпляраПО - Строка - идентификатор экземпляра ПО локального модуля ЧЗ.
//   * РазрешительныйРежимВерсияБазыЧерногоСписка   - Строка - версии базы локального модуля ЧЗ, на которой осуществлялася проверка КМ.
//
Функция РезультатЭлементаПроверкиКМПоУмолчанию() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("Заблокирован"                                           , Ложь);
	
	// Общие результаты
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ"           , "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ"                    , "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимАдресСервера"                        , "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимТелоЗапросаJSON"                     , "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимТелоОтветаJSON"                      , "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимКодОтвета"                           , "");
	
	// Результаты локального модуля
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО"           , "");
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимВерсияБазыЧерногоСписка"             , "");
	// ор ++
	ВозвращаемоеЗначение.Вставить("РазрешительныйРежимВерсияБазы", "");
	ВозвращаемоеЗначение.Вставить("КонтролиРазрешительногоРежима", Новый Массив);
	ВозвращаемоеЗначение.Вставить("ПараметрыОшибки", Неопределено);
	ВозвращаемоеЗначение.Вставить("ПродажаПоДаннымОффлайнРежима", Ложь);
	// ор --
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Подготавливает параметры выполнения проверки КМ по исходным параметрам.
//
// Параметры:
//  ПараметрыВыполненияПроверки - Структура - служебные параметры, необходимые для проверки КМ.
//  ПараметрыПроверкиКМ         - Структура - См. ПараметрыПроверкиКМНаКлиентеНаСервере().
//  ДополнительныеПараметры     - Структура - дополнительные параметры подготовки служебных параметров.
//
Процедура ПодготовитьПараметрыВыполненияПроверкиКМ(ПараметрыВыполненияПроверки, ПараметрыПроверкиКМ, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЭлементыПроверки            = ПараметрыПроверкиКМ.ДанныеДляПроверки;
	ПредыдущийРезультатПроверки = ПараметрыПроверкиКМ.РезультатПроверки;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыВыполненияПроверки, ПараметрыПроверкиКМНаКлиентеНаСервере(), Истина);
	
	// Механизм заполнения параметров выполнения из входящих параметров.
	ЗаполнитьЗначенияСвойств(ПараметрыВыполненияПроверки, ПараметрыПроверкиКМ,, "ДанныеДляПроверки, РезультатПроверки");
	
	ДействуетАварийныйРежим = ДействуетАварийныйРежимДляРозничныхПродаж();
	РазрешительныйРежимКодОтветаАварийныйРежим = АварийныйРежимКодОтветаСервисаГИСМТ();
	
	ПропуститьПолучениеИсходногоКодаМаркировки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "ПропуститьПолучениеИсходногоКодаМаркировки", Ложь);
	
	// Заполнение параметров элементов проверки
	Для Каждого ЭлементПроверки Из ЭлементыПроверки Цикл
		
		ПредыдущийРезультатЭлементаПроверки = ПредыдущийРезультатПроверки.ДанныеПроверки[ЭлементПроверки.ИдентификаторЭлемента];
		
		// Инициализация элемента коллекции результатов проверки.
		РезультатЭлементаПроверки = НовыйРезультатЭлементаПроверкиКМНаКлиентеНаСервере();
		
		РезультатЭлементаПроверки.ПолныйКодМаркировки = ЭлементПроверки.ПолныйКодМаркировки;
		
		Если Не ЗначениеЗаполнено(РезультатЭлементаПроверки.ПолныйКодМаркировки) Тогда
			РезультатЭлементаПроверки.ЕстьОшибки = Истина;
			РезультатЭлементаПроверки.ТребуетсяПолныйКодМаркировки = Истина;
		КонецЕсли;
		
		Если ДействуетАварийныйРежим Тогда
			РезультатЭлементаПроверки.РазрешительныйРежимКодОтвета = РазрешительныйРежимКодОтветаАварийныйРежим;
		КонецЕсли;
		
		Если ПроверитьАктуальностьРезультатовПроверкиКМ(ПредыдущийРезультатЭлементаПроверки) Тогда
			
			// Предыдущий результат не просрочен, еще действует.
			ЗаполнитьЗначенияСвойств(РезультатЭлементаПроверки, ПредыдущийРезультатЭлементаПроверки);
			
		// ор ++
		ИначеЕсли ПредыдущийРезультатЭлементаПроверки <> Неопределено
			И ПредыдущийРезультатЭлементаПроверки.ЕстьОшибки Тогда
			ЗаполнитьЗначенияСвойств(РезультатЭлементаПроверки, ПредыдущийРезультатЭлементаПроверки);
		// ор --
		КонецЕсли;
		
		СформироватьПредставлениеРезультатаЭлементаПроверки(РезультатЭлементаПроверки);
		
		ПараметрыВыполненияПроверки.РезультатПроверки.ДанныеПроверки.Вставить(ЭлементПроверки.ИдентификаторЭлемента, РезультатЭлементаПроверки);
		
		// Формирование коллеции элементов проверки.
		Если ЗначениеЗаполнено(РезультатЭлементаПроверки.ПолныйКодМаркировки)
			И Не ДействуетАварийныйРежим
			И Не РезультатЭлементаПроверки.ДанныеПроверкиКМПолучены Тогда
			
			Если Не ПропуститьПолучениеИсходногоКодаМаркировки Тогда
				
				// Пропустить получение исходного полного кода маркировки может потребоваться в случае, если параметры будут передаваться с клиента на сервер.
				// Символ GS не сериализуется.
				
				Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭлементПроверки, "ПолныйКодМаркировкиИсходный") Тогда
					ПолныйКодМаркировкиИсходный = ИнтеграцияМДЛПКлиентСервер.Base64ВШтрихкод(ЭлементПроверки.ПолныйКодМаркировки);
					ЭлементПроверки.Вставить("ПолныйКодМаркировкиИсходный", ПолныйКодМаркировкиИсходный);
				КонецЕсли;
				
				Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭлементПроверки, "СокращенныйКодМаркировки") Тогда
					ДанныеШтрихкода = ИнтеграцияМДЛПКлиентСервер.ДанныеШтрихкода(ЭлементПроверки.ПолныйКодМаркировкиИсходный);
					СокращенныйКодМаркировки = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку("01[GTIN]21[СерийныйНомерУпаковки]", ДанныеШтрихкода);
					ЭлементПроверки.Вставить("СокращенныйКодМаркировки", СокращенныйКодМаркировки);
				КонецЕсли;
				
			КонецЕсли;
			
			ПараметрыВыполненияПроверки.ДанныеДляПроверки.Добавить(ЭлементПроверки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДействуетАварийныйРежим Или Не ЗначениеЗаполнено(ПараметрыВыполненияПроверки.ДанныеДляПроверки) Тогда
		
		ПараметрыВыполненияПроверки.ВыполнятьПроверкуОнлайн  = Ложь;
		ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаЛокальномМодуле = Ложь;
		ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ = Ложь;
		ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаВнутреннемТСПИоТ = Ложь;
		
	Иначе
		
		Если ИнтеграцияТСПИоТМДЛПКлиентСервер.ПродукцияПодлежитОбязательнойПроверкеНаТСПИоТПередРозничнойПродажей() Тогда
			// Обязательно выполняется проверка на ТС ПИоТ, не зависимо от того, какой параметр был установлен.
			ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ = Истина;
		КонецЕсли;
		
		Если ПродукцияПодлежитОбязательнойОнлайнПроверкеПередРозничнойПродажей() Тогда
			// Обязательно выполняется онлайн проверка (если ТС ПИоТ не настроен), не зависимо от того, какой параметр был установлен.
			ПараметрыВыполненияПроверки.ВыполнятьПроверкуОнлайн = Истина;
		КонецЕсли;
		
		Если ПродукцияПодлежитОбязательнойОфлайнПроверкеПередРозничнойПродажей() Тогда
			// Обязательно выполняется офлайн проверка (если ТС ПИоТ не настроен или если онлайн проверка не будет выполнена), не зависимо от того, какой параметр был установлен.
			ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаЛокальномМодуле = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ
	 Или ПараметрыВыполненияПроверки.ВыполнятьПроверкуОнлайн
	 Или ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаЛокальномМодуле Тогда
		
		Если Не ЗначениеЗаполнено(ПараметрыВыполненияПроверки.НомерФискальногоНакопителя) Тогда
			ПараметрыВыполненияПроверки.НомерФискальногоНакопителя = ПолучитьНомерФискальногоНакопителя(ПараметрыВыполненияПроверки);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПараметрыВыполненияПроверки.ККТФФД12МДЛП) Тогда
			ПараметрыВыполненияПроверки.ККТФФД12МДЛП = ПолучитьККТФФД12МДЛП(ПараметрыВыполненияПроверки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыВыполненияПроверки.НомерФискальногоНакопителя) Или ЗначениеЗаполнено(ПараметрыВыполненияПроверки.ККТФФД12МДЛП) Тогда
			
			НастройкиПодключенияЭкземпляраТСПИоТ = ИнтеграцияТСПИоТМДЛПКлиентСервер.НастройкиПодключенияЭкземпляраТСПИоТ(ПараметрыВыполненияПроверки.НомерФискальногоНакопителя, ПараметрыВыполненияПроверки.ККТФФД12МДЛП);
			// ор ++
			ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ = ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ
				И НастройкиПодключенияЭкземпляраТСПИоТ.Настроено;
			// ор --
			
			Если ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаТСПИоТ Тогда
				// Если есть настройки внутреннего ТС ПИоТ, то используем внутренний ТС ПИоТ.
				ПараметрыВыполненияПроверки.ВыполнятьПроверкуНаВнутреннемТСПИоТ = НастройкиПодключенияЭкземпляраТСПИоТ.НастройкиПодключения.ВнутреннийТСПИоТ;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Переносит результат выполнения запроса проверки КМ в итоговый результат проверки КМ.
//
// Параметры:
//  РезультатПроверки - Структура - итоговый результат проверки.
//  РезультатЗапроса  - Структура - результат выполнения запроса проверки КМ.
//
Процедура ЗаполнитьРезультатПроверкиИзРезультатаЗапроса(РезультатПроверки, РезультатЗапроса) Экспорт
	
	ЗаполнитьЗначенияСвойств(РезультатПроверки, РезультатЗапроса); // Свойство ДанныеПроверки не перезаполняется.
	
	Если ЗначениеЗаполнено(РезультатПроверки.ТекстОшибки) Тогда
		РезультатПроверки.ЕстьОшибки = Истина;
		// ор ++
		Для Каждого КлючИЗначение Из РезультатПроверки.ДанныеПроверки Цикл
			РезультатЭлементаПроверки = КлючИЗначение.Значение;
			
			РезультатЭлементаПроверки.ЕстьОшибки = Истина;
			РезультатЭлементаПроверки.ТекстОшибки = РезультатПроверки.ТекстОшибки;
			РезультатЭлементаПроверки.ПредставлениеРезультата = РезультатПроверки.ТекстОшибки;
		КонецЦикла;
		// ор --
		Возврат;
	КонецЕсли;
	
	ДействуетАварийныйРежим = ДействуетАварийныйРежимДляРозничныхПродаж();
	РазрешительныйРежимКодОтветаАварийныйРежим = АварийныйРежимКодОтветаСервисаГИСМТ();
	
	Для Каждого КлючИЗначение Из РезультатПроверки.ДанныеПроверки Цикл
		
		ИдентификаторЭлемента     = КлючИЗначение.Ключ;
		РезультатЭлементаПроверки = КлючИЗначение.Значение;
		
		Если Не ЗначениеЗаполнено(РезультатЭлементаПроверки.ПолныйКодМаркировки) Тогда
			РезультатЭлементаПроверки.ЕстьОшибки = Истина;
			РезультатЭлементаПроверки.ТребуетсяПолныйКодМаркировки = Истина;
			СформироватьПредставлениеРезультатаЭлементаПроверки(РезультатЭлементаПроверки);
			Продолжить;
		КонецЕсли;
		
		Если ДействуетАварийныйРежим Тогда
			РезультатЭлементаПроверки.РазрешительныйРежимКодОтвета = РазрешительныйРежимКодОтветаАварийныйРежим;
			СформироватьПредставлениеРезультатаЭлементаПроверки(РезультатЭлементаПроверки);
			Продолжить;
		КонецЕсли;
		
		// Результаты контроля разрешительного режима.
		СтатусыКодаМаркировки = РезультатЗапроса.СтатусыКодовМаркировкиГИСМТ.Получить(ИдентификаторЭлемента);
		Если ЗначениеЗаполнено(СтатусыКодаМаркировки) Тогда
			Для Каждого СтатусИЗначение Из СтатусыКодаМаркировки Цикл
				Если ЗначениеЗаполнено(СтатусИЗначение.Значение) И РезультатЭлементаПроверки.Свойство(СтатусИЗначение.Ключ) Тогда
					РезультатЭлементаПроверки[СтатусИЗначение.Ключ] = СтатусИЗначение.Значение;
				КонецЕсли;
			КонецЦикла;
			РезультатЭлементаПроверки.ДанныеПроверкиКМПолучены = Истина;
		КонецЕсли;
		
		// Коды маркировки, по которым не были получены ответы ГИС МТ.
		ЭлементБезПроверки = РезультатЗапроса.КодыМаркировкиБезДанных.Получить(ИдентификаторЭлемента);
		Если ЭлементБезПроверки <> Неопределено Тогда
			РезультатЭлементаПроверки.ДанныеПроверкиКМПолучены = Ложь;
		КонецЕсли;
		
		// Ошибки кода маркировки контроля разрешительного режима.
		КонтролиРазрешительногоРежима = РезультатЗапроса.КонтролиРазрешительногоРежима.Получить(ИдентификаторЭлемента);
		Если ЗначениеЗаполнено(КонтролиРазрешительногоРежима) Тогда
			РезультатЭлементаПроверки.ЕстьОшибки  = Истина;
			РезультатЭлементаПроверки.ТекстОшибки = СтрСоединить(КонтролиРазрешительногоРежима, Символы.ПС);
			// ор ++
			РезультатЭлементаПроверки.КонтролиРазрешительногоРежима = КонтролиРазрешительногоРежима;
			// ор --
		КонецЕсли;
		
		СформироватьПредставлениеРезультатаЭлементаПроверки(РезультатЭлементаПроверки);
		
	КонецЦикла;
	
КонецПроцедуры

#Область CDNПлощадки

// Возвращает параметры необходимые для выполнения проверки КМ онлайн.
//
// Возвращаемое значение:
//   УникальныйИдентификатор    - УникальныйИдентификатор - идентификатор формы объекта, в котором выполняется проверка,
//                                или новый уникальный идентификатор, к которому можно подключить длительную операцию.
//   Организация                - СправочникСсылка.ОрганизацииМДЛП - организация по которой выполняется проверка КМ.
//   НомерФискальногоНакопителя - Строка - заводской номер фискального накопителя, позволяющий идентифицировать конкретную кассу
//                                с аутентификационным токеном и в случае подозрительной активности заблокировать конкретную кассу,
//                                а не весь токен полностью (блокировка на стороне ГИС МТ).
//   ВыполнятьПроверкуОнлайн    - Булево - признак необходимости выполнения онлайн проверки.
//                                Выставляется по умолчанию по дате начела действия онлайн проверки разрешительного режима.
//   ДанныеДляПроверки          - Массив - данные для проверки КМ.
//                                См. НовыйЭлементДанныхДляПроверкиОнлайн().
//   РезультатПроверки          - Структура - результаты проверки КМ.
//                                См. НовыйРезультатПроверкиКМОнлайн().
//
Функция ПараметрыПроверкиКМОнлайн() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("УникальныйИдентификатор"   , Неопределено);
	ВозвращаемоеЗначение.Вставить("Организация"               , ПредопределенноеЗначение("Справочник.ОрганизацииМДЛП.ПустаяСсылка"));
	ВозвращаемоеЗначение.Вставить("НомерФискальногоНакопителя", "");
	
	ВозвращаемоеЗначение.Вставить("ВыполнятьПроверкуОнлайн"   , ПродукцияПодлежитОбязательнойОнлайнПроверкеПередРозничнойПродажей());
	
	ВозвращаемоеЗначение.Вставить("ДанныеДляПроверки"         , Новый Массив);
	
	ВозвращаемоеЗначение.Вставить("РезультатПроверки"         , НовыйРезультатПроверкиКМОнлайн());
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает структуру элемента проверки КМ онлайн.
//
// Возвращаемое значение:
//  ПолныйКодМаркировки   - Строка - полный код маркировки в формате Base64.
//  ИдентификаторЭлемента - Строка - идентификатор по которому можно будет получить элемент проверки из общего результата проверки КМ.
//
Функция НовыйЭлементДанныхДляПроверкиОнлайн() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПолныйКодМаркировки"  , "");
	ВозвращаемоеЗначение.Вставить("ИдентификаторЭлемента", СокрЛП(Новый УникальныйИдентификатор));
	
	// ор ++
	ВозвращаемоеЗначение.Вставить("ПредставлениеНоменклатуры", "");
	// ор --
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


// Возвращает описание результата проверки КМ онлайн.
//
// Возвращаемое значение:
//  ЕстьОшибки                     - Булево - признак наличия критических ошибок выполнения проверки КМ.
//  ТекстОшибки                    - Строка - текст критических ошибок выполнения проверки КМ.
//  ТребуетсяОбновлениеКлючаСессии - Булево - признак необходимости обновления ключа сессии.
//  ОтсутствуютCDNПлощадки         - Булево - признак отсутсвия настроенных CDN-площадок.
//  ТребуетсяОбновлениеCDNПлощадок - Булево - признак необходимости обновления CDN-площадок.
//  ДанныеПроверки                 - Соответствие - коллекция результатов проверки кодов маркировки.
//   * Ключ - ИдентификаторЭлемента из коллекции ДанныеДляПроверки параметров проверки КМ
//            (см. функции ПараметрыПроверкиКМОнлайн и НовыйЭлементДанныхДляПроверкиОнлайн).
//   * Значение - Структура - результат проверки конкретного кода маркировки (см. функцию НовыйРезультатЭлементаПроверкиКМОнлайн).
//
Функция НовыйРезультатПроверкиКМОнлайн() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки" , Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки", "");
	
	ВозвращаемоеЗначение.Вставить("ТребуетсяОбновлениеКлючаСессии", Ложь);
	ВозвращаемоеЗначение.Вставить("ОтсутствуютCDNПлощадки", Ложь);
	
	ВозвращаемоеЗначение.Вставить("ТребуетсяОбновлениеCDNПлощадок", Ложь);
	
	ВозвращаемоеЗначение.Вставить("ДанныеПроверки", Новый Соответствие);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает описание результата онайлн проверки конкретного кода маркировки.
//
// Возвращаемое значение:
//  ЕстьОшибки                   - Булево - признак наличия ошибок проверки КМ.
//  ТекстОшибки                  - Строка - текст ошибки проверки КМ.
//  ПредставлениеРезультата      - Строка - представление результата проверки КМ (если ЕстьОшибки, то ТекстОшибки).
//  ПолныйКодМаркировки          - Строка - полный код маркировки в формате Base64.
//  ТребуетсяПолныйКодМаркировки - Булево - признак необходимости получения полного кода маркировки.
//  ДанныеПроверкиКМПолучены     - Булево - признак получения даннях проверки КМ (Ложь, если проверка не выполнена).
//  См. также РезультатЭлементаПроверкиКМПоУмолчанию().
//
Функция НовыйРезультатЭлементаПроверкиКМОнлайн() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки"             , Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки"            , "");
	ВозвращаемоеЗначение.Вставить("ПредставлениеРезультата", "");
	
	ВозвращаемоеЗначение.Вставить("ПолныйКодМаркировки"    , "");
	
	ВозвращаемоеЗначение.Вставить("ТребуетсяПолныйКодМаркировки", Ложь);
	
	ВозвращаемоеЗначение.Вставить("ДанныеПроверкиКМПолучены", Ложь);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВозвращаемоеЗначение, РезультатЭлементаПроверкиКМПоУмолчанию());
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает результат проверки кодов маркировки онлайн.
//
// Параметры:
//  ПараметрыПроверкиКМ - Структура - См. ПараметрыПроверкиКМОнлайн.
//
// Возвращаемое значение:
//  РезультатПроверки - Структура - см. НовыйРезультатПроверкиКМОнлайн.
//
Функция ПроверитьКМОнлайн(ПараметрыПроверкиКМ) Экспорт
	
	ПараметрыВыполненияПроверки = Новый Структура;
	
	ПодготовитьПараметрыВыполненияПроверкиКМ(ПараметрыВыполненияПроверки, ПараметрыПроверкиКМ);
	
	РезультатПроверки = ПараметрыВыполненияПроверки.РезультатПроверки;
	
	Если Не ПараметрыВыполненияПроверки.ВыполнятьПроверкуОнлайн Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатОнлайнЗапроса = ДанныеОнлайнПроверкиКМ(
		ПараметрыВыполненияПроверки.ДанныеДляПроверки,
		ПараметрыВыполненияПроверки.Организация,
		ПараметрыВыполненияПроверки.НомерФискальногоНакопителя);
	
	ЗаполнитьРезультатПроверкиИзРезультатаЗапроса(РезультатПроверки, РезультатОнлайнЗапроса);
	
	Возврат РезультатПроверки;
	
КонецФункции

#КонецОбласти // CDNПлощадки


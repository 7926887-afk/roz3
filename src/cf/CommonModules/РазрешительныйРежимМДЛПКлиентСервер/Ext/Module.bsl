КонецФункции

// Возвращает настройки разрешительного режима по умолчанию.
//
// Возвращаемое значение:
//  Результат - Структура - Настройки:
//   * ВремяБлокировкиCDNПлощадок                                  - Число - время блокировки CDN-площадок, в минутах.
//   * ВремяОтветаCDNПлощадокПриПробитииЧека                       - Число - время ожидания ответа от CDN-площадок при пробитии чека, в секундах.
//   * ЧастотаОбновленияCDNПлощадок                                - Число - частота обновления, в часах.
//   * СрокДействияИдентификатораРазрешительногоРежима             - Число - срок действия идентификатора, в секундах.
//   * АварийноеОтключенияРазрешительногоРежимаДоУниверсальнаяДата - Дата  - универсальная дата.
//
Функция НастройкиРазрешительногоРежимаПоУмолчанию() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВремяБлокировкиCDNПлощадок",                                  15);     // в минутах
	Результат.Вставить("ВремяОтветаCDNПлощадокПриПробитииЧека",                       1.5);    // в секундах
	Результат.Вставить("ЧастотаОбновленияCDNПлощадок",                                6);      // в часах
	Результат.Вставить("СрокДействияИдентификатораРазрешительногоРежима",             300);    // в секундах
	Результат.Вставить("АварийноеОтключенияРазрешительногоРежимаДоУниверсальнаяДата", Дата(1, 1, 1));
	
	Возврат Результат;
	
КонецФункции


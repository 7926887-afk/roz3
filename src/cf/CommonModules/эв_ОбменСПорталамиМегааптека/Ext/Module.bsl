КонецПроцедуры

Функция ТекстОшибкиОтвета(РезультатHTTP)

	Если РезультатHTTP.Успех Тогда
		Возврат "";
	КонецЕсли;

	Сообщение = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(РезультатHTTP.Json, "message")));
	Ошибки = ЗначениеПоляJSON(РезультатHTTP.Json, "errors");
	Если ТипЗнч(Ошибки) = Тип("Массив") И Ошибки.Количество() > 0 Тогда
		ТекстыОшибок = Новый Массив;
		Для Каждого Ошибка Из Ошибки Цикл
			Если ТипЗнч(Ошибка) = Тип("Строка") Тогда
				ТекстыОшибок.Добавить(Ошибка);
			Иначе
				ТекстЭлемента = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(Ошибка, "message")));
				Если ЗначениеЗаполнено(ТекстЭлемента) Тогда
					ТекстыОшибок.Добавить(ТекстЭлемента);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ТекстыОшибок.Количество() > 0 Тогда
			Сообщение = СокрЛП(Сообщение + " " + СтрСоединить(ТекстыОшибок, "; "));
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Сообщение) Тогда
		Возврат Сообщение;
	КонецЕсли;

	Возврат РезультатHTTP.ТекстОшибки;

КонецФункции

Функция ПолеЗаполнено(НастройкиAPI, ИмяПоля)

	ЗначениеПоля = Неопределено;
	Если Не НастройкиAPI.Свойство(ИмяПоля, ЗначениеПоля) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(ЗначениеПоля);

КонецФункции

Функция ЗначениеПоляJSON(ОбъектJSON, ИмяПоля)

	Если ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда
		Возврат ОбъектJSON.Получить(ИмяПоля);
	ИначеЕсли ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда
		ЗначениеПоля = Неопределено;
		ОбъектJSON.Свойство(ИмяПоля, ЗначениеПоля);
		Возврат ЗначениеПоля;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СтрокаИзJSON(ЗначениеПоля)

	Если ЗначениеПоля = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(ЗначениеПоля));

КонецФункции

Функция ЧислоИзJSON(ЗначениеПоля)

	Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
		Возврат ЗначениеПоля;
	КонецЕсли;
	Попытка
		Возврат Число(ЗначениеПоля);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

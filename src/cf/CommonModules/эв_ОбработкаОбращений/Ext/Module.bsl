
#Область ПрограммныйИнтерфейс

Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	ИмяФормы = "";
	НастройкиФормы.Свойство("ИмяФормы", ИмяФормы);
	Если СтрНачинаетсяС(ИмяФормы, "Обработка.эв_СоздатьОбращение.") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Использование", Метаданные.Обработки.эв_СоздатьОбращение) Тогда
		Возврат;
	КонецЕсли;
	
	Команда = Команды.Добавить();
	Команда.Вид = "КоманднаяПанель";
	Команда.Идентификатор = "эв_СоздатьОбращение";
	Команда.Представление = НСтр("ru = 'Создать обращение'");
	Команда.Картинка = БиблиотекаКартинок.СообщениеВТехПоддержку;
	Команда.ОтображениеКнопки = ОтображениеКнопки.Картинка;
	Команда.РежимЗаписи = "ЗаписыватьТолькоНовые";
	Команда.МножественныйВыбор = Ложь;
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.ИспользованиеТекущейСтроки = "НеИспользует";
	Команда.Обработчик = "эв_ОбработкаОбращенийКлиент.СоздатьОбращение";
	Команда.Порядок = 50;
	
КонецПроцедуры

// Кнопка на стандартной форме отчета. Команда выполняется через Подключаемый_Команда.
//
Процедура ДобавитьКомандуОтчета(Форма) Экспорт
	
	Если Не ПравоДоступа("Использование", Метаданные.Обработки.эв_СоздатьОбращение) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПостоянныеКоманды") Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Команды.Найти("эв_СоздатьОбращение") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоманднаяПанель = Форма.Элементы.Найти("ОсновнаяКоманднаяПанель");
	Если КоманднаяПанель = Неопределено Тогда
		КоманднаяПанель = Форма.КоманднаяПанель;
	КонецЕсли;
	
	Команда = Форма.Команды.Добавить("эв_СоздатьОбращение");
	Команда.Действие = "Подключаемый_Команда";
	Команда.Заголовок = НСтр("ru = 'Создать обращение'");
	Команда.Подсказка = Команда.Заголовок;
	Команда.Картинка = БиблиотекаКартинок.СообщениеВТехПоддержку;
	Команда.Отображение = ОтображениеКнопки.Картинка;
	
	Кнопка = Форма.Элементы.Добавить("эв_СоздатьОбращение", Тип("КнопкаФормы"), КоманднаяПанель);
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	Кнопка.ИмяКоманды = "эв_СоздатьОбращение";
	Кнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанелиИВДополнительномПодменю;
	
	Форма.ПостоянныеКоманды.Добавить("эв_СоздатьОбращение", "эв_ОбработкаОбращенийКлиент.СоздатьОбращениеИзФормы");
	
КонецПроцедуры

// Создает обращение в 1С:ITILIUM и записывает его идентификатор в регистр обращений.
// Статус записи не заполняется.
//
// Параметры:
//  ОбъектЗадачи - Строка - навигационная ссылка объекта, из которого создается обращение.
//  Проблема - Строка - текст проблемы.
//  ЧтоНеобходимоСделать - Строка - ожидаемое действие.
//  ПутиСкриншотов - Массив из Строка - пути к файлам из таблицы формы.
//  ФайлыСкриншотов - Массив из Структура - файлы, помещенные во временное хранилище:
//   * ИмяФайла - Строка
//   * Адрес - Строка
//  ВнешнийИдентификатор - Строка - ключ идемпотентности createIncident. Пустая строка заменяется новым UUID.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Идентификатор - Строка - UUID документа Инцидент.
//   * Номер - Строка
//   * Ошибка - Строка
//
Функция СоздатьОбращение(Знач ОбъектЗадачи, Знач Проблема, Знач ЧтоНеобходимоСделать, Знач ПутиСкриншотов = Неопределено, Знач ФайлыСкриншотов = Неопределено, Знач ВнешнийИдентификатор = "") Экспорт
	
	Результат = Новый Структура("Успех, Идентификатор, Номер, Ошибка", Ложь, "", "", "");
	
	Если ПутиСкриншотов = Неопределено Тогда
		ПутиСкриншотов = Новый Массив;
	КонецЕсли;
	Если ФайлыСкриншотов = Неопределено Тогда
		ФайлыСкриншотов = Новый Массив;
	КонецЕсли;
	
	Настройки = НастройкиИтилиум();
	Если ПустаяСтрока(Настройки.Адрес)
		Или ПустаяСтрока(Настройки.Пользователь)
		Или ПустаяСтрока(Настройки.Клиент)
		Или ПустаяСтрока(Настройки.Инициатор) Тогда
		Результат.Ошибка = НСтр("ru = 'Заполните константы подключения к Итилиум: адрес сервиса, пользователь, клиент и инициатор.'");
		Возврат Результат;
	КонецЕсли;
	
	Тема = "";
	Для НомерСтроки = 1 По СтрЧислоСтрок(Проблема) Цикл
		ТекстСтроки = СокрЛП(СтрПолучитьСтроку(Проблема, НомерСтроки));
		Если Не ПустаяСтрока(ТекстСтроки) Тогда
			Тема = ТекстСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Тема) > 255 Тогда
		Тема = Лев(Тема, 255);
	КонецЕсли;
	
	ЧастиОписания = Новый Массив;
	ЧастиОписания.Добавить(Проблема);
	Если Не ПустаяСтрока(СокрЛП(ЧтоНеобходимоСделать)) Тогда
		ЧастиОписания.Добавить("Что необходимо сделать:");
		ЧастиОписания.Добавить(ЧтоНеобходимоСделать);
	КонецЕсли;
	
	Файлы = Новый Массив;
	Для Каждого ФайлСкриншота Из ФайлыСкриншотов Цикл
		ДанныеФайла = ПолучитьИзВременногоХранилища(ФайлСкриншота.Адрес);
		Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
			Результат.Ошибка = НСтр("ru = 'Не удалось прочитать скриншот'") + " " + ФайлСкриншота.ИмяФайла;
			Возврат Результат;
		КонецЕсли;
		Файлы.Добавить(Новый Структура("name, data", ФайлСкриншота.ИмяФайла, Base64Строка(ДанныеФайла)));
	КонецЦикла;
	
	Тело = Новый Структура;
	Если ПустаяСтрока(ВнешнийИдентификатор) Тогда
		ВнешнийИдентификатор = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	Тело.Вставить("externalID", ВнешнийИдентификатор);
	Тело.Вставить("clientUuid", Настройки.Клиент);
	Тело.Вставить("initiatorUuid", Настройки.Инициатор);
	Тело.Вставить("topic", Тема);
	Тело.Вставить("description", СтрСоединить(ЧастиОписания, Символы.ПС));
	Если Файлы.Количество() > 0 Тогда
		Тело.Вставить("files", Файлы);
	КонецЕсли;
	
	Адрес = Настройки.Адрес;
	Если СтрЗаканчиваетсяНа(Адрес, "/") Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Аутентификация", КоннекторHTTP.НоваяАутентификацияBasic(Настройки.Пользователь, Настройки.Пароль));
	
	Попытка
		Ответ = КоннекторHTTP.PostJson(Адрес + "/createIncident", Тело, ПараметрыЗапроса);
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	ТекстОшибкиСервиса = ЗначениеОтветаИтилиум(Ответ, "ErrorText");
	Если ЗначениеОтветаИтилиум(Ответ, "isError") = Истина Или НРег(Строка(ЗначениеОтветаИтилиум(Ответ, "isError"))) = "true" Тогда
		Результат.Ошибка = Строка(ТекстОшибкиСервиса);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОтключения = ЗначениеОтветаИтилиум(Ответ, "Error");
	Если ЗначениеЗаполнено(ТекстОтключения) Тогда
		Результат.Ошибка = Строка(ТекстОтключения);
		Возврат Результат;
	КонецЕсли;
	
	Идентификатор = СокрЛП(Строка(ЗначениеОтветаИтилиум(Ответ, "uuid")));
	Номер = СокрЛП(Строка(ЗначениеОтветаИтилиум(Ответ, "number")));
	Если ПустаяСтрока(Идентификатор) Или СтрДлина(Идентификатор) > 36 Тогда
		Результат.Ошибка = НСтр("ru = 'Сервис не вернул идентификатор обращения'");
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ЗаписатьОбращениеВРегистр(Идентификатор, ТекстОбращения(ОбъектЗадачи, Проблема, ЧтоНеобходимоСделать, ПутиСкриншотов));
	Исключение
		Результат.Идентификатор = Идентификатор;
		Результат.Номер = Номер;
		Результат.Ошибка = НСтр("ru = 'Обращение создано, но не записано в регистр:'") + " " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = Истина;
	Результат.Идентификатор = Идентификатор;
	Результат.Номер = Номер;
	Если НРег(Строка(ЗначениеОтветаИтилиум(Ответ, "created"))) = "false" Тогда
		Результат.Ошибка = НСтр("ru = 'Обращение с таким внешним идентификатором уже существовало'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстОбращения(ОбъектЗадачи, Проблема, ЧтоНеобходимоСделать, ПутиСкриншотов)
	
	Части = Новый Массив;
	Части.Добавить(СтрокаСоединенияИнформационнойБазы());
	Части.Добавить(Строка(Пользователи.ТекущийПользователь()));
	Части.Добавить(ОбъектЗадачи);
	Части.Добавить(Проблема);
	Части.Добавить(ЧтоНеобходимоСделать);
	
	Для Каждого ПутьСкриншота Из ПутиСкриншотов Цикл
		Части.Добавить(ПутьСкриншота);
	КонецЦикла;
	
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

Процедура ЗаписатьОбращениеВРегистр(Идентификатор, ТекстОбращения)
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи = РегистрыСведений.эв_ОбращенияВТехподдержку.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.id = Идентификатор;
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.id = Идентификатор;
		КонецЕсли;
		МенеджерЗаписи.ТекстОбращения = ТекстОбращения;
		МенеджерЗаписи.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция НастройкиИтилиум()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Настройки = Новый Структура;
	Настройки.Вставить("Адрес", СокрЛП(Константы.эв_АдресСервисаИтилиум.Получить()));
	Настройки.Вставить("Пользователь", СокрЛП(Константы.эв_ПользовательСервисаИтилиум.Получить()));
	Настройки.Вставить("Пароль", Константы.эв_ПарольСервисаИтилиум.Получить());
	Настройки.Вставить("Клиент", СокрЛП(Константы.эв_КлиентИтилиум.Получить()));
	Настройки.Вставить("Инициатор", СокрЛП(Константы.эв_ИнициаторИтилиум.Получить()));
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Настройки;
	
КонецФункции

Функция ЗначениеОтветаИтилиум(Ответ, Имя)
	
	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Возврат Ответ.Получить(Имя);
	КонецЕсли;
	
	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		Значение = Неопределено;
		Ответ.Свойство(Имя, Значение);
		Возврат Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

Функция ИнициаторТекущегоМагазина()
	
	// ++ Эвалар 2026-11-20
	// Инициатор обращения берется из дополнительного реквизита текущего магазина.
	Магазин = эв_ОбщегоНазначенияПовтИсп.ОсновнойСклад();
	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Возврат "";
	КонецЕсли;
	
	Свойство = ДополнительныйРеквизитПоИмени("ИнициаторВИтилиумНаименование");
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		Возврат "";
	КонецЕсли;
	
	Значение = УправлениеСвойствами.ЗначениеСвойства(Магазин, Свойство);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	// -- Эвалар 2026-11-20
	
КонецФункции

Функция ДополнительныйРеквизитПоИмени(ИмяРеквизита)
	
	// ++ Эвалар 2026-11-20
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Свойства.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
	|ГДЕ
	|	НЕ Свойства.ПометкаУдаления
	|	И Свойства.ИдентификаторДляФормул = &Имя";
	Запрос.УстановитьПараметр("Имя", ИмяРеквизита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка();
	// -- Эвалар 2026-11-20
	
КонецФункции

Функция ЗначениеОтветаИтилиум(Ответ, Имя)
	
	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Возврат Ответ.Получить(Имя);
	КонецЕсли;
	
	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		Значение = Неопределено;
		Ответ.Свойство(Имя, Значение);
		Возврат Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИдентификаторыОбращений()
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ПустойИдентификатор", "");
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Обращения.id КАК id
		|ИЗ
		|	РегистрСведений.эв_ОбращенияВТехподдержку КАК Обращения
		|ГДЕ
		|	Обращения.id <> &ПустойИдентификатор";
		
		Идентификаторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("id");
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Идентификаторы;
	
КонецФункции

Функция ЭтоОшибкаИтилиум(Ответ)
	
	Если ПризнакОтветаИтилиум(Ответ, "isError") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(ЗначениеОтветаИтилиум(Ответ, "Error"));
	
КонецФункции

Функция ТекстОшибкиИтилиум(Ответ)
	
	Текст = ЗначениеОтветаИтилиум(Ответ, "ErrorText");
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Текст = ЗначениеОтветаИтилиум(Ответ, "Error");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат НСтр("ru = 'Сервис Итилиум вернул ошибку'");
	КонецЕсли;
	
	Возврат Строка(Текст);
	
КонецФункции

Функция ПризнакОтветаИтилиум(Ответ, Имя)
	
	Значение = ЗначениеОтветаИтилиум(Ответ, Имя);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат НРег(СокрЛП(Строка(Значение))) = "true";
	
КонецФункции

Процедура ЗаписатьОбновленияОбращений(Обращения, Результат)
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Для Каждого Обращение Из Обращения Цикл
			Если ЗаписатьОбновлениеОбращения(Обращение) Тогда
				Результат.Обновлено = Результат.Обновлено + 1;
			КонецЕсли;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Результат.Успех = Ложь;
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

Функция ЗаписатьОбновлениеОбращения(Обращение)
	
	Если Не ПризнакОтветаИтилиум(Обращение, "found") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначениеОтветаИтилиум(Обращение, "error")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Идентификатор = СокрЛП(Строка(ЗначениеОтветаИтилиум(Обращение, "externalID")));
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.эв_ОбращенияВТехподдержку.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.id = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Статус = СтатусОбращенияИтилиум(ЗначениеОтветаИтилиум(Обращение, "state"), ПризнакОтветаИтилиум(Обращение, "closed"));
	Если ЗначениеЗаполнено(Статус) Тогда
		МенеджерЗаписи.Статус = Статус;
	КонецЕсли;
	МенеджерЗаписи.ТекстОтвета = ТекстОтветаИтилиум(Обращение);
	МенеджерЗаписи.Записать();
	
	Возврат Истина;
	
КонецФункции

Функция СтатусОбращенияИтилиум(Состояние, Закрыто)
	
	Имя = НРег(СокрЛП(Строка(Состояние)));
	Если СтрНайти(Имя, "к выполнению") > 0 Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.КВыполнению;
	КонецЕсли;
	
	Если СтрНайти(Имя, "выполня") > 0
		Или СтрНайти(Имя, "работ") > 0
		Или СтрНайти(Имя, "исполн") > 0 Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.ВРаботе;
	КонецЕсли;
	
	Если Закрыто
		Или СтрНайти(Имя, "выполн") > 0
		Или СтрНайти(Имя, "закры") > 0
		Или СтрНайти(Имя, "решен") > 0
		Или СтрНайти(Имя, "решён") > 0
		Или СтрНайти(Имя, "отмен") > 0 Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.Выполнено;
	КонецЕсли;
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.ПустаяСсылка();
	КонецЕсли;
	
	Если СтрНайти(Имя, "зарегистрир") > 0
		Или СтрНайти(Имя, "нов") > 0
		Или СтрНайти(Имя, "ожид") > 0
		Или СтрНайти(Имя, "уточн") > 0
		Или СтрНайти(Имя, "отлож") > 0 Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.КВыполнению;
	КонецЕсли;
	
	Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.ВРаботе;
	
КонецФункции

Функция ТекстОтветаИтилиум(Обращение)
	
	События = Новый ТаблицаЗначений;
	События.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	События.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));
	
	ДобавитьСобытияИтилиум(События, ЗначениеОтветаИтилиум(Обращение, "solutions"));
	ДобавитьСобытияИтилиум(События, ЗначениеОтветаИтилиум(Обращение, "communications"));
	События.Сортировать("Дата");
	
	Части = Новый Массив;
	Для Каждого Событие Из События Цикл
		Если ЗначениеЗаполнено(Событие.Дата) Тогда
			Части.Добавить(Формат(Событие.Дата, "ДЛФ=DT") + Символы.ПС + Событие.Текст);
		Иначе
			Части.Добавить(Событие.Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);
	
КонецФункции

Процедура ДобавитьСобытияИтилиум(События, Список)
	
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Список Цикл
		Текст = СокрЛП(Строка(ЗначениеОтветаИтилиум(Элемент, "text")));
		Если ПустаяСтрока(Текст) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСобытия = События.Добавить();
		СтрокаСобытия.Текст = Текст;
		ДатаСтрокой = СокрЛП(Строка(ЗначениеОтветаИтилиум(Элемент, "date")));
		Если ЗначениеЗаполнено(ДатаСтрокой) Тогда
			Попытка
				СтрокаСобытия.Дата = Дата(ДатаСтрокой);
			Исключение
				СтрокаСобытия.Дата = '00010101';
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаписатьОбновленияОбращений(Обращения, Результат)
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Для Каждого Обращение Из Обращения Цикл
			Если ЗаписатьОбновлениеОбращения(Обращение) Тогда
				Результат.Обновлено = Результат.Обновлено + 1;
			КонецЕсли;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Результат.Успех = Ложь;
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

Функция ЗаписатьОбновлениеОбращения(Обращение)
	
	Если Не ПризнакОтветаИтилиум(Обращение, "found") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначениеОтветаИтилиум(Обращение, "error")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Идентификатор = СокрЛП(Строка(ЗначениеОтветаИтилиум(Обращение, "externalID")));
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.эв_ОбращенияВТехподдержку.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.id = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Статус = СтатусОбращенияИтилиум(ЗначениеОтветаИтилиум(Обращение, "state"), ПризнакОтветаИтилиум(Обращение, "closed"));
	Если ЗначениеЗаполнено(Статус) Тогда
		МенеджерЗаписи.Статус = Статус;
	КонецЕсли;
	МенеджерЗаписи.ТекстОтвета = ТекстОтветаИтилиум(Обращение);
	
	ВложенияИтилиум = СкриншотыИзОтветаИтилиум(ЗначениеОтветаИтилиум(Обращение, "files"));
	Если ВложенияИтилиум.Количество() > 0 Тогда
		МенеджерЗаписи.Скриншоты = Новый ХранилищеЗначения(
			ОбъединитьСкриншоты(МенеджерЗаписи.Скриншоты, ВложенияИтилиум));
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
	Возврат Истина;
	
КонецФункции

Функция СтатусОбращенияИтилиум(Состояние, Закрыто)
	
	Имя = СокрЛП(Строка(Состояние));
	Если ИменаСостоянийСовпадают(Имя, "В Работе") Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.ВРаботе;
	КонецЕсли;
	Если ИменаСостоянийСовпадают(Имя, "Выполнено") Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.Выполнено;
	КонецЕсли;
	Если ИменаСостоянийСовпадают(Имя, "Отменено") Тогда
		СтатусОтменено = СтатусОбращенияПоИмени("Отменено");
		Если ЗначениеЗаполнено(СтатусОтменено) Тогда
			Возврат СтатусОтменено;
		КонецЕсли;
	КонецЕсли;
	
	// Остальные состояния Итилиум, в том числе пустое и закрытые без точного соответствия.
	Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.КВыполнению;
	
КонецФункции

Функция СостояниеИтилиумПоСтатусу(Статус)
	
	Если Статус = Перечисления.эв_СтатусыОбращенийВТехподдержку.ВРаботе Тогда
		Возврат "В Работе";
	КонецЕсли;
	Если Статус = Перечисления.эв_СтатусыОбращенийВТехподдержку.Выполнено Тогда
		Возврат "Выполнено";
	КонецЕсли;
	Если XMLСтрока(Статус) = "Отменено" Тогда
		Возврат "Отменено";
	КонецЕсли;
	
	// КВыполнению и прочие — состояние по умолчанию для новых обращений.
	Возврат "В обработке";
	
КонецФункции

Функция СтатусОбращенияПоИмени(ИмяСтатуса)
	
	Если Метаданные.Перечисления.эв_СтатусыОбращенийВТехподдержку.ЗначенияПеречисления.Найти(ИмяСтатуса) = Неопределено Тогда
		Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Перечисления.эв_СтатусыОбращенийВТехподдержку[ИмяСтатуса];
	
КонецФункции

Функция ИменаСостоянийСовпадают(Левое, Правое)
	
	Возврат НРег(СокрЛП(Строка(Левое))) = НРег(СокрЛП(Строка(Правое)));
	
КонецФункции

Функция ТекстВHTML(Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");
	Возврат Результат;
	
КонецФункции

Функция СкриншотыВHTML(Скриншоты)
	
	ЗначениеСкриншотов = МассивСкриншотовИзХранилища(Скриншоты);
	Если ЗначениеСкриншотов.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Скриншот Из ЗначениеСкриншотов Цикл
		
		ИмяФайла = "";
		ДанныеФайла = Неопределено;
		Если ТипЗнч(Скриншот) = Тип("Структура") Тогда
			Скриншот.Свойство("ИмяФайла", ИмяФайла);
			Скриншот.Свойство("Данные", ДанныеФайла);
		КонецЕсли;
		
		Если ТипЗнч(ДанныеФайла) = Тип("Строка") И Не ПустаяСтрока(ДанныеФайла) Тогда
			Попытка
				ДанныеФайла = Base64Значение(ДанныеФайла);
			Исключение
				ДанныеФайла = Неопределено;
			КонецПопытки;
		КонецЕсли;
		
		Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Или ДанныеФайла.Размер() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТипСодержимого = ТипСодержимогоПоИмениФайла(ИмяФайла, Ложь);
		Если ПустаяСтрока(ТипСодержимого) Тогда
			Продолжить;
		КонецЕсли;
		
		Части.Добавить("<div style=""margin-bottom: 12px;"">");
		ДанныеBase64 = СтрЗаменить(Base64Строка(ДанныеФайла), Символы.ПС, "");
		ДанныеBase64 = СтрЗаменить(ДанныеBase64, Символы.ВК, "");
		Части.Добавить("<img style=""max-width: 100%;"" alt=""");
		Части.Добавить(ТекстВHTML(ИмяФайла));
		Части.Добавить(""" src=""data:");
		Части.Добавить(ТипСодержимого);
		Части.Добавить(";base64,");
		Части.Добавить(ДанныеBase64);
		Части.Добавить("""/>");
		Части.Добавить("</div>");
		
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "");
	
КонецФункции

Функция ТипСодержимогоПоИмениФайла(ИмяФайла, ПодставлятьPngПоУмолчанию = Истина)
	
	Расширение = НРег(ОбщегоНазначенияКлиентСервер.ПолучитьРасширениеИмениФайла(ИмяФайла));
	Если Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "jpg" Или Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "gif" Тогда
		Возврат "image/gif";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	ИначеЕсли Расширение = "webp" Тогда
		Возврат "image/webp";
	КонецЕсли;
	
	Если ПодставлятьPngПоУмолчанию Тогда
		Возврат "image/png";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ТекстОтветаИтилиум(Обращение)
	
	События = Новый ТаблицаЗначений;
	События.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	События.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));
	
	ДобавитьСобытияИтилиум(События, ЗначениеОтветаИтилиум(Обращение, "solutions"));
	ДобавитьСобытияИтилиум(События, ЗначениеОтветаИтилиум(Обращение, "communications"));
	События.Сортировать("Дата");
	
	Части = Новый Массив;
	Для Каждого Событие Из События Цикл
		Если ЗначениеЗаполнено(Событие.Дата) Тогда
			Части.Добавить(Формат(Событие.Дата, "ДЛФ=DT") + Символы.ПС + Событие.Текст);
		Иначе
			Части.Добавить(Событие.Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);
	
КонецФункции

Процедура ДобавитьСобытияИтилиум(События, Список)
	
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Список Цикл
		Текст = СокрЛП(Строка(ЗначениеОтветаИтилиум(Элемент, "text")));
		Если ПустаяСтрока(Текст) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСобытия = События.Добавить();
		СтрокаСобытия.Текст = Текст;
		ДатаСтрокой = СокрЛП(Строка(ЗначениеОтветаИтилиум(Элемент, "date")));
		Если ЗначениеЗаполнено(ДатаСтрокой) Тогда
			Попытка
				СтрокаСобытия.Дата = Дата(ДатаСтрокой);
			Исключение
				СтрокаСобытия.Дата = '00010101';
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

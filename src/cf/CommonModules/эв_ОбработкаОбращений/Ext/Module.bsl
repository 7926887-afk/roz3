Функция ЗначениеОтветаИтилиум(Ответ, Имя)
	
	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Возврат Ответ.Получить(Имя);
	КонецЕсли;
	
	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		Значение = Неопределено;
		Ответ.Свойство(Имя, Значение);
		Возврат Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	

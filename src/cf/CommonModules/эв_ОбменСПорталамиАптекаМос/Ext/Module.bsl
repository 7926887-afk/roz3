#Область ПрограммныйИнтерфейс

Функция ВыгрузитьОстатки(Источник, НастройкиAPI, ПолнаяВыгрузка) Экспорт

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не заполнены настройки API АптекаМос");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиAPI.Склад) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"У источника заказов не заполнен склад");
		Возврат Ложь;
	КонецЕсли;

	КодАптеки = ИдентификаторАптеки(НастройкиAPI);
	Если КодАптеки = 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Некорректный merchant: " + НастройкиAPI.merchant);
		Возврат Ложь;
	КонецЕсли;

	ТаблицаОстатков = ПолучитьОстаткиЦены(Источник, НастройкиAPI, ПолнаяВыгрузка);
	ТаблицаКОтправке = ТаблицаОстатков.СкопироватьКолонки();
	МассивЦен = СформироватьМассивЦен(ТаблицаОстатков, КодАптеки, ТаблицаКОтправке, ПолнаяВыгрузка);
	Если МассивЦен.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ТелоЗапроса = ТелоАвторизации(НастройкиAPI, Истина);
	ТелоЗапроса.Вставить("isTransact", ?(ПолнаяВыгрузка, 0, 1));
	ТелоЗапроса.Вставить("prices", МассивЦен);

	РезультатHTTP = ВыполнитьЗапрос(Источник, НастройкиAPI, "POST",
		АдресСервиса(НастройкиAPI, "/Price/WPrice/WimportPrices"),
		ТелоЗапроса, ?(ПолнаяВыгрузка, "pricesFull", "pricesInc"));

	Если Не РезультатHTTP.Успех Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Ошибка, , Источник,
			РезультатHTTP.ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	эв_ОбменСПорталамиСервер.ОбновитьСнимокОстатков(Источник, ТаблицаКОтправке, ПолнаяВыгрузка);
	Возврат Истина;

КонецФункции

Функция ЗагрузитьЗаказы(Источник, НастройкиAPI) Экспорт

	ТаблицаЗагруженных = НоваяТаблицаЗагруженныхЗаказов();

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не заполнены настройки API АптекаМос");
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиAPI.Склад) Тогда
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	КодАптеки = ИдентификаторАптеки(НастройкиAPI);
	Если КодАптеки = 0 Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Ошибка, , Источник,
			"Некорректный merchant: " + НастройкиAPI.merchant);
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	ДатаГраницы = эв_ОбменСПорталамиСервер.ДатаГраницыЗагрузкиЗаказов(Источник, "getOrders");
	Starts = СтрЗаменить(эв_ОбменСПорталамиСервер.ДатаISOСмещением(ДатаГраницы), "+", "%2B");
	АдресЗапроса = АдресСервиса(НастройкиAPI, "/Order/Order/getOrders")
		+ "?bilUserLogin=" + КодироватьСтроку(СокрЛП(НастройкиAPI.Логин), СпособКодированияСтроки.КодировкаURL)
		+ "&bilUserPassword=" + КодироватьСтроку(СокрЛП(НастройкиAPI.Пароль), СпособКодированияСтроки.КодировкаURL)
		+ "&starts=" + Starts;

	РезультатHTTP = ВыполнитьЗапрос(Источник, НастройкиAPI, "GET", АдресЗапроса, Неопределено, "getOrders");
	Если Не РезультатHTTP.Успех Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Ошибка, , Источник,
			РезультатHTTP.ТекстОшибки);
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	СписокЗаказов = ЗначениеПоляJSON(РезультатHTTP.Json, "orders");
	Если ТипЗнч(СписокЗаказов) <> Тип("Массив") Или СписокЗаказов.Количество() = 0 Тогда
		Возврат ТаблицаЗагруженных;
	КонецЕсли;

	НовыеЗаказы = Новый Массив;
	ЗагрузитьЗаказыИзJSON(Источник, НастройкиAPI, СписокЗаказов, КодАптеки, ТаблицаЗагруженных, НовыеЗаказы);
	ПодтвердитьПолучениеЗаказов(Источник, НастройкиAPI, НовыеЗаказы);

	Возврат ТаблицаЗагруженных;

КонецФункции

Функция ОтправитьСтатус(ПараметрыОчереди, НастройкиAPI) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");

	Если Не ДанныеПодключенияКорректны(НастройкиAPI) Тогда
		Результат.ТекстОшибки = "Не заполнены настройки API АптекаМос";
		Возврат Результат;
	КонецЕсли;

	КодСтатуса = эв_ОбменСПорталамиСервер.КодСтатусаПортала(
		ПараметрыОчереди.ИсточникЗаказов, ПараметрыОчереди.СтатусЗаказа, ПараметрыОчереди.ЗаказПокупателя);
	СтатусПортала = ВРег(СокрЛП(КодСтатуса));
	СостояниеНовый = эв_ОбменСПорталамиСервер.СостояниеНовыйЗаказа(НастройкиAPI.Вид);
	ЭтоПринятие = ПараметрыОчереди.СтатусЗаказа = СостояниеНовый Или СтатусПортала = "ACCEPTED";

	Если Не ЭтоПринятие И СтатусНеОтправляется(СтатусПортала) Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КодСтатуса) И Не ЭтоПринятие Тогда
		Результат.ТекстОшибки = "Не задан код статуса портала для состояния заказа";
		Возврат Результат;
	КонецЕсли;

	НомерНаСайте = эв_ОбменСПорталамиСервер.НомерЗаказаНаСайте(ПараметрыОчереди.ЗаказПокупателя);
	НомерЗаказа = ЧислоИзJSON(НомерНаСайте);
	Если НомерЗаказа = 0 Тогда
		Результат.ТекстОшибки = "Не найден числовой номер заказа на портале";
		Возврат Результат;
	КонецЕсли;

	Если Не ЭтоПринятие И СтатусМеняетСостав(СтатусПортала) Тогда
		РезультатСостава = ОтправитьСоставЗаказа(ПараметрыОчереди.ИсточникЗаказов, НастройкиAPI,
			ПараметрыОчереди.ЗаказПокупателя, НомерЗаказа);
		Если Не РезультатСостава.Успех Тогда
			Результат.ТекстОшибки = РезультатСостава.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	ПараметрСтатуса = ПараметрСтатусаЗаказа(ПараметрыОчереди.ЗаказПокупателя, НомерЗаказа, КодСтатуса, ЭтоПринятие);
	ПараметрыСтатусов = Новый Массив;
	ПараметрыСтатусов.Добавить(ПараметрСтатуса);

	ТелоЗапроса = ТелоАвторизации(НастройкиAPI, Ложь);
	ТелоЗапроса.Вставить("params", ПараметрыСтатусов);

	РезультатHTTP = ВыполнитьЗапрос(ПараметрыОчереди.ИсточникЗаказов, НастройкиAPI, "POST",
		АдресСервиса(НастройкиAPI, "/Order/Order/setOrders"),
		ТелоЗапроса, "setOrders", ПараметрыОчереди.ЗаказПокупателя);

	Результат.Успех = РезультатHTTP.Успех;
	Результат.ТекстОшибки = ТекстОшибкиОтвета(РезультатHTTP);
	Возврат Результат;

КонецФункции

Функция ДанныеПодключенияКорректны(НастройкиAPI) Экспорт

	Если ТипЗнч(НастройкиAPI) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПолеЗаполнено(НастройкиAPI, "Адрес")
		И ПолеЗаполнено(НастройкиAPI, "Логин")
		И ПолеЗаполнено(НастройкиAPI, "Пароль")
		И ПолеЗаполнено(НастройкиAPI, "merchant");
		//И ПолеЗаполнено(НастройкиAPI, "ЛогинФТП")
		//И ПолеЗаполнено(НастройкиAPI, "ПарольФТП")

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(Источник, НастройкиAPI, Метод, Адрес, Тело, Контур, ЗаказПокупателя = Неопределено)

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ИсточникЗаказов", Источник);
	ПараметрыЗапроса.Вставить("Метод", Метод);
	ПараметрыЗапроса.Вставить("Адрес", Адрес);
	ПараметрыЗапроса.Вставить("Контур", Контур);
	ПараметрыЗапроса.Вставить("Заголовки", ЗаголовкиПортала());
	Если Тело <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("Тело", Тело);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ПараметрыЗапроса.Вставить("ЗаказПокупателя", ЗаказПокупателя);
	КонецЕсли;
	Если ПолеЗаполнено(НастройкиAPI, "Пароль") Тогда
		ПараметрыЗапроса.Вставить("ПарольДляМаскировки", НастройкиAPI.Пароль);
	КонецЕсли;
	Если ПолеЗаполнено(НастройкиAPI, "ПарольФТП") Тогда
		ПараметрыЗапроса.Вставить("ПарольФТПДляМаскировки", НастройкиAPI.ПарольФТП);
	КонецЕсли;

	РезультатHTTP = эв_ОбменСПорталамиСервер.ВыполнитьЗапросHTTP(ПараметрыЗапроса);
	УчестьКодОтвета(РезультатHTTP);
	Возврат РезультатHTTP;

КонецФункции

Функция ЗаголовкиПортала()

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Возврат Заголовки;

КонецФункции

Функция АдресСервиса(НастройкиAPI, Путь)

	Возврат эв_ОбменСПорталамиСервер.БазовыйАдресAPI(НастройкиAPI) + Путь;

КонецФункции

Функция ТелоАвторизации(НастройкиAPI, ДляПрайса)

	ТелоЗапроса = Новый Структура;
	Если ДляПрайса Тогда
		ТелоЗапроса.Вставить("bilUserLogin", СокрЛП(НастройкиAPI.ЛогинФТП));
		ТелоЗапроса.Вставить("bilUserPassword", СокрЛП(НастройкиAPI.ПарольФТП));
	Иначе
		ТелоЗапроса.Вставить("bilUserLogin", СокрЛП(НастройкиAPI.Логин));
		ТелоЗапроса.Вставить("bilUserPassword", СокрЛП(НастройкиAPI.Пароль));
	КонецЕсли;
	Возврат ТелоЗапроса;

КонецФункции

Процедура УчестьКодОтвета(РезультатHTTP)

	Если Не РезультатHTTP.Успех Тогда
		Возврат;
	КонецЕсли;

	КодОтвета = ЗначениеПоляJSON(РезультатHTTP.Json, "code");
	Если КодОтвета = Неопределено Или ЧислоИзJSON(КодОтвета) >= 1 Тогда
		Возврат;
	КонецЕсли;

	РезультатHTTP.Успех = Ложь;
	Описание = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(РезультатHTTP.Json, "description")));
	Если ЗначениеЗаполнено(Описание) Тогда
		РезультатHTTP.ТекстОшибки = Описание;
	Иначе
		РезультатHTTP.ТекстОшибки = "Портал вернул код ошибки " + СтрокаИзJSON(КодОтвета);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьОстаткиЦены(Источник, НастройкиAPI, ПолнаяВыгрузка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Склад
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(, СтруктурнаяЕдиница = &Склад) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура,
		|	Остатки.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Резервы.Номенклатура КАК Номенклатура,
		|	Резервы.Характеристика КАК Характеристика,
		|	СУММА(Резервы.КоличествоОстаток) КАК РезервОстаток
		|ПОМЕСТИТЬ ВТ_Резервы
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(
		|			,
		|			СтруктурнаяЕдиница = &Склад
		|				И ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК Резервы
		|
		|СГРУППИРОВАТЬ ПО
		|	Резервы.Номенклатура,
		|	Резервы.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Склад.Номенклатура КАК Номенклатура,
		|	ВТ_Склад.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0) < 0
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_Склад.КоличествоОстаток - ЕСТЬNULL(ВТ_Резервы.РезервОстаток, 0)
		|	КОНЕЦ КАК ДоступныйОстаток,
		|	ВТ_Склад.Номенклатура.ор_ЕГК КАК ор_ЕГК,
		|	ВТ_Склад.Номенклатура.Наименование КАК Наименование,
		|	ВТ_Склад.Номенклатура.ЦеноваяГруппа КАК ЦеноваяГруппа,
		|	ЕСТЬNULL(ВТ_Склад.Номенклатура.ЦеноваяГруппа.Наименование, """") КАК ЦеноваяГруппаНаименование,
		|	ВТ_Склад.Характеристика.ор_СрокГодности КАК СрокГодности
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	ВТ_Склад КАК ВТ_Склад
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Резервы КАК ВТ_Резервы
		|		ПО ВТ_Склад.Номенклатура = ВТ_Резервы.Номенклатура
		|			И ВТ_Склад.Характеристика = ВТ_Резервы.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	Цены.Характеристика КАК Характеристика,
		|	МАКСИМУМ(Цены.Цена) КАК Цена
		|ПОМЕСТИТЬ ВТ_Цены
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦен = &ВидЦен) КАК Цены
		|
		|СГРУППИРОВАТЬ ПО
		|	Цены.Номенклатура,
		|	Цены.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Остатки.Номенклатура КАК Номенклатура,
		|	ВТ_Остатки.Характеристика КАК Характеристика,
		|	ВТ_Остатки.ДоступныйОстаток КАК ДоступныйОстаток,
		|	ВТ_Остатки.ор_ЕГК КАК ор_ЕГК,
		|	ВТ_Остатки.Наименование КАК Наименование,
		|	ВТ_Остатки.СрокГодности КАК СрокГодности,
		|	ВЫБОР
		|		КОГДА ВРЕГ(ВТ_Остатки.ЦеноваяГруппаНаименование) = ""ЭВАЛАР""
		|			ТОГДА ЕСТЬNULL(ЦеныБезХарактеристики.Цена, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЦеныСХарактеристикой.Цена, 0)
		|	КОНЕЦ КАК Цена
		|ПОМЕСТИТЬ ВТ_Текущие
		|ИЗ
		|	ВТ_Остатки КАК ВТ_Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ЦеныБезХарактеристики
		|		ПО ВТ_Остатки.Номенклатура = ЦеныБезХарактеристики.Номенклатура
		|			И (ЦеныБезХарактеристики.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|			И (ВРЕГ(ВТ_Остатки.ЦеноваяГруппаНаименование) = ""ЭВАЛАР"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ЦеныСХарактеристикой
		|		ПО ВТ_Остатки.Номенклатура = ЦеныСХарактеристикой.Номенклатура
		|			И ВТ_Остатки.Характеристика = ЦеныСХарактеристикой.Характеристика
		|			И (ВРЕГ(ВТ_Остатки.ЦеноваяГруппаНаименование) <> ""ЭВАЛАР"")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Снимок.Номенклатура КАК Номенклатура,
		|	Снимок.Характеристика КАК Характеристика,
		|	Снимок.Цена КАК Цена,
		|	Снимок.ДоступныйОстаток КАК ДоступныйОстаток
		|ПОМЕСТИТЬ ВТ_Снимок
		|ИЗ
		|	РегистрСведений.эв_ВыгруженныеОстаткиПорталов КАК Снимок
		|ГДЕ
		|	Снимок.ИсточникЗаказов = &Источник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_Текущие.Номенклатура, ВТ_Снимок.Номенклатура) КАК Номенклатура,
		|	ЕСТЬNULL(ВТ_Текущие.Характеристика, ВТ_Снимок.Характеристика) КАК Характеристика,
		|	ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) КАК ДоступныйОстаток,
		|	ЕСТЬNULL(ВТ_Текущие.Цена, ВТ_Снимок.Цена) КАК Цена,
		|	ЕСТЬNULL(ВТ_Текущие.ор_ЕГК, ВЫРАЗИТЬ(ЕСТЬNULL(ВТ_Снимок.Номенклатура.ор_ЕГК, """") КАК СТРОКА(20))) КАК ор_ЕГК,
		|	ЕСТЬNULL(ВТ_Текущие.Наименование, ВТ_Снимок.Номенклатура.Наименование) КАК Наименование,
		|	ЕСТЬNULL(ВТ_Текущие.СрокГодности, ВТ_Снимок.Характеристика.ор_СрокГодности) КАК СрокГодности,
		|	ВЫБОР
		|		КОГДА ВТ_Снимок.Номенклатура ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьВСнимке
		|ИЗ
		|	ВТ_Текущие КАК ВТ_Текущие
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Снимок КАК ВТ_Снимок
		|		ПО ВТ_Текущие.Номенклатура = ВТ_Снимок.Номенклатура
		|			И ВТ_Текущие.Характеристика = ВТ_Снимок.Характеристика
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ПолнаяВыгрузка
		|				ТОГДА ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) >= 1
		|			КОГДА ВТ_Снимок.Номенклатура ЕСТЬ NULL
		|				ТОГДА ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) >= 1
		|			ИНАЧЕ ЕСТЬNULL(ВТ_Текущие.ДоступныйОстаток, 0) <> ЕСТЬNULL(ВТ_Снимок.ДоступныйОстаток, 0)
		|					ИЛИ ЕСТЬNULL(ВТ_Текущие.Цена, 0) <> ЕСТЬNULL(ВТ_Снимок.Цена, 0)
		|		КОНЕЦ";

	Запрос.УстановитьПараметр("Склад", НастройкиAPI.Склад);
	Запрос.УстановитьПараметр("ВидЦен", НастройкиAPI.ВидЦен);
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("ПолнаяВыгрузка", ПолнаяВыгрузка);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция СформироватьМассивЦен(ТаблицаОстатков, ИдентификаторАптеки, ТаблицаКОтправке, ПолнаяВыгрузка)

	МассивЦен = Новый Массив;
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл

		КодЕГК = СтрЗаменить(СокрЛП(СтрокаОстатка.ор_ЕГК), " ", "");
		Если Не ЗначениеЗаполнено(КодЕГК) Тогда
			Продолжить;
		КонецЕсли;

		Удаление = Не ПолнаяВыгрузка И СтрокаОстатка.ДоступныйОстаток <= 0;
		Если СтрокаОстатка.Цена = 0 И Не Удаление Тогда
			Продолжить;
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(ТаблицаКОтправке.Добавить(), СтрокаОстатка);

		Позиция = Новый Структура;
		Позиция.Вставить("org_id", ИдентификаторАптеки);
		Позиция.Вставить("drug_id", ПривестиКодЕГК(КодЕГК));
		Позиция.Вставить("item_id", XMLСтрока(СтрокаОстатка.Номенклатура));
		Позиция.Вставить("item_name", СокрЛП(СтрокаОстатка.Наименование));
		Позиция.Вставить("price", Окр(СтрокаОстатка.Цена, 2));
		Позиция.Вставить("qtty", ?(Удаление, 0, СтрокаОстатка.ДоступныйОстаток));
		Позиция.Вставить("reserv", 1);

		Если ЗначениеЗаполнено(СтрокаОстатка.СрокГодности) Тогда
			Позиция.Вставить("item_code", Формат(СтрокаОстатка.СрокГодности, "ДФ=dd.MM.yyyy"));
		КонецЕсли;

		Если Не ПолнаяВыгрузка Тогда
			Если Удаление Тогда
				Позиция.Вставить("operation", "DELETE");
			ИначеЕсли Не СтрокаОстатка.ЕстьВСнимке Тогда
				Позиция.Вставить("operation", "CREATE");
			Иначе
				Позиция.Вставить("operation", "UPDATE");
			КонецЕсли;
		КонецЕсли;

		МассивЦен.Добавить(Позиция);

	КонецЦикла;

	Возврат МассивЦен;

КонецФункции

Функция ПривестиКодЕГК(КодЕГК)

	Попытка
		Возврат Число(КодЕГК);
	Исключение
		Возврат КодЕГК;
	КонецПопытки;

КонецФункции

Функция ИдентификаторАптеки(НастройкиAPI)

	Попытка
		Возврат Число(СтрЗаменить(СокрЛП(НастройкиAPI.merchant), " ", ""));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Процедура ЗагрузитьЗаказыИзJSON(Источник, НастройкиAPI, СписокЗаказов, ИдентификаторАптеки, ТаблицаЗагруженных, НовыеЗаказы)

	ДанныеВыкуплен = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "PURCHASED");
	ДанныеНеВыкуплен = эв_ОбменСПорталамиСервер.СостояниеПоКодуПортала(Источник, "NOT_PURCHASED");

	Для Каждого ОбъектЗаказа Из СписокЗаказов Цикл

		Если ЧислоИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "orgId")) <> ИдентификаторАптеки Тогда
			Продолжить;
		КонецЕсли;

		НомерНаСайте = НомерЗаказаПортала(ЗначениеПоляJSON(ОбъектЗаказа, "orderNum"));
		Если Не ЗначениеЗаполнено(НомерНаСайте) Или ЧислоИзJSON(НомерНаСайте) = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтатусПортала = ВРег(СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "orderStat"))));
		СуществующийЗаказ = эв_ОбменСПорталамиСервер.НайтиЗаказПоНомеруНаСайте(НомерНаСайте, Источник);

		Если ЗначениеЗаполнено(СуществующийЗаказ) Тогда
			Если СтатусПортала = "CANCELLED" Тогда
				ОтменитьЗаказНаСайте(СуществующийЗаказ, Источник, Справочники.ПричиныОтменыЗаказа.ОтмененСервисом);
			ИначеЕсли СтатусПортала = "PURCHASED" И ЗначениеЗаполнено(ДанныеВыкуплен.ВидСтатуса) Тогда
				ПрименитьСтатусПортала(СуществующийЗаказ, Источник, ДанныеВыкуплен, Ложь);
			ИначеЕсли СтатусПортала = "NOT_PURCHASED" Тогда
				ПрименитьСтатусПортала(СуществующийЗаказ, Источник, ДанныеНеВыкуплен, Истина);
			КонецЕсли;
			ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, СуществующийЗаказ, НомерНаСайте, Ложь);
			Продолжить;
		КонецЕсли;

		Если СтатусБезСозданияЗаказа(СтатусПортала) Тогда
			Продолжить;
		КонецЕсли;

		ДанныеЗаказа = РазобратьЗаказ(ОбъектЗаказа, НомерНаСайте, СтатусПортала);
		Если ДанныеЗаказа.Товары.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Предупреждение, , Источник,
				СтрШаблон("Заказ %1 не создан: нет позиций", НомерНаСайте));
			Продолжить;
		КонецЕсли;

		Попытка
			ЗаказСсылка = эв_ОбменСПорталамиСервер.СоздатьЗаказПортала(Источник, НастройкиAPI, ДанныеЗаказа);
		Исключение
			ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Ошибка, , Источник,
				СтрШаблон("Ошибка создания заказа %1: %2", НомерНаСайте, ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;

		Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
			Продолжить;
		КонецЕсли;

		Если СтатусПортала = "PURCHASED" И ЗначениеЗаполнено(ДанныеВыкуплен.ВидСтатуса) Тогда
			ПрименитьСтатусПортала(ЗаказСсылка, Источник, ДанныеВыкуплен, Ложь);
		КонецЕсли;

		ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, ЗаказСсылка, НомерНаСайте, Истина);
		НовыеЗаказы.Добавить(Новый Структура(
			"ЗаказПокупателя, Номер, Статус, Сумма",
			ЗаказСсылка, НомерНаСайте, СтатусПортала, ДанныеЗаказа.Сумма));

	КонецЦикла;

КонецПроцедуры

Функция РазобратьЗаказ(ОбъектЗаказа, НомерНаСайте, СтатусПортала)

	ФИО = РазобратьФИО(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "custFullName")));
	ТипЗаказа = ВРег(СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "orderType"))));
	АдресДоставки = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "custDelivAddr")));

	Комментарии = Новый Массив;
	ДобавитьНепустойКомментарий(Комментарии, ЗначениеПоляJSON(ОбъектЗаказа, "custComment"));
	ДобавитьНепустойКомментарий(Комментарии, ЗначениеПоляJSON(ОбъектЗаказа, "orderStatComment"));
	ДобавитьНепустойКомментарий(Комментарии, ЗначениеПоляJSON(ОбъектЗаказа, "operComment"));

	ТекстЗаказа = "";
	Попытка
		ТекстЗаказа = КоннекторHTTP.ОбъектВJson(ОбъектЗаказа);
	Исключение
		ТекстЗаказа = "";
	КонецПопытки;

	ДанныеЗаказа = Новый Структура;
	ДанныеЗаказа.Вставить("НомерНаСайте", НомерНаСайте);
	ДанныеЗаказа.Вставить("ИдентификаторНаПортале", НомерНаСайте);
	ДанныеЗаказа.Вставить("Дата", ДатаИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "orderTime")));
	ДанныеЗаказа.Вставить("Фамилия", ФИО.Фамилия);
	ДанныеЗаказа.Вставить("Имя", ФИО.Имя);
	ДанныеЗаказа.Вставить("Отчество", ФИО.Отчество);
	ДанныеЗаказа.Вставить("Почта", СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "custEmail"))));
	ДанныеЗаказа.Вставить("Телефон", ПривестиТелефон(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "custPhone"))));
	ДанныеЗаказа.Вставить("Комментарий", СтрСоединить(Комментарии, Символы.ПС));
	ДанныеЗаказа.Вставить("Сумма", ЧислоИзJSON(ЗначениеПоляJSON(ОбъектЗаказа, "orderRealSum")));
	ДанныеЗаказа.Вставить("ОплаченНаПортале", СтатусПортала = "PURCHASED");
	ДанныеЗаказа.Вставить("ИсходныйПакетJSON", ТекстЗаказа);
	ДанныеЗаказа.Вставить("Товары", Новый Массив);
	Если ТипЗаказа = "DELIVERY" Тогда
		ДанныеЗаказа.Вставить("СпособДоставки", Перечисления.СпособыДоставки.Курьер);
		ДанныеЗаказа.Вставить("АдресДоставки", ?(ЗначениеЗаполнено(АдресДоставки), АдресДоставки, "Доставка"));
	Иначе
		ДанныеЗаказа.Вставить("СпособДоставки", Перечисления.СпособыДоставки.Самовывоз);
		ДанныеЗаказа.Вставить("АдресДоставки", "Самовывоз");
	КонецЕсли;

	Позиции = ЗначениеПоляJSON(ОбъектЗаказа, "positions");
	Если ТипЗнч(Позиции) <> Тип("Массив") Тогда
		Возврат ДанныеЗаказа;
	КонецЕсли;

	КэшСерийныхВидов = Новый Соответствие;
	Для Каждого ОбъектПозиции Из Позиции Цикл

		ИдПозиции = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектПозиции, "itemId")));
		ИдТовара = НомерЗаказаПортала(ЗначениеПоляJSON(ОбъектПозиции, "drugId"));
		ИмяТовара = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектПозиции, "itemName")));
		Если Не ЗначениеЗаполнено(ИмяТовара) Тогда
			ИмяТовара = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(ОбъектПозиции, "drugName")));
		КонецЕсли;

		СтрокаТовара = Новый Структура;
		СтрокаТовара.Вставить("ИдПозиции", ИдПозиции);
		СтрокаТовара.Вставить("ИдТовара", ИдТовара);
		СтрокаТовара.Вставить("ИмяТовара", ИмяТовара);
		СтрокаТовара.Вставить("Номенклатура", эв_ОбменСПорталамиСервер.НоменклатураПоИдентификаторуПортала(ИдПозиции));
		СтрокаТовара.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		СтрокаТовара.Вставить("Количество", ЧислоИзJSON(ЗначениеПоляJSON(ОбъектПозиции, "qtty")));
		СтрокаТовара.Вставить("Цена", ЧислоИзJSON(ЗначениеПоляJSON(ОбъектПозиции, "price")));
		СтрокаТовара.Вставить("Серия", СерияПозиции(ЗначениеПоляJSON(ОбъектПозиции, "itemCode")));
		ДобавитьСтрокиТовараЗаказа(ДанныеЗаказа.Товары, СтрокаТовара, КэшСерийныхВидов);

	КонецЦикла;

	Возврат ДанныеЗаказа;

КонецФункции

Функция СерияПозиции(ЗначениеКода)

	Текст = СокрЛП(СтрокаИзJSON(ЗначениеКода));
	Если СтрДлина(Текст) = 10 И Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Процедура ДобавитьСтрокиТовараЗаказа(Товары, СтрокаТовара, КэшСерийныхВидов)

	КоличествоШтук = Цел(СтрокаТовара.Количество);
	Если КоличествоШтук < 2
		Или СтрокаТовара.Количество <> КоличествоШтук
		Или Не эв_ОбменСПорталамиСервер.ТоварКатегорииСерийный(СтрокаТовара.Номенклатура, КэшСерийныхВидов) Тогда
		Товары.Добавить(СтрокаТовара);
		Возврат;
	КонецЕсли;

	// Сумма позиции сайта — цена * количество, в копейках. Остаток копеек
	// кладётся на последние строки, чтобы сумма строк совпала с позицией сайта.
	СуммаКопеек = Окр(Окр(СтрокаТовара.Цена * СтрокаТовара.Количество, 2) * 100, 0);
	ЦенаКопеек = Цел(СуммаКопеек / КоличествоШтук);
	ОстатокКопеек = СуммаКопеек - ЦенаКопеек * КоличествоШтук;

	Для Номер = 1 По КоличествоШтук Цикл
		КопеекСтроки = ЦенаКопеек;
		Если Номер > КоличествоШтук - ОстатокКопеек Тогда
			КопеекСтроки = КопеекСтроки + 1;
		КонецЕсли;
		Товары.Добавить(КопияСтрокиТовара(СтрокаТовара, 1, КопеекСтроки / 100));
	КонецЦикла;

КонецПроцедуры

Функция КопияСтрокиТовара(СтрокаТовара, Количество, Цена)

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из СтрокаТовара Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Копия.Количество = Количество;
	Копия.Цена = Цена;
	Возврат Копия;

КонецФункции

Процедура ПодтвердитьПолучениеЗаказов(Источник, НастройкиAPI, НовыеЗаказы)

	ПараметрыПринятия = Новый Массив;
	ЗаказыКПовтору = Новый Массив;
	Для Каждого НовыйЗаказ Из НовыеЗаказы Цикл
		Если Не СтатусКПринятию(НовыйЗаказ.Статус) Тогда
			Продолжить;
		КонецЕсли;
		НомерЗаказа = ЧислоИзJSON(НовыйЗаказ.Номер);
		Если НомерЗаказа = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПараметрСтатуса = Новый Структура;
		ПараметрСтатуса.Вставить("orderNum", НомерЗаказа);
		ПараметрСтатуса.Вставить("orderStat", "ACCEPTED");
		Если НовыйЗаказ.Сумма <> 0 Тогда
			ПараметрСтатуса.Вставить("orderRealSum", НовыйЗаказ.Сумма);
		КонецЕсли;
		ПараметрыПринятия.Добавить(ПараметрСтатуса);
		ЗаказыКПовтору.Добавить(НовыйЗаказ);
	КонецЦикла;

	Если ПараметрыПринятия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТелоЗапроса = ТелоАвторизации(НастройкиAPI, Ложь);
	ТелоЗапроса.Вставить("params", ПараметрыПринятия);
	РезультатHTTP = ВыполнитьЗапрос(Источник, НастройкиAPI, "POST",
		АдресСервиса(НастройкиAPI, "/Order/Order/setOrders"),
		ТелоЗапроса, "accept");

	Если РезультатHTTP.Успех Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Ошибка, , Источник,
		ТекстОшибкиОтвета(РезультатHTTP));
	Для Каждого НовыйЗаказ Из ЗаказыКПовтору Цикл
		ПоставитьЗаказНовыйВОчередь(НовыйЗаказ.ЗаказПокупателя, Источник, НастройкиAPI);
	КонецЦикла;

КонецПроцедуры

Процедура ПоставитьЗаказНовыйВОчередь(ЗаказПокупателя, Источник, НастройкиAPI)

	СтатусНовый = эв_ОбменСПорталамиСервер.СостояниеНовыйЗаказа(НастройкиAPI.Вид);
	Если ЗначениеЗаполнено(СтатусНовый) Тогда
		эв_ОбменСПорталамиСервер.ПоставитьЗаказВОчередьСтатусов(ЗаказПокупателя, Источник, СтатусНовый, , Истина);
	КонецЕсли;

КонецПроцедуры

Функция ОтправитьСоставЗаказа(Источник, НастройкиAPI, ЗаказПокупателя, НомерЗаказа)

	Результат = Новый Структура("Успех, ТекстОшибки", Истина, "");
	Позиции = ПозицииФактическойСборки(ЗаказПокупателя, НомерЗаказа);
	Если Позиции.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ТелоЗапроса = ТелоАвторизации(НастройкиAPI, Ложь);
	ТелоЗапроса.Вставить("positions", Позиции);
	РезультатHTTP = ВыполнитьЗапрос(Источник, НастройкиAPI, "POST",
		АдресСервиса(НастройкиAPI, "/Order/Order/setOrdersPositions"),
		ТелоЗапроса, "setPositions", ЗаказПокупателя);

	Результат.Успех = РезультатHTTP.Успех;
	Результат.ТекстОшибки = ТекстОшибкиОтвета(РезультатHTTP);
	Возврат Результат;

КонецФункции

Функция ПараметрСтатусаЗаказа(ЗаказПокупателя, НомерЗаказа, КодСтатуса, ЭтоПринятие)

	СтатусПортала = ВРег(СокрЛП(КодСтатуса));
	ПараметрСтатуса = Новый Структура;
	ПараметрСтатуса.Вставить("orderNum", НомерЗаказа);

	Если ЭтоПринятие Тогда
		ПараметрСтатуса.Вставить("orderStat", "ACCEPTED");
		Если ЗначениеЗаполнено(КодСтатуса) И Не ЭтоСтатусАптекаМос(СтатусПортала) Тогда
			ПараметрСтатуса.Вставить("orderExtStatId", СокрЛП(КодСтатуса));
		КонецЕсли;
	ИначеЕсли ЭтоСтатусАптекаМос(СтатусПортала) Тогда
		ПараметрСтатуса.Вставить("orderStat", СтатусПортала);
	Иначе
		ПараметрСтатуса.Вставить("orderExtStatId", СокрЛП(КодСтатуса));
	КонецЕсли;

	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗаказПокупателя, "СуммаДокумента, ВариантЗавершения, Заметки");
	Если ТипЗнч(РеквизитыЗаказа.СуммаДокумента) = Тип("Число") Тогда
		ПараметрСтатуса.Вставить("orderRealSum", РеквизитыЗаказа.СуммаДокумента);
	КонецЕсли;
	Если РеквизитыЗаказа.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен Тогда
		Комментарий = СокрЛП(Строка(РеквизитыЗаказа.Заметки));
		Если ЗначениеЗаполнено(Комментарий) Тогда
			ПараметрСтатуса.Вставить("orderStatComment", Комментарий);
		КонецЕсли;
	КонецЕсли;

	Возврат ПараметрСтатуса;

КонецФункции

Функция ПозицииФактическойСборки(ЗаказПокупателя, НомерЗаказа)

	Позиции = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказыСайта.эв_ИсходныйПакет КАК ИсходныйПакет
		|ИЗ
		|	РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыСайта
		|ГДЕ
		|	ЗаказыСайта.ЗаказПокупателя = &ЗаказПокупателя
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Запасы.эв_ИдентификаторПозицииПортала КАК ИдПозиции,
		|	СУММА(Запасы.КоличествоСобрано) КАК Количество
		|ИЗ
		|	Документ.ЗаказПокупателя.Запасы КАК Запасы
		|ГДЕ
		|	Запасы.Ссылка = &ЗаказПокупателя
		|
		|СГРУППИРОВАТЬ ПО
		|	Запасы.эв_ИдентификаторПозицииПортала";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);

	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаПакета = Результаты[0].Выбрать();
	Если Не ВыборкаПакета.Следующий() Или ВыборкаПакета.ИсходныйПакет = Неопределено Тогда
		Возврат Позиции;
	КонецЕсли;

	ТекстПакета = ВыборкаПакета.ИсходныйПакет.Получить();
	Если ТипЗнч(ТекстПакета) <> Тип("Строка") Или Не ЗначениеЗаполнено(ТекстПакета) Тогда
		Возврат Позиции;
	КонецЕсли;

	Попытка
		ПакетJSON = КоннекторHTTP.JsonВОбъект(ТекстПакета);
	Исключение
		Возврат Позиции;
	КонецПопытки;

	СтрокиПортала = ЗначениеПоляJSON(ПакетJSON, "positions");
	Если ТипЗнч(СтрокиПортала) <> Тип("Массив") Тогда
		Возврат Позиции;
	КонецЕсли;

	КоличествоПоПозициям = Новый Соответствие;
	СобраноВсего = 0;
	ВыборкаСтрок = Результаты[1].Выбрать();
	Пока ВыборкаСтрок.Следующий() Цикл
		ИдПозиции = ?(СокрЛП(ВыборкаСтрок.ИдПозиции) = "","0",СокрЛП(ВыборкаСтрок.ИдПозиции));
		КоличествоПоПозициям.Вставить(ИдПозиции, ВыборкаСтрок.Количество);
		СобраноВсего = СобраноВсего + ВыборкаСтрок.Количество;
	КонецЦикла;

	Если СобраноВсего <= 0 Тогда
		Возврат Позиции;
	КонецЕсли;

	Для Каждого СтрокаПортала Из СтрокиПортала Цикл

		ИдПозиции = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(СтрокаПортала, "itemId")));
		КодЕГК = ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "drugId"));
		Если Не ЗначениеЗаполнено(ИдПозиции) И КодЕГК = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоФакт = 0;
		Если ЗначениеЗаполнено(ИдПозиции) Тогда
			КоличествоСтроки = КоличествоПоПозициям.Получить(ИдПозиции);
			Если КоличествоСтроки <> Неопределено Тогда
				КоличествоФакт = КоличествоСтроки;
			КонецЕсли;
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("orderNum", НомерЗаказа);
		Если ЗначениеЗаполнено(ИдПозиции) Тогда
			Позиция.Вставить("itemId", ИдПозиции);
		КонецЕсли;
		Если КодЕГК <> 0 Тогда
			Позиция.Вставить("drugId", КодЕГК);
		КонецЕсли;
		Позиция.Вставить("price", ЧислоИзJSON(ЗначениеПоляJSON(СтрокаПортала, "price")));
		Если КоличествоФакт <= 0 Тогда
			Позиция.Вставить("operation", "DELETE");
		Иначе
			Позиция.Вставить("qtty", КоличествоФакт);
			Позиция.Вставить("operation", "UPDATE");
		КонецЕсли;
		Позиции.Добавить(Позиция);

	КонецЦикла;

	Возврат Позиции;

КонецФункции

Процедура ПрименитьСтатусПортала(ЗаказПокупателя, Источник, ДанныеСтатуса, ЭтоОтменаПортала)

	СостояниеЗаказа = ДанныеСтатуса.ВидСтатуса;
	ПричинаОтмены = ДанныеСтатуса.ПричинаОтмены;
	Если ЭтоОтменаПортала И Не ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен;
		ПричинаОтмены = Справочники.ПричиныОтменыЗаказа.ОтмененСервисом;
	КонецЕсли;
	Позитив = Не ЗначениеЗаполнено(ПричинаОтмены);

	Если Не ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Предупреждение, , Источник,
			"Не найден код статуса в регистре кодов статусов портала");
		Возврат;
	КонецЕсли;

	Если СостояниеЗаказаУжеУстановлено(ЗаказПокупателя, СостояниеЗаказа, Позитив) Тогда
		Возврат;
	КонецЕсли;

	Если СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен И Не Позитив Тогда
		ОтменитьЗаказНаСайте(ЗаказПокупателя, Источник, ПричинаОтмены);
		Возврат;
	КонецЕсли;

	Попытка
		УстановитьСостояниеЗаказа(ЗаказПокупателя, СостояниеЗаказа, Позитив);
		эв_ОбменСПорталамиСервер.ПоставитьЗаказВОчередьСтатусов(ЗаказПокупателя, Источник, СостояниеЗаказа, , Истина);
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Ошибка, , Источник,
			СтрШаблон("Ошибка установки статуса заказа: %1", ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

Функция СостояниеЗаказаУжеУстановлено(ЗаказПокупателя, СостояниеЗаказа, Позитив)

	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗаказПокупателя, "СостояниеЗаказа, ВариантЗавершения");
	ВариантЗавершения = РеквизитыЗаказа.ВариантЗавершения;
	Если СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
		Если Позитив Тогда
			ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
		Иначе
			ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен;
		КонецЕсли;
	КонецЕсли;

	Возврат РеквизитыЗаказа.СостояниеЗаказа = СостояниеЗаказа
		И РеквизитыЗаказа.ВариантЗавершения = ВариантЗавершения;

КонецФункции

Процедура ОтменитьЗаказНаСайте(ЗаказПокупателя, Источник, ПричинаОтмены)

	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗаказПокупателя, "СостояниеЗаказа, ВариантЗавершения");
	Если РеквизитыЗаказа.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен
		И РеквизитыЗаказа.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПричинаОтмены) Тогда
		ПричинаОтмены = Справочники.ПричиныОтменыЗаказа.ОтмененСервисом;
	КонецЕсли;
	Попытка
		эв_ОбменСПорталамиСервер.ОтменитьЗаказПортала(ЗаказПокупателя, Источник, ПричинаОтмены);
	Исключение
		ЗаписьЖурналаРегистрации("Обмен с порталами.АптекаМос", УровеньЖурналаРегистрации.Ошибка, , Источник,
			СтрШаблон("Ошибка отмены заказа: %1", ОписаниеОшибки()));
	КонецПопытки;

	СостояниеОтмены = эв_ОбменСПорталамиСервер.СостояниеОтменыЗаказа();
	Если ЗначениеЗаполнено(СостояниеОтмены) Тогда
		эв_ОбменСПорталамиСервер.ЗаписатьИсториюСтатуса(ЗаказПокупателя, СостояниеОтмены, Дата(1, 1, 1));
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьСостояниеЗаказа(ЗаказПокупателя, СостояниеЗаказа, Позитив = Ложь)

	ДокументОбъект = ЗаказПокупателя.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВариантЗавершения = ДокументОбъект.ВариантЗавершения;
	Если СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
		Если Позитив Тогда
			ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
		Иначе
			ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен;
		КонецЕсли;
	КонецЕсли;

	Если ДокументОбъект.СостояниеЗаказа = СостояниеЗаказа
		И ДокументОбъект.ВариантЗавершения = ВариантЗавершения Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект.СостояниеЗаказа = СостояниеЗаказа;
	ДокументОбъект.ВариантЗавершения = ВариантЗавершения;
	Если ДокументОбъект.Проведен Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокументОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

Функция СтатусНеОтправляется(СтатусПортала)

	Возврат СтатусПортала = "CREATED"
		Или СтатусПортала = "NOT_CREATED"
		Или СтатусПортала = "TRANSFERRED"
		Или СтатусПортала = "NOT_TRANSFERRED"
		Или СтатусПортала = "CANCELLED"
		Или СтатусПортала = "ALL"
		Или СтатусПортала = "NOT_FOUND";

КонецФункции

Функция СтатусБезСозданияЗаказа(СтатусПортала)

	Возврат СтатусПортала = "CANCELLED"
		Или СтатусПортала = "NOT_CREATED"
		Или СтатусПортала = "NOT_TRANSFERRED"
		Или СтатусПортала = "NOT_ACCEPTED"
		Или СтатусПортала = "NOT_FORMED"
		Или СтатусПортала = "NOT_PURCHASED";

КонецФункции

Функция СтатусКПринятию(СтатусПортала)

	Возврат Не ЗначениеЗаполнено(СтатусПортала)
		Или СтатусПортала = "CREATED"
		Или СтатусПортала = "TRANSFERRED";

КонецФункции

Функция СтатусМеняетСостав(СтатусПортала)

	Возврат СтатусПортала = "FORMED" Или СтатусПортала = "NOT_FORMED";

КонецФункции

Функция ЭтоСтатусАптекаМос(СтатусПортала)

	Возврат СтатусПортала = "ACCEPTED"
		Или СтатусПортала = "NOT_ACCEPTED"
		Или СтатусПортала = "FORMED"
		Или СтатусПортала = "NOT_FORMED"
		Или СтатусПортала = "PURCHASED"
		Или СтатусПортала = "NOT_PURCHASED"
		Или СтатусНеОтправляется(СтатусПортала);

КонецФункции

Функция РазобратьФИО(ПолноеИмя)

	Результат = Новый Структура("Фамилия, Имя, Отчество", "", "", "");
	ЧастиИмени = СтрРазделить(СокрЛП(ПолноеИмя), " ", Ложь);
	Если ЧастиИмени.Количество() > 0 Тогда
		Результат.Фамилия = ЧастиИмени[0];
	КонецЕсли;
	Если ЧастиИмени.Количество() > 1 Тогда
		Результат.Имя = ЧастиИмени[1];
	КонецЕсли;
	Если ЧастиИмени.Количество() > 2 Тогда
		ОтчествоЧасти = Новый Массив;
		Для Индекс = 2 По ЧастиИмени.Количество() - 1 Цикл
			ОтчествоЧасти.Добавить(ЧастиИмени[Индекс]);
		КонецЦикла;
		Результат.Отчество = СтрСоединить(ОтчествоЧасти, " ");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПривестиТелефон(Телефон)

	Цифры = "";
	Для НомерСимвола = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, НомерСимвола, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) = 11 И Лев(Цифры, 1) = "8" Тогда
		Цифры = "7" + Сред(Цифры, 2);
	ИначеЕсли СтрДлина(Цифры) = 10 Тогда
		Цифры = "7" + Цифры;
	КонецЕсли;

	Возврат Цифры;

КонецФункции

Функция НоваяТаблицаЗагруженныхЗаказов()

	ТаблицаЗагруженных = Новый ТаблицаЗначений;
	ТаблицаЗагруженных.Колонки.Добавить("ЗаказПокупателя", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	ТаблицаЗагруженных.Колонки.Добавить("НомерЗаказаНаСайте", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаЗагруженных.Колонки.Добавить("ЭтоНовый", Новый ОписаниеТипов("Булево"));
	Возврат ТаблицаЗагруженных;

КонецФункции

Процедура ДобавитьСтрокуЗагруженных(ТаблицаЗагруженных, ЗаказПокупателя, НомерНаСайте, ЭтоНовый)

	СтрокаТаблицы = ТаблицаЗагруженных.Добавить();
	СтрокаТаблицы.ЗаказПокупателя = ЗаказПокупателя;
	СтрокаТаблицы.НомерЗаказаНаСайте = НомерНаСайте;
	СтрокаТаблицы.ЭтоНовый = ЭтоНовый;

КонецПроцедуры

Процедура ДобавитьНепустойКомментарий(Комментарии, ЗначениеКомментария)

	Текст = СокрЛП(СтрокаИзJSON(ЗначениеКомментария));
	Если ЗначениеЗаполнено(Текст) Тогда
		Комментарии.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

Функция НомерЗаказаПортала(ЗначениеПоля)

	Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
		Возврат Формат(ЗначениеПоля, "ЧГ=");
	КонецЕсли;
	Возврат СтрЗаменить(СокрЛП(СтрокаИзJSON(ЗначениеПоля)), Символы.НПП, "");

КонецФункции

Функция ТекстОшибкиОтвета(РезультатHTTP)

	Если РезультатHTTP.Успех Тогда
		Возврат "";
	КонецЕсли;

	Описание = СокрЛП(СтрокаИзJSON(ЗначениеПоляJSON(РезультатHTTP.Json, "description")));
	Если ЗначениеЗаполнено(Описание) Тогда
		Возврат Описание;
	КонецЕсли;

	Возврат РезультатHTTP.ТекстОшибки;

КонецФункции

Функция ПолеЗаполнено(НастройкиAPI, ИмяПоля)

	ЗначениеПоля = Неопределено;
	Если Не НастройкиAPI.Свойство(ИмяПоля, ЗначениеПоля) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(ЗначениеПоля);

КонецФункции

Функция ЗначениеПоляJSON(ОбъектJSON, ИмяПоля)

	Если ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда
		Возврат ОбъектJSON.Получить(ИмяПоля);
	ИначеЕсли ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда
		ЗначениеПоля = Неопределено;
		ОбъектJSON.Свойство(ИмяПоля, ЗначениеПоля);
		Возврат ЗначениеПоля;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СтрокаИзJSON(ЗначениеПоля)

	Если ЗначениеПоля = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(ЗначениеПоля));

КонецФункции

Функция ЧислоИзJSON(ЗначениеПоля)

	Если ЗначениеПоля = Неопределено Или ЗначениеПоля = "" Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
		Возврат ЗначениеПоля;
	КонецЕсли;
	Попытка
		Возврат Число(СтрЗаменить(СокрЛП(Строка(ЗначениеПоля)), Символы.НПП, ""));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ДатаИзJSON(ЗначениеПоля)

	Если ТипЗнч(ЗначениеПоля) = Тип("Дата") Тогда
		Возврат ЗначениеПоля;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;
	Попытка
		Возврат ПрочитатьДатуJSON(Строка(ЗначениеПоля), ФорматДатыJSON.ISO);
	Исключение
		Возврат ТекущаяДатаСеанса();
	КонецПопытки;

КонецФункции

#КонецОбласти

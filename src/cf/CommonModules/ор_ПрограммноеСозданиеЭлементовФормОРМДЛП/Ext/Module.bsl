Процедура ЖурДокЧекиККМФормаСписка(Форма, СписокОшибок)
	
	#Область ИзмененныеСвойства
	ор_ПрограммноеСозданиеЭлементовФорм.ПроверкаНеобходимостиУстановкиПроизвольногоЗапроса(Форма.ЧекиККМ);
	
	СхемаЗапроса = ор_ПрограммноеСозданиеЭлементовФорм.ПолучитьСхемуЗапроса(Форма.ЧекиККМ.ТекстЗапроса);
	Колонки      = СхемаЗапроса.ПакетЗапросов[0].Колонки;
	Поля         = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;
	
	Поля.Добавить("Выразить("""" КАК Строка(50))");
	Колонки[Поля.Количество() - 1].Псевдоним = "СтатусМДЛП";
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "ЖурналДокументов.ЧекиККМ";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Форма.Элементы.ЧекиККМ, СвойстваСписка);
	
	ор_ПрограммноеСозданиеЭлементовФорм.ИзменитьДействиеЭлемента(Форма,
																"ЧекиККМ",
																"ПриПолученииДанныхНаСервере",
																"СписокПриПолученииДанныхНаСервере",
																,
																СписокОшибок);
	#КонецОбласти
	
	#Область Элементы
	Элементы = Форма.Элементы;
	
	НовыйЭлемент = Элементы.Вставить("СтатусМДЛП", Тип("ПолеФормы"), Элементы.ЧекиККМ);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.ПутьКДанным = "ЧекиККМ.СтатусМДЛП";
	#КонецОбласти
	

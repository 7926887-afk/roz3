#Область Реквизиты
#КонецОбласти

#Область Команды
#КонецОбласти

#Область Элементы
	Элементы = Форма.Элементы;
	НовыйЭлемент = Элементы.Вставить(
		"РеквизитыМДЛП",
		Тип("ГруппаФормы"),
		Элементы.ГруппаОсновныеПараметрыКассы,
		Элементы.ГруппаНастройкиСБП);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок   = НСтр("ru = 'Маркировка ИС МДЛП'");
	НовыйЭлемент.Подсказка   = НСтр("ru = 'Маркировка ИС МДЛП'");
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	
	НовыйЭлемент = Элементы.Вставить(
		"ор_МДЛПОтправлятьДанныеМаркируемыхТоваровЧерезОФД",
		Тип("ПолеФормы"),
		Элементы.РеквизитыМДЛП);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным        = "Объект.ор_МДЛПОтправлятьДанныеМаркируемыхТоваровЧерезОФД";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
#КонецОбласти


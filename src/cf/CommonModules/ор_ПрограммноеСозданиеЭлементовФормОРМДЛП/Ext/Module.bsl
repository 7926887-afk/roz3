Функция ПолучитьСтруктуруБазыЭлементов()
	
	СтруктураЭлементов = Новый Структура;
	СтруктураЭлементов.Вставить("ЭлементКП"         , "Элементы.ГруппаЗапасыКоманднаяПанель");
	СтруктураЭлементов.Вставить("ЭлементКППеред"    , "Элементы.ГруппаРаботаСНомерамиГТД");
	СтруктураЭлементов.Вставить("ЭлементТовары"     , "Элементы.Запасы");
	СтруктураЭлементов.Вставить("ЭлементТоварыПеред", "Элементы.ЗапасыНомерСтроки");
	
	СтруктураЭлементов.Вставить("ОбъектЗапасы"      , "Объект.Запасы");
	
	Возврат СтруктураЭлементов;
	
КонецФункции

Процедура ДобавитьСтатусМДЛПВФормуСписка(Форма, СписокОшибок, ИмяОсновнойТаблицы)
	
	#Область ИзмененныеСвойства
	ор_ПрограммноеСозданиеЭлементовФорм.ПроверкаНеобходимостиУстановкиПроизвольногоЗапроса(Форма.Список);
	
	СхемаЗапроса = ор_ПрограммноеСозданиеЭлементовФорм.ПолучитьСхемуЗапроса(Форма.Список.ТекстЗапроса);
	Колонки      = СхемаЗапроса.ПакетЗапросов[0].Колонки;
	Поля         = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;
		
	Поля.Добавить("Выразить("""" КАК Строка(50))");
	Колонки[Поля.Количество() - 1].Псевдоним = "СтатусМДЛП";
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = ИмяОсновнойТаблицы;
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Форма.Элементы.Список, СвойстваСписка);
	
	ор_ПрограммноеСозданиеЭлементовФорм.ИзменитьДействиеЭлемента(Форма,
																"Список",
																"ПриПолученииДанныхНаСервере",
																"СписокПриПолученииДанныхНаСервере",
																,
																СписокОшибок);
	#КонецОбласти
	

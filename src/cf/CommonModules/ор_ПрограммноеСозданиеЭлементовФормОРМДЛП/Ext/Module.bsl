	НовыйЭлемент = Элементы.Вставить(
		"ор_ОткрыватьФормуВводаДанныхРецептаПриПодбореНоменклатуры", 
		Тип("ПолеФормы"),
		Элементы.ГруппаОтраслевыеФлагиЛево,
		Элементы.ГруппаВыбораЦветаДляТовараОтпускаемогоПоРецепту);
	НовыйЭлемент.Вид 	 	 		= ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным 		= "НастройкиРМК.ор_ОткрыватьФормуВводаДанныхРецептаПриПодбореНоменклатуры";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
#КонецОбласти


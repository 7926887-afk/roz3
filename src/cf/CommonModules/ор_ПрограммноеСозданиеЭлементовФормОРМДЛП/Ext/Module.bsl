Процедура СпрКатегорииНоменклатурыФормаЭлемента(Форма, СписокОшибок)

#Область ИзмененныеСвойства
#КонецОбласти

#Область Реквизиты
#КонецОбласти

#Область Команды
#КонецОбласти

#Область Элементы
	Элементы = Форма.Элементы;
	
	НовыйЭлемент = Форма.Элементы.Вставить(
		"ГруппаМаркировкаМДЛП",
		Тип("ГруппаФормы"),
		Элементы.СтраницаМаркировкаИФГИСЛеваяКолонка,
		Элементы.ГруппаАлкогольнаяПродукция);
	НовыйЭлемент.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок   = НСтр("ru = 'Маркировка ИС МДЛП'");
	НовыйЭлемент.Подсказка   = НСтр("ru = 'Маркировка ИС МДЛП'");
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	НовыйЭлемент = Форма.Элементы.Вставить(
		"ор_УчетМаркируемыхТоваров",
		Тип("ПолеФормы"),
		Элементы.ГруппаМаркировкаМДЛП);
	НовыйЭлемент.Вид                = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.Заголовок          = НСтр("ru = 'Маркируемая лекарственная продукция'");
	НовыйЭлемент.ПутьКДанным        = "Объект.ор_УчетМаркируемыхТоваров";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.ВидФлажка          = ВидФлажка.Выключатель;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ор_УчетМаркируемыхТоваров");
	
	НовыйЭлемент.Подсказка = НСтр("ru = 'Осуществляется обмен с ИС МДЛП информацией по обороту лекарственной продукции.'");
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	
#КонецОбласти


Процедура ДобавитьБазовыеЭлементыВФормуДокумента(Форма, СписокОшибок, СтруктураЭлементов)
	
	#Область Реквизиты
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы("ИспользоватьНомераУпаковок",
										Новый ОписаниеТипов("Булево"),
										СтруктураЭлементов.ОбъектЗапасы,
										"Использовать номера упаковок");
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	#КонецОбласти
	
	#Область Элементы
	Элементы = Форма.Элементы;
	
	ЭлементКП          = Вычислить(СтруктураЭлементов.ЭлементКП);
	ЭлементКППеред     = Вычислить(СтруктураЭлементов.ЭлементКППеред);
	ЭлементТовары      = Вычислить(СтруктураЭлементов.ЭлементТовары);
	ЭлементТоварыПеред = Вычислить(СтруктураЭлементов.ЭлементТоварыПеред);
	
	НовыйЭлемент = Элементы.Вставить("ЗапасыМаркировкаМДЛП", Тип("ГруппаФормы"), ЭлементКП, ЭлементКППеред);
	НовыйЭлемент.Вид 	 	= ВидГруппыФормы.Подменю;
	НовыйЭлемент.Заголовок 	= "Маркировка";
	
	НовыйЭлемент = Элементы.Вставить("ЗапасыСтатусЗаполненияУпаковок", Тип("ПолеФормы"), ЭлементТовары, ЭлементТоварыПеред);
	НовыйЭлемент.Вид 		 				= ВидПоляФормы.ПолеКартинки;
	НовыйЭлемент.ПутьКДанным 				= "Объект.Запасы.ор_СтатусЗаполненияУпаковок";
	НовыйЭлемент.ПоложениеЗаголовка 		= ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.КартинкаЗначений			= БиблиотекаКартинок.ор_СтатусыСерийНомеровУпаковок;
	НовыйЭлемент.КартинкаШапки				= БиблиотекаКартинок.ор_СтатусыСерийНомеровУпаковокКолонкаСтатусов;
	НовыйЭлемент.ФиксацияВТаблице			= ФиксацияВТаблице.Лево;
	НовыйЭлемент.СпособПеретаскиванияФайлов = СпособПеретаскиванияФайлов.КакФайл;
	#КонецОбласти
	

// Получение публикуемых реквизитов номенклатуры.
// 
// Параметры:
//  ПубликуемыеРеквизиты - Соответствие - реквизиты справочника Номенклатура, публикуемые для торговых предложений.
//    * Ключ     - ОпределяемыйТип.ДополнительныеРеквизитыБизнесСеть - значение реквизита сопоставления.
//    * Значение - Структура - свойства реквизита:
//      ** Представление    - Строка - наименование для отображения.
//      ** ПутьКДанным      - Строка - текст запроса для получения данных.
//      ** ТипЗначения      - ОписаниеТипов - описание типа данных.
//      ** ПустоеЗначение   - Произвольный - Значение реквизита, при котором, он считается не заполненным.
//
Процедура ПолучитьРеквизитыНоменклатурыДоступныеДляПубликации(ПубликуемыеРеквизиты) Экспорт
	
	// Номенклатура.Вес.
	СвойстваРеквизита = Новый Структура;
	СвойстваРеквизита.Вставить("Представление", НСтр("ru = 'Вес'"));
	СвойстваРеквизита.Вставить("ПутьКДанным", "Номенклатура.Вес");
	СвойстваРеквизита.Вставить("ТипЗначения", Новый ОписаниеТипов("Число"));
	СвойстваРеквизита.Вставить("ПустоеЗначение", 0);
	ПубликуемыеРеквизиты.Вставить(Перечисления.РеквизитыСопоставленияНоменклатурыБизнесСеть.Вес, СвойстваРеквизита);
		
	// Номенклатура.Объем.
	СвойстваРеквизита = Новый Структура;
	СвойстваРеквизита.Вставить("Представление", НСтр("ru = 'Объем'"));
	СвойстваРеквизита.Вставить("ПутьКДанным", "Номенклатура.Объем");
	СвойстваРеквизита.Вставить("ТипЗначения", Новый ОписаниеТипов("Число"));
	СвойстваРеквизита.Вставить("ПустоеЗначение", 0);
	ПубликуемыеРеквизиты.Вставить(Перечисления.РеквизитыСопоставленияНоменклатурыБизнесСеть.Объем, СвойстваРеквизита);
	
	// Номенклатура.Производитель.
	СвойстваРеквизита = Новый Структура;
	СвойстваРеквизита.Вставить("Представление", НСтр("ru = 'Производитель'"));
	СвойстваРеквизита.Вставить("ПутьКДанным", "Номенклатура.Производитель");
	СвойстваРеквизита.Вставить("ТипЗначения", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	СвойстваРеквизита.Вставить("ПустоеЗначение", Справочники.Контрагенты.ПустаяСсылка());
	ПубликуемыеРеквизиты.Вставить(Перечисления.РеквизитыСопоставленияНоменклатурыБизнесСеть.Производитель, СвойстваРеквизита);
	
КонецПроцедуры

// См. РаботаСНоменклатуройПереопределяемый.ФормализованныеРеквизитыНоменклатурыДляВыгрузки 
Процедура ФормализованныеРеквизитыНоменклатурыДляВыгрузки(ФормализованныеРеквизиты) Экспорт
	
	ФормализованныеРеквизиты.Производитель 	= Перечисления.РеквизитыСопоставленияНоменклатурыБизнесСеть.Производитель;
	
КонецПроцедуры
#КонецОбласти

Процедура ПолучитьДанныеРеестраПредельныхОтпускныхЦен(Знач ПараметрыПроцедуры, Знач АдресРезультата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СоответствиеНоменклатурыРаботаСНоменклатурой.Номенклатура КАК Номенклатура,
	|	СоответствиеНоменклатурыРаботаСНоменклатурой.ИдентификаторНоменклатурыСервиса КАК ИдРЛС
	|ПОМЕСТИТЬ втИдентификаторы
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыРаботаСНоменклатурой КАК СоответствиеНоменклатурыРаботаСНоменклатурой
	|ГДЕ
	|	СоответствиеНоменклатурыРаботаСНоменклатурой.СтатусСопоставления = ЗНАЧЕНИЕ(Перечисление.СтатусыСопоставленияРаботаСНоменклатурой.Сопоставлено)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втНоменклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В
	|			(ВЫБРАТЬ
	|				Т.Номенклатура КАК Ссылка
	|			ИЗ
	|				втИдентификаторы КАК Т)
	|	И Номенклатура.ор_ЖНВЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втИдентификаторы.Номенклатура КАК Номенклатура,
	|	втИдентификаторы.ИдРЛС КАК ИдРЛС
	|ИЗ
	|	втИдентификаторы КАК втИдентификаторы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втНоменклатура КАК втНоменклатура
	|		ПО втИдентификаторы.Номенклатура = втНоменклатура.Ссылка";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеНоменклатур = Новый Соответствие;
	
	ТаблицаЦен = Новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("ИдРЛС");
	ТаблицаЦен.Колонки.Добавить("Номенклатура");
	ТаблицаЦен.Колонки.Добавить("Цена");
	ТаблицаЦен.Колонки.Добавить("ДатаРегистрацииЦены");
	ТаблицаЦен.Колонки.Добавить("Наименование");
	ТаблицаЦен.Колонки.Добавить("НаименованиеПроизводителя");
	ТаблицаЦен.Колонки.Добавить("ИдРосЗдравНадзора");
	ТаблицаЦен.Колонки.Добавить("ШтрихКод");
	ТаблицаЦен.Колонки.Добавить("ФормаВыпускаКраткое");
	ТаблицаЦен.Колонки.Добавить("ФормаВыпускаПолное");
	ТаблицаЦен.Колонки.Добавить("МНН");
	ТаблицаЦен.Колонки.Добавить("КоличествоВУпаковке");
	
	ИдентификаторыНоменклатуры = Новый Массив;
	
	ПорцияДанных = 500;
	ВыборкаЦен = Результат.Выбрать();
	
	НужнаИтерация = ВыборкаЦен.Следующий();
	Пока НужнаИтерация Цикл
		
		ИдентификаторыНоменклатуры.Добавить(ВыборкаЦен.ИдРЛС);
		СоответствиеНоменклатур.Вставить(ВыборкаЦен.ИдРЛС, ВыборкаЦен.Номенклатура);
		
		НужнаИтерация = ВыборкаЦен.Следующий();
		
		Если ИдентификаторыНоменклатуры.Количество() = ПорцияДанных
			Или (Не НужнаИтерация И ИдентификаторыНоменклатуры.Количество() > 0) Тогда
			
			Отказ = Ложь;
			КодСостояния = 0;
			ПолучитьПредельныеОтпускныеЦены(ТаблицаЦен, ИдентификаторыНоменклатуры, Отказ, КодСостояния);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			ИдентификаторыНоменклатуры.Очистить();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаЦены Из ТаблицаЦен Цикл
		СтрокаЦены.Номенклатура = СоответствиеНоменклатур.Получить(СтрокаЦены.ИдРЛС);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ТаблицаЦен, АдресРезультата);
	
КонецПроцедуры

#Область ПриПолученииДанныхИзСервиса

// См. РаботаСНоменклатуройПереопределяемый.ПриПолученииДанныхИзСервисаПоНоменклатуре.
Процедура ПриПолученииДанныхИзСервисаПоНоменклатуре(ДанныеПоНоменклатуре) Экспорт
	
	ДанныеПоНоменклатуре.Колонки.Добавить("ор_ЖНВЛС"                                , Новый ОписаниеТипов("Булево"));
	ДанныеПоНоменклатуре.Колонки.Добавить("ор_ЗарегистрированВСистемеМониторингаЦен", Новый ОписаниеТипов("Булево"));
	ДанныеПоНоменклатуре.Колонки.Добавить("ор_НаркотическоеСредство"                , Новый ОписаниеТипов("Булево"));
	ДанныеПоНоменклатуре.Колонки.Добавить("ор_ОтпускПоРецепту"                      , Новый ОписаниеТипов("Булево"));
	ДанныеПоНоменклатуре.Колонки.Добавить("ор_Яд"                                   , Новый ОписаниеТипов("Булево"));
	
	ДанныеПоНоменклатуре.Колонки.Добавить("ор_Производитель"   , Новый ОписаниеТипов("Структура"));
	ДанныеПоНоменклатуре.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("Структура"));
	
	Для Каждого ДанныеНоменклатуры Из ДанныеПоНоменклатуре Цикл
		
		СтрокаДополнительныхРеквизитов = ДанныеНоменклатуры.ДополнительныеРеквизиты.Найти(ИдентификаторЖНВЛС(), "Идентификатор");
		Если СтрокаДополнительныхРеквизитов <> Неопределено Тогда
			ДанныеНоменклатуры.ор_ЖНВЛС = СтрокаДополнительныхРеквизитов.Значение;
		КонецЕсли;
		
		СтрокаДополнительныхРеквизитов = ДанныеНоменклатуры.ДополнительныеРеквизиты.Найти(ИдентификаторНаркотическоеСредство(), "Идентификатор");
		Если СтрокаДополнительныхРеквизитов <> Неопределено Тогда
			ДанныеНоменклатуры.ор_НаркотическоеСредство = СтрокаДополнительныхРеквизитов.Значение;
		КонецЕсли;
		
		Если ДанныеНоменклатуры.ор_ЖНВЛС Тогда
			НайденнаяСтрока = ДанныеНоменклатуры.ПредельныеОтпускныеЦены.Найти("Предельная отпускная цена", "ТипЦены");
			ДанныеНоменклатуры.ор_ЗарегистрированВСистемеМониторингаЦен = НайденнаяСтрока <> Неопределено
				И ЗначениеЗаполнено(НайденнаяСтрока.Цена);
		КонецЕсли;
		
		СтруктураПроизводителя = Новый Структура;
		СтруктураПроизводителя.Вставить("ЕстьЗначение", ЗначениеЗаполнено(ДанныеНоменклатуры.НаименованиеПроизводителя));
		Если СтруктураПроизводителя.ЕстьЗначение Тогда
			СтруктураПроизводителя.Вставить("Наименование", ДанныеНоменклатуры.НаименованиеПроизводителя);
			Если ЗначениеЗаполнено(ДанныеНоменклатуры.КодСтраныПроизводителя) Тогда
				СтруктураПроизводителя.Вставить("КодСтраны", ДанныеНоменклатуры.КодСтраныПроизводителя);
			КонецЕсли;
		КонецЕсли;
		ДанныеНоменклатуры.ор_Производитель = СтруктураПроизводителя;
		
		СтруктураСтраны = Новый Структура;
		СтруктураСтраны.Вставить("ЕстьЗначение", ЗначениеЗаполнено(ДанныеНоменклатуры.КодСтраныПроизводителя));
		Если СтруктураСтраны.ЕстьЗначение Тогда
			СтруктураСтраны.Вставить("КодСтраны", ДанныеНоменклатуры.КодСтраныПроизводителя);
			Если ЗначениеЗаполнено(ДанныеНоменклатуры.НаименованиеСтраныПроизводителя) Тогда
				СтруктураСтраны.Вставить("Наименование", ДанныеНоменклатуры.НаименованиеСтраныПроизводителя);
			КонецЕсли;
		КонецЕсли;
		ДанныеНоменклатуры.СтранаПроисхождения = СтруктураСтраны;
		
		// Загрузка классификаторов.
		ДанныеНоменклатуры.Классификаторы.Колонки.Добавить("ДанныеИзСервиса");
		Для Каждого Классификатор ИЗ ДанныеНоменклатуры.Классификаторы Цикл
			
			СтурктураДанных = Новый Структура;
			СтурктураДанных.Вставить("Идентификатор", Классификатор.Идентификатор);
			СтурктураДанных.Вставить("Наименование", Классификатор.Наименование);
			СтурктураДанных.Вставить("ДанныеИзСервиса");
			
			ПолучитьКлассификаторы(СтурктураДанных);
			
			Классификатор.ДанныеИзСервиса = СтурктураДанных.ДанныеИзСервиса;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Получить отраслевые реквизиты по данным сервиса.
//
// Параметры:
//  ДанныеЗаполнения - Структура	 - данные сервиса.
// 
// Возвращаемое значение:
//   - Структура - отраслевые данные для заполнения номенклатуры.
//
Функция ПолучитьОтраслевыеРеквизиты(ДанныеЗаполнения) Экспорт
	
	СтруктураВозврата = Новый Структура();
	
	СтруктураВозврата.Вставить("ор_ЖНВЛС", ДанныеЗаполнения.ор_ЖНВЛС);
	СтруктураВозврата.Вставить("ор_ЗарегистрированВСистемеМониторингаЦен", ДанныеЗаполнения.ор_ЗарегистрированВСистемеМониторингаЦен);
	СтруктураВозврата.Вставить("ор_НаркотическоеСредство", ДанныеЗаполнения.ор_НаркотическоеСредство);
	СтруктураВозврата.Вставить("ор_ОтпускПоРецепту", ДанныеЗаполнения.ор_ОтпускПоРецепту);
	СтруктураВозврата.Вставить("ор_Яд", ДанныеЗаполнения.ор_Яд);
	
	Если ДанныеЗаполнения.ор_Производитель.ЕстьЗначение Тогда
		СтруктураВозврата.Вставить("ор_Производитель", Справочники.ор_Производители.ПустаяСсылка());
		ОтраслевойПроизводительПоДаннымСервиса(ДанныеЗаполнения.ор_Производитель, СтруктураВозврата.ор_Производитель);
	КонецЕсли;
	
	Если ДанныеЗаполнения.СтранаПроисхождения.ЕстьЗначение Тогда
		СтруктураВозврата.Вставить("СтранаПроисхождения", Справочники.СтраныМира.ПустаяСсылка());
		СтранаПроисхожденияПоДаннымСервиса(ДанныеЗаполнения.СтранаПроисхождения, СтруктураВозврата.СтранаПроисхождения);
	КонецЕсли;
	
	Для Каждого Классификатор Из ДанныеЗаполнения.Классификаторы Цикл
		
		Если Классификатор.Наименование = ИмяКлассификатора_СМНН() И Классификатор.ДанныеИзСервиса.ДанныеПолучены Тогда
			
			СтруктураКлассификатор = Новый Структура;
			СтруктураКлассификатор.Вставить("Наименование", Классификатор.Наименование);
			СтруктураКлассификатор.Вставить("Идентификатор", Классификатор.Идентификатор);
			СтруктураКлассификатор.Вставить("ДанныеИзСервиса", Классификатор.ДанныеИзСервиса);
			СтруктураКлассификатор.Вставить("Ссылка");
			
			ЗагрузитьКлассификаторы(СтруктураКлассификатор);
			
			Если Не СтруктураКлассификатор.ДанныеИзСервиса.ДанныеПолучены Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураВозврата.Вставить("ор_СМНН", СтруктураКлассификатор.Ссылка);
			
			Для Каждого ВложенныйКлассификатор Из СтруктураКлассификатор.ДанныеИзСервиса.Классификаторы Цикл
				
				Если Не ВложенныйКлассификатор.ДанныеИзСервиса.ДанныеПолучены Тогда
					Продолжить;
				КонецЕсли;
				
				Если ВложенныйКлассификатор.Наименование = ИмяКлассификатора_ЛекарственныеФормы() Тогда
					СтруктураВозврата.Вставить("ор_ЛекарственнаяФорма", ЗначениеЗаполнено(ВложенныйКлассификатор.Ссылка));
				ИначеЕсли ВложенныйКлассификатор.Наименование = ИмяКлассификатора_ФТГ()
					И ЗначениеЗаполнено(ВложенныйКлассификатор.Ссылка)Тогда
					СтруктураВозврата.Вставить("ор_ФТГ", ВложенныйКлассификатор.Ссылка);
				ИначеЕсли ВложенныйКлассификатор.Наименование = ИмяКлассификатора_АТХ() 
					И ЗначениеЗаполнено(ВложенныйКлассификатор.Ссылка)Тогда
					Если НЕ СтруктураВозврата.Свойство("АТХКлассификация") Тогда
						СтруктураВозврата.Вставить("АТХКлассификация", Новый Массив);
					КонецЕсли;
					СтруктураВозврата.АТХКлассификация.Добавить(ВложенныйКлассификатор.Ссылка);
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтруктураКлассификатор.ДанныеИзСервиса.Свойство("ФормаВыпуска")
				И ЗначениеЗаполнено(СтруктураКлассификатор.ДанныеИзСервиса.ФормаВыпуска.Ссылка) Тогда
				СтруктураВозврата.Вставить("ор_ФормаВыпуска", СтруктураКлассификатор.ДанныеИзСервиса.ФормаВыпуска.Ссылка);
			КонецЕсли;
			
			Если СтруктураКлассификатор.ДанныеИзСервиса.Свойство("МНН")
				И ЗначениеЗаполнено(СтруктураКлассификатор.ДанныеИзСервиса.МНН.Ссылка) Тогда
				СтруктураВозврата.Вставить("ор_МНН", СтруктураКлассификатор.ДанныеИзСервиса.МНН.Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Сравнение значений отраслевых реквизитов номенклатуры информационной базы и номенклатуры сервиса.
//
// Параметры:
//  ДанныеНоменклатурыСервиса - СтрокаТаблицыЗначений - Данные по номенклатуре.
//                              Описание таблицы значений см. РаботаСНоменклатурой.ДанныеНоменклатурыСервиса.
//  ДанныеНоменклатурыБазы    - СтрокаТаблицыЗначений, Структура, Ссылка - данные по номенклатуре.
//                              См. процедуры ПолучитьЗначенияРеквизитовНоменклатуры,
//                              ПолучитьЗначенияДополнительныхРеквизитовИзФормы.
//  ТаблицаОтличийРеквизитов  - ТаблицаЗначений - см. РаботаСНоменклатурой.ТаблицаОтличийРеквизитов.
//
Процедура ПолучитьОтраслевыеОтличияНоменклатуры(ДанныеНоменклатурыСервиса, ДанныеНоменклатурыБазы, ТаблицаОтличийРеквизитов) Экспорт
	
	Если ДанныеНоменклатурыБазы.ор_ЖНВЛС <> ДанныеНоменклатурыСервиса.ор_ЖНВЛС Тогда
		РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
			ТаблицаОтличийРеквизитов,
			"ор_ЖНВЛС",
			ДанныеНоменклатурыСервиса.ор_ЖНВЛС,
			ДанныеНоменклатурыБазы.ор_ЖНВЛС,
			НСтр("ru = 'ЖНВЛП'"));
	КонецЕсли;
	
	Если ДанныеНоменклатурыБазы.ор_ЗарегистрированВСистемеМониторингаЦен <> ДанныеНоменклатурыСервиса.ор_ЗарегистрированВСистемеМониторингаЦен Тогда
		РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
			ТаблицаОтличийРеквизитов,
			"ор_ЗарегистрированВСистемеМониторингаЦен",
			ДанныеНоменклатурыСервиса.ор_ЗарегистрированВСистемеМониторингаЦен,
			ДанныеНоменклатурыБазы.ор_ЗарегистрированВСистемеМониторингаЦен,
			НСтр("ru = 'Зарегистрирован в системе мониторинга цен'"));
	КонецЕсли;
	
	Если ДанныеНоменклатурыБазы.ор_НаркотическоеСредство <> ДанныеНоменклатурыСервиса.ор_НаркотическоеСредство Тогда
		РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
			ТаблицаОтличийРеквизитов,
			"ор_НаркотическоеСредство",
			ДанныеНоменклатурыСервиса.ор_НаркотическоеСредство,
			ДанныеНоменклатурыБазы.ор_НаркотическоеСредство,
			НСтр("ru = 'Наркотическое средство'"));
	КонецЕсли;
	
	Если ДанныеНоменклатурыБазы.ор_ОтпускПоРецепту <> ДанныеНоменклатурыСервиса.ор_ОтпускПоРецепту Тогда
		РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
			ТаблицаОтличийРеквизитов,
			"ор_ОтпускПоРецепту",
			ДанныеНоменклатурыСервиса.ор_ОтпускПоРецепту,
			ДанныеНоменклатурыБазы.ор_ОтпускПоРецепту,
			НСтр("ru = 'Отпуск по рецепту'"));
	КонецЕсли;
	
	Если ДанныеНоменклатурыБазы.ор_Яд <> ДанныеНоменклатурыСервиса.ор_Яд Тогда
		РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
			ТаблицаОтличийРеквизитов,
			"ор_Яд",
			ДанныеНоменклатурыСервиса.ор_Яд,
			ДанныеНоменклатурыБазы.ор_Яд,
			НСтр("ru = 'Яд'"));
	КонецЕсли;
	
	Если ДанныеНоменклатурыСервиса.СтранаПроисхождения.ЕстьЗначение
		И СтрокиРазные(ДанныеНоменклатурыБазы.СтранаПроисхождения.Код, ДанныеНоменклатурыСервиса.СтранаПроисхождения.КодСтраны, Ложь) Тогда
		
		СтранаПроисхожденияСервиса = ДанныеНоменклатурыСервиса.СтранаПроисхождения;
		СтранаПроисхожденияВБазе = Неопределено;
		СтранаПроисхожденияВБазе(СтранаПроисхожденияСервиса, СтранаПроисхожденияВБазе);
		Если Не ЗначениеЗаполнено(СтранаПроисхожденияВБазе) Тогда
			СтранаПроисхожденияПоДаннымСервиса(СтранаПроисхожденияСервиса, СтранаПроисхожденияВБазе)
		КонецЕсли;
		
		РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
			ТаблицаОтличийРеквизитов,
			"СтранаПроисхождения",
			СтранаПроисхожденияВБазе,
			ДанныеНоменклатурыБазы.СтранаПроисхождения.Наименование,
			НСтр("ru = 'Страна происхождения'"),
			СтранаПроисхожденияСервиса.Наименование);
	КонецЕсли;
	
	Если ДанныеНоменклатурыСервиса.ор_Производитель.ЕстьЗначение
		И СтрокиРазные(ДанныеНоменклатурыБазы.ор_Производитель.Наименование, ДанныеНоменклатурыСервиса.ор_Производитель.Наименование) Тогда
		
		орПроизводительСервиса = ДанныеНоменклатурыСервиса.ор_Производитель;
		орПроизводительВБазе = Неопределено;
		ОтраслевойПроизводительВБазе(орПроизводительСервиса, орПроизводительВБазе);
		Если Не ЗначениеЗаполнено(орПроизводительВБазе) Тогда
			ОтраслевойПроизводительПоДаннымСервиса(орПроизводительСервиса, орПроизводительВБазе)
		КонецЕсли;
		
		РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
			ТаблицаОтличийРеквизитов,
			"ор_Производитель",
			орПроизводительВБазе,
			ДанныеНоменклатурыБазы.ор_Производитель.Наименование,
			НСтр("ru = 'Производитель'"),
			орПроизводительСервиса.Наименование);
	КонецЕсли;
	
	Для Каждого КлассификаторСервиса Из ДанныеНоменклатурыСервиса.Классификаторы  Цикл 
		
		Если КлассификаторСервиса.Наименование <> ИмяКлассификатора_СМНН()
			Или Не КлассификаторСервиса.ДанныеИзСервиса.ДанныеПолучены Тогда
			Продолжить;
		КонецЕсли;
		
		// Дозагружаем данные из сервиса.
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", КлассификаторСервиса.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", КлассификаторСервиса.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", КлассификаторСервиса.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		// Проверка реквизита СМНН.
		Если ДанныеНоменклатурыБазы.ор_СМНН <> СтруктураКлассификатор.Ссылка Тогда
			РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
				ТаблицаОтличийРеквизитов,
				"ор_СМНН",
				СтруктураКлассификатор.Ссылка,
				ДанныеНоменклатурыБазы.ор_СМНН,
				НСтр("ru = 'СМНН'"));
		КонецЕсли;
		
		СписокАТХ = Новый СписокЗначений;
		Для каждого ВложенныйКлассификатор Из СтруктураКлассификатор.ДанныеИзСервиса.Классификаторы Цикл
			
			Если Не ВложенныйКлассификатор.ДанныеИзСервиса.ДанныеПолучены Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВложенныйКлассификатор.Наименование = ИмяКлассификатора_ФТГ()
				И ЗначениеЗаполнено(ВложенныйКлассификатор.Ссылка)
				И ДанныеНоменклатурыБазы.ор_ФТГ <> ВложенныйКлассификатор.Ссылка Тогда
				РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
					ТаблицаОтличийРеквизитов,
					"ор_ФТГ", 
					ВложенныйКлассификатор.Ссылка,
					ДанныеНоменклатурыБазы.ор_ФТГ,
					НСтр("ru = 'Фармакотерапевтическая группа'"));
			ИначеЕсли ВложенныйКлассификатор.Наименование = ИмяКлассификатора_АТХ()
				И ЗначениеЗаполнено(ВложенныйКлассификатор.Ссылка) Тогда
				СписокАТХ.Добавить(ВложенныйКлассификатор.Ссылка);
			КонецЕсли;
			
		КонецЦикла;
		
		// Проверка ТЧ АТХ Классификация.
		ЕстьРазличияАТХ = Ложь;
		Если СписокАТХ.Количество() <> ДанныеНоменклатурыБазы.ор_АТХКлассификация.Количество() Тогда
			ЕстьРазличияАТХ = Истина;
		КонецЕсли;
		
		Для Каждого ЭлементАТХ Из СписокАТХ Цикл
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("АТХ", ЭлементАТХ.Значение);
			Если ДанныеНоменклатурыБазы.ор_АТХКлассификация.НайтиСтроки(ПараметрыПоиска).Количество() = 0 Тогда
				ЕстьРазличияАТХ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьРазличияАТХ Тогда
			СписокАТХТекущее = Новый СписокЗначений;
			ТаблицаЗначенийАТХКлассификация = ?(
				ТипЗнч(ДанныеНоменклатурыБазы.ор_АТХКлассификация) = Тип("ТаблицаЗначений"),
				ДанныеНоменклатурыБазы.ор_АТХКлассификация,
				ДанныеНоменклатурыБазы.ор_АТХКлассификация.Выгрузить());
			СписокАТХТекущее.ЗагрузитьЗначения(ТаблицаЗначенийАТХКлассификация.ВыгрузитьКолонку("АТХ"));
			
			РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
				ТаблицаОтличийРеквизитов,
				"ор_АТХКлассификация",
				СписокАТХ,
				СписокАТХТекущее,
				НСтр("ru = 'АТХ классификация'"));
		КонецЕсли;
		
		Если СтруктураКлассификатор.ДанныеИзСервиса.Свойство("ФормаВыпуска")
			И ЗначениеЗаполнено(СтруктураКлассификатор.ДанныеИзСервиса.ФормаВыпуска.Ссылка)
			И ДанныеНоменклатурыБазы.ор_ФормаВыпуска <> СтруктураКлассификатор.ДанныеИзСервиса.ФормаВыпуска.Ссылка Тогда
			РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
				ТаблицаОтличийРеквизитов,
				"ор_ФормаВыпуска",
				СтруктураКлассификатор.ДанныеИзСервиса.ФормаВыпуска.Ссылка,
				ДанныеНоменклатурыБазы.ор_ФормаВыпуска,
				НСтр("ru = 'Форма выпуска'"));
		КонецЕсли;
		
		Если СтруктураКлассификатор.ДанныеИзСервиса.Свойство("МНН")
			И ЗначениеЗаполнено(СтруктураКлассификатор.ДанныеИзСервиса.МНН.Ссылка)
			И ДанныеНоменклатурыБазы.ор_МНН <> СтруктураКлассификатор.ДанныеИзСервиса.МНН.Ссылка Тогда
			РаботаСНоменклатурой.ДобавитьСтрокуВТаблицуОтличий(
				ТаблицаОтличийРеквизитов,
				"ор_МНН",
				СтруктураКлассификатор.ДанныеИзСервиса.МНН.Ссылка,
				ДанныеНоменклатурыБазы.ор_МНН,
				НСтр("ru = 'МНН'"));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#Область ПолучениеИЗагрузкаКлассифакторовИзСервиса

Процедура ПолучитьКлассификаторы(СтруктураЗагружаемыйКлассификатор) Экспорт
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ФТГ() Тогда
		ПолучитьКлассификаторФТГ(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ЛекарственныеФормы() Тогда
		ПолучитьКлассификаторЛекарственныеФормы(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_АТХ() Тогда
		ПолучитьКлассификаторАТХ(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ДВЛП() Тогда
		ПолучитьКлассификаторДВЛП(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ЕдиницыИзмерения()Тогда
		ПолучитьКлассификаторЕдиницыИзмерения(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_СМНН() Тогда
		ПолучитьКлассификаторСМНН(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
КонецПроцедуры

// Обрабатывает данные набора классификаторов, объединенных по имени.
//
// Параметры:
//  ЗагружаемыеКлассификаторы - Соответствие - ключем которой является имя классификатора,
//    Значение - Соответствие - ключем которого является код классификатора,
//      Значение - Структура - новые данные классификатора.
//  ОбновлятьДанные - Булево - признак необходимости обновления данных классификатора новыми данными.
//
Процедура ЗагрузитьКлассификаторы(СтруктураЗагружаемыйКлассификатор) Экспорт
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_МНН() Тогда
		ЗагрузитьКлассификаторМНН(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ФТГ() Тогда
		ЗагрузитьКлассификаторФТГ(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ЛекарственныеФормы() Тогда
		ЗагрузитьКлассификаторЛекарственныеФормы(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_АТХ() Тогда
		ЗагрузитьКлассификаторАТХ(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ДВЛП() Тогда
		ЗагрузитьКлассификаторДВЛП(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ЕдиницыИзмерения() Тогда
		ЗагрузитьКлассификаторЕдиницыИзмерения(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_ФормыВыпуска() Тогда
		ЗагрузитьКлассификаторФормыВыпуска(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
	Если СтруктураЗагружаемыйКлассификатор.Наименование = ИмяКлассификатора_СМНН() Тогда
		ЗагрузитьКлассификаторСМНН(СтруктураЗагружаемыйКлассификатор);
	КонецЕсли;
	
КонецПроцедуры

#Область КлассификаторФТГ_СлужебныйИнтерфейс

Процедура ПолучитьКлассификаторФТГ(Классификатор)
	
	ЗагрузитьДанныеФТГ(Классификатор);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеФТГ(Классификатор)
	
	ТаблицаФТГ = Новый ТаблицаЗначений;
	ТаблицаФТГ.Колонки.Добавить("Идентификатор");
	ТаблицаФТГ.Колонки.Добавить("Описание");
	ТаблицаФТГ.Колонки.Добавить("ДанныеПолучены");
	
	НоваяСтрока = ТаблицаФТГ.Добавить();
	НоваяСтрока.Идентификатор = Классификатор.Идентификатор;
	НоваяСтрока.ДанныеПолучены = Ложь;
	
	РаботаСНоменклатуройСлужебный.ПолучитьЗначенияКлассификатораНоменклатуры(
		"esklp-ftg",
		ТаблицаФТГ,
		ОписаниеТаблицыКлассификатораФТГ());
	
	Классификатор.ДанныеИзСервиса = Новый Структура;
	Классификатор.ДанныеИзСервиса.Вставить("Идентификатор" , ТаблицаФТГ[0].Идентификатор);
	Классификатор.ДанныеИзСервиса.Вставить("Описание"      , ТаблицаФТГ[0].Описание);
	Классификатор.ДанныеИзСервиса.Вставить("ДанныеПолучены", ТаблицаФТГ[0].ДанныеПолучены);
	
КонецПроцедуры

Функция ОписаниеТаблицыКлассификатораФТГ()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор", Типы().Строка, "code");
	Результат.Колонки.Добавить("Описание"     , Типы().Строка, "description");
	Возврат Результат;
	
КонецФункции

Процедура ЗагрузитьКлассификаторФТГ(Классификатор)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ФТГ.Ссылка КАК Ссылка,
	|	ФТГ.НаименованиеПолное КАК НаименованиеПолное
	|ИЗ
	|	Справочник.ор_ФТГ КАК ФТГ
	|ГДЕ
	|	ФТГ.Наименование = &Наименование
	|	И НЕ ФТГ.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", ТРег(СокрЛП(Классификатор.ДанныеИзСервиса.Описание)));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_ФТГ.СоздатьЭлемент();
	НовыйОбъект.Наименование       = ТРег(СокрЛП(Классификатор.ДанныеИзСервиса.Описание));
	НовыйОбъект.НаименованиеПолное = ТРег(СокрЛП(Классификатор.ДанныеИзСервиса.Описание));
	НовыйОбъект.КодРаздела         = СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор);
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание классификатора Фармако-терапевтических групп'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти // КлассификаторФТГ_СлужебныйИнтерфейс

#Область КлассификаторЛекарственныеФормы_СлужебныйИнтерфейс

Процедура ПолучитьКлассификаторЛекарственныеФормы(Классификатор)
	
	ЗагрузитьДанныеЛекарственныеФормы(Классификатор);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеЛекарственныеФормы(Классификатор)
	
	ТаблицаЛекФорм = Новый ТаблицаЗначений;
	ТаблицаЛекФорм.Колонки.Добавить("Идентификатор");
	ТаблицаЛекФорм.Колонки.Добавить("Наименование");
	ТаблицаЛекФорм.Колонки.Добавить("НаименованиеЛатынь");
	ТаблицаЛекФорм.Колонки.Добавить("НаименованиеБазовая");
	ТаблицаЛекФорм.Колонки.Добавить("ДанныеПолучены");
	
	НоваяСтрока = ТаблицаЛекФорм.Добавить();
	НоваяСтрока.Идентификатор = Классификатор.Идентификатор;
	НоваяСтрока.ДанныеПолучены = Ложь;
	
	РаботаСНоменклатуройСлужебный.ПолучитьЗначенияКлассификатораНоменклатуры(
		"esklp-form",
		ТаблицаЛекФорм,
		ОписаниеТаблицыЛекарственныеФормы());
	
	Классификатор.ДанныеИзСервиса = Новый Структура;
	Классификатор.ДанныеИзСервиса.Вставить("Идентификатор"      , ТаблицаЛекФорм[0].Идентификатор);
	Классификатор.ДанныеИзСервиса.Вставить("Наименование"       , ТаблицаЛекФорм[0].Наименование);
	Классификатор.ДанныеИзСервиса.Вставить("НаименованиеЛатынь" , ТаблицаЛекФорм[0].НаименованиеЛатынь);
	Классификатор.ДанныеИзСервиса.Вставить("НаименованиеБазовая", ТаблицаЛекФорм[0].НаименованиеБазовая);
	Классификатор.ДанныеИзСервиса.Вставить("ДанныеПолучены"     , ТаблицаЛекФорм[0].ДанныеПолучены);
	
КонецПроцедуры

Функция ОписаниеТаблицыЛекарственныеФормы()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор"      , Типы().Строка, "code");
	Результат.Колонки.Добавить("Наименование"       , Типы().Строка, "name");
	Результат.Колонки.Добавить("НаименованиеЛатынь" , Типы().Строка, "nameLat");
	Результат.Колонки.Добавить("НаименованиеБазовая", Типы().Строка, "basicDoseForm");
	Возврат Результат;
	
КонецФункции

Процедура ЗагрузитьКлассификаторЛекарственныеФормы(Классификатор)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛекарственныеФормы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_ЛекарственныеФормы КАК ЛекарственныеФормы
	|ГДЕ
	|	ЛекарственныеФормы.Наименование = &Наименование
	|	И НЕ ЛекарственныеФормы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛекарственныеФормы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_ЛекарственныеФормы КАК ЛекарственныеФормы
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &НеИскатьБазовую
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ЛекарственныеФормы.Наименование = &НаименованиеБазовая
	|		КОНЕЦ
	|	И НЕ ЛекарственныеФормы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Классификатор.ДанныеИзСервиса.Наименование));
	Запрос.УстановитьПараметр("НеИскатьБазовую", ПустаяСтрока(Классификатор.ДанныеИзСервиса.НаименованиеБазовая));
	Запрос.УстановитьПараметр("НаименованиеБазовая", СокрЛП(Классификатор.ДанныеИзСервиса.НаименованиеБазовая));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатЗапроса[0].Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_ЛекарственныеФормы.СоздатьЭлемент();
	НовыйОбъект.Наименование = СокрЛП(Классификатор.ДанныеИзСервиса.Наименование);
	НовыйОбъект.НаименованиеПолное = СокрЛП(Классификатор.ДанныеИзСервиса.Наименование);
	
	Если НЕ ЗначениеЗаполнено(Классификатор.ДанныеИзСервиса.НаименованиеБазовая) Тогда
		НовыйОбъект.НаименованиеЛатынь = СокрЛП(Классификатор.ДанныеИзСервиса.НаименованиеЛатынь);
		НовыйОбъект.НаименованиеЛатыньПолное = СокрЛП(Классификатор.ДанныеИзСервиса.НаименованиеЛатынь);
	КонецЕсли;
	
	Выборка = РезультатЗапроса[1].Выбрать();
	Если Выборка.Следующий() Тогда
		НовыйОбъект.Родитель = Выборка.Ссылка;
	КонецЕсли;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание лекарственной формы'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти // КлассификаторЛекарственныеФормы_СлужебныйИнтерфейс

#Область КлассификаторАТХ_СлужебныйИнтерфейс

Процедура ПолучитьКлассификаторАТХ(Классификатор)
	
	ЗагрузитьДанныеАТХ(Классификатор);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеАТХ(Классификатор)
	
	ТаблицаАТХ = Новый ТаблицаЗначений;
	ТаблицаАТХ.Колонки.Добавить("Идентификатор");
	ТаблицаАТХ.Колонки.Добавить("Описание");
	ТаблицаАТХ.Колонки.Добавить("ДанныеПолучены");
	
	НоваяСтрока = ТаблицаАТХ.Добавить();
	НоваяСтрока.Идентификатор = Классификатор.Идентификатор;
	НоваяСтрока.ДанныеПолучены = Ложь;
	
	РаботаСНоменклатуройСлужебный.ПолучитьЗначенияКлассификатораНоменклатуры(
		"esklp-atc",
		ТаблицаАТХ,
		ОписаниеТаблицыКлассификатораАТХ());
	
	Классификатор.ДанныеИзСервиса = Новый Структура;
	Классификатор.ДанныеИзСервиса.Вставить("Идентификатор" , ТаблицаАТХ[0].Идентификатор);
	Классификатор.ДанныеИзСервиса.Вставить("Описание"      , ТаблицаАТХ[0].Описание);
	Классификатор.ДанныеИзСервиса.Вставить("ДанныеПолучены", ТаблицаАТХ[0].ДанныеПолучены);
	
КонецПроцедуры

Функция ОписаниеТаблицыКлассификатораАТХ()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор", Типы().Строка, "code");
	Результат.Колонки.Добавить("Описание"     , Типы().Строка, "description");
	Возврат Результат;
	
КонецФункции

Процедура ЗагрузитьКлассификаторАТХ(Классификатор)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	АТХКлассификация.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_КлассификаторАТХ КАК АТХКлассификация
	|ГДЕ
	|	АТХКлассификация.КодРаздела = &КодРаздела
	|	И НЕ АТХКлассификация.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("КодРаздела", СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_КлассификаторАТХ.СоздатьЭлемент();
	НовыйОбъект.КодРаздела = СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор);
	
	ПозицияСкобки = СтрНайти(Классификатор.ДанныеИзСервиса.Описание,"{");
	Если ПозицияСкобки <> 0 Тогда
		НовыйОбъект.Наименование = СокрЛП(Лев(Классификатор.ДанныеИзСервиса.Описание,ПозицияСкобки - 1));
	Иначе
		НовыйОбъект.Наименование = СокрЛП(Классификатор.ДанныеИзСервиса.Описание);
	КонецЕсли;
	
	НовыйОбъект.НаименованиеПолное = НовыйОбъект.КодРаздела + " " + НовыйОбъект.Наименование;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание АТХ классификатора'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти // КлассификаторАТХ_СлужебныйИнтерфейс

#Область КлассификаторДВЛП_СлужебныйИнтерфейс

Процедура ПолучитьКлассификаторДВЛП(Классификатор)
	
	ЗагрузитьДанныеДВЛП(Классификатор);
	ДозагрузкаПодчиненныхДВЛП(Классификатор);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеДВЛП(Классификатор)
	
	ТаблицаДВЛП = Новый ТаблицаЗначений;
	ТаблицаДВЛП.Колонки.Добавить("Идентификатор");
	ТаблицаДВЛП.Колонки.Добавить("ГруппаДействующегоВещества");
	ТаблицаДВЛП.Колонки.Добавить("Наименование");
	ТаблицаДВЛП.Колонки.Добавить("НаименованиеАнглийское");
	ТаблицаДВЛП.Колонки.Добавить("НаименованиеЛатинское");
	ТаблицаДВЛП.Колонки.Добавить("Классификаторы");
	ТаблицаДВЛП.Колонки.Добавить("ДанныеПолучены");
	
	НоваяСтрока = ТаблицаДВЛП.Добавить();
	НоваяСтрока.Идентификатор = Классификатор.Идентификатор;
	НоваяСтрока.ДанныеПолучены = Ложь;
	
	РаботаСНоменклатуройСлужебный.ПолучитьЗначенияКлассификатораНоменклатуры(
		"esklp-dvlp",
		ТаблицаДВЛП,
		ОписаниеТаблицыКлассификатораДВЛП());
	
	Классификатор.ДанныеИзСервиса = Новый Структура;
	Классификатор.ДанныеИзСервиса.Вставить("Идентификатор"             , ТаблицаДВЛП[0].Идентификатор);
	Классификатор.ДанныеИзСервиса.Вставить("ГруппаДействующегоВещества", ТаблицаДВЛП[0].ГруппаДействующегоВещества);
	Классификатор.ДанныеИзСервиса.Вставить("Наименование"              , ТаблицаДВЛП[0].Наименование);
	Классификатор.ДанныеИзСервиса.Вставить("НаименованиеАнглийское"    , ТаблицаДВЛП[0].НаименованиеАнглийское);
	Классификатор.ДанныеИзСервиса.Вставить("НаименованиеЛатинское"     , ТаблицаДВЛП[0].НаименованиеЛатинское); 
	Классификатор.ДанныеИзСервиса.Вставить("Классификаторы"            , ТаблицаДВЛП[0].Классификаторы);
	Классификатор.ДанныеИзСервиса.Вставить("ДанныеПолучены"            , ТаблицаДВЛП[0].ДанныеПолучены);
	
КонецПроцедуры

Функция ОписаниеТаблицыКлассификатораДВЛП()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор"             , Типы().Строка , "code");
	Результат.Колонки.Добавить("ГруппаДействующегоВещества", Типы().Число  , "groupCode");
	Результат.Колонки.Добавить("Наименование"              , Типы().Строка , "name");
	Результат.Колонки.Добавить("НаименованиеАнглийское"    , Типы().Строка , "nameEn");
	Результат.Колонки.Добавить("НаименованиеЛатинское"     , Типы().Строка , "nameLat");
	Результат.Колонки.Добавить("Классификаторы"            , Типы().Таблица, "classifiers|items.classifiers");
	
	Возврат Результат;
	
КонецФункции

Процедура ДозагрузкаПодчиненныхДВЛП(Классификатор)
	
	Если НЕ Классификатор.Свойство("ДанныеИзСервиса")
		Или Не Классификатор.ДанныеИзСервиса.Свойство("Классификаторы") Тогда
		Возврат;
	КонецЕсли;
	
	Классификатор.ДанныеИзСервиса.Классификаторы.Колонки.Добавить("ДанныеИзСервиса");
	
	Для Каждого СтрокаКлассификатор Из Классификатор.ДанныеИзСервиса.Классификаторы Цикл
		Если СтрокаКлассификатор.Наименование <> ИмяКлассификатора_АТХ() Тогда
			Продолжить;
		КонецЕсли;
		
		СтурктураДанных = Новый Структура;
		СтурктураДанных.Вставить("Идентификатор",СтрокаКлассификатор.Идентификатор);
		СтурктураДанных.Вставить("Наименование",СтрокаКлассификатор.Наименование);
		СтурктураДанных.Вставить("ДанныеИзСервиса");
		
		ПолучитьКлассификаторы(СтурктураДанных);
		
		СтрокаКлассификатор.ДанныеИзСервиса = СтурктураДанных.ДанныеИзСервиса;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьКлассификаторДВЛП(Классификатор)
	
	ПолучитьСсылкиПодчиненныхДВЛП(Классификатор);
	НайтиСоздатьДВЛП(Классификатор);
	
КонецПроцедуры

Процедура ПолучитьСсылкиПодчиненныхДВЛП(Классификатор)
	
	// Добавление классификаторов АТХ.
	Если Классификатор.ДанныеИзСервиса.Классификаторы.Колонки.Найти("Ссылка") = Неопределено Тогда
		Классификатор.ДанныеИзСервиса.Классификаторы.Колонки.Добавить("Ссылка");
	КонецЕсли;
	
	Для Каждого ПодчиненныйКлассификатор Из Классификатор.ДанныеИзСервиса.Классификаторы Цикл
		
		Если ЗначениеЗаполнено(ПодчиненныйКлассификатор.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", ПодчиненныйКлассификатор.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", ПодчиненныйКлассификатор.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", ПодчиненныйКлассификатор.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		ПодчиненныйКлассификатор.Ссылка = СтруктураКлассификатор.Ссылка;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура НайтиСоздатьДВЛП(Классификатор)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДействующиеВещества.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_ДВЛП КАК ДействующиеВещества
	|ГДЕ
	|	НЕ ДействующиеВещества.ПометкаУдаления
	|	И ДействующиеВещества.КодРаздела = &КодРаздела";
	
	Запрос.УстановитьПараметр("КодРаздела", СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_ДВЛП.СоздатьЭлемент();
	НовыйОбъект.КодРаздела                 = СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор);
	НовыйОбъект.Наименование               = СокрЛП(Классификатор.ДанныеИзСервиса.Наименование);
	НовыйОбъект.НаименованиеАнглийское     = СокрЛП(Классификатор.ДанныеИзСервиса.НаименованиеАнглийское);
	НовыйОбъект.НаименованиеЛатинское      = СокрЛП(Классификатор.ДанныеИзСервиса.НаименованиеЛатинское);
	НовыйОбъект.НаименованиеПолное         = СокрЛП(Классификатор.ДанныеИзСервиса.Наименование);
	НовыйОбъект.ГруппаДействующегоВещества = Классификатор.ДанныеИзСервиса.ГруппаДействующегоВещества;
	
	Для Каждого КлассификаторАТХ Из Классификатор.ДанныеИзСервиса.Классификаторы  Цикл
		НоваяСтрока = НовыйОбъект.АТХКлассификация.Добавить();
		НоваяСтрока.АТХ = КлассификаторАТХ.Ссылка;
	КонецЦикла;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание классификатора Действующие вещества лекарственных препаратов (ДВЛП)'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти // КлассификаторДВЛП_СлужебныйИнтерфейс

#Область КлассификаторЕдиницыИзмерения_СлужебныйИнтерфейс

Процедура ПолучитьКлассификаторЕдиницыИзмерения(Классификатор)
	
	ЗагрузитьДанныеЕдиницыИзмерения(Классификатор);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеЕдиницыИзмерения(Классификатор)
	
	ТаблицаЕдиницыИзмерения = Новый ТаблицаЗначений;
	ТаблицаЕдиницыИзмерения.Колонки.Добавить("Идентификатор");
	//ТаблицаЕдиницыИзмерения.Колонки.Добавить("ИдентификаторОКЕИ");
	ТаблицаЕдиницыИзмерения.Колонки.Добавить("Наименование");
	ТаблицаЕдиницыИзмерения.Колонки.Добавить("ПолноеНаименование");
	ТаблицаЕдиницыИзмерения.Колонки.Добавить("МеждународноеСокращение");
	ТаблицаЕдиницыИзмерения.Колонки.Добавить("ТипИзмеряемойВеличины");
	ТаблицаЕдиницыИзмерения.Колонки.Добавить("ДанныеПолучены");
	
	НоваяСтрока = ТаблицаЕдиницыИзмерения.Добавить();
	НоваяСтрока.Идентификатор = Классификатор.Идентификатор;
	НоваяСтрока.ДанныеПолучены = Ложь;
	
	РаботаСНоменклатуройСлужебный.ПолучитьЗначенияКлассификатораНоменклатуры(
		"okei",
		ТаблицаЕдиницыИзмерения,
		ОписаниеТаблицыКлассификатораОКЕИ());
	
	Классификатор.ДанныеИзСервиса = Новый Структура;
	Классификатор.ДанныеИзСервиса.Вставить("Идентификатор"           , ТаблицаЕдиницыИзмерения[0].Идентификатор);
	//Классификатор.ДанныеИзСервиса.Вставить("ИдентификаторОКЕИ"       , ТаблицаЕдиницыИзмерения[0].ИдентификаторОКЕИ);
	Классификатор.ДанныеИзСервиса.Вставить("Наименование"            , ТаблицаЕдиницыИзмерения[0].Наименование);
	Классификатор.ДанныеИзСервиса.Вставить("ПолноеНаименование"      , ТаблицаЕдиницыИзмерения[0].ПолноеНаименование);
	Классификатор.ДанныеИзСервиса.Вставить("МеждународноеСокращение" , ТаблицаЕдиницыИзмерения[0].МеждународноеСокращение); 
	Классификатор.ДанныеИзСервиса.Вставить("ТипИзмеряемойВеличины"   , ТаблицаЕдиницыИзмерения[0].ТипИзмеряемойВеличины); 
	Классификатор.ДанныеИзСервиса.Вставить("ДанныеПолучены"          , ТаблицаЕдиницыИзмерения[0].ДанныеПолучены);

КонецПроцедуры

Функция ОписаниеТаблицыКлассификатораОКЕИ()
	
	Результат = Новый ТаблицаЗначений;
	//Результат.Колонки.Добавить("Идентификатор"          , Типы().Строка, "id");
	//Результат.Колонки.Добавить("ИдентификаторОКЕИ"      , Типы().Строка, "okei");
	Результат.Колонки.Добавить("Идентификатор"          , Типы().Строка, "okei");
	Результат.Колонки.Добавить("Наименование"           , Типы().Строка, "nationalSymbol");
	Результат.Колонки.Добавить("ПолноеНаименование"     , Типы().Строка, "name");
	Результат.Колонки.Добавить("МеждународноеСокращение", Типы().Строка, "internationalCodeMark");
	Результат.Колонки.Добавить("ТипИзмеряемойВеличины"  , Типы().Строка, "type");
	Возврат Результат;
	
КонецФункции

Процедура ЗагрузитьКлассификаторЕдиницыИзмерения(Классификатор)
	
	ПоискПоКоду = Истина;
	//Если СокрЛП(Классификатор.ДанныеИзСервиса.ИдентификаторОКЕИ) = "876" Тогда
	Если СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор) = "876" Тогда
		//"876" - усл. ед. В таком случае ищем по наминованию.
		ПоискПоКоду = Ложь;
	КонецЕсли;
	
	Наименование = ?(ПустаяСтрока(Классификатор.ДанныеИзСервиса.Наименование),
		"~", СокрЛП(Классификатор.ДанныеИзСервиса.Наименование));
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ПоискПоКоду
	|				ТОГДА КлассификаторЕдиницИзмерения.Код = &Код
	|			ИНАЧЕ КлассификаторЕдиницИзмерения.Наименование = &Наименование
	|		КОНЕЦ
	|	И НЕ КлассификаторЕдиницИзмерения.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПоискПоКоду", ПоискПоКоду);
	Запрос.УстановитьПараметр("Код", СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор));
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
	
	НовыйОбъект.Код                     = СокрЛП(Классификатор.Идентификатор);
	НовыйОбъект.Наименование            = Наименование;
	НовыйОбъект.НаименованиеПолное      = Классификатор.ДанныеИзСервиса.ПолноеНаименование;
	НовыйОбъект.МеждународноеСокращение = ?(Классификатор.ДанныеИзСервиса.Свойство("МеждународноеСокращение"), СокрЛП(Классификатор.ДанныеИзСервиса.МеждународноеСокращение), "~");
	
	Если Не ПустаяСтрока(Классификатор.ДанныеИзСервиса.ТипИзмеряемойВеличины) Тогда
		НовыйОбъект.ТипИзмеряемойВеличины = ПолучитьТипИзмеряемойВеличины(
			ДоступныеТипыИзмеряемойВеличины(),
			Классификатор.ДанныеИзСервиса.ТипИзмеряемойВеличины);
	КонецЕсли;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание классификатора единицы измерения'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

Функция ДоступныеТипыИзмеряемойВеличины()
	
	ДоступныеТипыИзмеряемойВеличины = Новый Соответствие;
	Для Каждого Значение Из Перечисления.ТипыИзмеряемыхВеличин Цикл
		ДоступныеТипыИзмеряемойВеличины.Вставить(Строка(Значение), Значение);
	КонецЦикла;
	
	Возврат ДоступныеТипыИзмеряемойВеличины;
	
КонецФункции

Функция ПолучитьТипИзмеряемойВеличины(ДоступныеТипыИзмеряемойВеличины, ИмяТипа)
	
	ТипЕдиницы = Неопределено;
	Если ЗначениеЗаполнено(ИмяТипа) Тогда
		ТипЕдиницы = ДоступныеТипыИзмеряемойВеличины.Получить(ИмяТипа);
	КонецЕсли;
	
	Возврат ТипЕдиницы;
	
КонецФункции

#КонецОбласти // КлассификаторЕдиницыИзмерения_СлужебныйИнтерфейс

#Область КлассификаторФормыВыпуска_СлужебныйИнтерфейс

Процедура ЗагрузитьКлассификаторФормыВыпуска(Классификатор) 
	
	ПолучитьСсылкиПодчиненныхФормыВыпуска(Классификатор);
	НайтиСоздатьФормуВыпуска(Классификатор);
	
КонецПроцедуры

Процедура ПолучитьСсылкиПодчиненныхФормыВыпуска(Классификатор)
	
	// Получение лекарственных форм.
	ТекущиеДанные = Классификатор.ДанныеИзСервиса.ЛекарственнаяФорма;
	Если НЕ ТекущиеДанные.Свойство("Ссылка")
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", ТекущиеДанные.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", ТекущиеДанные.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", ТекущиеДанные.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		Классификатор.ДанныеИзСервиса.ЛекарственнаяФорма.Вставить("Ссылка", СтруктураКлассификатор.Ссылка);
		
	КонецЕсли;
	
	// Получение единиц измерения.
	ТекущиеДанные = Классификатор.ДанныеИзСервиса.ЕдиницаИзмеренияДозировки;
	Если НЕ ТекущиеДанные.Свойство("Ссылка")
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные) Тогда
		
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", ТекущиеДанные.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", ТекущиеДанные.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", ТекущиеДанные.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		Классификатор.ДанныеИзСервиса.ЕдиницаИзмеренияДозировки.Вставить("Ссылка",СтруктураКлассификатор.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСоздатьФормуВыпуска(Классификатор)
	
	НайденнаяСсылка = Неопределено;
	
	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ФормыВыпуска.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_ФормыВыпуска КАК ФормыВыпуска
	|ГДЕ
	|	НЕ ФормыВыпуска.ПометкаУдаления
	|	И ФормыВыпуска.ЛекарственнаяФорма = &ЛекарственнаяФорма
	|	И ФормыВыпуска.Количество = &Количество
	|	И ФормыВыпуска.ЕдиницаИзмерения = &ЕдиницаИзмерения";
	
	Запрос.УстановитьПараметр("ЛекарственнаяФорма", Классификатор.ДанныеИзСервиса.ЛекарственнаяФорма.Ссылка);
	Запрос.УстановитьПараметр("Количество", ТипЧисло.ПривестиЗначение(Классификатор.ДанныеИзСервиса.Количество));
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", Классификатор.ДанныеИзСервиса.ЕдиницаИзмеренияДозировки.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_ФормыВыпуска.СоздатьЭлемент();
	
	НовыйОбъект.Наименование       = Классификатор.ДанныеИзСервиса.Наименование;
	НовыйОбъект.ЛекарственнаяФорма = Классификатор.ДанныеИзСервиса.ЛекарственнаяФорма.Ссылка;
	НовыйОбъект.Количество         = Классификатор.ДанныеИзСервиса.Количество;
	НовыйОбъект.ЕдиницаИзмерения   = Классификатор.ДанныеИзСервиса.ЕдиницаИзмеренияДозировки.Ссылка;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание формы выпуска '",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти // КлассификаторФормыВыпуска_СлужебныйИнтерфейс

#Область КлассификаторМНН_СлужебныйИнтерфейс

Процедура ЗагрузитьКлассификаторМНН(Классификатор)
	
	ПолучитьСсылкиПодчиненныхМНН(Классификатор);
	НайтиСоздатьМНН(Классификатор);
	
КонецПроцедуры

Процедура ПолучитьСсылкиПодчиненныхМНН(Классификатор)
	
	// Получение ДВЛП.
	ТекущиеДанные = Классификатор.ДанныеИзСервиса.ДВЛП;
	Если ТекущиеДанные <> Неопределено
		И (НЕ ТекущиеДанные.Свойство("Ссылка") Или НЕ ЗначениеЗаполнено(ТекущиеДанные.Ссылка)) Тогда
		//Поучение ДВЛП
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", ТекущиеДанные.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", ТекущиеДанные.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", ТекущиеДанные.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		Классификатор.ДанныеИзСервиса.ДВЛП.Вставить("Ссылка", СтруктураКлассификатор.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСоздатьМНН(Классификатор)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МНН.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_МНН КАК МНН
	|ГДЕ
	|	МНН.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Классификатор.Идентификатор));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_МНН.СоздатьЭлемент();
	
	НовыйОбъект.КодРаздела              = Классификатор.ДанныеИзСервиса.КодРаздела;
	НовыйОбъект.Наименование            = Классификатор.ДанныеИзСервиса.Наименование;
	НовыйОбъект.НаименованиеРасширенное = Классификатор.ДанныеИзСервиса.НаименованиеРасширенное;
	НовыйОбъект.НаименованиеПолное      = Классификатор.ДанныеИзСервиса.Наименование;
	
	ДанныеДВЛП = Классификатор.ДанныеИзСервиса.ДВЛП;
	Если ДанныеДВЛП <> Неопределено
		И ЗначениеЗаполнено(ДанныеДВЛП.Ссылка) Тогда
		НовыйОбъект.НаименованиеЛатинское = ДанныеДВЛП.ДанныеИзСервиса.НаименованиеЛатинское;
	
		НоваяСтрока = НовыйОбъект.ДействующиеВещества.Добавить();
		НоваяСтрока.ДействующееВещество = ДанныеДВЛП.Ссылка;
	КонецЕсли;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание МНН'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти // КлассификаторМНН_СлужебныйИнтерфейс

#Область КлассификаторСМНН_СлужебныйИнтерфейс

Процедура ПолучитьКлассификаторСМНН(Классификатор)
	
	ЗагрузитьДанныеСМНН(Классификатор);
	ДозагрузкаПодчиненныхСМНН(Классификатор);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеСМНН(Классификатор)

	ТаблицаСМНН = Новый ТаблицаЗначений;
	ТаблицаСМНН.Колонки.Добавить("Идентификатор");
	ТаблицаСМНН.Колонки.Добавить("Наименование");
	ТаблицаСМНН.Колонки.Добавить("Дозировка");
	ТаблицаСМНН.Колонки.Добавить("Классификаторы");
	ТаблицаСМНН.Колонки.Добавить("ДанныеПолучены");
	ТаблицаСМНН.Колонки.Добавить("ДополнительныеРеквизитыСМНН");
	ТаблицаСМНН.Колонки.Добавить("УникальныйИдентификаторЕСКЛП");
	
	НоваяСтрока = ТаблицаСМНН.Добавить();
	НоваяСтрока.Идентификатор = Классификатор.Идентификатор;
	НоваяСтрока.ДанныеПолучены = Ложь;
	
	РаботаСНоменклатуройСлужебный.ПолучитьЗначенияКлассификатораНоменклатуры(
		"smnn",
		ТаблицаСМНН,
		ОписаниеТаблицыСМНН());
	
	Классификатор.ДанныеИзСервиса = Новый Структура;
	Классификатор.ДанныеИзСервиса.Вставить("Идентификатор"               , ТаблицаСМНН[0].Идентификатор);
	Классификатор.ДанныеИзСервиса.Вставить("Наименование"                , ТаблицаСМНН[0].Наименование);
	Классификатор.ДанныеИзСервиса.Вставить("Классификаторы"              , ТаблицаСМНН[0].Классификаторы);
	Классификатор.ДанныеИзСервиса.Вставить("Дозировка"                   , ТаблицаСМНН[0].Дозировка);
	Классификатор.ДанныеИзСервиса.Вставить("ДополнительныеРеквизитыСМНН" , ТаблицаСМНН[0].ДополнительныеРеквизитыСМНН);
	Классификатор.ДанныеИзСервиса.Вставить("УникальныйИдентификаторЕСКЛП", ТаблицаСМНН[0].УникальныйИдентификаторЕСКЛП);
	Классификатор.ДанныеИзСервиса.Вставить("ДанныеПолучены"              , ТаблицаСМНН[0].ДанныеПолучены);
	
КонецПроцедуры

Функция ОписаниеТаблицыСМНН()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Классификаторы"              , Типы().Таблица  , "classifiers|items.classifiers");
	Результат.Колонки.Добавить("Идентификатор"               , Типы().Строка   , "code");
	Результат.Колонки.Добавить("Наименование"                , Типы().Строка   , "name");
	Результат.Колонки.Добавить("Дозировка"                   , Типы().Структура, "dosage|items.dosage");
	Результат.Колонки.Добавить("ДополнительныеРеквизитыСМНН" , Типы().Таблица  , "features|items.features");
	Результат.Колонки.Добавить("УникальныйИдентификаторЕСКЛП", Типы().Строка   , "uuid");
	Возврат Результат;
	
КонецФункции

Процедура ДозагрузкаПодчиненныхСМНН(Классификатор)
	
	Если НЕ Классификатор.Свойство("ДанныеИзСервиса")
		ИЛИ НЕ Классификатор.ДанныеИзСервиса.ДанныеПолучены Тогда
		Возврат;
	КонецЕсли;
	
	Данные = Классификатор.ДанныеИзСервиса;
	
	// Дозагрузка классфикаторов АТХ, Лек. форм, ДВЛП, ФТГ.
	Если Данные.Свойство("Классификаторы") Тогда
		
		Данные.Классификаторы.Колонки.Добавить("ДанныеИзСервиса");
		
		Для Каждого СтрокаКлассификатор Из Данные.Классификаторы Цикл
			Если СтрокаКлассификатор.Наименование = ИмяКлассификатора_ЛекарственныеФормы()
				ИЛИ СтрокаКлассификатор.Наименование = ИмяКлассификатора_АТХ()
				ИЛИ СтрокаКлассификатор.Наименование = ИмяКлассификатора_ДВЛП()
				ИЛИ СтрокаКлассификатор.Наименование = ИмяКлассификатора_ФТГ() Тогда
				
				СтурктураДанных = Новый Структура;
				СтурктураДанных.Вставить("Идентификатор", СтрокаКлассификатор.Идентификатор);
				СтурктураДанных.Вставить("Наименование", СтрокаКлассификатор.Наименование);
				СтурктураДанных.Вставить("ДанныеИзСервиса");
				
				ПолучитьКлассификаторы(СтурктураДанных);
				
				СтрокаКлассификатор.ДанныеИзСервиса = СтурктураДанных.ДанныеИзСервиса;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Дозагрузка классификатора еденицы измерения дозировки.
	Если Данные.Свойство("Дозировка") Тогда
		
		СтурктураДанных = Новый Структура;
		СтурктураДанных.Вставить("Идентификатор", СокрЛП(Данные.Дозировка.ЕдиницаИзмеренияДозировки.Идентификатор));
		СтурктураДанных.Вставить("Наименование", ИмяКлассификатора_ЕдиницыИзмерения());
		СтурктураДанных.Вставить("ДанныеИзСервиса");
		
		ПолучитьКлассификаторы(СтурктураДанных);
		
		Данные.Дозировка.Вставить("ДанныеИзСервиса", СтурктураДанных.ДанныеИзСервиса);
		
	КонецЕсли;

	// Формы выпуска не загружаются, а формируются.
	ЛекФормаДляФормыВыпуска = Неопределено;
	Для Каждого ПодчиненныйКлассификатор Из Данные.Классификаторы Цикл
		Если ПодчиненныйКлассификатор.Наименование = ИмяКлассификатора_ЛекарственныеФормы() Тогда
			
			ЛекФормаДляФормыВыпуска = Новый Структура;
			ЛекФормаДляФормыВыпуска.Вставить("Идентификатор", ПодчиненныйКлассификатор.Идентификатор);
			ЛекФормаДляФормыВыпуска.Вставить("Наименование", ПодчиненныйКлассификатор.Наименование);
			ЛекФормаДляФормыВыпуска.Вставить("ДанныеИзСервиса", ПодчиненныйКлассификатор.ДанныеИзСервиса);
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЕстьОшибка = Ложь;
	Если ЛекФормаДляФормыВыпуска = Неопределено Тогда
		// Ошибка создания Форм выпуска, нет лек форм.
		ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если Данные.Свойство("Дозировка")
		И Данные.Дозировка.Свойство("ЕдиницаИзмеренияДозировки") Тогда
		
		ЕдиницаИзмеренияДозировкиДляФормыВыпуска = Новый Структура;
		ЕдиницаИзмеренияДозировкиДляФормыВыпуска.Вставить("Идентификатор", Данные.Дозировка.ЕдиницаИзмеренияДозировки.Идентификатор);
		ЕдиницаИзмеренияДозировкиДляФормыВыпуска.Вставить("Наименование", ИмяКлассификатора_ЕдиницыИзмерения());
		ЕдиницаИзмеренияДозировкиДляФормыВыпуска.Вставить("ДанныеИзСервиса", Данные.Дозировка.ДанныеИзСервиса);
	Иначе
		// Ошибка создания Форм выпуска, нет данных дозировки.
		ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибка Тогда
		
		Данные.Вставить("ФормаВыпуска", Новый Структура);
		
		Идентификатор = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Ключ_%1/%2_%3_%4",
			ЛекФормаДляФормыВыпуска.Идентификатор,
			Данные.Дозировка.ЕдиницаИзмеренияДозировки.Идентификатор,
			Данные.Дозировка.ЕдиницаИзмеренияДозировки.Количество,
			Данные.Дозировка.ЕдиницаИзмеренияДозировки.Наименование);
		
		
		Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1, %2 %3",
			ЛекФормаДляФормыВыпуска.ДанныеИзСервиса.Наименование,
			Формат(Данные.Дозировка.ЕдиницаИзмеренияДозировки.Количество, "ЧРД=."),
			СокрЛП(Данные.Дозировка.ЕдиницаИзмеренияДозировки.Наименование));
		
		ДанныеИзСервисаФормыВыпуска = Новый Структура;
		ДанныеИзСервисаФормыВыпуска.Вставить("ЕдиницаИзмеренияДозировки", ЕдиницаИзмеренияДозировкиДляФормыВыпуска); 
		ДанныеИзСервисаФормыВыпуска.Вставить("ЛекарственнаяФорма", ЛекФормаДляФормыВыпуска);
		ДанныеИзСервисаФормыВыпуска.Вставить("Количество", Данные.Дозировка.ЕдиницаИзмеренияДозировки.Количество);
		ДанныеИзСервисаФормыВыпуска.Вставить("Наименование", Наименование);
		
		Данные.ФормаВыпуска.Вставить("Идентификатор", Идентификатор);
		Данные.ФормаВыпуска.Вставить("Наименование", ИмяКлассификатора_ФормыВыпуска());
		Данные.ФормаВыпуска.Вставить("ДанныеИзСервиса", ДанныеИзСервисаФормыВыпуска);
	
	КонецЕсли;
	
	// Классификатор МНН не загружаются а формируются.
	ДВЛПДляМНН = Неопределено;
	Для Каждого ПодчиненныйКлассификатор Из Данные.Классификаторы Цикл
		Если ПодчиненныйКлассификатор.Наименование = ИмяКлассификатора_ДВЛП() Тогда
			
			ДВЛПДляМНН  = Новый Структура;
			ДВЛПДляМНН.Вставить("Идентификатор", ПодчиненныйКлассификатор.Идентификатор);
			ДВЛПДляМНН.Вставить("Наименование", ПодчиненныйКлассификатор.Наименование);
			ДВЛПДляМНН.Вставить("ДанныеИзСервиса", ПодчиненныйКлассификатор.ДанныеИзСервиса);
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаДопРеквизитМНН = Данные.ДополнительныеРеквизитыСМНН.Найти(31196, "ДопРеквизитИдентификатор");
	
	Если СтрокаДопРеквизитМНН <> Неопределено Тогда
		
		Данные.Вставить("МНН",Новый Структура);
		
		Идентификатор = СтрокаДопРеквизитМНН.Значение;
		
		ДанныеИзСервисаМНН = Новый Структура;
		ДанныеИзСервисаМНН.Вставить("КодРаздела", Данные.Идентификатор);
		ДанныеИзСервисаМНН.Вставить("Наименование", СтрокаДопРеквизитМНН.Значение);
		ДанныеИзСервисаМНН.Вставить("НаименованиеРасширенное", Данные.Наименование);
		ДанныеИзСервисаМНН.Вставить("ДВЛП", ДВЛПДляМНН);
		
		Данные.МНН.Вставить("Идентификатор", Идентификатор);
		Данные.МНН.Вставить("Наименование", ИмяКлассификатора_МНН());
		Данные.МНН.Вставить("ДанныеИзСервиса", ДанныеИзСервисаМНН);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьКлассификаторСМНН(Классификатор)
	
	// Дозаполняем подчиненные класификаторы.
	ПолучитьСсылкиПодчиненныхСМНН(Классификатор);
	
	// Поиск и при создание элемента при необходимости.
	НайтиСоздатьСМНН(Классификатор);
	
КонецПроцедуры

Процедура ПолучитьСсылкиПодчиненныхСМНН(Классификатор)
	
	// Добавление классификаторов Лек. форм, АТХ, ФТГ, ДВЛП.
	Если Классификатор.ДанныеИзСервиса.Классификаторы.Колонки.Найти("Ссылка") = Неопределено Тогда
		Классификатор.ДанныеИзСервиса.Классификаторы.Колонки.Добавить("Ссылка");
	КонецЕсли;
	
	Для Каждого ПодчиненныйКлассификатор Из Классификатор.ДанныеИзСервиса.Классификаторы Цикл
		
		Если ЗначениеЗаполнено(ПодчиненныйКлассификатор.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", ПодчиненныйКлассификатор.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", ПодчиненныйКлассификатор.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", ПодчиненныйКлассификатор.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		ПодчиненныйКлассификатор.Ссылка = СтруктураКлассификатор.Ссылка;
		
	КонецЦикла;
	
	// Формирование и создание Формы Выпуска.
	// После дозагрузки подчиненных СМНН Формы выпуска может не быть, если нет лек. формы.
	Если (Классификатор.ДанныеИзСервиса.Свойство("ФормаВыпуска")) 
		И (НЕ Классификатор.ДанныеИзСервиса.ФормаВыпуска.Свойство("Ссылка")
			ИЛИ НЕ ЗначениеЗаполнено(Классификатор.ДанныеИзСервиса.ФормаВыпуска.Ссылка)) Тогда
		
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", Классификатор.ДанныеИзСервиса.ФормаВыпуска.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", Классификатор.ДанныеИзСервиса.ФормаВыпуска.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", Классификатор.ДанныеИзСервиса.ФормаВыпуска.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		Классификатор.ДанныеИзСервиса.ФормаВыпуска.Вставить("Ссылка", СтруктураКлассификатор.Ссылка);
	КонецЕсли;

	// Формирование и создание МНН.
	// После дозагрузки подчиненных СМНН МНН может не быть.
	Если (Классификатор.ДанныеИзСервиса.Свойство("МНН")) 
		И (НЕ Классификатор.ДанныеИзСервиса.МНН.Свойство("Ссылка")
			ИЛИ НЕ ЗначениеЗаполнено(Классификатор.ДанныеИзСервиса.МНН.Ссылка)) Тогда
		
		СтруктураКлассификатор = Новый Структура;
		СтруктураКлассификатор.Вставить("Наименование", Классификатор.ДанныеИзСервиса.МНН.Наименование);
		СтруктураКлассификатор.Вставить("Идентификатор", Классификатор.ДанныеИзСервиса.МНН.Идентификатор);
		СтруктураКлассификатор.Вставить("ДанныеИзСервиса", Классификатор.ДанныеИзСервиса.МНН.ДанныеИзСервиса);
		СтруктураКлассификатор.Вставить("Ссылка");
		
		ЗагрузитьКлассификаторы(СтруктураКлассификатор);
		
		Классификатор.ДанныеИзСервиса.МНН.Вставить("Ссылка",СтруктураКлассификатор.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСоздатьСМНН(Классификатор)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СМНН.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_СМНН КАК СМНН
	|ГДЕ
	|	СМНН.КодЕСКЛП = &КодЕСКЛП";
	Запрос.УстановитьПараметр("КодЕСКЛП", СокрЛП(Классификатор.ДанныеИзСервиса.Идентификатор));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Классификатор.Ссылка = НайденнаяСсылка;
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_СМНН.СоздатьЭлемент();
	
	НовыйОбъект.КодЕСКЛП                     = Классификатор.ДанныеИзСервиса.Идентификатор;
	НовыйОбъект.НаименованиеПолное           = Классификатор.ДанныеИзСервиса.Наименование;
	НовыйОбъект.УникальныйИдентификаторЕСКЛП = Классификатор.ДанныеИзСервиса.УникальныйИдентификаторЕСКЛП;
	
	// Формы выпуска может не быть, если нет лек. формы.
	Если Классификатор.ДанныеИзСервиса.Свойство("ФормаВыпуска") Тогда
		НовыйОбъект.ФормаВыпуска             = Классификатор.ДанныеИзСервиса.ФормаВыпуска.Ссылка;
	КонецЕсли;
	// МНН так же может не быть.
	Если Классификатор.ДанныеИзСервиса.Свойство("МНН") Тогда
		НовыйОбъект.ДействующиеВеществаМНН   = Классификатор.ДанныеИзСервиса.МНН.Ссылка;
	КонецЕсли;
	
	Для Каждого Строка Из Классификатор.ДанныеИзСервиса.ДополнительныеРеквизитыСМНН Цикл
		Если Строка.ДопРеквизитИдентификатор = 31198 Тогда // Признак ЖНВЛП.
			НовыйОбъект.ЖНВЛП = ?(Строка.Значение = "true", Истина, Ложь);
		КонецЕсли;
	КонецЦикла;
	
	// Вытягиваем данные из ТЧ классифкаторов.
	Для каждого Строка из Классификатор.ДанныеИзСервиса.Классификаторы Цикл
		Если Строка.Наименование = ИмяКлассификатора_АТХ() Тогда
			НоваяСтрока = НовыйОбъект.АТХКлассификация.Добавить();
			НоваяСтрока.АТХ = Строка.Ссылка;
		КонецЕсли;
		Если Строка.Наименование = ИмяКлассификатора_ФТГ() Тогда
			НовыйОбъект.ФармакоТерапевтическаяГруппа = Строка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание СМНН'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Классификатор.Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти // КлассификаторСМНН_СлужебныйИнтерфейс

// Типы получаемых данных.
// 
// Возвращаемое значение:
//  Структура - описание типов:
//   * Простой         - простой тип.
//   * Строка          - тип Строка.
//   * Число           - тип Число.
//   * Булево          - тип Булево.
//   * Структура       - тип Структура.
//   * Дата            - тип Дата.
//   * ТаблицаЗначений - тип ТаблицаЗначений.
//
Функция Типы()
	Результат = Новый Структура;
	Результат.Вставить("Простой",   Новый ОписаниеТипов("Строка, Булево, Число, Дата"));
	Результат.Вставить("Булево",    Новый ОписаниеТипов("Булево"));
	Результат.Вставить("Число",     Новый ОписаниеТипов("Число"));
	Результат.Вставить("Дата",      Новый ОписаниеТипов("Дата"));
	Результат.Вставить("Строка",    Новый ОписаниеТипов("Строка"));
	Результат.Вставить("Структура", Новый ОписаниеТипов("Структура"));
	Результат.Вставить("Массив",    Новый ОписаниеТипов("Массив"));
	Результат.Вставить("Таблица",   Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьЗначениеВJSON(Значение, НастройкиСериализации = Неопределено) Экспорт
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение, НастройкиСериализации);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ПреобразоватьJSONВЗначение(Строка, ПрочитатьВСоответствие = Истина, ИменаСвойствСоЗначениямиДата = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат Строка;
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Строка);
	Значение = ПрочитатьJSON(Чтение, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата);
	
	Возврат Значение;
	
КонецФункции

Функция СтрокаВДату(Знач Значение) Экспорт
	
	Попытка
		ДанныеДаты = ПреобразоватьJSONВЗначение(ПреобразоватьЗначениеВJSON(Новый Структура("Дата", Значение)), Ложь, "Дата");
		Дата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДаты, "Дата");
	Исключение
		Дата = Неопределено;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ПреобразоватьСтрокуВДату(Значение);
	КонецЕсли;
	
	Возврат Дата;
	
КонецФункции

// Функция преобразовывает строку в тип Дата
//
// Параметры:
//  СтрокаДаты - строка, представляющая дату
//
// Возвращаемое значение:
//  Дата - дата из строки или '00010101'
//
Функция ПреобразоватьСтрокуВДату(СтрокаДаты) Экспорт
	
	Результат = '00010101';
	ОписаниеДата = Новый ОписаниеТипов("Дата");
	
	Если Не ПустаяСтрока(СтрокаДаты) Тогда
		Результат = ОписаниеДата.ПривестиЗначение(СтрокаДаты);
		Если Не ЗначениеЗаполнено(Результат) Тогда //Дата не в каноническом виде, будем преобразовывать самостоятельно
			СтрокаРазделителей = ".-/\TZ+:MSK";
			СтрокаЧисел = "0123456789";
			ДлинаСтроки = СтрДлина(СтрокаДаты);
			МассивЧастейДаты = Новый Массив;
			ВременнаяСтрока = "";
			КоличествоЧастейДаты = 0;
			Для Сч = 1 По ДлинаСтроки Цикл
				СимволСтроки = Сред(СтрокаДаты, Сч, 1);
				Если Найти(СтрокаЧисел, СимволСтроки) Тогда
					ВременнаяСтрока = ВременнаяСтрока + СимволСтроки;
				ИначеЕсли Найти(СтрокаРазделителей, СимволСтроки) Тогда
					Если Не ПустаяСтрока(ВременнаяСтрока) Тогда
						МассивЧастейДаты.Добавить(ВременнаяСтрока);
						ВременнаяСтрока = "";
						КоличествоЧастейДаты = КоличествоЧастейДаты + 1;
					КонецЕсли;
				Иначе
					МассивЧастейДаты.Очистить();
					Прервать; //неверный формат даты
				КонецЕсли;
				Если КоличествоЧастейДаты = 3 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не ПустаяСтрока(ВременнаяСтрока) Тогда           
				МассивЧастейДаты.Добавить(ВременнаяСтрока);
			КонецЕсли;
			Если МассивЧастейДаты.Количество() = 3 Тогда
				Если СтрДлина(МассивЧастейДаты[0]) = 4 Тогда
					Результат = ПолучитьДату(МассивЧастейДаты[0], МассивЧастейДаты[1], МассивЧастейДаты[2]);
				ИначеЕсли СтрДлина(МассивЧастейДаты[2]) = 4 Тогда
					Результат = ПолучитьДату(МассивЧастейДаты[2], МассивЧастейДаты[1], МассивЧастейДаты[0]);
				Иначе
					Результат = ПолучитьДату("20" + МассивЧастейДаты[2], МассивЧастейДаты[1], МассивЧастейДаты[0]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
 
// Функция получает дату на основании переданных параметров
//
// Параметры:
//  Год   - Число - год даты
//  Месяц - Число - месяц даты
//  День  - Число - день даты
//
// Возвращаемое значение:
//  Дата
//
Функция ПолучитьДату(Год, Месяц, День)
	
	Попытка
		Результат = Дата(Год, Месяц, День);
	Исключение
		Результат = '00010101';
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции
 

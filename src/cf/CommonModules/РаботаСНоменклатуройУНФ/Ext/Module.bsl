#Область СлужебныеПроцедурыИФункции

// Дополнение в запрос источников по дополнительным реквизитам номенклатуры.
//
// Параметры:
//   Запрос - Запрос - основной запрос сбора данных.
//
Процедура ДобавитьРеквизитыНоменклатурыВЗапрос(Запрос)
	
	БлокРеквизитовШаблон = "
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	NULL,
	|	&Свойство,
	|	&Значение,
	|	"""",
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				ОтборНоменклатуры КАК Товары
	|			ГДЕ
	|				Товары.Номенклатура = Номенклатура.Ссылка)";
	
	ДоступныеДляПубликацииРеквизиты = Новый Соответствие;
	ПолучитьРеквизитыНоменклатурыДоступныеДляПубликации(ДоступныеДляПубликацииРеквизиты);
	
	МассивПодзапросов = Новый Массив;
	СчетчикРеквизитов = 0;
	Для каждого СвойстваРеквизита Из ДоступныеДляПубликацииРеквизиты Цикл
		
		Если Запрос.Параметры.ИсключенныеДополнительныеРеквизиты.Найти(СвойстваРеквизита.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексСтрокой = XMLСтрока(СчетчикРеквизитов);
		ПутьКДанным   = СвойстваРеквизита.Значение.ПутьКДанным;
		СчетчикРеквизитов = СчетчикРеквизитов + 1;
		ТекстПодзапроса = БлокРеквизитовШаблон;
		
		ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, "&Значение", ПутьКДанным);
		ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, "&Свойство", "&Свойство" + ИндексСтрокой);
		
		Запрос.УстановитьПараметр("Свойство" + ИндексСтрокой, СвойстваРеквизита.Ключ);
		
		Если СвойстваРеквизита.Значение.Свойство("ПустоеЗначение") Тогда
			ТекстПодзапроса = ТекстПодзапроса + Символы.ПС
				+ "И НЕ "+ ПутьКДанным + " = &ПустоеЗначение" + ИндексСтрокой;
			Запрос.УстановитьПараметр("ПустоеЗначение" + ИндексСтрокой,
				СвойстваРеквизита.Значение.ПустоеЗначение);
		КонецЕсли;
		
		МассивПодзапросов.Добавить(ТекстПодзапроса);
		
	КонецЦикла;
	
	БлокРеквизитовПодстановка = СтрСоединить(МассивПодзапросов, Символы.ПС + Символы.ПС);
	
	// Если реквизиты не найдены, удалить БлокРеквизитовШаблон.
	Если ПустаяСтрока(БлокРеквизитовПодстановка) Тогда
		БлокРеквизитовПодстановка = "";
	КонецЕсли;
	
	Если СтрЧислоВхождений(Запрос.Текст, БлокРеквизитовШаблон) = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Ошибка компоновки запроса получения данных номенклатуры.'");
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, БлокРеквизитовШаблон, БлокРеквизитовПодстановка);
	
КонецПроцедуры

#Область ПроцедурыПроверкиВыполненияОбработкиОбъектов
Функция ПризнакПредметаРасчетаЗаполнен(Параметры) Экспорт 
	Результат = Истина;
	ПризнакПредметаРасчета = Неопределено;
	НаименованиеППР = "ПризнакПредметаРасчета";
	НаименованиеТипаНоменклатуры = "ТипНоменклатуры";
	НаименованиеТипаНоменклатурыПоУмолчанию = "ТипНоменклатурыПоУмолчанию";
	Если ТипЗнч(Параметры.Данные) = Тип("СправочникСсылка.Номенклатура") Тогда
		ПереченьРеквизитов = "" + НаименованиеППР + ", " + НаименованиеТипаНоменклатуры;
		Данные = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Данные, ПереченьРеквизитов);
	ИначеЕсли ТипЗнч(Параметры.Данные) = Тип("СправочникСсылка.КатегорииНоменклатуры") Тогда
		НаименованиеТипаНоменклатуры = НаименованиеТипаНоменклатурыПоУмолчанию;
		ПереченьРеквизитов = "" + НаименованиеППР + ", " + НаименованиеТипаНоменклатуры;
		Данные = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Данные, ПереченьРеквизитов);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры.Данные, НаименованиеТипаНоменклатуры) Тогда
		Данные = Параметры.Данные;
	Иначе                     
		НаименованиеТипаНоменклатуры = НаименованиеТипаНоменклатурыПоУмолчанию;
		Данные = Параметры.Данные; 
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры.Данные, НаименованиеТипаНоменклатуры)
		И Данные[НаименованиеТипаНоменклатуры] <> Перечисления.ТипыНоменклатуры.Операция
		И Данные[НаименованиеТипаНоменклатуры] <> Перечисления.ТипыНоменклатуры.ВидРабот 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры.Данные, НаименованиеППР) Тогда
		Результат = ЗначениеЗаполнено(Данные[НаименованиеППР]);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции		
#КонецОбласти

#Область ОтраслевыеПроцедурыИФункции

Процедура ОтраслевойПроизводительПоДаннымСервиса(ДанныеСервиса, Ссылка)
	
	Если Не ЗначениеЗаполнено(ДанныеСервиса.Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	ОтраслевойПроизводительВБазе(ДанныеСервиса, Ссылка);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.ор_Производители.СоздатьЭлемент();
	НовыйОбъект.Наименование = СокрЛП(ДанныеСервиса.Наименование);
	
	Импортный = Ложь;
	Если ДанныеСервиса.Свойство("КодСтраны")
		И ЗначениеЗаполнено(ДанныеСервиса.КодСтраны) Тогда
		Импортный = СокрЛП(ДанныеСервиса.КодСтраны) <> "643";
	КонецЕсли;
	НовыйОбъект.Импортный = Импортный;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание производителя'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

Процедура ОтраслевойПроизводительВБазе(ДанныеСервиса, Ссылка)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	Производители.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ор_Производители КАК Производители
	|ГДЕ
	|	Производители.Наименование = &Наименование
	|	И НЕ Производители.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", СокрЛП(ДанныеСервиса.Наименование));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Ссылка = НайденнаяСсылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура СтранаПроисхожденияПоДаннымСервиса(ДанныеСервиса, Ссылка)
	
	Если Не ЗначениеЗаполнено(ДанныеСервиса) Тогда
		Возврат;
	КонецЕсли;
	
	СтранаПроисхожденияВБазе(ДанныеСервиса.КодСтраны, Ссылка);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	// Создание элемента если не найдено.
	НовыйОбъект = Справочники.СтраныМира.СоздатьЭлемент();
	НовыйОбъект.Код = ДанныеСервиса.КодСтраны;
	
	ДанныеКлассификатора = УправлениеКонтактнойИнформацией.ДанныеКлассификатораСтранМираПоКоду(ДанныеСервиса.КодСтраны, "КодСтраны");
	Если НЕ ДанныеКлассификатора = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НовыйОбъект,ДанныеКлассификатора);
	КонецЕсли;
	
	Если ДанныеСервиса.Свойство("Наименование") Тогда
		НовыйОбъект.Наименование = ДанныеСервиса.Наименование;
	КонецЕсли;
	
	НовыйОбъект.ОбменДанными.Загрузка = Истина;
	Попытка
		НовыйОбъект.Записать();
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Работа с номенклатурой. Создание стран мира'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Ссылка = НовыйОбъект.Ссылка;
	
КонецПроцедуры

Процедура СтранаПроисхожденияВБазе(КодСтраны, Ссылка)
	
	НайденнаяСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	СтраныМира.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтраныМира КАК СтраныМира
	|ГДЕ
	|	СтраныМира.Код = &КодСтраны
	|	И НЕ СтраныМира.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("КодСтраны", СокрЛП(КодСтраны));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Ссылка = НайденнаяСсылка;
	КонецЕсли;
	
КонецПроцедуры

Функция СтрокиРазные(Первая, Вторая, ИспользоватьНрег = Истина)
	
	Если ИспользоватьНрег Тогда
		Возврат НРег(СокрЛП(Первая)) <> НРег(СокрЛП(Вторая));
	Иначе
		Возврат СокрЛП(Первая) <> СокрЛП(Вторая);
	КонецЕсли;
	
КонецФункции

Процедура ПолучитьПредельныеОтпускныеЦены(ТаблицаЦен, ИдентификаторыНоменклатуры, Отказ, КодСостояния)
	
	ДанныеПоНоменклатуре = РаботаСНоменклатуройСлужебный.ПолучитьДанныеПоНоменклатуре(
		ИдентификаторыНоменклатуры,
		Ложь,
		Отказ,
		КодСостояния);
	
	Если Отказ
		Или ТипЗнч(ДанныеПоНоменклатуре) <> Тип("ТаблицаЗначений")
		Или ДанныеПоНоменклатуре.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСНоменклатуройПереопределяемый.ПриПолученииДанныхИзСервисаПоНоменклатуре(ДанныеПоНоменклатуре);
	
	Для Каждого СтрокаНоменклатуры Из ДанныеПоНоменклатуре Цикл
		
		ОтраслевыеРеквизиты = РаботаСНоменклатуройУНФ.ПолучитьОтраслевыеРеквизиты(СтрокаНоменклатуры);
		
		Для Каждого СтрокаЦен Из СтрокаНоменклатуры.ПредельныеОтпускныеЦены Цикл
			
			Если СтрокаЦен.ТипЦены <> "Предельная отпускная цена" Тогда
				Продолжить;
			КонецЕсли;
			
			Цена = СтрокаЦен.Цена;
			ДатаРегистрацииЦены = Неопределено;
			Для Каждого СтрокаСвойства Из СтрокаЦен.ДополнительныеРеквизиты Цикл
				Если СтрокаСвойства.Наименование = "reg_date" Тогда
					ДатаРегистрацииЦены = ПрочитатьДатуJSON(СтрокаСвойства.Значение, ФорматДатыJSON.ISO);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			НоваяСтрока = ТаблицаЦен.Добавить();
			НоваяСтрока.ИдРЛС = СтрокаНоменклатуры.Идентификатор;
			НоваяСтрока.Цена = Цена;
			НоваяСтрока.ДатаРегистрацииЦены = ДатаРегистрацииЦены;
			НоваяСтрока.НаименованиеПроизводителя = СтрокаНоменклатуры.НаименованиеПроизводителя;
			
			Если ОтраслевыеРеквизиты.Свойство("ор_МНН") Тогда
				НоваяСтрока.МНН = ОтраслевыеРеквизиты.ор_МНН.Наименование;
			КонецЕсли;
			
			НоваяСтрока.Наименование = СтрокаНоменклатуры.Наименование;
			НоваяСтрока.КоличествоВУпаковке = СтрокаНоменклатуры.КоличествоВУпаковке.Количество;
			
			Если СтрокаНоменклатуры.Штрихкоды.Количество() > 0 Тогда
				НоваяСтрока.ШтрихКод = СтрокаНоменклатуры.Штрихкоды[0];
			КонецЕсли;
			
			Если ОтраслевыеРеквизиты.Свойство("ор_ФормаВыпуска") Тогда
				НоваяСтрока.ФормаВыпускаПолное = ОтраслевыеРеквизиты.ор_ФормаВыпуска.Наименование;
			КонецЕсли;
			

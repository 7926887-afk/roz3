	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	ЗагружаемыйРеквизит                     = СтруктураПараметров.ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Страна происхождения";
	ЗагружаемыйРеквизит.НомерКолонки        = 0;
	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	
	ЗагружаемыйРеквизит                     = СтруктураПараметров.ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Орган выдавший сертификат";
	ЗагружаемыйРеквизит.НомерКолонки        = 0;
	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	
	ЗагружаемыйРеквизит                     = СтруктураПараметров.ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Срок действия сертификата";
	ЗагружаемыйРеквизит.НомерКолонки        = 0;
	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	
	ЗагружаемыйРеквизит                     = СтруктураПараметров.ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Декларацию зарегистрировал";
	ЗагружаемыйРеквизит.НомерКолонки        = 0;
	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	
	ЗагружаемыйРеквизит                     = СтруктураПараметров.ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Декларант";
	ЗагружаемыйРеквизит.НомерКолонки        = 0;
	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	
	ЗагружаемыйРеквизит                     = СтруктураПараметров.ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Маркируемый товар";
	ЗагружаемыйРеквизит.НомерКолонки        = 0;
	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	
	ЗагружаемыйРеквизит                     = СтруктураПараметров.ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "GTIN";
	ЗагружаемыйРеквизит.НомерКолонки        = 0;
	ЗагружаемыйРеквизит.РежимЗагрузки       = "Искать";
	
	Если НЕ ТаблицаСтарыхЗнач=Неопределено Тогда
		Для Каждого СтрокаТаблДопПар Из СтруктураПараметров.ТаблицаДополнительныхПараметров Цикл
			НайденнаяСтрока = ТаблицаСтарыхЗнач.Найти(СтрокаТаблДопПар.ИмяРеквизита);
			Если НЕ НайденнаяСтрока = Неопределено Тогда
				СтрокаТаблДопПар.НомерКолонки  = НайденнаяСтрока.НомерКолонки;
				СтрокаТаблДопПар.РежимЗагрузки = НайденнаяСтрока.РежимЗагрузки;
				СтрокаТаблДопПар.Выражение     = НайденнаяСтрока.Выражение;
				Если НЕ ЗначениеЗаполнено(СтрокаТаблДопПар.РежимЗагрузки) Тогда
					СтрокаТаблДопПар.РежимЗагрузки = "Искать";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	// ЗаполнитьНастройкиКолонокТабличнойЧастиДополнительныхПараметров()

// Процедура дополняет параметры по срокам годности при загрузке.
//
Процедура ДополнитьПараметрыПоСрокамГодностиПриЗагрузке(СтруктураПараметров) Экспорт
	
	Попытка
		ПроверятьСрокиГодности = НЕ Пользователи.РолиДоступны("ор_ПравоРазрешитьЗаписьДокументовСодержащихМедикаментыСИстекшимСрокомГодности", Пользователи.ТекущийПользователь());
	Исключение
		ПроверятьСрокиГодности = Ложь;
	КонецПопытки;
	
	СтруктураПараметров.Вставить("ПроверятьСрокиГодности",     ПроверятьСрокиГодности);
	СтруктураПараметров.Вставить("ЕстьНовыеПросроченныеСерии", Ложь);
	СтруктураПараметров.Вставить("ПодобранаПросроченнаяСерия", Ложь);
	
КонецПроцедуры

// Процедура расширяет до максимальной колонки с учетом таблицы дополнительных параметров.
//
Процедура РасширитьДоМаксимальнойКолонкиСУчетомТаблицыДопПараметров(СтруктураПараметров,МаксимальныНомерКолонки) Экспорт
	Попытка
		// Таблица серий не обязательна к заполнению справочников и регистров сведений.
		Для каждого Строка Из СтруктураПараметров.ТаблицаДополнительныхПараметров Цикл
			Если МаксимальныНомерКолонки < Строка.НомерКолонки Тогда
				МаксимальныНомерКолонки = Строка.НомерКолонки;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
КонецПроцедуры

// Процедура проверки возможности продолжения операции с учетом проверки на просроченность серий.
//
Функция НадоПрерватьОперациюИзЗаПросроченныхСерий(СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров.ЕстьНовыеПросроченныеСерии И СтруктураПараметров.ПроверятьСрокиГодности Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Функция проверки наличия колонки наименования в табличном документе
//
Функция НомерКолонкиНаименованияНеНайден(СтруктураПараметров, НомерКолонкиНаименованиеТабличногоДокумента) Экспорт
	НомерКолонкиНеНайден = Ложь;
	
	Если СтруктураПараметров.Свойство("ТаблицаДополнительныхПараметров") Тогда
		СтрокаНастройки = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Наименование товара","ИмяРеквизита");
		Если СтрокаНастройки = Неопределено Тогда
			НомерКолонкиНеНайден = Истина;
		ИначеЕсли СтрокаНастройки.РежимЗагрузки = "Вычислять" Тогда
		Иначе
			Если СтрокаНастройки.НомерКолонки = 0 Тогда
				НомерКолонкиНеНайден = Истина; 
			Иначе
				НомерКолонкиНаименованиеТабличногоДокумента = СтрокаНастройки.НомерКолонки;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли НомерКолонкиНаименованиеТабличногоДокумента = 0 Тогда
		НомерКолонкиНеНайден = Истина;
	КонецЕсли;
	
	Возврат НомерКолонкиНеНайден;
	
КонецФункции

// Функция получения структуры отраслевых дополнительных параметров
//
Функция ПолучитьСтруктуруОтраслевыхДопПараметров(СтруктураПараметров) Экспорт
	
	СтруктураДопПараметров = Новый Структура();
	СтрСтавкаНДС = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Найти("СтавкаНДС","ИмяРеквизита");
	Если НЕ СтрСтавкаНДС = Неопределено И СтрСтавкаНДС.Пометка Тогда
		НомерКолонкиСтавкаНДС = СтрСтавкаНДС.НомерКолонки;
	Иначе
		НомерКолонкиСтавкаНДС = 0;
	КонецЕсли;
	СтруктураДопПараметров.Вставить("СтрСтавкаНДС", СтрСтавкаНДС);
	СтруктураДопПараметров.Вставить("НомерКолонкиСтавкаНДС", НомерКолонкиСтавкаНДС);
	
	СтрВидСтавкиНДС = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Найти("ВидСтавкиНДС","ИмяРеквизита");
	Если НЕ СтрВидСтавкиНДС = Неопределено И СтрВидСтавкиНДС.Пометка Тогда
		НомерКолонкиВидСтавкиНДС = СтрВидСтавкиНДС.НомерКолонки;
	Иначе
		НомерКолонкиВидСтавкиНДС = 0;
	КонецЕсли;
	СтруктураДопПараметров.Вставить("СтрВидСтавкиНДС", СтрВидСтавкиНДС);
	СтруктураДопПараметров.Вставить("НомерКолонкиВидСтавкиНДС", НомерКолонкиВидСтавкиНДС);
	
	Попытка
		СтрШтрихкод = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("ШтрихКод","ИмяРеквизита");
	Исключение
		СтрШтрихкод = Неопределено;
	КонецПопытки;
	Если НЕ СтрШтрихкод = Неопределено Тогда
		НомерКолонкиШтрихкод = СтрШтрихкод.НомерКолонки;
	Иначе
		НомерКолонкиШтрихкод = 0;
	КонецЕсли;
	СтруктураДопПараметров.Вставить("СтрШтрихкод", СтрШтрихкод);
	СтруктураДопПараметров.Вставить("НомерКолонкиШтрихкод", НомерКолонкиШтрихкод);
	
	Попытка
		СтрСтранаПроисхождения = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Страна происхождения","ИмяРеквизита");
	Исключение
		СтрСтранаПроисхождения = Неопределено;
	КонецПопытки;
	Если НЕ СтрСтранаПроисхождения = Неопределено Тогда
		НомерКолонкиСтранаПроисхождения = СтрСтранаПроисхождения.НомерКолонки;
	Иначе
		НомерКолонкиСтранаПроисхождения = 0;
	КонецЕсли;
	СтруктураДопПараметров.Вставить("СтрСтранаПроисхождения", СтрСтранаПроисхождения);
	СтруктураДопПараметров.Вставить("НомерКолонкиСтранаПроисхождения", НомерКолонкиСтранаПроисхождения);
	
	Попытка
		СтрПроизводитель = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Производитель","ИмяРеквизита");
	Исключение
		СтрПроизводитель = Неопределено;
	КонецПопытки;
	Если НЕ СтрПроизводитель = Неопределено Тогда
		НомерКолонкиПроизводитель = СтрПроизводитель.НомерКолонки;
	Иначе
		НомерКолонкиПроизводитель = 0;
	КонецЕсли;
	СтруктураДопПараметров.Вставить("СтрПроизводитель", СтрПроизводитель);
	СтруктураДопПараметров.Вставить("НомерКолонкиПроизводитель", НомерКолонкиПроизводитель);
	
	Возврат СтруктураДопПараметров;
	
Конецфункции

// Функция получения наименования для таблицы соответствий
//
Функция ПолучитьНаименованиеДляТаблицыСоответствия(СтруктураПараметров,ТабличныйДокумент, ТекстыЯчеек, НомерКолонкиНаименованиеТабличногоДокумента, Строка, СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	Наименование = "";
	
	СтрокаНастройки = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Наименование товара", "ИмяРеквизита");
	Если СтрокаНастройки.РежимЗагрузки = "Искать" Тогда
		Наименование = СокрЛП(ТабличныйДокумент.Область("R"+Формат(Строка,"ЧГ=")+"C"+Формат(СтрокаНастройки.НомерКолонки,"ЧГ=")).Текст);
	Иначе
		Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаНастройки.Выражение,?(СтрокаНастройки.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаНастройки.НомерКолонки]),ТекстыЯчеек,"", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
		Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
			Наименование = Вычисление.Результат;
		Иначе
			ТекстСообщения = НСтр("ru = 'При вычислении выражения: %1
			| Произошла ошибка: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрокаНастройки.Выражение,Вычисление.ОписаниеОшибки);
			Если СтруктураПараметровЛогирования = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Иначе
				ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
			КонецЕсли;
			Наименование = "";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции

// Процедура заполняет строку таблицы соответствия по дополнительным параметрам
//
Процедура ЗаполнитьСтрокуТаблицыСоответствияПоДопПараметрам(СтруктураПараметров, НоваяСтрокаТаблСоответсвия,СтруктураОтраслевыхДополнительныхПараметров, ТабличныйДокумент, НомерСтроки, ТекстыЯчеек, СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	ВидСтавкиНДС = "";
	// Заполняем ставку НДС
	Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("НомерКолонкиСтавкаНДС") И СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиСтавкаНДС>0 Тогда
		Попытка
			СтавкаНДС = Число(СокрЛП(ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиСтавкаНДС,"ЧГ=")).Текст));
		Исключение
			СтавкаНДС = "";
		КонецПопытки;
		ВидСтавкиНДС = СтавкаНДС;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрокаТаблСоответсвия, "СтавкаНДС") Тогда
			Если СтавкаНДС = 0 Тогда
				НоваяСтрокаТаблСоответсвия.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.БезНДС);
			ИначеЕсли СтавкаНДС = 10 Тогда
				НоваяСтрокаТаблСоответсвия.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.Пониженная);
			ИначеЕсли СтавкаНДС = 18 Тогда
				НоваяСтрокаТаблСоответсвия.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.Общая);
			ИначеЕсли СтавкаНДС = 20 Тогда
				НоваяСтрокаТаблСоответсвия.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.Общая);
			Иначе
				НоваяСтрокаТаблСоответсвия.СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("НомерКолонкиВидСтавкиНДС") И СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиВидСтавкиНДС>0 Тогда
		Попытка
			ВидСтавкиНДС = Число(СокрЛП(ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиВидСтавкиНДС,"ЧГ=")).Текст));
		Исключение
			ВидСтавкиНДС = "";
		КонецПопытки;
	КонецЕсли;
	
	Если ВидСтавкиНДС <> "" И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрокаТаблСоответсвия, "ВидСтавкиНДС") Тогда
		Если ВидСтавкиНДС = 0 Тогда
			НоваяСтрокаТаблСоответсвия.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.БезНДС;
		ИначеЕсли ВидСтавкиНДС = 10 Тогда
			НоваяСтрокаТаблСоответсвия.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Пониженная;
		ИначеЕсли ВидСтавкиНДС = 18 Тогда
			НоваяСтрокаТаблСоответсвия.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
		ИначеЕсли ВидСтавкиНДС = 20 Тогда
			НоваяСтрокаТаблСоответсвия.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
		ИначеЕсли ВидСтавкиНДС = 5 Тогда
			НоваяСтрокаТаблСоответсвия.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ПониженнаяУСН;
		ИначеЕсли ВидСтавкиНДС = 7 Тогда
			НоваяСтрокаТаблСоответсвия.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ОбщаяУСН;
		Иначе
			НоваяСтрокаТаблСоответсвия.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	// Заполняем штрихкод
	Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("СтрШтрихкод") И СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод <> Неопределено И СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод.РежимЗагрузки = "Искать" Тогда
		Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("НомерКолонкиШтрихкод") И СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиШтрихкод>0 Тогда
			Попытка
				Штрихкод = СокрЛП(ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиШтрихкод,"ЧГ=")).Текст);
			Исключение
				Штрихкод = "";
			КонецПопытки;
			НоваяСтрокаТаблСоответсвия.Штрихкод = Штрихкод;
		КонецЕсли;
	ИначеЕсли СтруктураОтраслевыхДополнительныхПараметров.Свойство("СтрШтрихкод") И СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод <> Неопределено И СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод.РежимЗагрузки = "Вычислять" Тогда
		Вычисление = ВычислитьЗначениеДляХарактеристики(СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод.Выражение, ?(СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод.НомерКолонки = 0, "", ТекстыЯчеек[СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод.НомерКолонки]), ТекстыЯчеек, "", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
		Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
			Штрихкод = Вычисление.Результат;
		Иначе
			ТекстСообщения = НСтр("ru = 'При вычислении выражения: %1
			| Произошла ошибка: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтруктураОтраслевыхДополнительныхПараметров.СтрШтрихкод.Выражение,Вычисление.ОписаниеОшибки);
			Если СтруктураПараметровЛогирования = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Иначе
				ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
			КонецЕсли;
			Штрихкод = "";
		КонецЕсли;
		НоваяСтрокаТаблСоответсвия.Штрихкод = Штрихкод;
	КонецЕсли;
	
	// Заполняем страну происхождения
	Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("СтрСтранаПроисхождения") И СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения <> Неопределено И СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения.РежимЗагрузки = "Искать" Тогда
		Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("НомерКолонкиСтранаПроисхождения") И СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиСтранаПроисхождения>0 Тогда
			Попытка
				СтранаПроисхождения = СокрЛП(ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиСтранаПроисхождения,"ЧГ=")).Текст);
			Исключение
				СтранаПроисхождения = "";
			КонецПопытки;
			НоваяСтрокаТаблСоответсвия.СтранаПроисхождения = СтранаПроисхождения;
		КонецЕсли;
	ИначеЕсли СтруктураОтраслевыхДополнительныхПараметров.Свойство("СтрСтранаПроисхождения") И СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения <> Неопределено И СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения.РежимЗагрузки = "Вычислять" Тогда
		Вычисление = ВычислитьЗначениеДляХарактеристики(СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения.Выражение,?(СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения.НомерКолонки = 0, "", ТекстыЯчеек[СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения.НомерКолонки]),ТекстыЯчеек, "", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
		Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
			СтранаПроисхождения = Вычисление.Результат;
		Иначе
			ТекстСообщения = НСтр("ru = 'При вычислении выражения: %1
			| Произошла ошибка: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтруктураОтраслевыхДополнительныхПараметров.СтрСтранаПроисхождения.Выражение,Вычисление.ОписаниеОшибки);
			Если СтруктураПараметровЛогирования = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Иначе
				ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
			КонецЕсли;
			СтранаПроисхождения = "";
		КонецЕсли;
		НоваяСтрокаТаблСоответсвия.СтранаПроисхождения = СтранаПроисхождения;
	КонецЕсли;
	
	// Заполним производителя
	Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("СтрПроизводитель") И СтруктураОтраслевыхДополнительныхПараметров.СтрПроизводитель <> Неопределено Тогда
		ИщемПроизводителя = Истина;
		Если СтруктураОтраслевыхДополнительныхПараметров.СтрПроизводитель.РежимЗагрузки = "Искать" Тогда
			// Заполняем производителя
			Если СтруктураОтраслевыхДополнительныхПараметров.Свойство("НомерКолонкиПроизводитель") И СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиПроизводитель>0 Тогда
				Попытка
					Производитель = СокрЛП(ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(СтруктураОтраслевыхДополнительныхПараметров.НомерКолонкиПроизводитель,"ЧГ=")).Текст);
				Исключение
					Производитель = "";
				КонецПопытки;
			Иначе
				ИщемПроизводителя = Ложь;
			КонецЕсли;
		Иначе // СтрПроизводитель.РежимЗагрузки = "Вычислять"
			Вычисление = ВычислитьЗначениеДляХарактеристики(СтруктураОтраслевыхДополнительныхПараметров.СтрПроизводитель.Выражение,?(СтруктураОтраслевыхДополнительныхПараметров.СтрПроизводитель.НомерКолонки = 0, "", ТекстыЯчеек[СтруктураОтраслевыхДополнительныхПараметров.СтрПроизводитель.НомерКолонки]),ТекстыЯчеек, Справочники.ор_Производители.ПустаяСсылка(), СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
			Если ПустаяСтрока(СтруктураОтраслевыхДополнительныхПараметров.СтрПроизводитель.Выражение) Тогда
				ИщемПроизводителя = Ложь;
			КонецЕсли;
			Если ПустаяСтрока(Вычисление.ОписаниеОшибки)Тогда
				Попытка
					Производитель = Строка(Вычисление.Результат);
				Исключение
					Производитель = "";
				КонецПопытки;
			Иначе
				Производитель = "";
			КонецЕсли;
		КонецЕсли;
		
		НаименованиеПроизводителя = СокрЛП(Производитель);
		НоваяСтрокаТаблСоответсвия.ПроизводительЛС = НаименованиеПроизводителя;
		
		// Попробуем найти производителя по прайс листу поставщика
		ПроизводительСсылка = Неопределено;
		Если ЗначениеЗаполнено(Штрихкод) Тогда
			ПроизводительСсылка = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.НайтиЗначениеВПрайсеПоставщика(Штрихкод, "Штрихкод", СтруктураПараметров.Поставщик, "Производитель",,СтруктураПараметров.флПоискПоПрайсуПоставщика,СтруктураПараметровЛогирования);
		КонецЕсли;
		// Если не найден по прайсу поставщика, попробуем найти по наименованию
		Если НЕ ЗначениеЗаполнено(ПроизводительСсылка) Тогда
			Производители = Справочники.ор_Производители;
			Если ЗначениеЗаполнено(НаименованиеПроизводителя) Тогда
				ПроизводительСсылка = Производители.НайтиПоНаименованию(НаименованиеПроизводителя); 
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ПроизводительСсылка) и ИщемПроизводителя И Не ПустаяСтрока(НаименованиеПроизводителя) Тогда
				Если СтруктураПараметров.СоздаватьПроизводителя Тогда
					НовыйПроизводитель = Производители.СоздатьЭлемент();
					НовыйПроизводитель.Наименование = НаименованиеПроизводителя;
					НовыйПроизводитель.Записать();
					ПроизводительСсылка = НовыйПроизводитель.Ссылка;
					ТекстСообщения = НСтр("ru = 'Создан элемент справочника производителей: %1'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,НаименованиеПроизводителя);
					Если СтруктураПараметровЛогирования = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Иначе
						ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 3, СтруктураПараметровЛогирования);
					КонецЕсли;
				Иначе
					ТекстСообщения = НСтр("ru = 'Не найден элемент <%1> в справочнике производителей.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,НаименованиеПроизводителя);
					Если СтруктураПараметровЛогирования = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Иначе
						ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрокаТаблСоответсвия.Производитель = ПроизводительСсылка;
	КонецЕсли;
	
	// Если в прайс грузим цену, то ее тоже заполняем
	СтрокаНастройки = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Цена", "ИмяРеквизита");
	Если СтрокаНастройки = Неопределено Тогда
		НомерКолонкиЦена = 0;
	Иначе
		НомерКолонкиЦена = СтрокаНастройки.НомерКолонки;
	КонецЕсли;
	Если СтрокаНастройки <> Неопределено И СтрокаНастройки.РежимЗагрузки = "Искать" Тогда
		Если НомерКолонкиЦена>0 Тогда
			Попытка
				НоваяСтрокаТаблСоответсвия.Цена = Число(СокрЛП(ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(НомерКолонкиЦена,"ЧГ=")).Текст));
			Исключение
				НоваяСтрокаТаблСоответсвия.Цена = 0; //Цена не найдена
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли СтрокаНастройки <> Неопределено И СтрокаНастройки.РежимЗагрузки = "Вычислять" Тогда
		Вычисление = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ВычислитьЗначениеДляХарактеристики(СтрокаНастройки.Выражение,?(СтрокаНастройки.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаНастройки.НомерКолонки]),ТекстыЯчеек, 0, СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
		Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
			НоваяСтрокаТаблСоответсвия.Цена = Вычисление.Результат;
		Иначе
			ТекстСообщения = НСтр("ru = 'При вычислении выражения: %1
			| Произошла ошибка: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрокаНастройки.Выражение,Вычисление.ОписаниеОшибки);
			Если СтруктураПараметровЛогирования = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Иначе
				ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
			КонецЕсли;
			НоваяСтрокаТаблСоответсвия.Цена = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


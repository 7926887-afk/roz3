// Процедура выполняет загрузку заводских ШК.
//
Процедура ЗагрузитьЗаводскиеШК(СтруктураПараметров, СтруктураПараметровЛогирования = Неопределено) Экспорт
	// Разберемся с заводскими ШК.
	Если СтруктураПараметров.ЗагружатьШК И СтруктураПараметров.СоответствиеНоменклатуры.Количество() > 0 Тогда
		Для Каждого СтрокаТЧ Из СтруктураПараметров.СоответствиеНоменклатуры Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Штрихкод) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			ЗарегистрироватьШтрихКод(СтрокаТЧ.Штрихкод, СтрокаТЧ.Номенклатура, Неопределено, Неопределено, СтруктураПараметровЛогирования, Ложь);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Процедура заполняет реквизиты предопределенного элемента.
//
// Параметры:
//  Объект    - СправочникОбъект.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента - объект, реквизиты
//                      которого надо заполнить.
//  Настройки - ТабличныйДокумент - Табличный документ.
//
// Возвращаемое значение:
//  Булево - признак успешности выполнения операции.
//
Функция ЗаполнитьНастройкиЗагрузкиИзТабличногоДокумента(Объект, Настройки)
	
	Если ТипЗнч(Настройки)<>Тип("ТабличныйДокумент") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		ВерсияОбработки = СокрЛП(Настройки.Область("R1C5").Текст);
		
		ТекстВосстановленногоРежимаЗагрузки = СокрЛП(Настройки.Область("R2C5").Текст);
		Если (ТекстВосстановленногоРежимаЗагрузки <> "в табличную часть"
				И ТекстВосстановленногоРежимаЗагрузки <> "в справочник")
				И ТекстВосстановленногоРежимаЗагрузки <> "Х" Тогда
			Возврат Ложь;
		КонецЕсли;
		
		фМетаданныеИсточника = Метаданные.НайтиПоПолномуИмени(СокрЛП(Настройки.Область("R3C5").Текст));
		Если фМетаданныеИсточника = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Объект.ЗапретСозданияНовыхЭлементов = НЕ ПустаяСтрока(Настройки.Область("R4C5").Текст);
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	// Заполним реквизиты справочника настроек.
	Если Объект.ВариантИспользованияНастройки <> Перечисления.ор_ВариантыИспользованияНастройки.ЗагрузкаДанных Тогда
		Объект.ВариантИспользованияНастройки = Перечисления.ор_ВариантыИспользованияНастройки.ЗагрузкаДанных;
	КонецЕсли;
	
	Если Метаданные.РегистрыСведений.Содержит(фМетаданныеИсточника) Тогда
		// Это регистр сведений.
		Объект.ТипПрикладногоОбъекта           = Перечисления.ор_ТипыПрикладныхОбъектов.РегистрСведений;
		Объект.ИмяПрикладногоОбъекта           = фМетаданныеИсточника.Имя;
		Объект.ИмяТабличнойЧасти               = "";
		Объект.ПредставлениеПрикладногоОбъекта = фМетаданныеИсточника.Представление();
		Объект.ПредставлениеТабличнойЧасти     = "";
	ИначеЕсли Метаданные.Справочники.Содержит(фМетаданныеИсточника) Тогда
		// Это справочник.
		Объект.ТипПрикладногоОбъекта           = Перечисления.ор_ТипыПрикладныхОбъектов.Справочник;
		Объект.ИмяПрикладногоОбъекта           = фМетаданныеИсточника.Имя;
		Объект.ИмяТабличнойЧасти               = "";
		Объект.ПредставлениеПрикладногоОбъекта = фМетаданныеИсточника.Представление();
		Объект.ПредставлениеТабличнойЧасти     = "";
	Иначе
		// Это ТЧ, только надо разобраться, чья.
		Если Метаданные.Документы.Содержит(фМетаданныеИсточника.Родитель()) Тогда
			Объект.ТипПрикладногоОбъекта = Перечисления.ор_ТипыПрикладныхОбъектов.Документ;
		ИначеЕсли Метаданные.Справочники.Содержит(фМетаданныеИсточника.Родитель()) Тогда
			Объект.ТипПрикладногоОбъекта = Перечисления.ор_ТипыПрикладныхОбъектов.Справочник;
		ИначеЕсли Метаданные.Обработки.Содержит(фМетаданныеИсточника.Родитель()) Тогда
			Объект.ТипПрикладногоОбъекта = Перечисления.ор_ТипыПрикладныхОбъектов.Обработка;
		КонецЕсли;
		Объект.ИмяПрикладногоОбъекта           = фМетаданныеИсточника.Родитель().Имя;
		Объект.ИмяТабличнойЧасти               = фМетаданныеИсточника.Имя;
		Объект.ПредставлениеПрикладногоОбъекта = фМетаданныеИсточника.Родитель().Представление();
		Объект.ПредставлениеТабличнойЧасти     = фМетаданныеИсточника.Представление();
	КонецЕсли;
	
	Объект.НастройкиЗагрузкиВыгрузки = Новый ХранилищеЗначения(Настройки);
	
	Возврат Истина;
	
КонецФункции

// Получить цену загружаемой серии.
//
Функция ПолучитьЦенуЗагружаемойСерии(ТекстыЯчеек, ТаблицаЗагружаемыхРеквизитов) Экспорт
	
	Попытка
		НайденнаяСтрока = ТаблицаЗагружаемыхРеквизитов.Найти("Цена","ИмяРеквизита");
		Если НайденнаяСтрока <> Неопределено Тогда 
			НомерКолонкиЦена = НайденнаяСтрока.НомерКолонки;
			Если ЗначениеЗаполнено(НомерКолонкиЦена)  Тогда
				Возврат Число(ТекстыЯчеек[НомерКолонкиЦена]);
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат 0;
	
КонецФункции

// Функция получает штрихкод номенклатуры из настроек
//
Функция ПолучитьШКНоменклатурыИзНастроек(СтруктураПараметров, ТекстыЯчеек, СтруктураПараметровЛогирования = Неопределено) Экспорт
	Попытка
		СтрокаШтрихКод   = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("ШтрихКод","ИмяРеквизита");
		НомерКолонкиШтрихКод = СтрокаШтрихКод.НомерКолонки;
	Исключение
		СтрокаШтрихКод = Неопределено;
		НомерКолонкиШтрихКод = 0;
	КонецПопытки;
	
	// Найдем штрихкод 
	Если ЗначениеЗаполнено(СтрокаШтрихКод) И СтрокаШтрихКод.РежимЗагрузки = "Искать" И ЗначениеЗаполнено(НомерКолонкиШтрихКод) И ЗначениеЗаполнено(ТекстыЯчеек[НомерКолонкиШтрихКод])Тогда
		ВозвращаемыйШтрихКод = ТекстыЯчеек[НомерКолонкиШтрихКод];
	ИначеЕсли ЗначениеЗаполнено(СтрокаШтрихКод) И СтрокаШтрихКод.РежимЗагрузки = "Вычислять" Тогда
		Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаШтрихКод.Выражение,?(СтрокаШтрихКод.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаШтрихКод.НомерКолонки]),ТекстыЯчеек, "", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
		Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
			ВозвращаемыйШтрихКод = Вычисление.Результат;
		Иначе
			ВозвращаемыйШтрихКод = "";
		КонецЕсли;
	Иначе
		ВозвращаемыйШтрихКод = "";
	КонецЕсли;
	
	Возврат ВозвращаемыйШтрихКод;
	
КонецФункции

// Функция получает штрихкод номенклатуры из параметров
//
Функция ПолучитьШтрихкодИзПараметров(ТабличныйДокумент, СтруктураПараметров, ТекстыЯчеек, СтруктураПараметровЛогирования = Неопределено) Экспорт
	


#Область СлужебныеПроцедурыИФункции

// Процедура заполненяет предопределенные настроек
//
Процедура ЗаполнитьПредопределенныеНастройки() Экспорт
	
	// Заполним соответствие предопределенных элементов и имен макетов шаблонов настроек.
	СоответствиеМакетовИЭлементов = Новый Соответствие();
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.АптекаХолд,
		"НастройкаАптекаХолд");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.Генезис,
		"НастройкаГенезис");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.Катрен,
		"НастройкаКатрен");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.Морон,
		"НастройкаМорон");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.Протек,
		"НастройкаПротек");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.Сиа,
		"НастройкаСиа");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ЗагрузкаФальсификатовMDB,
		"НастройкаЗагрузкаФальсификатовMDB");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ЗагрузкаФальсификатовDBF,
		"НастройкаЗагрузкаФальсификатовDBF");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ЗагрузкаЦенЖНВЛС,
		"НастройкаЗагрузкаЦенЖНВЛС");
	СоответствиеМакетовИЭлементов.Вставить(Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ЗагрузкаЦенЖНВЛСНедействующие,
		"НастройкаЗагрузкаЦенЖНВЛСНедействующие");
	
	Для Каждого Элемент Из СоответствиеМакетовИЭлементов Цикл
		
		СправочникОбъект = Элемент.Ключ.ПолучитьОбъект();
		
		// Пропустим уже заполненные настройки (заполненными могут быть при конвертации, их будем конвертировать).
		Настройки = СправочникОбъект.НастройкиЗагрузкиВыгрузки.Получить();
		//Если ТипЗнч(Настройки)=Тип("ТабличныйДокумент") Тогда
		//	Продолжить;
		//КонецЕсли;
		
		Если ЗаполнитьНастройкиЗагрузкиИзТабличногоДокумента(СправочникОбъект, СправочникОбъект.ПолучитьМакет(Элемент.Значение)) Тогда
			Попытка
				СправочникОбъект.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

// Заполняет настройки колонок по умолчанию для табличной части доп. параметров справочника настроек
//
// Параметры:
//  НастройкиДопПараметров - Соответствие - Соответствие данных для заполнения значений колонки "НомерКолонки"
//
Процедура ЗаполнитьНастройкиКолонокТабличнойЧастиДопПараметровСправочникаНастроек(НастройкиПараметров=Неопределено, ТаблицаДополнительныхПараметров = Неопределено) Экспорт
	
	Если ТаблицаДополнительныхПараметров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДополнительныхПараметров.Очистить();

	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Номер серии производителя";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Срок годности";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Производитель";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Сертификат";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "ШтрихКод";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Наименование характеристики";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Наименование товара";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Цена";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Страна происхождения";
	
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Орган выдавший сертификат";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Срок действия сертификата";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Декларацию зарегистрировал";
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Декларант";
	
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "Маркируемый товар";
	
	ЗагружаемыйРеквизит                     = ТаблицаДополнительныхПараметров.Добавить();
	ЗагружаемыйРеквизит.ИмяРеквизита        = "GTIN";
	
	Если НастройкиПараметров <> Неопределено Тогда
		Для Каждого Строка Из ТаблицаДополнительныхПараметров Цикл
			Строка.НомерКолонки  = НастройкиПараметров[Строка.ИмяРеквизита];
			Строка.РежимЗагрузки = НастройкиПараметров[Строка.ИмяРеквизита + " РежимЗагрузки"];
			Строка.Выражение     = НастройкиПараметров[Строка.ИмяРеквизита + " Выражение"];
			Если НЕ ЗначениеЗаполнено(Строка.РежимЗагрузки) Тогда
				Строка.РежимЗагрузки = "Искать";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Процедура заполненяет соответствие параметров из флагов
//
Функция ЗаполнитьСоответствиеПараметровИзФлагов(ВерсияОбработки, СтруктураФлагов, Настройки) Экспорт
	
	НастройкиПараметров = Новый Соответствие;
	НастройкиПараметров.Вставить("Номер серии производителя", СтруктураФлагов.НомерСерииПроизводителя);
	НастройкиПараметров.Вставить("Срок годности"            , СтруктураФлагов.СрокГодности);
	НастройкиПараметров.Вставить("Сертификат"               , СтруктураФлагов.Сертификат);
	НастройкиПараметров.Вставить("Производитель"            , СтруктураФлагов.Производитель);
	НастройкиПараметров.Вставить("ШтрихКод"                 , СтруктураФлагов.ШтрихКод);
	НастройкиПараметров.Вставить("Наименование товара"      , СтруктураФлагов.НаименованиеТовара);
	НастройкиПараметров.Вставить("Цена"                     , СтруктураФлагов.Цена);
	НастройкиПараметров.Вставить("Страна происхождения"     , СтруктураФлагов.СтранаПроисхождения);
	
	НастройкиПараметров.Вставить("Номер серии производителя РежимЗагрузки", Настройки.Область("R43C5").Текст);
	НастройкиПараметров.Вставить("Номер серии производителя Выражение"    , Настройки.Область("R44C5").Текст);
	
	НастройкиПараметров.Вставить("Срок годности РежимЗагрузки", Настройки.Область("R47C5").Текст);
	НастройкиПараметров.Вставить("Срок годности Выражение"    , Настройки.Область("R48C5").Текст);
	
	НастройкиПараметров.Вставить("Сертификат РежимЗагрузки", Настройки.Область("R57C5").Текст);
	НастройкиПараметров.Вставить("Сертификат Выражение"    , Настройки.Область("R58C5").Текст);
	
	НастройкиПараметров.Вставить("Производитель РежимЗагрузки", Настройки.Область("R50C5").Текст);
	НастройкиПараметров.Вставить("Производитель Выражение"    , Настройки.Область("R51C5").Текст);
	
	НастройкиПараметров.Вставить("ШтрихКод РежимЗагрузки", Настройки.Область("R24C5").Текст);
	НастройкиПараметров.Вставить("ШтрихКод Выражение"    , Настройки.Область("R25C5").Текст);
	
	НастройкиПараметров.Вставить("Наименование товара РежимЗагрузки", Настройки.Область("R33C5").Текст);
	НастройкиПараметров.Вставить("Наименование товара Выражение"    , Настройки.Область("R34C5").Текст);
	
	НастройкиПараметров.Вставить("Цена РежимЗагрузки", Настройки.Область("R39C5").Текст);
	НастройкиПараметров.Вставить("Цена Выражение"    , Настройки.Область("R40C5").Текст);
	
	НастройкиПараметров.Вставить("Страна происхождения РежимЗагрузки", Настройки.Область("R54C5").Текст);
	НастройкиПараметров.Вставить("Страна происхождения Выражение"    , Настройки.Область("R55C5").Текст);
	
	НастройкиПараметров.Вставить("Наименование характеристики"              , Настройки.Область("R35C5").Текст);
	НастройкиПараметров.Вставить("Наименование характеристики РежимЗагрузки", Настройки.Область("R36C5").Текст);
	НастройкиПараметров.Вставить("Наименование характеристики Выражение"    , Настройки.Область("R37C5").Текст);
	
	// Необходимо для реестра сертификатов соответствий.
	НастройкиПараметров.Вставить("Срок действия сертификата"              , Настройки.Область("R61C5").Текст);
	НастройкиПараметров.Вставить("Срок действия сертификата РежимЗагрузки", Настройки.Область("R62C5").Текст);
	НастройкиПараметров.Вставить("Срок действия сертификата Выражение"    , Настройки.Область("R63C5").Текст);
	
	НастройкиПараметров.Вставить("Орган выдавший сертификат"              , Настройки.Область("R64C5").Текст);
	НастройкиПараметров.Вставить("Орган выдавший сертификат РежимЗагрузки", Настройки.Область("R65C5").Текст);
	НастройкиПараметров.Вставить("Орган выдавший сертификат Выражение"    , Настройки.Область("R66C5").Текст);
	
	НастройкиПараметров.Вставить("Декларацию зарегистрировал"              , Настройки.Область("R67C5").Текст);
	НастройкиПараметров.Вставить("Декларацию зарегистрировал РежимЗагрузки", Настройки.Область("R68C5").Текст);
	НастройкиПараметров.Вставить("Декларацию зарегистрировал Выражение"    , Настройки.Область("R69C5").Текст);
	
	НастройкиПараметров.Вставить("Декларант"              , Настройки.Область("R70C5").Текст);
	НастройкиПараметров.Вставить("Декларант РежимЗагрузки", Настройки.Область("R71C5").Текст);
	НастройкиПараметров.Вставить("Декларант Выражение"    , Настройки.Область("R72C5").Текст);
	
	НастройкиПараметров.Вставить("Маркируемый товар"              , Настройки.Область("R73C5").Текст);
	НастройкиПараметров.Вставить("Маркируемый товар РежимЗагрузки", Настройки.Область("R74C5").Текст);
	НастройкиПараметров.Вставить("Маркируемый товар Выражение"    , Настройки.Область("R75C5").Текст);
	
	НастройкиПараметров.Вставить("GTIN"              , Настройки.Область("R76C5").Текст);
	НастройкиПараметров.Вставить("GTIN РежимЗагрузки", Настройки.Область("R77C5").Текст);
	НастройкиПараметров.Вставить("GTIN Выражение"    , Настройки.Область("R78C5").Текст);
	
	Возврат НастройкиПараметров;
	
КонецФункции

// Процедура заполненяет табличный документ настройками дополнительных параметров
//
Процедура ЗаполнитьТабличныйДокументНастройкамиДопПараметров(ОбластьШапки, СтруктураПараметров) Экспорт
	Попытка
		ОбластьШапки.Параметры.ФорматДатыСрокаГодности           = СтруктураПараметров.ФорматДатыСрокаГодности;
		ОбластьШапки.Параметры.ВсегдаФормироватьНовыеСерии       = ?(СтруктураПараметров.ВсегдаФормироватьНовыеСерии, "Х","");
		ОбластьШапки.Параметры.СоздаватьСтрануПроисхождения      = ?(СтруктураПараметров.СоздаватьСтрануПроисхождения, "Х","");
		ОбластьШапки.Параметры.ЗагружатьGTINДляСерии             = ?(СтруктураПараметров.ЗагружатьGTINДляСерии, "Х","");
		ОбластьШапки.Параметры.НеФормироватьДопНомерСерии        = ?(СтруктураПараметров.НеФормироватьДопНомерСерии, "Х","");
		ОбластьШапки.Параметры.СоздаватьПроизводителя            = ?(СтруктураПараметров.СоздаватьПроизводителя, "Х","");
		ОбластьШапки.Параметры.ЗагружатьШК                       = ?(СтруктураПараметров.ЗагружатьШК, "Х","");
		ОбластьШапки.Параметры.ШКЯвляетсяПолемПоискаНоменклатуры = ?(СтруктураПараметров.Свойство("ШКЯвляетсяПолемПоискаНоменклатуры"),?(СтруктураПараметров.ШКЯвляетсяПолемПоискаНоменклатуры, "Х",""), "");
		ОбластьШапки.Параметры.СоздаватьОбщиеХарактеристики      = ?(СтруктураПараметров.Свойство("СоздаватьОбщиеХарактеристики"),?(СтруктураПараметров.СоздаватьОбщиеХарактеристики, "Х",""), "");
		Для Каждого СтрокаТаблицы Из СтруктураПараметров.ТаблицаДополнительныхПараметров Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.РежимЗагрузки) Тогда
				СтрокаТаблицы.РежимЗагрузки = "Искать";
			КонецЕсли;
		КонецЦикла;
		
		Если ТипЗнч(СтруктураПараметров.ТаблицаДополнительныхПараметров) = Тип("ТаблицаЗначений") Тогда
			ТаблицаВременная = СтруктураПараметров.ТаблицаДополнительныхПараметров.Скопировать();
		Иначе
			ТаблицаВременная = СтруктураПараметров.ТаблицаДополнительныхПараметров.Выгрузить();
		КонецЕсли;
		
		НайденнаяСтрока = ТаблицаВременная.Найти("Номер серии производителя","ИмяРеквизита");
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииНомер              = НайденнаяСтрока.НомерКолонки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииНомерРежимЗагрузки = НайденнаяСтрока.РежимЗагрузки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииНомерВыражение     = НайденнаяСтрока.Выражение;
		
		НайденнаяСтрока = ТаблицаВременная.Найти("Срок годности","ИмяРеквизита");
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииСрокГодности             = НайденнаяСтрока.НомерКолонки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииСрокГодностиРежимЗагрузки = НайденнаяСтрока.РежимЗагрузки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииСрокГодностиВыражение     = НайденнаяСтрока.Выражение;
		
		НайденнаяСтрока = ТаблицаВременная.Найти("Производитель","ИмяРеквизита");
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииПроизводитель              = НайденнаяСтрока.НомерКолонки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииПроизводительРежимЗагрузки = НайденнаяСтрока.РежимЗагрузки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииПроизводительВыражение     = НайденнаяСтрока.Выражение;
		
		НайденнаяСтрока = ТаблицаВременная.Найти("Сертификат","ИмяРеквизита");
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииСертификат              = НайденнаяСтрока.НомерКолонки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииСертификатРежимЗагрузки = НайденнаяСтрока.РежимЗагрузки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииСертификатВыражение     = НайденнаяСтрока.Выражение;
		
		НайденнаяСтрока = ТаблицаВременная.Найти("ШтрихКод","ИмяРеквизита");

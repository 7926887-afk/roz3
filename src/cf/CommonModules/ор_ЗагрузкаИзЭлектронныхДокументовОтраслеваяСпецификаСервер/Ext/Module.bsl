		Если СтрокаОрганЗарегистрировавшийДекларацию.РежимЗагрузки = "Искать" Тогда
			Если ЗначениеЗаполнено(НомерКолонкиОрганЗарегистрировавшийДекларацию) Тогда
				обСерия.ор_ОрганЗарегистрировавшийДекларацию= ТекстыЯчеек[НомерКолонкиОрганЗарегистрировавшийДекларацию];
			КонецЕсли;
		Иначе // Если СтрокаОрганЗарегистрировавшийДекларацию.РежимЗагрузки = "Вычислять" Тогда
			Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаОрганЗарегистрировавшийДекларацию.Выражение,?(СтрокаОрганЗарегистрировавшийДекларацию.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаОрганЗарегистрировавшийДекларацию.НомерКолонки]),ТекстыЯчеек,"", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
			Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
				обСерия.ор_ОрганЗарегистрировавшийДекларацию = Вычисление.Результат;
			Иначе
				ТекстСообщения = НСтр("ru= 'При вычислении выражения
				| <%1>
				| Произошла ошибка: %2'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СтрокаОрганЗарегистрировавшийДекларацию.Выражение, Вычисление.ОписаниеОшибки);
				Если СтруктураПараметровЛогирования = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Иначе
					ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаДекларант.РежимЗагрузки = "Искать" Тогда
			обСерия.ор_Декларант = ТекстыЯчеек[НомерКолонкиДекларант];
		Иначе // Если СтрокаДекларант.РежимЗагрузки = "Вычислять" Тогда
			Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаДекларант.Выражение,?(СтрокаДекларант.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаДекларант.НомерКолонки]),ТекстыЯчеек,"", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
			Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
				обСерия.ор_Декларант = Вычисление.Результат;
			Иначе
				ТекстСообщения = НСтр("ru = 'Не удалось вычислить обязательные реквизиты, не можем сформировать новую серию!
				| %1'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,Вычисление.ОписаниеОшибки); 
				Если СтруктураПараметровЛогирования = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Иначе
					ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
				КонецЕсли;
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		
		Если СтрокаСтранаПроисхождения.РежимЗагрузки = "Искать" Тогда
			Если ЗначениеЗаполнено(НомерКолонкиСтранаПроисхождения) Тогда
				спрСтраныМира = Справочники.СтраныМира;
				// Попробуем найти по наименованию
				Если ЗначениеЗаполнено(ТекстыЯчеек[НомерКолонкиСтранаПроисхождения]) Тогда
					сСтранаПроисхождения = спрСтраныМира.НайтиПоНаименованию(СокрЛП(ТекстыЯчеек[НомерКолонкиСтранаПроисхождения]),Истина);
					Если НЕ сСтранаПроисхождения.Пустая() Тогда 
						обСерия.ор_СтранаПроисхождения = сСтранаПроисхождения;
					ИначеЕсли СтруктураПараметров.СоздаватьСтрануПроисхождения Тогда
						НаименованиеСтраны = ТекстыЯчеек[НомерКолонкиСтранаПроисхождения];
						НоваяСтрана = спрСтраныМира.СоздатьЭлемент();
						ДанныеКлассификатора = Справочники.СтраныМира.ДанныеКлассификатораСтранМираПоНаименованию(ВРег(НаименованиеСтраны));
						Если ДанныеКлассификатора = Неопределено Тогда
							НоваяСтрана.Наименование = НаименованиеСтраны;
							НоваяСтрана.Код = "--";
						Иначе
							ЗаполнитьЗначенияСвойств(НоваяСтрана, ДанныеКлассификатора);
						КонецЕсли;
						НоваяСтрана.Записать();
						обСерия.ор_СтранаПроисхождения = НоваяСтрана.Ссылка;
						
						ТекстСообщения = НСтр("ru = 'Создан элемент справочника стран мира: %1'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,НаименованиеСтраны);
						Если СтруктураПараметровЛогирования = Неопределено Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Иначе
							ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 3, СтруктураПараметровЛогирования);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе // Если СтрокаСтранаПроисхождения.РежимЗагрузки = "Вычислять" Тогда
			Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаСтранаПроисхождения.Выражение,?(СтрокаСтранаПроисхождения.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаСтранаПроисхождения.НомерКолонки]),ТекстыЯчеек,Справочники.СтраныМира.ПустаяСсылка(), СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
			Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
				обСерия.ор_СтранаПроисхождения = Вычисление.Результат;
			Иначе
				ТекстСообщения = НСтр("ru= 'При вычислении выражения
				| %1
				| Произошла ошибка: %2'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СтрокаСтранаПроисхождения.Выражение, Вычисление.ОписаниеОшибки);
				Если СтруктураПараметровЛогирования = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Иначе
					ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаНаименование.РежимЗагрузки = "Вычислять" Тогда
			Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаНаименование.Выражение,?(СтрокаНаименование.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаНаименование.НомерКолонки]),ТекстыЯчеек, "", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
			Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
				обСерия.Наименование = Вычисление.Результат;
			Иначе
				ТекстСообщения = НСтр("ru= 'Не удалось вычислить наименование серии! Серия не сформирована!
				| <%1>'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Вычисление.ОписаниеОшибки);
				Если СтруктураПараметровЛогирования = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Иначе
					ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
				КонецЕсли;
				обСерия = Неопределено;
				Возврат Неопределено;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(НомерКолонкиНаименование) Тогда
			обСерия.Наименование = ТекстыЯчеек[НомерКолонкиНаименование];
		ИначеЕсли ДопНомерСерии = 0 ИЛИ НеФормироватьДопНомерСерии Тогда
			обСерия.Наименование = обСерия.ор_СерияПроизводителя+", "+Формат(обСерия.ор_СрокГодности, "ДФ=dd.MM.yyyy");
		Иначе
			обСерия.Наименование = обСерия.ор_СерияПроизводителя+" '"+ДопНомерСерии+"'"+", "+Формат(обСерия.ор_СрокГодности, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		обСерия.НаименованиеДляПечати = обСерия.Наименование;
		
		Если НЕ НеФормироватьДопНомерСерии Тогда
			// Теперь проверим, чтобы не было серий с таким наименованием
			НайдСерия = СпрХарактеристики.НайтиПоНаименованию(СокрЛП(обСерия.Наименование), Истина, ВладелецСерии);
			Если ЗначениеЗаполнено(НайдСерия) Тогда
				Сч = ?(ДопНомерСерии=0, 1, ДопНомерСерии);
				Пока Истина Цикл
					Если СтрокаНаименование.РежимЗагрузки = "Вычислять" ИЛИ (ЗначениеЗаполнено(НомерКолонкиНаименование) И  СтрокаНаименование.РежимЗагрузки = "Искать") Тогда
						НаименованиеСерии ="'"+Сч+"' "+обСерия.Наименование;
					Иначе
						НаименованиеСерии = обСерия.ор_СерияПроизводителя+" '"+Сч+"'"+", "+Формат(обСерия.ор_СрокГодности, "ДФ=dd.MM.yyyy");
					КонецЕсли;
					НайдСерия = СпрХарактеристики.НайтиПоНаименованию(НаименованиеСерии, Истина, ВладелецСерии);
					Если Не ЗначениеЗаполнено(НайдСерия) Тогда
						обСерия.Наименование = НаименованиеСерии;
						Прервать;
					КонецЕсли;
					Сч = Сч+1;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ЗаписатьОбъект(обСерия,СтруктураПараметров,,СтруктураПараметровЛогирования) Тогда
			ТекстСообщения = НСтр("ru= 'Сформирована новая серия <%1> владельца <%2>'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, обСерия,ВладелецСерии);
			Если СтруктураПараметровЛогирования = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Иначе
				ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 3, СтруктураПараметровЛогирования);
			КонецЕсли;
			
			// Сформируем штрихкод серии.
			Если ЗначениеЗаполнено(СтрокаШтрихКод) И СтрокаШтрихКод.РежимЗагрузки = "Искать" И ЗначениеЗаполнено(НомерКолонкиШтрихКод) И ЗначениеЗаполнено(ТекстыЯчеек[НомерКолонкиШтрихКод])Тогда
				ШтрихКодСерии = ТекстыЯчеек[НомерКолонкиШтрихКод];
			ИначеЕсли ЗначениеЗаполнено(СтрокаШтрихКод) И СтрокаШтрихКод.РежимЗагрузки = "Вычислять" Тогда
				Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаШтрихКод.Выражение,?(СтрокаШтрихКод.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаШтрихКод.НомерКолонки]),ТекстыЯчеек, "", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
				Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
					ШтрихКодСерии = Вычисление.Результат;
				Иначе
					ШтрихКодСерии = "";
				КонецЕсли;
			Иначе
				ШтрихКодСерии = "";
			КонецЕсли;
			
			Если СтруктураПараметров.Свойство("НоменклатураДляЗаписиШК") Тогда
				ЗарегистрироватьШтрихКод(ШтрихКодСерии,СтруктураПараметров.НоменклатураДляЗаписиШК,обСерия.Ссылка,Неопределено, СтруктураПараметровЛогирования);
			КонецЕсли;
			
			// Сформируем штрихкод серии 
			Если ЗначениеЗаполнено(СтрокаGTIN) И СтрокаGTIN.РежимЗагрузки = "Искать" И ЗначениеЗаполнено(НомерКолонкиGTIN) И ЗначениеЗаполнено(ТекстыЯчеек[НомерКолонкиGTIN])Тогда
				GTINСерии = ТекстыЯчеек[НомерКолонкиGTIN];
			ИначеЕсли ЗначениеЗаполнено(СтрокаGTIN) И СтрокаGTIN.РежимЗагрузки = "Вычислять" Тогда
				Вычисление = ВычислитьЗначениеДляХарактеристики(СтрокаGTIN.Выражение,?(СтрокаGTIN.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаGTIN.НомерКолонки]),ТекстыЯчеек, "", СтруктураПараметров.СсылкаИсточника, СтруктураПараметровЛогирования);
				Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
					GTINСерии = Вычисление.Результат;
				Иначе
					GTINСерии = "";
				КонецЕсли;
			Иначе
				GTINСерии = "";
			КонецЕсли;
			
			ДляХарактеристики = Ложь;
			Если СтруктураПараметров.Свойство("ЗагружатьGTINДляСерии") Тогда
				ДляХарактеристики = СтруктураПараметров.ЗагружатьGTINДляСерии;
			КонецЕсли;
			
			Если СтруктураПараметров.Свойство("НоменклатураДляЗаписиШК") И ЗначениеЗаполнено(GTINСерии) И обСерия.ор_МаркируемыйТовар Тогда
				Если ДляХарактеристики Тогда
					ЗарегистрироватьGTIN(GTINСерии, СтруктураПараметров.НоменклатураДляЗаписиШК, обСерия.Ссылка, СтруктураПараметровЛогирования);
				Иначе
					ЗарегистрироватьGTIN(GTINСерии, СтруктураПараметров.НоменклатураДляЗаписиШК, Неопределено, СтруктураПараметровЛогирования);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат обСерия.Ссылка;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Регистрирует GTIN в регистре сведений
//
Процедура ЗарегистрироватьGTIN(GTIN, Номенклатура, ХарактеристикаНоменклатуры, СтруктураПараметровЛогирования = Неопределено) Экспорт 
	
	Если ХарактеристикаНоменклатуры = Неопределено Тогда
		ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегШтрихкоды.Номенклатура КАК Номенклатура,
	|	РегШтрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК РегШтрихкоды
	|ГДЕ
	|	РегШтрихкоды.Штрихкод = &Штрихкод
	|	И РегШтрихкоды.Номенклатура = &Номенклатура
	|	И РегШтрихкоды.Характеристика = &Характеристика
	|");
	
	Запрос.УстановитьПараметр("Штрихкод", GTIN);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", ХарактеристикаНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТекЗапись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	ТекЗапись.Штрихкод       = GTIN;
	ТекЗапись.Номенклатура  = Номенклатура;
	ТекЗапись.Характеристика = ХарактеристикаНоменклатуры;
	
	Попытка
		ТекЗапись.Записать();
	Исключение
		ТекстОшибки = НСтр("ru= 'Ошибка при записи GTIN: %1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ИнформацияОбОшибке().Описание);
		Если СтруктураПараметровЛогирования = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Иначе
			ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстОшибки, 1, СтруктураПараметровЛогирования);
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

// Регистрирует серию в регистре сведений
//
// Параметры:
//  ШтрихКод	       – Строка	– Строка штрих-кода.
//  Номенклатура	   – СправочникСсылка.Номенклатура	– номенклатура для которой формируем штрих-код.
//  Характеристика	   – СправочникСсылка.ХарактеристикиНоменклатуры – характеристика для которой формируем штрих-кода.
//  ЕдиницаИзмерения   – СправочникСсылка.ЕдиницыИзмерения	– единица измерения штрих-кода.
//
Процедура ЗарегистрироватьШтрихКод(ШтрихКод,Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения, СтруктураПараметровЛогирования = Неопределено, СоздаватьНовыйШК = Истина) Экспорт 
	
	ТекЗапись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	ТекЗапись.Номенклатура   = Номенклатура;
	ТекЗапись.Характеристика = ХарактеристикаНоменклатуры;
	
	Если НЕ ЗначениеЗаполнено(ШтрихКод) Тогда
		ТекЗапись.Штрихкод               = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьШтрихкодEAN13();
	Иначе
		Запрос = Новый Запрос("
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	РегШтрихкоды.Номенклатура КАК Номенклатура,
		|	РегШтрихкоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК РегШтрихкоды
		|ГДЕ
		|	РегШтрихкоды.ШтрихКод = &ШтрихКод
		|");
		
		Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() ИЛИ Константы.ИспользоватьНеуникальныеШтрихкоды.Получить() Тогда
			ТекЗапись.Штрихкод = ШтрихКод;
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Если СоздаватьНовыйШК Тогда
				ТекстОшибки = НСтр("ru= 'Штрихкод %1 уже имеет владельца <%2>. Будет сформирован новый штрихкод.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.ШтрихКод, СокрЛП(Выборка.Номенклатура));
				Если СтруктураПараметровЛогирования = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Иначе
					ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстОшибки, 2, СтруктураПараметровЛогирования);
				КонецЕсли;
				ТекЗапись.Штрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьШтрихкодEAN13();
			Иначе
				ТекстОшибки = НСтр("ru= 'Штрихкод %1 уже имеет владельца <%2>.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.ШтрихКод, СокрЛП(Выборка.Номенклатура));
				Если СтруктураПараметровЛогирования = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Иначе
					ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстОшибки, 2, СтруктураПараметровЛогирования);
				КонецЕсли;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		ТекЗапись.Записать();
	Исключение
		ТекстОшибки = НСтр("ru= 'Ошибка при записи штрихкода: %1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ИнформацияОбОшибке().Описание);
		Если СтруктураПараметровЛогирования = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Иначе
			ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстОшибки, 1, СтруктураПараметровЛогирования);
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

// Получить дату в формате
//
Функция ПолучитьДатуСрокаГодностиСерии(СтрокаДаты, ФорматДатыСрокаГодности) Экспорт
	
	Если НЕ ПустаяСтрока(СтрокаДаты) Тогда
		Попытка
			СтрокаДаты = СокрЛП(СтрЗаменить(СтрокаДаты,",","."));
			Если ФорматДатыСрокаГодности = "дд.мм.гггг" Тогда
				Если СтрДлина(СтрокаДаты) = 10 Тогда
					Возврат Дата(СтрокаДаты+" 00:00:00");
				Иначе
					Возврат Дата(СтрокаДаты);  
				КонецЕсли;
			ИначеЕсли ФорматДатыСрокаГодности = "ддммгггг" Тогда
				Возврат Дата(Прав(СтрокаДаты,4)+Сред(СтрокаДаты,3,2)+Лев(СтрокаДаты,2)+"000000");
			ИначеЕсли ФорматДатыСрокаГодности = "дд.мм.гг" Тогда
				Возврат Дата("20"+Прав(СтрокаДаты,2)+Сред(СтрокаДаты,4,2)+Лев(СтрокаДаты,2)+"000000")
			ИначеЕсли ФорматДатыСрокаГодности = "ггггммдд" Тогда
				Возврат Дата(СтрокаДаты+"000000");
			ИначеЕсли ФорматДатыСрокаГодности = "гггг.мм.дд" Тогда
				Возврат Дата(Лев(СтрокаДаты,4)+Сред(СтрокаДаты,6,2)+Прав(СтрокаДаты,2)+"000000");
			ИначеЕсли ФорматДатыСрокаГодности = "мм.гггг" Тогда
				Возврат Дата(Прав(СтрокаДаты,4)+Лев(СтрокаДаты,2)+"01"+"000000"); 
			ИначеЕсли ФорматДатыСрокаГодности = "ммгггг" Тогда
				Возврат Дата(Прав(СтрокаДаты,4)+Лев(СтрокаДаты,2)+"01"+"000000"); 
			ИначеЕсли ФорматДатыСрокаГодности = "гггг.мм" Тогда
				Возврат Дата(Лев(СтрокаДаты,4)+Прав(СтрокаДаты,2)+"01"+"000000"); 
			ИначеЕсли ФорматДатыСрокаГодности = "ггггмм" Тогда
				Возврат Дата(СтрокаДаты+"01"+"000000");
			ИначеЕсли ФорматДатыСрокаГодности = "мм.гг" Тогда
				Возврат Дата("01."+Лев(СтрокаДаты,2)+".20"+Прав(СтрокаДаты,2)+" 00:00:00");
			Иначе
				Возврат Дата(СтрокаДаты);
			КонецЕсли;
		Исключение
			Возврат ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПривестиКДате(СтрокаДаты, Новый ОписаниеТипов("Дата"));
		КонецПопытки;
		
	КонецЕсли;
	
КонецФункции

// Процедура проверки новых просроченных серии
//
Процедура ПроверитьНовыеПросроченныеСерии(ОбъектИсточника, СтруктураПараметров, СтруктураПараметровЛогирования = Неопределено) Экспорт
	Если (СтруктураПараметров.ЕстьНовыеПросроченныеСерии ИЛИ СтруктураПараметров.ПодобранаПросроченнаяСерия) и (СтруктураПараметров.РежимЗагрузки = 1 ИЛИ (СтруктураПараметров.РежимЗагрузки = 3 И ПустаяСтрока(СтруктураПараметров.ИмяСправочника) И ПустаяСтрока(СтруктураПараметров.ИмяВидаРегистра))) Тогда
		Если СтруктураПараметров.ПроверятьСрокиГодности Тогда
			СтруктураПараметров.ОписаниеОшибок = СтруктураПараметров.ОписаниеОшибок + "В процессе загрузки документа в загружаемом файле обнаружены просроченные серии. Табличная часть документа очищена." + Символы.ПС;
			Если СтруктураПараметров.РежимЗагрузки = 3 Тогда
				СтруктураПараметров.ТЧДокумента.Очистить();
			Иначе
				ОбъектИсточника[СтруктураПараметров.ТабличнаяЧастьИсточника].Очистить();
			КонецЕсли;
		Иначе
			СтруктураПараметров.ОписаниеОшибок = СтруктураПараметров.ОписаниеОшибок + "В процессе загрузки документа в загружаемом файле обнаружены просроченные серии." + Символы.ПС;
		КонецЕсли;
		
		Если СтруктураПараметровЛогирования = Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПараметров.ОписаниеОшибок);
		Иначе
			ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(СтруктураПараметров.ОписаниеОшибок, 1, СтруктураПараметровЛогирования);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура добавляет в описание ошибок строку о загрузке справочника
//
Процедура ДобавитьВОписаниеОшибокСтрокуОЗагрузкеСправочника(СтруктураПараметров, ТекстВопросаИсточника, Загружено, КоличествоЭлементов, Сообщать = Истина, СтруктураПараметровЛогирования = Неопределено) Экспорт
	Если НЕ ((СтруктураПараметров.ЕстьНовыеПросроченныеСерии ИЛИ СтруктураПараметров.ПодобранаПросроченнаяСерия)И СтруктураПараметров.ПроверятьСрокиГодности) Тогда
		СтруктураПараметров.ОписаниеОшибок = СтруктураПараметров.ОписаниеОшибок + "Выполняется загрузка"+ 	ТекстВопросаИсточника + Символы.ПС;
		СтруктураПараметров.ОписаниеОшибок = СтруктураПараметров.ОписаниеОшибок + "" +Загружено +" из "+ КоличествоЭлементов + " элементов." + Символы.ПС;
		Если Сообщать Тогда
			Если СтруктураПараметровЛогирования = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПараметров.ОписаниеОшибок);
			Иначе
				ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(СтруктураПараметров.ОписаниеОшибок, 3, СтруктураПараметровЛогирования);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция получения параметров по версии обработки для справочника настроек
//
Функция ПолучитьПараметрыПоВерсииОбработкиДляСправочникаНастроек(ВерсияОбработки, Настройки) Экспорт
	
	ВозвращаемыеПараметры = Новый Структура;
	// Строка с которой начинается таблица реквизитов
	ВозвращаемыеПараметры.Вставить("НаименованиеТовара", 	Настройки.Область("R32C5").Текст);
	ВозвращаемыеПараметры.Вставить("Цена", 					Настройки.Область("R38C5").Текст);
	ВозвращаемыеПараметры.Вставить("СтранаПроисхождения",	Настройки.Область("R53C5").Текст);
	ВозвращаемыеПараметры.Вставить("Табуляция", Настройки.Область("R16C5").Текст);
	
	ТекущаяСтрока = 89;
	ТекущаяСтрокаШапка = 100;
	
	ВозвращаемыеПараметры.Вставить("ТекущаяСтрока", 								ТекущаяСтрока);
	ВозвращаемыеПараметры.Вставить("ТекущаяСтрокаШапка", 							ТекущаяСтрокаШапка);
	ВозвращаемыеПараметры.Вставить("НеСоздаватьНовыхЭлементов", 					НЕ ПустаяСтрока(Настройки.Область("R4C5").Текст));
	ВозвращаемыеПараметры.Вставить("ЗапретОбновленияСуществующихЭлементов",			НЕ ПустаяСтрока(Настройки.Область("R5C5").Текст));
	ВозвращаемыеПараметры.Вставить("флПоискПоПрайсуПоставщика",						НЕ ПустаяСтрока(Настройки.Область("R15C5").Текст));
	ВозвращаемыеПараметры.Вставить("РучнаяНумерацияКолонокТабличногоДокумента",		НЕ ПустаяСтрока(Настройки.Область("R7C5").Текст));
	ВозвращаемыеПараметры.Вставить("РучнаяНумерацияКолонокТабличногоДокументаДляШапки", НЕ ПустаяСтрока(Настройки.Область("R22C5").Текст));
	ВозвращаемыеПараметры.Вставить("ИспользоватьВнешнийМодульПреобразованияФайла", НЕ ПустаяСтрока(Настройки.Область("R17C5").Текст));
	ВозвращаемыеПараметры.Вставить("ИдентификаторОбработкиЗагрузкиИзXML",          Настройки.Область("R18C5").Текст);
	
	ВозвращаемыеПараметры.Вставить("ПерваяСтрокаДанныхТабличногоДокумента", ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера. ПривестиКЧислу(Настройки.Область("R8C5").Текст));
	ВозвращаемыеПараметры.Вставить("ПерваяСтрокаДанныхШапки",               ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПривестиКЧислу(Настройки.Область("R23C5").Текст));
	ВозвращаемыеПараметры.Вставить("ДействиеСЗагружаемымФайлом",            Настройки.Область("R9C5").Текст);
	ВозвращаемыеПараметры.Вставить("КаталогАрхиваЗагруженныхФайлов",        Настройки.Область("R10C5").Текст);
	ВозвращаемыеПараметры.Вставить("Производитель",                         Настройки.Область("R11C5").Текст);
	ВозвращаемыеПараметры.Вставить("ШтрихКод",                              Настройки.Область("R12C5").Текст);
	
	ВозвращаемыеПараметры.Вставить("ШКЯвляетсяПолемПоискаНоменклатуры", НЕ ПустаяСтрока(Настройки.Область("R26C5").Текст));
	ВозвращаемыеПараметры.Вставить("СоздаватьОбщиеХарактеристики",      НЕ ПустаяСтрока(Настройки.Область("R30C5").Текст));
	
	// ++ Отраслевые аптечные флаги.
	ВозвращаемыеПараметры.Вставить("ФорматДатыСрокаГодности",      Настройки.Область("R45C5").Текст);
	ВозвращаемыеПараметры.Вставить("ВсегдаФормироватьНовыеСерии",  НЕ ПустаяСтрока(Настройки.Область("R41C5").Текст));
	ВозвращаемыеПараметры.Вставить("СоздаватьСтрануПроисхождения", НЕ ПустаяСтрока(Настройки.Область("R52C5").Текст));
	ВозвращаемыеПараметры.Вставить("СоздаватьПроизводителя",       НЕ ПустаяСтрока(Настройки.Область("R49C5").Текст));
	ВозвращаемыеПараметры.Вставить("НеФормироватьДопНомерСерии",   НЕ ПустаяСтрока(Настройки.Область("R59C5").Текст));
	ВозвращаемыеПараметры.Вставить("ЗагружатьШК",                  НЕ ПустаяСтрока(Настройки.Область("R60C5").Текст));
	ВозвращаемыеПараметры.Вставить("НомерСерииПроизводителя",      Настройки.Область("R42C5").Текст);
	ВозвращаемыеПараметры.Вставить("СрокГодности",                 Настройки.Область("R46C5").Текст);
	ВозвращаемыеПараметры.Вставить("Сертификат",                   Настройки.Область("R56C5").Текст);
	
	ВозвращаемыеПараметры.Вставить("СрокДействияСертификата",   Настройки.Область("R61C5").Текст);
	ВозвращаемыеПараметры.Вставить("ОрганВыдавшийСертификат",   Настройки.Область("R64C5").Текст);
	ВозвращаемыеПараметры.Вставить("ДекларациюЗарегистрировал", Настройки.Область("R67C5").Текст);
	ВозвращаемыеПараметры.Вставить("Декларант",                 Настройки.Область("R70C5").Текст);
	
	ВозвращаемыеПараметры.Вставить("МаркируемыйТовар",      Настройки.Область("R73C5").Текст);
	ВозвращаемыеПараметры.Вставить("GTIN",                  Настройки.Область("R76C5").Текст);
	ВозвращаемыеПараметры.Вставить("ЗагружатьGTINДляСерии", НЕ ПустаяСтрока(Настройки.Область("R79C5").Текст));
	// -- Отраслевые аптечные флаги.
	
	ВозвращаемыеПараметры.Вставить("Кодировка",  Настройки.Область("R13C5").Текст);
	ВозвращаемыеПараметры.Вставить("ИмяТаблицы", Настройки.Область("R14C5").Текст);
	ВозвращаемыеПараметры.Вставить("КоличествоНеОбрабатываемыхСтрок", ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПривестиКЧислу(Настройки.Область("R29C5").Текст));
	
	ВозвращаемыеПараметры.Вставить("ЗагружатьДополнительныеРеквизитыИСведения", НЕ ПустаяСтрока(Настройки.Область("R19C5").Текст));
	ВозвращаемыеПараметры.Вставить("ДополнительныеРеквизитыИСведенияТолькоОбщие", НЕ ПустаяСтрока(Настройки.Область("R20C5").Текст));
	ВозвращаемаяКатегорияНоменклатуры = Настройки.Область("R21C5").Текст;
	Если Не ПустаяСтрока(ВозвращаемаяКатегорияНоменклатуры) Тогда
		Попытка
			КатегорияНоменклатурыЗначение = ЗначениеИзСтрокиВнутр(ВозвращаемаяКатегорияНоменклатуры);
		Исключение
			КатегорияНоменклатурыЗначение = Неопределено;
		КонецПопытки;
	Иначе
		КатегорияНоменклатурыЗначение = Неопределено;
	КонецЕсли;
	ВозвращаемыеПараметры.Вставить("ДополнительныеРеквизитыПоКатегорииНоменклатурыИзНастроек", КатегорияНоменклатурыЗначение);
	Возврат ВозвращаемыеПараметры;
	
КонецФункции

// Функция получения параметров по версии обработки
//
Функция ПолучитьПараметрыПоВерсииОбработки(ВерсияОбработки, Настройки) Экспорт
	
	ВозвращаемыеПараметры = Новый Структура;
	ТекущаяСтрока = 89;
	ТекущаяСтрокаШапка = 100;
	
	ВозвращаемыеПараметры.Вставить("ТекущаяСтрока",                             ТекущаяСтрока);
	ВозвращаемыеПараметры.Вставить("ТекущаяСтрокаШапка",                        ТекущаяСтрокаШапка);
	ВозвращаемыеПараметры.Вставить("НеСоздаватьНовыхЭлементов",                 НЕ ПустаяСтрока(Настройки.Область("R4C5").Текст));
	ВозвращаемыеПараметры.Вставить("НеОбновлятьСуществующиеЭлементы",           НЕ ПустаяСтрока(Настройки.Область("R5C5").Текст));
	ВозвращаемыеПараметры.Вставить("ЗамещатьСуществующиеЗаписи",                НЕ ПустаяСтрока(Настройки.Область("R6C5").Текст));
	ВозвращаемыеПараметры.Вставить("РучнаяНумерацияКолонокТабличногоДокумента", НЕ ПустаяСтрока(Настройки.Область("R7C5").Текст));
	ВозвращаемыеПараметры.Вставить("ПерваяСтрокаДанныхТабличногоДокумента",     ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПривестиКЧислу(Настройки.Область("R8C5").Текст));
	ВозвращаемыеПараметры.Вставить("РучнаяНумерацияКолонокТабличногоДокументаДляШапки", НЕ ПустаяСтрока(Настройки.Область("R22C5").Текст));
	ВозвращаемыеПараметры.Вставить("ПерваяСтрокаДанныхШапки",                           ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПривестиКЧислу(Настройки.Область("R23C5").Текст));
	
	ВозвращаемыеПараметры.Вставить("ШКЯвляетсяПолемПоискаНоменклатуры", НЕ ПустаяСтрока(Настройки.Область("R26C5").Текст));
	ВозвращаемыеПараметры.Вставить("СоздаватьОбщиеХарактеристики",      НЕ ПустаяСтрока(Настройки.Область("R30C5").Текст));
	
	ВозвращаемыеПараметры.Вставить("флПоискПоПрайсуПоставщика",      НЕ ПустаяСтрока(Настройки.Область("R15C5").Текст));
	ВозвращаемыеПараметры.Вставить("ДействиеСЗагружаемымФайлом",     Настройки.Область("R9C5").Текст);
	ВозвращаемыеПараметры.Вставить("КаталогАрхиваЗагруженныхФайлов", Настройки.Область("R10C5").Текст);
	ВозвращаемыеПараметры.Вставить("Табуляция",                      Настройки.Область("R16C5").Текст);
	
	ВозвращаемыеПараметры.Вставить("ФорматДатыСрокаГодности",      Настройки.Область("R45C5").Текст);
	ВозвращаемыеПараметры.Вставить("ВсегдаФормироватьНовыеСерии",  НЕ ПустаяСтрока(Настройки.Область("R41C5").Текст));
	ВозвращаемыеПараметры.Вставить("СоздаватьСтрануПроисхождения", НЕ ПустаяСтрока(Настройки.Область("R52C5").Текст));
	ВозвращаемыеПараметры.Вставить("НеФормироватьДопНомерСерии",   НЕ ПустаяСтрока(Настройки.Область("R59C5").Текст));
	ВозвращаемыеПараметры.Вставить("ЗагружатьШК",                  НЕ ПустаяСтрока(Настройки.Область("R60C5").Текст));
	ВозвращаемыеПараметры.Вставить("СоздаватьПроизводителя",       НЕ ПустаяСтрока(Настройки.Область("R49C5").Текст));
	ВозвращаемыеПараметры.Вставить("ЗагружатьGTINДляСерии",        НЕ ПустаяСтрока(Настройки.Область("R79C5").Текст));
	
	ВозвращаемыеПараметры.Вставить("Кодировка", Настройки.Область("R13C5").Текст);
	ВозвращаемыеПараметры.Вставить("ИмяТаблицы", Настройки.Область("R14C5").Текст);
	
	ИспользоватьВнешнийМодульПреобразованияФайла = Ложь;
	ОбработкаПреобразования = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	ИспользоватьВнешнийМодульПреобразованияФайла = НЕ ПустаяСтрока(Настройки.Область("R17C5").Текст);
	ИдентификаторОбработкиЗагрузки = Настройки.Область("R18C5").Текст; 
	Попытка
		ОбработкаПреобразования = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторОбработкиЗагрузки));
	Исключение
	КонецПопытки;
	
	ВозвращаемыеПараметры.Вставить("КоличествоНеОбрабатываемыхСтрок", ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПривестиКЧислу(Настройки.Область("R29C5").Текст));
	
	ВозвращаемыеПараметры.Вставить("ИспользоватьВнешнийМодульПреобразованияФайла", ИспользоватьВнешнийМодульПреобразованияФайла);
	ВозвращаемыеПараметры.Вставить("ОбработкаПреобразования", ОбработкаПреобразования);
	
	ВозвращаемыеПараметры.Вставить("ЗагружатьДополнительныеРеквизитыИСведения", НЕ ПустаяСтрока(Настройки.Область("R19C5").Текст));
	ВозвращаемыеПараметры.Вставить("ДополнительныеРеквизитыИСведенияТолькоОбщие", НЕ ПустаяСтрока(Настройки.Область("R20C5").Текст));
	ВозвращаемаяКатегорияНоменклатуры = Настройки.Область("R21C5").Текст;
	Если Не ПустаяСтрока(ВозвращаемаяКатегорияНоменклатуры) Тогда
		Попытка
			КатегорияНоменклатурыЗначение = ЗначениеИзСтрокиВнутр(ВозвращаемаяКатегорияНоменклатуры);
		Исключение
			КатегорияНоменклатурыЗначение = Неопределено;
		КонецПопытки;
	Иначе
		КатегорияНоменклатурыЗначение = Неопределено;
	КонецЕсли;
	ВозвращаемыеПараметры.Вставить("ДополнительныеРеквизитыПоКатегорииНоменклатурыИзНастроек", КатегорияНоменклатурыЗначение);
	
	Возврат ВозвращаемыеПараметры;

КонецФункции

// Процедура дополняет структуру параметров создания табличного документа отраслевыми свойствами при заполнении 
// табличного документа из настроек.
//
Процедура ДополнитьСтруктуруПараметровЗаполнитьТабличныйДокументИзНастроек(СтруктураПараметров, ЭтаФорма) Экспорт
	СтруктураПараметров.Вставить("ФорматДатыСрокаГодности", 		ЭтаФорма.ФорматДатыСрокаГодности);
	СтруктураПараметров.Вставить("ВсегдаФормироватьНовыеСерии",		ЭтаФорма.ВсегдаФормироватьНовыеСерии);
	СтруктураПараметров.Вставить("СоздаватьСтрануПроисхождения",    ЭтаФорма.СоздаватьСтрануПроисхождения);
	СтруктураПараметров.Вставить("НеФормироватьДопНомерСерии",      ЭтаФорма.НеФормироватьДопНомерСерии);
	СтруктураПараметров.Вставить("СоздаватьПроизводителя",          ЭтаФорма.СоздаватьПроизводителя);
	СтруктураПараметров.Вставить("ЗагружатьШК",                     ЭтаФорма.ЗагружатьШК);
	СтруктураПараметров.Вставить("ЗагружатьGTINДляСерии",           ЭтаФорма.ЗагружатьGTINДляСерии);
	СтруктураПараметров.Вставить("ТаблицаДополнительныхПараметров", ЭтаФорма.ТаблицаДополнительныхПараметров);
	СтруктураПараметров.Вставить("ШКЯвляетсяПолемПоискаНоменклатуры", ЭтаФорма.ШКЯвляетсяПолемПоискаНоменклатуры);
	СтруктураПараметров.Вставить("СоздаватьОбщиеХарактеристики", ЭтаФорма.СоздаватьОбщиеХарактеристики);
КонецПроцедуры

// Процедура дополняет структуру параметров создания табличного документа отраслевыми свойствами при заполнении 
// табличного документа из настроек в форме помощника.
//
Процедура ДополнитьСтруктуруПараметровЗаполнитьТабличныйДокументИзНастроекПомощника(СтруктураПараметров, Объект, ТаблицаДополнительныхПараметров) Экспорт
	
	СтруктураПараметров.Вставить("ТаблицаДополнительныхПараметров",   ТаблицаДополнительныхПараметров);
	СтруктураПараметров.Вставить("СоздаватьОбщиеХарактеристики",      Объект.СоздаватьОбщиеХарактеристики);
	
	СтруктураПараметров.Вставить("ФорматДатыСрокаГодности",      Объект.ФорматДатыСрокаГодности);
	СтруктураПараметров.Вставить("ВсегдаФормироватьНовыеСерии",  Объект.ВсегдаФормироватьНовыеСерии);
	СтруктураПараметров.Вставить("СоздаватьСтрануПроисхождения", Объект.СоздаватьСтрануПроисхождения);
	СтруктураПараметров.Вставить("НеФормироватьДопНомерСерии",   Объект.НеФормироватьДопНомерСерии);
	СтруктураПараметров.Вставить("СоздаватьПроизводителя",       Объект.СоздаватьПроизводителя);
	СтруктураПараметров.Вставить("ЗагружатьШК",                  Объект.ЗагружатьШК);
	СтруктураПараметров.Вставить("ЗагружатьGTINДляСерии",        Объект.ЗагружатьGTINДляСерии);
	
КонецПроцедуры

// Процедура устанавливает дополнительные параметры загрузки.
//
Процедура УстановитьДополнительныеПараметрыЗагрузки(Результат, Объект = Неопределено) Экспорт
	Если Объект<>Неопределено Тогда
		Объект.ВсегдаФормироватьНовыеСерии     = Результат.ВсегдаФормироватьНовыеСерии;
		Объект.СоздаватьПроизводителя          = Результат.СоздаватьПроизводителя;
		Объект.ФорматДатыСрокаГодности         = Результат.ФорматДатыСрокаГодности;
		Объект.НеФормироватьДопНомерСерии      = Результат.НеФормироватьДопНомерСерии;
		Объект.СоздаватьСтрануПроисхождения    = Результат.СоздаватьСтрануПроисхождения;
		Объект.ЗагружатьGTINДляСерии           = Результат.ЗагружатьGTINДляСерии;
	КонецЕсли;
КонецПроцедуры

// Процедура устанавливает формат даты срока годности серий по умолчанию.
//
Процедура УстановитьФорматДатыСрокаГодностиСерийПоУмолчанию(ЭтаФорма) Экспорт
	ЭтаФорма.ФорматДатыСрокаГодности = "дд.мм.гггг";
КонецПроцедуры

// Процедура устанавливает текущую группу справочника.
//
Процедура УстановитьТекущуюГруппуСправочника(Параметры, Список) Экспорт
	Если Параметры.ПараметрОтборПоВариантуИспользования = Перечисления.ор_ВариантыИспользованияНастройки.ВыгрузкаДанных Тогда
		Список.ТекущийРодитель = Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ГруппаНастроекВыгрузки;
		
	// ++ Отраслевое аптечное.
	ИначеЕсли Параметры.ПараметрОтборПоВариантуИспользования = Перечисления.ор_ВариантыИспользованияНастройки.ЗагрузкаДанных 
		И Параметры.Свойство("ПараметрОтборПоМетаданным") 
		И Параметры.ПараметрОтборПоМетаданным = "РегистрСведений.ор_РеестрЦенПроизводителейНаЖНВЛП" Тогда
		
		Список.ТекущийРодитель = Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ГруппаНастроекЗагрузкиРеестрЦенЖНВЛС;
	// -- Отраслевое аптечное.
	
	ИначеЕсли Параметры.ПараметрОтборПоВариантуИспользования = Перечисления.ор_ВариантыИспользованияНастройки.ЗагрузкаДанных Тогда
		Список.ТекущийРодитель = Справочники.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ГруппаНастроекЗагрузки;
	КонецЕсли;
КонецПроцедуры

// Процедура устанавливает надпись "ТекстВыражения".
//
Процедура УстановитьНадписьТекстВыражения(Параметры, НадписьТекстВыражения) Экспорт
	
	Если Параметры.Свойство("ОткрытьДляРедактированияДопРеквизитов") Тогда
		НадписьТекстВыражения =
		НСтр("ru = 'В тексте выражения можно использовать следующие предопределенные параметры:
		|   Результат      - результат вычисления (на входе пустая строка)
		|   ТекстыЯчеек    - массив текстов ячеек строки
		|   ТекстЯчейки    - текст текущей ячейки
		|   СсылкаИсточника - документ для загрузки данных
		|Встроенные функции, функции общих модулей.'");
	Иначе
		НадписьТекстВыражения =
		НСтр("ru = 'В тексте выражения можно использовать следующие предопределенные параметры:
		|   Результат      - результат вычисления (на входе - значение по умолчанию)
		|   ТекстЯчейки    - текст текущей ячейки
		|   ТекстыЯчеек    - массив текстов ячеек строки
		|   ТекущиеДанные  - структура загруженных значений
		|   флКонтрольЗаполнения - флаг запрета создания новых элементов
		|   ДокументОбъект - документ для загрузки данных
		|Встроенные функции, функции общих модулей.'");
	КонецЕсли;
	
КонецПроцедуры

// Заполняет настройки колонок по умолчанию для табличной части дополнительных параметров
//

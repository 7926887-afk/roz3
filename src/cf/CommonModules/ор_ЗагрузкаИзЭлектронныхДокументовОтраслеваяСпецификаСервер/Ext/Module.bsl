		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииМаркируемыйТоварРежимЗагрузки = НайденнаяСтрока.РежимЗагрузки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииМаркируемыйТоварВыражение     = НайденнаяСтрока.Выражение;
		
		НайденнаяСтрока = ТаблицаВременная.Найти("GTIN","ИмяРеквизита");
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииGTIN              = НайденнаяСтрока.НомерКолонки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииGTINРежимЗагрузки = НайденнаяСтрока.РежимЗагрузки;
		ОбластьШапки.Параметры.ТаблицаРеквизитовСерииGTINВыражение     = НайденнаяСтрока.Выражение;
		
	Исключение
	КонецПопытки;

КонецПроцедуры

// Процедура дополняет список выбора имен представлений
//
Процедура ДополнитьСписокВыбораИменПредставлений(Тип, СписокВыбора) Экспорт
	Если Тип = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		СписокВыбора.Добавить("СерияПроизводителяИСрокГодности", "Серия произв. и срок годн.");
	КонецЕсли;
	
КонецПроцедуры

// Функция вычисляет значение ячейки для режима "Вычислять"
//
// Параметры:
//  Выражение 		- Строка	- Программный код, который необходимо выполнить
//  ТекущиеДанные  	- Структура	- Структура загруженных значений
//  ТекстЯчейки    	- Строка	- Текст текущей ячейки
//  ТекстыЯчеек    	- Массив	- Массив текстов ячеек строки
//  Результат      	- Число		- Результат вычисления
//
// Возвращаемое значение:
//  Структура		- Структура, содержащая Результат и ОписаниеОшибки
//
Функция ВычислитьЗначениеДляХарактеристики(Знач Выражение, Знач ТекстЯчейки, Знач ТекстыЯчеек, Знач Результат, Знач СсылкаИсточника, СтруктураПараметровЛогирования = Неопределено) Экспорт 
	
	ТекстЯчейки = СокрЛП(ТекстЯчейки);
	ТекстСообщения = "";
	Попытка
		Выполнить(Выражение);
	Исключение
		ТекстСообщения = НСтр("ru = 'Ошибка при вычислении выражения %1: %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Выражение, ОписаниеОшибки());
		Если СтруктураПараметровЛогирования = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Иначе
			ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
		КонецЕсли;
	КонецПопытки;
	
	Возврат Новый Структура("Результат,ОписаниеОшибки",Результат,ТекстСообщения);
	
КонецФункции // ВычислитьЗначениеДляХарактеристики()

// Функция формирует новую характеристику(серию)
//
// Параметры:
//  ТекстыЯчеек    	   - Массив - Массив текстов ячеек строки
//  Серия	           – СправочникСсылка.ХарактеристикиНоменклатуры – характеристика.
//  ДопНомерСерии	   – Число	– Индекс серии.
//
// Возвращаемое значение:
//  Серия	   – СправочникСсылка.ХарактеристикиНоменклатуры – серия.
//
Функция СформироватьНовуюСерию(ТекстыЯчеек, СтруктураПараметров, Серия = Неопределено, ДопНомерСерии = 0, СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	ТаблицаДополнительныхПараметров = СтруктураПараметров.ТаблицаДополнительныхПараметров;
	ТаблицаЗагружаемыхРеквизитов = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов;
	ВладелецСерии = СтруктураПараметров.ВладелецСерии;
	ПроверятьСрокиГодности = СтруктураПараметров.ПроверятьСрокиГодности;
	НеФормироватьДопНомерСерии = СтруктураПараметров.НеФормироватьДопНомерСерии;
	
	Попытка
		СтрокаШтрихКод   = ТаблицаДополнительныхПараметров.Найти("ШтрихКод","ИмяРеквизита");
		НомерКолонкиШтрихКод = СтрокаШтрихКод.НомерКолонки;
	Исключение
		СтрокаШтрихКод = Неопределено;
		НомерКолонкиШтрихКод = 0;
	КонецПопытки;

	Попытка
		СтрокаGTIN   = ТаблицаДополнительныхПараметров.Найти("GTIN","ИмяРеквизита");
		НомерКолонкиGTIN = СтрокаGTIN.НомерКолонки;
	Исключение
		СтрокаGTIN = Неопределено;
		НомерКолонкиGTIN = 0;
	КонецПопытки;
	
	Если ТаблицаДополнительныхПараметров.Количество() > 0 Тогда
		
		СтрокаНастройкиЗагрузкиНоменклатуры =  ТаблицаЗагружаемыхРеквизитов.Найти("Номенклатура","ПредставлениеРеквизита"); 
		Если (СтрокаНастройкиЗагрузкиНоменклатуры = Неопределено) ИЛИ (СтрокаНастройкиЗагрузкиНоменклатуры.Пометка = Ложь) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		СтрокаНастройкиЗагрузкиСерии =  ТаблицаЗагружаемыхРеквизитов.Найти("Характеристика","ПредставлениеРеквизита"); 
		Если (СтрокаНастройкиЗагрузкиСерии = Неопределено) ИЛИ (СтрокаНастройкиЗагрузкиСерии.Пометка = Ложь)  Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВладелецСерии) Тогда 
			ТекстСообщения = НСтр("ru = 'Не указан владелец, не можем сформировать новую серию'");
			Если СтруктураПараметровЛогирования = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Иначе
				ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
			КонецЕсли;
			Возврат Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(ВладелецСерии)=Тип("СправочникСсылка.Номенклатура") Тогда
			Если Не ВладелецСерии.КатегорияНоменклатуры.ИспользоватьХарактеристики Тогда
				// Учет по характеристикам не ведется, но надо проверить ШК
				
				Если ЗначениеЗаполнено(НомерКолонкиШтрихКод) И ЗначениеЗаполнено(ТекстыЯчеек[НомерКолонкиШтрихКод])Тогда
					
					ШтрихКодСерииДляРегистрации = ТекстыЯчеек[НомерКолонкиШтрихКод];
					
				Иначе
					ШтрихКодСерииДляРегистрации = "";
				КонецЕсли;
				
				Если СтруктураПараметров.Свойство("НоменклатураДляЗаписиШК") Тогда
					ЗарегистрироватьШтрихКод(ШтрихКодСерииДляРегистрации,СтруктураПараметров.НоменклатураДляЗаписиШК,Неопределено,Неопределено, СтруктураПараметровЛогирования);
				КонецЕсли;	
				
				Возврат Неопределено;
				
			ИначеЕсли СтруктураПараметров.СоздаватьОбщиеХарактеристики Тогда
				// Серии подчинены виду номенклатуры
				ВладелецСерии = ВладелецСерии.КатегорияНоменклатуры;
				СтруктураПараметров.ВладелецСерии = ВладелецСерии;
			КонецЕсли;
		Иначе
			Если Не ВладелецСерии.ИспользоватьХарактеристики Тогда
				// Учет по характеристикам не ведется, но надо проверить ШК
				
				Если ЗначениеЗаполнено(НомерКолонкиШтрихКод) И ЗначениеЗаполнено(ТекстыЯчеек[НомерКолонкиШтрихКод])Тогда
					
					ШтрихКодСерииДляРегистрации = ТекстыЯчеек[НомерКолонкиШтрихКод];
					
				Иначе
					ШтрихКодСерииДляРегистрации = "";
				КонецЕсли;
				
				Если СтруктураПараметров.Свойство("НоменклатураДляЗаписиШК") Тогда
					ЗарегистрироватьШтрихКод(ШтрихКодСерииДляРегистрации,СтруктураПараметров.НоменклатураДляЗаписиШК,Неопределено,Неопределено, СтруктураПараметровЛогирования);
				КонецЕсли;	
				
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			СтрокаСерии = ТаблицаДополнительныхПараметров.Найти("Номер серии производителя","ИмяРеквизита");
			НомерКолонкиСерия = СтрокаСерии.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаСрокГодности   = ТаблицаДополнительныхПараметров.Найти("Срок годности","ИмяРеквизита");
			НомерКолонкиСрокГодности = СтрокаСрокГодности.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаПроизводитель   = ТаблицаДополнительныхПараметров.Найти("Производитель","ИмяРеквизита");
			НомерКолонкиПроизводитель = СтрокаПроизводитель.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаСтранаПроисхождения = ТаблицаДополнительныхПараметров.Найти("Страна происхождения","ИмяРеквизита");
			НомерКолонкиСтранаПроисхождения = СтрокаСтранаПроисхождения.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаСертификат   = ТаблицаДополнительныхПараметров.Найти("Сертификат","ИмяРеквизита");
			НомерКолонкиСертификат = СтрокаСертификат.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаНаименование   = ТаблицаДополнительныхПараметров.Найти("Наименование характеристики", "ИмяРеквизита");
			НомерКолонкиНаименование = СтрокаНаименование.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаОрганВыдавшийСертификат       = ТаблицаДополнительныхПараметров.Найти("Орган выдавший сертификат", "ИмяРеквизита");
			НомерКолонкиОрганВыдавшийСертификат = СтрокаОрганВыдавшийСертификат.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаСрокДействияСертификата       = ТаблицаДополнительныхПараметров.Найти("Срок действия сертификата", "ИмяРеквизита");
			НомерКолонкиСрокДействияСертификата = СтрокаСрокДействияСертификата.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаОрганЗарегистрировавшийДекларацию       = ТаблицаДополнительныхПараметров.Найти("Декларацию зарегистрировал", "ИмяРеквизита");
			НомерКолонкиОрганЗарегистрировавшийДекларацию = СтрокаОрганЗарегистрировавшийДекларацию.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаДекларант       = ТаблицаДополнительныхПараметров.Найти("Декларант", "ИмяРеквизита");
			НомерКолонкиДекларант = СтрокаДекларант.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Попытка
			СтрокаМаркируемыйТовар   = ТаблицаДополнительныхПараметров.Найти("Маркируемый товар","ИмяРеквизита");
			НомерКолонкиМаркируемыйТовар = СтрокаМаркируемыйТовар.НомерКолонки;
		Исключение
		КонецПопытки;
		
		Если СтрокаСерии.РежимЗагрузки = "Искать" Тогда
			Если НЕ ЗначениеЗаполнено(НомерКолонкиСерия) Тогда 

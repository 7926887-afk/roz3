// Процедура выполняет поиск в справочниках Номенклатура и Характеристики номенклатуры по штрихкоду.
//
Процедура ОтработатьПоискСправочникаПоШК(СтруктураПараметров,
										ТаблицаНоменклатурыИХарактеристик,
										НайденныеЗначения,
										ТЧДокумента,
										ТекстыЯчеек,
										ТипРеквизита, 
										флКонтрольЗаполнения,
										СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	ДопНомерСерии = 0;
	Для каждого СтрокаШК Из ТаблицаНоменклатурыИХарактеристик Цикл
		Если ТипРеквизита = Тип("СправочникСсылка.Номенклатура") Тогда
			Если НЕ ТипЗнч(СтрокаШК.Объект)=Тип("СправочникСсылка.Номенклатура") Тогда Продолжить; КонецЕсли;
			НайденныеЗначения.Добавить(СтрокаШК.Объект);
			Прервать;
		ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
			Если Не ТипЗнч(СтрокаШК.ХарактеристикаНоменклатуры) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
				Продолжить;
			КонецЕсли;
			
			ЦенаСерии = ПолучитьЦенуЗагружаемойСерии(ТекстыЯчеек, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
			Если Не СерияИспользуетсяВТЧДокумента(ТЧДокумента, СтрокаШК.ХарактеристикаНоменклатуры) Тогда
				НайденныеЗначения.Добавить(СтрокаШК.ХарактеристикаНоменклатуры);
				Если ЗначениеЗаполнено(СтрокаШК.ХарактеристикаНоменклатуры)
					И СтрокаШК.ХарактеристикаНоменклатуры.ор_СрокГодности < НачалоДня(ТекущаяДата()) Тогда
					СтруктураПараметров.ПодобранаПросроченнаяСерия = Истина;
				КонецЕсли;
				Прервать;
			Иначе
				Запрос=Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	ХарактеристикиНоменклатуры.Ссылка 
				|ИЗ
				|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
				|ГДЕ
				|	ХарактеристикиНоменклатуры.Владелец = &Владелец";
				Запрос.УстановитьПараметр("Владелец", СтрокаШК.ХарактеристикаНоменклатуры.Владелец);
				Выборка =  Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ДопНомерСерии = ПолучитьДопНомерСерии(Выборка.Ссылка,ДопНомерСерии);
				КонецЦикла; 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденныеЗначения.Количество() = 0
		И флКонтрольЗаполнения = Ложь
		И ТипРеквизита = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		НоваяСерия = СформироватьНовуюСерию(ТекстыЯчеек, СтруктураПараметров,, ДопНомерСерии + 1, СтруктураПараметровЛогирования);
		Если НоваяСерия <> Неопределено Тогда
			НайденныеЗначения.Добавить(НоваяСерия);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Получить индекс серии
//
// Параметры:
//  Серия          - Ссылка	- ссылка на серию
//  ДопНомерСерии  – Список	– номер серии
//
// Возвращаемое значение:
//  Число	- следующий номер серии
//
Функция ПолучитьДопНомерСерии(Серия,ДопНомерСерии) Экспорт
	
	Попытка
		НаименованиеСерии = Серия.Наименование;
		НачСимвол = Найти(НаименованиеСерии,"'");
		Если НачСимвол <> 0 Тогда 
			ДопНомерТекущейСерии = Число(Сред(НаименованиеСерии,НачСимвол+1,Найти(Сред(НаименованиеСерии,НачСимвол),"'")));
			Если ДопНомерТекущейСерии > ДопНомерСерии Тогда
				ДопНомерСерии = ДопНомерТекущейСерии;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат ДопНомерСерии;
	
КонецФункции

 // Проверка использования серии в табличной части документа
//
Функция СерияИспользуетсяВТЧДокумента(ТЧДокумента,СерияНоменклатуры) Экспорт
	
	Попытка
		НайденнаяСтрока = ТЧДокумента.Найти(СерияНоменклатуры,"Характеристика");
		Если НайденнаяСтрока <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Ложь;
	
КонецФункции

// Процедура обрабатывает все найденные значения.
//
Процедура ОбработатьВсеНайденныеЗначения(ТипРеквизита, 
										СтруктураПараметров, 
										ТекстыЯчеек, 
										Выборка, 
										НайденныеЗначения,
										ИскатьПо,
										Представление,
										НормаЗначений,
										Запрос,
										ТаблицаСлов,
										ПоискПоСхожести,
										ЭтоСправочник,
										ИскатьПоСерииИСрокуГодности = Ложь,
										СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	Если ТипРеквизита = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		ДопНомерСерии = 0;
		ЦенаСерии = ПолучитьЦенуЗагружаемойСерии(ТекстыЯчеек, СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов);
		
		// Найдем значение маркируемый товар.
		МаркируемыйТовар = Ложь;
		ЕстьКолонкаМаркируемыйТовар = Ложь;
		Попытка
			СтрокаМаркируемыйТовар = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Маркируемый товар","ИмяРеквизита");
			Если СтрокаМаркируемыйТовар <> Неопределено Тогда
				НомерКолонкиМаркируемыйТовар = СтрокаМаркируемыйТовар.НомерКолонки;
				ЕстьКолонкаМаркируемыйТовар = СтрокаМаркируемыйТовар.НомерКолонки <> 0;
				Если ЗначениеЗаполнено(НомерКолонкиМаркируемыйТовар) И СтрокаМаркируемыйТовар.РежимЗагрузки = "Искать" Тогда
					МаркируемыйТовар = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПривестиКЧислу(ТекстыЯчеек[НомерКолонкиМаркируемыйТовар], Новый ОписаниеТипов("Булево"));
				Иначе
					Вычисление = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ВычислитьЗначениеДляХарактеристики(
						СтрокаМаркируемыйТовар.Выражение,
						?(ЕстьКолонкаМаркируемыйТовар, "", ТекстыЯчеек[НомерКолонкиМаркируемыйТовар]),
						ТекстыЯчеек,
						Ложь,
						СтруктураПараметров.СсылкаИсточника,
						СтруктураПараметровЛогирования);
					Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
						МаркируемыйТовар = Вычисление.Результат;
					Иначе
						ТекстОшибки = НСтр("ru= 'При вычислении выражения: 
						| %1
						| Произошла ошибка: %2'");
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаМаркируемыйТовар.Выражение, Вычисление.ОписаниеОшибки);
						Если СтруктураПараметровЛогирования = Неопределено Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
						Иначе
							ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстОшибки, 1, СтруктураПараметровЛогирования);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		Если ИскатьПоСерииИСрокуГодности Тогда
			
			// Найдем представление серии производителя.
			Попытка
				СтрокаСерии = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Номер серии производителя","ИмяРеквизита");
				Если СтрокаСерии.РежимЗагрузки = "Вычислять" Тогда
					Вычисление = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ВычислитьЗначениеДляХарактеристики(
						СтрокаСерии.Выражение,
						?(СтрокаСерии.НомерКолонки = 0, "", ТекстыЯчеек[СтрокаСерии.НомерКолонки]),
						ТекстыЯчеек,
						"",
						СтруктураПараметров.СсылкаИсточника,
						СтруктураПараметровЛогирования);
					Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
						Представление = Вычисление.Результат;
					КонецЕсли;
				Иначе
					НомерКолонкиСерия = СтрокаСерии.НомерКолонки;
					Если ЗначениеЗаполнено(НомерКолонкиСерия) Тогда
						Представление = ТекстыЯчеек[НомерКолонкиСерия];
					КонецЕсли;
				КонецЕсли;
				Запрос.УстановитьПараметр("Представление", Представление);
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
			КонецПопытки;
			
			// Найдем представление срока годности.
			СрокГодностиСерии = Дата('00010101');
			Попытка
				НайденнаяСтрока = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Срок годности","ИмяРеквизита");
				Если НайденнаяСтрока <> Неопределено Тогда 
					НомерКолонкиСрокГодности = НайденнаяСтрока.НомерКолонки;
					Если ЗначениеЗаполнено(НомерКолонкиСрокГодности) И НайденнаяСтрока.РежимЗагрузки = "Искать" Тогда
						СрокГодностиСерии = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ПолучитьДатуСрокаГодностиСерии(ТекстыЯчеек[НомерКолонкиСрокГодности], СтруктураПараметров.ФорматДатыСрокаГодности);
					Иначе
						Вычисление = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ВычислитьЗначениеДляХарактеристики(
							НайденнаяСтрока.Выражение,
							?(НайденнаяСтрока.НомерКолонки = 0, "", ТекстыЯчеек[НайденнаяСтрока.НомерКолонки]),
							ТекстыЯчеек,
							Дата('00010101'),
							СтруктураПараметров.СсылкаИсточника,
							СтруктураПараметровЛогирования);
						Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
							СрокГодностиСерии = Вычисление.Результат;
						Иначе
							ТекстОшибки = НСтр("ru= 'При вычислении выражения: 
							| %1
							| Произошла ошибка: %2'");
							ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НайденнаяСтрока.Выражение, Вычисление.ОписаниеОшибки);
							Если СтруктураПараметровЛогирования = Неопределено Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
							Иначе
								ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстОшибки, 1, СтруктураПараметровЛогирования);
							КонецЕсли;
							СрокГодностиСерии = Дата('00010101');
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			Пометить = Истина;
			Пока Выборка.Следующий() Цикл 
				ДопНомерСерии = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ПолучитьДопНомерСерии(Выборка.Ссылка,ДопНомерСерии);
				Если (Не ЕстьКолонкаМаркируемыйТовар Или Выборка.Ссылка.ор_МаркируемыйТовар = МаркируемыйТовар)
					И Выборка.Ссылка.ор_СрокГодности = СрокГодностиСерии
					И НЕ СтруктураПараметров.ВсегдаФормироватьНовыеСерии
					И НЕ СерияИспользуетсяВТЧДокумента(СтруктураПараметров.ТЧДокумента,Выборка.Ссылка) Тогда
					// Если выбранная серия не используется, тогда необходимо изменить этот статус.
					Если Пометить И Выборка.Ссылка.Недействителен Тогда
						СерияОбъект = Выборка.Ссылка.ПолучитьОбъект();
						СерияОбъект.Недействителен = Ложь;
						Попытка
							СерияОбъект.Записать();
							ТекстСообщения = НСтр("ru= 'Серия %1 владельца %2 помечена как %3'");
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СерияОбъект.Наименование, СокрЛП(СерияОбъект.Владелец.Наименование), ?(СерияОбъект.Недействителен,"недействительная","используемая"));
							Если СтруктураПараметровЛогирования = Неопределено Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
							Иначе
								ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 3, СтруктураПараметровЛогирования);
							КонецЕсли;
						Исключение
							ТекстСообщения = НСтр("ru= 'Не удалось изменить статус ""Недействителен"" для серии <%1>'");
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Выборка.Ссылка);
							Если СтруктураПараметровЛогирования = Неопределено Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
							Иначе
								ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
							КонецЕсли;
						КонецПопытки;
					КонецЕсли;
					Пометить = Ложь;
					НайденныеЗначения.Добавить(Выборка.Ссылка);
					Если Выборка.Ссылка.ор_СрокГодности < НачалоДня(ТекущаяДата()) Тогда
						СтруктураПараметров.ПодобранаПросроченнаяСерия = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Пометить = Истина;
			// Проверим если производится поиск по "Наименование" и выборка по запросу пустая
			// то подменим параметр "Представление" на тот который задан в дополнительных параметрах
			// если он задан либо вычислив его либо просто взяв текст ячейки.
			Если Выборка.Количество() = 0 И ИскатьПо = "Наименование" Тогда
				Попытка
					НайденнаяСтрока   = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Наименование характеристики","ИмяРеквизита");
					Если НайденнаяСтрока <> Неопределено Тогда 
						НомерКолонкиНаименование = НайденнаяСтрока.НомерКолонки;
						Если ЗначениеЗаполнено(НомерКолонкиНаименование) И НайденнаяСтрока.РежимЗагрузки = "Искать" Тогда
							лНаименование = ТекстыЯчеек[НомерКолонкиНаименование];
						Иначе
							Вычисление = ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ВычислитьЗначениеДляХарактеристики(
								НайденнаяСтрока.Выражение,
								?(НайденнаяСтрока.НомерКолонки = 0, "", ТекстыЯчеек[НайденнаяСтрока.НомерКолонки]),
								ТекстыЯчеек,
								"",
								СтруктураПараметров.СсылкаИсточника,
								СтруктураПараметровЛогирования);
							Если ПустаяСтрока(Вычисление.ОписаниеОшибки) Тогда
								лНаименование = Вычисление.Результат;
							Иначе
								ТекстСообщения = НСтр("ru= 'При вычислении выражения: 
								|%1
								| Произошла ошибка: %2'");
								ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НайденнаяСтрока.Выражение,Вычисление.ОписаниеОшибки);
								Если СтруктураПараметровЛогирования = Неопределено Тогда
									ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
								Иначе
									ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
								КонецЕсли;
								лНаименование = "";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				Исключение
				КонецПопытки;
				Если ЗначениеЗаполнено(лНаименование) Тогда
					Запрос.УстановитьПараметр("Представление", лНаименование);
					Выборка = Запрос.Выполнить().Выбрать();
				КонецЕсли;
			КонецЕсли;
			
			Пока Выборка.Следующий() Цикл
				ДопНомерСерии = ПолучитьДопНомерСерии(Выборка.Ссылка,ДопНомерСерии);
				Если Выборка.Ссылка.ор_МаркируемыйТовар = МаркируемыйТовар
					И Не СтруктураПараметров.ВсегдаФормироватьНовыеСерии
					И Не СерияИспользуетсяВТЧДокумента(СтруктураПараметров.ТЧДокумента,Выборка.Ссылка) Тогда
					
					// Если выбранная серия не используется, тогда необходимо изменить этот статус.
					Если Пометить И Выборка.Ссылка.Недействителен Тогда
						СерияОбъект = Выборка.Ссылка.ПолучитьОбъект();
						СерияОбъект.Недействителен = Ложь;
						Попытка
							СерияОбъект.Записать();
							ТекстСообщения = НСтр("ru= 'Серия <%1> владельца <%2> помечена как %3'");
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СерияОбъект.Наименование,СокрЛП(СерияОбъект.Владелец.Наименование), ?(СерияОбъект.Недействителен,"недействительная","используемая"));
							Если СтруктураПараметровЛогирования = Неопределено Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
							Иначе
								ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 3, СтруктураПараметровЛогирования);
							КонецЕсли;
						Исключение
							ТекстСообщения = НСтр("ru= 'Не удалось изменить статус ""Недействителен"" для серии <%1>'");
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Выборка.Ссылка);
							Если СтруктураПараметровЛогирования = Неопределено Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
							Иначе
								ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстСообщения, 1, СтруктураПараметровЛогирования);
							КонецЕсли;
						КонецПопытки;
					КонецЕсли;
					Пометить = Ложь;
					НайденныеЗначения.Добавить(Выборка.Ссылка);
					Если Выборка.Ссылка.ор_СрокГодности < НачалоДня(ТекущаяДата()) Тогда
						СтруктураПараметров.ПодобранаПросроченнаяСерия = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Если НЕ ПоискПоСхожести Тогда
			Пока Выборка.Следующий() Цикл
				НайденныеЗначения.Добавить(Выборка.Ссылка);
			КонецЦикла;
		Иначе
			// Попробуем найти точное совпадение
			СтрокаНайденная = ТаблицаСлов.Найти(Представление, "ЗначениеРеквизита");
			Если СтрокаНайденная = Неопределено Тогда
				ТаблицаНайденных = Новый ТаблицаЗначений;
				ТаблицаНайденных.Колонки.Добавить("Значение");
				ТаблицаНайденных.Колонки.Добавить("СтепеньСоответствия");
				ИсходныйСписокСлов = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьСписокСлов(Представление);
				Сч = 1;
				Пока ТаблицаСлов.Количество() > 0 И Сч<=НормаЗначений Цикл
					КоличествоСтрок = ТаблицаСлов.Количество();
					СписокСтрок = Новый СписокЗначений;
					СтрокаСравнения = ТаблицаСлов[0];
					СписокСловСравнения = СтрокаСравнения.СписокСлов.Скопировать();
					ТекущийСписокСлов = ИсходныйСписокСлов.Скопировать();
					СтепеньСоответствия = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ВернутьСтепеньСоответствияСписковСлов(ТекущийСписокСлов, СписокСловСравнения);
					НовСтр = ТаблицаНайденных.Добавить();
					НовСтр.Значение = СтрокаСравнения.Ссылка;
					НовСтр.СтепеньСоответствия = СтепеньСоответствия;
					ТаблицаСлов.Удалить(СтрокаСравнения);
					Сч = Сч+1;
				КонецЦикла;
				ТаблицаНайденных.Сортировать("СтепеньСоответствия Убыв");
				Если ТаблицаНайденных.Количество() > 1 Тогда
					ТекстСообщения = "Для значения <"+Представление+"> найдено несколько вариантов:"+Символы.ПС;
					Для Каждого Зн из ТаблицаНайденных Цикл
						ТекстСообщения = ТекстСообщения+Символы.Таб+Зн.Значение+Символы.ПС;
					КонецЦикла;
					ТекстОшибки = НСтр("ru= '%1'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекстСообщения);
					Если СтруктураПараметровЛогирования = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
					Иначе
						ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ДобавитьВЛог(ТекстОшибки, 2, СтруктураПараметровЛогирования);
					КонецЕсли;
				КонецЕсли;
				НайденныеЗначения = ТаблицаНайденных.ВыгрузитьКолонку("Значение");
			Иначе
				НайденныеЗначения.Добавить(СтрокаНайденная.Ссылка);
				Если ТипЗнч(СтрокаНайденная.Ссылка) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры")
					И СтрокаНайденная.Ссылка.ор_СрокГодности < НачалоДня(ТекущаяДата()) Тогда
					СтруктураПараметров.ПодобранаПросроченнаяСерия = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НайденныеЗначения.Количество() = 0
		И ЭтоСправочник
		И СтруктураПараметров.флКонтрольЗаполнения=Ложь
		И ТипРеквизита = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		НоваяСерия = СформироватьНовуюСерию(ТекстыЯчеек, СтруктураПараметров,, ДопНомерСерии + 1, СтруктураПараметровЛогирования);
		Если НоваяСерия <> Неопределено Тогда
			НайденныеЗначения.Добавить(НоваяСерия);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция получения данных производителя из дополнительных параметров
//
Функция ПолучитьДанныеПроизводителяИзДопПараметров(СтруктураПараметров) Экспорт
	
	// Для книжек ничего менять даже не надо, стоит проверка на наличие доп. параметров
	СтруктураВозврата = Новый Структура();
	
	Если СтруктураПараметров.Свойство("ТаблицаДополнительныхПараметров") и СтруктураПараметров.ТаблицаДополнительныхПараметров<>Неопределено Тогда
		КолонкаПроизводителя = 0;
		СтрокаПроизводитель = СтруктураПараметров.ТаблицаДополнительныхПараметров.Найти("Производитель");
		Если НЕ СтрокаПроизводитель = Неопределено Тогда
			Если ЗначениеЗаполнено(СтрокаПроизводитель.НомерКолонки) Тогда
				КолонкаПроизводителя = СтрокаПроизводитель.НомерКолонки;
			КонецЕсли;
		КонецЕсли;
		СтруктураВозврата.Вставить("СтрокаПроизводитель",  СтрокаПроизводитель);
		СтруктураВозврата.Вставить("КолонкаПроизводителя", КолонкаПроизводителя);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Функция получения значения по производителю
//
Функция ПолучитьЗначенияПоПроизводителю(ТабличныйДокумент, 
											ТекстыЯчеек, 
											Примечание, 
											Представление,
											НайденнаяСтрока,
											НомерСтроки,
											СтруктураПараметровПроизводителя,
											СтруктураПараметров,
											СтруктураПараметровЛогирования = Неопределено) Экспорт
	
	// Для книжек ничего менять не нужно, отработает первая ветка если.
	Если СтруктураПараметровПроизводителя.Количество() = 0 Тогда
		НайденныеЗначения = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьВозможныеЗначения(НайденнаяСтрока, Представление, Примечание, НайденнаяСтрока, ТекстыЯчеек, СтруктураПараметров, 1, Неопределено,,СтруктураПараметровЛогирования);
	Иначе
		Дополнительно = Новый Структура;
		Если СтруктураПараметровПроизводителя.Свойство("КолонкаПроизводителя") И СтруктураПараметровПроизводителя.Свойство("СтрокаПроизводитель") Тогда
			Если НЕ СтруктураПараметровПроизводителя.КолонкаПроизводителя = 0 И СтруктураПараметровПроизводителя.СтрокаПроизводитель.РежимЗагрузки = "Искать" Тогда
				Производитель = ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(СтруктураПараметровПроизводителя.КолонкаПроизводителя,"ЧГ=")).Текст;
				Если НЕ ПустаяСтрока(Производитель) Тогда
					Дополнительно.Вставить("Производитель",Производитель);
				КонецЕсли;
			ИначеЕсли СтруктураПараметровПроизводителя.СтрокаПроизводитель <> Неопределено
				И СтруктураПараметровПроизводителя.СтрокаПроизводитель.РежимЗагрузки = "Вычислять" Тогда
				Попытка
					Вычисление = ВычислитьЗначениеДляХарактеристики(
						СтруктураПараметровПроизводителя.СтрокаПроизводитель.Выражение,
						?(СтруктураПараметровПроизводителя.СтрокаПроизводитель.НомерКолонки = 0, "", ТекстыЯчеек[СтруктураПараметровПроизводителя.СтрокаПроизводитель.НомерКолонки]),
						ТекстыЯчеек,
						Справочники.ор_Производители.ПустаяСсылка(),
						СтруктураПараметров.СсылкаИсточника,
						СтруктураПараметровЛогирования);
					// Здесь для поиска нам необходимо будет строковое значение.
					Дополнительно.Вставить("Производитель",Строка(Вычисление.Результат));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		НайденныеЗначения = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьВозможныеЗначения(НайденнаяСтрока, Представление, Примечание, НайденнаяСтрока, ТекстыЯчеек, СтруктураПараметров, 1, Дополнительно,, СтруктураПараметровЛогирования);
	КонецЕсли;
	
	Возврат НайденныеЗначения;
	
КонецФункции

// Процедура выполняет запись отраслевых параметров в прайс-лист
//
Процедура ЗаписатьОтраслевыеПараметрыВПрайс(НоваяПозицияПрайсЛиста, ЗначениеДляПоиска, СтрокаИсточника = Неопределено) Экспорт
	// Для книжек оставить пустую процедуру
	
	Если СтрокаИсточника = Неопределено Тогда
		НоваяПозицияПрайсЛиста.ШтрихКод = ЗначениеДляПоиска;
	Иначе
		НоваяПозицияПрайсЛиста.Штрихкод = СтрокаИсточника.ШтрихКод;
		НоваяПозицияПрайсЛиста.СтранаПроисхождения = СтрокаИсточника.СтранаПроисхождения;
		НоваяПозицияПрайсЛиста.Производитель       = СтрокаИсточника.Производитель;
		НоваяПозицияПрайсЛиста.ПроизводительЛС     = СтрокаИсточника.ПроизводительЛС;
	КонецЕсли;
	
КонецПроцедуры

////////////////////

// Процедура дополняет структуру параметров значениями таблицы дополнительных параметров.
//
Процедура ДополнитьВСтруктуруДопПараметры(СтруктураПараметров, ЭтаФорма, ЭтотОбъект, ТолькоКолонки = Ложь) Экспорт
	
	Если ТолькоКолонки Тогда
		СтруктураПараметров.Вставить("ТаблицаДополнительныхПараметров", ЭтаФорма.ТаблицаДополнительныхПараметров.Выгрузить().СкопироватьКолонки());
	Иначе
		СтруктураПараметров.Вставить("ТаблицаДополнительныхПараметров", ЭтаФорма.ТаблицаДополнительныхПараметров.Выгрузить());
	КонецЕсли;
	СтруктураПараметров.Вставить("ШКЯвляетсяПолемПоискаНоменклатуры", ЭтотОбъект.ШКЯвляетсяПолемПоискаНоменклатуры);
	СтруктураПараметров.Вставить("СоздаватьОбщиеХарактеристики",      ЭтотОбъект.СоздаватьОбщиеХарактеристики);
	СтруктураПараметров.Вставить("НеФормироватьДопНомерСерии",        ЭтотОбъект.НеФормироватьДопНомерСерии);
	СтруктураПараметров.Вставить("ЗагружатьШК",                       ЭтотОбъект.ЗагружатьШК);
	
КонецПроцедуры

// Процедура дополняет структуру параметров значениями таблицы дополнительных параметров, 
// необходимых для автоматической загрузки.
//
Процедура ДополнитьВСтруктуруДопПараметрыАвтозагрузка(СтруктураПараметров, СтруктураТаблиц) Экспорт
	
	СтруктураПараметров.Вставить("ТаблицаДополнительныхПараметров",   СтруктураТаблиц.ТаблицаДополнительныхПараметров);
	СтруктураПараметров.Вставить("ШКЯвляетсяПолемПоискаНоменклатуры", Ложь);
	СтруктураПараметров.Вставить("СоздаватьОбщиеХарактеристики",      Ложь);

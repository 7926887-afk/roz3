#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановнитьВидимостьРеквизитовПравила()
	
	Если Объект.ВидНаименования <> ПредопределенноеЗначение("Перечисление.ВидыНаименованийОбъектов.НоменклатураРабочее")
		И Объект.ВидНаименования <> ПредопределенноеЗначение("Перечисление.ВидыНаименованийОбъектов.ХарактеристикаРабочее") Тогда
		Объект.ор_ТоварВнеБазы = Ложь;
		Элементы.ор_ТоварВнеБазы.Видимость = Ложь;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ИдентификаторПолный", "ор_НаименованиеПоставщика");
	НайденныеСтроки = Реквизиты.НайтиСтроки(СтруктураОтбора);
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		НайденныйЭлемент = Элементы.Найти("КомандаВставитьПараметр" + Реквизиты.Индекс(НайденныеСтроки[0]));
		Если НайденныйЭлемент <> Неопределено Тогда
			НайденныйЭлемент.Доступность = Объект.ор_ТоварВнеБазы;
		КонецЕсли;
	КонецЕсли;
	
	Если Не Объект.ор_ТоварВнеБазы Тогда
		ИмяПараметра = "[ор_НаименованиеПоставщика]";
		УдалитьПараметрИзШаблона(Объект.ШаблонДляПредставления, ИмяПараметра);
		УдалитьПараметрИзШаблона(Объект.ШаблонДляФормирования, ИмяПараметра);
	КонецЕсли;
	
	Элементы.СтраницыРеквизитов.Видимость = Объект.ор_ТоварВнеБазы;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПараметрИзШаблона(РедактируемыйШаблон, ИмяПараметра)
	
	НомерПозиции = СтрНайти(РедактируемыйШаблон, ИмяПараметра);
	Если НомерПозиции = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерПервогоСимвола = СтрНайти(РедактируемыйШаблон, "{", НаправлениеПоиска.СКонца, НомерПозиции);
	НомерПоследнегоСимвола = СтрНайти(РедактируемыйШаблон, "}", НаправлениеПоиска.СНачала, НомерПозиции);
	
	РедактируемыйШаблон = Лев(РедактируемыйШаблон, НомерПервогоСимвола - 1) + Сред(РедактируемыйШаблон, НомерПоследнегоСимвола + 1);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьДопТаблицыТоваровВнеБазы()
	
	Если Объект.ВидНаименования = Перечисления.ВидыНаименованийОбъектов.ДоговорКонтрагента Тогда
		Возврат;
	КонецЕсли;
	
	НачальныеПараметры = ШаблоныНаименований.СформироватьНачальныеПараметрыПоПравилу(Объект.ВидНаименования);
	
	СформироватьСписокИсключающихРеквизитов();
	
	ЭтотОбъект.ТаблицаРеквизитов.Загрузить(СформироватьТаблицуРеквизитов(НачальныеПараметры));
	
	СформироватьСписокРеквизитов(НачальныеПараметры);
	СформироватьТаблицуДопРеквизитов(НачальныеПараметры);
	
	Элементы.ДополнительныеРеквизитыПредставление.СписокВыбора.Очистить();
	Для Каждого ТекЭлемент Из ЭтотОбъект.СписокДопРеквизитов Цикл
		Элементы.ДополнительныеРеквизитыПредставление.СписокВыбора.Добавить(ТекЭлемент.Значение);
	КонецЦикла;
	
	Элементы.ДополнительныеРеквизитыПредставление.КнопкаВыпадающегоСписка = Истина;
	Элементы.РеквизитыДляЗаполненияПредставление.КнопкаВыпадающегоСписка  = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоУмолчаниюНаСервере(ТолькоОбязательные = Ложь)
	
	НачальныеПараметры = ШаблоныНаименований.СформироватьНачальныеПараметрыПоПравилу(Объект.ВидНаименования);
	
	Для Каждого Реквизит Из НачальныеПараметры.НаборРеквизитов Цикл
		Если НЕ ТолькоОбязательные
			ИЛИ Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда
			
			Если НЕ ШаблоныНаименований.ОтраслевойРеквизитИспользуется(Реквизит.Имя, Объект.ВидНаименования) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ШаблоныНаименований.РеквизитИспользуется(Реквизит.Имя, Ложь) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЭтотОбъект.ИсключающиеРеквизиты.НайтиПоЗначению(Реквизит.Синоним) = Неопределено Тогда
				НоваяСтрока = Объект.ор_РеквизитыДляЗаполнения.Добавить();
				НоваяСтрока.Реквизит      = Реквизит.Имя;
				НоваяСтрока.Представление = Реквизит.Синоним;
				ОписаниеТипа = Новый ОписаниеТипов(Реквизит.Тип);
				НоваяСтрока.Значение = ОписаниеТипа.ПривестиЗначение();
				Если ТипЗнч(НоваяСтрока.Значение) = Тип("Строка") Тогда
					НоваяСтрока.Значение = "";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыНаСервере(ТолькоОбязательные = Ложь)
	
	Для Каждого ТекРеквизит Из ЭтотОбъект.ТаблицаДопРеквизитов Цикл
		Если НЕ ТолькоОбязательные ИЛИ ТекРеквизит.Реквизит.ЗаполнятьОбязательно Тогда
			ОписаниеТипа = Новый ОписаниеТипов(ТекРеквизит.Реквизит.ТипЗначения);
			
			НоваяСтрока = Объект.ор_ДополнительныеРеквизиты.Добавить();
			НоваяСтрока.Реквизит      = ТекРеквизит.Реквизит;
			НоваяСтрока.Представление = ТекРеквизит.Реквизит;
			НоваяСтрока.Тип           = ТекРеквизит.Тип;
			НоваяСтрока.Значение      = ОписаниеТипа.ПривестиЗначение();
			Если ТипЗнч(НоваяСтрока.Значение) = Тип("Строка") Тогда
				НоваяСтрока.Значение = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьТаблицуДопРеквизитов(НачальныеПараметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НаборДополнительныхРеквизитов.Свойство.Заголовок КАК Заголовок,
	|	НаборДополнительныхРеквизитов.Свойство КАК Свойство,
	|	НаборДополнительныхРеквизитов.Свойство.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборДополнительныхРеквизитов
	|ГДЕ
	|	НаборДополнительныхРеквизитов.Ссылка = &НаборСвойств";
	Запрос.УстановитьПараметр("НаборСвойств", НаборСвойств);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ЭтотОбъект.ТаблицаДопРеквизитов.Добавить();
		НоваяСтрока.Синоним  = Выборка.Заголовок;
		НоваяСтрока.Реквизит = Выборка.Свойство;
		НоваяСтрока.Тип      = Выборка.ТипЗначения;
		ЭтотОбъект.СписокДопРеквизитов.Добавить(Выборка.Свойство);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСписокРеквизитов(НачальныеПараметры)
	
	Для Каждого Реквизит Из НачальныеПараметры.НаборРеквизитов Цикл
		
		Если НЕ ШаблоныНаименований.ОтраслевойРеквизитИспользуется(Реквизит.Имя, Объект.ВидНаименования) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ШаблоныНаименований.РеквизитИспользуется(Реквизит.Имя, Истина) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтотОбъект.ИсключающиеРеквизиты.НайтиПоЗначению(Реквизит.Синоним) = Неопределено Тогда
			ЭтотОбъект.СписокРеквизитовФормы.Добавить(Реквизит.Синоним);
		КонецЕсли;
	КонецЦикла;
	
Конецпроцедуры

&НаСервере
// Процедура формирует таблицу реквизитов
//
Функция СформироватьТаблицуРеквизитов(НачальныеПараметры)
	
	ТаблицаРеквизитовВременная = Новый ТаблицаЗначений;
	ТаблицаРеквизитовВременная.Колонки.Добавить("Синоним");
	ТаблицаРеквизитовВременная.Колонки.Добавить("Тип");
	ТаблицаРеквизитовВременная.Колонки.Добавить("Реквизит");
	
	Для Каждого Реквизит Из НачальныеПараметры.НаборРеквизитов Цикл
		
		Если НЕ ШаблоныНаименований.ОтраслевойРеквизитИспользуется(Реквизит.Имя, Объект.ВидНаименования) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ШаблоныНаименований.РеквизитИспользуется(Реквизит.Имя, Истина) Тогда
			Продолжить;
		КонецЕсли;
		
		// Добавляем только те реквизиты, которые не входят в исключения
		Если ЭтотОбъект.ИсключающиеРеквизиты.НайтиПоЗначению(Реквизит.Синоним) = Неопределено Тогда
			НоваяСтрока = ТаблицаРеквизитовВременная.Добавить();
			НоваяСтрока.Синоним  = Реквизит.Синоним;
			НоваяСтрока.Тип      = Реквизит.Тип;
			НоваяСтрока.Реквизит = Реквизит.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРеквизитовВременная;
	
КонецФункции

&НаКлиенте
// Возвращает строки реквизита
//
Функция ПолучитьПараметрыСтрокиРеквизита(ВыбранноеЗначение)
	
	СтруктураОтбора = Новый Структура("Синоним", ВыбранноеЗначение);
	СтрокиПоиска = ЭтотОбъект.ТаблицаРеквизитов.НайтиСтроки(СтруктураОтбора);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Тип", СтрокиПоиска[0].Тип);
	СтруктураПараметров.Вставить("Синоним", СтрокиПоиска[0].Синоним);
	СтруктураПараметров.Вставить("Реквизит", СтрокиПоиска[0].Реквизит);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаКлиенте
// Возвращает строки дополнительного реквизита
//
Функция ПолучитьПараметрыСтрокиДопРеквизита(ВыбранноеЗначение)
	
	СтруктураОтбора = Новый Структура("Реквизит", ВыбранноеЗначение);
	СтрокиПоиска = ЭтотОбъект.ТаблицаДопРеквизитов.НайтиСтроки(СтруктураОтбора);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Тип", СтрокиПоиска[0].Тип);
	СтруктураПараметров.Вставить("Синоним", СтрокиПоиска[0].Синоним);
	СтруктураПараметров.Вставить("Реквизит", СтрокиПоиска[0].Реквизит);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервере
Процедура СформироватьСписокИсключающихРеквизитов()
	
	ЭтотОбъект.ИсключающиеРеквизиты.Добавить("Тип");
	ЭтотОбъект.ИсключающиеРеквизиты.Добавить("Категория");
	ЭтотОбъект.ИсключающиеРеквизиты.Добавить("Файл картинки");
	ЭтотОбъект.ИсключающиеРеквизиты.Добавить("Наименование полное");
	ЭтотОбъект.ИсключающиеРеквизиты.Добавить("Наименование поставщика");
	ЭтотОбъект.ИсключающиеРеквизиты.Добавить("Вставка");
	
Конецпроцедуры

&НаКлиенте
// Заполняет реквизиты по умолчанию
//
Процедура ЗаполнитьРеквизитыПоУмолчаниюЗавершение(Результат, ТолькоОбязательные = Ложь) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ор_РеквизитыДляЗаполнения.Очистить();
	КонецЕсли;
	
	ЗаполнитьРеквизитыПоУмолчаниюНаСервере(ТолькоОбязательные);
	
КонецПроцедуры

&НаКлиенте
// Заполняет дополнительные реквизиты по умолчанию
//
Процедура ЗаполнитьДополнительныеРеквизитыПоУмолчаниюЗавершение(Результат, ТолькоОбязательные = Ложь) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ор_ДополнительныеРеквизиты.Очистить();
	КонецЕсли;
	
	ЗаполнитьДополнительныеРеквизитыНаСервере(ТолькоОбязательные);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеТовараВнеБазыЗавершение(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ор_ДополнительныеРеквизиты.Очистить();
		Объект.ор_РеквизитыДляЗаполнения.Очистить();
		УстановнитьВидимостьРеквизитовПравила();
	Иначе
		Объект.ор_ТоварВнеБазы = Не Объект.ор_ТоварВнеБазы;
		Если Не Объект.ор_ТоварВнеБазы Тогда
			ИмяПараметра = "[ор_НаименованиеПоставщика]";
			УдалитьПараметрИзШаблона(Объект.ШаблонДляПредставления, ИмяПараметра);
			УдалитьПараметрИзШаблона(Объект.ШаблонДляФормирования, ИмяПараметра);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


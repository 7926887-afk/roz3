
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// Параметры номенклатуры
	ПравилоКраткогоНаименования = Параметры.ПравилоКраткоеНоменклатуры;
	ПравилоПолногоНаименования  = Параметры.ПравилоПолноеНоменклатуры;
	СтруктураДанныеПоставщика   = Параметры.СтруктураДанныеПоставщика;
	
	// Приоритет у правила Полного Наименования
	// Значение правила краткого наименования перезатираются полным.
	Если ЗначениеЗаполнено(ПравилоПолногоНаименования) Тогда
		РеквизитыНоменклатуры.Загрузить(ПравилоКраткогоНаименования.ор_РеквизитыДляЗаполнения.Выгрузить());
		Для Каждого Строка Из ПравилоПолногоНаименования.ор_РеквизитыДляЗаполнения Цикл
			НайденныеСтроки = РеквизитыНоменклатуры.НайтиСтроки(Новый Структура("Реквизит", Строка.Реквизит));
			Если НайденныеСтроки.Количество() = 0 Тогда 
				НоваяСтрока = РеквизитыНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			Иначе
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0],Строка);
			КонецЕсли;
		КонецЦикла;
		
		ДополнительныеРеквизитыНоменклатуры.Загрузить(ПравилоКраткогоНаименования.ор_ДополнительныеРеквизиты.Выгрузить());
		Для Каждого Строка Из ПравилоПолногоНаименования.ор_ДополнительныеРеквизиты Цикл
			НайденныеСтроки = ДополнительныеРеквизитыНоменклатуры.НайтиСтроки(Новый Структура("Реквизит", Строка.Реквизит));
			Если НайденныеСтроки.Количество() = 0 Тогда 
				НоваяСтрока = ДополнительныеРеквизитыНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			Иначе
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0],Строка);
			КонецЕсли;
		КонецЦикла;
	Иначе
		РеквизитыНоменклатуры.Загрузить(ПравилоКраткогоНаименования.ор_РеквизитыДляЗаполнения.Выгрузить());
		ДополнительныеРеквизитыНоменклатуры.Загрузить(ПравилоКраткогоНаименования.ор_ДополнительныеРеквизиты.Выгрузить());
	КонецЕсли;
	
	СоздатьСоответсвиеРеквизитовШаблонов();
	
	// Параметры характеристики
	ПравилоХарактеристики = Параметры.ПравилоХарактеристики;
	
	МассивПараметровНоменклатуры = Новый Массив;
	ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
		МассивПараметровНоменклатуры,
		СтруктураДанныеПоставщика.КатегорияНоменклатуры,
		ПравилоКраткогоНаименования,,
		Истина);
	Если ЗначениеЗаполнено(ПравилоПолногоНаименования) Тогда
		ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
			МассивПараметровНоменклатуры,
			СтруктураДанныеПоставщика.КатегорияНоменклатуры,
			ПравилоПолногоНаименования,,
			Истина);
	КонецЕсли;
	
	ШаблоныНаименований.ДобавитьРеквизитыИЭлементыНаФорму(
		ЭтотОбъект,
		Элементы.ГруппаРеквизитыНоменклатуры,
		МассивПараметровНоменклатуры);
	
	Для каждого Строка Из ПараметрыПравилаИменования Цикл
		Строка.ДляНоменклатуры = Истина;
	КонецЦикла;
	
	// Характеристики
	Если ЗначениеЗаполнено(ПравилоХарактеристики) Тогда
		СоздаватьХарактеристику = Истина;
	Иначе
		СоздаватьХарактеристику = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаНастройкиСозданияХарактеристик.Видимость = СоздаватьХарактеристику;
	
	Если СоздаватьХарактеристику Тогда
		
		МассивПараметровХарактеристик = Новый Массив;
		ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
			МассивПараметровХарактеристик,
			СтруктураДанныеПоставщика.КатегорияНоменклатуры,
			ПравилоХарактеристики,,
			Истина);
		
		Если Параметры.Свойство("ПравилоХарактеристикиДляПечати", ПравилоХарактеристикиДляПечати)
			И ЗначениеЗаполнено(ПравилоХарактеристикиДляПечати) Тогда
			ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
				МассивПараметровХарактеристик,
				СтруктураДанныеПоставщика.КатегорияНоменклатуры,
				ПравилоХарактеристикиДляПечати,,
				Истина);
		КонецЕсли;
		ШаблоныНаименований.ДобавитьРеквизитыИЭлементыНаФорму(
			ЭтотОбъект,
			Элементы.ГруппаРеквизитыХарактеристики,
			МассивПараметровХарактеристик);
		
		РеквизитыХарактеристики.Загрузить(ПравилоХарактеристики.ор_РеквизитыДляЗаполнения.Выгрузить());
		ДополнительныеРеквизитыХарактеристики.Загрузить(ПравилоХарактеристики.ор_ДополнительныеРеквизиты.Выгрузить());
		Если ЗначениеЗаполнено(ПравилоХарактеристикиДляПечати) Тогда
			Для Каждого Строка Из ПравилоХарактеристикиДляПечати.ор_РеквизитыДляЗаполнения Цикл
				НайденныеСтроки = РеквизитыХарактеристики.НайтиСтроки(Новый Структура("Реквизит", Строка.Реквизит));
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрока = РеквизитыХарактеристики.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
				Иначе
					ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], Строка);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Строка Из ПравилоХарактеристикиДляПечати.ор_ДополнительныеРеквизиты Цикл
				НайденныеСтроки = ДополнительныеРеквизитыХарактеристики.НайтиСтроки(Новый Структура("Реквизит", Строка.Реквизит));
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрока = ДополнительныеРеквизитыХарактеристики.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
				Иначе
					ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], Строка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// При добавлении параметров характеристик затераются параметры номенклатуры 
		Для каждого СтрокаПараметр Из МассивПараметровНоменклатуры Цикл
			НоваяСтрока = ПараметрыПравилаИменования.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаПараметр);
			НоваяСтрока.ДляНоменклатуры = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	НоваяСтрока = ПараметрыПравилаИменования.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Новый Структура("ДанныеПараметраСтрокой,ИмяПараметра,ИмяЭлемента,ПутьКДанным",
		СтруктураДанныеПоставщика.КатегорияНоменклатуры,
		"Категория номенклатуры",
		"КатегорияНоменклатуры",
		"КатегорияНоменклатуры"));
	
	ОткорректироватьРеквизитыНоменклатуры();
	СоздатьРеквизитыСправочников();
	ДобавитьДополнительныеРеквизитыСправочников();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьСправочник(Команда)
	
	Отказ = Ложь;
	ПроверитьЗаполнениеПолей(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СписокНоменклатуры = НайтиНомеклатуруНаСервере();
	
	Если СписокНоменклатуры.Количество() > 0 Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("СписокНоменклатуры", СписокНоменклатуры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросСоздаватьНоменклатуруЗавершение", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(
			ОписаниеОповещения,
			НСтр("ru = 'Уже существует номенклатура с такими же параметрами.
			|Использовать её?'"),
			РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	СоздатьСправочникЗавершение();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОткорректироватьРеквизитыНоменклатуры()
	
	НайденныеСтроки = ПараметрыПравилаИменования.НайтиСтроки(Новый Структура("ИмяПараметра", "ор_НаименованиеПоставщика"));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Для Каждого Элемент Из НайденныеСтроки Цикл
			Элемент.ДанныеПараметраСтрокой = СтруктураДанныеПоставщика.НаименованиеПоставщика;
			ЭтотОбъект[Элемент.ПутьКданным] = СтруктураДанныеПоставщика.НаименованиеПоставщика;
		КонецЦикла;
	КонецЕсли;
	
	// Номенклатура
	// Удаление реквизитов правил из реквизитов номенклатуры
	Для каждого Реквизит Из ПараметрыПравилаИменования Цикл
		//НайденнаяСтрока = РеквизитыНоменклатуры.НайтиСтроки(Новый Структура("Реквизит,Представление",Реквизит.ПутьКДанным,Реквизит.ИмяПараметра));
		НайденнаяСтрока = РеквизитыНоменклатуры.НайтиСтроки(Новый Структура("Представление",Реквизит.ИмяПараметра));
		Если НайденнаяСтрока.Количество() > 0 Тогда
			Реквизит.ДанныеПараметраСтрокой = НайденнаяСтрока[0].Значение;
			ЭтотОбъект[Реквизит.ПутьКДанным] = НайденнаяСтрока[0].Значение;
			РеквизитыНоменклатуры.Удалить(НайденнаяСтрока[0]);
		КонецЕсли;
		
		//НайденнаяСтрока = ДополнительныеРеквизитыНоменклатуры.НайтиСтроки(Новый Структура("Реквизит,Представление",Реквизит.ПутьКДанным,Реквизит.ИмяПараметра));
		НайденнаяСтрока = ДополнительныеРеквизитыНоменклатуры.НайтиСтроки(Новый Структура("Представление",Реквизит.ИмяПараметра));
		Если НайденнаяСтрока.Количество() > 0 Тогда
			Реквизит.ДанныеПараметраСтрокой		= НайденнаяСтрока[0].Значение;
			ЭтотОбъект[Реквизит.ПутьКДанным]	= НайденнаяСтрока[0].Значение;
			ДополнительныеРеквизитыНоменклатуры.Удалить(НайденнаяСтрока[0]);
		КонецЕсли;
	КонецЦикла;
	
	// Характеристики
	// Удаление реквизитов правил из реквизитов номенклатуры
	Для каждого Реквизит Из ПараметрыПравилаИменования Цикл
		НайденнаяСтрока = РеквизитыХарактеристики.НайтиСтроки(Новый Структура("Представление",Реквизит.ИмяПараметра));
		Если НайденнаяСтрока.Количество() > 0 Тогда
			Реквизит.ДанныеПараметраСтрокой = НайденнаяСтрока[0].Значение;
			ЭтотОбъект[Реквизит.ПутьКДанным] = НайденнаяСтрока[0].Значение;
			РеквизитыХарактеристики.Удалить(НайденнаяСтрока[0]);
		КонецЕсли;
		
		НайденнаяСтрока = ДополнительныеРеквизитыХарактеристики.НайтиСтроки(Новый Структура("Представление",Реквизит.ИмяПараметра));
		Если НайденнаяСтрока.Количество() > 0 Тогда
			Реквизит.ДанныеПараметраСтрокой		= НайденнаяСтрока[0].Значение;
			ЭтотОбъект[Реквизит.ПутьКДанным]	= НайденнаяСтрока[0].Значение;
			ДополнительныеРеквизитыХарактеристики.Удалить(НайденнаяСтрока[0]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыСправочников()
	
	Для Каждого ТекРеквизит Из РеквизитыНоменклатуры Цикл
		
		// Добавим реквизит
		ИмяЭлемента = "Номенклатура" + ТекРеквизит.Реквизит;
		ТипОписание = Новый ОписаниеТипов(Метаданные.Справочники.Номенклатура.Реквизиты[ТекРеквизит.Реквизит].Тип);
		Реквизит = Новый РеквизитФормы(ИмяЭлемента, ТипОписание);
		ДобавляемыеРеквизиты = Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Реквизит);
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		ЭтотОбъект[ИмяЭлемента] = ТекРеквизит.Значение;
		
		Если Не ЗначениеЗаполнено(ТекРеквизит.Значение) Или ТипЗнч(ТекРеквизит.Значение) = Тип("Булево") Тогда
			// Если значение не заполнено, добавим поле для заполнения.
			НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.ГруппаРеквизитыНоменклатуры);
			НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = ИмяЭлемента;
			НовыйЭлемент.Заголовок   = ТекРеквизит.Представление;
			НовыйЭлемент.АвтоОтметкаНезаполненного = Метаданные.Справочники.Номенклатура.Реквизиты[ТекРеквизит.Реквизит].ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
		КонецЕсли;
		
	КонецЦикла;
	
	Сч=0;
	Для Каждого ТекРеквизит Из ДанныеПоставщикаНоменклатура Цикл
		
		Если ЗначениеЗаполнено(СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра]) Тогда
			Если ТекРеквизит.ЭтоДополнительныйРеквизит Тогда
				// Добавим реквизит
				ИмяЭлемента = "ДополнительныйРеквизитРегистр" + Сч;
				ТипОписание = СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра].ТипЗначения;
				Реквизит = Новый РеквизитФормы(ИмяЭлемента, ТипОписание);
				ДобавляемыеРеквизиты = Новый Массив;
				ДобавляемыеРеквизиты.Добавить(Реквизит);
				ИзменитьРеквизиты(ДобавляемыеРеквизиты);
				ЭтотОбъект[ИмяЭлемента] = СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра];
				
				// Добавим строку с описанием дополнительного реквизита в таблицу значений.
				НоваяСтрока = ДополнительныеРеквизитыНоменклатурыОписание.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекРеквизит);
				НоваяСтрока.ИмяРеквизитаНаФорме = ИмяЭлемента;
				Сч = Сч+1;
			Иначе
				// Добавим реквизит
				ИмяЭлемента = "Номенклатура" + ТекРеквизит.РеквизитСправочника;
				МестоположениеРеквизита=?(ТекРеквизит.ЭтоСтандартныйРеквизит,"СтандартныеРеквизиты", "Реквизиты");
				ТипОписание = Новый ОписаниеТипов(Метаданные.Справочники.Номенклатура[МестоположениеРеквизита][ТекРеквизит.РеквизитСправочника].Тип);
				Реквизит = Новый РеквизитФормы(ИмяЭлемента, ТипОписание);
				ДобавляемыеРеквизиты = Новый Массив;
				ДобавляемыеРеквизиты.Добавить(Реквизит);
				ИзменитьРеквизиты(ДобавляемыеРеквизиты);
				ЭтотОбъект[ИмяЭлемента] = СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра];
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если СоздаватьХарактеристику Тогда
		
		Для Каждого ТекРеквизит Из РеквизитыХарактеристики Цикл
			
			// Добавим реквизит
			ИмяЭлемента = "Характеристика" + ТекРеквизит.Реквизит;
			ТипОписание = Новый ОписаниеТипов(Метаданные.Справочники.ХарактеристикиНоменклатуры.Реквизиты[ТекРеквизит.Реквизит].Тип);
			Реквизит = Новый РеквизитФормы(ИмяЭлемента, ТипОписание);
			ДобавляемыеРеквизиты = Новый Массив;
			ДобавляемыеРеквизиты.Добавить(Реквизит);
			ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			ЭтотОбъект[ИмяЭлемента] = ТекРеквизит.Значение;
			
			Если Не ЗначениеЗаполнено(ТекРеквизит.Значение) Или ТипЗнч(ТекРеквизит.Значение) = Тип("Булево") Тогда
				// Если значение не заполнено, добавим поле для заполнения.
				НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.ГруппаРеквизитыХарактеристики);
				НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
				НовыйЭлемент.ПутьКДанным = ИмяЭлемента;
				НовыйЭлемент.Заголовок = ТекРеквизит.Представление;
				НовыйЭлемент.АвтоОтметкаНезаполненного =
				Метаданные.Справочники.ХарактеристикиНоменклатуры.Реквизиты[ТекРеквизит.Реквизит].ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ТекРеквизит Из ДанныеПоставщикаХарактеристика Цикл
			
			Если ЗначениеЗаполнено(СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра]) Тогда
				Если ТекРеквизит.ЭтоДополнительныйРеквизит Тогда
					// Добавим реквизит
					ИмяЭлемента = "ДополнительныйРеквизитРегистр" + Сч;
					ТипОписание = ТипЗнч(СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра]);
					МассивТипов = Новый Массив;
					МассивТипов.Добавить(ТипОписание);
					Реквизит = Новый РеквизитФормы(ИмяЭлемента, Новый ОписаниеТипов(МассивТипов));
					ДобавляемыеРеквизиты = Новый Массив;
					ДобавляемыеРеквизиты.Добавить(Реквизит);
					ИзменитьРеквизиты(ДобавляемыеРеквизиты);
					ЭтотОбъект[ИмяЭлемента] = СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра];
					// Добавим строку с описанием дополнительного реквизита в таблицу значений.
					НоваяСтрока = ДополнительныеРеквизитыХарактеристикиОписание.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекРеквизит);
					НоваяСтрока.ИмяРеквизитаНаФорме = ИмяЭлемента;
					НоваяСтрока.Реквизит = ТекРеквизит.РеквизитСправочника;
					Сч = Сч+1;
				Иначе
					// Добавим реквизит
					ИмяЭлемента = "Характеристика" + ТекРеквизит.РеквизитНоменклатуры;
					МестоположениеРеквизита=?(ТекРеквизит.ЭтоСтандартныйРеквизит,"СтандартныеРеквизиты", "Реквизиты");
					ТипОписание = Новый ОписаниеТипов(Метаданные.Справочники.ХарактеристикиНоменклатуры[МестоположениеРеквизита][ТекРеквизит.РеквизитСправочника].Тип);
					Реквизит = Новый РеквизитФормы(ИмяЭлемента, ТипОписание);
					ДобавляемыеРеквизиты = Новый Массив;
					ДобавляемыеРеквизиты.Добавить(Реквизит);
					ИзменитьРеквизиты(ДобавляемыеРеквизиты);
					ЭтотОбъект[ИмяЭлемента] = СтруктураДанныеПоставщика[ТекРеквизит.РеквизитРегистра];
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры


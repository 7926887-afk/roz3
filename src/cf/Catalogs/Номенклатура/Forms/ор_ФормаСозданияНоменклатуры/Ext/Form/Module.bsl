&НаСервере
Функция СоздатьСправочникНаСервере(Номенклатура, ТекстСообщения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Номенклатура = Неопределено Тогда
		СозданнаяНоменклатура = СоздатьНомеклатуруНаСервере(ТекстСообщения);
		Если СозданнаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		СозданнаяНоменклатура = Номенклатура;
	КонецЕсли;
	
	Если СоздаватьХарактеристику Тогда
		
		НачатьТранзакцию();
		
		НовыйЭлементХарактеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		
		Для Каждого ТекРеквизит Из РеквизитыХарактеристики Цикл
			ИмяРеквизита = ТекРеквизит.Реквизит;
			НовыйЭлементХарактеристика[ИмяРеквизита] = ЭтотОбъект["Характеристика"+ИмяРеквизита];
		КонецЦикла;
		Для Каждого ТекРеквизит Из ДанныеПоставщикаХарактеристика Цикл
			Если НЕ ТекРеквизит.ЭтоДополнительныйРеквизит Тогда
				ИмяРеквизита = ТекРеквизит.РеквизитРегистра;
				НовыйЭлементХарактеристика[ТекРеквизит.РеквизитСправочника] = ЭтотОбъект["Характеристика"+ ИмяРеквизита];
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекРеквизит Из ПараметрыПравилаИменования Цикл
			ИмяРеквизита = ТекРеквизит.ПутьКДанным;
			Если ИмяРеквизита = "КатегорияНоменклатуры" ИЛИ ТекРеквизит.ДляНоменклатуры Тогда 
				Продолжить;
			КонецЕсли;
			
			Если НЕ ТекРеквизит.ЭтоДопСведение И НЕ ТекРеквизит.ЭтоДопРеквизит Тогда
				ИмяРеквизитаСправочника = Прав(ИмяРеквизита,СтрДлина(ИмяРеквизита)-15);
				НовыйЭлементХарактеристика[ИмяРеквизитаСправочника] = ЭтотОбъект[ИмяРеквизита];
			ИначеЕсли ТекРеквизит.ЭтоДопРеквизит Тогда
				НоваяСтрока = НовыйЭлементХарактеристика.ДополнительныеРеквизиты.Добавить();
				НоваяСтрока.Свойство = ТекРеквизит.Свойство;
				НоваяСтрока.Значение = ЭтотОбъект[ТекРеквизит.ПутьКДанным];
			КонецЕсли;
		КонецЦикла;
		
		// Добавим дополнительные реквизиты номенклатуры
		СоздатьДополнительныеРеквизитыСправочника("ДополнительныеРеквизитыХарактеристикиОписание", НовыйЭлементХарактеристика);
		
		СписокПараметров = ПолучитьСписокПараметровДляШаблона(Истина);
		НовыйЭлементХарактеристика.Наименование = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
			СписокПараметров,
			ПравилоХарактеристики.ШаблонДляФормирования);
		Если ЗначениеЗаполнено(ПравилоХарактеристикиДляПечати) Тогда
			НовыйЭлементХарактеристика.НаименованиеДляПечати = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
				СписокПараметров,
				ПравилоХарактеристикиДляПечати.ШаблонДляФормирования);
		КонецЕсли;
		Если ПустаяСтрока(НовыйЭлементХарактеристика.НаименованиеДляПечати) Тогда
			НовыйЭлементХарактеристика.НаименованиеДляПечати = НовыйЭлементХарактеристика.Наименование;
		КонецЕсли;
		
		НовыйЭлементХарактеристика.Владелец = ?(ГдеСоздаемХарактеристики = 1, СозданнаяНоменклатура.КатегорияНоменклатуры, СозданнаяНоменклатура);
		
		Попытка
			НовыйЭлементХарактеристика.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ТекстСообщения = "Не удалось записать элемент справочника" + ОписаниеОшибки();
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецПопытки;
		
		СозданнаяХарактеристика = НовыйЭлементХарактеристика.Ссылка;
		
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Номенклатура", СозданнаяНоменклатура);
	СтруктураПараметров.Вставить("ТипНоменклатуры", СозданнаяНоменклатура.ТипНоменклатуры);
	СтруктураПараметров.Вставить("Характеристика",  СозданнаяХарактеристика);
	СтруктураПараметров.Вставить("ХарактеристикиИспользуются",  СозданнаяНоменклатура.КатегорияНоменклатуры.ИспользоватьХарактеристики);
	СтруктураПараметров.Вставить("ДоговорКонтрагента", СозданнаяНоменклатура.Договор);

	Возврат Истина;
	
КонецФункции

&НаСервере
Функция НайтиНомеклатуруНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование";
	
	Запрос = Новый Запрос;
	
	СписокОтборов = Новый Массив;
	СписокОтборов.Добавить("Наименование");
	СписокОтборов.Добавить("НаименованиеПолное");
	
	Для Каждого ТекРеквизит Из РеквизитыНоменклатуры Цикл
		
		ИмяРеквизита = ТекРеквизит.Реквизит;
		Если СписокОтборов.Найти(ИмяРеквизита) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СписокОтборов.Добавить(ИмяРеквизита);
		
		ТекстЗапроса = СтрШаблон(
			"%1
			|	И Номенклатура.%2 = &%2",
			ТекстЗапроса,
			ИмяРеквизита);
		Запрос.УстановитьПараметр(ИмяРеквизита, ЭтотОбъект["Номенклатура" + ИмяРеквизита]);
		
	КонецЦикла;
	
	Для Каждого ТекРеквизит Из ДанныеПоставщикаНоменклатура Цикл
		Если ТекРеквизит.ЭтоДополнительныйРеквизит Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизита = ТекРеквизит.РеквизитСправочника;
		Если СписокОтборов.Найти(ИмяРеквизита) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СписокОтборов.Добавить(ИмяРеквизита);
		
		ТекстЗапроса = СтрШаблон(
			"%1
			|	И Номенклатура.%2 = &%2",
			ТекстЗапроса,
			ИмяРеквизита);
		Запрос.УстановитьПараметр(ИмяРеквизита, ЭтотОбъект["Номенклатура" + ИмяРеквизита]);
		
	КонецЦикла;
	
	// В таблице ПараметрыПравилаИменования лежат реквизиты номенклатуры и характеристики - отличительная особеность флаг "ДляНоменклатуры" 
	Для Каждого ТекРеквизит Из ПараметрыПравилаИменования Цикл
		
		ИмяРеквизита = ТекРеквизит.ПутьКДанным;
		Если ИмяРеквизита = "КатегорияНоменклатуры"
			Или Не ТекРеквизит.ДляНоменклатуры
			Или (ТекРеквизит.ЭтоДопСведение Или ТекРеквизит.ЭтоДопРеквизит) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизитаСправочника = Прав(ИмяРеквизита,СтрДлина(ИмяРеквизита)-13);
		Если СписокОтборов.Найти(ИмяРеквизитаСправочника) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СписокОтборов.Добавить(ИмяРеквизитаСправочника);
		
		ТекстЗапроса = СтрШаблон(
			"%1
			|	И Номенклатура.%2 = &%2",
			ТекстЗапроса,
			ИмяРеквизитаСправочника);
		Запрос.УстановитьПараметр(ИмяРеквизитаСправочника, ЭтотОбъект[ИмяРеквизита]);
		
		ТекРеквизит.ДанныеПараметраСтрокой = Формат(ЭтотОбъект[ИмяРеквизита],"ДЛФ=Д; БЛ='Ложь'; БИ='" + ТекРеквизит.ИмяПараметра + "'");
		
	КонецЦикла;
	
	СписокПараметров = ПолучитьСписокПараметровДляШаблона();
	Запрос.УстановитьПараметр("Наименование", ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
		СписокПараметров,
		ПравилоКраткогоНаименования.ШаблонДляФормирования));
	
	// Корректируем значения которые могут браться из Категории номенклатуры.
	ТекКатегорияНоменклатуры = Неопределено;
	Если Запрос.Параметры.Свойство("КатегорияНоменклатуры", ТекКатегорияНоменклатуры) Тогда
		ЗначенияПоУмолчанию = ПолучитьЗначенияПоУмолчаниюДляКатегорииНоменклатуры(ТекКатегорияНоменклатуры);
		Для Каждого ТекРеквизит Из ЗначенияПоУмолчанию Цикл
			ИмяРеквизита = ТекРеквизит.Ключ;
			Если Запрос.Параметры.Свойство(ИмяРеквизита)
				И Не ЗначениеЗаполнено(Запрос.Параметры[ИмяРеквизита]) Тогда
				Запрос.Параметры[ИмяРеквизита] = ТекРеквизит.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	СписокНоменклатуры = Новый Массив;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокНоменклатуры.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокНоменклатуры;
	
КонецФункции

&НаСервере
Функция СоздатьНомеклатуруНаСервере(ТекстСообщения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
	
	НовыйЭлемент.КатегорияНоменклатуры = СтруктураДанныеПоставщика.КатегорияНоменклатуры;
	ЗаполнитьЗначенияНоменклатурыПоУмолчанию(НовыйЭлемент);
	КатегорииНоменклатурыСервер.ЗаполнитьСвойстваНоменклатурыПоКатегории(НовыйЭлемент, Истина);
	
	НовыйЭлемент.ИспользоватьХарактеристики = СоздаватьХарактеристику;
	
	Для Каждого ТекРеквизит Из РеквизитыНоменклатуры Цикл
		ИмяРеквизита = ТекРеквизит.Реквизит;
		НовыйЭлемент[ИмяРеквизита] = ЭтотОбъект["Номенклатура"+ ИмяРеквизита];
	КонецЦикла;
	
	Для Каждого ТекРеквизит Из ДанныеПоставщикаНоменклатура Цикл
		Если НЕ ТекРеквизит.ЭтоДополнительныйРеквизит Тогда
			ИмяРеквизита = ТекРеквизит.РеквизитСправочника;
			НовыйЭлемент[ТекРеквизит.РеквизитСправочника] = ЭтотОбъект["Номенклатура"+ ИмяРеквизита];
		КонецЕсли;
	КонецЦикла;
	
	// В таблице ПараметрыПравилаИменования лежат реквизиты номенклатуры и характеристики - отличительная особеность флаг "ДляНоменклатуры" 
	Для Каждого ТекРеквизит Из ПараметрыПравилаИменования Цикл
		ИмяРеквизита = ТекРеквизит.ПутьКДанным;
		Если ИмяРеквизита = "КатегорияНоменклатуры" Тогда 
			Продолжить;
		КонецЕсли;
		
		Если ТекРеквизит.ДляНоменклатуры Тогда
			Если НЕ ТекРеквизит.ЭтоДопСведение И НЕ ТекРеквизит.ЭтоДопРеквизит Тогда
				ИмяРеквизитаСправочника = Прав(ИмяРеквизита,СтрДлина(ИмяРеквизита)-13);
				НовыйЭлемент[ИмяРеквизитаСправочника] = ЭтотОбъект[ИмяРеквизита];
			ИначеЕсли ТекРеквизит.ЭтоДопРеквизит Тогда
				НоваяСтрока = НовыйЭлемент.ДополнительныеРеквизиты.Добавить();
				НоваяСтрока.Свойство = ТекРеквизит.Свойство;
				НоваяСтрока.Значение = ЭтотОбъект[ТекРеквизит.ПутьКДанным];
			КонецЕсли;
		КонецЕсли;
		ТекРеквизит.ДанныеПараметраСтрокой = Формат(ЭтотОбъект[ИмяРеквизита],"ДЛФ=Д; БЛ='Ложь'; БИ='" + ТекРеквизит.ИмяПараметра + "'");
	КонецЦикла;
	
	КлючВидовПродукции = Неопределено;
	ОписаниеНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(НовыйЭлемент.КатегорияНоменклатуры)[НовыйЭлемент.КатегорияНоменклатуры];
	Если Не ОписаниеНоменклатуры = Неопределено Тогда
		КлючВидовПродукции = ОписаниеНоменклатуры.КлючВидовПродукции;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючВидовПродукции) Тогда
		НовыйЭлемент.ПризнакПредметаРасчета = РозничныеПродажиСервер.ПолучитьОжидаемыйПризнакПредметаРасчета(
			НовыйЭлемент.ТипНоменклатуры,
			КлючВидовПродукции,
			НовыйЭлемент.ВидМаркировки,
			НовыйЭлемент.ПодакцизныйТовар,
			НовыйЭлемент.ПродаетсяВРозлив);
		
		Если КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияВЕТИС(КлючВидовПродукции)
			И Не НовыйЭлемент.ПодконтрольнаяПродукцияВЕТИС Тогда
			НовыйЭлемент.ПодконтрольнаяПродукцияВЕТИС = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Добавим дополнительные реквизиты номенклатуры
	СоздатьДополнительныеРеквизитыСправочника("ДополнительныеРеквизитыНоменклатурыОписание", НовыйЭлемент);
	
	СписокПараметров = ПолучитьСписокПараметровДляШаблона();
	НовыйЭлемент.Наименование = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
		СписокПараметров,
		ПравилоКраткогоНаименования.ШаблонДляФормирования);
	
	НовыйЭлемент.НаименованиеПолное = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
		СписокПараметров,
		ПравилоПолногоНаименования.ШаблонДляФормирования);
	
	Если ПустаяСтрока(НовыйЭлемент.НаименованиеПолное) Тогда
		НовыйЭлемент.НаименованиеПолное = НовыйЭлемент.Наименование;
	КонецЕсли;
	
	Попытка
		НачатьТранзакцию();
		НовыйЭлемент.Записать();
		// ИнтеграцияГосИС
		// Если произойдет ошибка при создании настройки маркируемой продукции,
		// то не уходим в отказ, так как номенклатура уже создана,
		// а сообщение об ошибке выводиться во вложенных функциях.
		ЕстьОшибки = Ложь;
		СобытияФормИСУНФ.ПриЗаписиНаСервере(ЭтотОбъект, НовыйЭлемент, ЕстьОшибки);
		// Конец ИнтеграцияГосИС
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось записать элемент справочника. %1'"),
									КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Процедура СоздатьДополнительныеРеквизитыСправочника(ИмяТЧ, СправочникОбъект)
	
	Для Каждого ТекРеквизит Из ЭтотОбъект[ИмяТЧ] Цикл
		
		Если Не ПроверитьЗаполнениеРеквизита(ТекРеквизит.Значение) Тогда
			ТекРеквизит.Значение = ЭтотОбъект[ТекРеквизит.ИмяРеквизитаНаФорме];
		КонецЕсли;
		
		СтрокаРеквизита = СправочникОбъект.ДополнительныеРеквизиты.Добавить();
		СтрокаРеквизита.Свойство = ТекРеквизит.Реквизит;
		СтрокаРеквизита.Значение = ТекРеквизит.Значение;
		
		// Поддержка строк неограниченной длины.
		ИспользоватьНеограниченнуюСтроку = УправлениеСвойствамиСлужебный.ИспользоватьНеограниченнуюСтроку(
		ТекРеквизит.Реквизит.ТипЗначения, ТекРеквизит.Реквизит.МногострочноеПолеВвода);
		
		Если ИспользоватьНеограниченнуюСтроку Тогда
			СтрокаРеквизита.ТекстоваяСтрока = ТекРеквизит.Значение;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПолей(Отказ)
	Для Каждого ТекЭлемент Из Элементы Цикл
		
		Если ТипЗнч(ТекЭлемент) <> Тип("ПолеФормы")
			Или ТекЭлемент.Имя = "ГдеСоздаемХарактеристики" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекЭлемент.ОтметкаНезаполненного = Истина тогда
			ИмяРеквизита = ПолучитьПутьКДанным(ТекЭлемент.Имя);
			Если Не ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизита]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено значение реквизита """ + ТекЭлемент.Заголовок + """" ,,
				ТекЭлемент.Имя,ПолучитьПутьКДанным(ТекЭлемент.Имя),Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецФункции

&НаСервере
Функция ПолучитьПутьКДанным(ИмяПолеФормы)
	Возврат Элементы[ИмяПолеФормы].ПутьКДанным;
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеРеквизита(Реквизит)
	
	Если ТипЗнч(Реквизит) = Тип("Дата") Тогда
		Возврат Реквизит = Дата(1,1,1);
	Иначе 
		Возврат ЗначениеЗаполнено(Реквизит); 
	КонецЕсли;
	
КонецФункции

&НаСервере

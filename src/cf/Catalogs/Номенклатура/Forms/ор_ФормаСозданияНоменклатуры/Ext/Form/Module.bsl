КонецПроцедуры

&НаКлиенте
Процедура ВопросСоздаватьНоменклатуруЗавершение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		Если ДополнительныеПараметры.СписокНоменклатуры.Количество() = 1 Тогда
			СоздатьСправочникЗавершение(ДополнительныеПараметры.СписокНоменклатуры[0]);
		Иначе
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборНоменклатурыЗавершение", ЭтотОбъект);
			
			СписокЗначений = Новый СписокЗначений;
			СписокЗначений.ЗагрузитьЗначения(ДополнительныеПараметры.СписокНоменклатуры);
			ПоказатьВыборИзСписка(
				ОписаниеОповещения,
				СписокЗначений);
			
		КонецЕсли;
	Иначе
		СоздатьСправочникЗавершение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборНоменклатурыЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьСправочникЗавершение(ВыбранныйЭлемент.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСправочникЗавершение(Номенклатура = Неопределено)
	
	ТекстСообщения = "";
	Если СоздатьСправочникНаСервере(Номенклатура, ТекстСообщения) Тогда
		Закрыть(СтруктураПараметров);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначенияПоУмолчаниюДляКатегорииНоменклатуры(КатегорияНоменклатуры)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	КатегорииНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	КатегорииНоменклатуры.ВидСтавкиНДС КАК ВидСтавкиНДС,
	|	КатегорииНоменклатуры.ЦеноваяГруппа КАК ЦеноваяГруппа,
	|	КатегорииНоменклатуры.СтранаПроисхождения КАК СтранаПроисхождения,
	|	КатегорииНоменклатуры.Производитель КАК Производитель
	|ИЗ
	|	Справочник.КатегорииНоменклатуры КАК КатегорииНоменклатуры
	|ГДЕ
	|	КатегорииНоменклатуры.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", КатегорияНоменклатуры);
	Результат = Запрос.Выполнить();
	
	СтруктураПараметров = Новый Структура;
	Для Каждого ТекущаяКолонка Из Результат.Колонки Цикл
		СтруктураПараметров.Вставить(ТекущаяКолонка.Имя, Неопределено);
	КонецЦикла;
	
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, Выборка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураПараметров.ВидСтавкиНДС) Тогда
		СтруктураПараметров.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураПараметров.ЕдиницаИзмерения) Тогда
		СтруктураПараметров.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду("796");
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьЗначенияНоменклатурыПоУмолчанию(Номенклатура)
	
	Если ЗначениеЗаполнено(Номенклатура.КатегорияНоменклатуры) Тогда
		Номенклатура.ВидСтавкиНДС = Номенклатура.КатегорияНоменклатуры.ВидСтавкиНДС;
		Номенклатура.ТипНоменклатуры = Номенклатура.КатегорияНоменклатуры.ТипНоменклатурыПоУмолчанию;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура.ВидСтавкиНДС) Тогда
		Номенклатура.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура.ТипНоменклатуры) Тогда
		Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура.ЕдиницаИзмерения) Тогда
		Номенклатура.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;
	КонецЕсли;
	
	Номенклатура.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
	Номенклатура.МетодОценки      = Перечисления.МетодОценкиЗапасов.ПоСредней;
	Номенклатура.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	
	Номенклатура.СчетУчетаЗапасов = Справочники.Номенклатура.СчетУчетаЗапасов();
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПодсистемуПроизводство") Тогда
		Номенклатура.СчетУчетаЗатрат = ПредопределенноеЗначение("ПланСчетов.Управленческий.НезавершенноеПроизводство");
	Иначе
		Номенклатура.СчетУчетаЗатрат = ПредопределенноеЗначение("ПланСчетов.Управленческий.КоммерческиеРасходы");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПараметровДляШаблона(ДляХарактеристики = Ложь)
	
	СписокПараметров = Новый СписокЗначений;
	
	Для Каждого ТекущиеДанные Из ПараметрыПравилаИменования Цикл
		Если Не ДляХарактеристики И ТекущиеДанные.ДляНоменклатуры
			Или ДляХарактеристики И Не ТекущиеДанные.ДляНоменклатуры Тогда
			СписокПараметров.Добавить(ТекущиеДанные.ИмяПараметра, ТекущиеДанные.ДанныеПараметраСтрокой);

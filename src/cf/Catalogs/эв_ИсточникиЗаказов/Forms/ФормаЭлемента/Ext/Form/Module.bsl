&НаСервере
Процедура УстановитьВидимостьНаСервере()

    Портал = ПорталВида(Объект.Вид);
    ЭтоМегаАптека = Портал = Перечисления.эв_ВидыИсточниковЗаказа.МегаАптека;
    ЭтоЮтека = Портал = Перечисления.эв_ВидыИсточниковЗаказа.Ютека;
    ЭтоАсна = Портал = Перечисления.эв_ВидыИсточниковЗаказа.Асна;
    ЭтоЭвалар = Портал = Перечисления.эв_ВидыИсточниковЗаказа.Эвалар;
    ЭтоАптекаМос = Портал = Перечисления.эв_ВидыИсточниковЗаказа.АптекаМос;

    Элементы.ОтправитьАптекуВСервис.Видимость = ЭтоМегаАптека Или ЭтоЮтека;
    Элементы.ПроверитьСтатусАптеки.Видимость = ЭтоМегаАптека Или ЭтоЮтека;
    Элементы.УдалитьАптекуИзСервиса.Видимость = ЭтоМегаАптека Или ЭтоЮтека;
    Элементы.ВыполнитьСвязкиАСНА.Видимость = ЭтоАсна;
    Элементы.ОтправитьФайлКаталога.Видимость = ЭтоАсна;
    Элементы.ПолнаяВыгрузкаОстатков.Видимость = ЭтоМегаАптека Или ЭтоЮтека Или ЭтоАсна ИЛИ ЭтоЭвалар ИЛИ ЭтоАптекаМос;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПорталВида(Вид)

    Если Не ЗначениеЗаполнено(Вид) Тогда
        Возврат Перечисления.эв_ВидыИсточниковЗаказа.ПустаяСсылка();
    КонецЕсли;

    Портал = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Вид, "Портал");
    Если Не ЗначениеЗаполнено(Портал) Тогда
        Возврат Перечисления.эв_ВидыИсточниковЗаказа.ПустаяСсылка();
    КонецЕсли;

    Возврат Портал;

КонецФункции

&НаКлиенте
Функция ДанныеАптекиФормы()

    ДанныеАптеки = Новый Структура;
    ДанныеАптеки.Вставить("Вид",          Объект.Вид);
    ДанныеАптеки.Вставить("Активный",     Объект.Активный);
    ДанныеАптеки.Вставить("Склад",        Объект.Склад);
    ДанныеАптеки.Вставить("Комментарий",  Объект.Комментарий);
    ДанныеАптеки.Вставить("Широта",       Объект.Широта);
    ДанныеАптеки.Вставить("Долгота",      Объект.Долгота);
    ДанныеАптеки.Вставить("ГрафикРаботы", Объект.ГрафикРаботы);
    ДанныеАптеки.Вставить("Регион",       Объект.Регион);
    ДанныеАптеки.Вставить("Город",        Объект.Город);
    ДанныеАптеки.Вставить("Адрес",        Объект.Адрес);
    ДанныеАптеки.Вставить("Телефон",      Объект.Телефон);
    ДанныеАптеки.Вставить("Почта",        Объект.Почта);
    
    Возврат ДанныеАптеки;

КонецФункции


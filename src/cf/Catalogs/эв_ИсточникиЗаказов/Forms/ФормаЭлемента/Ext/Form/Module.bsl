&НаКлиенте
Процедура ОтправитьКаталогНаКлиенте(Результат, ДополнительныеПараметры) Экспорт

    Если Результат <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ПутьWinSCP = "C:\Program Files (x86)\WinSCP\WinSCP.exe";
    ФайлФТП = Новый Файл(ПутьWinSCP);
    Если Не ФайлФТП.Существует() Тогда
        ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(
            "Для отправки каталога необходимо наличие установленной программы WinSCP в каталог %1", ПутьWinSCP));
        Возврат;
    КонецЕсли;

    Адрес = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
    ПараметрыФТП = эв_ОбменСПорталамиСервер.СформироватьКаталогДБФАСНА(Адрес);
    Если ПараметрыФТП = "" Тогда
        ОбщегоНазначенияКлиент.СообщитьПользователю("В источнике заказов Асна не указан склад выгрузки остатков");
        Возврат;
    КонецЕсли;
    Если ТипЗнч(ПараметрыФТП) <> Тип("Структура") Тогда
        Возврат;
    КонецЕсли;

    ИмяФайлаКаталога = ПолучитьИмяВременногоФайла("dbf");
    ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
    ДвоичныеДанные.Записать(ИмяФайлаКаталога);

    ТекстСценария = СтрШаблон(
        "option batch abort
        |option confirm off
        |open sftp://%1:%2@%3 -hostkey=*
        |put -delete -rawtransfersettings IgnorePermErrors=1 ReplaceInvalidChars=0 %4 \goods.dbf
        |exit",
        ПараметрыФТП.ЛогинФТП,
        ПараметрыФТП.ПарольФТП,
        ПараметрыФТП.АдресФТП,
        ИмяФайлаКаталога);

    ИмяФайлаСценария = ПолучитьИмяВременногоФайла("txt");
    ФайлСценария = Новый ТекстовыйДокумент;
    ФайлСценария.УстановитьТекст(ТекстСценария);
    ФайлСценария.Записать(ИмяФайлаСценария);

    ИмяФайлаЛога = ПолучитьИмяВременногоФайла("log");
    Команда = """" + ПутьWinSCP + """ /ini=nul /console /script=""" + ИмяФайлаСценария + """ /log=""" + ИмяФайлаЛога + """";
    ЗапуститьПриложение(Команда, , Истина);

    ФайлЛога = Новый ТекстовыйДокумент;
    Попытка
        ФайлЛога.Прочитать(ИмяФайлаЛога, КодировкаТекста.UTF8);
    Исключение
        ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    ФайлЛога.Показать("Лог выгрузки файла на SFTP сервер портала");
    Объект.Комментарий = СтрШаблон("Отправка каталога %1", ТекущаяДата());
    Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПолнаяВыгрузкаОстатков(Команда)

    ДлительнаяОперация = ЗапуститьПолнуюВыгрузкуОстатковНаСервере();
    Если ДлительнаяОперация.Статус = "Выполняется" Тогда
        ПоказатьОповещениеПользователя("Полная выгрузка остатков", , "Выгрузка запущена, можно продолжать работу");
    КонецЕсли;

    ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
    ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
    ПараметрыОжидания.ВыводитьСообщения = Истина;
    ПараметрыОжидания.ОтменятьПриЗакрытииФормыВладельца = Ложь;
    ПараметрыОжидания.ОповещениеПользователя.Показать = Истина;
    ПараметрыОжидания.ОповещениеПользователя.Текст = "Полная выгрузка остатков";
    ПараметрыОжидания.ОповещениеПользователя.Пояснение = "Выгрузка завершена";

    Оповещение = Новый ОписаниеОповещения("ПолнаяВыгрузкаОстатковЗавершение", ЭтотОбъект);
    ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ПолнаяВыгрузкаОстатковЗавершение(Результат, ДополнительныеПараметры) Экспорт

    Если Результат = Неопределено Или Результат.Статус <> "Ошибка" Тогда
        Возврат;
    КонецЕсли;

    Если СтрНачинаетсяС(Результат.КраткоеПредставлениеОшибки, "Задание с таким значением ключа уже выполняется") Тогда
        ОбщегоНазначенияКлиент.СообщитьПользователю("Полная выгрузка остатков уже выполняется");
        Возврат;
    КонецЕсли;

    СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);

КонецПроцедуры

&НаСервере
Функция ЗапуститьПолнуюВыгрузкуОстатковНаСервере()

    ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
    ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Полная выгрузка остатков";
    ПараметрыВыполнения.КлючФоновогоЗадания = "ПолнаяВыгрузкаОстатков_" + XMLСтрока(Объект.Вид);
    ПараметрыВыполнения.ЗапуститьВФоне = Истина;
    ПараметрыВыполнения.ОжидатьЗавершение = 0;

    Возврат ДлительныеОперации.ВыполнитьПроцедуру(
        ПараметрыВыполнения,
        "эв_ОбменСПорталамиСервер.ПолнаяВыгрузкаОстатков",
        Объект.Вид);

КонецФункции
&НаСервере
Процедура ОтправитьАптекуВСервисМегааптекаНаСервере(Удалить)
	// Вставить содержимое обработчика.  
	
	СтруктураОтвета = эвОбменСПорталамиСобытия.ПолучитьпараметрыПодключенияКПорталу(Объект.Вид, Объект.Активный);
	
	НастройкиВыгрузки = СтруктураОтвета.НастройкиВыгрузки;
	
    Для каждого Источник Из НастройкиВыгрузки Цикл
	
		Если ПустаяСтрока(Источник.Адрес) ИЛИ ПустаяСтрока(Источник.auth_token) ИЛИ ПустаяСтрока(Источник.merchant) Тогда 
			ОбщегоНазначения.СообщитьПользователю("Настройки API не указаны!");
			Продолжить;
		КонецЕсли;

		ЗаголовкиЗапросов = Новый Соответствие;
		ЗаголовкиЗапросов.Вставить("Content-Type", "application/json");
		ЗаголовкиЗапросов.Вставить("merchant-code", Источник.merchant);
		ЗаголовкиЗапросов.Вставить("auth-token",    Источник.auth_token);
		
		СтруктураПакета = ВернутьСтруктуруАптекиМегаптека(Удалить);
		
		Попытка   
			РезультатОбновления = КоннекторHTTP.PostJson(СокрЛП(Источник.Адрес)+"/stores", СтруктураПакета, Новый Структура("Заголовки", ЗаголовкиЗапросов)); 
		Исключение   
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки статуса Аптеки в %1", Источник.Адрес), УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		КонецПопытки;
		
		Если РезультатОбновления.Свойство("message") Тогда
			ОбщегоНазначения.СообщитьПользователю(РезультатОбновления.message);
		КонецЕсли;
		
		Если РезультатОбновления.КодСостояния = 200 Тогда 
			ОбщегоНазначения.СообщитьПользователю("Данные в сервисе актуализированы!"); 
			Объект.Активный = Истина;
		Иначе	
			Объект.Активный = Ложь;
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки статуса Аптеки в %1", Источник.Адрес), УровеньЖурналаРегистрации.Ошибка, , , РезультатОбновления.message);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры
&НаСервере
Процедура ОтправитьАптекуВСервисЮтекаНаСервере(Удалить)
	// Вставить содержимое обработчика.  

	СтруктураОтвета = эвОбменСПорталамиСобытия.ПолучитьпараметрыПодключенияКПорталу(Объект.Вид, Объект.Активный);
	
	НастройкиВыгрузки = СтруктураОтвета.НастройкиВыгрузки;
	
    Для каждого Источник Из НастройкиВыгрузки Цикл
	
		Если ПустаяСтрока(Источник.Адрес) ИЛИ ПустаяСтрока(Источник.auth_token) ИЛИ ПустаяСтрока(Источник.merchant) Тогда 
			ОбщегоНазначения.СообщитьПользователю("Настройки API не указаны!");
			Продолжить;
		КонецЕсли;
		
		ЗаголовкиЗапросов = Новый Соответствие;
		ЗаголовкиЗапросов.Вставить("Content-Type", "application/json");
		ЗаголовкиЗапросов.Вставить("auth_token",    Источник.auth_token);
		
		// Отправим Аптеку
		СтруктураПакета = ВернутьСтруктуруАптекиЮтека(Удалить);
		
		Попытка   
			РезультатОбновления = КоннекторHTTP.PutJson(СокрЛП(Источник.Адрес)+"/stores?mc="+СокрП(Источник.merchant), СтруктураПакета, Новый Структура("Заголовки", ЗаголовкиЗапросов)); 
		Исключение   
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки Аптеки в %1", Источник.Адрес), УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		КонецПопытки;
		
		Если РезультатОбновления.Свойство("message") Тогда
			ОбщегоНазначения.СообщитьПользователю(РезультатОбновления.message);
			Возврат;
		КонецЕсли;
		
		Если РезультатОбновления.КодСостояния = 200 Тогда 
			ОбщегоНазначения.СообщитьПользователю("Данные в сервисе актуализированы!"); 
			Объект.Активный = Истина;
		Иначе	
			Объект.Активный = Ложь;
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки Аптеки в %1", Источник.Адрес), УровеньЖурналаРегистрации.Ошибка);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСтатусАптекиМегааптекаНаСервере()
	// Вставить содержимое обработчика.
	
	СтруктураОтвета = эвОбменСПорталамиСобытия.ПолучитьпараметрыПодключенияКПорталу(Объект.Вид, Объект.Активный);
	
	НастройкиВыгрузки = СтруктураОтвета.НастройкиВыгрузки;
	
	Для каждого Источник Из НастройкиВыгрузки Цикл
	
		Если ПустаяСтрока(Источник.Адрес) ИЛИ ПустаяСтрока(Источник.auth_token) ИЛИ ПустаяСтрока(Источник.merchant) Тогда 
			ОбщегоНазначения.СообщитьПользователю("Настройки API не указаны!");
			Продолжить;
		КонецЕсли;
		
		ЗаголовкиЗапросов = Новый Соответствие;
		ЗаголовкиЗапросов.Вставить("Content-Type", "application/json");
		ЗаголовкиЗапросов.Вставить("merchant-code", Источник.merchant);
		ЗаголовкиЗапросов.Вставить("auth-token",    Источник.auth_token);

		СтруктураПакета = Новый Структура("store_id", XMLСтрока(Объект.Склад));
		
	    Попытка   
			РезультатОбновления = КоннекторHTTP.GETJson(СокрЛП(Источник.Адрес)+"/stores", СтруктураПакета, Новый Структура("Заголовки", ЗаголовкиЗапросов)); 
		Исключение   
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка получения статуса Аптеки в %1", Источник.Адрес), УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		КонецПопытки;
		
		Если РезультатОбновления.КодСостояния = 200 Тогда
			Для каждого Структура Из РезультатОбновления.list Цикл
				МассивСтрок = Новый Массив;
				Для каждого Элемент Из Структура Цикл
					МассивСтрок.Добавить(Элемент.Ключ + " = " + Элемент.Значение);
				КонецЦикла;
				ОбщегоНазначения.СообщитьПользователю(СтрСоединить(МассивСтрок,Символы.ПС));
			КонецЦикла;
		Иначе	
			ЗаписьЖурналаРегистрации(СтрШаблон("Ошибка отправки статуса Аптеки в %1", Источник.Адрес), УровеньЖурналаРегистрации.Ошибка, , , РезультатОбновления.message);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьАптекуВСервис(Команда)   
	
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
	    ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите склад");
		Возврат;
	КонецЕсли;
	
	Если Объект.Вид = ПредопределенноеЗначение("Перечисление.эвВидыИсточниковЗаказа.МегаАптека") Тогда

&НаСервере
Функция ОтправитьФайлКаталогаНаСервере(Адрес)
	// Вставить содержимое обработчика.
	
	Возврат эвОбменСПорталамиСобытия.эв_ВыгрузитьКаталогДБФАсна(Адрес);

КонецФункции

&НаКлиенте
Процедура ОтправитьКаталогНаКлиенте(Результат, ДополнительныеПараметры = Неопределено) Экспорт

	Если Результат = КодВозвратаДиалога.Нет Тогда
		 Возврат;
	КонецЕсли;
	
	ПутьWinSCP = "C:\Program Files (x86)\WinSCP\WinSCP.exe";

	ФайлФТП = Новый Файл(ПутьWinSCP);
	Если НЕ ФайлФТП.Существует() Тогда
	    ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Для отправки каталога необходимо наличие установленной программы WinSCP в каталог %1", ПутьWinSCP));
		Возврат;
	КонецЕсли; 
	
	// В Адрес окажется файл во ВХ
	Адрес = ПоместитьВоВременноеХранилище(, УникальныйИдентификатор);
	
	ПарФТП = ОтправитьФайлКаталогаНаСервере(Адрес);
	
	Если ПарФТП = "" Тогда
	    ОбщегоНазначенияКлиент.СообщитьПользователю("В источнике заказов Асна не указан склад выгрузки остатков");
		Возврат;
	КонецЕсли; 

	НовоеИмяФайла = ПолучитьИмяВременногоФайла("dbf");
	ДД = ПолучитьИзВременногоХранилища(Адрес);
	ДД.Записать(НовоеИмяФайла);
	
	ТекстСценария = СтрШаблон("option batch abort
	|option confirm off
	|open sftp://%1:%2@%3 -hostkey=*
	|put -delete -rawtransfersettings[2] IgnorePermErrors=1 ReplaceInvalidChars=0 %4 \goods.dbf
	|exit", ПарФТП.ЛогинФТП, ПарФТП.ПарольФТП, ПарФТП.АдресФТП, НовоеИмяФайла);
	
	ИмяФайлаСценария = ПолучитьИмяВременногоФайла(".txt");
	ФайлСценария = Новый ТекстовыйДокумент;
	ФайлСценария.УстановитьТекст(ТекстСценария);
	ФайлСценария.Записать(ИмяФайлаСценария);
	
	Лог = ПолучитьИмяВременногоФайла(".log");
	
	Команда = """" + ПутьWinSCP + """ /ini=nul /console /script=""" + ИмяФайлаСценария + """" + " /log=""" + Лог + """"; 
	
	ЗапуститьПриложение(Команда,,Истина);
	
	ФайлЛог= Новый ТекстовыйДокумент;
	Попытка
		ФайлЛог.Прочитать(Лог, КодировкаТекста.UTF8);
	Исключение
	    ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ФайлЛог.Показать("Лог выгрузки файла на SFTP сервер портала", ФайлЛог);
	
	Объект.Комментарий = СтрШаблон("Отправка каталога %1", ТекущаяДата());
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры


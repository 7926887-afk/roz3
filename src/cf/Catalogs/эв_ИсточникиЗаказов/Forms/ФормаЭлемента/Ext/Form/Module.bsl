Функция ВернутьСтруктуруАптекиМегаптека(Удалить)
	
	СтруктураОтвета = Новый Структура("list");
	
	list = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МагазиныКонтактнаяИнформация.Значение КАК Значение,
		|	МагазиныКонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
		|	МагазиныКонтактнаяИнформация.Тип КАК Тип,
		|	МагазиныКонтактнаяИнформация.Вид КАК Вид,
		|	МагазиныКонтактнаяИнформация.АдресЭП КАК АдресЭП
		|ПОМЕСТИТЬ ВТ_КИ
		|ИЗ
		|	Справочник.Магазины.КонтактнаяИнформация КАК МагазиныКонтактнаяИнформация
		|ГДЕ
		|	МагазиныКонтактнаяИнформация.Ссылка = &Магазин
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_КИ.Значение КАК Значение,
		|	ВТ_КИ.Тип КАК Тип,
		|	ВТ_КИ.Вид КАК Вид
		|ИЗ
		|	ВТ_КИ КАК ВТ_КИ
		|ГДЕ
		|	ВТ_КИ.Тип = &ТипАдрес
		|	И ВТ_КИ.Вид = &ВидАдрес
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_КИ.НомерТелефона КАК НомерТелефона
		|ИЗ
		|	ВТ_КИ КАК ВТ_КИ
		|ГДЕ
		|	ВТ_КИ.Тип = &ТипТелефон
		|	И ВТ_КИ.Вид = &ВидТелефон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_КИ.АдресЭП КАК АдресЭП
		|ИЗ
		|	ВТ_КИ КАК ВТ_КИ
		|ГДЕ
		|	ВТ_КИ.Тип = &ТипЭП";
	
	Запрос.УстановитьПараметр("Магазин",    Объект.Склад.Магазин);
	Запрос.УстановитьПараметр("ТипАдрес",   Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("ВидАдрес",   Справочники.ВидыКонтактнойИнформации.ФактАдресМагазина);
	Запрос.УстановитьПараметр("ТипТелефон", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("ВидТелефон", Справочники.ВидыКонтактнойИнформации.ТелефонМагазина);
	Запрос.УстановитьПараметр("ТипЭП", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Телефон = "";
	ВыборкаТ = РезультатЗапроса[2].Выбрать();
	Пока ВыборкаТ.Следующий() Цикл
	    Телефон = ВыборкаТ.НомерТелефона;
	КонецЦикла;
	АдресЭП = "";
	ВыборкаЭП = РезультатЗапроса[3].Выбрать();
	Пока ВыборкаЭП.Следующий() Цикл
	    АдресЭП = ВыборкаЭП.АдресЭП;
	КонецЦикла;

	Выборка = РезультатЗапроса[1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураАдреса = УправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(Выборка.Значение, Выборка.Тип);
		
		Представление = СтруктураАдреса.value;
		Регион        = СтруктураАдреса.areaValue;
		Город         = ?(ПустаяСтрока(СтруктураАдреса.city), СтруктураАдреса.areaValue, СтруктураАдреса.city); 
		
		Адрес = Сред(Представление, СтрНайти(Представление, Город, НаправлениеПоиска.СКонца));
		Адрес = СтрЗаменить(Адрес,Город+",","");
		
		СтруктураАптеки = Новый Структура;
		СтруктураАптеки.Вставить("id",         XMLСтрока(Объект.Склад));
		СтруктураАптеки.Вставить("region",     Регион);
		СтруктураАптеки.Вставить("city",       Город);
		СтруктураАптеки.Вставить("address",    СокрЛП(Адрес));
		СтруктураАптеки.Вставить("brand",      "ЭВАЛАР");
		СтруктураАптеки.Вставить("latitude",   Объект.Широта);
		СтруктураАптеки.Вставить("longitude",  Объект.Долгота);
		СтруктураАптеки.Вставить("phone",      Телефон);
		СтруктураАптеки.Вставить("schedule",   Объект.ГрафикРаботы);
		СтруктураАптеки.Вставить("ogrn",       СокрЛП(Объект.Склад.Организация.ОГРН));
		СтруктураАптеки.Вставить("email",      АдресЭП);
		СтруктураАптеки.Вставить("is_deleted", Удалить);
		
		list.Добавить(СтруктураАптеки);
		
	КонецЦикла;
	
	СтруктураОтвета.list = list;
	
	Возврат СтруктураОтвета;
	
КонецФункции 

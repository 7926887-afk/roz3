
&НаСервере
Процедура ЗаполнитьОбъектыМетаданныхИзМакета(ИмяМакета)
	
	Макет = Справочники.эв_ОчередиPinkRabbitMQ.ПолучитьМакет(ИмяМакета);
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область());
	ТаблицаДанных = ПостроительЗапроса.Результат.Выгрузить();
	
	Объект.ОбъектыМетаданных.Очистить();
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаДанных.ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ОбъектыМетаданных.Добавить();
		НоваяСтрока.ОбъектМетаданных = СокрЛП(Строка(СтрокаДанных.ОбъектМетаданных));
		НоваяСтрока.ТочкаОбмена = СокрЛП(Строка(СтрокаДанных.ТочкаОбмена));
		НоваяСтрока.routing_key = СокрЛП(Строка(СтрокаДанных.routing_key));
		НоваяСтрока.Магазин = МагазинИзЗначенияМакета(СтрокаДанных.Магазин);
		
	КонецЦикла;
	
	Объект.ОбъектыМетаданных.Сортировать("ОбъектМетаданных");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВводГородаЗавершение(Город, ДополнительныеПараметры) Экспорт
    
    // 2. Проверка на пустое значение
    Если ПустаяСтрока(Город) Тогда
        Возврат;
    КонецЕсли;
    
 	Для каждого Стр Из Объект.ОбъектыМетаданных Цикл
		
		Если СтрНайти(Стр.ТочкаОбмена, "city_direct") > 0 ИЛИ СтрНайти(Стр.ТочкаОбмена, "global_direct") > 0 Тогда
		    Продолжить;
		КонецЕсли;
		
		Стр.routing_key = СтрШаблон("direct.%1.%2.centr", сокрЛП(Город), сокрлп(Объект.ИмяОчереди));
		
	
	КонецЦикла;
    
КонецПроцедуры

&НаСервере
Функция МагазинИзЗначенияМакета(ЗначениеМагазина)
	
	Если Не ЗначениеЗаполнено(ЗначениеМагазина) Тогда
		Возврат Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеМагазина) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
		Возврат ЗначениеМагазина;
	КонецЕсли;
	
	СтрокаЗначения = СокрЛП(Строка(ЗначениеМагазина));
	Магазин = Справочники.Магазины.НайтиПоКоду(СтрокаЗначения);
	Если ЗначениеЗаполнено(Магазин) Тогда
		Возврат Магазин;
	КонецЕсли;
	
	Возврат Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию(СтрокаЗначения, Истина);
	
КонецФункции
  
&НаКлиенте
Процедура ЗаполнитьДляУзла(Команда)
	
	ЗаполнитьОбъектыМетаданныхИзМакета("МетаданныеУзла");
	
	НачЗнач = "msk";
	
	ПоказатьВводСтроки(
        Новый ОписаниеОповещения("КомандаВводГородаЗавершение", ЭтотОбъект),
		НачЗнач,
        "Введите город. Пустая строка - отказ.",
        50
     );


КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДляЦБ(Команда)
	
	ЗаполнитьОбъектыМетаданныхИзМакета("МетаданныеЦБ");
	
КонецПроцедуры

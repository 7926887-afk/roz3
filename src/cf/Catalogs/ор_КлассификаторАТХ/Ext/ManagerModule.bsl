#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЭлементКлассификатора(ПараметрыДанных) Экспорт
	
	РезультатВозврат = Новый Структура;
	РезультатВозврат.Вставить("ВсеЭлементы", Новый Соответствие);
	РезультатВозврат.Вставить("КоличествоНовыхЭлементов", 0);
	РезультатВозврат.Вставить("КоличествоОбновленныхЭлементов", 0);
	РезультатВозврат.Вставить("МассивНовыхЭлементов", Новый Массив);
	
	ПараметрыПолучения = Новый Структура;
	ПараметрыПолучения.Вставить("ТаблицаЗначений"           , Новый ТаблицаЗначений);
	ПараметрыПолучения.Вставить("ПоискПоНаименованию"       , Истина);
	ПараметрыПолучения.Вставить("ПоискПоНаименованиюПодобно", Ложь);
	ПараметрыПолучения.Вставить("Дерево"                    , Новый ДеревоЗначений);
	ПараметрыПолучения.Вставить("ОбновлятьСуществующие"     , Ложь);
	
	ПараметрыПолучения.Вставить("ПоискПоНаименованиюИКоду", Ложь);
	ПараметрыПолучения.Вставить("ПоискПоКоду"             , Ложь);
	
	Если ПараметрыДанных <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыПолучения, ПараметрыДанных);
	КонецЕсли;
	
	Если ПараметрыПолучения.ТаблицаЗначений.Количество() = 0 Тогда
		Возврат РезультатВозврат;
	КонецЕсли;
	
	Если ПараметрыПолучения.ТаблицаЗначений.Колонки.Найти("КодРаздела") <> Неопределено Тогда
		ПараметрыПолучения.ПоискПоНаименованиюИКоду = ЗначениеЗаполнено(ПараметрыПолучения.ТаблицаЗначений[0]["КодРаздела"]);
		ПараметрыПолучения.ПоискПоНаименованию      = Ложь;
	КонецЕсли;
	
	Если ПараметрыПолучения.ТаблицаЗначений.Колонки.Найти("КодРаздела") = Неопределено Тогда
		ПараметрыПолучения.ТаблицаЗначений.Колонки.Добавить("КодРаздела", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(10)));
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Таблица.Наименование КАК Наименование,
	|	Таблица.КодРаздела КАК КодРаздела
	|ПОМЕСТИТЬ Таб
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.Наименование КАК Наименование,
	|	ЕСТЬNULL(Спр.Ссылка, ЗНАЧЕНИЕ(Справочник.ор_КлассификаторАТХ.ПустаяСсылка)) КАК Ссылка,
	|	Таб.КодРаздела КАК КодРаздела
	|ИЗ
	|	Таб КАК Таб
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ор_КлассификаторАТХ КАК Спр
	|		ПО (&ПоискПоНаименованиюИКоду
	|					И Таб.Наименование = Спр.Наименование
	|					И Таб.КодРаздела = Спр.КодРаздела
	|				ИЛИ &ПоискПоНаименованию
	|					И Таб.Наименование = Спр.Наименование
	|				ИЛИ &ПоискПоКоду
	|					И Таб.КодРаздела = Спр.КодРаздела
	|				ИЛИ &ПоискПоНаименованиюПодобно
	|					И Спр.Наименование ПОДОБНО ""%"" + Таб.Наименование + ""%"")");
	Запрос.УстановитьПараметр("Таблица"                   , ПараметрыПолучения.ТаблицаЗначений);
	Запрос.УстановитьПараметр("ПоискПоНаименованию"       , ПараметрыПолучения.ПоискПоНаименованию);
	Запрос.УстановитьПараметр("ПоискПоНаименованиюПодобно", ПараметрыПолучения.ПоискПоНаименованиюПодобно);
	Запрос.УстановитьПараметр("ПоискПоКоду"               , ПараметрыПолучения.ПоискПоКоду);
	Запрос.УстановитьПараметр("ПоискПоНаименованиюИКоду"  , ПараметрыПолучения.ПоискПоНаименованиюИКоду);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СоответсвиеЭлементов = Новый Соответствие;
	НайденыВсеЭлементы = Истина;
	Пока Выборка.Следующий() Цикл
		Если ПараметрыПолучения.ПоискПоНаименованиюИКоду ИЛИ ПараметрыПолучения.ПоискПоКоду Тогда
			СоответсвиеЭлементов.Вставить(Выборка.КодРаздела, Выборка.Ссылка);
		Иначе
			СоответсвиеЭлементов.Вставить(Выборка.Наименование, Выборка.Ссылка);
		КонецЕсли;
		
		Если Выборка.Ссылка.Пустая() Тогда
			НайденыВсеЭлементы = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	РезультатВозврат.ВсеЭлементы = СоответсвиеЭлементов;
	
	ОбновлятьСуществующие = ПараметрыПолучения.ОбновлятьСуществующие;
	Если НайденыВсеЭлементы И НЕ ОбновлятьСуществующие Тогда
		Возврат РезультатВозврат;
	КонецЕсли;
	
	// Формирование структуры реквизитов справочника.
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("Наименование");
	СтруктураДанных.Вставить("Родитель");
	
	Для Каждого Реквизит Из Метаданные.Справочники.ор_КлассификаторАТХ.Реквизиты Цикл
		СтруктураДанных.Вставить(Реквизит.Имя);
		
		Если ПараметрыПолучения.ТаблицаЗначений.Колонки.Найти(Реквизит.Имя) = Неопределено Тогда
			ПараметрыПолучения.ТаблицаЗначений.Колонки.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущийЭлемент Из РезультатВозврат.ВсеЭлементы Цикл
		
		СправочникСсылка = ТекущийЭлемент.Значение;
		Если НЕ СправочникСсылка.Пустая() И НЕ ОбновлятьСуществующие Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыПолучения.ПоискПоНаименованиюИКоду ИЛИ ПараметрыПолучения.ПоискПоКоду Тогда
			СтруктураПоиска = Новый Структура("КодРаздела", ТекущийЭлемент.Ключ);
		Иначе
			СтруктураПоиска = Новый Структура("Наименование", ТекущийЭлемент.Ключ);
		КонецЕсли;
		
		НайденныеСтроки = ПараметрыПолучения.Дерево.Строки.НайтиСтроки(СтруктураПоиска, Истина);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтруктураДанных, НайденныеСтроки[0]);
		Иначе
			НайденныеСтроки = ПараметрыПолучения.ТаблицаЗначений.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтруктураДанных, НайденныеСтроки[0]);
			КонецЕсли;
		КонецЕсли;
		
		Если СправочникСсылка.Пустая() Тогда
			СсылкаСправочника = СоздатьЭлементСлужебный(
				СтруктураДанных,
				СправочникСсылка,
				ОбновлятьСуществующие,
				РезультатВозврат
			);
			РезультатВозврат.ВсеЭлементы.Вставить(ТекущийЭлемент.Ключ, СсылкаСправочника);
			
			РезультатВозврат.МассивНовыхЭлементов.Добавить(СсылкаСправочника);
		Иначе
			СоздатьЭлементСлужебный(
				СтруктураДанных,
				СправочникСсылка,
				ОбновлятьСуществующие,
				РезультатВозврат);
			РезультатВозврат.КоличествоОбновленныхЭлементов = РезультатВозврат.КоличествоОбновленныхЭлементов + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатВозврат.КоличествоНовыхЭлементов = РезультатВозврат.МассивНовыхЭлементов.Количество();
	
	Возврат РезультатВозврат;
	
КонецФункции

Функция СоздатьЭлементСлужебный(Данные, СправочникСсылка, ОбновлятьСуществующие, РезультатВозврат)
	
	Если СправочникСсылка.Пустая() Тогда
		СправочникОбъект = Справочники.ор_КлассификаторАТХ.СоздатьЭлемент();
	Иначе
		СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СправочникОбъект, Данные);
	Если Данные.Родитель <> Неопределено Тогда
		Если Данные.Свойство("КодРаздела") И Не ПустаяСтрока(Данные.КодРаздела) Тогда
			СправочникОбъект.Родитель = Справочники.ор_КлассификаторАТХ.НайтиПоРеквизиту("КодРаздела", Данные.Родитель.КодРаздела);
			ТекущийКлючРодителя = Данные.Родитель.КодРаздела;
		Иначе
			СправочникОбъект.Родитель = Справочники.ор_КлассификаторАТХ.НайтиПоНаименованию(Данные.Родитель.Наименование);
			ТекущийКлючРодителя = Данные.Родитель.Наименование;
		КонецЕсли;
		
		ПустаяСсылка = СправочникОбъект.Родитель.Пустая();
		Если ПустаяСсылка ИЛИ ОбновлятьСуществующие Тогда
			СтруктураРодитель = Новый Структура;
			Для Каждого СвойствоСтруктуры Из Данные Цикл
				СтруктураРодитель.Вставить(СвойствоСтруктуры.Ключ);
			КонецЦикла;
			
			ЗаполнитьЗначенияСвойств(СтруктураРодитель, Данные.Родитель);
			
			СправочникОбъект.Родитель = СоздатьЭлементСлужебный(
				СтруктураРодитель,
				СправочникОбъект.Родитель,
				ОбновлятьСуществующие,
				РезультатВозврат
			);
			Если ПустаяСсылка Тогда
				
				РезультатВозврат.ВсеЭлементы.Вставить(ТекущийКлючРодителя, СправочникОбъект.Родитель);
				РезультатВозврат.МассивНовыхЭлементов.Добавить(СправочникОбъект.Родитель);
			Иначе
				РезультатВозврат.КоличествоОбновленныхЭлементов = РезультатВозврат.КоличествоОбновленныхЭлементов + 1;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		СправочникОбъект.Родитель = Справочники.ор_КлассификаторАТХ.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		СправочникОбъект.Записать();
		_Возврат = СправочникОбъект.Ссылка;
	Исключение
		_Возврат = Справочники.ор_КлассификаторАТХ.ПустаяСсылка();
	КонецПопытки;
	
	Возврат _Возврат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
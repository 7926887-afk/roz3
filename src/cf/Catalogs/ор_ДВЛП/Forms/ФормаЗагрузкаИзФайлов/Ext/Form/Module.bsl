
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("ПриОткрытииЗавершение", ЭтотОбъект));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФайлДанныхДействующиеВеществаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("ПодключениеРасширенияРаботыСФайламиЗавершение", ЭтотОбъект));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)
	
	ФайлНаДискеКлассификаторАТХ = Новый Файл(ФайлДанныхДействующиеВещества);
	Если НЕ ФайлНаДискеКлассификаторАТХ.Существует() ИЛИ ФайлНаДискеКлассификаторАТХ.ЭтоКаталог() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Файл данных с действующими веществами не существует'"),, НСтр("ru = 'Ошибка'"));
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("ФайлДанных", ФайлДанныхДействующиеВещества));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриОткрытииЗавершение(Подключено, ДополнительныеПараметры) Экспорт
	
	РасширениеРаботыСФайламиПодключено = Подключено;
	Если НЕ РасширениеРаботыСФайламиПодключено Тогда
		Элементы.ФайлДанныхДействующиеВещества.Видимость = Ложь;
		Элементы.ПредупреждениеЗагрузка.Видимость = Истина;
	Иначе
		Элементы.ФайлДанныхДействующиеВещества.Видимость = Истина;
		Элементы.ПредупреждениеЗагрузка.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключениеРасширенияРаботыСФайламиЗавершение(Подключено, ДополнительныеПараметры) Экспорт
	
	Если Не Подключено Тогда
		
		ПоказатьПредупреждение(Неопределено,НСтр("ru = 'Для данной операции необходимо установить расширение работы с файлами!'"));
		Возврат;
		
	КонецЕсли;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.ПолноеИмяФайла = ФайлДанныхДействующиеВещества;
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'ВЫБРАТЬ источник данных'");
	ДиалогВыбораФайла.Фильтр = НСтр("ru = 'Документ XML'") + " (*.xml)|*.xml";
	
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения(
		"ФайлДанныхДействующиеВеществаНачалоВыбораЗавершение",
		ЭтотОбъект,
		Новый Структура("Диалог", ДиалогВыбораФайла)));
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлДанныхДействующиеВеществаНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	ДиалогВыбораФайла = ДополнительныеПараметры.Диалог;
	
	Если НЕ (ВыбранныеФайлы <> Неопределено) Тогда
		Возврат;
	КонецЕсли;
	
	ФайлДанныхДействующиеВещества = ДиалогВыбораФайла.ПолноеИмяФайла;
	
КонецПроцедуры

#КонецОбласти


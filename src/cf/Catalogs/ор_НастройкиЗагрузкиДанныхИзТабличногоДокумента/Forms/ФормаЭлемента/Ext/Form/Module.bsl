Процедура ТаблицаЗагружаемыхРеквизитовЗначениеПоУмолчаниюОчистка(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
	Если ТекДанные <> Неопределено
		И ТекДанные.ДоступноеОписаниеТипов.Типы().Количество() > 1 Тогда
		СтандартнаяОбработка = Ложь;
		ТекДанные.ЗначениеПоУмолчанию = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовЗначениеПоУмолчаниюАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ТекДанные.ИмяРеквизита = "Родитель" Тогда
		
		ДанныеВыбораРодителя = ПолучитьДанныеВыбораРодителя(ТипЗнч(ТекДанные.ЗначениеПоУмолчанию), ПараметрыПолученияДанных, СтандартнаяОбработка);
		Если Не СтандартнаяОбработка Тогда
			ДанныеВыбора = ДанныеВыбораРодителя;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеВыбораРодителя(Тип, ПараметрыПолученияДанных, СтандартнаяОбработка = Истина)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	Если Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	Если Не ОбъектМетаданных.Иерархический
		Или ОбъектМетаданных.ВидИерархии <> Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ПустаяСтрока(ПараметрыПолученияДанных.СтрокаПоиска) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 5
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Таблица
		|ГДЕ
		|	Таблица.ЭтоГруппа");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура", ОбъектМетаданных.Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		ДанныеВыбора = Новый СписокЗначений;
		Пока Выборка.Следующий() Цикл
			ДанныеВыбора.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Иначе
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ЭтоГруппа", Истина);
		
		ПараметрыПолученияДанных.Отбор = ПараметрыОтбора;
		ПараметрыПолученияДанных.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы;
		
		ДанныеВыбора = Справочники[ОбъектМетаданных.Имя].ПолучитьДанныеВыбора(ПараметрыПолученияДанных);
	КонецЕсли;
	
	Возврат ДанныеВыбора;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаЗагружаемыхРеквизитовШапки

// Процедура - обработчик события "ПриАктивизацииСтроки"  табличного поля "ТаблицаЗагружаемыхРеквизитовШапки"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиПриАктивизацииСтроки(Элемент)
	
	// Проверка необходима для корректной работы при принудительном обновлении формы
	Если Элементы.ГруппаСтраницыНастройкиЗагрузки.ТекущаяСтраница = Элементы.ГруппаСтраницаНастройкиТабличнойЧасти Тогда
		Возврат;
	КонецЕсли;
	
	ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитовШапки);
	РазобратьсяСОформлениемСтрок();
	
КонецПроцедуры

// Процедура - обработчик события "ПередНачаломИзменения"  табличного поля "ТаблицаЗагружаемыхРеквизитовШапки"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиПередНачаломИзменения(Элемент, Отказ)
	
	ИндексТекущейСтроки = ТаблицаЗагружаемыхРеквизитовШапки.Индекс(Элемент.ТекущиеДанные);
	ТекущийЭлементИмя = Элемент.ТекущийЭлемент.Имя;
	РежимЗагрузкиИскать = Элемент.ТекущиеДанные.РежимЗагрузки = "Искать";
	
	Если ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиИскатьПо"
	 ИЛИ ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиСвязьПоВладельцу"
	 ИЛИ ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиСвязьПоТипу" Тогда
		СписокВыбора = ЗаполнитьСпискиВыбораШапка(ИндексТекущейСтроки, ТекущийЭлементИмя, РежимЗагрузкиИскать);
		Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
		Для Каждого СтрокаСписка Из СписокВыбора Цикл
			Элемент.ТекущийЭлемент.СписокВыбора.Добавить(СтрокаСписка.Значение, СтрокаСписка.Представление);
		КонецЦикла;
	КонецЕсли;
	
	Элементы.ТаблицаЗагружаемыхРеквизитовШапкиЗначениеПоУмолчанию.КнопкаВыбора = НЕ ТипЗНЧ(Элемент.ТекущиеДанные.ЗначениеПоУмолчанию) = Тип("Строка");
	
КонецПроцедуры


		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЧекККМ.Организация КАК Организация,
	ЧекККМ.СтруктурнаяЕдиница КАК Магазин,
	ЧекККМТовары.Номенклатура КАК Номенклатура,
	ЧекККМТовары.Характеристика КАК Характеристика,
	ЧекККМ.Дата КАК ДатаЧека,
	ЧекККМ.Ссылка КАК ЧекККМ,
	ЧекККМ.Ответственный КАК Ответственный,
	СпрНоменклатура.ЦеноваяГруппа КАК ЦеноваяГруппа
ПОМЕСТИТЬ ТаблицаПроданныхТоваров
ИЗ
	Документ.ЧекККМ КАК ЧекККМ
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Запасы КАК ЧекККМТовары
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
			ПО ЧекККМТовары.Номенклатура = СпрНоменклатура.Ссылка
		ПО ЧекККМ.Ссылка = ЧекККМТовары.Ссылка
ГДЕ
	ЧекККМТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЧекККМТовары.Ссылка.Проведен
	И ЧекККМТовары.Ссылка.Статус В(&amp;СтатусыЧекаККМ)

ИНДЕКСИРОВАТЬ ПО
	Организация,
	Магазин,
	Номенклатура,
	Характеристика,
	ДатаЧека
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ТаблицаПроданныхТоваров.ЧекККМ КАК ЧекККМ,
	ТаблицаПроданныхТоваров.Организация КАК Организация,
	ТаблицаПроданныхТоваров.Магазин КАК Магазин,
	ТаблицаПроданныхТоваров.Номенклатура КАК Номенклатура,
	ТаблицаПроданныхТоваров.Характеристика КАК Характеристика,
	МАКСИМУМ(ТаблицаПроданныхТоваров.ДатаЧека) КАК ДатаЧека,
	ЕСТЬNULL(ПоступлениеТоваровТовары.Цена, 0) КАК ЦенаПоставки,
	ТаблицаПроданныхТоваров.Ответственный КАК Ответственный,
	ТаблицаПроданныхТоваров.ЦеноваяГруппа КАК ЦеноваяГруппа
ПОМЕСТИТЬ ТаблицаЦеныНаМоментПродажи
ИЗ
	ТаблицаПроданныхТоваров КАК ТаблицаПроданныхТоваров
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная.Запасы КАК ПоступлениеТоваровТовары
		ПО ТаблицаПроданныхТоваров.Организация = ПоступлениеТоваровТовары.Ссылка.Организация
			И ТаблицаПроданныхТоваров.Магазин = ПоступлениеТоваровТовары.Ссылка.СтруктурнаяЕдиница
			И (ПоступлениеТоваровТовары.Номенклатура = ТаблицаПроданныхТоваров.Номенклатура)
			И (ПоступлениеТоваровТовары.Характеристика = ТаблицаПроданныхТоваров.Характеристика)
			И (ПоступлениеТоваровТовары.Ссылка.Дата &lt;= ТаблицаПроданныхТоваров.ДатаЧека)

СГРУППИРОВАТЬ ПО
	ТаблицаПроданныхТоваров.Организация,
	ТаблицаПроданныхТоваров.Магазин,
	ТаблицаПроданныхТоваров.Номенклатура,
	ТаблицаПроданныхТоваров.Характеристика,
	ЕСТЬNULL(ПоступлениеТоваровТовары.Цена, 0),
	ТаблицаПроданныхТоваров.ЧекККМ,
	ТаблицаПроданныхТоваров.Ответственный,
	ТаблицаПроданныхТоваров.ЦеноваяГруппа

ИНДЕКСИРОВАТЬ ПО
	Организация,
	Магазин,
	Номенклатура,
	Характеристика,
	ДатаЧека,
	ЦенаПоставки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТаблицаЦеныНаМоментПродажи.Номенклатура КАК Номенклатура,
	ТаблицаЦеныНаМоментПродажи.Характеристика КАК Характеристика,
	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) КАК Цена,
	МАКСИМУМ(ЦеныНоменклатуры.Период) КАК Период
ПОМЕСТИТЬ ЦенаИзРегистра
ИЗ
	ТаблицаЦеныНаМоментПродажи КАК ТаблицаЦеныНаМоментПродажи
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
		ПО (ЦеныНоменклатуры.ВидЦен = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ЦенаПоставщика))
			И ТаблицаЦеныНаМоментПродажи.Номенклатура = ЦеныНоменклатуры.Номенклатура
			И ТаблицаЦеныНаМоментПродажи.Характеристика = ЦеныНоменклатуры.Характеристика
			И (ЦеныНоменклатуры.Период &lt;= ТаблицаЦеныНаМоментПродажи.ДатаЧека)
ГДЕ
	ТаблицаЦеныНаМоментПродажи.ЦенаПоставки = 0

СГРУППИРОВАТЬ ПО
	ТаблицаЦеныНаМоментПродажи.Номенклатура,
	ТаблицаЦеныНаМоментПродажи.Характеристика,
	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ТаблицаЦеныНаМоментПродажи.ЧекККМ КАК ЧекККМ,
	ТаблицаЦеныНаМоментПродажи.Организация КАК Организация,
	ТаблицаЦеныНаМоментПродажи.Магазин КАК Магазин,
	ТаблицаЦеныНаМоментПродажи.Ответственный КАК Ответственный,
	ТаблицаЦеныНаМоментПродажи.Номенклатура КАК Номенклатура,
	ТаблицаЦеныНаМоментПродажи.ЦеноваяГруппа КАК ЦеноваяГруппа,
	ТаблицаЦеныНаМоментПродажи.Характеристика КАК Характеристика,
	ТаблицаЦеныНаМоментПродажи.ДатаЧека КАК ДатаЧека,
	ВЫРАЗИТЬ(ВЫБОР
			КОГДА ТаблицаЦеныНаМоментПродажи.ЦенаПоставки = 0
				ТОГДА ЦенаИзРегистра.Цена
			ИНАЧЕ ТаблицаЦеныНаМоментПродажи.ЦенаПоставки
		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК ЗакупочнаяЦена,
	ВЫРАЗИТЬ(ВЫБОР
			КОГДА ТаблицаЦеныНаМоментПродажи.ЦенаПоставки = 0
				ТОГДА ЦенаИзРегистра.Цена * ЧекККМТовары.Количество
			ИНАЧЕ ТаблицаЦеныНаМоментПродажи.ЦенаПоставки * ЧекККМТовары.Количество
		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаВЗакупочныхЦенах,
	ВЫРАЗИТЬ(ЧекККМТовары.Количество КАК ЧИСЛО(15, 2)) КАК Количество,
	ВЫРАЗИТЬ(ЧекККМТовары.Сумма / ЧекККМТовары.Количество КАК ЧИСЛО(15, 2)) КАК РозничнаяЦенаСоСкидкой,
	ВЫРАЗИТЬ(ЧекККМТовары.Сумма КАК ЧИСЛО(15, 2)) КАК Сумма,
	ВЫРАЗИТЬ(ЧекККМТовары.СуммаАвтоматическойСкидки КАК ЧИСЛО(15, 2)) КАК СуммаАвтоматическойСкидки,
	ВЫРАЗИТЬ(ЧекККМТовары.СуммаАвтоматическойСкидки + ЧекККМТовары.Сумма КАК ЧИСЛО(15, 2)) КАК СуммаБезСкидки,
	ВЫРАЗИТЬ(ЧекККМТовары.Сумма - ЕСТЬNULL(ТаблицаЦеныНаМоментПродажи.ЦенаПоставки, ЕСТЬNULL(ЦенаИзРегистра.Цена, 0)) * ЧекККМТовары.Количество КАК ЧИСЛО(15, 2)) КАК СуммаПрибыли,
	ВЫРАЗИТЬ((ЧекККМТовары.Сумма - ЕСТЬNULL(ТаблицаЦеныНаМоментПродажи.ЦенаПоставки, ЕСТЬNULL(ЦенаИзРегистра.Цена, 0)) * ЧекККМТовары.Количество) * (&amp;ПроцентБонуса / 100) КАК ЧИСЛО(15, 2)) КАК Бонус,
	ВЫРАЗИТЬ((ЧекККМТовары.Сумма - ЕСТЬNULL(ТаблицаЦеныНаМоментПродажи.ЦенаПоставки, ЕСТЬNULL(ЦенаИзРегистра.Цена, 0)) * ЧекККМТовары.Количество) * (&amp;ПроцентЗаведующей / 100) КАК ЧИСЛО(15, 2)) КАК ПроцентЗаведующей
ИЗ
	ТаблицаЦеныНаМоментПродажи КАК ТаблицаЦеныНаМоментПродажи
		ЛЕВОЕ СОЕДИНЕНИЕ ЦенаИзРегистра КАК ЦенаИзРегистра
		ПО ТаблицаЦеныНаМоментПродажи.Номенклатура = ЦенаИзРегистра.Номенклатура
			И ТаблицаЦеныНаМоментПродажи.Характеристика = ЦенаИзРегистра.Характеристика
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Запасы КАК ЧекККМТовары
		ПО ТаблицаЦеныНаМоментПродажи.ЧекККМ = ЧекККМТовары.Ссылка
			И ТаблицаЦеныНаМоментПродажи.Номенклатура = ЧекККМТовары.Номенклатура
			И ТаблицаЦеныНаМоментПродажи.Характеристика = ЧекККМТовары.Характеристика</query>
	</dataSet>
	<parameter>
		<name>ДатаНачала</name>

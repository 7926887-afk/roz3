		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЧекККМ.Ссылка КАК ДокументПродажи,
	ТаблицаТовары.Номенклатура КАК Номенклатура,
	ТаблицаТовары.Характеристика КАК Характеристика,
	СУММА(ТаблицаТовары.Количество) КАК Количество,
	ТаблицаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ЕСТЬNULL(НомераУпаковок.НомерКИЗ, "") КАК НомерКИЗ,
	ЕСТЬNULL(НомераУпаковок.ПолныйКодМаркировки, "") КАК ПолныйКодМаркировки
ПОМЕСТИТЬ ОсновныеДанные
ИЗ
	Документ.ЧекККМ.Запасы КАК ТаблицаТовары
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
		ПО ТаблицаТовары.Ссылка = ЧекККМ.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.ор_НомераУпаковок КАК НомераУпаковок
		ПО ТаблицаТовары.ор_ИдентификаторСтроки = НомераУпаковок.ИдентификаторСтроки
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		ПО ТаблицаТовары.Характеристика = ХарактеристикиНоменклатуры.Ссылка
ГДЕ
	ВЫБОР
			КОГДА &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ЧекККМ.Дата &gt;= &amp;НачалоПериода
			ИНАЧЕ ЧекККМ.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
		КОНЕЦ
	И НЕ ЧекККМ.ОперацияСДенежнымиСредствами
	И ЧекККМ.Проведен
	И ХарактеристикиНоменклатуры.ор_МаркируемыйТовар
{ГДЕ
	ЧекККМ.Организация.*,
	ТаблицаТовары.СтруктурнаяЕдиница.*}

СГРУППИРОВАТЬ ПО
	ТаблицаТовары.Номенклатура,
	ТаблицаТовары.Характеристика,
	ТаблицаТовары.ЕдиницаИзмерения,
	ЧекККМ.Ссылка,
	ЕСТЬNULL(НомераУпаковок.НомерКИЗ, ""),
	ЕСТЬNULL(НомераУпаковок.ПолныйКодМаркировки, "")
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ОсновныеДанные.НомерКИЗ КАК НомерКИЗ
ПОМЕСТИТЬ НомераПроданныхУпаковок
ИЗ
	ОсновныеДанные КАК ОсновныеДанные
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОсновныеДанные.НомерКИЗ КАК НомерУпаковки,
	ВЫБОР
		КОГДА СУММА(Доли.ДоляУпаковки) &gt;= 1
			ТОГДА 1
		ИНАЧЕ СУММА(Доли.ДоляУпаковки)
	КОНЕЦ КАК ДоляУпаковки
ПОМЕСТИТЬ ОстаткиДолейУпаковок
ИЗ
	НомераПроданныхУпаковок КАК ОсновныеДанные
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДолиУпаковокМДЛП КАК Доли
		ПО ОсновныеДанные.НомерКИЗ = Доли.НомерУпаковки

СГРУППИРОВАТЬ ПО
	ОсновныеДанные.НомерКИЗ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОсновныеДанные.НомерКИЗ КАК НомерУпаковки,
	ВЫБОР
		КОГДА СУММА(Доли.ДоляУпаковки) &gt;= 1
			ТОГДА 1
		ИНАЧЕ СУММА(Доли.ДоляУпаковки)
	КОНЕЦ КАК ДоляУпаковкиРеестра
ПОМЕСТИТЬ ОстаткиДолейУпаковокРеестра
ИЗ
	НомераПроданныхУпаковок КАК ОсновныеДанные
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеестрВыбытияУпаковокМДЛП КАК Доли
		ПО ОсновныеДанные.НомерКИЗ = Доли.НомерУпаковки
ГДЕ
	Доли.СтатусВыбытия &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СтатусыВыбытияУпаковокМДЛП.ОтклоненВыводИзОборота)

СГРУППИРОВАТЬ ПО
	ОсновныеДанные.НомерКИЗ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОсновныеДанные.НомерКИЗ КАК НомерУпаковки,
	ВЫБОР
		КОГДА ЕСТЬNULL(ОстаткиДолейУпаковок.ДоляУпаковки, 1) &gt; ЕСТЬNULL(ОстаткиДолейУпаковокРеестра.ДоляУпаковкиРеестра, 1)
			ТОГДА ЕСТЬNULL(ОстаткиДолейУпаковокРеестра.ДоляУпаковкиРеестра, 1)
		ИНАЧЕ ЕСТЬNULL(ОстаткиДолейУпаковок.ДоляУпаковки, 1)
	КОНЕЦ КАК ОстатокДоляУпаковки
ПОМЕСТИТЬ НомераУпаковок
ИЗ
	НомераПроданныхУпаковок КАК ОсновныеДанные
		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДолейУпаковок КАК ОстаткиДолейУпаковок
		ПО ОсновныеДанные.НомерКИЗ = ОстаткиДолейУпаковок.НомерУпаковки
		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДолейУпаковокРеестра КАК ОстаткиДолейУпаковокРеестра
		ПО ОсновныеДанные.НомерКИЗ = ОстаткиДолейУпаковокРеестра.НомерУпаковки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЧекККМПродажи.Дата КАК ДатаПродажи,
	ОсновныеДанные.ДокументПродажи КАК ДокументПродажи,
	ОсновныеДанные.Номенклатура КАК Номенклатура,
	ОсновныеДанные.Характеристика КАК Характеристика,
	ОсновныеДанные.Количество КАК Количество,
	ОсновныеДанные.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ОсновныеДанные.НомерКИЗ КАК НомерКИЗ,
	ЕдиницыИзмерения.ор_КоличествоПервичныхУпаковок КАК КоличествоПервичныхУпаковок,
	ОсновныеДанные.ПолныйКодМаркировки КАК ПолныйКодМаркировки,
	ЕдиницыИзмерения.ор_КоличествоПервичныхУпаковок - НомераУпаковок.ОстатокДоляУпаковки / ВЫБОР
		КОГДА ЕдиницыИзмерения.Коэффициент = 0
			ТОГДА 1
		ИНАЧЕ ЕдиницыИзмерения.Коэффициент
	КОНЕЦ КАК КоличествоОстаток
ИЗ
	ОсновныеДанные КАК ОсновныеДанные
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		ПО ОсновныеДанные.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМПродажи
		ПО ОсновныеДанные.ДокументПродажи = ЧекККМПродажи.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ НомераУпаковок КАК НомераУпаковок
		ПО ОсновныеДанные.НомерКИЗ = НомераУпаковок.НомерУпаковки
ГДЕ
	ЕдиницыИзмерения.ор_КоличествоПервичныхУпаковок &gt; 1
	И ОсновныеДанные.Количество &gt; 0</query>
	</dataSet>
	<calculatedField>
		<dataPath>ПроданныеДоли</dataPath>
		<expression>Формат(Количество, "ЧН=") + " / " + Формат(КоличествоПервичныхУпаковок, "ЧН=") </expression>
		<title xsi:type="v8:LocalStringType">


#Область ОписаниеПеременных

&НаКлиенте
Перем ВебКамера; // Экземпляр работы с камерой.

&НаКлиенте
Перем ДанныеИзменены; // Флаг, характеризующий изменение данных на этапе формы.

&НаКлиенте
Перем ПутьКВременномуФайлу; // Путь к файлу созданном на диске при фото с камерты.

&НаКлиенте
Перем ВременныйАдрес; // Путь к файлу, изпользуется на время создания изображения.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ор_ПрограммноеСозданиеЭлементовФорм.СоздатьЭлементыФормы(ЭтотОбъект);
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	Если НЕ Параметры.Свойство("СозданиеХарактеристики") Тогда
		ПередаваемыйОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	Иначе
		ПередаваемыйОбъект = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		Если Параметры.Свойство("ТекущаяНоменклатура") Тогда
			ПередаваемыйОбъект.Владелец = Параметры.ТекущаяНоменклатура;
		КонецЕсли;
	КонецЕсли;
	ДополнительныеПараметры.Вставить("Объект", ПередаваемыйОбъект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	Элементы.ГруппаИспользованияХарактеристик.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики");
	
	// Инициализация реквизитов
	ТекущееДействие = "ВыборРежима";
	ВебКамера       = Справочники.ПодключаемоеОборудование.ПустаяСсылка();
	
	ИспользоватьОтраслевогоПроизводителя = Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ор_Производитель") <> Неопределено;
	ИспользоватьПодключаемоеОборудование = УправлениеНебольшойФирмойПовтИсп.ИспользоватьПодключаемоеОборудование();
	ИспользованиеВебКамеры               = ИспользоватьПодключаемоеОборудование И ЗначениеЗаполнено(ВебКамера);
	
	// Инициализация отраслевых реквизитов
	ПриСозданииНаСервереОтраслевой();
	
	// Создание реквизитов и элементов формы
	СформироватьПараметрыИСоздатьРеквизиты();
	
	// Заполнение реквизитов по полученым параметрам
	Параметры.Свойство("Склад",                      Склад);
	Параметры.Свойство("Магазин",                    Магазин);
	Параметры.Свойство("ВызовИзСписка",              ВызовИзСписка);
	// ПоказыватьПолеВидЦены - При вызове обработки из документа "Установка цен номенклатуры"
	Параметры.Свойство("ПоказыватьПолеВидЦены",      ПоказыватьПолеВидЦены);
	Параметры.Свойство("ИмяТЧ",                      ИмяТЧ);
	Параметры.Свойство("ТекущаяНоменклатура",        ЭтотОбъект.Номенклатура);
	Параметры.Свойство("СозданиеТолькоНоменклатуры", СозданиеТолькоНоменклатуры);
	
	// Настройка элементов
	Элементы.ВидЦены.Видимость = ПоказыватьПолеВидЦены;
	
	Если ПоказыватьПолеВидЦены Тогда
		Элементы.ВидЦены.СписокВыбора.Очистить();
		Для Каждого Цена Из Параметры.ВидыЦен Цикл
			ИспользуемыеВидыЦен.Добавить(Цена.Ссылка,Цена.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	// Обработка дополнительных параметров, при вызовах не из списка
	Если СозданиеТолькоНоменклатуры Тогда
		РежимСоздания = 0;
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Номенклатура) Тогда 
		РежимСоздания = 1;
		
		// Для создания характеристики необязательно выполнять инициализацию всех параметров
		// поэтому устанавливаем только КатегорияНоменклатуры
		ЭтотОбъект.КатегорияНоменклатуры = ЭтотОбъект.Номенклатура.КатегорияНоменклатуры;
		ИспользуютсяХарактеристики = ИспользуютсяХарактеристикиНоменклатуры(ЭтотОбъект.Номенклатура, ЭтотОбъект.КатегорияНоменклатуры);
		ПроверятьЗаполнениеХарактеристики = ПроверятьЗаполнениеХарактеристики(ЭтотОбъект.Номенклатура, ЭтотОбъект.КатегорияНоменклатуры);
		Если ИспользуютсяХарактеристики Тогда
			ТекущееДействие = "СозданиеНоменклатуры";
			Элементы.СтраницыЭтапов.ТекущаяСтраница = Элементы.СтраницаСозданиеНоменклатуры;
		Иначе
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДанныеИзменены = Ложь;
	
	Если СозданиеТолькоНоменклатуры ИЛИ ЗначениеЗаполнено(ЭтотОбъект.Номенклатура) Тогда
		Далее(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// ПодключаемоеОборудование
	Если ИспользованиеВебКамеры Тогда
		
		Описание = Новый ОписаниеОповещения("ОтключениеВидеокамерыЗавершение", ЭтотОбъект);
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоИдентификатору(Описание, ЭтотОбъект.УникальныйИдентификатор, ВебКамера);
		
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия="Запись_Файл" Тогда		
		СсылкаНаФайл = ?(ТипЗнч(Источник) = Тип("Массив"), Источник[0], Источник);
		Если ВыборИзображения Тогда
			ЗаписатьКартинкуНоменклатуры(СсылкаНаФайл);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	
	Если НЕ ЭтотОбъект.Свойства_ИспользоватьСвойства
		ИЛИ НЕ ЭтотОбъект.Свойства_ИспользоватьДопРеквизиты Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСправочника = "";
	Если ТекущееДействие = "СозданиеНоменклатуры" Тогда
		ИмяСправочника = "Номенклатура";
	ИначеЕсли ТекущееДействие = "СозданиеХарактеристики" Тогда
		ИмяСправочника = "ХарактеристикиНоменклатуры";
	КонецЕсли;

	Если ПустаяСтрока(ИмяСправочника) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОбъекта = СтруктураОбъектаМетаданных(ИмяСправочника);
	Префикс          = ?(ИмяСправочника = "ХарактеристикиНоменклатуры","Характеристика",ИмяСправочника);
	ЗаполнитьСтруктуруОбъекта(СтруктураОбъекта, Префикс);
	
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект,СтруктураОбъекта);
	ПриИзмененииРеквизита(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЦеныНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ИспользуемыеВидыЦен;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЦенникаПриИзменении(Элемент)
	
	Если НЕ Объект.ПечатьЦенника Тогда
		ОчиститьПараметрыПечати();
	КонецЕсли;
	УстановитьДоступностьПараметровПечати();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранятьЗначениеПриИзменении(Элемент, ИзмененоПользователем = Истина)
	
	ИмяРеквизита = СтрЗаменить(Элемент.Имя, "СохранятьЗначение", "");
	ЭлементРеквизита = Элементы[ИмяРеквизита];
	
	ЗначениеСохранения = ЭтотОбъект[Элемент.Имя];
	ЭлементРеквизита.ПропускатьПриВводе = ЗначениеСохранения;
	
	Если ИзмененоПользователем Тогда
		Если СохраненныеПользователемЭлементы.НайтиПоЗначению(ИмяРеквизита) = Неопределено Тогда
			СохраненныеПользователемЭлементы.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	ЗаполнитьРеквизитыВыбраннойНоменклатуры();
	НастроитьЭлементыПоЗаполненнымЗначениям();
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорияНоменклатурыПриИзменении(Элемент)
	
	ЗаполнитьРеквизитыВыбранногоКатегорииНоменклатуры();
	НастроитьЭлементыПоЗаполненнымЗначениям();
	ПриИзмененииРеквизита(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорияНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ОткрытьФорму("Справочник.КатегорииНоменклатуры.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизита(Элемент)
	
	Если ПриИзмененииРеквизитаНаСервере(Элемент.Имя) Тогда
		СохранятьЗначениеПриИзменении(Элементы["СохранятьЗначение" + Элемент.Имя], Ложь);
	КонецЕсли;
	
	ДанныеИзменены = Истина;
	ЭтотОбъект.Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииРеквизитаНаСервере(ИмяЭлемента)
	
	ОбновитьПараметрПравилНаименования(ИмяЭлемента);
	
	Возврат ОбновитьЗначениеСохранения(ИмяЭлемента);
	
КонецФункции

&НаКлиенте
Процедура ор_ПравилоНаименованияПриИзменении(Элемент)
	
	ор_ПравилоНаименованияПриИзмененииНаСервере(Элемент.Имя);
	УстановитьВидимостьНаименования();
	ПриИзмененииРеквизита(Элемент);
	ОбновитьАвтоОтметкуНеЗаполненногоВПараметрахПравил();
	
КонецПроцедуры

&НаСервере
Процедура ор_ПравилоНаименованияПриИзмененииНаСервере(ИмяЭлемента)
	
	СоздатьРеквизитыИПоляФормыПравила(ЭтоШаблонНаименованияХарактеристики(ИмяЭлемента));
	ЗаполнитьПараметрыПравилаИменованияСервер();
	ОбновитьЗначенияПравилНаименования();
	
КонецПроцедуры

&НаКлиенте
Процедура ор_ПравилоНаименованияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДляХарактеристики = ЭтоШаблонНаименованияХарактеристики(Элемент.Имя);
	Если ДляХарактеристики Тогда
		Объект.НаборСвойств = ПолучитьНаборСвойствХарактеристик(ЭтотОбъект.КатегорияНоменклатуры);
	Иначе
		Объект.НаборСвойств = ПолучитьНаборСвойств(ЭтотОбъект.КатегорияНоменклатуры);
	КонецЕсли;
	ВидНаименования = ВидНаименованияШаблонаНаименований(Элемент.Имя);
	
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("ПометкаУдаления", Ложь);
	СтруктураОтбора.Вставить("КатегорияНоменклатуры", ЭтотОбъект.КатегорияНоменклатуры);
	СтруктураОтбора.Вставить("ДляХарактеристики", ДляХарактеристики);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("НаборСвойств", Объект.НаборСвойств);
	ПараметрыОткрытия.Вставить("Отбор", СтруктураОтбора);
	ПараметрыОткрытия.Вставить("ТекущаяСтрока", ЭтотОбъект[Элемент.Имя]);
	ПараметрыОткрытия.Вставить("ВидНаименования", ВидНаименования);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуВыбораПравилЗавершение", ЭтотОбъект, Элемент.Имя);
	ОткрытьФорму("Справочник.ШаблоныНаименований.ФормаВыбора", ПараметрыОткрытия, ЭтотОбъект,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ор_ПравилоНаименованияСоздание(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметровОповещения = Новый Структура;
	СтруктураПараметровОповещения.Вставить("ИмяЭлемента", Элемент.Имя);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("КатегорияНоменклатуры", ЭтотОбъект.КатегорияНоменклатуры);
	ПараметрыОткрытия.Вставить("ВидНаименования", ВидНаименованияШаблонаНаименований(Элемент.Имя));
	ПараметрыОткрытия.Свойство("ДляХарактеристики", ЭтоШаблонНаименованияХарактеристики(Элемент.Имя));
	
	ОткрытьФорму(
		"Справочник.ШаблоныНаименований.Форма.ФормаЭлемента",
		ПараметрыОткрытия,
		ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеИспользоватьХарактеристикиПриИзменении(Элемент)
	
	Если Не ИспользуютсяХарактеристики Тогда
		ПроверятьЗаполнениеХарактеристики = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ПолеПроверятьЗаполнениеХарактеристики",
		"Доступность",
		ИспользуютсяХарактеристики);
	
КонецПроцедуры

&НаКлиенте
Процедура ЖНВЛППриИзменении(Элемент)
	
	ПриИзмененииРеквизита(Элемент);
	
	ПроверитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИзготовленияПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаИзготовления) Тогда
		ЭтотОбъект.СрокХранения = 0;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СрокГодности) И ЭтотОбъект.ДатаИзготовления > ЭтотОбъект.СрокГодности Тогда
		Сообщение = НСтр("ru = 'Срок годности не может быть больше даты изготовления!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		ЭтотОбъект.СрокХранения = 0;
		ЭтотОбъект.СрокГодности = НачалоДня(ЭтотОбъект.ДатаИзготовления + ЭтотОбъект.СрокХранения * 86400);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СрокГодности) И ЗначениеЗаполнено(ЭтотОбъект.СрокХранения) Тогда
		ЭтотОбъект.СрокХранения = Цел((ЭтотОбъект.СрокГодности-НачалоДня(ЭтотОбъект.ДатаИзготовления)) / 86400);
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.СрокГодности) Тогда
		ЭтотОбъект.СрокХранения = Цел((ЭтотОбъект.СрокГодности-НачалоДня(ЭтотОбъект.ДатаИзготовления)) / 86400);
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.СрокХранения) Тогда
		ЭтотОбъект.СрокГодности=НачалоДня(ЭтотОбъект.ДатаИзготовления + ЭтотОбъект.СрокХранения * 86400);
	КонецЕсли;
	
	ПриИзмененииРеквизита(Элемент);
	ПриИзмененииРеквизита(Элементы.СрокГодности);
	
	Элементы.СрокГодности.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(ЭтотОбъект.СрокГодности);
	
КонецПроцедуры

&НаКлиенте
Процедура СрокХраненияПриИзменении(Элемент)
	
	ПриИзмененииРеквизита(Элемент);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаИзготовления) И ЗначениеЗаполнено(ЭтотОбъект.СрокГодности) Тогда
		ЭтотОбъект.СрокГодности=НачалоДня(ЭтотОбъект.ДатаИзготовления + ЭтотОбъект.СрокХранения * 86400);
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.ДатаИзготовления) Тогда
		ЭтотОбъект.СрокГодности=НачалоДня(ЭтотОбъект.ДатаИзготовления + ЭтотОбъект.СрокХранения * 86400);
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.СрокГодности) Тогда
		ЭтотОбъект.ДатаИзготовления=НачалоДня(ЭтотОбъект.СрокГодности - ЭтотОбъект.СрокХранения * 86400);
	Иначе
		ЭтотОбъект.СрокХранения = 0;
	КонецЕсли;
	
	ПриИзмененииРеквизита(Элементы.СрокГодности);
	Элементы.СрокГодности.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(ЭтотОбъект.СрокГодности);
	
КонецПроцедуры

&НаКлиенте
Процедура СрокГодностиПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.СрокГодности) Тогда
		ЭтотОбъект.СрокХранения = 0;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаИзготовления) И ЭтотОбъект.ДатаИзготовления > ЭтотОбъект.СрокГодности Тогда
		Сообщение = НСтр("ru = 'Срок годности не может быть больше даты изготовления!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		ЭтотОбъект.СрокХранения = 0;
		ЭтотОбъект.СрокГодности = НачалоДня(ЭтотОбъект.ДатаИзготовления + ЭтотОбъект.СрокХранения * 86400);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаИзготовления) И ЗначениеЗаполнено(ЭтотОбъект.СрокХранения) Тогда
		ЭтотОбъект.СрокХранения = Цел((ЭтотОбъект.СрокГодности-НачалоДня(ЭтотОбъект.ДатаИзготовления))/86400);
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.ДатаИзготовления) Тогда
		ЭтотОбъект.СрокХранения = Цел((ЭтотОбъект.СрокГодности-НачалоДня(ЭтотОбъект.ДатаИзготовления))/86400);
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.СрокХранения) Тогда
		ЭтотОбъект.ДатаИзготовления=НачалоДня(ЭтотОбъект.СрокГодности-ЭтотОбъект.СрокХранения*86400);
	КонецЕсли;
	
	Если ЭтотОбъект.СрокГодности < НачалоДня(ТекущаяДата()) Тогда
		Сообщение = НСтр("ru = '" + "Срок годности истек: " + Формат(ЭтотОбъект.СрокГодности,"ДФ=dd.MM.yyyy") + "'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
	КонецЕсли;
	
	ПриИзмененииРеквизита(Элемент);
	
	Элементы.СрокГодности.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(ЭтотОбъект.СрокГодности);
	
КонецПроцедуры

&НаКлиенте
Процедура СерияПроизводителяПриИзменении(Элемент)
	
	ПриИзмененииРеквизита(Элемент);
	Элементы.СерияПроизводителя.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(ЭтотОбъект.СерияПроизводителя);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Далее(Команда)
	
	ОчиститьСообщения();
	РежимОдиночногоСоздания     = РежимСоздания = 0;
	РежимВыбораНоменклатуры     = РежимСоздания = 1;
	РежимМножественногоСоздания = РежимСоздания = 2;
	
	Если ТекущееДействие = "ВыборРежима" Тогда
		Если Объект.ПечатьЦенника И НЕ ЗначениеЗаполнено(Шаблон) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран шаблон печати",, "Шаблон");
			Возврат;
		КонецЕсли;
		
		ТекущееДействие = "СозданиеНоменклатуры";
		
	ИначеЕсли ТекущееДействие = "СозданиеНоменклатуры" Тогда
		
		Если РежимВыбораНоменклатуры Тогда
			Если Не ЗначениеЗаполнено(ЭтотОбъект.Номенклатура) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрана номенклатура",, "Номенклатура");
				Возврат;
			КонецЕсли;
			
			Если Не ИспользуютсяХарактеристики Тогда
				ПоказатьПредупреждение(,"Для данной номенклатуры не используются характеристики.",,
					"Ошибка выполнения");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если СоздаватьИзображения И ЕстьОшибкиПараметровНоменклатуры() Тогда
			Возврат;
		КонецЕсли;
		
		Если Не РежимВыбораНоменклатуры И Не СоздаватьИзображения Тогда
			НоменклатураСоздана = СоздатьНоменклатуру();
			
			Если Не НоменклатураСоздана Тогда
				Возврат;
			КонецЕсли;
			
			ТекстСообщения = НСтр(СтрШаблон("ru = 'Номенклатура <%1> успешно создана!'", ЭтотОбъект.Номенклатура));
			ПоказатьОповещениеПользователя("Создание номенклатуры",,ТекстСообщения);
		КонецЕсли;
		
		Если Не РежимВыбораНоменклатуры И СоздаватьИзображения Тогда
			ТекущееДействие = "СозданиеИзображения";
		Иначе
			ПереходССозданияНоменклатуры();
		КонецЕсли;
		
	ИначеЕсли ТекущееДействие = "СозданиеИзображения" Тогда
		
		Если Не СоздатьНоменклатуру() Тогда
			ПослеЗакрытияВопросаНазад(,);
			Возврат;
		КонецЕсли;
		
		ТекстСообщения = НСтр(СтрШаблон("ru = 'Номенклатура <%1> успешно создана!'", ЭтотОбъект.Номенклатура));
		ПоказатьОповещениеПользователя("Создание номенклатуры",, ТекстСообщения);
	
		Если ЗначениеЗаполнено(АдресИзображения) И ЭтоАдресВременногоХранилища(АдресИзображения) Тогда
			ДобавитьИзображениеВХранилище();
			ИзображениеОчистить(Истина);
		КонецЕсли;
		
		ПереходССозданияНоменклатуры();
		
	ИначеЕсли ТекущееДействие = "СозданиеХарактеристики" Тогда
		Если СоздатьХарактеристику() Тогда
			ТекстСообщения = НСтр(СтрШаблон("ru = 'Характеристика <%1> успешно создана!'", ЭтотОбъект.Характеристика));
			ПоказатьОповещениеПользователя("Создание характеристики",,ТекстСообщения);
			
			ОчиститьРеквизитыИОбновитьПравила();
			ОбновитьАвтоОтметкуНеЗаполненногоВПараметрахПравил();
			
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеИзменены = Ложь;
	НастроитьЭлементыПоШагу();
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	Если ТекущееДействие <> "СозданиеИзображения" Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаНазад", ЭтотОбъект);
		ПоказатьВопросИзмененныхДанных(Оповещение);
	Иначе
		ПослеЗакрытияВопросаНазад(,);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаНазад(Результат, Параметры) Экспорт
	
	ДанныеИзменены = Ложь;
	РежимМножественногоСоздания = РежимСоздания = 2;
	Если РежимМножественногоСоздания И ТекущееДействие = "СозданиеХарактеристики" Тогда
		
		ТекущееДействие = "СозданиеНоменклатуры";
		ОчиститьРеквизитыИПерезаписатьПравила(Истина, Ложь, Истина, Ложь, Истина);
		ОбновитьАвтоОтметкуНеЗаполненногоВПараметрахПравил();
		
	ИначеЕсли ТекущееДействие = "СозданиеИзображения" Тогда
		
		ТекущееДействие = "СозданиеНоменклатуры";
		
	Иначе
		
		ТекущееДействие = "ВыборРежима";
		
		ОчиститьРеквизитыИОбновитьПравила(Истина);
		СохраненныеПользователемЭлементы.Очистить();
		
	КонецЕсли;
	
	НастроитьЭлементыПоШагу();
	
КонецПроцедуры

&НаКлиенте
Процедура Готово(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаГотово", ЭтотОбъект);
	ПоказатьВопросИзмененныхДанных(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаГотово(Результат, Параметры) Экспорт
	
	ЭтотОбъект.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеОткрытьНаДиске(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.ПолноеИмяФайла = "";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Выберите изображение для загрузки";
	Диалог.Фильтр = РаботаСФайламиУНФКлиентСервер.ФильтрФайловИзображений();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьДиалогВыбораФайлаЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// Если ЭтоАдресВременногоХранилища(АдресИзображения) Тогда
	//    ИзображениеПосмотреть(Неопределено);
	// Иначе
	ИзображениеОткрытьНаДиске(Неопределено);
	// КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеОчистить(Команда)
	
	Если ЭтоАдресВременногоХранилища(АдресИзображения) Тогда
		УдалитьИзВременногоХранилища(АдресИзображения);
	КонецЕсли;
	АдресИзображения = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеПолучитьСКамеры(Команда)
	
	#Если ВебКлиент Тогда
		ОписаниеОшибки = НСтр("ru='Система  управления оборудование не поддерживает работу в режиме Web-клиента.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Возврат;
	#КонецЕсли
	
	// ToDo:
	// Убрать когда появитсья интеграция камеры.
	Возврат;
	Если ИспользованиеВебКамеры Тогда
		
		Контекст = Новый Структура;
		Контекст.Вставить("Форма", ЭтотОбъект);
		Контекст.Вставить("АдресФото", "");
		
		ОписаниеОповещения = Новый ОписаниеОповещения("НачатьПолучениеФотоЗавершение", ЭтотОбъект, Контекст);
		
		//ор_ФотоВидеофиксацияКлиент.НачатьПолучениеФото(ОписаниеОповещения, ЭтотОбъект.УникальныйИдентификатор, Ложь);
	Иначе
		
		ОписаниеОшибки = НСтр("ru='Укажите веб-камеру для фото номенклатуры.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Возврат;
		
	КонецЕсли;
	
	Попытка
		Если Не ПустаяСтрока(Контекст.АдресФото) Тогда
			АдресИзображения = Контекст.АдресФото;
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(,НСтр("ru = 'Не удалось получить изображение!'"));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеПосмотреть(Команда)
	
	Если ЗначениеЗаполнено(АдресИзображения) И ЭтоАдресВременногоХранилища(АдресИзображения) Тогда
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ОткрытьФорму("Обработка.ор_СозданиеНоменклатуры.Форма.ФормаПросмотраИзображения",, ЭтотОбъект,,,,,Режим);
	Иначе
		ТекстСообщения = НСтр("ru='""Файл картинки отсутствует"".'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СозданиеРеквизитовИЭлементов

// Процедура - Создать реквизиты и поля к ним по заданным параметрам
//
// Параметры:
//  МассивРеквизитов - Массив из Структура - Массив структур свойств реквизитов.
//                     Стандартную структуру можно получить в "ПолучитьШаблонСтандартногоРеквизита" 
//
&НаСервере
Процедура СоздатьРеквизитыИПоляФормы(МассивРеквизитов)
	
	// Пакетное создание реквизитов
	СоздаваемыеРеквизиты = Новый Массив;
	Для Каждого НовыйРеквизит Из МассивРеквизитов Цикл
		
		Реквизит = Новый РеквизитФормы(НовыйРеквизит.ИмяРеквизита, НовыйРеквизит.ТипРеквизита, , НовыйРеквизит.Заголовок, Истина);
		СоздаваемыеРеквизиты.Добавить(Реквизит);
		
		Если НовыйРеквизит.Сохраняемыйреквизит Тогда
			Реквизит = Новый РеквизитФормы("СохранятьЗначение" + НовыйРеквизит.ИмяРеквизита, Новый ОписаниеТипов("Булево"), , НовыйРеквизит.Заголовок, Истина);
			СоздаваемыеРеквизиты.Добавить(Реквизит);
		КонецЕсли;
		
		Если НовыйРеквизит.ЭтоПравилоНаименования Тогда
			Реквизит = Новый РеквизитФормы("ЗначениеНаименования" + НовыйРеквизит.ИмяРеквизита, Новый ОписаниеТипов("Строка"), , "", Истина); 
			СоздаваемыеРеквизиты.Добавить(Реквизит);
		КонецЕсли;
		
	КонецЦикла;
	ИзменитьРеквизиты(СоздаваемыеРеквизиты);
	
	Для Каждого НовыйРеквизит Из МассивРеквизитов Цикл
		
		Если Не НовыйРеквизит.СоздаватьЭлементНаФорме Тогда
			Продолжить;
		КонецЕсли;
		
		Если НовыйРеквизит.Сохраняемыйреквизит Тогда
			ГруппаСохранения = СоздатьЭлементыФормыСохраненияДанных(НовыйРеквизит.ИмяРеквизита, НовыйРеквизит.Группа);
			Элемент = Элементы.Вставить(НовыйРеквизит.ИмяРеквизита, Тип(НовыйРеквизит.ТипЭлемента), ГруппаСохранения, ГруппаСохранения.ПодчиненныеЭлементы[0]);
		Иначе
			Элемент = Элементы.Добавить(НовыйРеквизит.ИмяРеквизита, Тип(НовыйРеквизит.ТипЭлемента), НовыйРеквизит.Группа);
		КонецЕсли;
		
		// Создадим элемент формы связанный с созданным реквизитом, укажим его свойства.
		Если НовыйРеквизит.ЭтоПолеФлажка Тогда
			Элемент.Вид       = ВидПоляФормы.ПолеФлажка;
			Элемент.ВидФлажка = ВидФлажка.Выключатель;
		Иначе
			Элемент.Вид                      = ВидПоляФормы.ПолеВвода;
			Элемент.РастягиватьПоГоризонтали = Истина;
			Элемент.АвтоМаксимальнаяШирина   = Ложь;
			Элемент.КнопкаОткрытия           = НовыйРеквизит.КнопкаОткрытия;
			Элемент.КнопкаОчистки            = НовыйРеквизит.КнопкаОчистки;
			Элемент.КнопкаВыпадающегоСписка  = НовыйРеквизит.КнопкаВыпадающегоСписка;
			Элемент.КнопкаСпискаВыбора       = НовыйРеквизит.КнопкаСпискаВыбора;
			Элемент.КнопкаВыбора             = НовыйРеквизит.КнопкаВыбора;
			Элемент.ВыборГруппИЭлементов     = НовыйРеквизит.ВыборГруппИЭлементов;
			Элемент.ОтметкаНезаполненного    = НовыйРеквизит.ОтметкаНезаполненного;
			Элемент.РедактированиеТекста     = НовыйРеквизит.РедактированиеТекста;
		КонецЕсли;
		
		Элемент.Доступность          = НовыйРеквизит.Доступность;
		Элемент.Подсказка            = НовыйРеквизит.Подсказка;
		Элемент.ОтображениеПодсказки = НовыйРеквизит.ОтображениеПодсказки;
		Элемент.ПутьКДанным          = НовыйРеквизит.ИмяРеквизита;
		Элемент.ПропускатьПриВводе   = НовыйРеквизит.ПропускатьПриВводе;
		
		// Установим обработчики событий элемента, по указанным в настройках соответствиям.
		Для Каждого Событие Из НовыйРеквизит.ОбрабатываемыеСобытия Цикл
			Элемент.УстановитьДействие(Событие.Ключ,Событие.Значение);
		КонецЦикла;
		
		Если НовыйРеквизит.ЭтоПравилоНаименования Тогда
			ГруппаЗначения = Элементы.Добавить("ГруппаЗначение" + НовыйРеквизит.ИмяРеквизита, Тип("ГруппаФормы"), НовыйРеквизит.Группа);
			ГруппаЗначения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаЗначения.ОтображатьЗаголовок = Ложь;
			ГруппаЗначения.Объединенная        = Ложь;
			ГруппаЗначения.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			
			ИмяРеквизитаЗначения = "ЗначениеНаименования" + НовыйРеквизит.ИмяРеквизита;
			
			Элемент = Элементы.Добавить(ИмяРеквизитаЗначения, Тип("ПолеФормы"), ГруппаЗначения);
			Элемент.Вид                      = ВидПоляФормы.ПолеНадписи;
			Элемент.Доступность              = Истина;
			Элемент.Видимость                = Ложь;
			Элемент.РастягиватьПоГоризонтали = Истина;
			Элемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
			Элемент.АвтоМаксимальнаяШирина   = Ложь;
			Элемент.ПутьКДанным              = ИмяРеквизитаЗначения;
			Элемент.ЦветТекста               = ЦветаСтиля.ЦветТекстаФормы;
			Элемент.Шрифт                    = Новый Шрифт(, 8, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - Получить структуру стандартного реквизита для передачи в "СоздатьРеквизитыИПоляФормы" 
// 
// Возвращаемое значение:
// Структура - Структура стандартного реквизита
//
&НаСервере
Функция ПолучитьШаблонСтандартногоРеквизита()
	
	ПараметрыРеквизита = Новый Структура();
	ПараметрыРеквизита.Вставить("ИмяРеквизита",            "");
	ПараметрыРеквизита.Вставить("ПропускатьПриВводе",      Ложь);
	ПараметрыРеквизита.Вставить("Заголовок",               "");                           // Заголовок создаваемого реквизита, при создании элемента на форме будет отображен указанный заголовок
	ПараметрыРеквизита.Вставить("Подсказка",               "");
	ПараметрыРеквизита.Вставить("ОтображениеПодсказки",    ОтображениеПодсказки.Нет);
	ПараметрыРеквизита.Вставить("ВыборГруппИЭлементов",    ГруппыИЭлементы.Авто);         // Вид отображания и выбора(Элементы, группы, группы и элементы, авто)
	ПараметрыРеквизита.Вставить("Доступность",             Истина);
	ПараметрыРеквизита.Вставить("ТипРеквизита",            Новый ОписаниеТипов("Строка"));// Указывается тип создаваемого реквизита
	ПараметрыРеквизита.Вставить("Группа",                  ЭтотОбъект);                     // Группа(родитель), в которую будет помещен новый элемент.
	ПараметрыРеквизита.Вставить("РедактированиеТекста",    Истина);                       // Разрешение на ввод текста с клавиатуры в данном элементе
	ПараметрыРеквизита.Вставить("КнопкаОчистки",           Истина);
	ПараметрыРеквизита.Вставить("КнопкаВыпадающегоСписка", Истина);
	ПараметрыРеквизита.Вставить("КнопкаОткрытия",          Ложь);
	ПараметрыРеквизита.Вставить("КнопкаВыбора",            Истина);
	ПараметрыРеквизита.Вставить("КнопкаСпискаВыбора",      Ложь);
	ПараметрыРеквизита.Вставить("ОтметкаНезаполненного",   Ложь);
	ПараметрыРеквизита.Вставить("ОбрабатываемыеСобытия",   Новый Соответствие());          // Соответствие обрабатываемых событий элемента и их обработчиков
	ПараметрыРеквизита.Вставить("ТипЭлемента",             "ПолеФормы");                   // Тип элемента создаваемого на форме
	ПараметрыРеквизита.Вставить("СохраняемыйРеквизит",     Истина);                        // При указании данного флага, будет созданна подгруппа, в которую будет помещен создаваемый элемент и булево значение с префиксом "СохранятьЗначение"+имя реквизита. В дальнейшем используется для пропуска заполненных полей
	ПараметрыРеквизита.Вставить("СоздаватьЭлементНаФорме", Истина);                        // Используется, если требуется создать ТОЛЬКО реквизит, без его отображения на форме и флага сохранения.
	ПараметрыРеквизита.Вставить("ЭтоПравилоНаименования",  Ложь);
	ПараметрыРеквизита.Вставить("ЭтоПолеФлажка",           Ложь);
	
	Возврат ПараметрыРеквизита;
	
КонецФункции

&НаСервере
Процедура СформироватьПараметрыИСоздатьРеквизиты()
	
	// !СозданиеРеквизитов
	// Массив, в который добавляются шаблоны создаваемых реквизитов
	ПараметрыСоздаваемыхРеквизитов = Новый Массив();

	СформироватьСтандартныеРевизиты(ПараметрыСоздаваемыхРеквизитов);
	СформироватьОтраслевыеРеквизиты(ПараметрыСоздаваемыхРеквизитов);
	
	// Создадим реквизиты и элементы по заполненным настройкам.
	СоздатьРеквизитыИПоляФормы(ПараметрыСоздаваемыхРеквизитов);
	
	СоздатьДополнительныеСтандартныеЭлементы();
	СоздатьДополнительныеОтраслевыеЭлементы();
	
КонецПроцедуры


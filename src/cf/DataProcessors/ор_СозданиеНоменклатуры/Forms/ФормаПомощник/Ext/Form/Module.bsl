&НаКлиенте
Процедура НастроитьОтраслевыеЭлементыПоШагу()
	СозданиеНоменклатуры   = ТекущееДействие = "СозданиеНоменклатуры";
	СозданиеХарактеристики = ТекущееДействие = "СозданиеХарактеристики";
	
	// Происходит настройка видимости отраслевых элементов форм в зависимости от текущего действия
	Если СозданиеНоменклатуры Тогда
		Элементы.ЗарегистрированВСистемеМониторингаЦен.Доступность = ЭтотОбъект.ЖНВЛП;
	ИначеЕсли СозданиеХарактеристики Тогда
		ИспользуютсяСерии = ПолучитьФлагСерийногоУчета();
		Элементы.ГруппаПараметрыХарактеристики.Видимость = ИспользуютсяСерии;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыВыбраннойНоменклатурыОтраслевые()
	
	// Происходит заполнение реквизитов при изменении значения номенклатуры (только в режиме "ВыбораНоменклатуры")
	Если ИспользоватьОтраслевогоПроизводителя Тогда
		ЭтотОбъект.Производитель = ЭтотОбъект.Номенклатура.ор_Производитель;
	Иначе
		ЭтотОбъект.Производитель = ЭтотОбъект.Номенклатура.Производитель;
	КонецЕсли;
	
	ЭтотОбъект.ЖНВЛП                                 = ЭтотОбъект.Номенклатура.ор_ЖНВЛС;
	ЭтотОбъект.Яд                                    = ЭтотОбъект.Номенклатура.ор_Яд;
	ЭтотОбъект.НаркотическоеСредство                 = ЭтотОбъект.Номенклатура.ор_НаркотическоеСредство;
	ЭтотОбъект.МНН                                   = ЭтотОбъект.Номенклатура.ор_МНН;
	ЭтотОбъект.СМНН                                  = ЭтотОбъект.Номенклатура.ор_СМНН;
	ЭтотОбъект.ЕГК                                   = ЭтотОбъект.Номенклатура.ор_ЕГК;
	ЭтотОбъект.ФормаВыпуска                          = ЭтотОбъект.Номенклатура.ор_ФормаВыпуска;
	ЭтотОбъект.КодРосздравнадзора                    = ЭтотОбъект.Номенклатура.ор_КодРосздравнадзора;
	ЭтотОбъект.ЗарегистрированВСистемеМониторингаЦен = ЭтотОбъект.Номенклатура.ор_ЗарегистрированВСистемеМониторингаЦен;
	ЭтотОбъект.ОтпускПоРецепту                       = ЭтотОбъект.Номенклатура.ор_ОтпускПоРецепту;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыВыбранногоКатегорииНоменклатурыОтраслевые(МассивРеквизитовДляОбновления)
	
	// Происходит заполнение реквизитов связанных с видом номенклатуры, при её изменении
	// Названия изменённых реквизитов записываются в МассивРеквизитовДляОбновления
	// для дальнейшей настройки флажков "Сохранения значений"
	ИмяРеквизита = "Производитель";
	Если ИспользоватьОтраслевогоПроизводителя Тогда
		ИмяРеквизита = "ор_" + ИмяРеквизита;
	КонецЕсли;
	
	ЗначениеРеквизита = ЭтотОбъект.КатегорияНоменклатуры[ИмяРеквизита];
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		ЭтотОбъект.Производитель = ЗначениеРеквизита;
		МассивРеквизитовДляОбновления.Добавить("Производитель");
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ПодготовитьТоварыДляПечати()
	
	СтрокаТовара = ТаблицаТоваровБПОДляПечати.Добавить();
	СтрокаТовара.Выбран                 = Истина;
	СтрокаТовара.НоменклатураБПО        = ЭтотОбъект.Номенклатура;
	СтрокаТовара.ХарактеристикаБПО      = ЭтотОбъект.Характеристика;
	СтрокаТовара.ОрганизацияБПО         = ЭтотОбъект.ОрганизацияДляПечати;
	СтрокаТовара.ШаблонЦенникаЭтикетки  = Шаблон;
	СтрокаТовара.Количество             = 1;
	СтрокаТовара.УпаковкаБПО            = ЭтотОбъект.ЕдиницаИзмерения;
	СтрокаТовара.Цена                   = ?(ЗначениеЗаполнено(ЭтотОбъект.ЦенаХарактеристики), ЭтотОбъект.ЦенаХарактеристики, ЭтотОбъект.Цена);
	
	ДополнитьТоварыДляПечати();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаТоваровБПОДляПечати.Выгрузить());
	
КонецФункции


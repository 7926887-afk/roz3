&НаСервере
Процедура СоздатьДополнительныеСтандартныеЭлементы()
	
	ПервыйЭлемент = Элементы.СтраницаСозданиеХарактеристик.ПодчиненныеЭлементы[0];
	
	ПолеНоменклатуры = Элементы.Вставить(
		"ВыбраннаяНоменклатура",
		Тип("ПолеФормы"),
		Элементы.СтраницаСозданиеХарактеристик,
		ПервыйЭлемент);
	ПолеНоменклатуры.ПутьКДанным              = "Номенклатура";
	ПолеНоменклатуры.Вид                      = ВидПоляФормы.ПолеВвода;
	ПолеНоменклатуры.ТолькоПросмотр           = Истина;
	ПолеНоменклатуры.Заголовок                = НСтр("ru = 'Номенклатура'");
	ПолеНоменклатуры.Подсказка                = НСтр("ru = 'Номенклатура, для которой создаются характеристики'");
	ПолеНоменклатуры.АвтоМаксимальнаяШирина   = Ложь;
	ПолеНоменклатуры.РастягиватьПоГоризонтали = Истина;
	
	// Настройка созданных элементов
	Элементы.КатегорияНоменклатуры.АвтоОтметкаНезаполненного = Истина;
	Элементы.ЕдиницаИзмерения.АвтоОтметкаНезаполненного = Истина;
	
КонецПроцедуры

// Функция - Создать элементы формы сохранения данных. 
//           Внимание! Для оптимизации, реквизит для сохранения данных должен быть создан заранее.
//           Имя созданного реквизита сохранения должно быть получено из функции ПолучитьИмяСохраненияЗначения
//
// Параметры:
//  ИмяРеквизита - Строка - Имя реквизита для которого создаётся пометка сохранения данных. 
// 	Родитель     - ГруппаФормы, СтаницаФормы - Родительская группа или страница для создания элементов.
//
// Возвращаемое значение:
//  ГруппаФормы - Группа для вставки элемента реквизита.
//
&НаСервере
Функция СоздатьЭлементыФормыСохраненияДанных(ИмяРеквизита, Родитель)
	
	// Создадим новую группу в родительской, и переназначим указанную в настройках группу на новосозданную.
	Группа = Элементы.Добавить("Группа" + ИмяРеквизита, Тип("ГруппаФормы"), Родитель);
	Группа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.ОтображатьЗаголовок = Ложь;
	Группа.Объединенная        = Ложь;
	Группа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	
	// Добавляем поле флага, соответствующего созданному реквизиту
	Элемент = Элементы.Добавить("СохранятьЗначение" + ИмяРеквизита, Тип("ПолеФормы"), Группа);
	Элемент.Вид                             = ВидПоляФормы.ПолеФлажка;
	Элемент.ВидФлажка                       = ВидФлажка.Выключатель;
	Элемент.ПоложениеЗаголовка              = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Элемент.ГоризонтальноеПоложениеВГруппе	= ГоризонтальноеПоложениеЭлемента.Право;
	Элемент.ПутьКДанным                     = "СохранятьЗначение" + ИмяРеквизита;
	Элемент.Подсказка                       = НСтр("ru = 'Сохранить значения поля для создания следующего элемента.'");
	
	// Флаги заполняются автоматически при заполнении соответствующих им полей. Если требуется, пользователь снимает флаг вручную.
	Элемент.ПропускатьПриВводе = Истина;
	
	// Стандартный обработчик для всех флагов сохранения, используемый в механизме сохранения настроек шаблона.
	Элемент.УстановитьДействие("ПриИзменении","СохранятьЗначениеПриИзменении");
	
	Возврат Группа;
	
КонецФункции

#КонецОбласти

#Область НастройкаЭлементовФормы

// Процедура - Настроить свойства элементов формы в зависимости от текущего шага
//
&НаКлиенте
Процедура НастроитьЭлементыПоШагу()
	
	РежимВыбораНоменклатуры     = РежимСоздания = 1;
	РежимМножественногоСоздания = РежимСоздания = 2;
	
	СозданиеНоменклатуры   = ТекущееДействие = "СозданиеНоменклатуры";
	СозданиеХарактеристики = ТекущееДействие = "СозданиеХарактеристики";
	ВыборРежима            = ТекущееДействие = "ВыборРежима";
	СозданиеИзображения    = ТекущееДействие = "СозданиеИзображения";
	
	// Дополнительные реквизиты
	ОбновитьЭлементыДополнительныхРеквизитов();
	
	Элементы.Готово.Видимость = Истина;
	Элементы.Справка.Видимость = ВыборРежима;
	Если ВыборРежима Тогда
	   	Элементы.Назад.Видимость = Ложь;
		
		Элементы.Далее.Заголовок = НСтр("ru = 'Продолжить'");
		Элементы.Далее.Видимость = Истина;
		Элементы.Далее.Отображение = ОтображениеКнопки.Текст;
		
		Элементы.Готово.Заголовок = НСтр("ru = 'Отмена'");
		
		Элементы.ДекорацияЭтап.Заголовок = НСтр("ru = 'Шаг 1 из 3. Предварительная настройка'");
		
		Элементы.СтраницыЭтапов.ТекущаяСтраница = Элементы.СтраницаВыборРежима;
		
	ИначеЕсли СозданиеНоменклатуры Тогда
		Если РежимВыбораНоменклатуры Тогда
			Элементы.ДекорацияЭтап.Заголовок = НСтр("ru = 'Шаг 2 из 3. Выбор номенклатуры'");
		Иначе
			Элементы.ДекорацияЭтап.Заголовок = НСтр("ru = 'Шаг 2 из 3. Создание номенклатуры'");
		КонецЕсли;
		
		Элементы.Готово.Заголовок = НСтр("ru = 'Завершить'");
		
		Элементы.Назад.Заголовок   = НСтр("ru = 'Назад'");
		Элементы.Назад.Видимость   = НЕ СозданиеТолькоНоменклатуры;
		
		Элементы.Далее.Заголовок   = НСтр("ru = 'Создать и продолжить'");
		Элементы.Далее.Отображение = ОтображениеКнопки.КартинкаИТекст;
		Элементы.Далее.Видимость   = НЕ СозданиеТолькоНоменклатуры;
		
		Если Элементы.ГруппаПараметрыНоменклатуры.ТолькоПросмотр <> РежимВыбораНоменклатуры Тогда
			Элементы.ГруппаПараметрыНоменклатуры.ТолькоПросмотр = РежимВыбораНоменклатуры;
		КонецЕсли;
		
		Элементы.Номенклатура.Видимость = РежимВыбораНоменклатуры;
		
		Элементы.СтраницыЭтапов.ТекущаяСтраница = Элементы.СтраницаСозданиеНоменклатуры;
		
		УстановитьВидимостьСохранитьЗначение(РежимМножественногоСоздания);
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры) Тогда
			Элементы.ЕдиницаИзмерения.ТолькоПросмотр = Ложь;
			Элементы.СохранятьЗначениеЕдиницаИзмерения.ТолькоПросмотр = Ложь;
		КонецЕсли;
		
	ИначеЕсли СозданиеИзображения Тогда
		Элементы.СтраницыЭтапов.ТекущаяСтраница = Элементы.СтраницаСозданияИзображения;
		
	ИначеЕсли СозданиеХарактеристики Тогда
		Элементы.Далее.Заголовок = НСтр("ru = 'Создать и продолжить'");
		
		Если РежимМножественногоСоздания Тогда
			Элементы.Назад.Заголовок = НСтр("ru = 'Следующая номенклатура'");
		КонецЕсли;
		
		ХарактеристикиТолькоДляНоменклатуры = ИспользуютсяХарактеристики
			И Не ХарактеристикиИспользуютсяВКатегорииНоменклатуры(ЭтотОбъект.КатегорияНоменклатуры);
		Элементы.ГдеСоздаемХарактеристики.Доступность = Не ХарактеристикиТолькоДляНоменклатуры;
		Если ХарактеристикиТолькоДляНоменклатуры Тогда
			ГдеСоздаемХарактеристики = 0;
		КонецЕсли;
		
		Элементы.Готово.Заголовок = НСтр("ru = 'Завершить'");
		
		Элементы.ДекорацияЭтап.Заголовок = НСтр("ru = 'Шаг 3 из 3. Создание характеристик'");
		
		Элементы.СтраницыЭтапов.ТекущаяСтраница = Элементы.СтраницаСозданиеХарактеристик;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ПолеПроверятьЗаполнениеХарактеристики",
		"Доступность",
		ИспользуютсяХарактеристики);
	
	НастроитьОтраслевыеЭлементыПоШагу();
	НастроитьЭлементыПоЗаполненнымЗначениям();
	УстановитьФокусировкуНаЭлемент();
	ОбновитьАвтоОтметкуНеЗаполненногоВПараметрахПравил();
	
КонецПроцедуры

// Процедура - Настроить свойства элементов формы в зависимости от заполненных данных
//
&НаКлиенте
Процедура НастроитьЭлементыПоЗаполненнымЗначениям()
	
	РежимОдиночногоСоздания = РежимСоздания = 0;
	РежимВыбораНоменклатуры = РежимСоздания = 1;
	
	СозданиеНоменклатуры    = ТекущееДействие = "СозданиеНоменклатуры";
	СозданиеИзображения     = ТекущееДействие = "СозданиеИзображения";
	
	КатегорияНоменклатурыВыбран = ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры);
	
	УстановитьВидимостьНаименования();
	
	ТипНоменклатуры = ПолучитьТипНоменклатурыПоУмолчанию(ЭтотОбъект.КатегорияНоменклатуры);
	Если Не ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас")
		И Не ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга")
		И Не ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа") Тогда
		Элементы.ПолеИспользоватьХарактеристики.Доступность = Ложь;
	Иначе
		Элементы.ПолеИспользоватьХарактеристики.Доступность = Истина;
	КонецЕсли;
	
	Если СозданиеНоменклатуры Тогда
		Элементы.Группаор_ПравилоКраткогоНаименования.Доступность = КатегорияНоменклатурыВыбран;
		Элементы.Группаор_ПравилоПолногоНаименования.Доступность  = КатегорияНоменклатурыВыбран;
		
		Элементы.ЗначениеНаименованияор_ПравилоКраткогоНаименования.Видимость = 
			ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоКраткогоНаименования);
		Элементы.ЗначениеНаименованияор_ПравилоПолногоНаименования.Видимость  =
			ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоПолногоНаименования);
		
	КонецЕсли;
	
	Если (СозданиеНоменклатуры ИЛИ СозданиеИзображения) Тогда
		
		Если РежимВыбораНоменклатуры ИЛИ (СозданиеНоменклатуры И СоздаватьИзображения) Тогда
			ЗаголовокДалее = НСтр("ru = 'Продолжить'");
		ИначеЕсли КатегорияНоменклатурыВыбран И РежимОдиночногоСоздания 
			И (НЕ ИспользуютсяХарактеристики ИЛИ СозданиеТолькоНоменклатуры)
			И (НЕ СоздаватьИзображения ИЛИ СозданиеИзображения) Тогда
			ЗаголовокДалее = НСтр("ru = 'Создать и завершить'");
		Иначе
			ЗаголовокДалее = НСтр("ru = 'Создать и продолжить'");
		КонецЕсли;
		
		Элементы.Далее.Заголовок = ЗаголовокДалее;
	КонецЕсли;
	
	УстановитьВидимостьОтраслевыхРеквизитовНаСервере();
	
КонецПроцедуры

// Процедура - Установить видимость чек-боксам с сохранением значений
//
// Параметры:
//  Видимость	 - Булево - Требуемая видимость 
//
&НаКлиенте
Процедура УстановитьВидимостьСохранитьЗначение(Видимость)
	
	// В данном случае видимость этого элемента устанавивается только данной процедурой
	// и с целью оптимизации, выполняется проверка одного из элементов на совпадении видимости
	Если Элементы.СохранятьЗначениеКатегорияНоменклатуры.Видимость = Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Очередь = Новый Массив;
	Очередь.Добавить(Элементы.СтраницаСозданиеНоменклатуры);
	// Очередь.Добавить(Элементы.СтраницаСозданиеХарактеристик);
	Для Каждого Элемент Из Очередь Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ГруппаФормы") Тогда
			Для Каждого Потомок Из Элемент.ПодчиненныеЭлементы Цикл
				Очередь.Добавить(Потомок);
			КонецЦикла;
		ИначеЕсли ТипЭлемента = Тип("ПолеФормы") Тогда
			Если СтрНайти(Элемент.Имя, "СохранятьЗначение") Тогда
				Элемент.Видимость = Видимость;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	Если ТекущееДействие = "СозданиеНоменклатуры" Тогда 
		Если ЭтотОбъект.Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			// Создание фейкового объекта
			ПередаваемыйОбъект = Справочники.Номенклатура.СоздатьЭлемент();
			ПередаваемыйОбъект.КатегорияНоменклатуры = ЭтотОбъект["КатегорияНоменклатуры"];
		Иначе
			ПередаваемыйОбъект = ЭтотОбъект.Номенклатура.ПолучитьОбъект();
		КонецЕсли
	Иначе
		ПередаваемыйОбъект = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		
		ПередаваемыйОбъект.Владелец = ?(ГдеСоздаемХарактеристики = 1, ЭтотОбъект.КатегорияНоменклатуры, ЭтотОбъект.Номенклатура);
	КонецЕсли;
	
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект,ПередаваемыйОбъект,Истина);
	
	ЭлементыПеремещения = Новый Массив;
	ШрифтЗаголовка = Новый Шрифт("ШрифтЗаголовка", 10, Истина);
	Для Каждого Элемент Из Элементы.ГруппаДополнительныеРеквизиты.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			Элемент.ШрифтЗаголовка = ШрифтЗаголовка;
			Элемент.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаФормы;
		КонецЕсли;
		
		Если ТекущееДействие = "СозданиеХарактеристики" Тогда
			ЭлементыПеремещения.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из ЭлементыПеремещения Цикл
		Элементы.Переместить(Элемент, Элементы.ГруппаДополнительныеРеквизитыХарактеристики);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПравилаИменования

&НаКлиенте
Процедура ОткрытьФормуВыбораПравилЗавершение(Результат, ИмяЭлемента) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ЭтотОбъект[ИмяЭлемента] = Результат;
		ор_ПравилоНаименованияПриИзменении(Элементы[ИмяЭлемента]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоШаблонНаименованияХарактеристики(ИмяЭлемента)
	Возврат СтрНайти(НРег(ИмяЭлемента), "характеристики") > 0;
КонецФункции

&НаКлиенте
Функция ВидНаименованияШаблонаНаименований(ИмяЭлемента)
	
	ВидНаименования = ПредопределенноеЗначение("Перечисление.ВидыНаименованийОбъектов.НоменклатураРабочее");
	Если ИмяЭлемента = "ор_ПравилоНаименованияХарактеристики" 
		Или ИмяЭлемента = "ор_ПравилоНаименованияХарактеристикиДляПечати" Тогда
		ВидНаименования = ПредопределенноеЗначение("Перечисление.ВидыНаименованийОбъектов.ХарактеристикаРабочее");
	КонецЕсли;
	
	Возврат ВидНаименования;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьПараметрПравилНаименования(СтрокаПараметраПравила, Значение)
	
	СтрокаПараметраПравила.ДанныеПараметраСтрокой = Формат(Значение,"ДЛФ=Д; БЛ='Ложь'; БИ='" + СтрокаПараметраПравила.ИмяПараметра + "'");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПравилаИменованияСервер()
	
	// По умолчанию вид номенклатуры не добавляется
	ПоискКатегорииНоменклатуры = ПараметрыПравилаИменования.НайтиСтроки(Новый Структура("ИмяЭлемента,ПутьКДанным","КатегорияНоменклатуры","КатегорияНоменклатуры"));
	Если ПоискКатегорииНоменклатуры.Количество() = 0 Тогда 
		НоваяСтрока = ПараметрыПравилаИменования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Новый Структура("ДанныеПараметраСтрокой,ИмяПараметра,ИмяЭлемента,ПутьКДанным,ДляНоменклатуры",
			ЭтотОбъект.КатегорияНоменклатуры,
			"Категория номенклатуры",
			"КатегорияНоменклатуры",
			"КатегорияНоменклатуры"));
	КонецЕсли;
	
	Для Каждого СтрокаПараметр Из ПараметрыПравилаИменования Цикл
		НазваниеРеквизита = НайтиНазваниеРеквизитаПравилаНаименования(СтрокаПараметр.ПутьКДанным);
		Если НазваниеРеквизита <> Неопределено Тогда
			УстановитьПараметрПравилНаименования(СтрокаПараметр, ЭтотОбъект[НазваниеРеквизита]);
		Иначе
			СтрокаПараметр.ДанныеПараметраСтрокой = " ";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ОбновитьПараметрПравилНаименования(ИмяЭлемента)
	
	ПолеПравила = НайтиПараметрПравилаНаименования(ИмяЭлемента);
	Если ПолеПравила <> Неопределено Тогда
		ПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
		УстановитьПараметрПравилНаименования(ПолеПравила, ЭтотОбъект[ПутьКДанным]);
		ОбновитьЗначенияПравилНаименования();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗначенияПравилНаименования()
	
	НазванияРеквизитовПравил = Новый Массив;
	Если ТекущееДействие = "СозданиеНоменклатуры" Тогда
		СписокПараметров = ПолучитьСписокПараметровДляШаблона();
		
		НазванияРеквизитовПравил.Добавить("ор_ПравилоКраткогоНаименования");
		НазванияРеквизитовПравил.Добавить("ор_ПравилоПолногоНаименования");
	Иначе
		СписокПараметров = ПолучитьСписокПараметровДляШаблона(Истина);
		
		НазванияРеквизитовПравил.Добавить("ор_ПравилоНаименованияХарактеристики");
		НазванияРеквизитовПравил.Добавить("ор_ПравилоНаименованияХарактеристикиДляПечати");
	КонецЕсли;
	
	Для Каждого НазваниеРеквизита Из НазванияРеквизитовПравил Цикл
		НазваниеРевизитаЗначения = "ЗначениеНаименования" + НазваниеРеквизита;
		ЗначениеПравила = ЭтотОбъект[НазваниеРеквизита];
		Если Не ЗначениеЗаполнено(ЗначениеПравила) ИЛИ Не ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры) Тогда
			Элементы[НазваниеРевизитаЗначения].Видимость = Ложь;
		Иначе
			Элементы[НазваниеРевизитаЗначения].Видимость = Истина;
			ЭтотОбъект[НазваниеРевизитаЗначения] = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
				СписокПараметров,
				ЗначениеПравила.ШаблонДляФормирования);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПараметровДляШаблона(ДляХарактеристики = Ложь)
	
	СписокПараметров = Новый СписокЗначений;
	
	Для Каждого ТекущиеДанные Из ПараметрыПравилаИменования Цикл
		Если Не ДляХарактеристики И ТекущиеДанные.ДляНоменклатуры
			Или ДляХарактеристики И Не ТекущиеДанные.ДляНоменклатуры Тогда
			СписокПараметров.Добавить(ТекущиеДанные.ИмяПараметра, ТекущиеДанные.ДанныеПараметраСтрокой);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокПараметров;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПравилаНаименованияПоКатегорииНоменклатуры(ДляХарактеристик = Ложь)
	
	СтруктураОтборов = Новый Структура;
	
	СтруктураОтборов.Вставить("ДляХарактеристики", ДляХарактеристик);
	
	Если Не ДляХарактеристик Тогда
		СтруктураОтборов.Вставить("ВидНаименования", Перечисления.ВидыНаименованийОбъектов.НоменклатураРабочее);
		ТаблицаШаблонов = ШаблоныНаименованийПовтИсп.ШаблоныНаименованийКатегорииПоОтборам(ЭтотОбъект.КатегорияНоменклатуры, СтруктураОтборов);
		Если ТаблицаШаблонов.Количество() = 1 Тогда
			ЭтотОбъект.СохранятьЗначениеор_ПравилоКраткогоНаименования = Истина;
			ЭтотОбъект.ор_ПравилоКраткогоНаименования = ТаблицаШаблонов[0].Ссылка;
		Иначе
			ЭтотОбъект.СохранятьЗначениеор_ПравилоКраткогоНаименования = Ложь;
			ЭтотОбъект.ор_ПравилоКраткогоНаименования = Неопределено;
		КонецЕсли;
		
		СтруктураОтборов.Вставить("ВидНаименования", Перечисления.ВидыНаименованийОбъектов.НоменклатураДляПечати);
		ТаблицаШаблонов = ШаблоныНаименованийПовтИсп.ШаблоныНаименованийКатегорииПоОтборам(ЭтотОбъект.КатегорияНоменклатуры, СтруктураОтборов);
		Если ТаблицаШаблонов.Количество() = 1 Тогда
			ЭтотОбъект.СохранятьЗначениеор_ПравилоПолногоНаименования = Истина;
			ЭтотОбъект.ор_ПравилоПолногоНаименования = ТаблицаШаблонов[0].Ссылка;
		Иначе
			ЭтотОбъект.СохранятьЗначениеор_ПравилоПолногоНаименования = Ложь;
			ЭтотОбъект.ор_ПравилоПолногоНаименования = Неопределено;
		КонецЕсли;
	Иначе
		СтруктураОтборов.Вставить("ВидНаименования", Перечисления.ВидыНаименованийОбъектов.ХарактеристикаРабочее);
		ТаблицаШаблонов = ШаблоныНаименованийПовтИсп.ШаблоныНаименованийКатегорииПоОтборам(ЭтотОбъект.КатегорияНоменклатуры, СтруктураОтборов);
		Если ТаблицаШаблонов.Количество() = 1 Тогда
			ЭтотОбъект.СохранятьЗначениеор_ПравилоНаименованияХарактеристики = Истина;
			ЭтотОбъект.ор_ПравилоНаименованияХарактеристики = ТаблицаШаблонов[0].Ссылка;
		Иначе
			ЭтотОбъект.СохранятьЗначениеор_ПравилоНаименованияХарактеристики = Ложь;
			ЭтотОбъект.ор_ПравилоНаименованияХарактеристики = Неопределено;
		КонецЕсли;
		
		СтруктураОтборов.Вставить("ВидНаименования", Перечисления.ВидыНаименованийОбъектов.ХарактеристикаДляПечати);
		ТаблицаШаблонов = ШаблоныНаименованийПовтИсп.ШаблоныНаименованийКатегорииПоОтборам(ЭтотОбъект.КатегорияНоменклатуры, СтруктураОтборов);
		Если ТаблицаШаблонов.Количество() = 1 Тогда
			ЭтотОбъект.СохранятьЗначениеор_ПравилоНаименованияХарактеристикиДляПечати = Истина;
			ЭтотОбъект.ор_ПравилоНаименованияХарактеристикиДляПечати = ТаблицаШаблонов[0].Ссылка;
		Иначе
			ЭтотОбъект.СохранятьЗначениеор_ПравилоНаименованияХарактеристикиДляПечати = Ложь;
			ЭтотОбъект.ор_ПравилоНаименованияХарактеристикиДляПечати = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПараметровПравил()
	
	Результат = ПолучитьНезаполненныеПравилаНаименования();
	Для Каждого Элемент Из Результат.СписокДанных Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для правил наименования требуется заполнение поля ""%1"".", Элемент.ИмяПараметра),,
			Элемент.ИмяРеквизита);
	КонецЦикла;
	
	Возврат Результат.ЕстьНезаполненные;
	
КонецФункции

&НаСервере
Функция ПолучитьНезаполненныеПравилаНаименования() 
	
	Результат = Новый Структура("ЕстьНезаполненные, СписокДанных", Ложь, Новый Массив);
	Для Каждого ТекСтрока Из ПараметрыПравилаИменования Цикл
		
		// Проверка заполнения.
		Если НЕ (СозданиеНоменклатуры = ТекСтрока.ДляНоменклатуры) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрНайти(ТекСтрока.ПутьКданным, "ор_НаименованиеПоставщика") > 0 Тогда
			ТекСтрока.ДанныеПараметраСтрокой = " ";
		КонецЕсли;
		
		ТекЭлементФормы = Элементы.Найти(ТекСтрока.ИмяЭлемента);
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ДанныеПараметраСтрокой) И ТекСтрока.ДанныеПараметраСтрокой <> " " Тогда
			
			// Переопределение имени отраслевым именем
			ИмяРеквизита = НайтиНазваниеРеквизитаПравилаНаименования(ТекСтрока.ПутьКДанным);
			
			Если ИмяРеквизита <> Неопределено Тогда
				Результат.СписокДанных.Добавить(Новый Структура("ИмяРеквизита, ИмяПараметра", 
					ИмяРеквизита, ТекСтрока.ИмяПараметра));
				Результат.ЕстьНезаполненные = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ТекСтрока.ДанныеПараметраСтрокой = " " Тогда
			ТекСтрока.ДанныеПараметраСтрокой = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
Конецфункции

&НаСервереБезКонтекста
Функция ПолучитьНаборСвойств(КатегорияНоменклатуры)
	
	Возврат КатегорияНоменклатуры.НаборСвойств;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНаборСвойствХарактеристик(КатегорияНоменклатуры)
	
	Возврат КатегорияНоменклатуры.НаборСвойствХарактеристики;
	
КонецФункции

&НаСервере
Процедура СоздатьРеквизитыИПоляФормыПравила(ЭтоПараметрыДляХарактеристики = Ложь, ЭтоПереход = Ложь, СохранитьЗначения = Ложь)
	РежимМножественногоСоздания = РежимСоздания = 2;
	
	// Сохранение значений реквизитов перед удалением.
	Если СохранитьЗначения ИЛИ (РежимМножественногоСоздания И ЭтоПереход И ЭтоПараметрыДляХарактеристики) Тогда
		Для Каждого СтрокаПараметр Из ПараметрыПравилаИменования Цикл
			Если СтрокаПараметр.ПутьКДанным = "КатегорияНоменклатуры" Тогда 
				Продолжить;
			КонецЕсли;
			
			ИмяНаФорме = НайтиНазваниеРеквизитаПравилаНаименования(СтрокаПараметр.ПутьКДанным);
			ИмяНаФорме = ?(ИмяНаФорме = Неопределено, СтрокаПараметр.ПутьКДанным, ИмяНаФорме);
			ИмяФлагаЭлемента = ?(РеквизитСуществует("СохранятьЗначение" + ИмяНаФорме), ИмяНаФорме, СтрокаПараметр.ИмяЭлемента);
			Если РеквизитСуществует(ИмяНаФорме) 
				И РеквизитСуществует("СохранятьЗначение" + ИмяФлагаЭлемента)
				И ЭтотОбъект["СохранятьЗначение" + ИмяФлагаЭлемента] Тогда
				СписокВременныхПараметров.Добавить(ЭтотОбъект[ИмяНаФорме], ИмяНаФорме);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТекущаяКатегорияНоменклатуры = ?(ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры),
		ЭтотОбъект.КатегорияНоменклатуры,
		ЭтотОбъект.Номенклатура.КатегорияНоменклатуры);
	
	МассивПараметров = Новый Массив();
	// В шаблоне наименований не используються доп. свойства, а только доп. реквизиты.
	ТекущиеОписаниеДопРеквизитов = ?(ЭтотОбъект.Свойства_ИспользоватьСвойства, ЭтотОбъект.Свойства_ОписаниеДополнительныхРеквизитов, Неопределено);
	Если НЕ ЭтоПараметрыДляХарактеристики Тогда
		Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоКраткогоНаименования) Тогда
			ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
				МассивПараметров,
				ТекущаяКатегорияНоменклатуры,
				ЭтотОбъект.ор_ПравилоКраткогоНаименования,
				ТекущиеОписаниеДопРеквизитов);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоПолногоНаименования) Тогда
			ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
				МассивПараметров,
				ТекущаяКатегорияНоменклатуры,
				ЭтотОбъект.ор_ПравилоПолногоНаименования,
				ТекущиеОписаниеДопРеквизитов);
		КонецЕсли;
		
		ЛеваяГруппа  = Элементы.ГруппаПараметрыПравилаНаименованияЛевыйСтолбец;
		ПраваяГруппа = Элементы.ГруппаПараметрыПравилаНаименованияПравыйСтолбец;
	Иначе
		Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоНаименованияХарактеристики) Тогда
			ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
				МассивПараметров,
				ТекущаяКатегорияНоменклатуры,
				ЭтотОбъект.ор_ПравилоНаименованияХарактеристики,
				ТекущиеОписаниеДопРеквизитов);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоНаименованияХарактеристикиДляПечати) Тогда
			ШаблоныНаименований.ЗаполнитьМассивПараметровШаблонаНаименования(
				МассивПараметров,
				ТекущаяКатегорияНоменклатуры,
				ЭтотОбъект.ор_ПравилоНаименованияХарактеристикиДляПечати,
				ТекущиеОписаниеДопРеквизитов);
		КонецЕсли;
		
		ЛеваяГруппа  = Элементы.ГруппаПараметрыНаименованияХарактеристикиЛевыйСтолбец;
		ПраваяГруппа = Элементы.ГруппаПараметрыНаименованияХарактеристикиПравыйСтолбец;
	КонецЕсли;
	
	// Удаление старых реквизитов и элементов
	УдалитьРеквизитыИЭлементыПравилНаименования();
	
	// Создание новых реквизитов и элементов
	ШаблоныНаименований.ДобавитьРеквизитыИЭлементыНаФорму(ЭтотОбъект, ЛеваяГруппа, МассивПараметров);
	
	ЗаполнитьРеквизитыПравилаИменованияИзКэша();
	
	// Проверка на наличие дублей уже существующих элементов отраслевых реквизитов
	Для Каждого СтрокаПараметр Из ПараметрыПравилаИменования Цикл
		Если СтрокаПараметр.ПутьКДанным = "КатегорияНоменклатуры" Тогда
			Продолжить;
		КонецЕсли;
		
		СоответствиеНазванийПравилоКОтраслевому = ПолучитьСоответствиеРеквизитовПравилоКОтраслевому();
		Если СоответствиеНазванийПравилоКОтраслевому.Получить(СтрокаПараметр.ПутьКДанным) <> Неопределено Тогда
			Элемент = Элементы.Найти(СтрокаПараметр.ИмяЭлемента);
			Если Элемент <> Неопределено Тогда
				Элементы.Удалить(Элемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Создание реквизитов сохранять значение
	МассивКСозданию = Новый Массив;
	Для Каждого Элемент Из ЛеваяГруппа.ПодчиненныеЭлементы Цикл
		Реквизит = Новый РеквизитФормы("СохранятьЗначение" + Элемент.Имя, Новый ОписаниеТипов("Булево"), , "", Истина);
		МассивКСозданию.Добавить(Реквизит);
	КонецЦикла;
	ИзменитьРеквизиты(МассивКСозданию);
	
	// Создание элементов сохранять значение
	МассивКПеремещению = Новый Массив;
	Для Каждого Элемент Из ЛеваяГруппа.ПодчиненныеЭлементы Цикл 
		
		Группа = СоздатьЭлементыФормыСохраненияДанных(Элемент.Имя, ПраваяГруппа);
		
		Элемент.РастягиватьПоГоризонтали = Истина;
		Элемент.МаксимальнаяШирина = 0;

		Элемент.УстановитьДействие("ПриИзменении", "ПриИзмененииРеквизита");
		
		ЭлементФлажка = Группа.ПодчиненныеЭлементы[0];
		Если РежимСоздания <> 2 И РежимСоздания <> 1 Тогда
			ЭлементФлажка.Видимость = Ложь;
		КонецЕсли;
		
		МассивКПеремещению.Добавить(Новый Структура("НовыйЭлемент, Элемент, Родитель", Элемент, ЭлементФлажка, Группа));
	КонецЦикла;
	
	// Перемещение элементов правил в группы с сохранением значения
	Для Каждого Данные Из МассивКПеремещению Цикл
		Элементы.Переместить(Данные.НовыйЭлемент, Данные.Родитель, Данные.Элемент);
	КонецЦикла;
	
	// Балансировка элементов на обоих столбцах
	Если ПраваяГруппа.ПодчиненныеЭлементы.Количество() > 1 Тогда
		ПереместитьТекущий = Ложь;
		ЭлементыКПеремещению = Новый Массив;
		Для Каждого Элемент из ПраваяГруппа.ПодчиненныеЭлементы Цикл
			
			Если ПереместитьТекущий Тогда
				ЭлементыКПеремещению.Добавить(Элемент);
			КонецЕсли;
			Элемент.РастягиватьПоГоризонтали = Истина;
			
			ПереместитьТекущий = Не ПереместитьТекущий;
		КонецЦикла;
		
		Для Каждого Элемент Из ЭлементыКПеремещению Цикл
			Элементы.Переместить(Элемент, ЛеваяГруппа);
		КонецЦикла;
	ИначеЕсли ПраваяГруппа.ПодчиненныеЭлементы.Количество() = 1 Тогда
		Элемент = ПраваяГруппа.ПодчиненныеЭлементы[0];
		Элементы.Переместить(Элемент, ЛеваяГруппа);
	КонецЕсли;
	
	// Запись запомненных значений реквизитов
	Если СохранитьЗначения ИЛИ (РежимМножественногоСоздания И ЭтоПереход И Не ЭтоПараметрыДляХарактеристики) Тогда
		Для Каждого ЭлементСписка Из СписокВременныхПараметров Цикл
			ЕстьРеквизитПараметра = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ЭлементСписка.Представление);
			Если ЕстьРеквизитПараметра Тогда
				ЭтотОбъект[ЭлементСписка.Представление] = ЭлементСписка.Значение;
				Результат = ПараметрыПравилаИменования.НайтиСтроки(Новый Структура("ПутьКДанным", ЭлементСписка.Представление));
				Если Результат.Количество() > 0 Тогда
					ИмяЭлемента = Результат[0].ИмяЭлемента;
					ИмяФлагаСохранения = "СохранятьЗначение" + ИмяЭлемента;
					
					ЭтотОбъект[ИмяФлагаСохранения] = Истина;
					Элементы[ИмяЭлемента].ПропускатьПриВводе = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СписокВременныхПараметров.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПравилаИменованияИзКэша()
	
	Для Каждого ЭлементКэша Из КэшЗначенийРеквизитовПравилНаименования Цикл
		РеквизитОпределен = РеквизитСуществует(ЭлементКэша.ПутьКДанным);
		Если РеквизитОпределен Тогда
			ЭтотОбъект[ЭлементКэша.ПутьКДанным] = ЭлементКэша.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция УдалитьРеквизитыИЭлементыПравилНаименования()
	
	КэшЗначенийРеквизитовПравилНаименования.Очистить();
	
	МассивУдаляемыхРеквизитов = Новый Массив;
	Для Каждого СтрокаПараметр Из ПараметрыПравилаИменования Цикл
		
		Если СтрокаПараметр.ПутьКДанным = "КатегорияНоменклатуры" Тогда 
			Продолжить;
		КонецЕсли;
		
		РеквизитОпределен = РеквизитСуществует(СтрокаПараметр.ПутьКДанным);
		
		УдаляемыйЭлемент = Элементы.Найти(СтрокаПараметр.ИмяЭлемента);
		Если РеквизитОпределен И УдаляемыйЭлемент <> Неопределено Тогда
			МассивУдаляемыхРеквизитов.Добавить(СтрокаПараметр.ПутьКДанным);
			МассивУдаляемыхРеквизитов.Добавить("СохранятьЗначение" + СтрокаПараметр.ИмяЭлемента); 
			Элементы.Удалить(Элементы["Группа" + СтрокаПараметр.ИмяЭлемента]);
			
			Если ЗначениеЗаполнено(ЭтотОбъект[СтрокаПараметр.ПутьКДанным]) Тогда
				СтрокаКэша = КэшЗначенийРеквизитовПравилНаименования.Добавить();
				СтрокаКэша.ПутьКДанным 	= СтрокаПараметр.ПутьКДанным;
				СтрокаКэша.Значение 	= ЭтотОбъект[СтрокаПараметр.ПутьКДанным];
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
	ПараметрыПравилаИменования.Очистить();
	
КонецФункции

&НаСервере
Функция ПолучитьСоответствиеРеквизитовПравилоКОтраслевому()
	
	// Устанавливаем соответствие названий реквизитов данной формы и реквизитов в правиле решений.
	ПравилоКОтраслевому = Новый Соответствие;
	
	ПравилоКОтраслевому.Вставить("Номенклатура_Артикул", "Артикул");
	ПравилоКОтраслевому.Вставить("Номенклатура_ЦеноваяГруппа", "ЦеноваяГруппа");
	ПравилоКОтраслевому.Вставить("Номенклатура_ЕдиницаИзмерения", "ЕдиницаИзмерения");
	ПравилоКОтраслевому.Вставить("Номенклатура_Производитель", "Производитель");
	
	ДобавитьСоответствиеОтраслевыхРеквизитовПравилоКОтраслевому(ПравилоКОтраслевому);
	
	Возврат ПравилоКОтраслевому;
	
КонецФункции

&НаСервере
Функция ПолучитьСоответствиеРеквизитовОтраслевойКПравилу()
	
	// Устанавливаем соответствие названий реквизитов данной формы и реквизитов в правиле решений.
	ОтраслевыеНазванияРеквизитов = Новый Соответствие;
	
	ОтраслевыеНазванияРеквизитов.Вставить("Артикул", "Номенклатура_Артикул");
	ОтраслевыеНазванияРеквизитов.Вставить("ЦеноваяГруппа", "Номенклатура_ЦеноваяГруппа");
	ОтраслевыеНазванияРеквизитов.Вставить("ЕдиницаИзмерения", "Номенклатура_ЕдиницаИзмерения");
	ОтраслевыеНазванияРеквизитов.Вставить("Производитель", "Номенклатура_Производитель");
	
	ДобавитьСоответствиеОтраслевыхРеквизитовОтраслевойКПравилу(ОтраслевыеНазванияРеквизитов);
	
	Возврат ОтраслевыеНазванияРеквизитов;
	
КонецФункции

&НаСервере
Функция НайтиНазваниеРеквизитаПравилаНаименования(НазваниеРеквизита)
	
	СоответствиеНазванийПравилоКОтраслевому = ПолучитьСоответствиеРеквизитовПравилоКОтраслевому();
	ОтраслевоеНазвание = СоответствиеНазванийПравилоКОтраслевому.Получить(НазваниеРеквизита);
	Если ОтраслевоеНазвание <> Неопределено И РеквизитСуществует(ОтраслевоеНазвание) Тогда
		Возврат ОтраслевоеНазвание;
	ИначеЕсли РеквизитСуществует(НазваниеРеквизита) Тогда
		Возврат НазваниеРеквизита;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция НайтиПараметрПравилаНаименования(ИмяЭлементаФормы)
	
	ЭлементФормы = Элементы[ИмяЭлементаФормы];
	СоответствиеНазванийОтраслевойКПравилу = ПолучитьСоответствиеРеквизитовОтраслевойКПравилу();
	ПутьКДанным = СоответствиеНазванийОтраслевойКПравилу.Получить(ЭлементФормы.ПутьКДанным);
	Если ПутьКДанным = Неопределено Тогда
		ПутьКДанным = ЭлементФормы.ПутьКДанным;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("ПутьКДанным", ПутьКДанным);
	Результат = ПараметрыПравилаИменования.НайтиСтроки(ПараметрыОтбора);
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПерезаписатьПравилаНаименования(ЭтоПараметрыДляХарактеристики = Ложь, ЭтоПереход = Ложь, 
											ЗаполнятьПоКатегории = Истина, ЗаполнитьПараметры = Ложь, СохранитьЗначения = Ложь)
	
	Если ЗаполнятьПоКатегории Тогда
		ЗаполнитьПравилаНаименованияПоКатегорииНоменклатуры(ЭтоПараметрыДляХарактеристики);
	КонецЕсли;
	
	СоздатьРеквизитыИПоляФормыПравила(ЭтоПараметрыДляХарактеристики, ЭтоПереход, СохранитьЗначения);

	Если ЗаполнитьПараметры Тогда
		ЗаполнитьПараметрыПравилаИменованияСервер();
	КонецЕсли;
	
	ОбновитьЗначенияПравилНаименования();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНаименования()
	
	// Если правило краткого наименования не заполнено, тогда наименование заполняется из правила полного наименования.
	// Иначе наименование заполняется из поля "Наименование".
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоКраткогоНаименования)
		ИЛИ Не ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоКраткогоНаименования) И ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоПолногоНаименования) Тогда
		ЭтотОбъект.Наименование = "";
		Элементы.Наименование.Видимость = Ложь;
	Иначе
		Элементы.Наименование.Видимость = Истина;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоНаименованияХарактеристики) Тогда
		ЭтотОбъект.НаименованиеХарактеристики = "";
		Элементы.НаименованиеХарактеристики.Видимость = Ложь;
	Иначе
		Элементы.НаименованиеХарактеристики.Видимость = Истина;
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СозданиеНоменклатурыИХарактеристики

&НаКлиенте
Функция СоздатьНоменклатуру()
	
	Если ЕстьОшибкиПараметровНоменклатуры() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СоздатьНоменклатуруНаСервере() Тогда
		Если Объект.ПечатьЦенника Тогда
			Печать();
		КонецЕсли;
		
		Если Не ВызовИзСписка Тогда
			ДобавитьВДокумент();
		КонецЕсли;
		
		Оповестить("Запись_Номенклатура", ЭтотОбъект.Номенклатура);
		
	Иначе
		Возврат Ложь;
		ПоказатьПредупреждение(,"Произошли ошибки при создании данных!");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Создание номенклатуры по заполненым реквизитам
&НаСервере
Функция СоздатьНоменклатуруНаСервере()
	
	Результат = Истина;
	
	ЭтотОбъект.Характеристика = Неопределено;
	// !СозданиеНоменклатуры
	// Первичная запись номенклатуры
	НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
	
	НоваяНоменклатура.КатегорияНоменклатуры = ЭтотОбъект.КатегорияНоменклатуры;
	Если ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры) Тогда
		НоваяНоменклатура.ТипНоменклатуры = ЭтотОбъект.КатегорияНоменклатуры.ТипНоменклатурыПоУмолчанию;
	Иначе
		НоваяНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	КонецЕсли;
	КатегорииНоменклатурыСервер.ЗаполнитьСвойстваНоменклатурыПоКатегории(НоваяНоменклатура, Истина);
	ЗаполнитьЗначенияНоменклатурыПоУмолчанию(НоваяНоменклатура);
	
	НоваяНоменклатура.ИспользоватьХарактеристики        = ИспользуютсяХарактеристики;
	НоваяНоменклатура.ПроверятьЗаполнениеХарактеристики = ПроверятьЗаполнениеХарактеристики;
	
	НоваяНоменклатура.Родитель         = ЭтотОбъект.ГруппаНоменклатуры;
	НоваяНоменклатура.ЦеноваяГруппа    = ЭтотОбъект.ЦеноваяГруппа;
	НоваяНоменклатура.Артикул          = ЭтотОбъект.Артикул;
	НоваяНоменклатура.ЕдиницаИзмерения = ЭтотОбъект.ЕдиницаИзмерения;
	
	// Ставка НДС
	Если Не ЗначениеЗаполнено(НоваяНоменклатура.ВидСтавкиНДС) Тогда
		НоваяНоменклатура.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
	КонецЕсли;
	
	КлючВидовПродукции = Неопределено;
	ОписаниеНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(НоваяНоменклатура.КатегорияНоменклатуры)[НоваяНоменклатура.КатегорияНоменклатуры];
	Если Не ОписаниеНоменклатуры = Неопределено Тогда
		КлючВидовПродукции = ОписаниеНоменклатуры.КлючВидовПродукции;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючВидовПродукции) Тогда
		НоваяНоменклатура.ПризнакПредметаРасчета = РозничныеПродажиСервер.ПолучитьОжидаемыйПризнакПредметаРасчета(
			НоваяНоменклатура.ТипНоменклатуры,
			КлючВидовПродукции,
			НоваяНоменклатура.ВидМаркировки,
			НоваяНоменклатура.ПодакцизныйТовар,
			НоваяНоменклатура.ПродаетсяВРозлив);
		
		Если КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияВЕТИС(КлючВидовПродукции)
			И Не НоваяНоменклатура.ПодконтрольнаяПродукцияВЕТИС Тогда
			НоваяНоменклатура.ПодконтрольнаяПродукцияВЕТИС = Истина;
		КонецЕсли;
	КонецЕсли;
	
	НоваяНоменклатура.УстановитьНовыйКод();
	
	ЗаполнитьНоменклатуруОтраслевымиРеквизитамиПередЗаписью(НоваяНоменклатура);
	
	// Запись реквизитов из правила именования
	Для Каждого ТекРеквизит Из ПараметрыПравилаИменования Цикл
		ИмяРеквизита = ТекРеквизит.ПутьКДанным;
		Если ИмяРеквизита = "КатегорияНоменклатуры"
			 ИЛИ НЕ ТекРеквизит.ДляНоменклатуры
			 ИЛИ ТекРеквизит.ЭтоДопСведение
			 ИЛИ ТекРеквизит.ЭтоДопРеквизит Тогда
			// Доп реквизиты и сведения обрабатывае ниже
			Продолжить;
		КонецЕсли;
		
		ИмяНаФорме = НайтиНазваниеРеквизитаПравилаНаименования(ИмяРеквизита);
		ИмяНаФорме = ?(ИмяНаФорме = Неопределено, ИмяРеквизита, ИмяНаФорме);
		
		ИмяРеквизитаСправочника = СтрЗаменить(ИмяРеквизита, "Номенклатура_", "");
		
		НоваяНоменклатура[ИмяРеквизитаСправочника] = ЭтотОбъект[ИмяНаФорме];
		
	КонецЦикла;
	
	// Заполнение данных предопределенных в категории номенклатуры
	// Записаны только те реквизиты, что не были заполнены ранее
	СписокИменРеквизитовКатегории = Новый Массив;
	СписокИменРеквизитовКатегории.Добавить("СтранаПроисхождения");
	Для Каждого ИмяРеквизита Из СписокИменРеквизитовКатегории Цикл
		Если Не ЗначениеЗаполнено(НоваяНоменклатура[ИмяРеквизита])
				И ЗначениеЗаполнено(НоваяНоменклатура.КатегорияНоменклатуры[ИмяРеквизита]) Тогда
			НоваяНоменклатура[ИмяРеквизита] = НоваяНоменклатура.КатегорияНоменклатуры[ИмяРеквизита];
		КонецЕсли;
	КонецЦикла;
	
	// Заполнение Доп Реквизитов
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, НоваяНоменклатура);
	// Конец СтандартныеПодсистемы.Свойства
	
	// Получение наименований
	Если ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры) Тогда
		
		СписокПараметров = ПолучитьСписокПараметровДляШаблона();
		
		НоваяНоменклатура.НаименованиеПолное = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
			СписокПараметров,
			ЭтотОбъект.ор_ПравилоПолногоНаименования.ШаблонДляФормирования);
		НоваяНоменклатура.Наименование = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
			СписокПараметров,
			ЭтотОбъект.ор_ПравилоКраткогоНаименования.ШаблонДляФормирования);
		
		Если Не ЗначениеЗаполнено(НоваяНоменклатура.Наименование) Тогда 
			Если ЗначениеЗаполнено(НоваяНоменклатура.НаименованиеПолное) Тогда
				НоваяНоменклатура.Наименование = НоваяНоменклатура.НаименованиеПолное;
			Иначе
				НоваяНоменклатура.Наименование = ЭтотОбъект["Наименование"];
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		НоваяНоменклатура.Наименование = ЭтотОбъект["Наименование"];
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоваяНоменклатура.НаименованиеПолное) Тогда
		НоваяНоменклатура.НаименованиеПолное = НоваяНоменклатура.Наименование;
	КонецЕсли;
	
	Попытка
		// Перед записью доп сведений и вставок необходимо записать элемент.
		НоваяНоменклатура.Записать();
		// ИнтеграцияГосИС
		// Если произойдет ошибка при создании настройки маркируемой продукции,
		// то не уходим в отказ, так как номенклатура уже создана,
		// а сообщение об ошибке выводиться во вложенных функциях.
		ЕстьОшибки = Ложь;
		СобытияФормИСУНФ.ПриЗаписиНаСервере(ЭтотОбъект, НоваяНоменклатура, ЕстьОшибки);
		// Конец ИнтеграцияГосИ
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при создании номенклатуры: " +Символы.ПС+ОписаниеОшибки());
		Результат = Ложь;
		// Если не создана номенклатура - продолжать нет смысла.
		Возврат Результат;
	КонецПопытки;
	
	ЗаполнитьНоменклатуруОтраслевымиРеквизитамиПослеЗаписи(НоваяНоменклатура);
	
	Если Не ХарактеристикиИспользуютсяВКатегорииНоменклатуры(ЭтотОбъект.КатегорияНоменклатуры) Тогда
		
		// Формирование штрихкода
		ТекЗапись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		
		ТекЗапись.Номенклатура = НоваяНоменклатура.Ссылка;
		ТекЗапись.Штрихкод     = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьШтрихкодEAN13();
		
		Попытка
			ТекЗапись.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при записи штрихкода: " +Символы.ПС+ОписаниеОшибки());
			Результат = Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	ЭтотОбъект.Номенклатура = НоваяНоменклатура.Ссылка;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьЗначенияНоменклатурыПоУмолчанию(Номенклатура)
	
	Если ЗначениеЗаполнено(Номенклатура.КатегорияНоменклатуры) Тогда
		Номенклатура.ВидСтавкиНДС = Номенклатура.КатегорияНоменклатуры.ВидСтавкиНДС;
	Иначе
		Номенклатура.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура.СпособПополнения) Тогда
		Номенклатура.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура.МетодОценки) Тогда
		Номенклатура.МетодОценки = Перечисления.МетодОценкиЗапасов.ПоСредней;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура.НаправлениеДеятельности) Тогда
		Номенклатура.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	КонецЕсли;

	Номенклатура.СчетУчетаЗапасов = Справочники.Номенклатура.СчетУчетаЗапасов();
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПодсистемуПроизводство") Тогда
		Номенклатура.СчетУчетаЗатрат = ПредопределенноеЗначение("ПланСчетов.Управленческий.НезавершенноеПроизводство");
	Иначе
		Номенклатура.СчетУчетаЗатрат = ПредопределенноеЗначение("ПланСчетов.Управленческий.КоммерческиеРасходы");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СоздатьХарактеристику()
	
	ЕстьОшибки = Ложь;
	Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоНаименованияХарактеристики) Тогда
		Если ПроверитьЗаполнениеПараметровПравил() Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект["НаименованиеХарактеристики"]) Тогда
			ЕстьОшибки = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Наименование характеристики не заполнено.",, "ЭтотОбъект.НаименованиеХарактеристики");
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьОшибки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ХарактеристикаСоздана = СоздатьХарактеристикуНаСервере();
	Если ХарактеристикаСоздана Тогда
		
		Если Объект.ПечатьЦенника Тогда
			Печать();
		КонецЕсли;
		
		Если Не ВызовИзСписка Тогда
			ДобавитьВДокумент();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ХарактеристикаСоздана;
	
КонецФункции

// Создание характеристики для созданной\выбранной номенклатуры
&НаСервере
Функция СоздатьХарактеристикуНаСервере()
	
	Результат = Истина;
	Если ИспользуютсяХарактеристикиНоменклатуры(ЭтотОбъект.Номенклатура, ЭтотОбъект.КатегорияНоменклатуры) Тогда
		
		// Первичная запись номенклатуры
		НоваяХарактеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		НоваяХарактеристика.Владелец = ?(ГдеСоздаемХарактеристики = 1, ЭтотОбъект.КатегорияНоменклатуры, ЭтотОбъект.Номенклатура);
		
		Если НЕ ЗаполнитьХарактеристикуОтраслевымиРеквизитамиПередЗаписью(НоваяХарактеристика) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Запись реквизитов из правила именования
		Для Каждого ТекРеквизит Из ПараметрыПравилаИменования Цикл
			ИмяРеквизита = ТекРеквизит.ПутьКДанным;
			Если ИмяРеквизита = "КатегорияНоменклатуры"
				 ИЛИ ИмяРеквизита = "Характеристика_ор_Вставка"
				 ИЛИ ТекРеквизит.ДляНоменклатуры
				 ИЛИ ТекРеквизит.ЭтоДопСведение
				 ИЛИ ТекРеквизит.ЭтоДопРеквизит Тогда
				// Доп реквизиты и сведения обрабатывае ниже
				Продолжить;
			КонецЕсли;
			
			ИмяНаФорме = НайтиНазваниеРеквизитаПравилаНаименования(ИмяРеквизита);
			ИмяНаФорме = ?(ИмяНаФорме = Неопределено,ИмяРеквизита,ИмяНаФорме);
			
			ИмяРеквизитаСправочника = СтрЗаменить(ИмяРеквизита, "Характеристика_","");
			
			НоваяХарактеристика[ИмяРеквизитаСправочника] = ЭтотОбъект[ИмяНаФорме];
		КонецЦикла;
		
		// Заполнение Доп Реквизитов
		// СтандартныеПодсистемы.Свойства
		УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, НоваяХарактеристика);
		// Конец СтандартныеПодсистемы.Свойства
		
		Попытка
			НачатьТранзакцию();
			// Первичная запись номенклатуры
			НоваяХарактеристика.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при создании характеристики: " +Символы.ПС+ОписаниеОшибки());
			Результат = Ложь;
			// Если не создана номенклатура - продолжать нет смысла.
			Возврат Результат;
		КонецПопытки;
		
		Если НЕ ЗаполнитьХарактеристикуОтраслевымиРеквизитамиПослеЗаписи(НоваяХарактеристика) Тогда
			Результат = Ложь;
		КонецЕсли;
		
		СписокПараметров = ПолучитьСписокПараметровДляШаблона(Истина);
		Если ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры) И ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоНаименованияХарактеристики) Тогда
			СтрокаНаименованиеХарактеристики = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
				СписокПараметров,
				ЭтотОбъект.ор_ПравилоНаименованияХарактеристики.ШаблонДляФормирования);
			НоваяХарактеристика.Наименование = СтрокаНаименованиеХарактеристики;
		Иначе
			НоваяХарактеристика.Наименование = ЭтотОбъект["НаименованиеХарактеристики"];
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоНаименованияХарактеристикиДляПечати) Тогда
			НоваяХарактеристика.НаименованиеДляПечати = ШаблоныНаименованийКлиентСервер.СформироватьНаименованиеПоШаблону(
				СписокПараметров,
				ЭтотОбъект.ор_ПравилоНаименованияХарактеристикиДляПечати.ШаблонДляФормирования);
		КонецЕсли;
		
		Если ПустаяСтрока(НоваяХарактеристика.НаименованиеДляПечати) Тогда
			НоваяХарактеристика.НаименованиеДляПечати = НоваяХарактеристика.Наименование;
		КонецЕсли;
		
		Попытка
			НоваяХарактеристика.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при создании характеристики: " +Символы.ПС+ОписаниеОшибки());
			Результат = Ложь;
			ОтменитьТранзакцию();
		КонецПопытки;
		
		// Формирование штрихкода
		ТекЗапись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		
		ТекЗапись.Номенклатура   = ЭтотОбъект.Номенклатура;
		ТекЗапись.Характеристика = НоваяХарактеристика.Ссылка;
		ТекЗапись.Штрихкод       = РегистрыСведений.ШтрихкодыНоменклатуры.СформироватьШтрихкодEAN13();
		
		Попытка
			ТекЗапись.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при записи штрихкода: " +Символы.ПС+ОписаниеОшибки());
			Результат = Ложь;
		КонецПопытки;
		
		ЭтотОбъект.Характеристика = НоваяХарактеристика.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РаботаСИзображением

// Запись полученной картинки в текущую номенклатуру
//
&НаСервере
Процедура ЗаписатьКартинкуНоменклатуры(Файл)
	
	НоменклатураОбъект              = ЭтотОбъект.Номенклатура.ПолучитьОбъект();
	НоменклатураОбъект.ФайлКартинки = Файл;
	НоменклатураОбъект.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображениеВХранилище()
	
	АдресВременногоХранилищаТекста = "";
	РасширениеБезТочки             = "jpg";
	
	ИмяСоздания = ПолучитьНаименованиеКартинки(ЭтотОбъект.Номенклатура);
	
	Если ЭтоАдресВременногоХранилища(АдресИзображения) Тогда
		#Если Не ВебКлиент Тогда
		ДанныеКартинки = ПолучитьИзВременногоХранилища(АдресИзображения);
		АдресВременногоФайла = ПолучитьИмяВременногоФайла(".jpg");
		ДанныеКартинки.Записать(АдресВременногоФайла);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВладелецФайла",                           ЭтотОбъект.Номенклатура);
		ДополнительныеПараметры.Вставить("ИдентификаторФормы",                      Новый УникальныйИдентификатор);
		ДополнительныеПараметры.Вставить("Фильтр",                                  "");
		ДополнительныеПараметры.Вставить("ГруппаФайлов",                            Неопределено);
		ДополнительныеПараметры.Вставить("ПолноеИмяФайла",                          АдресВременногоФайла);
		ДополнительныеПараметры.Вставить("НеОткрыватьКарточкуПослеСозданияИзФайла", Истина);
		ДополнительныеПараметры.Вставить("ИмяСоздаваемогоФайла",                    ИмяСоздания);
		
		ВыборИзображения = Истина;
		ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьФайлыРасширениеПредложено", РаботаСФайламиСлужебныйКлиент, ДополнительныеПараметры);
		РаботаСФайламиСлужебныйКлиент.ПоказатьВопросОбУстановкеРасширения1СПредприятия(ОписаниеОповещения);
		ВыборИзображения = Ложь;
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНаименованиеКартинки(Номенклатура)
	
	ДатаВАдресе = СтрЗаменить(ТекущаяДата(),":","_");
	Возврат Номенклатура.Наименование + ДатаВАдресе;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьДиалогВыбораФайлаЗавершение(ВыбранныеФайлы, ДопПараметр) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзображениеОчистить(Неопределено);
	
	ОповещениеПомещения = Новый ОписаниеОповещения("НачатьПомещениеФайлаЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(ОповещениеПомещения,, ВыбранныеФайлы[0], Ложь, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПомещениеФайлаЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДопПараметры) Экспорт
	
	Если Не Результат Тогда
		ПоказатьПредупреждение(, "Ошибка загрузки изображения в временное хранилище!");
		Возврат;	
	КонецЕсли;
	
	АдресИзображения = Адрес;
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область Печать

// Функция - Запрос дополнения товаров для печати
// 
// Возвращаемое значение:
//   Результат - текст запроса дополнения исходных данных.
//
&НаСервере
Функция ЗапросДополненияТоваровДляПечати()
	
	Результат = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Партия КАК Партия,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Партия КАК Партия,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО Товары.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|			И Товары.Характеристика = ШтрихкодыНоменклатуры.Характеристика
	|			И Товары.Партия = ШтрихкодыНоменклатуры.Партия
	|			И Товары.ЕдиницаИзмерения = ШтрихкодыНоменклатуры.ЕдиницаИзмерения");
	
	Возврат Результат;


КонецФункции

// Процедура - Печать на сервере
//
&НаСервере
Процедура ДополнитьТоварыДляПечати()
	
	Товары = Новый ТаблицаЗначений();
	Товары.Колонки.Добавить("Номенклатура",         Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Товары.Колонки.Добавить("Характеристика",       Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Товары.Колонки.Добавить("Партия",               Новый ОписаниеТипов("СправочникСсылка.ПартииНоменклатуры"));
	Товары.Колонки.Добавить("ЕдиницаИзмерения",     Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	
	НовыйТовар = Товары.Добавить();
	НовыйТовар.Номенклатура        = ЭтотОбъект.Номенклатура;
	НовыйТовар.Характеристика      = ЭтотОбъект.Характеристика;
	НовыйТовар.Партия              = Справочники.ПартииНоменклатуры.ПустаяСсылка();
	НовыйТовар.ЕдиницаИзмерения    = ЭтотОбъект.ЕдиницаИзмерения;
	
	Запрос = ЗапросДополненияТоваровДляПечати();
	Запрос.УстановитьПараметр("Товары", Товары);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТоварыСоШтрихкодом = РезультатЗапроса[1].Выгрузить();
	
	Для Каждого Товар Из ТаблицаТоваровБПОДляПечати Цикл
		
		РезультатПоиска = ТоварыСоШтрихкодом.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Партия",
			Товар.НоменклатураБПО, Товар.ХарактеристикаБПО, Товар.Партия));
		Если РезультатПоиска.Количество() > 0 Тогда
			Товар.Штрихкод = РезультатПоиска[0].Штрихкод;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура осуществляет печать по выбранному шаблону.
//
&НаКлиенте
Процедура Печать()
	
	ХарактеристикиНеИспользуются = Не ИспользуютсяХарактеристикиНоменклатуры(ЭтотОбъект.Номенклатура, ЭтотОбъект.КатегорияНоменклатуры);
	СоздаетсяНоменклатура        = ТекущееДействие = "СозданиеНоменклатуры";
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Если (ХарактеристикиНеИспользуются И СоздаетсяНоменклатура) Или Не СоздаетсяНоменклатура Тогда
		
		ПараметрКоманды = Новый Массив;
		ПараметрКоманды.Добавить(ПредопределенноеЗначение("Справочник.ШаблоныЭтикетокИЦенниковБПО.ПустаяСсылка"));
		
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("ТорговыйОбъект",        МагазинДляПечати);
		ПараметрыПечати.Вставить("МассивСтруктурТоваров", ПодготовитьТоварыДляПечати());
		ПараметрыПечати.Вставить("ВидЦены",               ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка"));
		ПараметрыПечати.Вставить("ВидЦеныАкционный",      ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка")); 
		ПараметрыПечати.Вставить("ЦеныНаДату",            ТекущаяДата());
		
		МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
		МодульУправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.ор_СозданиеНоменклатуры", "Ценники", ПараметрКоманды, ЭтотОбъект, ПараметрыПечати);
	
	КонецЕсли;
	
КонецПроцедуры

// Очистка значений реквизитов параметров печати
//
&НаСервере
Процедура ОчиститьПараметрыПечати()
	
	МагазинДляПечати     = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	ОрганизацияДляПечати = Справочники.Организации.ПустаяСсылка();
	Шаблон               = Справочники.ХранилищеШаблонов.ПустаяСсылка();
	
КонецПроцедуры

// Установка доступности элементов управления, отвечающих за настройку печати.
//
&НаКлиенте
Процедура УстановитьДоступностьПараметровПечати()
	
	Элементы.ПечатьМагазин.Доступность     = Объект.ПечатьЦенника;
	Элементы.ПечатьОрганизация.Доступность = Объект.ПечатьЦенника;
	Элементы.ПечатьШаблон.Доступность      = Объект.ПечатьЦенника;
	
КонецПроцедуры // УстановитьДоступностьПараметровПечати()

#КонецОбласти

// Создает структуру из реквизитов и общих реквизитов объекта метаданных - справочника или документа.
//  Примечание: табличные части в структуру не попадут.
//
// Параметры:
//  ИмяОбъекта	 - Строка - Имя объекта метаданных структуру которого необходимо получить.
// 
// Возвращаемое значение:
//  Структура - структура объекта метаданных, или пустая структура если объект найти не удалось.
//
&НаСервереБезКонтекста
Функция СтруктураОбъектаМетаданных(ИмяОбъекта)
	
	СтруктураОбъекта = Новый Структура;
	
	ОбъектМетаданных = Метаданные.Справочники.Найти(ИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда 
		ОбъектМетаданных = Метаданные.Документы.Найти(ИмяОбъекта);
	КонецЕсли;
	
	Если ОбъектМетаданных <> Неопределено Тогда 
		Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			СтруктураОбъекта.Вставить(Реквизит.Имя);
		КонецЦикла;
		
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			СтруктураОбъекта.Вставить(Реквизит.Имя);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтруктураОбъекта;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьАвтоОтметкуНеЗаполненногоВПараметрахПравил()
	
	Результат = ПолучитьНезаполненныеПравилаНаименования();
	Для Каждого Элемент Из Результат.СписокДанных Цикл
		Если Элементы.Найти(Элемент.ИмяРеквизита) <> Неопределено Тогда
			Элементы[Элемент.ИмяРеквизита].АвтоОтметкаНезаполненного = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет структуру объекта метаданных по данным формы, выполняет заполнение значений свойств,
// и поиск автогенерированных реквизитов с префиксом.
//
// Параметры:
//  СтруктураОбъекта - Структура	 - структура объекта метаданных.
//  Префикс			 - Строка	 - префикс автогенерированных реквизитов объекта.
//
&НаКлиенте
Процедура ЗаполнитьСтруктуруОбъекта(СтруктураОбъекта, Префикс)
	
	ЗаполнитьЗначенияСвойств(СтруктураОбъекта, ЭтотОбъект);
	Для Каждого КлючИЗначение Из СтруктураОбъекта Цикл
		ИмяРеквизитаСПрефиксом = Префикс + "_" + КлючИЗначение.Ключ;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаСПрефиксом) Тогда 
			СтруктураОбъекта[КлючИЗначение.Ключ]= ЭтотОбъект[ИмяРеквизитаСПрефиксом];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Выполнение оповещения документа владелеца о записи номенклатуры
//
&НаКлиенте
Процедура ДобавитьВДокумент()
	
	ХарактеристикиНеИспользуются = Не ИспользуютсяХарактеристикиНоменклатуры(ЭтотОбъект.Номенклатура, ЭтотОбъект.КатегорияНоменклатуры);
	
	СоздаетсяНоменклатура = ТекущееДействие = "СозданиеНоменклатуры" Или ТекущееДействие = "СозданиеИзображения";
	
	СписокПараметрыСоздания = Новый СписокЗначений;
	СписокПараметрыСоздания.Добавить(ЭтотОбъект.Номенклатура);
	СписокПараметрыСоздания.Добавить(?(ХарактеристикиНеИспользуются, Неопределено, ЭтотОбъект.Характеристика));
	СписокПараметрыСоздания.Добавить(?(ЗначениеЗаполнено(ЭтотОбъект.ЦенаХарактеристики), ЭтотОбъект.ЦенаХарактеристики, ЭтотОбъект.Цена));
	СписокПараметрыСоздания.Добавить(ЭтотОбъект.ВидЦены);
	СписокПараметрыСоздания.Добавить(ИмяТЧ);
	
	Если (ХарактеристикиНеИспользуются И СоздаетсяНоменклатура) ИЛИ НЕ СоздаетсяНоменклатура Тогда
		ОповеститьОЗаписиНового(СписокПараметрыСоздания);
	КонецЕсли;
	
КонецПроцедуры

// Заполнение реквизитов для выбранной номенклатуры
//
&НаСервере
Процедура ЗаполнитьРеквизитыВыбраннойНоменклатуры()
	
	ЭтотОбъект.ГруппаНоменклатуры    = ЭтотОбъект.Номенклатура.Родитель;
	ЭтотОбъект.Артикул               = ЭтотОбъект.Номенклатура.Артикул;
	ЭтотОбъект.КатегорияНоменклатуры = ЭтотОбъект.Номенклатура.КатегорияНоменклатуры;
	ЭтотОбъект.Наименование          = ЭтотОбъект.Номенклатура.Наименование;
	ЭтотОбъект.ЕдиницаИзмерения      = ЭтотОбъект.Номенклатура.ЕдиницаИзмерения;
	ЭтотОбъект.ЦеноваяГруппа         = ЭтотОбъект.Номенклатура.ЦеноваяГруппа;
	
	ИспользуютсяХарактеристики = ИспользуютсяХарактеристикиНоменклатуры(ЭтотОбъект.Номенклатура, ЭтотОбъект.КатегорияНоменклатуры);
	ПроверятьЗаполнениеХарактеристики = ПроверятьЗаполнениеХарактеристики(ЭтотОбъект.Номенклатура, ЭтотОбъект.КатегорияНоменклатуры);
	
	ЗаполнитьРеквизитыВыбраннойНоменклатурыОтраслевые();
	
	ОбновитьЭлементыДополнительныхРеквизитов();
	
	ЗаполнитьПравилаНаименованияПоКатегорииНоменклатуры();
	СоздатьРеквизитыИПоляФормыПравила();
	ЗаполнитьРеквизитыПравилВыбраннойНоменклатуры();
	ЗаполнитьПараметрыПравилаИменованияСервер();
	ОбновитьЗначенияПравилНаименования();
	
КонецПроцедуры

&НаСервере
// Процедура - Заполняет данные реквизитов созданных из правил наименования
//
Процедура ЗаполнитьРеквизитыПравилВыбраннойНоменклатуры()
	
	Для Каждого ТекСтрока Из ПараметрыПравилаИменования Цикл
		
		// Исключение - "Наименование поставщика","КатегорияНоменклатуры" - значения всегда по умолчанию
		Если ТекСтрока.ПутьКДанным = "КатегорияНоменклатуры" 
			ИЛИ ТекСтрока.ИмяПараметра = "ор_НаименованиеПоставщика" Тогда
			Продолжить;
		КонецЕсли;
		
		// Выполняем поиск программно созданнных элементов.
		ТекЭлемент = Элементы.Найти(ТекСтрока.ИмяЭлемента);
		Если ТекЭлемент <> Неопределено Тогда
			НазваниеРеквизитаНоменклатуры = СтрЗаменить(ТекЭлемент.ПутьКДанным, "Номенклатура_", "");
			ЭтотОбъект[ТекСтрока.ПутьКДанным] = ЭтотОбъект.Номенклатура[НазваниеРеквизитаНоменклатуры];
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыВыбранногоКатегорииНоменклатуры()
	
	ИменаРеквизитовДляОбновления = ЗаполнитьРеквизитыВыбранногоКатегорииНоменклатурыНаСервере();
	Для Каждого ИмяРеквизита Из ИменаРеквизитовДляОбновления Цикл
		СохранятьЗначениеПриИзменении(Элементы["СохранятьЗначение" + ИмяРеквизита], Ложь);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Заполняет реквизиты связанные с текущим видом номенклатуры
//
&НаСервере
Функция ЗаполнитьРеквизитыВыбранногоКатегорииНоменклатурыНаСервере()
	
	МассивРеквизитовДляОбновления = Новый Массив;
	ТекущаяКатегорияНоменклатуры = ЭтотОбъект.КатегорияНоменклатуры;
	
	Если ЗначениеЗаполнено(ТекущаяКатегорияНоменклатуры.ЕдиницаИзмерения) Тогда
		ЭтотОбъект.ЕдиницаИзмерения = ТекущаяКатегорияНоменклатуры.ЕдиницаИзмерения;
		МассивРеквизитовДляОбновления.Добавить("ЕдиницаИзмерения");
	КонецЕсли;
	
	ЭтотОбъект.СохранятьЗначениеЕдиницаИзмерения = Истина;
	
	Если ЗначениеЗаполнено(ТекущаяКатегорияНоменклатуры.ЦеноваяГруппа) Тогда
		ЭтотОбъект.ЦеноваяГруппа = ТекущаяКатегорияНоменклатуры.ЦеноваяГруппа;
		МассивРеквизитовДляОбновления.Добавить("ЦеноваяГруппа");
	КонецЕсли;
	
	ЗаполнитьРеквизитыВыбранногоКатегорииНоменклатурыОтраслевые(МассивРеквизитовДляОбновления);
	
	// Дополнительные реквизиты
	ОбновитьЭлементыДополнительныхРеквизитов();
	ИспользуютсяХарактеристики = ТекущаяКатегорияНоменклатуры.ИспользоватьХарактеристики;
	ПроверятьЗаполнениеХарактеристики = ТекущаяКатегорияНоменклатуры.ПроверятьЗаполнениеХарактеристики;
	
	// Очистка правил, реквизитов и элеменотов
	ЗаполнитьПравилаНаименованияПоКатегорииНоменклатуры();
	СоздатьРеквизитыИПоляФормыПравила();
	ЗаполнитьПараметрыПравилаИменованияСервер();
	
	МассивОбновленных = Новый Массив;
	Для Каждого ИмяРеквизита Из МассивРеквизитовДляОбновления Цикл
		Если ОбновитьЗначениеСохранения(ИмяРеквизита) Тогда
			МассивОбновленных.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивОбновленных;
	
КонецФункции

&НаСервере
Функция ОбновитьЗначениеСохранения(ИмяЭлемента)
	
	ЭлементФормы = Элементы.Найти("СохранятьЗначение" + ИмяЭлемента);
	Элемент = Элементы[ИмяЭлемента];
	
	ТребуетсяОбновление = ЭлементФормы <> Неопределено 
		И СохраненныеПользователемЭлементы.НайтиПоЗначению(ИмяЭлемента) = Неопределено;
	Если ТребуетсяОбновление Тогда
		НазваниеРеквизита = Элементы[ИмяЭлемента].ПутьКДанным;
		ЭтотОбъект["СохранятьЗначение" + ИмяЭлемента] = ЗначениеЗаполнено(ЭтотОбъект[НазваниеРеквизита]);
	КонецЕсли;
	
	Возврат ТребуетсяОбновление;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИспользуютсяХарактеристикиНоменклатуры(Номенклатура, КатегорияНоменклатуры)
	
	Возврат Номенклатура.ИспользоватьХарактеристики Или КатегорияНоменклатуры.ИспользоватьХарактеристики;
	
КонецФункции

&НаСервереБезКонтекста
Функция ХарактеристикиИспользуютсяВКатегорииНоменклатуры(КатегорияНоменклатуры)
	
	Возврат КатегорияНоменклатуры.ИспользоватьХарактеристики;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверятьЗаполнениеХарактеристики(Номенклатура, КатегорияНоменклатуры)
	
	Возврат Номенклатура.ПроверятьЗаполнениеХарактеристики Или КатегорияНоменклатуры.ПроверятьЗаполнениеХарактеристики;
	
КонецФункции

// Функция - Узнать сущетвует ли реквизит с данным названием.
//
// Параметры:
//  Название - Строка - Название реквизита 
// 
// Возвращаемое значение:
//  Булево - Существует реквизит
//
&НаСервере
Функция РеквизитСуществует(Название)
	
	Попытка
		НайденныйРеквизитОбъекта = ЭтотОбъект[Название];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Процедура - Выполнить очистку реквизитов текущей страницы
//
// Параметры:
//  ТолькоНеСохраненные	 - Булево - Очищать только элементы без установленного сохранения
//
&НаСервере
Процедура ОчиститьРеквизитыТекущейСтраницы(ТолькоНеСохраненные=Ложь)
	
	Очередь = Новый Массив;
	Если ТекущееДействие <> "СозданиеНоменклатуры" Тогда
		Очередь.Добавить(Элементы.СтраницаСозданиеХарактеристик);
	КонецЕсли;
	
	Если ТекущееДействие <> "СозданиеХарактеристики" Тогда
		Очередь.Добавить(Элементы.СтраницаСозданиеНоменклатуры);
	КонецЕсли;
	
	Для Каждого Элемент Из Очередь Цикл		
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ГруппаФормы") Тогда
			Для Каждого Потомок Из Элемент.ПодчиненныеЭлементы Цикл
				Очередь.Добавить(Потомок);
			КонецЦикла;
		ИначеЕсли ТипЭлемента = Тип("ПолеФормы") Тогда
			Если ТолькоНеСохраненные Тогда
				Если Элемент.ПутьКДанным = "Номенклатура"
					Или Элемент.ПутьКДанным = "ИспользуютсяХарактеристики"
					Или Элемент.ПутьКДанным = "ПроверятьЗаполнениеХарактеристики" Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрНайти(Элемент.Имя, "СохранятьЗначение") Тогда
					Продолжить;
				КонецЕсли;
				
				ПометкаСуществует = РеквизитСуществует("СохранятьЗначение" + Элемент.Имя);
				Если ПометкаСуществует И ЭтотОбъект["СохранятьЗначение" + Элемент.Имя] Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ЭтотОбъект[Элемент.ПутьКДанным] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция - Установить фокусировку первый доступный элемент текущей страницы без свойства "ПропускатьПриВводе"
//
// Параметры:
//  Родитель - ГруппаФормы, СтраницаФормы - Группа или страница у которой 
//                                          требуется сфоркусировать на первом элементе.
//                                          По умолчанию будет выбрана текущая страница.
// 
// Возвращаемое значение:
//  Булево - Успешность операции
//
&НаКлиенте
Функция УстановитьФокусировкуНаЭлемент(Родитель=Неопределено)
	
	Если Родитель = Неопределено Тогда
		Родитель = Элементы.СтраницыЭтапов.ТекущаяСтраница;
	КонецЕсли;
	
	Для Каждого Элемент Из Родитель.ПодчиненныеЭлементы Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ГруппаФормы") Тогда
			// Требуется проход в глубину, поэтому выбран рекурсивный вариант
			Если УстановитьФокусировкуНаЭлемент(Элемент) Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли ТипЭлемента = Тип("ПолеФормы") И Элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
			Если Элемент.ПропускатьПриВводе = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Элемент.Видимость И Элемент.Доступность И НЕ Элемент.ПропускатьПриВводе Тогда
				ЭтотОбъект.ТекущийЭлемент = Элемент;
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьВопросИзмененныхДанных(Оповещение)
	
	Если ТекущееДействие <> "ВыборРежима" И ДанныеИзменены Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		
		ОповещениеЗакрытия = Новый ОписаниеОповещения("ПоказатьВопросПодтвержденияВыходаЗавершение", ЭтотОбъект, Оповещение);
		НазваниеОбъекта = ?(ТекущееДействие = "СозданиеХарактеристики", "характеристики", "номенклатуры");
		ПоказатьВопрос(ОповещениеЗакрытия, НСтр(СтрШаблон("ru = 'Незаписанные изменения параметров %1 будут утрачены, продолжить?'", НазваниеОбъекта)), Режим, 0);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросПодтвержденияВыходаЗавершение(Результат, Оповещение) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьОшибкиПараметровНоменклатуры()
	
	ЕстьОшибки = Ложь;
	Если Не ЗначениеЗаполнено(ЭтотОбъект.КатегорияНоменклатуры) Тогда
		ЕстьОшибки = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед записью необходимо заполнить ""Категорию номенклатуры""!",,"КатегорияНоменклатуры"); 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ЕдиницаИзмерения) Тогда
		ЕстьОшибки = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед записью необходимо заполнить ""Единицу измерения""!",,"ЕдиницаИзмерения");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоКраткогоНаименования)
		Или ЗначениеЗаполнено(ЭтотОбъект.ор_ПравилоПолногоНаименования) Тогда
		Если ПроверитьЗаполнениеПараметровПравил() Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект["Наименование"]) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Наименование номенклатуры не заполнено.",,"Наименование");
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Процедура ПереходССозданияНоменклатуры()
	
	РежимМножественногоСоздания = РежимСоздания = 2;
	
	ПереходНаХарактеристики = Истина;
	ЗаполнитьПараметрыПравилаИменования = Ложь;
	Если ИспользуютсяХарактеристики И Не СозданиеТолькоНоменклатуры Тогда
		ТекущееДействие	= "СозданиеХарактеристики";
		ЗаполнитьПараметрыПравилаИменования = Истина;
	ИначеЕсли РежимМножественногоСоздания Тогда
		ТекущееДействие = "СозданиеНоменклатуры";
		ПереходНаХарактеристики = Ложь;
		ЗаполнитьПараметрыПравилаИменования = Истина;
	Иначе
		Закрыть();
	КонецЕсли;
	
	ОчиститьРеквизитыИПерезаписатьПравила(Истина,
		ПереходНаХарактеристики, ПереходНаХарактеристики,
		ПереходНаХарактеристики, ЗаполнитьПараметрыПравилаИменования, Не ПереходНаХарактеристики);
		
	ОбновитьАвтоОтметкуНеЗаполненногоВПараметрахПравил();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыИПерезаписатьПравила(ОчиститьТолькоНеСохранённые = Ложь,
												ЭтоПараметрыДляХарактеристики = Ложь, ЭтоПереход = Ложь,
												ЗаполнятьПоКатегории = Истина, ЗаполнитьПараметры = Ложь,
												СохранитьЗначения = Ложь)
	
	ОчиститьРеквизитыТекущейСтраницы(ОчиститьТолькоНеСохранённые);
	
	Если ЭтоПереход Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
	КонецЕсли;
	
	ПерезаписатьПравилаНаименования(ЭтоПараметрыДляХарактеристики, ЭтоПереход,
			ЗаполнятьПоКатегории, ЗаполнитьПараметры, СохранитьЗначения);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыИОбновитьПравила(УдалитьПравила = Ложь)
	
	ОчиститьРеквизитыТекущейСтраницы(Не УдалитьПравила);
	
	Если УдалитьПравила Тогда
		УдалитьРеквизитыИЭлементыПравилНаименования();
	Иначе
		ОбновитьЗначенияПравилНаименования();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТипНоменклатурыПоУмолчанию(КатегорияСсылка)
	Возврат КатегорияСсылка.ТипНоменклатурыПоУмолчанию;
КонецФункции

#Область РаботаСВебкамерой

&НаКлиенте
Процедура НачатьПолучениеФотоЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ИзображениеОчистить(Неопределено);
		
		Если ЗначениеЗаполнено(ПутьКВременномуФайлу) Тогда
			ОтключитьОбработчикОжидания("ПолучениеИзменениеНовогоФотоНоменклатуры");
			УдалитьКартинкуИзВременныхФайлов(РезультатВыполнения.АдресФото);
		Иначе
			УстановитьНовоеВременноеФото(РезультатВыполнения.АдресФото);
		КонецЕсли;
	Иначе
		ТекстСообщения = НСтр("ru='""%ОписаниеОшибки%"".'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНовоеВременноеФото(АдресФото)
	
	ПутьКВременномуФайлу = АдресФото;
	ВременныйАдрес       = АдресФото;
	
	// Ожидание пока пользователь сделает фото с камеры
	ПодключитьОбработчикОжидания("ПолучениеИзменениеНовогоФотоНоменклатуры", 1.5, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключениеВидеокамерыЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		УдалитьКартинкуИзВременныхФайлов();
	Иначе
		ТекстСообщения = НСтр("ru='""%ОписаниеОшибки%"".'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеИзменениеНовогоФотоНоменклатуры()
	
	Попытка
		Файл = Новый Файл(ВременныйАдрес);
		
		// Проверим существование файла
		Если Файл.Существует() Тогда
			ОповещениеПомещения = Новый ОписаниеОповещения("НачатьПомещениеФайлаЗавершение", ЭтотОбъект);
			НачатьПомещениеФайла(ОповещениеПомещения,, ВременныйАдрес, Ложь, УникальныйИдентификатор);
			ВременныйАдрес = Неопределено;
			
			ТекстСообщения = НСтр("ru='""Файл картинки получен"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКартинкуИзВременныхФайлов(АдресНовогоФото=Неопределено)
	
	Если ПутьКВременномуФайлу <> Неопределено Тогда
		НовыйФайлКартинки = Новый Файл(ПутьКВременномуФайлу);
		
		Оповещение = Новый ОписаниеОповещения("НачатьПроверкуСуществованияЗавершение", ЭтотОбъект, АдресНовогоФото);
		НовыйФайлКартинки.НачатьПроверкуСуществования(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПроверкуСуществованияЗавершение(Существует, АдресНовогоФото) Экспорт
	
	Если Существует Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("НачатьУдалениеФайловЗавершение", ЭтотОбъект, АдресНовогоФото);
		НачатьУдалениеФайлов(ОписаниеОповещения, ПутьКВременномуФайлу);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьУдалениеФайловЗавершение(АдресНовогоФото) Экспорт
	
	ПутьКВременномуФайлу = Неопределено;
	Если АдресНовогоФото <> Неопределено Тогда
		УстановитьНовоеВременноеФото(АдресНовогоФото);
	КонецЕсли;
	
КонецПроцедуры


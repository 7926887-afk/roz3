// Процедура - Вызывается при заполнении данных характеристики перед записью.
//  Используется для записи отраслевых данных в характеристику, переданную в параметрах.
//
// Параметры:
//  Характеристика	 - Справочники.Характеристики	 - Новый объект характеристики. Отраслевые данные записываются в данный параметр.
// 
// Возвращаемое значение:
//  Булево - Результат выполнения функции.
//
&НаСервере
Функция ЗаполнитьХарактеристикуОтраслевымиРеквизитамиПередЗаписью(Характеристика)
	
	// Установка отраслевых реквизитов для характеристики
	ИспользуютсяСерии =  ПолучитьФлагСерийногоУчета();
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.СрокГодности) И ИспользуютсяСерии Тогда
		Сообщение = НСтр("ru = 'Срок годности не заполнен!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.СерияПроизводителя) И ИспользуютсяСерии Тогда
		Сообщение = НСтр("ru = 'Серия производителя не заполнена!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		Возврат Ложь;
	КонецЕсли;
	
	Характеристика.ор_СерияПроизводителя = ЭтотОбъект.СерияПроизводителя;
	Характеристика.ор_ДатаИзготовления   = ЭтотОбъект.ДатаИзготовления;
	Характеристика.ор_СрокГодности       = ЭтотОбъект.СрокГодности;
	Характеристика.ор_СертификатСтрока   = ЭтотОбъект.СертификатСтрока;
	Характеристика.ор_Производитель      = ЭтотОбъект.ПроизводительСерии;
	
	Если ор_ИнтеграцияМДЛП.ПолучитьФлагМаркируемогоТовара(Характеристика.Владелец) Тогда
		Характеристика.ор_МаркируемыйТовар = Истина;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции


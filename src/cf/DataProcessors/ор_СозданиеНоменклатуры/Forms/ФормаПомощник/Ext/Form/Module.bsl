// Процедура - Вызывается при заполнении данных номенклатуры перед записью.
//  Используется для записи отраслевых данных в номенклатуру, переданную в параметрах.
//
// Параметры:
//  Номенклатура - Справочники.Номенклатура	 - Новый объект номенклатуры. Отраслевые данные записываются в данный параметр.
// 
// Возвращаемое значение:
//  Булево - Результат выполнения функции.
//
&НаСервере
Процедура ЗаполнитьНоменклатуруОтраслевымиРеквизитамиПередЗаписью(Номенклатура)
	
	Номенклатура.ор_Производитель                         = ЭтотОбъект.Производитель;
	Номенклатура.ор_ЖНВЛС                                 = ЭтотОбъект.ЖНВЛП;
	Номенклатура.ор_Яд                                    = ЭтотОбъект.Яд;
	Номенклатура.ор_НаркотическоеСредство                 = ЭтотОбъект.НаркотическоеСредство;
	Номенклатура.ор_МНН                                   = ЭтотОбъект.МНН;
	Номенклатура.ор_СМНН                                  = ЭтотОбъект.СМНН;

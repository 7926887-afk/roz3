
#Область ОписаниеПеременных

&НаКлиенте
Перем ОбновитьИнтерфейс;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Элементы.АнализСканированияШтрихкодов.Видимость = ПравоДоступа("Использование", Метаданные.Обработки.АнализСканированияШтрихкодовМДЛП);
	
	НастроитьФормуПриИзменииЭлементовУправления();
	
	// ИнтеграцияМДЛП.РазрешительныйРежим.
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияМДЛП.РазрешительныйРежим") Тогда
		Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияМДЛП.РазрешительныйРежим.ТСПИоТ") Тогда
			Элементы.НастройкиПодключенияТСПИоТ.Видимость = Истина;
			Если КонтрольКодовМаркировкиМДЛПКлиентСерверПовтИсп.ВерсияБПОПоддерживаетПроверкуКМЧерезТСПИоТ() Тогда
				Элементы.НастройкиПодключенияТСПИоТ.Видимость = ПравоДоступа("Просмотр", Метаданные.Справочники["ТСПИоТ"]);
			КонецЕсли;
		Иначе
			Элементы.НастройкиПодключенияТСПИоТ.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ГруппаРазрешительныйРежимНастройки.Видимость = Ложь;
		Элементы.ГруппаРазрешительныйРежимСервис.Видимость = Ложь;
		Элементы.НастройкиПодключенияТСПИоТ.Видимость = Ложь;
	КонецЕсли;
	// Конец ИнтеграцияМДЛП.РазрешительныйРежим.
	
	СобытияФормМДЛППереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ИнтеграцияМДЛП.РазрешительныйРежим.
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтеграцияМДЛП.РазрешительныйРежим") Тогда
		МодульСобытияФормРазрешительныйРежимМДЛПКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СобытияФормРазрешительныйРежимМДЛПКлиент");
		МодульСобытияФормРазрешительныйРежимМДЛПКлиент.ОбновитьПредставлениеАварийногоРежима(ЭтотОбъект);
	КонецЕсли;
	// Конец ИнтеграцияМДЛП.РазрешительныйРежим.
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ИнтеграцияМДЛП.РазрешительныйРежим.
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтеграцияМДЛП.РазрешительныйРежим") Тогда
		МодульСобытияФормРазрешительныйРежимМДЛПКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СобытияФормРазрешительныйРежимМДЛПКлиент");
		МодульСобытияФормРазрешительныйРежимМДЛПКлиент.ОбработатьОповещениеОбИзмененииАварийногоРежима(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	КонецЕсли;
	// Конец ИнтеграцияМДЛП.РазрешительныйРежим.
	
	СобытияФормМДЛПКлиентПереопределяемый.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры


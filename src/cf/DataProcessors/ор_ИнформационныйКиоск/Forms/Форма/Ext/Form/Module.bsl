	|			ИЛИ НЕ &ОтборПоКонтрагенту)";
	
	ТекущаяДата = ТекущаяДатаСеанса();
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	Запрос.УстановитьПараметр("ТорговыйОбъект", Объект.ТорговыйОбъект);
	Запрос.УстановитьПараметр("ДеньНедели", Перечисления.ДниНедели.Получить(ДеньНедели(ТекущаяДата) - 1));
	
	Назначения = Новый Массив;
	Назначения.Добавить(Перечисления.НазначенияАвтоматическихСкидок.Розница);
	Назначения.Добавить(Перечисления.НазначенияАвтоматическихСкидок.Везде);
	Запрос.УстановитьПараметр("Назначения", Назначения);
	
	МассивТиповСтруктурныхЕдиниц = Новый Массив;
	МассивТиповСтруктурныхЕдиниц.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Склад);
	МассивТиповСтруктурныхЕдиниц.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Розница);
	Запрос.УстановитьПараметр("ТипМагазинГруппаСкладов", Перечисления.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов);
	Запрос.УстановитьПараметр("МассивТиповСтруктурныхЕдиниц", МассивТиповСтруктурныхЕдиниц);
	
	// Отбор по контрагенту ведем если заполена дисконтная карта,
	// так как без карты контрагент всегда заполнен значением по умолчанию.
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ОтборПоКонтрагенту", ЗначениеЗаполнено(Объект.ДисконтнаяКарта));
	
	Запрос.УстановитьПараметр("СпособыПредоставления", СпособыПредоставления);
	Запрос.УстановитьПараметр("ОтборПоСпособуПредоставления", СпособыПредоставления.Количество() > 0);
	
	Возврат Запрос;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРодителейНоменклатурыИерархически(Номенклатура)
	
	МассивСсылок = Новый Массив;
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат МассивСсылок;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ");
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат МассивСсылок;
	
КонецФункции

&НаСервере
Функция ОпределитьМинМаксЦеныТовара(СсылкаНаНоменклатуру)
	
	МинМаксЦена = Неопределено;
	Если СсылкаНаНоменклатуру.ИспользоватьХарактеристики
		Или СсылкаНаНоменклатуру.КатегорияНоменклатуры.ИспользоватьХарактеристики Тогда
		
		Запрос = ЗапросЦенИОстатков(СсылкаНаНоменклатуру);
		Запрос.Текст = Запрос.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОсновныеДанные.Номенклатура КАК Номенклатура,
		|	МИНИМУМ(ОсновныеДанные.Цена) КАК ЦенаМин,
		|	МАКСИМУМ(ОсновныеДанные.Цена) КАК ЦенаМакс
		|ИЗ
		|	ОсновныеДанные КАК ОсновныеДанные
		|
		|СГРУППИРОВАТЬ ПО
		|	ОсновныеДанные.Номенклатура";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			МинМаксЦена = ?(
				Выборка.ЦенаМин = Выборка.ЦенаМакс,
				Выборка.ЦенаМин,
				СтрШаблон("%1 - %2", Выборка.ЦенаМин, Выборка.ЦенаМакс));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если МинМаксЦена = Неопределено Тогда
		МинМаксЦена = ПолучитьЦенуТовара(СсылкаНаНоменклатуру, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	КонецЕсли;
	
	Возврат МинМаксЦена;
	
КонецФункции

&НаСервере
Функция ЗапросЦенИОстатков(СсылкаНаНоменклатуру)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СпрНоменклатура.ЭтоНабор КАК ЭтоНабор,
	|	СпрНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	СпрНоменклатура.Номинал КАК Номинал
	|ПОМЕСТИТЬ ТаблицаНоменклатура
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка = &Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатуры.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ЦеныНоменклатуры.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЦеныНоменклатуры.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ТаблицаНоменклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатуры.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|	КОНЕЦ КАК Упаковка,
	|	МАКСИМУМ(ЕСТЬNULL(ЦеныНоменклатуры.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))) КАК Период,
	|	ЕСТЬNULL(ЦеныНоменклатуры.ВидЦен, ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)) КАК ВидЦен,
	|	0 КАК Номинал,
	|	ТаблицаНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры
	|ПОМЕСТИТЬ ТаблицаМаксПериодЦен
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|		ПО ТаблицаНоменклатура.Номенклатура = ЦеныНоменклатуры.Номенклатура
	|ГДЕ
	|	ЦеныНоменклатуры.Период <= &Дата
	|	И ЦеныНоменклатуры.ВидЦен = &ВидЦены
	|	И ЦеныНоменклатуры.Актуальность
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ЦеныНоменклатуры.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)),
	|	ЕСТЬNULL(ЦеныНоменклатуры.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)),
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЦеныНоменклатуры.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ТаблицаНоменклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатуры.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|	КОНЕЦ,
	|	ЕСТЬNULL(ЦеныНоменклатуры.ВидЦен, ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)),
	|	ТаблицаНоменклатура.ТипНоменклатуры
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаНоменклатура.Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	|	ТаблицаНоменклатура.ЕдиницаИзмерения,
	|	&Дата,
	|	&ВидЦены,
	|	0,
	|	ТаблицаНоменклатура.ТипНоменклатуры
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|		ПО ТаблицаНоменклатура.Номенклатура = ЦеныНоменклатуры.Номенклатура
	|ГДЕ
	|	ТаблицаНоменклатура.ЭтоНабор
	|	И ЦеныНоменклатуры.Номенклатура ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаНоменклатура.Номенклатура,
	|	ТаблицаНоменклатура.ЕдиницаИзмерения,
	|	ТаблицаНоменклатура.ТипНоменклатуры
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаНоменклатура.Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	|	ТаблицаНоменклатура.ЕдиницаИзмерения,
	|	&Дата,
	|	&ВидЦены,
	|	ТаблицаНоменклатура.Номинал,
	|	ТаблицаНоменклатура.ТипНоменклатуры
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|		ПО ТаблицаНоменклатура.Номенклатура = ЦеныНоменклатуры.Номенклатура
	|ГДЕ
	|	ТаблицаНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаНоменклатура.Номенклатура,
	|	ТаблицаНоменклатура.ЕдиницаИзмерения,
	|	ТаблицаНоменклатура.Номинал,
	|	ТаблицаНоменклатура.ТипНоменклатуры
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Период,
	|	ВидЦен,
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМаксПериодЦен.Номенклатура КАК Номенклатура,
	|	ТаблицаМаксПериодЦен.Характеристика КАК Характеристика,
	|	ТаблицаМаксПериодЦен.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ТаблицаМаксПериодЦен.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
	|			ТОГДА ТаблицаМаксПериодЦен.Номинал
	|		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0)
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ ТаблицаИтоговыхЦен
	|ИЗ
	|	ТаблицаМаксПериодЦен КАК ТаблицаМаксПериодЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|		ПО ТаблицаМаксПериодЦен.Период = ЦеныНоменклатуры.Период
	|			И ТаблицаМаксПериодЦен.ВидЦен = ЦеныНоменклатуры.ВидЦен
	|			И ТаблицаМаксПериодЦен.Номенклатура = ЦеныНоменклатуры.Номенклатура
	|			И ТаблицаМаксПериодЦен.Характеристика = ЦеныНоменклатуры.Характеристика
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Упаковка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаИтоговыхЦен.Номенклатура КАК Номенклатура,
	|	ТаблицаИтоговыхЦен.Характеристика КАК Характеристика,
	|	ТаблицаИтоговыхЦен.Цена КАК Цена,
	|	ВЫБОР
	|		КОГДА ТаблицаИтоговыхЦен.Упаковка ССЫЛКА Справочник.ЕдиницыИзмерения
	|			ТОГДА ЕСТЬNULL(ЕдиницыИзмерения.Коэффициент, 1)
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ТаблицаКоэффициентыУпаковок
	|ИЗ
	|	ТаблицаИтоговыхЦен КАК ТаблицаИтоговыхЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО ТаблицаИтоговыхЦен.Упаковка = ЕдиницыИзмерения.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ДанныеТорговогоОбъекта
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|ГДЕ
	|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
	|	И СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы = &ТипМагазинГруппаСкладов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеТорговогоОбъекта.Ссылка КАК ТорговыйОбъект,
	|	СтруктурныеЕдиницы.Ссылка КАК Склад
	|ПОМЕСТИТЬ ТаблицаСклады
	|ИЗ
	|	ДанныеТорговогоОбъекта КАК ДанныеТорговогоОбъекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ПО ДанныеТорговогоОбъекта.Ссылка = СтруктурныеЕдиницы.Родитель
	|ГДЕ
	|	СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы В(&МассивТиповСтруктурныхЕдиниц)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСклады.ТорговыйОбъект КАК ТорговыйОбъект,
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	СУММА(ОстаткиТоваров.Количество) КАК Количество
	|ПОМЕСТИТЬ ТаблицаОстатки
	|ИЗ
	|	ТаблицаСклады КАК ТаблицаСклады
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
	|		ПО ТаблицаСклады.Склад = ОстаткиТоваров.СтруктурнаяЕдиница
	|ГДЕ
	|	ОстаткиТоваров.Номенклатура = &Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСклады.ТорговыйОбъект,
	|	ОстаткиТоваров.Номенклатура,
	|	ОстаткиТоваров.Характеристика
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ТаблицаОстатки.ТорговыйОбъект, &ТорговыйОбъект) КАК ТорговыйОбъект,
	|	ТаблицаКоэффициентыУпаковок.Номенклатура КАК Номенклатура,
	|	ТаблицаКоэффициентыУпаковок.Характеристика КАК Характеристика,
	|	ТаблицаКоэффициентыУпаковок.Цена КАК Цена,
	|	ТаблицаКоэффициентыУпаковок.КоэффициентУпаковки КАК КоэффициентУпаковки,
	|	ЕСТЬNULL(ТаблицаОстатки.Количество, 0) / ТаблицаКоэффициентыУпаковок.КоэффициентУпаковки КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОсновныеДанные
	|ИЗ
	|	ТаблицаКоэффициентыУпаковок КАК ТаблицаКоэффициентыУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОстатки КАК ТаблицаОстатки
	|		ПО ТаблицаКоэффициентыУпаковок.Номенклатура = ТаблицаОстатки.Номенклатура
	|			И ТаблицаКоэффициентыУпаковок.Характеристика = ТаблицаОстатки.Характеристика";
	
	Запрос.УстановитьПараметр("Номенклатура", СсылкаНаНоменклатуру);
	Запрос.УстановитьПараметр("ВидЦены", Объект.ВидЦен);
	Запрос.УстановитьПараметр("ТорговыйОбъект", Объект.ТорговыйОбъект);
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	
	МассивТиповСтруктурныхЕдиниц = Новый Массив;
	МассивТиповСтруктурныхЕдиниц.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Склад);
	МассивТиповСтруктурныхЕдиниц.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Розница);
	Запрос.УстановитьПараметр("ТипМагазинГруппаСкладов", Перечисления.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов);
	Запрос.УстановитьПараметр("МассивТиповСтруктурныхЕдиниц", МассивТиповСтруктурныхЕдиниц);
	
	Возврат Запрос;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВладельцевХарактеристики(Номенклатура)
	
	МассивВладельцев = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат МассивВладельцев;
	ИначеЕсли НЕ ТипЗнч(Номенклатура)=Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат МассивВладельцев;
	ИначеЕсли НЕ ЗначениеЗаполнено(Номенклатура.КатегорияНоменклатуры) Тогда
		Возврат МассивВладельцев;
	КонецЕсли;
	
	Если Номенклатура.ИспользоватьХарактеристики Тогда
		МассивВладельцев.Добавить(Номенклатура);
	КонецЕсли;
	
	Если Номенклатура.КатегорияНоменклатуры.ИспользоватьХарактеристики Тогда
		МассивВладельцев.Добавить(Номенклатура.КатегорияНоменклатуры);
	КонецЕсли;
	
	Возврат МассивВладельцев;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОбъектКорзиныНаJS()
	
	СтрокиСкрипта = Новый Массив;
	СтрокиСкрипта.Добавить("let AGoods = {};");
	
	Если ФОКиоска.Корзина Тогда
		
		СчС = 0;
		Для Каждого ТоварКорзины Из Корзина Цикл
			
			СтрокиСкрипта.Добавить("AGoods = {};");
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.IDAGoods         = '%1';", ТоварКорзины.ИДНоменклатуры));
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.IDCharacteristic = '%1';", ТоварКорзины.ИДХарактеристики));
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.Name             = '%1';", ТоварКорзины.Наименование));
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.Price            = %1;", ПривестиЧислоКФорматуJS(ТоварКорзины.Цена)));
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.Count            = %1;", ПривестиЧислоКФорматуJS(ТоварКорзины.Количество)));
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.DiscountValue    = '%1';", ТоварКорзины.СкидкаЗначение));
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.Sum              = %1;", ПривестиЧислоКФорматуJS(ТоварКорзины.Сумма)));
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.TotalSum         = %1;", ПривестиЧислоКФорматуJS(ТоварКорзины.ИтогоПоЗаказу)));
			
			СтрокиСкрипта.Добавить(СтрШаблон("AGoods.IsPresent = %1;",
				ПривестиБулевоКФорматуJS(ТоварКорзины.Свойство("ПродажаПодарка") И ТоварКорзины.ПродажаПодарка)));
			
			СтрокиСкрипта.Добавить(СтрШаблон("Basket[%1] = AGoods;", Формат(СчС, "ЧН=; ЧГ=")));
			
			СчС = СчС + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиСкрипта, Символы.ПС);
	
КонецФункции

// Процедура выводит дополнительные отраслевые характеристики товара в строку
//
&НаСервере
Функция ПолучитьДополнительныеХарактеристикиТовара(ВыборкаТовар)
	
	// Дополнительные характеристики.
	Артикул             = СтрЗаменить(ВыборкаТовар.Артикул, "'", "");
	Производитель       = СтрЗаменить(Строка(ВыборкаТовар.ор_Производитель), "'", "");
	СтранаПроисхождения = СтрЗаменить(Строка(ВыборкаТовар.СтранаПроисхождения), "'", "");
	
	СтрокаДопХарактеристик = "";
	Если ЗначениеЗаполнено(Артикул) Тогда
		СтрокаДопХарактеристик = СтрокаДопХарактеристик
			+ СтрШаблон("<strong>Артикул</strong>: <span>%1</span></br>", Артикул);
	КонецЕсли;
	Если ЗначениеЗаполнено(Производитель) Тогда
		СтрокаДопХарактеристик = СтрокаДопХарактеристик
			+ СтрШаблон("<strong>Производитель</strong>: <span>%1</span></br>", Производитель);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		СтрокаДопХарактеристик = СтрокаДопХарактеристик
			+ СтрШаблон("<strong>Страна происхождения</strong>: <span>%1</span></br>", СтранаПроисхождения);
	КонецЕсли;
	
	// Аптека.
	Если ЗначениеЗаполнено(ВыборкаТовар.ор_МНН) Тогда
		МНН = СтрЗаменить(Строка(ВыборкаТовар.ор_МНН), "'", "");
		СтрокаДопХарактеристик = СтрокаДопХарактеристик
			+ СтрШаблон("<strong>МНН</strong>: <span>%1</span></br>", МНН);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаТовар.ор_ЕГК) Тогда
		ЕГК = СтрЗаменить(Строка(ВыборкаТовар.ор_ЕГК), "'", "");
		СтрокаДопХарактеристик = СтрокаДопХарактеристик
			+ СтрШаблон("<strong>ЕГК</strong>: <span>%1</span></br>", ЕГК);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаТовар.ор_ФТГ) Тогда
		ФТГ = СтрЗаменить(Строка(ВыборкаТовар.ор_ФТГ), "'", "");
		СтрокаДопХарактеристик = СтрокаДопХарактеристик
			+ СтрШаблон("<strong>Фармако-терапевтическая группа</strong>: <span>%1</span></br>", ФТГ);
	КонецЕсли;
	
	ДопПризнаки = "";
	Если ВыборкаТовар.ор_ЖНВЛС Тогда
		ДопПризнаки = НСтр("ru = 'ЖНВЛП'");
	КонецЕсли;
	Если ВыборкаТовар.ор_Яд Тогда
		ДопПризнаки = ?(ПустаяСтрока(ДопПризнаки), "", ";" + Символы.НПП) + НСтр("ru = 'Яд'");
	КонецЕсли;
	Если ВыборкаТовар.ор_НаркотическоеСредство Тогда
		ДопПризнаки = ?(ПустаяСтрока(ДопПризнаки), "", ";" + Символы.НПП) + НСтр("ru = 'Наркотическое cредство'");
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДопПризнаки) Тогда
		СтрокаДопХарактеристик = СтрокаДопХарактеристик
			+ СтрШаблон("<strong>Дополнительные признаки</strong>: <span>%1</span></br>", ДопПризнаки);
	КонецЕсли;
	// Конец Аптека.
	
	Возврат СтрокаДопХарактеристик;
	
КонецФункции

// Процедура получает текст отраслевого запроса
//
&НаСервере
Функция ПолучитьТекстЗапросаПоДополнительнымХарактеристикам()
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ОсновныеДанные.Номенклатура КАК Номенклатура,
	|	СУММА(ОсновныеДанные.КоличествоОстаток) КАК Количество,
	|	МАКСИМУМ(ОсновныеДанные.Цена) КАК Цена
	|ПОМЕСТИТЬ ОсаткиИЦеныНоменклатуры
	|ИЗ
	|	ОсновныеДанные КАК ОсновныеДанные
	|ГДЕ
	|	ОсновныеДанные.ТорговыйОбъект = &ТорговыйОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	ОсновныеДанные.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Ссылка,
	|	СпрНоменклатура.ПометкаУдаления КАК ПометкаУдаления,
	|	СпрНоменклатура.Родитель КАК Родитель,
	|	СпрНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	СпрНоменклатура.Код КАК Код,
	|	СпрНоменклатура.Наименование КАК Наименование,
	|	СпрНоменклатура.Комментарий КАК Описание,
	|	СпрНоменклатура.ФайлКартинки КАК ФайлКартинки,
	|	СпрНоменклатура.Артикул КАК Артикул,
	|	ВЫБОР
	|		КОГДА СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоТовар,
	|	СпрНоменклатура.Производитель КАК Производитель,
	|	СпрНоменклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(ОсаткиИЦеныНоменклатуры.Количество, 0) КАК Количество,
	// Аптека.
	|	СпрНоменклатура.ор_МНН КАК ор_МНН,
	|	СпрНоменклатура.ор_ЕГК КАК ор_ЕГК,
	|	СпрНоменклатура.ор_Производитель КАК ор_Производитель,
	|	СпрНоменклатура.ор_ФТГ КАК ор_ФТГ,
	|	СпрНоменклатура.ор_ЖНВЛС КАК ор_ЖНВЛС,
	|	СпрНоменклатура.ор_Яд КАК ор_Яд,
	|	СпрНоменклатура.ор_НаркотическоеСредство КАК ор_НаркотическоеСредство,
	// Конец Аптека.
	|	ЕСТЬNULL(ОсаткиИЦеныНоменклатуры.Цена, 0) КАК Цена
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОсаткиИЦеныНоменклатуры КАК ОсаткиИЦеныНоменклатуры
	|		ПО СпрНоменклатура.Ссылка = ОсаткиИЦеныНоменклатуры.Номенклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка = &Номенклатура";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ИдентификацияЭлементовHTML

// Функция выполняет рекурсивный поиск элемента HTML и его обработчика
//
&НаКлиенте
Функция ПолучитьКлавишиНавигации(ЭлементКонтейнера, НомерИтерации = 0, МассивОбрабатываемыхID = Неопределено)
	
	Если МассивОбрабатываемыхID = Неопределено Тогда
		
		// Создадим массив элементами которого являются составляющие id элементов которые подлежат обработке.
		МассивОбрабатываемыхID = Новый Массив;
		МассивОбрабатываемыхID.Добавить("shop actions");
		МассивОбрабатываемыхID.Добавить("prev nav");
		МассивОбрабатываемыхID.Добавить("next nav");
		МассивОбрабатываемыхID.Добавить("about shop");
		МассивОбрабатываемыхID.Добавить("find-goods");
		МассивОбрабатываемыхID.Добавить("issue-order");
	КонецЕсли;
	
	МассивОбрабатываемыхClass = Неопределено;
	Если МассивОбрабатываемыхClass = Неопределено Тогда
		
		// Создадим массив элементами которого являются составляющие class элементов которые подлежат обработке.
		МассивОбрабатываемыхClass = Новый Массив;
		МассивОбрабатываемыхClass.Добавить("custom-button");
		МассивОбрабатываемыхClass.Добавить("buy-button");
		МассивОбрабатываемыхClass.Добавить("item");
		МассивОбрабатываемыхClass.Добавить("delete-count count-block");
		МассивОбрабатываемыхClass.Добавить("count-block add-count");
		МассивОбрабатываемыхClass.Добавить("delete-item");
	КонецЕсли;
	
	Если ЭлементКонтейнера.tagName = "BODY" Тогда
		Структура = Новый Структура;
		Структура.Вставить("ИдентификаторОбработки", "");
		
		Возврат Структура;
	КонецЕсли;
	
	идИмя = ЭлементКонтейнера.id;
	
	Если идИмя <> NULL Тогда
		Для Каждого ОсознанныйЭлемент Из МассивОбрабатываемыхID Цикл
			// Если нашли соответствие id какому-нибудь из обрабатываемых элементов,
			// то возвращаем найденный элемент и соответствующее ему событие.
			Если Найти(идИмя, ОсознанныйЭлемент) Тогда
				Структура = Новый Структура;
				Структура.Вставить("ИскомыйЭлемент", ЭлементКонтейнера);
				Структура.Вставить("ИдентификаторОбработки", ОсознанныйЭлемент);
				Если идИмя = "shop actions" Тогда
					идНоменклатуры = Элементы.ИнфоКиоск.Документ.getElementById("execution").getAttribute("paramID");
					Структура.Вставить("ЭтоКнопкаАкций", Истина);
					Структура.Вставить("ЭтоАкцииВсегоМагазина", ?(идИмя = "shop actions", Истина, Ложь));
					Структура.Вставить("НоменклатураИД", идНоменклатуры);
				Иначе
					Структура.Вставить("ЭтоКнопкаАкций", Ложь);
				КонецЕсли;
				
				Если идИмя = "prev nav" ИЛИ идИмя = "next nav" Тогда
					Структура.Вставить("ЭтоКнопкаПерехода", Истина);
					Структура.Вставить("ЭтоКнопкаПереходаНазад", ?(идИмя = "prev nav", Истина, Ложь));
				Иначе
					Структура.Вставить("ЭтоКнопкаПерехода", Ложь);
				КонецЕсли;
				
				Если идИмя = "about shop" Тогда
					Структура.Вставить("ЭтоКнопкаОМагазине", Истина);
				Иначе
					Структура.Вставить("ЭтоКнопкаОМагазине", Ложь);
				КонецЕсли;
				
				Если идИмя = "find-goods" Тогда
					ЭлемСТекстом = Элементы.ИнфоКиоск.Документ.getElementById("search-text");
					// Заменим неразрывной пробел на обычный, которые использует 1С Предприятие
					// в противном случае поиск не даст результатов при вводе значения с цифровой клавиатуры.
					ТекстДляПоиска = СокрЛП(СтрЗаменить(ЭлемСТекстом.value, Символ(160), Символ(32)));
					ТекстПоУмолчанию = СокрЛП(ЭлемСТекстом.placeholder); // Текст по умолчанию "Нажмите на поле для вызова клавиатуры".
					Если ЗначениеЗаполнено(ТекстДляПоиска) И ТекстДляПоиска <> ТекстПоУмолчанию Тогда
						ПолучитьТоварыДляПоиска = Истина;
						
						СтрокаСкрипта = ПолучитьСтраницуКаталога(, ТекстДляПоиска);
						
						ЭлементВыполнения = Элементы.ИнфоКиоск.Документ.getElementById("execution");
						ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
						ВыполнитьСобытиеOnclick(ЭлементВыполнения);
						
						// Запоминание истории поиска.
						Для Каждого историяПерехода Из стекПереходов Цикл
							Если историяПерехода.Пометка Тогда
								
								КодСкрипта = историяПерехода.Значение.КодСкрипта;
								КодСкрипта = ЭлементВыполнения.getAttribute("paramKod");
								историяПерехода.Значение.КодСкрипта = КодСкрипта;
								
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				// Оформление заказа
				Если идИмя = "issue-order" Тогда
					
					Если Корзина.Количество() Тогда
						ОтветОформления = ОформитьЗаказНаКлиенте();
						
						КнопкаЗаказать = Элементы.ИнфоКиоск.Документ.getElementById("issue-order");
						Если ОтветОформления.ДокументОформлен Тогда
							Корзина.Очистить();
							КнопкаЗаказать.setAttribute("paramOrderIssued", ОтветОформления.НомерЗаказа);
							ВыполнитьСобытиеOnclick(КнопкаЗаказать);
							НапечататьЗаказ();
						Иначе
							КнопкаЗаказать.setAttribute("paramOrderIssued", "");
							// Перенаправим на страницу с ошибкой.
							ОсуществитьПереходНаСтраницу("error.html");
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Возврат Структура;
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	
	классИмя = ЭлементКонтейнера.ClassName;
	
	Если классИмя <> NULL Тогда
		Для Каждого ОсознанныйЭлемент Из МассивОбрабатываемыхClass Цикл
			// Если нашли соответствие id какому-нибудь из обрабатываемых элементов,
			// то возвращаем найденный элемент и соответствующее ему событие.
			Если ВРег(классИмя)=ВРег(ОсознанныйЭлемент) Тогда
				классИмя = ОсознанныйЭлемент;
				Структура = Новый Структура;
				Структура.Вставить("ИскомыйЭлемент", ЭлементКонтейнера);
				Структура.Вставить("ИдентификаторОбработки", ОсознанныйЭлемент);
				// Обработка нажатия кнопки ВКорзину в карточке товара.
				Если классИмя = "buy-button" ИЛИ классИмя = "custom-button" Тогда
					
					ЭлементСвязи   = Элементы.ИнфоКиоск.Документ.getElementById("execution");
					
					ЭлементВКорзину = Элементы.ИнфоКиоск.Документ.getElementById("buy-button");
					идНоменклатуры = ЭлементВКорзину.getAttribute("paramIDAGoods");
					
					Если классИмя = "custom-button" Тогда
						идХарактеристики = ЭлементКонтейнера.getAttribute("paramIDCharacteristic");
					Иначе
						идХарактеристики = Строка(ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка").УникальныйИдентификатор());
					КонецЕсли;
					
					СтрокаТовара = Неопределено;
					ВКорзинеУжеЕстьДобавляемыйТовар = Ложь;
					
					Для Каждого ТоварКорзины Из Корзина Цикл
						Если ТоварКорзины.ИДНоменклатуры = идНоменклатуры И ТоварКорзины.ИДХарактеристики = идХарактеристики Тогда
							ТоварКорзины.Количество = ТоварКорзины.Количество + 1;
							ТоварКорзины.Сумма = ТоварКорзины.Цена * ТоварКорзины.Количество;
							ПересчитатьИтогоКорзины();
							РассчитатьСкидкиКорзины();
							ВКорзинеУжеЕстьДобавляемыйТовар = Истина;
						КонецЕсли;
					КонецЦикла;
					
					Если НЕ ВКорзинеУжеЕстьДобавляемыйТовар Тогда
						
						ДанныеТовара = ПолучитьДанныеДляПомещенияТовараВКорзину(идНоменклатуры, идХарактеристики);
						
						ТоварКорзины = Новый Структура();
						ТоварКорзины.Вставить("ИДНоменклатуры",   идНоменклатуры);
						ТоварКорзины.Вставить("ИДХарактеристики", идХарактеристики);
						ТоварКорзины.Вставить("Наименование",     ДанныеТовара.Наименование);
						ТоварКорзины.Вставить("Цена",             ДанныеТовара.Цена);
						ТоварКорзины.Вставить("Количество",       1);
						ТоварКорзины.Вставить("СкидкаЗначение",   "");
						ТоварКорзины.Вставить("СкидкаИД",         "");
						ТоварКорзины.Вставить("Сумма",            ДанныеТовара.Цена);
						ТоварКорзины.Вставить("ПродажаПодарка",   Ложь);
						ТоварКорзины.Вставить("ИтогоПоЗаказу",    ДанныеТовара.Цена);
						
						Корзина.Добавить(ТоварКорзины);
						ПересчитатьИтогоКорзины();
						РассчитатьСкидкиКорзины();
						
					КонецЕсли;
					
					Структура.Вставить("ЭтоКнопкаВКорзину", Истина);
					// Обновить количество товаров.
					ЭлементСвязи.setAttribute("paramBasketCount", ПолучитьКоличествоТовараВКорзине());
					
					Если классИмя = "custom-button" Тогда
						ВыполнитьСобытиеOnclick(ЭлементКонтейнера);
					ИначеЕсли классИмя = "buy-button" Тогда
						ВыполнитьСобытиеOnclick(Элементы.ИнфоКиоск.Документ.getElementById("buy-button"));
					КонецЕсли;
					
				Иначе
					Структура.Вставить("ЭтоКнопкаАкций", Ложь);
					Структура.Вставить("ЭтоКнопкаПерехода", Ложь);
					Структура.Вставить("ЭтоКнопкаОМагазине", Ложь);
				КонецЕсли;
				
				Если классИмя = "item" Тогда
					парам1с = ЭлементКонтейнера.getAttribute("param1c");
					Если парам1с = "CatalogItem" Тогда
						Структура = Новый Структура;
						Структура.Вставить("ИскомыйЭлемент", ЭлементКонтейнера);
						Структура.Вставить("ИдентификаторОбработки", парам1с);
						Структура.Вставить("ИД", ЭлементКонтейнера.getAttribute("paramID"));
						СтруктураТовара = ПолучитьСтруктуруПоИД(
							?(ФОКиоска.КаталогИзПрайсЛиста, "ПрайсЛист", "Номенклатура"), Структура.ИД);
						Структура.Вставить("СсылкаНаЭлемент", СтруктураТовара.СсылкаНаЭлемент);
						Структура.Вставить("ЭтоГруппа", СтруктураТовара.ЭтоГруппа);
						Структура.Вставить("ЭтоКнопкаВКаталоге", Истина);
					КонецЕсли;
				КонецЕсли;
				
				Если классИмя = "delete-count count-block" ИЛИ классИмя = "count-block add-count" Тогда
					
					Слагаемое = ?(классИмя = "delete-count count-block", -1, 1);
					
					идНоменклатуры   = ЭлементКонтейнера.getAttribute("paramIDAGoods");
					идХарактеристики = ЭлементКонтейнера.getAttribute("paramIDCharacteristic");
					
					ТоварУдалили = Ложь;
					
					Для Каждого ТоварКорзины Из Корзина Цикл
						Если ТоварКорзины.ИДНоменклатуры = идНоменклатуры И ТоварКорзины.ИДХарактеристики = идХарактеристики Тогда
							ТоварКорзины.Количество = ТоварКорзины.Количество + Слагаемое;
							ТоварКорзины.Сумма = ТоварКорзины.Цена * ТоварКорзины.Количество;
							Если ТоварКорзины.Количество = 0 Тогда
								Индекс = Корзина.Найти(ТоварКорзины);
								Если Индекс <> Неопределено Тогда
									Корзина.Удалить(Индекс);
									ТоварУдалили = Истина;
								КонецЕсли;
							КонецЕсли;
							ПересчитатьИтогоКорзины();
							РассчитатьСкидкиКорзины();
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					ЭлементВыполнения = Элементы.ИнфоКиоск.Документ.getElementById("execution");
					
					СтрокаСкрипта     = ПолучитьОбъектКорзиныНаJS();
					ЭлементВыполнения.setAttribute("paramID", "");
				
					ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
					ВыполнитьСобытиеOnclick(ЭлементВыполнения);
					
				КонецЕсли;
				
				Если классИмя = "delete-item" Тогда
					
					идНоменклатуры   = ЭлементКонтейнера.getAttribute("paramIDAGoods");
					идХарактеристики = ЭлементКонтейнера.getAttribute("paramIDCharacteristic");
					
					Для Каждого ТоварКорзины Из Корзина Цикл
						Если ТоварКорзины.ИДНоменклатуры = идНоменклатуры И ТоварКорзины.ИДХарактеристики = идХарактеристики Тогда
							Индекс = Корзина.Найти(ТоварКорзины);
							Если Индекс <> Неопределено Тогда
								Корзина.Удалить(Индекс);
								ТоварУдалили = Истина;
							КонецЕсли;
							ПересчитатьИтогоКорзины();
							РассчитатьСкидкиКорзины();
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					ЭлементВыполнения = Элементы.ИнфоКиоск.Документ.getElementById("execution");
					
					СтрокаСкрипта     = ПолучитьОбъектКорзиныНаJS();
					ЭлементВыполнения.setAttribute("paramID", "");
				
					ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
					ВыполнитьСобытиеOnclick(ЭлементВыполнения);
					
				КонецЕсли;
				
				Возврат Структура;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НомерИтерации = НомерИтерации + 1;
	
	Если НомерИтерации = 5 Тогда
		
		Структура = Новый Структура;
		Структура.Вставить("ИдентификаторОбработки", "");
		
		Возврат Структура;
	КонецЕсли;
	
	ЭлементКонтейнера = ЭлементКонтейнера.parentElement;
	
	Возврат ПолучитьКлавишиНавигации(ЭлементКонтейнера, НомерИтерации, МассивОбрабатываемыхID)
	
КонецФункции

#КонецОбласти

#Область ОформлениеЗаказа

&НаКлиенте
Функция ОформитьЗаказНаКлиенте()
	
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("ПрименятьКОбъекту"          , Ложь);
	СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет", Ложь);
	СтруктураПараметры.Вставить("РабочееМесто"               , РабочееМесто);
	СтруктураПараметры.Вставить("Корзина"                    , Корзина);
	
	РассчитатьСкидкиНаценкиНаСервере(СтруктураПараметры);
	
	Возврат ОформитьЗаказНаСервере();
	
КонецФункции

&НаСервере
Функция ОформитьЗаказНаСервере()
	
	ДокументОформлен = Ложь;
	
	ДокументЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	
	ДокументЗаказ.Дата = ТекущаяДатаСеанса();
	
	ДокументЗаказ.Организация = Объект.Организация;
	ДокументЗаказ.НалогообложениеНДС = Объект.НалогообложениеНДС;
	
	ДокументЗаказ.ВидЗаказа = Справочники.ВидыЗаказовПокупателей.Основной;
	ДокументЗаказ.СостояниеЗаказа = ЗаполнениеОбъектовУНФ.ПолучитьСостояниеЗаказаПокупателя(ДокументЗаказ.ВидЗаказа);
	ДокументЗаказ.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
	ДокументЗаказ.ХозяйственнаяОперация = Справочники.ХозяйственныеОперации.ЗаказНаПродажу;
	
	ДокументЗаказ.Автор = Пользователи.ТекущийПользователь();
	ДокументЗаказ.Ответственный = ПерсональныеНастройкиРУНФ.Прочитать(
		"ОсновнойОтветственный",,
		ДокументЗаказ.Автор);
	
	ДокументЗаказ.СтруктурнаяЕдиницаРезерв  = Объект.СтруктурнаяЕдиницаРезерв;
	ДокументЗаказ.СтруктурнаяЕдиницаПродажи = Объект.СтруктурнаяЕдиницаПродажи;
	
	ДокументЗаказ.Контрагент = Объект.Контрагент;
	ДокументЗаказ.Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(ДокументЗаказ.Контрагент);
	
	ДокументЗаказ.ДатаОтгрузки = Документы.ЗаказПокупателя.РассчитатьДатуОтгрузки(ДокументЗаказ.Дата, ДокументЗаказ.Договор);
	Если Не ЗначениеЗаполнено(ДокументЗаказ.ДатаОтгрузки) Тогда
		ДокументЗаказ.ДатаОтгрузки = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		ДокументЗаказ.ДисконтнаяКарта                = Объект.ДисконтнаяКарта;
		ДокументЗаказ.ВидСкидкиНаценки               = Объект.ВидСкидкиНаценки;
		ДокументЗаказ.ПроцентСкидкиПоДисконтнойКарте = Объект.ПроцентСкидкиПоДисконтнойКарте;
		
		ДанныеОсновногоКонтактногоЛица = ДанныеОсновногоКонтактногоЛица(ДокументЗаказ.Контрагент);
		Если ЗначениеЗаполнено(ДанныеОсновногоКонтактногоЛица) Тогда
			Объект.КонтактноеЛицо = ДанныеОсновногоКонтактногоЛица.Представление;
			Объект.КонтактныйТелефон = ДанныеОсновногоКонтактногоЛица.КонтактныйТелефон;
			Объект.ЗапаснойТелефон = ДанныеОсновногоКонтактногоЛица.ЗапаснойТелефон;
			Объект.ПочтаПолучателя = ДанныеОсновногоКонтактногоЛица.ПочтаПолучателя;
		Иначе
			Для Каждого ТекЭлемент Из ДанныеКонтактныхЛиц(ДокументЗаказ.Контрагент) Цикл
				Объект.КонтактноеЛицо = ТекЭлемент.Значение.Представление;
				Объект.КонтактныйТелефон = ТекЭлемент.Значение.КонтактныйТелефон;
				Объект.ЗапаснойТелефон = ТекЭлемент.Значение.ЗапаснойТелефон;
				Объект.ПочтаПолучателя = ТекЭлемент.Значение.ПочтаПолучателя;
				Прервать;
			КонецЦикла;
		КонецЕсли;
		
		АдресаДоставки = АдресаДоставки(ДокументЗаказ.Контрагент);
		Если ЗначениеЗаполнено(АдресаДоставки) Тогда
			Объект.АдресДоставки = АдресаДоставки[0].АдресДоставки;
			Объект.АдресДоставкиЗначение = АдресаДоставки[0].АдресДоставкиЗначение;
			Объект.АдресДоставкиЗначенияПолей = АдресаДоставки[0].АдресДоставкиЗначенияПолей;
		КонецЕсли;
	КонецЕсли;
	
	ДокументЗаказ.ВалютаДокумента = Объект.ВалютаДокумента;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс,
	|	КурсыВалютСрезПоследних.Кратность
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Период, Валюта = &Валюта) КАК КурсыВалютСрезПоследних");
	Запрос.УстановитьПараметр("Период", ДокументЗаказ.Дата);
	Запрос.УстановитьПараметр("Валюта", ДокументЗаказ.Договор.ВалютаРасчетов);
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ДокументЗаказ.Курс      = ВыборкаДетальныеЗаписи.Курс;
		ДокументЗаказ.Кратность = ВыборкаДетальныеЗаписи.Кратность;
	Иначе
		ДокументЗаказ.Курс      = 1;
		ДокументЗаказ.Кратность = 1;
	КонецЕсли;
	
	ДокументЗаказ.ВидЦен = Объект.ВидЦен;
	ДокументЗаказ.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	
	ЗначениеНастройки = ПерсональныеНастройкиРУНФ.Прочитать("ПоложениеДатыОтгрузкиВЗаказеПокупателя");
	Если ЗначениеЗаполнено(ЗначениеНастройки) Тогда
		Если ДокументЗаказ.ПоложениеДатыОтгрузки <> ЗначениеНастройки Тогда
			ДокументЗаказ.ПоложениеДатыОтгрузки = ЗначениеНастройки;
		КонецЕсли;
	Иначе
		ДокументЗаказ.ПоложениеДатыОтгрузки = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
	КонецЕсли;
	
	ДокументЗаказ.СкидкиРассчитаны = Объект.СкидкиНаценки;
	ДокументЗаказ.СуммаДокумента   = Объект.СуммаДокумента;
	
	ВесИтог   = 0;
	ОбъемИтог = 0;
	
	Для Каждого ТекущиеДанные Из Объект.Запасы Цикл
		НоваяСтрока = ДокументЗаказ.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
		
		НоваяСтрока.ДатаОтгрузки = ДокументЗаказ.ДатаОтгрузки;
		
		СтруктураДанные = СтруктураДанныхДляНомеклатуры();
		СтруктураДанные.Вставить("Номенклатура", НоваяСтрока.Номенклатура);
		СтруктураДанные.Вставить("Характеристика", НоваяСтрока.Характеристика);
		
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные);
		
		НоваяСтрока.ТипНоменклатурыЗапас = ДанныеНоменклатуры.ЭтоЗапас;
		
		НоваяСтрока.Вес   = ДанныеНоменклатуры.ВесЕдиницыТовара * НоваяСтрока.Количество;
		НоваяСтрока.Объем = ДанныеНоменклатуры.ОбъемЕдиницыТовара * НоваяСтрока.Количество;
		ВесИтог   = ВесИтог + НоваяСтрока.Вес;
		ОбъемИтог = ОбъемИтог + НоваяСтрока.Объем;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ВесИтог) Тогда
		ДокументЗаказ.Вес = ВесИтог;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъемИтог) Тогда
		ДокументЗаказ.Объем = ОбъемИтог;
	КонецЕсли;
	
	Для Каждого ТекущиеДанные Из Объект.СкидкиНаценки Цикл
		НоваяСтрока = ДокументЗаказ.СкидкиНаценки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	КонецЦикла;
	
	Для Каждого ТекущиеДанные Из Объект.Подарки Цикл
		НоваяСтрока = ДокументЗаказ.Подарки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	КонецЦикла;
	
	Для Каждого ТекущиеДанные Из Объект.ДобавленныеНаборы Цикл
		НоваяСтрока = ДокументЗаказ.ДобавленныеНаборы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	КонецЦикла;
	
	Для Каждого ТекущиеДанные Из Объект.БонусныеБаллыКНачислению Цикл
		НоваяСтрока = ДокументЗаказ.БонусныеБаллыКНачислению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	КонецЦикла;
	
	Попытка
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		ДокументОформлен = Истина;
	Исключение
		ЗаписьЖурналаРегистрации(
			"Инфо-киоск.Заказ покупателя",
			УровеньЖурналаРегистрации.Ошибка,
			,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
		ДокументОформлен = Ложь;
	КонецПопытки;
	
	ОтветОформления = Новый Структура;
	ОтветОформления.Вставить("ДокументОформлен", ДокументОформлен);
	Если ДокументОформлен Тогда
		ОчиститьДанныеПоЗаказу();
		
		ОтветОформления.Вставить("НомерЗаказа", ДокументЗаказ.Номер);
		
		ЗаказПокупателя = ДокументЗаказ.Ссылка;
	КонецЕсли;
	
	Возврат ОтветОформления;
	
КонецФункции

&НаСервере
Процедура ОчиститьДанныеПоЗаказу()
	
	Объект.Запасы.Очистить();
	Объект.ДобавленныеНаборы.Очистить();
	Объект.БонусныеБаллыКНачислению.Очистить();
	Объект.СкидкиНаценки.Очистить();
	Объект.Подарки.Очистить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеОсновногоКонтактногоЛица(Контрагент)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.КонтактноеЛицо,
	|	ПРЕДСТАВЛЕНИЕ(Контрагенты.КонтактноеЛицо) КАК Представление,
	|	КонтактныеЛицаКонтактнаяИнформация.Тип,
	|	КонтактныеЛицаКонтактнаяИнформация.АдресЭП,
	|	КонтактныеЛицаКонтактнаяИнформация.НомерТелефона
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛица.КонтактнаяИнформация КАК КонтактныеЛицаКонтактнаяИнформация
	|		ПО (КонтактныеЛицаКонтактнаяИнформация.Ссылка = Контрагенты.КонтактноеЛицо И Контрагенты.Ссылка = &Контрагент)
	|ГДЕ
	|	(КонтактныеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|			ИЛИ КонтактныеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|	И Контрагенты.Ссылка = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	Результат = НовыеДанныеКонтактногоЛица();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Результат.Представление) Тогда
			Результат.Представление = Выборка.Представление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат.КонтактныйТелефон)
			И ЗначениеЗаполнено(Результат.ЗапаснойТелефон)
			И ЗначениеЗаполнено(Результат.ПочтаПолучателя) Тогда
			Прервать;
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты
			И Не ЗначениеЗаполнено(Результат.ПочтаПолучателя) Тогда
			Результат.ПочтаПолучателя = Выборка.АдресЭП;
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон
			И Не ЗначениеЗаполнено(Результат.КонтактныйТелефон) Тогда
			Результат.КонтактныйТелефон = Выборка.НомерТелефона;
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон
			И Не ЗначениеЗаполнено(Результат.ЗапаснойТелефон) Тогда
			Результат.ЗапаснойТелефон = Выборка.НомерТелефона;
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция НовыеДанныеКонтактногоЛица()
	
	Результат = Новый Структура;
	Результат.Вставить("Представление");
	Результат.Вставить("КонтактныйТелефон");
	Результат.Вставить("ЗапаснойТелефон");
	Результат.Вставить("ПочтаПолучателя");
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеКонтактныхЛиц(Контрагент)
	
	Результат = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактныеЛица.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(КонтактныеЛица.Ссылка) КАК Представление,
	|	КонтактныеЛицаКонтактнаяИнформация.Тип КАК Тип,
	|	КонтактныеЛицаКонтактнаяИнформация.АдресЭП КАК АдресЭП,
	|	КонтактныеЛицаКонтактнаяИнформация.НомерТелефона КАК НомерТелефона
	|ИЗ
	|	РегистрСведений.СвязиКонтрагентКонтакт.СрезПоследних(, Контрагент = &Контрагент) КАК СвязиКонтрагентКонтакт
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛица КАК КонтактныеЛица
	|		ПО СвязиКонтрагентКонтакт.Контакт = КонтактныеЛица.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛица.КонтактнаяИнформация КАК КонтактныеЛицаКонтактнаяИнформация
	|		ПО (КонтактныеЛицаКонтактнаяИнформация.Ссылка = КонтактныеЛица.Ссылка)
	|ГДЕ
	|	(КонтактныеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|			ИЛИ КонтактныеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|	И СвязиКонтрагентКонтакт.СвязьНедействительна = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Результат[Выборка.Ссылка] = Неопределено Тогда
			Результат[Выборка.Ссылка] = НовыеДанныеКонтактногоЛица();
			Результат[Выборка.Ссылка].Представление = Выборка.Представление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат[Выборка.Ссылка].КонтактныйТелефон)
			И ЗначениеЗаполнено(Результат[Выборка.Ссылка].ЗапаснойТелефон)
			И ЗначениеЗаполнено(Результат[Выборка.Ссылка].ПочтаПолучателя) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты
			И Не ЗначениеЗаполнено(Результат[Выборка.Ссылка].ПочтаПолучателя) Тогда
			Результат[Выборка.Ссылка].ПочтаПолучателя = Выборка.АдресЭП;
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон
			И Не ЗначениеЗаполнено(Результат[Выборка.Ссылка].КонтактныйТелефон) Тогда
			Результат[Выборка.Ссылка].КонтактныйТелефон = Выборка.НомерТелефона;
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон
			И Не ЗначениеЗаполнено(Результат[Выборка.Ссылка].ЗапаснойТелефон) Тогда
			Результат[Выборка.Ссылка].ЗапаснойТелефон = Выборка.НомерТелефона;
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция АдресаДоставки(Контрагент)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивКонтрагент = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Контрагент);
	Адреса = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(МассивКонтрагент,
		,
		ВидыКИАдресаДоставки(),
		ТекущаяДатаСеанса());
	
	УникальныеЗначения = Новый Соответствие;
	Для Каждого АдресКонтрагента Из Адреса Цикл
		Если УникальныеЗначения[АдресКонтрагента.Представление] = Неопределено Тогда
			УникальныеЗначения[АдресКонтрагента.Представление] = Новый Структура;
			УникальныеЗначения[АдресКонтрагента.Представление].Вставить("Значение", АдресКонтрагента.Значение);
			УникальныеЗначения[АдресКонтрагента.Представление].Вставить("ЗначенияПолей", АдресКонтрагента.ЗначенияПолей);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекЭлемент Из УникальныеЗначения Цикл
		ДобавляемоеЗначение = Новый Структура;
		ДобавляемоеЗначение.Вставить("АдресДоставки", ТекЭлемент.Ключ);
		ДобавляемоеЗначение.Вставить("АдресДоставкиЗначение", ТекЭлемент.Значение.Значение);
		ДобавляемоеЗначение.Вставить("АдресДоставкиЗначенияПолей", ТекЭлемент.Значение.ЗначенияПолей);
		Результат.Добавить(ДобавляемоеЗначение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВидыКИАдресаДоставки()
	
	Результат = Новый Массив;
	Результат.Добавить(Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
	Результат.Добавить(Справочники.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПолучениеСтраниц

&НаСервере
Функция ПолучитьСтраницуКаталога(Родитель = Неопределено, ТекстДляПоиска = "", СписокОтображаемойНоменклатуры = Неопределено)
	
	Запрос = Новый Запрос;
	Если ФОКиоска.КаталогИзПрайсЛиста Тогда
		
		лРодитель = ПолучитьСсылкуНаСправочник("ПрайсЛист", Родитель);
		
		Запрос.Текст = "ВЫБРАТЬ
		|	СпрПрайсЛисты.Ссылка КАК Ссылка,
		|	СпрПрайсЛисты.Номенклатура КАК Номенклатура,
		|	СпрПрайсЛисты.Родитель КАК Родитель,
		|	СпрПрайсЛисты.ЭтоГруппа КАК ЭтоГруппа,
		|	СпрПрайсЛисты.Код КАК Код,
		|	СпрПрайсЛисты.Наименование КАК Наименование,
		|	СпрНоменклатура.Комментарий КАК Описание,
		|	СпрНоменклатура.ФайлКартинки КАК ФайлКартинки,
		|	СпрНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры
		|ПОМЕСТИТЬ ОсновныеДанные
		|ИЗ
		|	Справочник.ор_ПрайсЛистИнформационногоКиоска КАК СпрПрайсЛисты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО СпрПрайсЛисты.Номенклатура = СпрНоменклатура.Ссылка
		|ГДЕ
		|	НЕ СпрПрайсЛисты.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОсновныеДанные.Ссылка КАК Ссылка,
		|	ОсновныеДанные.Номенклатура КАК Номенклатура,
		|	ОсновныеДанные.Родитель КАК Родитель,
		|	ОсновныеДанные.ЭтоГруппа КАК ЭтоГруппа,
		|	ОсновныеДанные.Код КАК Код,
		|	ОсновныеДанные.Наименование КАК Наименование,
		|	ОсновныеДанные.Описание КАК Описание,
		|	ОсновныеДанные.ФайлКартинки КАК ФайлКартинки
		|ИЗ
		|	ОсновныеДанные КАК ОсновныеДанные
		|ГДЕ
		|	&Отборы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭтоГруппа УБЫВ,
		|	Наименование";
		
	Иначе
		
		лРодитель = ПолучитьСсылкуНаСправочник("Номенклатура", Родитель);
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ОсновныеДанные.Ссылка КАК Ссылка,
		|	ОсновныеДанные.Ссылка КАК Номенклатура,
		|	ОсновныеДанные.Родитель КАК Родитель,
		|	ОсновныеДанные.ЭтоГруппа КАК ЭтоГруппа,
		|	ОсновныеДанные.Код КАК Код,
		|	ОсновныеДанные.Наименование КАК Наименование,
		|	ОсновныеДанные.Комментарий КАК Описание,
		|	ОсновныеДанные.ФайлКартинки КАК ФайлКартинки
		|ИЗ
		|	Справочник.Номенклатура КАК ОсновныеДанные
		|ГДЕ
		|	НЕ ОсновныеДанные.ПометкаУдаления
		|	И &Отборы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭтоГруппа УБЫВ,
		|	Наименование";
		
		
	КонецЕсли;
	
	Если СписокОтображаемойНоменклатуры <> Неопределено Тогда
		Запрос.УстановитьПараметр("ДоступныеТипыНоменклатуры", КэшЗначений.ДоступныеТипыНоменклатуры);
		Запрос.УстановитьПараметр("СписокОтображаемойНоменклатуры", СписокОтображаемойНоменклатуры);
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&Отборы",
			"НЕ ОсновныеДанные.ЭтоГруппа
			|	И ОсновныеДанные.ТипНоменклатуры В(&ДоступныеТипыНоменклатуры)
			|	И ОсновныеДанные.Ссылка В(&СписокОтображаемойНоменклатуры)");
	ИначеЕсли ТекстДляПоиска <> "" Тогда
		Запрос.УстановитьПараметр("ДоступныеТипыНоменклатуры", КэшЗначений.ДоступныеТипыНоменклатуры);
		Запрос.УстановитьПараметр("ТекстДляПоиска", ТекстДляПоиска);
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&Отборы",
			"НЕ ОсновныеДанные.ЭтоГруппа
			|	И ОсновныеДанные.ТипНоменклатуры В(&ДоступныеТипыНоменклатуры)
			|	И ОсновныеДанные.Наименование ПОДОБНО ""%"" + &ТекстДляПоиска + ""%""");
	ИначеЕсли лРодитель.ЭтоГруппа ИЛИ лРодитель.Пустая() Тогда
		Запрос.УстановитьПараметр("Родитель", лРодитель);
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&Отборы",
			"ОсновныеДанные.Родитель = &Родитель");
	Иначе
		// Для вывода пустого результата,
		// данная ситуация исключительная и воспроизводиться при нормальной работе не должна.
		Запрос.УстановитьПараметр("Отборы", Ложь);
	КонецЕсли;
	
	СтрокиСкрипта = Новый Массив;
	СтрокиСкрипта.Добавить("let CatalogItem = {};");
	
	ЗаголовокКаталога = ?(лРодитель.Пустая(), "Каталог", Строка(лРодитель));
	ЗаголовокКаталога = ПолучитьСтрокуТекстаДляJS(ЗаголовокКаталога);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		
		СчС = 0;
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СсылкаНаНоменклатуру = Выборка.Номенклатура;
			МинМаксЦена = "";
			Картинка    = "";
			
			Если НЕ Выборка.ЭтоГруппа Тогда
				Картинка = ПолучитьКартинкуТовара(Выборка.ФайлКартинки);
				МинМаксЦена = ОпределитьМинМаксЦеныТовара(СсылкаНаНоменклатуру);
			КонецЕсли;
			
			ВыборкаНаименование = СократитьСтрокуДоНужногоКоличестваСимволов(Выборка.Наименование, 42);
			ВыборкаНаименование = ПолучитьСтрокуТекстаДляJS(ВыборкаНаименование);
			ВыборкаОписание     = ПолучитьСтрокуТекстаДляJS(Выборка.Описание);
			
			СтрокиСкрипта.Добавить("CatalogItem = {};");
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.ID            = '%1';", Выборка.Ссылка.УникальныйИдентификатор()));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.Name          = '%1';", ВыборкаНаименование));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.Group         = %1;", ПривестиБулевоКФорматуJS(Выборка.ЭтоГруппа)));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.Picture       = '%1';", Картинка));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.Description   = '%1';", ВыборкаОписание));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.Price         = '%1';", МинМаксЦена));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.CatalogName   = '%1';", ЗаголовокКаталога));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.SearchingText = '%1';", ТекстДляПоиска));
			СтрокиСкрипта.Добавить(СтрШаблон("CatalogItems[%1] = CatalogItem;", Формат(СчС, "ЧН=; ЧГ=")));
			
			СчС = СчС + 1;
		КонецЦикла;
	Иначе
		
		СтрокиСкрипта.Добавить("CatalogItem = {};");
		СтрокиСкрипта.Добавить(СтрШаблон("CatalogItem.CatalogName = '%1'", ЗаголовокКаталога));
		Если ЗначениеЗаполнено(ТекстДляПоиска)Тогда
			СтрокиСкрипта.Добавить(СтрШаблон(
				"CatalogItem.FindResult = 'По запросу ""%1"" ничего не найдено.';",
				ПолучитьСтрокуТекстаДляJS(ТекстДляПоиска)));
		Иначе
			СтрокиСкрипта.Добавить("CatalogItem.FindResult = '';");
		КонецЕсли;
		СтрокиСкрипта.Добавить("CatalogItem.Name          = 'Пустой заголовок';");
		СтрокиСкрипта.Добавить("CatalogItem.Description   = 'Пустое описание';");
		СтрокиСкрипта.Добавить("CatalogItem.Price         = '0';");
		СтрокиСкрипта.Добавить("CatalogItem.SearchingText = '';");
		СтрокиСкрипта.Добавить("CatalogItems[0] = CatalogItem;");
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиСкрипта, Символы.ПС);
	
КонецФункции

&НаСервере
Функция ПолучитьСтраницуТовара(ТоварИД, ЭтоСобытиеПодключаемогоОборудования = Ложь)
	
	СтрокиСкрипта = Новый Массив;
	
	Если ФОКиоска.КаталогИзПрайсЛиста
		И Не ЭтоСобытиеПодключаемогоОборудования Тогда
		СсылкаВПрайсЛисте = ПолучитьСсылкуНаСправочник("ПрайсЛист", ТоварИД);
		Товар = СсылкаВПрайсЛисте.Номенклатура;
	Иначе
		Товар = ПолучитьСсылкуНаСправочник("Номенклатура", ТоварИД);
	КонецЕсли;
	
	// Получение скидок на товар.
	СтрокиСкрипта.Добавить("let Actions = [];");
	СтрокиСкрипта.Добавить("let Action = {};");
	
	ТаблицаСкидок = ПолучитьТаблицуАвтоматическихСкидокДляРозничнойТорговли(Товар);
	СчС = 0;
	Для Каждого ТекущиеДанные Из ТаблицаСкидок Цикл
		
		СкидкаНаименование = ПолучитьСтрокуТекстаДляJS(ТекущиеДанные.СкидкаНаценка);
		СкидкаУИД          = ТекущиеДанные.СкидкаНаценка.УникальныйИдентификатор();
		СкидкаДействует    = ?(ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания),
			СтрШаблон(НСтр("ru = 'До %1'"), Формат(ТекущиеДанные.ДатаОкончания, "ДЛФ=ДД")),
			НСтр("ru = 'На постоянной основе'"));
		
		ЗначениеСкидки = "";
		Если ТекущиеДанные.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Процент Тогда
			ЗначениеСкидки = СтрШаблон(НСтр("ru = '%1 %%.'"), ТекущиеДанные.ЗначениеСкидкиНаценки);
		ИначеЕсли ТекущиеДанные.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Сумма Тогда
			ЗначениеСкидки = СтрШаблон(НСтр("ru = '%1 р.'"), ТекущиеДанные.ЗначениеСкидкиНаценки);
		ИначеЕсли ТекущиеДанные.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Подарок Тогда
			ЗначениеСкидки = НСтр("ru = 'Подарок'");
		КонецЕсли;
		
		СтрокиСкрипта.Добавить("Action = {};");
		СтрокиСкрипта.Добавить(СтрШаблон("Action.ID    = '%1';", СкидкаУИД));
		СтрокиСкрипта.Добавить(СтрШаблон("Action.Name    = '%1';", СкидкаНаименование));
		СтрокиСкрипта.Добавить(СтрШаблон("Action.Valid    = '%1';", СкидкаДействует));
		СтрокиСкрипта.Добавить(СтрШаблон("Action.Value    = '%1';", ЗначениеСкидки));
		СтрокиСкрипта.Добавить(СтрШаблон("Action.Description = '%1';", ПолучитьСтрокуТекстаДляJS(ТекущиеДанные.Описание)));
		
		СтрокиСкрипта.Добавить(СтрШаблон("Actions[%1] = Action;", Формат(СчС, "ЧН=; ЧГ=")));
		
		СчС = СчС + 1;
	КонецЦикла;
	
	СтрокиСкрипта.Добавить("Item.Actions = Actions;");
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос = ЗапросЦенИОстатков(Товар);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
	// Получение остатков по всем магазинам.
	СтрокиСкрипта.Добавить("let QuantityShops = [];");
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ОсновныеДанные.ТорговыйОбъект КАК ТорговыйОбъект,
	|	СУММА(ОсновныеДанные.КоличествоОстаток) КАК Количество
	|ИЗ
	|	ОсновныеДанные КАК ОсновныеДанные
	|ГДЕ
	|	НЕ ОсновныеДанные.ТорговыйОбъект = &ТорговыйОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	ОсновныеДанные.ТорговыйОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновныеДанные.ТорговыйОбъект";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СчС = 0;
	СтрокиСкрипта.Добавить("let QuantityShop = {};");
	Пока Выборка.Следующий() Цикл
		СтрокиСкрипта.Добавить("QuantityShop = {};");
		
		СтрокиСкрипта.Добавить(СтрШаблон("QuantityShop.ID       = '%1';", Выборка.ТорговыйОбъект.УникальныйИдентификатор()));
		СтрокиСкрипта.Добавить(СтрШаблон("QuantityShop.Name     = '%1';", ПолучитьСтрокуТекстаДляJS(Выборка.ТорговыйОбъект)));
		СтрокиСкрипта.Добавить(СтрШаблон("QuantityShop.Quantity = '%1';", ПривестиЧислоКФорматуJS(Выборка.Количество)));
		
		СтрокиСкрипта.Добавить(СтрШаблон("QuantityShops[%1] = QuantityShop;", Формат(СчС, "ЧН=; ЧГ=")));
		СчС = СчС + 1;
	КонецЦикла;
	СтрокиСкрипта.Добавить("Item.QuantityShops = QuantityShops;");
	
	// Получение данных по характеристикам.
	СтрокиСкрипта.Добавить("let Сharacteristics = [];");
	СтрокиСкрипта.Добавить("let Characteristic = {};");
	
	МинЦена  = 0;
	МаксЦена = 0;
	ВладелецыХарактеристики = ПолучитьВладельцевХарактеристики(Товар);
	ДляТовараХарактеристикиИспользуются = ВладелецыХарактеристики.Количество() > 0;
	Если ДляТовараХарактеристикиИспользуются Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	СпрХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
		|	СУММА(ЕСТЬNULL(ОсновныеДанные.КоличествоОстаток, 0)) КАК Количество,
		|	МАКСИМУМ(ЕСТЬNULL(ОсновныеДанные.Цена, 0)) КАК Цена
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОсновныеДанные КАК ОсновныеДанные
		|		ПО СпрХарактеристикиНоменклатуры.Ссылка = ОсновныеДанные.Характеристика
		|			И (ОсновныеДанные.ТорговыйОбъект = &ТорговыйОбъект)
		|ГДЕ
		|	СпрХарактеристикиНоменклатуры.Владелец В (&ВладелецыХарактеристики)
		|
		|СГРУППИРОВАТЬ ПО
		|	СпрХарактеристикиНоменклатуры.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	СпрХарактеристикиНоменклатуры.Ссылка";
		
		Запрос.УстановитьПараметр("ВладелецыХарактеристики", ВладелецыХарактеристики);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		СчС = 0;
		НоменклатураУИД = Товар.УникальныйИдентификатор();
		Пока Выборка.Следующий() Цикл
			
			ХарактеристикаНаименование = ПолучитьСтрокуТекстаДляJS(Выборка.Характеристика);
			ХарактеристикаУИД          = Выборка.Характеристика.УникальныйИдентификатор();
			ХарактеристикаЦена         = Выборка.Цена;
			
			СтрокиСкрипта.Добавить("Characteristic = {};");
			
			СтрокиСкрипта.Добавить(СтрШаблон("Characteristic.ID       = '%1';", ХарактеристикаУИД));
			СтрокиСкрипта.Добавить(СтрШаблон("Characteristic.IdOwner  = '%1';", НоменклатураУИД));
			СтрокиСкрипта.Добавить(СтрШаблон("Characteristic.Name     = '%1';", ХарактеристикаНаименование));
			СтрокиСкрипта.Добавить(СтрШаблон("Characteristic.Price    = '%1';", ХарактеристикаЦена));
			СтрокиСкрипта.Добавить(СтрШаблон("Characteristic.Quantity = %1;", ПривестиЧислоКФорматуJS(Выборка.Количество)));
			
			СтрокиСкрипта.Добавить(СтрШаблон("Сharacteristics[%1] = Characteristic;", Формат(СчС, "ЧН=; ЧГ=")));
			СчС = СчС + 1;
			
			// Определение макс и мин цены
			Если ХарактеристикаЦена <> 0 Тогда
				Если МинЦена = 0 Тогда
					МинЦена = ХарактеристикаЦена;
				Иначе
					МинЦена = Мин(МинЦена, ХарактеристикаЦена);
				КонецЕсли;
				МаксЦена = Макс(МаксЦена, ХарактеристикаЦена);;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	СтрокиСкрипта.Добавить("Item.Сharacteristics = Сharacteristics;");
	
	// Получение данных по товару.
	Запрос.Текст = ПолучитьТекстЗапросаПоДополнительнымХарактеристикам();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Картинка = ПолучитьКартинкуТовара(Выборка.ФайлКартинки);
		
		СтрокиСкрипта.Добавить(СтрШаблон("Item.ID          = '%1';", Выборка.Ссылка.УникальныйИдентификатор()));
		СтрокиСкрипта.Добавить(СтрШаблон("Item.Name        = '%1';", ПолучитьСтрокуТекстаДляJS(Выборка.Ссылка)));
		СтрокиСкрипта.Добавить(СтрШаблон("Item.Picture     = '%1';", Картинка));
		СтрокиСкрипта.Добавить(СтрШаблон("Item.Description = '%1';", ПолучитьСтрокуТекстаДляJS(Выборка.Описание)));
		
		Если ДляТовараХарактеристикиИспользуются Тогда
			ПодставляемаяЦена = ?(МинЦена = МаксЦена, МинЦена, СтрШаблон("%1 - %2", МинЦена, МаксЦена));
		Иначе
			ПодставляемаяЦена = Выборка.Цена;
		КонецЕсли;
		СтрокиСкрипта.Добавить(СтрШаблон("Item.Price                = '%1';", ПодставляемаяЦена));
		СтрокиСкрипта.Добавить(СтрШаблон("Item.Quantity             = %1;", ПривестиЧислоКФорматуJS(Выборка.Количество)));
		СтрокиСкрипта.Добавить(СтрШаблон("Item.ItIsAGoods           = %1;", ПривестиБулевоКФорматуJS(Выборка.ЭтоТовар)));
		СтрокиСкрипта.Добавить(СтрШаблон("Item.ControlBalancesGoods = %1;", ПривестиБулевоКФорматуJS(КонтролироватьОстаткиТоваров)));
		
		// Дополнительные характеристики.
		СтрокиСкрипта.Добавить(СтрШаблон("Item.DopCharacteristics = '%1';", ПолучитьДополнительныеХарактеристикиТовара(Выборка)));
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиСкрипта, Символы.ПС);
	
КонецФункции

&НаСервере
Функция ПолучитьСтраницуАкций()
	
	СтрокиСкрипта = Новый Массив;
	СтрокиСкрипта.Добавить("let Action = {};");
	Если ФОКиоска.Акции Тогда
		
		ТаблицаСкидок = ПолучитьТаблицуАвтоматическихСкидокДляРозничнойТорговли();
		
		СчА = 0;
		Для Каждого ТекСтрока Из ТаблицаСкидок Цикл
			СкидкаНаименование = ПолучитьСтрокуТекстаДляJS(ТекСтрока.Наименование);
			
			СкидкаУИД = ТекСтрока.СкидкаНаценка.УникальныйИдентификатор();
			
			СкидкаДействует = ?(ЗначениеЗаполнено(ТекСтрока.ДатаОкончания),
				СтрШаблон(НСтр("ru = 'До %1'"), Формат(ТекСтрока.ДатаОкончания, "ДЛФ=ДД")),
				НСтр("ru = 'На постоянной основе'"));
			
			ЗначениеСкидки = "";
			Если ТекСтрока.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Процент Тогда
				ЗначениеСкидки = СтрШаблон(НСтр("ru = '%1 %%.'"), ТекСтрока.ЗначениеСкидкиНаценки);
			ИначеЕсли ТекСтрока.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Сумма Тогда
				ЗначениеСкидки = СтрШаблон(НСтр("ru = '%1 р.'"), ТекСтрока.ЗначениеСкидкиНаценки);
			ИначеЕсли ТекСтрока.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Подарок Тогда
				ЗначениеСкидки = НСтр("ru = 'Подарок'");
			КонецЕсли;
			
			СтрокиСкрипта.Добавить("Action = {};");
			СтрокиСкрипта.Добавить(СтрШаблон("Action.ID    = '%1';", СкидкаУИД));
			СтрокиСкрипта.Добавить(СтрШаблон("Action.Name    = '%1';", СкидкаНаименование));
			СтрокиСкрипта.Добавить(СтрШаблон("Action.Valid    = '%1';", СкидкаДействует));
			СтрокиСкрипта.Добавить(СтрШаблон("Action.Value    = '%1';", ЗначениеСкидки));
			СтрокиСкрипта.Добавить(СтрШаблон("Action.Description = '%1';", ПолучитьСтрокуТекстаДляJS(ТекСтрока.Описание)));
			
			СтрокиСкрипта.Добавить(СтрШаблон("Actions[%1] = Action;", Формат(СчА, "ЧН=; ЧГ=")));
			
			СчА = СчА + 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиСкрипта, Символы.ПС);
	
КонецФункции

&НаСервере
Функция ПолучитьСтраницуОМагазине()
	
	СтрокиСкрипта = Новый Массив;
	СтрокиСкрипта.Добавить("let ShopsInfo = [];");
	
	ОписаниеЕсть = Ложь;
	Если ФОКиоска.ОМагазине Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	СтруктурныеЕдиницы.Ссылка КАК Магазин,
		|	ЕСТЬNULL(СтруктурныеЕдиницыКонтактнаяИнформация.Представление, """") КАК ПредставлениеКонтактнойИнформации,
		|	ЕСТЬNULL(СтруктурныеЕдиницыКонтактнаяИнформация.Тип, ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.ПустаяСсылка)) КАК ТипКонтактнойИнформации,
		|	ВЫБОР
		|		КОГДА СтруктурныеЕдиницы.Ссылка = &ТекущийМагазин
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоТекущийМагазинПродажи,
		|	СтруктурныеЕдиницы.Наименование КАК НаименованиеМагазина
		|ИЗ
		|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы.КонтактнаяИнформация КАК СтруктурныеЕдиницыКонтактнаяИнформация
		|		ПО СтруктурныеЕдиницы.Ссылка = СтруктурныеЕдиницыКонтактнаяИнформация.Ссылка
		|			И (СтруктурныеЕдиницыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|				ИЛИ СтруктурныеЕдиницыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
		|ГДЕ
		|	СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭтоТекущийМагазинПродажи УБЫВ,
		|	Магазин
		|ИТОГИ
		|	МАКСИМУМ(ЭтоТекущийМагазинПродажи),
		|	МАКСИМУМ(НаименованиеМагазина)
		|ПО
		|	Магазин");
		
		Запрос.УстановитьПараметр("ТекущийМагазин", Объект.ТорговыйОбъект);
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		СтрокиСкрипта.Добавить("let ShopInfo = {};");
		
		СчС = 0;
		Пока Выборка.Следующий() Цикл
			
			МагазинНаименование = ПолучитьСтрокуТекстаДляJS(Выборка.НаименованиеМагазина);
			Если Выборка.ЭтоТекущийМагазинПродажи Тогда
				СтрокиСкрипта.Добавить(СтрШаблон("AboutShop.Name = '%1';", МагазинНаименование));
				СтрокиСкрипта.Добавить("AboutShop.Logo = 'images\\icons\\logo.png';");
				
				ОписаниеЕсть = Истина;
			КонецЕсли;
			
			СтрокиСкрипта.Добавить("ShopInfo = {};");
			СтрокиСкрипта.Добавить(СтрШаблон("ShopInfo.Name = '%1';", МагазинНаименование));
			СтрокиСкрипта.Добавить(СтрШаблон("ShopInfo.CurrentShop = %1;", ПривестиБулевоКФорматуJS(Выборка.ЭтоТекущийМагазинПродажи)));
			
			ДобавитьДанныеПоГрафикуРаботы(СтрокиСкрипта, Выборка.Магазин);
			
			ВыборкаДетали = Выборка.Выбрать();
			
			АдресМагазина = "";
			ТелефонМагазина = "";
			Пока ВыборкаДетали.Следующий() Цикл
				МагазинКИПредставление = ПолучитьСтрокуТекстаДляJS(ВыборкаДетали.ПредставлениеКонтактнойИнформации);
				
				Если ПустаяСтрока(АдресМагазина)
					И ВыборкаДетали.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
					АдресМагазина = МагазинКИПредставление;
				КонецЕсли;
				
				Если ПустаяСтрока(ТелефонМагазина)
					И ВыборкаДетали.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
					ТелефонМагазина = МагазинКИПредставление;
				КонецЕсли;
			КонецЦикла;
			
			СтрокиСкрипта.Добавить(СтрШаблон("ShopInfo.Address = '%1';", АдресМагазина));
			СтрокиСкрипта.Добавить(СтрШаблон("ShopInfo.Telephone = '%1';", ТелефонМагазина));
			
			СтрокиСкрипта.Добавить(СтрШаблон("ShopsInfo[%1] = ShopInfo;", Формат(СчС, "ЧН=; ЧГ=")));
			
			СчС = СчС + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ОписаниеЕсть Тогда
		СтрокиСкрипта.Добавить("AboutShop.Name  = 'Нет заголовка магазина';");
		СтрокиСкрипта.Добавить("AboutShop.Logo = 'images\\icons\\logo.png';");
		СтрокиСкрипта.Добавить("AboutShop.Description = 'Нет описания';");
	КонецЕсли;
	
	СтрокиСкрипта.Добавить("AboutShop.ShopsInfo = ShopsInfo;");
	
	Возврат СтрСоединить(СтрокиСкрипта, Символы.ПС);
	
КонецФункции

&НаСервере
Процедура ДобавитьДанныеПоГрафикуРаботы(СтрокиСкрипта, СтруктурнаяЕдиница)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГрафикиРаботыСтруктурныхЕдиниц.ГрафикРаботы КАК ГрафикРаботы
	|ПОМЕСТИТЬ ГрафикиРаботы
	|ИЗ
	|	РегистрСведений.ГрафикиРаботыСтруктурныхЕдиниц КАК ГрафикиРаботыСтруктурныхЕдиниц
	|ГДЕ
	|	ГрафикиРаботыСтруктурныхЕдиниц.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|	И НЕ ГрафикиРаботыСтруктурныхЕдиниц.ГрафикРаботы = ЗНАЧЕНИЕ(Справочник.ГрафикиРаботы.ПустаяСсылка)
	|	И ГОД(ГрафикиРаботыСтруктурныхЕдиниц.Период) = &НомерГода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГрафикиРаботыРасписаниеРаботы.НомерДняЦикла КАК НомерДня,
	|	ГрафикиРаботыРасписаниеРаботы.ВремяНачала КАК ВремяНачала,
	|	ГрафикиРаботыРасписаниеРаботы.ВремяОкончания КАК ВремяОкончания
	|ИЗ
	|	ГрафикиРаботы КАК ГрафикиРаботы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГрафикиРаботы.РасписаниеРаботы КАК ГрафикиРаботыРасписаниеРаботы
	|		ПО ГрафикиРаботы.ГрафикРаботы = ГрафикиРаботыРасписаниеРаботы.Ссылка
	|ГДЕ
	|	ГрафикиРаботыРасписаниеРаботы.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерДняЦикла";
	
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("НомерГода", Год(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ТекущаяДатаСеанса()));
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаПоВремени = ТаблицаДанных.Скопировать(, "ВремяНачала, ВремяОкончания");
	ТаблицаПоВремени.Свернуть("ВремяНачала, ВремяОкончания");
	
	СписокИменДней = Новый Массив;
	СписокИменДней.Добавить(НСтр("ru = 'пн'"));
	СписокИменДней.Добавить(НСтр("ru = 'вт'"));
	СписокИменДней.Добавить(НСтр("ru = 'ср'"));
	СписокИменДней.Добавить(НСтр("ru = 'чт'"));
	СписокИменДней.Добавить(НСтр("ru = 'пт'"));
	СписокИменДней.Добавить(НСтр("ru = 'сб'"));
	СписокИменДней.Добавить(НСтр("ru = 'вс'"));
	
	СтрокаВремяРаботы = "";
	Для Каждого ТекущееВремя Из ТаблицаПоВремени Цикл
		
		ВремяРаботы = СтрШаблон("%1-%2", Формат(ТекущееВремя.ВремяНачала, "ДФ=""ЧЧ:мм"""), Формат(ТекущееВремя.ВремяОкончания, "ДФ=""ЧЧ:мм"""));
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ВремяНачала", ТекущееВремя.ВремяНачала);
		СтруктураОтбора.Вставить("ВремяОкончания", ТекущееВремя.ВремяОкончания);
		НайденныеСтроки = ТаблицаДанных.НайтиСтроки(СтруктураОтбора);
		
		СписокДней = Новый Массив;
		ПервыйДеньИнтервала = -1;
		ПоследнийДеньИнтервала = -1;
		Для Каждого ТекущиеДанные Из НайденныеСтроки Цикл
			
			ТекущийНомерДня = ТекущиеДанные.НомерДня - 1;
			
			Если ПервыйДеньИнтервала = -1 Тогда
				ПервыйДеньИнтервала = ТекущийНомерДня;
			КонецЕсли;
			Если ПоследнийДеньИнтервала = -1 Тогда
				ПоследнийДеньИнтервала = ТекущийНомерДня;
			КонецЕсли;
			
			// Строки упорядочены по номеру дня, так что ситуаций
			// когда Текущий номер дня больше Первого дня интервала не должно быть.
			Если ТекущийНомерДня <= ПоследнийДеньИнтервала Тогда
				Продолжить;
			ИначеЕсли ТекущийНомерДня = ПоследнийДеньИнтервала + 1 Тогда
				ПоследнийДеньИнтервала = ТекущийНомерДня;
				Продолжить;
			Иначе
				Если ПервыйДеньИнтервала = ПоследнийДеньИнтервала Тогда
					СписокДней.Добавить(СписокИменДней[ПервыйДеньИнтервала]);
				ИначеЕсли ПервыйДеньИнтервала + 1 = ПоследнийДеньИнтервала Тогда
					// Если это два последовательных дня, то нет смысла записывать их как интервал.
					СписокДней.Добавить(СписокИменДней[ПервыйДеньИнтервала]);
					СписокДней.Добавить(СписокИменДней[ПоследнийДеньИнтервала]);
				Иначе
					СписокДней.Добавить(СтрШаблон("%1-%2", СписокИменДней[ПервыйДеньИнтервала], СписокИменДней[ПоследнийДеньИнтервала]));
				КонецЕсли;
				ПервыйДеньИнтервала    = ТекущийНомерДня;
				ПоследнийДеньИнтервала = ТекущийНомерДня;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаВремяРаботы ="<b>" + СтрСоединить(СписокДней, ", ") + ": </b></br>" + ВремяРаботы;
		
	КонецЦикла;
	
	СтрокиСкрипта.Добавить(СтрШаблон("ShopInfo.OperatingTime = '%1';", СтрокаВремяРаботы));
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтраницуИнформацияПоДисконту(ДисконтнаяКарта = Неопределено)
	
	СтрокиДисконта = Новый Массив;
	ДобавитьЗаглушку = Истина;
	
	Если ФОКиоска.ИнформацияПоКарте
		И ДисконтнаяКарта <> Неопределено Тогда
		
		ЗапросПоДисконту = Новый Запрос;
		
		ЗапросПоДисконту.Текст = "ВЫБРАТЬ
		|	ДисконтныеКарты.КодКартыШтрихкод КАК КодКартыШтрихкод,
		|	ДисконтныеКарты.КодКартыМагнитный КАК КодКартыМагнитный,
		|	ДисконтныеКарты.ВладелецКарты КАК ВладелецКарты,
		|	ДисконтныеКарты.Владелец КАК ВидДисконтнойКарты,
		|	ЕСТЬNULL(ПродажиПоКартамОбороты.СуммаОборот, 0) КАК СуммаНакопления
		|ИЗ
		|	Справочник.ДисконтныеКарты КАК ДисконтныеКарты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПродажиПоДисконтнымКартам.Обороты(, , , ДисконтнаяКарта = &ДисконтнаяКарта) КАК ПродажиПоКартамОбороты
		|		ПО ДисконтныеКарты.Ссылка = ПродажиПоКартамОбороты.ДисконтнаяКарта
		|ГДЕ
		|	ДисконтныеКарты.Ссылка = &ДисконтнаяКарта";
		
		ЗапросПоДисконту.УстановитьПараметр("ДисконтнаяКарта", ДисконтнаяКарта);
		
		Результат = ЗапросПоДисконту.Выполнить();
		Если Не Результат.Пустой() Тогда
			
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			
			ВладелецКарты = ПолучитьСтрокуТекстаДляJS(Выборка.ВладелецКарты);
			КодКарты      = ?(ПустаяСтрока(Выборка.КодКартыМагнитный), Выборка.КодКартыШтрихкод, Выборка.КодКартыМагнитный);
			ВидКарты      = ПолучитьСтрокуТекстаДляJS(Выборка.ВидДисконтнойКарты);
			
			СтруктураСкидки = ПолучитьПроцентСкидкиПоДисконтнойКарте();
			
			СтрокиОписанийСкидки = Новый Массив;
			СтрокиОписанийСкидки.Добавить(НСтр("ru = 'В зависимости от проходящих в магазине акций и условий предоставления скидок.'"));
			Если ЗначениеЗаполнено(СтруктураСкидки.СуммаСкидки) Тогда
				СтрокиОписанийСкидки.Добавить(СтрШаблон(НСтр("ru  = 'В денежном выражении %1'"), СтруктураСкидки.СуммаСкидки));
			КонецЕсли;
			Если ЗначениеЗаполнено(СтруктураСкидки.ПроцентСкидки) Тогда
				СтрокиОписанийСкидки.Добавить(СтрШаблон(НСтр("ru  = 'В процентах %1'"), СтруктураСкидки.ПроцентСкидки));
			КонецЕсли;
			
			ПредоставляемаяСкидка = "";
			Если СтрокиОписанийСкидки.Количество() > 1 Тогда
				ПредоставляемаяСкидка = СтрСоединить(СтрокиОписанийСкидки, Символы.ПС);
			КонецЕсли;
			
			СуммаНакопления = СтрШаблон(НСтр("ru  = 'За весь период %1 р.'"), Выборка.СуммаНакопления);
			
			СтрокиДисконта.Добавить(СтрШаблон("CardInfo.CardHolder = '%1';", ВладелецКарты));
			СтрокиДисконта.Добавить(СтрШаблон("CardInfo.CardCode = '%1';", КодКарты));
			СтрокиДисконта.Добавить(СтрШаблон("CardInfo.CardType = '%1';", ВидКарты));
			СтрокиДисконта.Добавить(СтрШаблон("CardInfo.Discount = '%1';", ПредоставляемаяСкидка));
			СтрокиДисконта.Добавить(СтрШаблон("CardInfo.AccumulatingSum = '%1';", СуммаНакопления));
			
			ДобавитьЗаглушку = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДобавитьЗаглушку Тогда
		СтрокиДисконта.Добавить("CardInfo.CardHolder = '';");
		СтрокиДисконта.Добавить("CardInfo.CardCode = '';");
		СтрокиДисконта.Добавить("CardInfo.CardType = '';");
		СтрокиДисконта.Добавить("CardInfo.Discount = '';");
		СтрокиДисконта.Добавить("CardInfo.AccumulatingSum = '';");
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиДисконта, Символы.ПС);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьСимволы(Знач Строка)
	Результат = СтрЗаменить(Строка, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, """", "\""");
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьКартинкуТовара(ФайлКартинки)
	
	ДанныеФайла = РаботаСФайлами.ХранилищеФайлаИзИнформационнойБазы(ФайлКартинки);
	Если ДанныеФайла <> Неопределено Тогда
		Картинка = "data:image/" + ФайлКартинки.Расширение + ";base64,"
		+ СтрЗаменить(ПолучитьBase64СтрокуИзДвоичныхДанных(ДанныеФайла.Получить()),
			Символы.ВК + Символы.ПС, "");
	Иначе
		лПутьККиоску = СтрЗаменить(ПутьККиоску, "\", "\\");
		Картинка = "images\\icons\\goods-no-image.png";
	КонецЕсли;
	
	Возврат Картинка;
	
КонецФункции


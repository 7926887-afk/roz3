&НаКлиенте
Процедура ЗагрузитьHTMLСтраницу()
	
	ТемпКаталог = КаталогВременныхФайлов();
	
	ПутьКФайлуАрхива = ПолучитьИмяВременногоФайла("zip");
	
	// Записываем архив информационного киоска на диск.
	ДвоичныеДанные = ПолучитьМакетНаСервере();
	
	ДвоичныеДанные.Записать(ПутьКФайлуАрхива);
	
	// Извлекаем из архива файлы информационного киоска в каталог временных файлов.
	АрхивКиоска = Новый ЧтениеZipФайла(ПутьКФайлуАрхива);
	АрхивКиоска.ИзвлечьВсе(ТемпКаталог);
	
	// Получим директорию сайта.
	Путь = АрхивКиоска.Элементы[0].Путь;
	НомерСимвола = Найти(Путь, "/");
	
	Если НомерСимвола = 0 Тогда
		ПапкаКиоска = Путь;
	Иначе
		ПапкаКиоска = Сред(Путь, 1, НомерСимвола);
		ПапкаКиоска = СтрЗаменить(ПапкаКиоска, "/", "\");
	КонецЕсли;

	// Запомним путь к киоску.
	ПутьККиоску = ТемпКаталог + ПапкаКиоска;
	СборщикМусора(ПутьКФайлуАрхива, Истина);
	
	ПутьКВременнымФайламКиоска = ПутьККиоску + "temp\";
	
	ИнфоКиоск = ПутьККиоску + "main.html";
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СборщикМусора(Путь, ОдинФайл)
	
	Попытка
		Если ОдинФайл Тогда
			УдалитьФайлы(Путь);
		Иначе
			УдалитьФайлы(Путь, "*.*");
		КонецЕсли;
	Исключение
	КонецПопытки
	
КонецПроцедуры


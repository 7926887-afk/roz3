#Область РаботаСИсторией

&НаКлиенте
Процедура ПолучитьСтаруюСтраницу()
	
	// Определим адрес текущей страницы.
	Адрес = Элементы.ИнфоКиоск.Документ.url;
	Для Каждого АдресСписка Из СписокСтраниц Цикл
		Если Найти(Адрес, АдресСписка.Значение) <> 0 Тогда
			СтараяСтраница = АдресСписка.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаСоСтеком(КомандаСтека, АдресПерехода = "", СтраницаПерехода = "", КодСкрипта = "")
	
	Если КомандаСтека = "очистить" Тогда
		
		стекПереходов.Очистить();
		СтараяСтраница = Неопределено;
		
	ИначеЕсли КомандаСтека = "добавить" Тогда
		
		индексОтсечения = 0;
		Для Каждого страницаИстории Из стекПереходов Цикл
			Если страницаИстории.Пометка Тогда
				индексОтсечения = стекПереходов.Индекс(страницаИстории);
			КонецЕсли;
		КонецЦикла;
		
		колвоЭлем = стекПереходов.Количество()-1;
		Пока колвоЭлем > индексОтсечения Цикл
			удаляемыйЭлем = стекПереходов.Получить(колвоЭлем);
			стекПереходов.Удалить(удаляемыйЭлем);
			колвоЭлем = колвоЭлем - 1;
		КонецЦикла;
		
		СтруктураПереходов = Новый Структура;
		СтруктураПереходов.Вставить("АдресПерехода",    АдресПерехода);
		СтруктураПереходов.Вставить("СтраницаПерехода", СтраницаПерехода);
		СтруктураПереходов.Вставить("КодСкрипта",       КодСкрипта);
		
		стекПереходов.ЗаполнитьПометки(Ложь);
		
		стекПереходов.Добавить(СтруктураПереходов,,Истина);
		
	ИначеЕсли КомандаСтека = "отсечьДоКонца" Тогда
		
		индексОтсечения = 0;
		Для Каждого страницаИстории Из стекПереходов Цикл
			Если страницаИстории.Пометка Тогда
				индексОтсечения = стекПереходов.Индекс(страницаИстории);
			КонецЕсли;
		КонецЦикла;
		
		колвоЭлем = стекПереходов.Количество()-1;
		Пока колвоЭлем > индексОтсечения Цикл
			удаляемыйЭлем = стекПереходов.Получить(колвоЭлем);
			стекПереходов.Удалить(удаляемыйЭлем);
			колвоЭлем = колвоЭлем - 1;
		КонецЦикла;
		
	КонецЕсли
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруПоИД(ОбработатьКак, ИД)
	
	СсылкаНаЭлемент = ПолучитьСсылкуНаСправочник(ОбработатьКак, ИД);
	
	Структура = Новый Структура;
	Структура.Вставить("СсылкаНаЭлемент", СсылкаНаЭлемент);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СсылкаНаЭлемент, "ЭтоГруппа") Тогда
		Структура.Вставить("ЭтоГруппа", СсылкаНаЭлемент.ЭтоГруппа);
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции


	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УсловияПредоставленияСкидокНаценок КАК УсловияПредоставленияСкидокНаценок
	|		ПО УсловияПредоставления.УсловиеПредоставления = УсловияПредоставленияСкидокНаценок.Ссылка
	|ГДЕ
	|	УсловияПредоставленияСкидокНаценок.УсловиеПредоставления = ЗНАЧЕНИЕ(Перечисление.УсловияПредоставленияСкидокНаценок.ЗаНакопленныйОбъемПродаж)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УсловияПредоставления.ЗначениеСкидкиНаценки,
	|	УсловияПредоставления.СпособПредоставления
	|ИЗ
	|	УсловияПредоставления КАК УсловияПредоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УсловияПредоставленияСкидокНаценок КАК УсловияПредоставленияСкидокНаценок
	|		ПО УсловияПредоставления.УсловиеПредоставления = УсловияПредоставленияСкидокНаценок.Ссылка
	|ГДЕ
	|	УсловияПредоставленияСкидокНаценок.УсловиеПредоставления = ЗНАЧЕНИЕ(Перечисление.УсловияПредоставленияСкидокНаценок.ор_ПоДиапазонуНомеровКарт)
	|	И УсловияПредоставленияСкидокНаценок.Ссылка В
	|			(ВЫБРАТЬ
	|				ТаблицаУсловия.Ссылка
	|			ИЗ
	|				УсловияПредоставленияПоПрефиксамКарт КАК ТаблицаУсловия)";
	
	ВидДисконтнойКарты = Объект.ДисконтнаяКарта.Владелец;
	Запрос.УстановитьПараметр("ВидДисконтнойКарты", ВидДисконтнойКарты);
	
	Если ВидДисконтнойКарты.ТипКарты = Перечисления.ТипыКарт.Магнитная Тогда
		Запрос.УстановитьПараметр("НомерКарты", Объект.ДисконтнаяКарта.КодКартыМагнитный);
		Запрос.УстановитьПараметр("ТипКарты"  , Перечисления.ТипыКодовКарт.МагнитныйКод);
	Иначе
		Запрос.УстановитьПараметр("НомерКарты", Объект.ДисконтнаяКарта.КодКартыШтрихкод);
		Запрос.УстановитьПараметр("ТипКарты"  , Перечисления.ТипыКодовКарт.Штрихкод);
	КонецЕсли;
	
	СписокСумм      = Новый СписокЗначений;
	СписокПроцентов = Новый СписокЗначений;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Процент Тогда
			СписокПроцентов.Добавить(Выборка.ЗначениеСкидкиНаценки);
		ИначеЕсли Выборка.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Сумма Тогда
			СписокСумм.Добавить(Выборка.ЗначениеСкидкиНаценки);
		КонецЕсли;
		
	КонецЦикла;
	
	СписокСумм.СортироватьПоЗначению();
	СписокПроцентов.СортироватьПоЗначению();
	
	СуммаСкидки = "";
	Если СписокСумм.Количество() > 0 Тогда
		Если СписокСумм.Количество() = 1
			Или СписокСумм[0].Значение = СписокСумм[СписокСумм.Количество()-1] Тогда
			СуммаСкидки = СуммаСкидки + СтрШаблон(НСтр("ru = '%1 р.'"), СписокСумм[0].Значение);
		Иначе
			СуммаСкидки = СуммаСкидки
				+ СтрШаблон(НСтр("ru = 'от %1 до %2 р.'"), СписокСумм[0].Значение, СписокСумм[СписокСумм.Количество() - 1]);
		КонецЕсли;
	КонецЕсли;
	
	ПроцентСкидки = "";
	Если СписокПроцентов.Количество() > 0 Тогда
		Если СписокПроцентов.Количество() = 1
			Или СписокПроцентов[0].Значение = СписокПроцентов[СписокПроцентов.Количество()-1] Тогда
			ПроцентСкидки = ПроцентСкидки + Строка(СписокПроцентов[0].Значение);
		Иначе
			ПроцентСкидки = ПроцентСкидки
				+ СтрШаблон(НСтр("ru = 'от %1 до %2'"),
					СписокПроцентов[0].Значение,
					СписокПроцентов[СписокПроцентов.Количество() - 1].Значение);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураСкидки = Новый Структура;
	СтруктураСкидки.Вставить("СуммаСкидки", СуммаСкидки);
	СтруктураСкидки.Вставить("ПроцентСкидки", ПроцентСкидки);
	
	Возврат СтруктураСкидки;
	
КонецФункции

&НаСервере
Функция ЗапросДляАвтоматическихСкидок(СпособыПредоставления = Неопределено)
	
	Если СпособыПредоставления = Неопределено Тогда
		СпособыПредоставления = Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка КАК Склад,
	|	СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы КАК ТипСтруктурнойЕдиницы
	|ПОМЕСТИТЬ ДанныеТорговогоОбъекта
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|ГДЕ
	|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
	|	И СтруктурныеЕдиницы.Ссылка = &ТорговыйОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка КАК Склад
	|ПОМЕСТИТЬ ТаблицаСклады
	|ИЗ
	|	ДанныеТорговогоОбъекта КАК ДанныеТорговогоОбъекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ПО ДанныеТорговогоОбъекта.Склад = СтруктурныеЕдиницы.Родитель
	|ГДЕ
	|	ДанныеТорговогоОбъекта.ТипСтруктурнойЕдиницы = &ТипМагазинГруппаСкладов
	|	И СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы В(&МассивТиповСтруктурныхЕдиниц)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка
	|ИЗ
	|	ДанныеТорговогоОбъекта КАК ДанныеТорговогоОбъекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ПО ДанныеТорговогоОбъекта.Склад = СтруктурныеЕдиницы.Ссылка
	|;

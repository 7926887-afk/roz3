&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтрокуТекстаДляJS(СтрокаТекста)
	
	ФорматированнаяСтрока  = Строка(СтрокаТекста);
	ФорматированнаяСтрока = СтрЗаменить(ФорматированнаяСтрока, "'", "");
	ФорматированнаяСтрока = СокрЛП(ФорматированнаяСтрока);
	ФорматированнаяСтрока = СтрЗаменить(ФорматированнаяСтрока, Символы.ПС, "\" + Символы.ПС);
	
	Возврат ФорматированнаяСтрока
	
КонецФункции

&НаКлиенте
Процедура ОсуществитьПереходНаСтраницу(СтраницаПерехода)
	
	Если Найти(ИнфоКиоск, СтраницаПерехода+"#") Тогда
		ИнфоКиоск = ПутьККиоску + СтраницаПерехода;
	Иначе
		ИнфоКиоск = ПутьККиоску + СтраницаПерехода+"#";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СократитьСтрокуДоНужногоКоличестваСимволов(СтрокаТекста, КоличествоСимволов)
	
	ФорматированнаяСтрока = Строка(СтрокаТекста);
	
	ФорматированнаяСтрока = Сред(ФорматированнаяСтрока, 1, КоличествоСимволов);
	
	Возврат ФорматированнаяСтрока;
	
КонецФункции

// Проверяет вхождение полученного ИД товара в Прайс-лист информационного киоска
//
&НаСервере
Функция ЭтаНоменклатураВходитВСписокПрайсЛиста(ТоварИД)
	
	Товар = ПолучитьСсылкуНаСправочник("Номенклатура", ТоварИД);
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ПрайсЛист.Ссылка
	|ИЗ
	|	Справочник.ор_ПрайсЛистИнформационногоКиоска КАК ПрайсЛист
	|ГДЕ
	|	ПрайсЛист.Номенклатура = &Ссылка
	|	И НЕ ПрайсЛист.ПометкаУдаления
	|	И НЕ ПрайсЛист.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("Ссылка", Товар);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Процедура ПроверитьОбщуюВозможностьРаботы(Отказ, ТекстСообщения)
	
	ВалютаЗаполненаПравильно = Истина;
	ОбщегоНазначенияРМКПереопределяемый.ПроверитьВозможностьРаботыСВалютой(ВалютаЗаполненаПравильно, ЭтотОбъект);
	Если Не ВалютаЗаполненаПравильно Тогда
		ТекстСообщения = НСтр("ru = 'В настройках программы и в данных торгового объекта указаны разные валюты.
			|Обратитесь к администратору системы.'");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	СформироватьЗапросДанныеКассыККМ(Запрос);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПодключенныеККМПроверка = РезультатЗапроса.Выгрузить();
	ПодключенныеККМПроверка.Колонки.Добавить("Количество");
	ПодключенныеККМПроверка.ЗаполнитьЗначения(1, "Количество");
	ПодключенныеККМПроверкаККТ = ПодключенныеККМПроверка.Скопировать();
	
	ПодключенныеККМПроверка.Свернуть("Организация", "Количество");
	Для Каждого СтрокаОрганизации Из ПодключенныеККМПроверка Цикл
		Если СтрокаОрганизации.Количество > 1 Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'На организацию: %1 подключено несколько касс ККМ. Допустима одна.
				|Обратитесь к администратору системы.'"), СтрокаОрганизации.Организация);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ПодключенныеККМПроверкаККТ.Свернуть("ПодключаемоеОборудование", "Количество");
	Для Каждого СтрокаОборудования Из ПодключенныеККМПроверкаККТ Цикл
		Если СтрокаОборудования.Количество > 1 И ЗначениеЗаполнено(СтрокаОборудования.ПодключаемоеОборудование) Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Подключаемое оборудование: %1 установлено к нескольким кассам ККМ.
				|Обратитесь к администратору системы.'"), СтрокаОборудования.ПодключаемоеОборудование);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Если Выборка.Количество() > 0 Тогда
		
		ТаблицаКассККМОрганизаций.Очистить();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаКассККМ = ТаблицаКассККМОрганизаций.Добавить();
			СтрокаКассККМ.КассаККМ                 = Выборка.КассаККМ;
			СтрокаКассККМ.ПодключаемоеОборудование = Выборка.ПодключаемоеОборудование;
			СтрокаКассККМ.Организация              = Выборка.Организация;
			
		КонецЦикла;
		
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ТорговыйОбъект) Тогда
		ТекстСообщения = НСтр("ru = 'Для запуска информационного киоска необходимо выбрать магазин.'");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗапросДанныеКассыККМ(Запрос)
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтруктурныеЕдиницы.Ссылка КАК Склад,
	|	СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы КАК ТипСтруктурнойЕдиницы
	|ПОМЕСТИТЬ ДанныеТорговогоОбъекта
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|ГДЕ
	|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
	|	И СтруктурныеЕдиницы.Ссылка = &ТорговыйОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтруктурныеЕдиницы.Ссылка КАК Склад
	|ПОМЕСТИТЬ ТаблицаСкладов
	|ИЗ
	|	ДанныеТорговогоОбъекта КАК ДанныеТорговогоОбъекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ПО ДанныеТорговогоОбъекта.Склад = СтруктурныеЕдиницы.Родитель
	|ГДЕ
	|	ДанныеТорговогоОбъекта.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка
	|ИЗ
	|	ДанныеТорговогоОбъекта КАК ДанныеТорговогоОбъекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ПО ДанныеТорговогоОбъекта.Склад = СтруктурныеЕдиницы.Ссылка
	|ГДЕ
	|	ДанныеТорговогоОбъекта.ТипСтруктурнойЕдиницы В (&МассивТиповСтруктурныхЕдиниц)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КассыККМ.Ссылка КАК КассаККМ,
	|	КассыККМ.СтруктурнаяЕдиница КАК ТорговыйОбъект,
	|	КассыККМ.Владелец КАК Организация,
	|	КассыККМ.ПодключаемоеОборудование КАК ПодключаемоеОборудование,
	|	КассыККМ.ИспользоватьБезПодключенияОборудования КАК ИспользоватьБезПодключенияОборудования
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПодключаемоеОборудование КАК СпрПодключаемоеОборудование
	|		ПО КассыККМ.ПодключаемоеОборудование = СпрПодключаемоеОборудование.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаСкладов КАК ТаблицаСкладов
	|		ПО КассыККМ.СтруктурнаяЕдиница = ТаблицаСкладов.Склад
	|ГДЕ
	|	НЕ КассыККМ.ПометкаУдаления
	|	И СпрПодключаемоеОборудование.РабочееМесто = &РабочееМесто
	|	И КассыККМ.ТипКассы = ЗНАЧЕНИЕ(Перечисление.ТипыКассККМ.ФискальныйРегистратор)
	|	И СпрПодключаемоеОборудование.УстройствоИспользуется";
	
	МассивТиповСтруктурныхЕдиниц = Новый Массив;
	МассивТиповСтруктурныхЕдиниц.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Склад);
	МассивТиповСтруктурныхЕдиниц.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Розница);
	
	Если Не ЗначениеЗаполнено(Объект.ТорговыйОбъект) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СтруктурныеЕдиницы.Ссылка = &ТорговыйОбъект", "");
	Иначе
		Запрос.УстановитьПараметр("ТорговыйОбъект", Объект.ТорговыйОбъект);
	КонецЕсли;
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("МассивТиповСтруктурныхЕдиниц", МассивТиповСтруктурныхЕдиниц);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРозничныйВидЦены()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтруктурныеЕдиницы.РозничныйВидЦен КАК РозничныйВидЦен,
	|	ВидыЦен.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ВидыЦен.ВалютаЦены КАК ВалютаЦены
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЦен КАК ВидыЦен
	|		ПО СтруктурныеЕдиницы.РозничныйВидЦен = ВидыЦен.Ссылка
	|ГДЕ
	|	СтруктурныеЕдиницы.Ссылка = &ТорговыйОбъект";
	
	Запрос.УстановитьПараметр("ТорговыйОбъект", Объект.ТорговыйОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Объект.ВидЦен = Выборка.РозничныйВидЦен;
		Объект.СуммаВключаетНДС = Выборка.ЦенаВключаетНДС;
		Объект.ВалютаДокумента = Выборка.ВалютаЦены;
	Иначе
		Если ЗначениеЗаполнено(Объект.ТорговыйОбъект) Тогда
			ВидЦеныПоУмолчанию = Справочники.ВидыЦен.Оптовая;
			Объект.ВидЦен = ВидЦеныПоУмолчанию;
			Объект.СуммаВключаетНДС = ВидЦеныПоУмолчанию.ЦенаВключаетНДС;
			Объект.ВалютаДокумента = ВидЦеныПоУмолчанию.ВалютаЦены;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПервуюПредопределеннуюИлиДоступнуюОрганизацию()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации");
	
	Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", "ОсновнаяОрганизация");
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

#Область ПечатьЗаказаНаЛентуФискальногоРегистратора

// Процедура - выполняет вывод заказа на ленту принтера чеков или фискального регистратора в не фискальном режиме
//
&НаКлиенте
Процедура НапечататьЗаказ()
	
	Если Не ИспользоватьПодключаемоеОборудование
		Или Не МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() 
		Или ТаблицаКассККМОрганизаций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказНапечатан = Ложь;
	Для Каждого СтрокаКассККМОрганизаций Из ТаблицаКассККМОрганизаций Цикл
		
		Если ЗаказНапечатан Тогда
			Прервать;
		КонецЕсли;
		
		СтруктураПараметровПечати = СтруктураПараметровПечати(СтрокаКассККМОрганизаций.КассаККМ);
		
		ИдентификаторУстройстваФР = СтруктураПараметровПечати.ПодключаемоеОборудование;
		
		Если ИдентификаторУстройстваФР <> Неопределено Тогда
			
			ТекстЧекаЗаказа = ТекстПечатиЗаказаНаФР(СтруктураПараметровПечати.ШиринаЛенты);
			Если ПустаяСтрока(ТекстЧекаЗаказа) Тогда
				Возврат;
			КонецЕсли;
			
			ОповещениеПриЗавершении = Новый ОписаниеОповещения("НапечататьЗаказа_Завершение",ЭтотОбъект);
			ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПечатиТекста(ТекстЧекаЗаказа);
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПечатьТекста(
				ОповещениеПриЗавершении,
				УникальныйИдентификатор,
				ИдентификаторУстройстваФР,
				ПараметрыОперации);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЗаказа_Завершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ЗаказНапечатан = Ложь;
		ТекстСообщения = НСтр("ru = 'При печати заказа возникла ошибка.
			|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	Иначе
		ЗаказНапечатан = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтруктураПараметровПечати(КассаККМ)
	
	ВыходнаяСтруктура = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассаККМ, "Ссылка, ПодключаемоеОборудование");
	
	ВыходнаяСтруктура.Вставить("ШиринаЛенты", 32);
	
	Возврат ВыходнаяСтруктура;
	
КонецФункции

&НаСервере
Функция ТекстПечатиЗаказаНаФР(ШиринаЛенты)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Номер КАК Номер,
	|	Документ.Дата КАК Дата,
	|	Документ.Организация КАК Организация,
	|	Документ.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &СсылкаНаЗаказ
	|	И Документ.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаТовары.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Номенклатура.Артикул КАК Артикул,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	ТаблицаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТовары.Количество КАК Количество,
	|	ТаблицаТовары.Цена КАК Цена,
	|	ТаблицаТовары.Сумма КАК Сумма,
	|	ТаблицаТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя.Запасы КАК ТаблицаТовары
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &СсылкаНаЗаказ
	|	И ТаблицаТовары.Ссылка.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки");
	
	Запрос.УстановитьПараметр("СсылкаНаЗаказ", ЗаказПокупателя);
	Запрос.УстановитьПараметр("ТекстИП", НСтр("ru = 'ИП '"));
	Запрос.УстановитьПараметр("ТекстТочкаПробел", НСтр("ru = '. '"));
	Запрос.УстановитьПараметр("ТекстТочка", НСтр("ru = '.'"));
	Запрос.УстановитьПараметр("ТекстПробел", НСтр("ru = ' '"));
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ДокументЗаказККМ  = Новый ТекстовыйДокумент();
	
	// Получение макета
	МакетЗаказаККМ = Обработки.ор_ИнформационныйКиоск.ПолучитьМакет("ЗаказПокупателя");
	
	ОбластьШапкаЧека  = МакетЗаказаККМ.ПолучитьОбласть("ШапкаЧека"      + ШиринаЛенты);
	ОбластьТелоЧека   = МакетЗаказаККМ.ПолучитьОбласть("ТелоЧека"       + ШиринаЛенты);
	ОбластьСкидка     = МакетЗаказаККМ.ПолучитьОбласть("ТелоЧекаСкидка" + ШиринаЛенты);
	ОбластьПодвалЧека = МакетЗаказаККМ.ПолучитьОбласть("ПодвалЧека"     + ШиринаЛенты);
	ОбластьРазрывЧека = МакетЗаказаККМ.ПолучитьОбласть("РазрывЧека"     + ШиринаЛенты);
	
	ВыборкаШапка       = Результаты[0].Выбрать();
	ВыборкаПоСтрокамТЧ = Результаты[1].Выбрать();
	
	Если ВыборкаШапка.Следующий() Тогда
		
		ОбластьШапкаЧека.Параметры.Организация = Строка(ВыборкаШапка.Организация);
		ОбластьШапкаЧека.Параметры.Магазин     = Строка(Объект.ТорговыйОбъект);
		ОбластьШапкаЧека.Параметры.НомерЗаказа = ВыборкаШапка.Номер;
		ОбластьШапкаЧека.Параметры.Дата        = Строка(ВыборкаШапка.Дата);
		
		ДокументЗаказККМ.Вывести(ОбластьШапкаЧека);
		
		Пока ВыборкаПоСтрокамТЧ.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыборкаПоСтрокамТЧ.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыНоменклатуры = Новый Структура;
			ПараметрыНоменклатуры.Вставить("ПредставлениеНоменклатуры", ВыборкаПоСтрокамТЧ.Номенклатура);
			ПараметрыНоменклатуры.Вставить("ПредставлениеХарактеристики", ВыборкаПоСтрокамТЧ.Характеристика);
			ПараметрыНоменклатуры.Вставить("ПредставлениеАртикула", ВыборкаПоСтрокамТЧ.Артикул);
			
			ОбластьТелоЧека.Параметры.НаименованиеТовара = ПечатьДокументовУНФ.ПредставлениеНоменклатуры(ПараметрыНоменклатуры);
			ОбластьТелоЧека.Параметры.КоличествоЦена     = СтрШаблон("%1 х %2",
			Формат(ВыборкаПоСтрокамТЧ.Количество, "ЧЦ=17; ЧДЦ=3; ЧРД=.; ЧН=; ЧГ=0"),
				Формат(ВыборкаПоСтрокамТЧ.Цена, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0"));
			ОбластьТелоЧека.Параметры.СуммаПоСтроке     = "="
				+ Формат(ВыборкаПоСтрокамТЧ.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
			
			КонечнаяСкидка = ВыборкаПоСтрокамТЧ.Количество *  ВыборкаПоСтрокамТЧ.Цена -  ВыборкаПоСтрокамТЧ.Сумма;
			
			ДокументЗаказККМ.Вывести(ОбластьТелоЧека);
			
			Если КонечнаяСкидка <> 0 Тогда
				ЗагСкидка = ?(КонечнаяСкидка > 0, НСтр("ru = 'СКИДКА='"), НСтр("ru = 'НАДБАВКА='"));
				ОбластьСкидка.Параметры.Скидка = ЗагСкидка + Формат(?(КонечнаяСкидка > 0, КонечнаяСкидка, -КонечнаяСкидка), "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
				ДокументЗаказККМ.Вывести(ОбластьСкидка);
			КонецЕсли;
			
		КонецЦикла;
		
		ОбластьПодвалЧека.Параметры.Итог = НСтр("ru = 'ИТОГ='") + Формат(ВыборкаШапка.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
		
		ДокументЗаказККМ.Вывести(ОбластьПодвалЧека);
		
	КонецЕсли;
	
	СтрокаВозврат = "";
	
	КоличествоСтрок = ДокументЗаказККМ.КоличествоСтрок();
	
	Для Индекс = 1 По КоличествоСтрок Цикл
		СтрокаВозврат = СтрокаВозврат + ДокументЗаказККМ.ПолучитьСтроку(Индекс); 
		
		Если НЕ Индекс = КоличествоСтрок Тогда
			СтрокаВозврат = СтрокаВозврат + Символы.ПС; 
		КонецЕсли;
	КонецЦикла;
	
	ДокументЗаказККМ.Вывести(ОбластьРазрывЧека);
	
	Возврат СтрокаВозврат
	
КонецФункции

#КонецОбласти

#Область РаботаСВременемБездействияКиоска

&НаСервереБезКонтекста
Функция ПолучитьТаймАутВозврата()
	
	Время = Константы.ор_ИнфоКиоскВремяБездействия.Получить();
	
	Возврат ?(Время = 0, 300, Время);
	
КонецФункции

&НаКлиенте
Процедура ВернутьИнфоКиоскВПервоначальноеСостояниеПоВремениОжидания()
	
	// Может поменяли тайм-аут.
	ТаймАутВозврата = ПолучитьТаймАутВозврата();
	
	// Очистка корзины
	Корзина.Очистить();
	
	Объект.Контрагент = КонтрагентПоУмолчанию;
	Объект.ДисконтнаяКарта = ПредопределенноеЗначение("Справочник.ДисконтныеКарты.ПустаяСсылка");
	
	// Переход на главную.
	ОсуществитьПереходНаСтраницу("main.html");
	
	// Очистка истории.
	РаботаСоСтеком("очистить");
	
	// Отключение обработчика ожидания
	ЭтотОбъект.ОтключитьОбработчикОжидания("ВернутьИнфоКиоскВПервоначальноеСостояниеПоВремениОжидания");
	
КонецПроцедуры

#КонецОбласти

#Область РаботаOptionsКиоска

&НаКлиенте
Процедура СобратьФункциональныеОпцииКиоска()
	
	ФОКиоска = Новый Структура();
	ЗаполнитьФункциональныеОпции(ФОКиоска);
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(СтрШаблон("Options.Actions = %1;", ПривестиБулевоКФорматуJS(ФОКиоска.Акции)));
	МассивСтрок.Добавить(СтрШаблон("Options.QuantityShops = %1;", ПривестиБулевоКФорматуJS(ФОКиоска.ОстаткиПоМагазинам)));
	МассивСтрок.Добавить(СтрШаблон("Options.CardInfo = %1;", ПривестиБулевоКФорматуJS(ФОКиоска.ИнформацияПоКарте)));
	МассивСтрок.Добавить(СтрШаблон("Options.Basket = %1;", ПривестиБулевоКФорматуJS(ФОКиоска.Корзина)));
	МассивСтрок.Добавить(СтрШаблон("Options.AboutShop = %1;", ПривестиБулевоКФорматуJS(ФОКиоска.ОМагазине)));
	
	ОпцииКиоскаСтрокаСкрипта = СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьФункциональныеОпции(СтруктураДанных)
	
	СтруктураДанных.Вставить("Акции"              , Константы.ор_ИнфоКиоскПоказыватьАкции.Получить());
	СтруктураДанных.Вставить("ОстаткиПоМагазинам" , Константы.ор_ИнфоКиоскПоказыватьОстаткиВДругихМагазинах.Получить());
	СтруктураДанных.Вставить("ИнформацияПоКарте"  , Константы.ор_ИнфоКиоскПоказыватьИнформациюПоКарте.Получить());
	СтруктураДанных.Вставить("Корзина"            , Константы.ор_ИнфоКиоскПоказыватьКорзину.Получить());
	СтруктураДанных.Вставить("ОМагазине"          , Константы.ор_ИнфоКиоскПоказыватьИнформациюОМагазине.Получить());
	СтруктураДанных.Вставить("КаталогИзПрайсЛиста", Константы.ор_ИнфоКиоскВКаталогеОтображатьПрайсЛист.Получить());
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСКорзиной

&НаКлиенте
Процедура ПересчитатьИтогоКорзины()
	
	ИтогоПоЗаказу = 0;
	Для Каждого ТоварКорзины Из Корзина Цикл
		ИтогоПоЗаказу = ИтогоПоЗаказу + ТоварКорзины.Сумма;
	КонецЦикла;
	
	Для Каждого ТоварКорзины Из Корзина Цикл
		ТоварКорзины.ИтогоПоЗаказу = ИтогоПоЗаказу;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКоличествоТовараВКорзине()
	
	КоличествоТовара = 0;
	
	Для Каждого Товар Из Корзина Цикл
		КоличествоТовара = КоличествоТовара + Товар.Количество;
	КонецЦикла;
	
	Возврат КоличествоТовара;
	
КонецФункции

&НаСервере
Процедура ПоместитьКорзинуВТабличнуюЧастьТовары(КорзинаТоваров)
	
	Объект.Запасы.Очистить();
	Объект.СкидкиНаценки.Очистить();
	
	Для Каждого ТоварКорзины Из КорзинаТоваров Цикл
		
		НоваяСтрока = Объект.Запасы.Добавить();
		НоваяСтрока.Номенклатура       = ПолучитьСсылкуНаСправочник("Номенклатура",   ТоварКорзины.ИДНоменклатуры);
		НоваяСтрока.Характеристика     = ПолучитьСсылкуНаСправочник("Характеристика", ТоварКорзины.ИДХарактеристики);
		НоваяСтрока.Количество         = ТоварКорзины.Количество;
		НоваяСтрока.Цена               = ТоварКорзины.Цена;
		НоваяСтрока.ПродажаПодарка     = ТоварКорзины.Свойство("ПродажаПодарка") И ТоварКорзины.ПродажаПодарка;
		
		ЗапасыНоменклатураПриИзменении(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзвлечьТабличнуюЧастьТоварыВКорзину()
	
	Объект.Запасы.Сортировать("Номенклатура");
	
	Корзина = Новый Массив;
	
	Для Каждого ТоварВКорзину Из Объект.Запасы Цикл
		
		идНоменклатуры   = Строка(ТоварВКорзину.Номенклатура.УникальныйИдентификатор());
		идХарактеристики = Строка(ТоварВКорзину.Характеристика.УникальныйИдентификатор());
		
		Если ТоварВКорзину.Характеристика.Пустая() Тогда
			НаименованиеТовара = Строка(ТоварВКорзину.Номенклатура);
		Иначе
			НаименованиеТовара = СтрШаблон("%1 (%2)", Строка(ТоварВКорзину.Номенклатура), Строка(ТоварВКорзину.Характеристика));
		КонецЕсли;
		
		ТоварКорзины = Новый Структура();
		ТоварКорзины.Вставить("ИДНоменклатуры"  , идНоменклатуры);
		ТоварКорзины.Вставить("ИДХарактеристики", идХарактеристики);
		ТоварКорзины.Вставить("Наименование"    , НаименованиеТовара);
		ТоварКорзины.Вставить("Цена"            , ТоварВКорзину.Цена);
		ТоварКорзины.Вставить("Количество"      , ТоварВКорзину.Количество);
		ТоварКорзины.Вставить("СкидкаЗначение"  , ТоварВКорзину.ПроцентАвтоматическойСкидки);
		ТоварКорзины.Вставить("Сумма"           , ТоварВКорзину.Сумма);
		ТоварКорзины.Вставить("ПродажаПодарка"  , ТоварВКорзину.ПродажаПодарка);
		ТоварКорзины.Вставить("ИтогоПоЗаказу"   , Объект.СуммаДокумента);
		
		Корзина.Добавить(ТоварКорзины);
		
	КонецЦикла;
	
	// Очистим для последующих подсчетов.
	Объект.Запасы.Очистить();
	Объект.СкидкиНаценки.Очистить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляПомещенияТовараВКорзину(ИДНоменклатуры, ИДХарактеристики)
	
	ДанныеТовара = Новый Структура;
	
	СсылкаНоменклатура   = ПолучитьСсылкуНаСправочник("Номенклатура", ИДНоменклатуры);
	СсылкаХарактеристика = ПолучитьСсылкуНаСправочник("Характеристика", ИДХарактеристики);
	Если СсылкаХарактеристика.Пустая() Тогда
		НаименованиеТовара = Строка(СсылкаНоменклатура);
	Иначе
		НаименованиеТовара = СтрШаблон("%1 (%2)", Строка(СсылкаНоменклатура), Строка(СсылкаХарактеристика));
	КонецЕсли;
	
	ДанныеТовара.Вставить("Наименование", НаименованиеТовара);
	ДанныеТовара.Вставить("Цена", ПолучитьЦенуТовара(СсылкаНоменклатура, СсылкаХарактеристика));
	
	Возврат ДанныеТовара;
	
КонецФункции

&НаСервере
Функция ПолучитьЦенуТовара(СсылкаНоменклатура, СсылкаХарактеристика)
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("ВидЦен"          , Объект.ВидЦен);
	СтруктураДанные.Вставить("ДатаОбработки"   , ТекущаяДатаСеанса());
	СтруктураДанные.Вставить("Номенклатура"    , СсылкаНоменклатура);
	СтруктураДанные.Вставить("Характеристика"  , СсылкаХарактеристика);
	СтруктураДанные.Вставить("Коэффициент"     , 1);
	СтруктураДанные.Вставить("ВалютаДокумента" , Объект.ВалютаДокумента);
	СтруктураДанные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	
	Возврат ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(СтруктураДанные);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаСправочник(ПолучитьОбъект, ид)
	
	ИмяСправочника = "";
	Если ПолучитьОбъект = "Характеристика" Тогда
		ИмяСправочника = "ХарактеристикиНоменклатуры";
	ИначеЕсли ПолучитьОбъект = "Номенклатура" Тогда
		ИмяСправочника = "Номенклатура";
	ИначеЕсли ПолучитьОбъект = "ПрайсЛист" Тогда
		ИмяСправочника = "ор_ПрайсЛистИнформационногоКиоска";
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Ссылка = Неопределено;
	ИначеЕсли Не ЗначениеЗаполнено(ид) Тогда
		Ссылка = Справочники[ИмяСправочника].ПустаяСсылка();
	Иначе
		Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(ид));
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

&НаСервере
Процедура ЗапасыНоменклатураПриИзменении(СтрокаТабличнойЧасти)
	
	СтруктураДанные = СтруктураДанныхДляНомеклатуры();
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("Характеристика", СтрокаТабличнойЧасти.Характеристика);
	
	СтруктураДанные = ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные);
	
	Если СтруктураДанные.ЭтоНабор И НЕ СтруктураДанные.ИспользоватьХарактеристики Тогда
		
		// Наборы
		НаборыКлиентСервер.ЗаменитьСтрокуДаннымиНабора(Объект, "Запасы", СтрокаТабличнойЧасти, СтруктураДанные);
		
		// АвтоматическиеСкидки.
		СброситьФлагСкидкиРассчитаныСервер("РассчитатьСуммуВСтрокеТабличнойЧасти", "Сумма");
		// Конец АвтоматическиеСкидки
		
	Иначе
		
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтруктураДанные.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = СтруктураДанные.ПроцентСкидкиНаценки;
		СтрокаТабличнойЧасти.СтавкаНДС = СтруктураДанные.СтавкаНДС;
		
		Если СтруктураДанные.ИспользоватьХарактеристики Тогда
			СтрокаТабличнойЧасти.Характеристика = СтруктураДанные.Характеристика;
		КонецЕсли;
		
		Если СтруктураДанные.ЭтоЗапас Тогда
			СтрокаТабличнойЧасти.СтруктурнаяЕдиницаРезерв = Объект.СтруктурнаяЕдиницаРезерв;
		КонецЕсли;
		
		РассчитатьСуммуВСтрокеТабличнойЧасти(СтрокаТабличнойЧасти);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные)
	
	// Наборы
	Если НЕ СтруктураДанные.Свойство("ЕдиницаИзмерения") И ТипЗнч(СтруктураДанные.Номенклатура)=Тип("СправочникСсылка.Номенклатура") Тогда
		СтруктураДанные.Вставить("ЕдиницаИзмерения", СтруктураДанные.Номенклатура.ЕдиницаИзмерения);
	КонецЕсли; 
	Если НЕ СтруктураДанные.Свойство("Коэффициент") Тогда
		Если ТипЗнч(СтруктураДанные.ЕдиницаИзмерения)=Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
			СтруктураДанные.Вставить("Коэффициент", СтруктураДанные.ЕдиницаИзмерения.Коэффициент);
		Иначе
			СтруктураДанные.Вставить("Коэффициент", 1);
		КонецЕсли; 
	КонецЕсли;
	// Конец Наборы
	
	СтруктураДанные.Вставить("ЭтоУслуга", СтруктураДанные.Номенклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
	СтруктураДанные.Вставить("ЭтоЗапас", (СтруктураДанные.Номенклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас")
									ИЛИ СтруктураДанные.Номенклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПодарочныйСертификат")));
	
	СтруктураДанные.Вставить("Склад", СтруктураДанные.Номенклатура.Склад);
	СтруктураДанные.Вставить("Ячейка", СтруктураДанные.Номенклатура.Ячейка);
	
	Если СтруктураДанные.Свойство("НормаВремени") Тогда
		СтруктураДанные.НормаВремени = ЦенообразованиеСервер.ПолучитьНормуВремениРаботы(СтруктураДанные);
	КонецЕсли;
	
	Если СтруктураДанные.Свойство("НалогообложениеНДС") 
		И НЕ СтруктураДанные.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДС") Тогда
		
		Если СтруктураДанные.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС") Тогда
			СтруктураДанные.Вставить("СтавкаНДС", УправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСБезНДС());
		Иначе
			СтруктураДанные.Вставить("СтавкаНДС", УправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСНоль());
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СтруктураДанные.Номенклатура.ВидСтавкиНДС) Тогда
		СтруктураДанные.Вставить("СтавкаНДС", Справочники.СтавкиНДС.СтавкаНДС(СтруктураДанные.Номенклатура.ВидСтавкиНДС, ?(ЗначениеЗаполнено(СтруктураДанные.ДатаОбработки), СтруктураДанные.ДатаОбработки, ТекущаяДатаСеанса())));
	Иначе
		СтруктураДанные.Вставить("СтавкаНДС", Справочники.СтавкиНДС.СтавкаНДС(СтруктураДанные.Организация.ВидСтавкиНДСПоУмолчанию, ?(ЗначениеЗаполнено(СтруктураДанные.ДатаОбработки), СтруктураДанные.ДатаОбработки, ТекущаяДатаСеанса())));
	КонецЕсли;
	
	// Характеристики
	СтруктураДанные.Вставить("ИспользоватьХарактеристики",Ложь);
	СтруктураДанные.Вставить("ПроверятьЗаполнениеХарактеристики",Ложь);
	
	Если ЗначениеЗаполнено(СтруктураДанные.Номенклатура)
		И СтруктураДанные.Номенклатура.ИспользоватьХарактеристики Тогда
		ЗначенияПоУмолчанию = НоменклатураВДокументахСервер.ЗначенияНоменклатурыПоУмолчанию(СтруктураДанные.Номенклатура);
		
		Если Не ЗначенияПоУмолчанию = Неопределено Тогда
			ХарактеристикаПоУмолчанию = ЗначенияПоУмолчанию;
		КонецЕсли;
		
		Если НЕ СтруктураДанные.Свойство("Характеристика") Тогда
			СтруктураДанные.Вставить("Характеристика",ХарактеристикаПоУмолчанию);
		Иначе
			СтруктураДанные.Характеристика = ?(
				ЗначениеЗаполнено(СтруктураДанные.Характеристика),
				СтруктураДанные.Характеристика,
				ХарактеристикаПоУмолчанию);
		КонецЕсли;
		
		СтруктураДанные.Вставить("ИспользоватьХарактеристики",Истина);
		СтруктураДанные.Вставить("ПроверятьЗаполнениеХарактеристики", СтруктураДанные.Номенклатура.ПроверятьЗаполнениеХарактеристики);
	КонецЕсли; 
	// Конец Характеристики
	
	Если СтруктураДанные.Свойство("Цена") И ЗначениеЗаполнено(СтруктураДанные.Цена) Тогда
		// При подборе наборов расчет цены не требуется - используется цена, указанная в подборе
	ИначеЕсли СтруктураДанные.Свойство("ВидЦен") Тогда
		
		Если НЕ СтруктураДанные.Свойство("Характеристика") Тогда
			СтруктураДанные.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		КонецЕсли;
		
		Если СтруктураДанные.Свойство("ВидРабот") Тогда
		
			Если СтруктураДанные.Номенклатура.ФиксированнаяСтоимость Тогда
				
				Цена = ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(СтруктураДанные);
				СтруктураДанные.Вставить("Цена", Цена);
			
			Иначе
			
				СтруктураДанные.Номенклатура = СтруктураДанные.ВидРабот;
				СтруктураДанные.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
				Цена = ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(СтруктураДанные);
				СтруктураДанные.Вставить("Цена", Цена);
				
			КонецЕсли;
			
		Иначе
			
			Цена = ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(СтруктураДанные);
			СтруктураДанные.Вставить("Цена", Цена);
			
		КонецЕсли;
		
	Иначе
		
		СтруктураДанные.Вставить("Цена", 0);
		
	КонецЕсли;
	
	СтруктураДанные.Вставить("МинимальнаяЦена", ЦенообразованиеСервер.ПолучитьМинимальнуюЦенуНоменклатуры(СтруктураДанные));
	
	Если СтруктураДанные.Свойство("ВидСкидкиНаценки") 
		И ЗначениеЗаполнено(СтруктураДанные.ВидСкидкиНаценки) Тогда
		СтруктураДанные.Вставить("ПроцентСкидкиНаценки", СтруктураДанные.ВидСкидкиНаценки.Процент);
	Иначе
		СтруктураДанные.Вставить("ПроцентСкидкиНаценки", 0);
	КонецЕсли;
	
	Если СтруктураДанные.Свойство("ПроцентСкидкиПоДисконтнойКарте") 
		И ЗначениеЗаполнено(СтруктураДанные.ДисконтнаяКарта) Тогда
		ТекПроцент = СтруктураДанные.ПроцентСкидкиНаценки;
		СтруктураДанные.Вставить("ПроцентСкидкиНаценки", ТекПроцент + СтруктураДанные.ПроцентСкидкиПоДисконтнойКарте);
	КонецЕсли;
	СтруктураДанные.Вставить("ВесЕдиницыТовара", СтруктураДанные.Номенклатура.Вес);
	СтруктураДанные.Вставить("ОбъемЕдиницыТовара", СтруктураДанные.Номенклатура.Объем);
	
	// Наборы
	НаборыСервер.ДобавитьИнформациюОНабореПриПолученииДанныхНоменклатуры(СтруктураДанные);
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаСервере
Функция СтруктураДанныхДляНомеклатуры()
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Организация", Объект.Организация);
	СтруктураДанные.Вставить("СтруктурнаяЕдиница", Объект.СтруктурнаяЕдиницаРезерв);
	СтруктураДанные.Вставить("ЭтоНовыйОбъект", Истина);
	СтруктураДанные.Вставить("НалогообложениеНДС", Объект.НалогообложениеНДС);
	СтруктураДанные.Вставить("ДатаОбработки", Объект.Дата);
	
	СтруктураДанные.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	СтруктураДанные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	СтруктураДанные.Вставить("Коэффициент", 1);
	СтруктураДанные.Вставить("ВидЦен", Объект.ВидЦен);
	СтруктураДанные.Вставить("ВидСкидкиНаценки", Объект.ВидСкидкиНаценки);
	
	// ДисконтныеКарты
	СтруктураДанные.Вставить("ДисконтнаяКарта", Объект.ДисконтнаяКарта);
	СтруктураДанные.Вставить("ПроцентСкидкиПоДисконтнойКарте", Объект.ПроцентСкидкиПоДисконтнойКарте);
	// Конец ДисконтныеКарты
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаСервере
Процедура РассчитатьСуммуВСтрокеТабличнойЧасти(СтрокаТабличнойЧасти, ПараметрыРасчета = Неопределено)
	
	Если ПараметрыРасчета = Неопределено Тогда
		ПараметрыРасчета = Новый Структура("СброситьФлагСкидкиРассчитаны", Истина);
	КонецЕсли;
	
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("ИспользоватьМинимальныеЦены", КэшЗначений.ИспользоватьМинимальныеЦены);
	
	ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(СтрокаТабличнойЧасти, ПараметрыРасчета);
	
	// АвтоматическиеСкидки.
	СброситьФлагСкидкиРассчитаныСервер("РассчитатьСуммуВСтрокеТабличнойЧасти");
	// Конец АвтоматическиеСкидки
	
КонецПроцедуры

// Функция сбрасывает флаг "СкидкиРассчитаны", если это необходимо, и возвращает Истина, если требуется пересчёт скидок.
//
&НаСервере
Функция СброситьФлагСкидкиРассчитаныСервер(Действие, КолонкаТЧ = "")
	
	ТребуетсяПересчет = Ложь;
	Если ИспользоватьАвтоматическиеСкидки И Объект.Запасы.Количество() > 0 И Объект.СкидкиРассчитаны Тогда
		ТребуетсяПересчет = СброситьФлагСкидкиРассчитаны(Действие, КолонкаТЧ);
	КонецЕсли;
	Если ТребуетсяПересчет Тогда
		ВывестиСообщения = Ложь;
		ВыдатьПодаркиНаВыбор = Ложь;
	КонецЕсли;
	Возврат ТребуетсяПересчет;
	
КонецФункции

// Функция сбрасывает флаг СкидкиРассчитаны, если это необходимо, и возвращает Истина, если требуется пересчёт скидок.
//
&НаСервере
Функция СброситьФлагСкидкиРассчитаны(Действие, КолонкаТЧ = "")
	
	Возврат СкидкиНаценкиСервер.СброситьФлагСкидкиРассчитаны(ЭтотОбъект, Действие, КолонкаТЧ);
	
КонецФункции

#КонецОбласти

#Область РасчетСкидок

&НаКлиенте
Процедура РассчитатьСкидкиКорзины()
	
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("ПрименятьКОбъекту"          , Ложь);
	СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет", Ложь);
	СтруктураПараметры.Вставить("РабочееМесто"               , РабочееМесто);
	СтруктураПараметры.Вставить("Корзина"                    , Корзина);
	
	РассчитатьСкидкиНаценкиНаСервере(СтруктураПараметры);
	
	ИзвлечьТабличнуюЧастьТоварыВКорзину();
	
КонецПроцедуры

// Процедура - обработчик команды "РассчитатьСкидкиНаценки".
//
&НаСервере
Процедура РассчитатьСкидкиНаценкиНаСервере(СтруктураПараметры)
	
	Объект.Дата = ТекущаяДатаСеанса();
	
	ПоместитьКорзинуВТабличнуюЧастьТовары(СтруктураПараметры.Корзина);
	
	ЗаполнитьБонуснуюПрограмму(Объект, СтруктураПараметры);
	
	РасчетныеСкидки = ВыполнитьРасчетСкидокНаСервере(Объект, СтруктураПараметры);
	РезультатПрименения = ПрименитьРассчитанныеСкидкиКОбъекту(Объект, РасчетныеСкидки);
	
	Объект.СкидкиРассчитаны = РезультатПрименения.Успех;
	АдресСкидокВоВременномХранилище = "";
	Если РезультатПрименения.Успех Тогда
		АдресСкидокВоВременномХранилище = ПоместитьВоВременноеХранилище(
			РезультатПрименения.ПримененныеСкидкиНаценки,
			УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьБонуснуюПрограмму(Знач Объект, СтруктураПараметры)
	
	Если Не ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		Если Не Объект.БонусныеБаллыКНачислению.Количество() = 0 Тогда
			Объект.БонусныеБаллыКНачислению.Очистить();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Объект.Запасы.Количество() = 0 Тогда
		Если Не Объект.БонусныеБаллыКНачислению.Количество() = 0 Тогда
			Объект.БонусныеБаллыКНачислению.Очистить();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	РеквизитыБП = РаботаСБонусами.РеквизитыБонуснойПрограммы(Объект.ДисконтнаяКарта);
	
	Если РеквизитыБП.БонуснаяПрограмма.Пустая() Тогда
		Если Не Объект.БонусныеБаллыКНачислению.Количество() = 0 Тогда
			Объект.БонусныеБаллыКНачислению.Очистить();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если РеквизитыБП.НеНачислятьПриОплатеБонусами Тогда
		Если РаботаСБонусами.ЕстьОплатаБонусами(Объект.Предоплата) Тогда
			Объект.БонусныеБаллыКНачислению.Очистить();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПараметры.Вставить("БонуснаяПрограмма", РеквизитыБП.БонуснаяПрограмма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры)
	
	СкидкиНаценкиСервер.ЗаполнитьКлючиСвязиВТабличнойЧастиТовары(ОбъектДляРасчета, "Запасы");
	
	РассчитанныеСкидкиПоВсемВариантам = Новый Структура;
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("НомерВариантаКП", 0);
	ОтборСтрок.Вставить("ЭтоРазделитель", Ложь);
	СтруктураПараметры.Вставить("ОтборСтрок", ОтборСтрок);
	
	РассчитанныеСкидки = СкидкиНаценкиСерверПереопределяемый.ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры);
	
	ТаблицаСообщений         = СкидкиНаценкиСервер.ПустаяТаблицаСообщений();
	ТаблицаПодарков          = СкидкиНаценкиСервер.ПустаяТаблицаПодарков();
	ТаблицаБонусыКНачислению = СкидкиНаценкиСервер.ПустаяТаблицаБонусов();
	
	РассчитанныеСкидкиПоВсемВариантам.Вставить("ДеревоСкидок", РассчитанныеСкидки.ДеревоСкидок);
	РассчитанныеСкидкиПоВсемВариантам.Вставить("ТаблицаСкидкиНаценки", РассчитанныеСкидки.ТаблицаСкидкиНаценки);
	РассчитанныеСкидкиПоВсемВариантам.Вставить("ТаблицаСообщений", ТаблицаСообщений);
	РассчитанныеСкидкиПоВсемВариантам.Вставить("ТаблицаПодарков", ТаблицаПодарков);
	РассчитанныеСкидкиПоВсемВариантам.Вставить("ТаблицаБонусыКНачислению", ТаблицаБонусыКНачислению);
	
	Если РассчитанныеСкидки.Свойство("ТаблицаСообщений", ТаблицаСообщений) Тогда
		РассчитанныеСкидкиПоВсемВариантам.Вставить("ТаблицаСообщений", ТаблицаСообщений);
	КонецЕсли;
	Если РассчитанныеСкидки.Свойство("ТаблицаПодарков", ТаблицаПодарков) Тогда
		РассчитанныеСкидкиПоВсемВариантам.Вставить("ТаблицаПодарков", ТаблицаПодарков);
	КонецЕсли;
	Если РассчитанныеСкидки.Свойство("ТаблицаБонусыКНачислению", ТаблицаБонусыКНачислению) Тогда
		РассчитанныеСкидкиПоВсемВариантам.Вставить("ТаблицаБонусыКНачислению", ТаблицаБонусыКНачислению);
	КонецЕсли;
	
	Возврат РассчитанныеСкидкиПоВсемВариантам
	
КонецФункции

&НаСервереБезКонтекста
Функция ПрименитьРассчитанныеСкидкиКОбъекту(Объект, РасчетныеСкидки)
	
	Результат = СкидкиНаценкиСервер.ПрименитьРассчитанныеСкидкиКОбъекту(Объект, РасчетныеСкидки);

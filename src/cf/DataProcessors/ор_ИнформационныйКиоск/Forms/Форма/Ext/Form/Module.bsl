
#Область ОписаниеПеременных

&НаКлиенте
Перем СтараяСтраница; // Страница которая была открыта до перехода на другую страницу.

&НаКлиенте
Перем СписокСтраниц; // Список страниц которые используются в информационном киоске.

&НаКлиенте
Перем стекПереходов; // История переходов по страницам.

&НаКлиенте
Перем резНажатияНавигации; // Структура которая содержит параметры перехода на другую страницу.

&НаКлиенте
Перем ОбработатьСобытиеПодключаемогоОборудования; // Содержит код HTML который выводится на страницу.

&НаКлиенте
Перем Корзина; // Корзина покупателя.

&НаКлиенте
Перем КэшированныеЗначения; //Переменная необходимая для вызова процедур обработки.

&НаКлиенте
Перем ОпцииКиоскаСтрокаСкрипта; // Опции которые включают отображение элементов киоска.

&НаКлиенте
Перем мЭтаФормаЗаголовок; // Переменная которая хранит заголовок окна для того чтобы компонента могла его закрыть.

&НаКлиенте
Перем ТаймАутВозврата; // Таймаут по которому будет происходить возврат киоска в начальное состояние.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	Если ЭтоМобильныйКлиент Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Мобильный клиент не поддерживается.'"));
		Возврат;
	КонецЕсли;
	
	ЭтоВебКлиент = ОбщегоНазначения.ЭтоВебКлиент();
	Если ЭтоВебКлиент Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Веб-клиент не поддерживается.'"));
		Возврат;
	КонецЕсли;
	
	КэшЗначений = Новый Структура;
	КэшЗначений.Вставить("ИспользоватьМинимальныеЦены", ЦенообразованиеСерверПовтИсп.МинимальныеЦеныИспользуются());
	КэшЗначений.Вставить("РезервированиеЗапасов", ПолучитьФункциональнуюОпцию("РезервированиеЗапасов"));
	КэшЗначений.Вставить("НаборСвойств_Документ_ЗаказПокупателя",
		УправлениеСвойствами.НаборСвойствПоИмени("Документ_ЗаказПокупателя"));
	
	МассивТиповНоменклатуры = Новый Массив;
	МассивТиповНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Запас);
	МассивТиповНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	МассивТиповНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	МассивТиповНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.ПодарочныйСертификат);
	КэшЗначений.Вставить("ДоступныеТипыНоменклатуры", МассивТиповНоменклатуры);
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций") Тогда
		Объект.Организация = ПерсональныеНастройкиРУНФ.Прочитать("ОсновнаяОрганизация");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ПолучитьПервуюПредопределеннуюИлиДоступнуюОрганизацию();
	КонецЕсли;
	
	Объект.СтруктурнаяЕдиницаРезерв = ПерсональныеНастройкиРУНФ.Прочитать("ОсновнойСклад");
	Объект.НалогообложениеНДС = НалогиУНФ.НалогообложениеНДС(Объект.Организация, Объект.СтруктурнаяЕдиницаРезерв, ТекущаяДатаСеанса());
	
	Объект.СтруктурнаяЕдиницаПродажи = ПерсональныеНастройкиРУНФ.Прочитать("ОсновноеПодразделение");
	Объект.СтруктурнаяЕдиницаПродажи = ?(ЗначениеЗаполнено(Объект.СтруктурнаяЕдиницаПродажи),
		Объект.СтруктурнаяЕдиницаПродажи,
		Справочники.СтруктурныеЕдиницы.ОсновноеПодразделение);
	
	ОбщегоНазначенияРМКУНФ.ОпределитьТекущийТорговыйОбъект(Объект.ТорговыйОбъект);
	
	ЗаполнитьРозничныйВидЦены();
	
	ТекстОшибки = "";
	ПроверитьОбщуюВозможностьРаботы(Отказ, ТекстОшибки);
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	КонтрагентПоУмолчанию = Константы.ор_ИнфоКиоскКонтрагентПоУмолчанию.Получить();
	Если НЕ ЗначениеЗаполнено(КонтрагентПоУмолчанию) Тогда
		Выборка = Справочники.Контрагенты.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ Выборка.ЭтоГруппа И Выборка.Покупатель Тогда
				КонтрагентПоУмолчанию = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Объект.Контрагент = КонтрагентПоУмолчанию;
	
	Объект.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
	
	КонтролироватьОстаткиТоваров = Константы.КонтролироватьОстаткиПриПроведении.Получить();
	
	ИспользоватьПодключаемоеОборудование = ПолучитьФункциональнуюОпцию("ИспользоватьПодключаемоеОборудование");
	ИспользоватьАвтоматическиеСкидки     = ПолучитьФункциональнуюОпцию("ИспользоватьАвтоматическиеСкидкиНаценки");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(РабочееМесто) Тогда
		ОбщегоНазначенияРМККлиентПереопределяемый.ЗаполнитьРабочееМесто(ЭтотОбъект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РабочееМесто) Тогда
		ТекстОшибки = НСтр("ru = 'Не смогли определить рабочее место.
			|Обратитесь к администратору системы.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	РеквизитыФормыДляДобавленияСтроки = СтруктураРеквизитовФормыДляДобавленияСтроки();
	
	Активизировать();
	
	ЗагрузитьHTMLСтраницу();
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода,СчитывательМагнитныхКарт");
	// Конец ПодключаемоеОборудование
	
	СобратьФункциональныеОпцииКиоска();
	
	ТаймАутВозврата = ПолучитьТаймАутВозврата();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Или ЗакрытьБезПроверки Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ИспользоватьПодключаемоеОборудование Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// С появлением webkit когда поле доступно на редактирование и в нем моргает курсор,
	// то ВводДоступен у формы будет возращать ложь.
	Если Источник = "ПодключаемоеОборудование"
		И ВводДоступен() Или ПолеHTMLВводДоступен() Тогда
		
		Если ИмяСобытия = "ScanData" Тогда
			Штрихкод = ?(Параметр[1] = Неопределено, Параметр[0], Параметр[1][1]);
			ВыполнитьПоискШтрихкода(Штрихкод);
		ИначеЕсли ИмяСобытия = "ScanDataBase64" Тогда
			Штрихкод = ?(Параметр[1] = Неопределено, Параметр[0], Параметр[1][1]);
			Штрихкод = МенеджерОборудованияКлиентСервер.Base64ВШтрихкод(Штрихкод);
			ВыполнитьПоискШтрихкода(Штрихкод);
		ИначеЕсли ИмяСобытия = "TracksData" Тогда
			ВыполнитьПоискМагнитнойКарты(Параметр[0]);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "ИзменениеПараметровКиоска" Тогда
		Если Параметр.ТорговыйОбъект <> Объект.ТорговыйОбъект Тогда
			Объект.ТорговыйОбъект = Параметр.ТорговыйОбъект;
			Объект.ВидЦен = Параметр.ВидЦены;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "НастройкаКиоска" Тогда
		
		ОпцииКиоскаСтрокаСкрипта = Параметр;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИнфоКиоскДокументСформирован(Элемент)
	
	АдресНовый = Элементы.ИнфоКиоск.Документ.url;
	Для Каждого АдресСписка Из СписокСтраниц Цикл
		Если Найти(АдресНовый, АдресСписка.Значение) <> 0 Тогда
			ТекСтраница = АдресСписка.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ТекСтраница = "data-transfer.html" Тогда
		Возврат;
	КонецЕсли; 
	
	Если ТекСтраница <> "about:blank" Тогда
		ЭтотОбъект.ПодключитьОбработчикОжидания("ВернутьИнфоКиоскВПервоначальноеСостояниеПоВремениОжидания", ТаймАутВозврата, Истина); 
		элемНавигацииНазад  = Элементы.ИнфоКиоск.Документ.getElementById("prev nav");
		элемНавигацииВперед = Элементы.ИнфоКиоск.Документ.getElementById("next nav");
		
		ЭлементВыполнения = Элементы.ИнфоКиоск.Документ.getElementById("execution");
		ЭлементВыполнения.setAttribute("paramBasketCount", ПолучитьКоличествоТовараВКорзине());
		
		ЭлементВыполнения2 = Элементы.ИнфоКиоск.Документ.getElementById("basket-count");
		ЭлементВыполнения2.innerHTML = СтрШаблон("(%1)", ПолучитьКоличествоТовараВКорзине());
		
		// Отображаемые элементы информационного киоска.
		ЭлементВыполнения.setAttribute("paramOptions", ОпцииКиоскаСтрокаСкрипта);
		
		резНавигацииИдОбработки = резНажатияНавигации.ИдентификаторОбработки;
		
		// Переход по истории.
		Если (резНавигацииИдОбработки = "prev nav" ИЛИ резНавигацииИдОбработки = "next nav") Тогда
			
			лСтраницаИстории = Неопределено;
			Для Каждого СтраницаИстории Из СтекПереходов Цикл
				Если СтраницаИстории.Пометка Тогда
					лСтраницаИстории = СтраницаИстории;
				КонецЕсли;
			КонецЦикла;
			
			Если лСтраницаИстории <> Неопределено Тогда
				ИндексСтраницы = стекПереходов.Индекс(лСтраницаИстории);
				колвоЭлементов = стекПереходов.Количество()-1;
				лСтраницаПерехода = Неопределено;
				Если резНажатияНавигации.ЭтоКнопкаПереходаНазад Тогда
					ИндексПерехода = ИндексСтраницы - 1;
					ИндексПереходаНазад = ИндексСтраницы - 2;
					Если ЗначениеЗаполнено(СтараяСтраница) И СтараяСтраница = "error.html" Тогда
						элемНавигацииВперед.href = "#";
						элемНавигацииВперед.setAttribute("paramKod", "");
						ИндексПереходаНазад = ИндексПереходаНазад + 1; // Значит побывали на странице описания ошибки.
					ИначеЕсли ИндексПерехода >= 0 Тогда
						лСтраницаПерехода = стекПереходов.Получить(ИндексПерехода);
						
						элемНавигацииВперед.href = лСтраницаИстории.Значение.АдресПерехода;
						элемНавигацииВперед.setAttribute("paramKod", лСтраницаИстории.Значение.КодСкрипта);
					КонецЕсли;
					
					Если ИндексПереходаНазад >= 0 Тогда
						лСтраницаПереходаНазад  = стекПереходов.Получить(ИндексПереходаНазад);
						элемНавигацииНазад.href = лСтраницаПереходаНазад.Значение.АдресПерехода;
						элемНавигацииНазад.setAttribute("paramKod", лСтраницаПереходаНазад.Значение.КодСкрипта);
					Иначе
						элемНавигацииНазад.href = "#";
						элемНавигацииНазад.setAttribute("paramKod", "");
					КонецЕсли;
					
				Иначе
					ИндексПерехода = ИндексСтраницы + 1;
					ИндексПереходаВперед = ИндексСтраницы + 2;
					
					Если ИндексПерехода <= колвоЭлементов Тогда
						лСтраницаПерехода = стекПереходов.Получить(ИндексПерехода);
						
						элемНавигацииНазад.href = лСтраницаИстории.Значение.АдресПерехода;
						элемНавигацииНазад.setAttribute("paramKod", лСтраницаИстории.Значение.КодСкрипта);
					КонецЕсли;
					
					Если ИндексПереходаВперед <= колвоЭлементов Тогда
						лСтраницаПереходаВперед = стекПереходов.Получить(ИндексПереходаВперед);
						
						элемНавигацииВперед.href = лСтраницаПереходаВперед.Значение.АдресПерехода;
						элемНавигацииВперед.setAttribute("paramKod", лСтраницаПереходаВперед.Значение.КодСкрипта);
					Иначе
						элемНавигацииВперед.href = "#";
						элемНавигацииВперед.setAttribute("paramKod", "");
					КонецЕсли;
					
				КонецЕсли;
				
				Если лСтраницаПерехода <> Неопределено Тогда 
					стекПереходов.ЗаполнитьПометки(Ложь);
					лСтраницаПерехода.Пометка = Истина;
					
					ЭлементВыполнения.setAttribute("paramKod", лСтраницаПерехода.Значение.КодСкрипта);
					
					резНажатияНавигации.Вставить("ЭтоПроходДляИстории");
				Иначе
					резНажатияНавигации.Вставить("ЭтоПУСТОЙПроходДляИстории");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Загрузка страниц.
		Если ТекСтраница = "catalog.html" Тогда
			
			Если резНажатияНавигации.Свойство("ЭтоПУСТОЙПроходДляИстории") Тогда
			ИначеЕсли резНажатияНавигации.Свойство("ЭтоПроходДляИстории") Тогда
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				
			ИначеЕсли резНажатияНавигации.ИдентификаторОбработки = "CatalogItem" Тогда
				
				СтрокаСкрипта = ПолучитьСтраницуКаталога(резНажатияНавигации.ИД);
				
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				
			Иначе
				
				СтрокаСкрипта = ПолучитьСтраницуКаталога();
				
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекСтраница = "catalog-detail.html" Тогда
			
			Если НЕ ПустаяСтрока(ОбработатьСобытиеПодключаемогоОборудования) Тогда
				
				СтрокаСкрипта = ОбработатьСобытиеПодключаемогоОборудования;
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				ОбработатьСобытиеПодключаемогоОборудования = "";
				
			ИначеЕсли резНажатияНавигации.Свойство("ЭтоПУСТОЙПроходДляИстории") Тогда
			ИначеЕсли резНажатияНавигации.Свойство("ЭтоПроходДляИстории") Тогда
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
			ИначеЕсли резНажатияНавигации.ИдентификаторОбработки = "CatalogItem" Тогда
				
				СтрокаСкрипта = ПолучитьСтраницуТовара(резНажатияНавигации.ИД);
				
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ЭлементВыполнения.setAttribute("paramID", резНажатияНавигации.ИД);
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекСтраница = "action.html" Тогда
			
			Если резНажатияНавигации.Свойство("ЭтоПУСТОЙПроходДляИстории") Тогда
			Иначе
				СтрокаСкрипта = ПолучитьСтраницуАкций();
				ЭлементВыполнения.setAttribute("paramID", "");
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекСтраница = "about.html" Тогда
			
			Если резНажатияНавигации.Свойство("ЭтоПУСТОЙПроходДляИстории") Тогда
			Иначе
				
				СтрокаСкрипта = ПолучитьСтраницуОМагазине();
				
				ЭлементВыполнения.setAttribute("paramID", "");
				
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекСтраница = "basket.html" Тогда
			
			Если резНажатияНавигации.Свойство("ЭтоПУСТОЙПроходДляИстории") Тогда
			Иначе
				СтрокаСкрипта = ПолучитьОбъектКорзиныНаJS();
				ЭлементВыполнения.setAttribute("paramID", "");
				
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекСтраница = "cardinfo.html" Тогда
			
			Если НЕ ПустаяСтрока(ОбработатьСобытиеПодключаемогоОборудования) Тогда
				
				СтрокаСкрипта = ОбработатьСобытиеПодключаемогоОборудования;
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				
				ОбработатьСобытиеПодключаемогоОборудования = "";
				
			ИначеЕсли резНажатияНавигации.Свойство("ЭтоПУСТОЙПроходДляИстории") Тогда
			Иначе
				
				СтрокаСкрипта = ПолучитьСтраницуИнформацияПоДисконту(Объект.ДисконтнаяКарта);
				ЭлементВыполнения.setAttribute("paramID", "");
				
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекСтраница = "search-code.html" Тогда
			
			Если НЕ ПустаяСтрока(ОбработатьСобытиеПодключаемогоОборудования) Тогда
				
				СтрокаСкрипта = ОбработатьСобытиеПодключаемогоОборудования;
				ЭлементВыполнения.setAttribute("paramKod", ЭкранироватьСимволы(СтрокаСкрипта));
				ВыполнитьСобытиеOnclick(ЭлементВыполнения);
				
				ОбработатьСобытиеПодключаемогоОборудования = "";
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если (ТекСтраница = "main.html"
				ИЛИ ТекСтраница = "data-transfer.html"
				ИЛИ ТекСтраница = "error.html"
				ИЛИ ТекСтраница = "search.html" ИЛИ ТекСтраница = "terminal-not-work.html")
			И Не резНажатияНавигации.Свойство("ЭтоПУСТОЙПроходДляИстории") Тогда
			ВыполнитьСобытиеOnclick(ЭлементВыполнения);
		КонецЕсли;
		
		// Запоминание истории.
		Если (резНавигацииИдОбработки = ""
			ИЛИ (резНавигацииИдОбработки <> "prev nav" И резНавигацииИдОбработки <> "next nav")) Тогда
			// Если осуществляется переход на одну и ту же страницу то историю не запоминаем.
			Если ТекСтраница <> "about:blank"
				И СтараяСтраница <> Неопределено И ТекСтраница = СтараяСтраница
				// Если идут переходы по дереву каталога то их не надо стирать, а надо запоминать.
				И резНажатияНавигации.ИдентификаторОбработки <> "CatalogItem" Тогда
				
				Для Каждого историяПерехода Из стекПереходов Цикл
					Если историяПерехода.Пометка Тогда
						
						ИндексСтраницы = стекПереходов.Индекс(историяПерехода);
						колвоЭлементов = стекПереходов.Количество()-1;
						лСтраницаПерехода = Неопределено;
						ИндексПереходаНазад = ИндексСтраницы - 1;
						
						Если ИндексПереходаНазад >= 0 Тогда
							лСтраницаПереходаНазад  = стекПереходов.Получить(ИндексПереходаНазад);
							элемНавигацииНазад.href = лСтраницаПереходаНазад.Значение.АдресПерехода;
							элемНавигацииНазад.setAttribute("paramKod", лСтраницаПереходаНазад.Значение.КодСкрипта);
						Иначе
							элемНавигацииНазад.href = "#";
							элемНавигацииНазад.setAttribute("paramKod", "");
						КонецЕсли;
						
						элемНавигацииВперед.href = "#";
						элемНавигацииВперед.setAttribute("paramKod", "");
						
						РаботаСоСтеком("отсечьДоКонца");
						
					КонецЕсли;
				КонецЦикла;
			// Если осуществляется переход на другой URL то его запомним.
			ИначеЕсли ТекСтраница <> "about:blank" И СтараяСтраница <> Неопределено Тогда
				
				Для Каждого историяПерехода Из стекПереходов Цикл
					Если историяПерехода.Пометка Тогда
						ПереходДляКнопкиНазад = историяПерехода.Значение.АдресПерехода;
						
						элемНавигацииНазад.href = ПереходДляКнопкиНазад;
						
						КодСкрипта = историяПерехода.Значение.КодСкрипта;
						элемНавигацииНазад.setAttribute("paramKod", КодСкрипта);
						
						элемНавигацииВперед.href = "#";
						элемНавигацииВперед.setAttribute("paramKod", "");
					КонецЕсли;
				КонецЦикла;
				Если ТекСтраница <> "error.html" Тогда
					КомандаСтека = "добавить";
					АдресПерехода = АдресНовый;
					СтраницаПерехода = ТекСтраница;
					КодСкрипта = ЭлементВыполнения.getAttribute("paramKod");
					
					РаботаСоСтеком(КомандаСтека, АдресПерехода, СтраницаПерехода, КодСкрипта);
				КонецЕсли;
				
			// Первый запуск.
			ИначеЕсли ТекСтраница <> "about:blank" И СтараяСтраница = Неопределено Тогда
				
				КомандаСтека     = "добавить";
				АдресПерехода    = АдресНовый;
				СтраницаПерехода = ТекСтраница;
				КодСкрипта = ЭлементВыполнения.getAttribute("paramKod");
				
				РаботаСоСтеком(КомандаСтека, АдресПерехода, СтраницаПерехода, КодСкрипта);
				
			КонецЕсли;
		КонецЕсли;
		
		// Очистим вспомогательные свойства.
		резНажатияНавигации.ИдентификаторОбработки = "";
		Если резНажатияНавигации.Свойство("ЭтоПроходДляИстории") Тогда
			резНажатияНавигации.Удалить("ЭтоПУСТОЙПроходДляИстории");
		ИначеЕсли резНажатияНавигации.Свойство("ЭтоПроходДляИстории") Тогда
			резНажатияНавигации.Удалить("ЭтоПроходДляИстории");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнфоКиоскПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	ЭтотОбъект.ПодключитьОбработчикОжидания("ВернутьИнфоКиоскВПервоначальноеСостояниеПоВремениОжидания", ТаймАутВозврата, Истина);
	
	// Определим адрес текущей страницы.
	ПолучитьСтаруюСтраницу();
	
	// Соберём корзину в 1С по переданному коду.
	Если СтараяСтраница = "basket.html" Тогда
		ЭлементВыполнения = Элементы.ИнфоКиоск.Документ.getElementById("execution");
		Код1С = ЭлементВыполнения.getAttribute("paramKod");
		Если СтрНайти(Код1С, "&quot;") > 0 Тогда
			Код1С = СтрЗаменить(Код1С, "&quot;", """""");
		КонецЕсли;
		// Получение объектов 1С из HTML.
		Выполнить(Код1С);
		
		ПересчитатьИтогоКорзины();
		РассчитатьСкидкиКорзины();
	КонецЕсли;
	
	ЭлементКонтейнера = ДанныеСобытия.Element;
	
	резНажатияНавигации = ПолучитьКлавишиНавигации(ЭлементКонтейнера);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьСобытиеOnclick(ЭлементВыполнения)
	
	// Ошибка платформы 8.3.27.1508: прямой вызов onclick элемента DOM вызывает ошибку "Метод объекта не обнаружен (onclick)".
	Попытка
		ЭлементВыполнения.onclick();
	Исключение
		Выполнить("ЭлементВыполнения.parent."+ ЭлементВыполнения.getAttribute("onclick"));
	КонецПопытки;
	
КонецПроцедуры

#Область ОбработчикиСобытийПодключаемогоОборудования

&НаКлиенте
Процедура ЗаменитьСимволGS1(Штрихкод)
	
	СимволGS1 = МенеджерОборудованияМаркировкаКлиентСервер.РазделительGS1();
	Разделитель = МенеджерОборудованияМаркировкаКлиентСервер.ЭкранированныйСимволGS1();
	
	Штрихкод = СтрЗаменить(Штрихкод, СимволGS1, Разделитель);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоискШтрихкода(Штрихкод)
	
	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаменитьСимволGS1(Штрихкод);
	
	ПараметрыДляОбработкиШтрихкода = Новый Структура();
	ПараметрыДляОбработкиШтрихкода.Вставить("Штрихкод", Штрихкод);
	
	ОповещениеПоискаПоШтрихкоду(Штрихкод, ПараметрыДляОбработкиШтрихкода);
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеПоискаПоШтрихкоду(Штрихкод, ДополнительныеПараметры)
	
	ФильтрПоискаПоШтрихкоду = Новый Структура;
	ФильтрПоискаПоШтрихкоду.Вставить("Номенклатура");
	ФильтрПоискаПоШтрихкоду.Вставить("Пользователи");
	ФильтрПоискаПоШтрихкоду.Вставить("ФизическиеЛица");
	ФильтрПоискаПоШтрихкоду.Вставить("ИнформационныеКарты");
	
	СтруктураПараметровКлиента = ДанныеПоискаПоШтрихкодуСервер(Штрихкод, ДополнительныеПараметры);
	ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента, ПараметрыДляОбработкиШтрихкода)
	
	Если СтруктураПараметровКлиента.ЗначенияПоиска.Количество() > 0 Тогда
		
		СтрокаРезультата = СтруктураПараметровКлиента.ЗначенияПоиска[0];
		Если ЕстьСвойство(ПараметрыДляОбработкиШтрихкода, "ВыйтиИзКиоска")
			И ПараметрыДляОбработкиШтрихкода.ВыйтиИзКиоска Тогда
			
			ЗакрытьБезПроверки = Истина;
			ЗавершитьРаботуСистемы();
			Возврат;
			
		ИначеЕсли ЕстьСвойство(ПараметрыДляОбработкиШтрихкода, "ПоказатьДисконт") Тогда
			Если ФОКиоска.ИнформацияПоКарте Тогда
				
				ПолучитьСтаруюСтраницу();
				
				Если СтараяСтраница <> "basket.html" Тогда
					ОсуществитьПереходНаСтраницу("cardinfo.html");
					ОбработатьСобытиеПодключаемогоОборудования = ПараметрыДляОбработкиШтрихкода.ПоказатьДисконт;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ЕстьСвойство(ПараметрыДляОбработкиШтрихкода, "ПоказатьТовары") Тогда
			
			ПолучитьСтаруюСтраницу();
			ОсуществитьПереходНаСтраницу("catalog-detail.html");
			СтрокаСкрипта = ПараметрыДляОбработкиШтрихкода.ПоказатьТовары;
			ОбработатьСобытиеПодключаемогоОборудования = СтрокаСкрипта;
			
		Иначе
			
			ПолучитьСтаруюСтраницу();
			ОсуществитьПереходНаСтраницу("search-code.html");
			
			ОбработатьСобытиеПодключаемогоОборудования = СтрШаблон(
				НСтр("ru = 'Данные по коду не найдены: %1'"),
				СтрокаРезультата.ДанныеПО);
			
		КонецЕсли;
		
	Иначе
		
		ПолучитьСтаруюСтраницу();
		ОсуществитьПереходНаСтраницу("search-code.html");
		
		ОбработатьСобытиеПодключаемогоОборудования = СтрШаблон(
			НСтр("ru = 'Данные по коду не найдены: %1'"),
			СтруктураПараметровКлиента.ДанныеПО);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоШтрихкоду(СтрокаРезультата, ПараметрыДляОбработкиШтрихкода)
	
	Если СтрокаРезультата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыДляОбработкиШтрихкода = Неопределено Тогда
		ПараметрыДляОбработкиШтрихкода = Новый Структура();
		ПараметрыДляОбработкиШтрихкода.Вставить("Штрихкод", СтрокаРезультата.ДанныеПО);
	КонецЕсли;
	
	ВладелецШтрихкода = СтрокаРезультата.Владелец;
	
	НайденныйКассир = Неопределено;
	ШтрихкодированиеРМКПереопределяемый.ЗаполнитьДанныеНайденногоКассира(ВладелецШтрихкода, ЭтотОбъект, НайденныйКассир);
	Если НЕ НайденныйКассир = Неопределено Тогда
		
		РазрешитьЗакрыватьИнфоКиоск = ПерсональныеНастройкиРУНФ.Прочитать(
			"ор_РазрешитьЗакрыватьИнформационныйКиоск",,
			НайденныйКассир.ПользовательБД,
			Ложь);
		Если РазрешитьЗакрыватьИнфоКиоск Тогда
			ПараметрыДляОбработкиШтрихкода.Вставить("ВыйтиИзКиоска", РазрешитьЗакрыватьИнфоКиоск);
		КонецЕсли;
		Возврат;
		
	КонецЕсли;
	
	НайденнаяКартаЛояльности = Неопределено;
	ШтрихкодированиеРМКПереопределяемый.ЗаполнитьДанныеНайденнойКартыЛояльности(ВладелецШтрихкода,
		НайденнаяКартаЛояльности);
	Если НЕ НайденнаяКартаЛояльности = Неопределено Тогда
		
		Объект.ДисконтнаяКарта = НайденнаяКартаЛояльности.КартаЛояльности;
		ВладелецДисконтнойКарты = Объект.ДисконтнаяКарта.ВладелецКарты;
		Если ВладелецДисконтнойКарты.Пустая() Тогда
			Объект.Контрагент = КонтрагентПоУмолчанию;
		Иначе
			Объект.Контрагент = ВладелецДисконтнойКарты;
		КонецЕсли;
		
		СтрокаСкрипта = ПолучитьСтраницуИнформацияПоДисконту(Объект.ДисконтнаяКарта);
		ПараметрыДляОбработкиШтрихкода.Вставить("ПоказатьДисконт", СтрокаСкрипта);
		Возврат;
		
	КонецЕсли;
	
	НайденнаяНоменклатура = Неопределено;
	ШтрихкодированиеРМКПереопределяемый.ЗаполнитьДанныеНайденнойНоменклатуры(
		СтрокаРезультата, РеквизитыФормыДляДобавленияСтроки, ПараметрыДляОбработкиШтрихкода, НайденнаяНоменклатура);
	Если НЕ НайденнаяНоменклатура = Неопределено Тогда
		
		СписокНоменклатуры = Новый СписокЗначений;
		СписокНоменклатуры.Добавить(НайденнаяНоменклатура.Номенклатура);
		
		Если ФОКиоска.КаталогИзПрайсЛиста
			И НЕ ЭтаНоменклатураВходитВСписокПрайсЛиста(Строка(СписокНоменклатуры[0].Значение.УникальныйИдентификатор())) Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаСкрипта = ПолучитьСтраницуТовара(Строка(СписокНоменклатуры[0].Значение.УникальныйИдентификатор()), Истина);
		
		ПараметрыДляОбработкиШтрихкода.Вставить("ПоказатьТовары", СтрокаСкрипта);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеПоискаПоШтрихкодуСервер(Штрихкод, ПараметрыДляОбработкиШтрихкода)
	
	ДанныеШтрихкода = Новый Структура;
	РаботаСоШтрихкодамиПереопределяемый.ЗаполнитьДанныеПоискаПоШтрихкоду(Штрихкод, ЭтотОбъект, ДанныеШтрихкода);
	
	Если ДанныеШтрихкода <> Неопределено
		И ДанныеШтрихкода.ЗначенияПоиска.Количество() > 0 Тогда
		СтрокаРезультата = ДанныеШтрихкода.ЗначенияПоиска[0];
		ЗаполнитьДанныеПоШтрихкоду(СтрокаРезультата, ПараметрыДляОбработкиШтрихкода);
	КонецЕсли;
	
	Возврат ДанныеШтрихкода;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоискМагнитнойКарты(МагнитныйКод)
	
	// Ветка поиска по штрихкоду дополнительно ищет и по магнитному коду,
	// поэтому дергаем ее.
	ФильтрПоискаПоШтрихкоду = Новый Структура;
	ФильтрПоискаПоШтрихкоду.Вставить("Пользователи");
	ФильтрПоискаПоШтрихкоду.Вставить("ФизическиеЛица");
	ФильтрПоискаПоШтрихкоду.Вставить("ИнформационныеКарты");
	
	ПараметрыДляОбработкиШтрихкода = Новый Структура();
	ПараметрыДляОбработкиШтрихкода.Вставить("Штрихкод", МагнитныйКод);
	
	СтруктураПараметровКлиента = ДанныеПоискаПоШтрихкодуСервер(МагнитныйКод, ПараметрыДляОбработкиШтрихкода);
	ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента, ПараметрыДляОбработкиШтрихкода);
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураРеквизитовФормыДляДобавленияСтроки()
	
	ИменаРеквизитовОбъектаФормыРМК = ОбщегоНазначенияРМККлиент.ИменаРеквизитовОбъектаФормыРМКДляДобавленияСтроки();
	СтруктураРеквизитовОбъектаФормыРМК = Новый Структура(ИменаРеквизитовОбъектаФормыРМК);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитовОбъектаФормыРМК, Объект);
	
	ИменаРеквизитовФормыРМК = ОбщегоНазначенияРМККлиент.ИменаРеквизитовФормыРМКДляДобавленияСтроки();
	СтруктураРеквизитовФормыРМК = Новый Структура(ИменаРеквизитовФормыРМК);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитовФормыРМК, ЭтотОбъект);
	СтруктураРеквизитовФормыРМК.Вставить("Объект", СтруктураРеквизитовОбъектаФормыРМК);
	
	СтруктураРеквизитовФормыРМК.ОсновнаяОрганизация  = Объект.Организация;
	СтруктураРеквизитовФормыРМК.ВыбраннаяОрганизация = Объект.Организация;
	СтруктураРеквизитовФормыРМК.ОтображатьОстаток    = Ложь;
	СтруктураРеквизитовФормыРМК.РозничныйВидЦены     = Объект.ВидЦен;
	СтруктураРеквизитовФормыРМК.ИспользоватьКонтрольПродаж = Ложь;
	СтруктураРеквизитовФормыРМК.ИспользоватьВыборСкладаПриПродаже = Ложь;
	СтруктураРеквизитовФормыРМК.РежимКассыСамообслуживания        = Ложь;
	
	СтруктураРеквизитовФормыРМК.КэшРаспределенияПродаж = Новый Структура;
	СтруктураРеквизитовФормыРМК.КэшРаспределенияПродаж.Вставить("ГруппыКатегории", 0);
	СтруктураРеквизитовФормыРМК.КэшРаспределенияПродаж.Вставить("РаспределениеНоменклатуры", Новый Соответствие);
	СтруктураРеквизитовФормыРМК.КэшРаспределенияПродаж.Вставить("СистемаНалогообложения", Новый Соответствие);
	
	КассыККМИОрганизации = ПодключенныеКассыККМИОрганизации();
	МассивОрганизаций = КассыККМИОрганизации.МассивОрганизаций;
	
	СтруктураРеквизитовФормыРМК.Вставить("МассивОрганизаций", МассивОрганизаций);
	
	СтруктураРеквизитовФормыРМК.Вставить("ПризнакЗапрета", Истина);
	
	Возврат СтруктураРеквизитовФормыРМК;
	
КонецФункции

&НаКлиенте
Функция ПодключенныеКассыККМИОрганизации()
	
	МассивКассККМ = Новый Массив;
	МассивОрганизаций = Новый Массив;
	
	Для Каждого СтрокаКасс Из ТаблицаКассККМОрганизаций Цикл
		
		МассивКассККМ.Добавить(СтрокаКасс.КассаККМ);
		МассивОрганизаций.Добавить(СтрокаКасс.Организация);
		
	КонецЦикла;
	
	СтруктураКассККМИОрганизаций = Новый Структура();
	СтруктураКассККМИОрганизаций.Вставить("МассивКассККМ", МассивКассККМ);
	СтруктураКассККМИОрганизаций.Вставить("МассивОрганизаций", МассивОрганизаций);
	
	Возврат СтруктураКассККМИОрганизаций;
	
КонецФункции


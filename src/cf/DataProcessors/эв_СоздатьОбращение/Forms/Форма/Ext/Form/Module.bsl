
#Область ОписаниеПеременных

&НаКлиенте
Перем ОтправкаВыполняется;

&НаКлиенте
Перем ВнешнийИдентификаторОтправки;

#КонецОбласти

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = НСтр("ru = 'Создать обращение'");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СкриншотыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выберите скриншот'");
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = НСтр("ru = 'Изображения'") + "|*.png;*.jpg;*.jpeg;*.bmp;*.gif";
	Диалог.Показать(Новый ОписаниеОповещения("СкриншотыПослеВыбораФайла", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура СкриншотыПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Скриншоты.Добавить();
	НоваяСтрока.Скриншот = ВыбранныеФайлы[0];
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	
	Если ОтправкаВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(СокрЛП(Проблема)) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните поле ""Проблема"".'"));
		Возврат;
	КонецЕсли;
	
	ОтправкаВыполняется = Истина;
	Если ПустаяСтрока(ВнешнийИдентификаторОтправки) Тогда
		ВнешнийИдентификаторОтправки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	Очередь = Новый Массив;
	Для Каждого СтрокаСкриншота Из Скриншоты Цикл
		Путь = СокрЛП(СтрокаСкриншота.Скриншот);
		Если Не ПустаяСтрока(Путь) Тогда
			Очередь.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;
	
	Контекст = Новый Структура;
	Контекст.Вставить("Очередь", Очередь);
	Контекст.Вставить("Индекс", 0);
	Контекст.Вставить("Файлы", Новый Массив);
	ПоместитьСледующийСкриншот(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьСледующийСкриншот(Контекст)
	
	Если Контекст.Индекс >= Контекст.Очередь.Количество() Тогда
		ЗавершитьОтправку(Контекст.Очередь, Контекст.Файлы);
		Возврат;
	КонецЕсли;
	
	Путь = Контекст.Очередь[Контекст.Индекс];
	Оповещение = Новый ОписаниеОповещения("ПоместитьСкриншотЗавершение", ЭтотОбъект, Контекст);
	Попытка
		НачатьПомещениеФайла(Оповещение, , Путь, Ложь, УникальныйИдентификатор);
	Исключение
		ОтправкаВыполняется = Ложь;
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьСкриншотЗавершение(Помещен, Адрес, ВыбранноеИмяФайла, Контекст) Экспорт
	
	Если Не Помещен Тогда
		ОтправкаВыполняется = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось прочитать файл'") + " " + Контекст.Очередь[Контекст.Индекс]);
		Возврат;
	КонецЕсли;
	
	Файл = Новый Файл(Контекст.Очередь[Контекст.Индекс]);
	ИмяФайла = Файл.Имя;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "screenshot.png";
	КонецЕсли;
	
	Контекст.Файлы.Добавить(Новый Структура("ИмяФайла, Адрес", ИмяФайла, Адрес));
	Контекст.Индекс = Контекст.Индекс + 1;
	ПоместитьСледующийСкриншот(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОтправку(ПутиСкриншотов, ФайлыСкриншотов)
	
	Результат = эв_ОбработкаОбращений.СоздатьОбращение(ОбъектЗадачи, Проблема, ЧтоНеобходимоСделать, ПутиСкриншотов, ФайлыСкриншотов, ВнешнийИдентификаторОтправки);
	ОтправкаВыполняется = Ложь;
	
	Если Результат.Успех Тогда
		ВнешнийИдентификаторОтправки = "";
		ОбъектЗадачи = "";
		Проблема = "";
		ЧтоНеобходимоСделать = "";
		Скриншоты.Очистить();
		
		Сообщение = НСтр("ru = 'Обращение создано:'") + " " + Результат.Номер;
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			Сообщение = Сообщение + Символы.ПС + Результат.Ошибка;
		КонецЕсли;
		ПоказатьПредупреждение(
			Новый ОписаниеОповещения("ПослеУспешногоСозданияОбращения", ЭтотОбъект),
			Сообщение);
	Иначе
		ТекстОшибки = Результат.Ошибка;
		Если Не ПустаяСтрока(Результат.Номер) Тогда
			ТекстОшибки = Результат.Номер + Символы.ПС + ТекстОшибки;
		КонецЕсли;
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось создать обращение.'") + Символы.ПС + ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУспешногоСозданияОбращения(ДополнительныеПараметры) Экспорт
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

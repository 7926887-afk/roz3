	ПолеОбъект.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОбъект.ПутьКДанным = "ОбъектЗадачи";
	ПолеОбъект.Заголовок = "Объект";
	ПолеОбъект.РежимВыбораИзСписка = Ложь;
	ПолеОбъект.КнопкаВыпадающегоСписка = Истина;
	ПолеОбъект.ПодсказкаВвода = "Выберите из открытых окон или введите вручную";

	// Поле "Проблема".
	ПолеПроблема = Элементы.Добавить("Проблема", Тип("ПолеФормы"));
	ПолеПроблема.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПроблема.ПутьКДанным = "Проблема";
	ПолеПроблема.Заголовок = "Проблема";
	ПолеПроблема.МногострочныйРежим = Истина;
	ПолеПроблема.Высота = 6;
	ПолеПроблема.РасширенноеРедактирование = Ложь;

	// Поле "Что необходимо сделать".
	ПолеЧтоСделать = Элементы.Добавить("ЧтоНеобходимоСделать", Тип("ПолеФормы"));
	ПолеЧтоСделать.Вид = ВидПоляФормы.ПолеВвода;
	ПолеЧтоСделать.ПутьКДанным = "ЧтоНеобходимоСделать";
	ПолеЧтоСделать.Заголовок = "Что необходимо сделать";
	ПолеЧтоСделать.МногострочныйРежим = Истина;
	ПолеЧтоСделать.Высота = 6;

	// Поле "Скриншот": вставка из буфера обмена (Ctrl+V при активном поле)
	// или выбор файла кнопкой.
	ПолеСкриншот = Элементы.Добавить("Скриншот", Тип("ПолеФормы"));
	ПолеСкриншот.Вид = ВидПоляФормы.ПолеКартинки;
	ПолеСкриншот.ПутьКДанным = "Скриншот";
	ПолеСкриншот.Заголовок = "Скриншот";
	ПолеСкриншот.ТолькоПросмотр = Ложь;
	ПолеСкриншот.РазмерКартинки = РазмерКартинки.Пропорционально;
	ПолеСкриншот.Высота = 10;

	// Команды и кнопки.
	КомандаВыбратьФайл = Команды.Добавить("ВыбратьСкриншот");
	КомандаВыбратьФайл.Действие = "ВыбратьСкриншот";
	КомандаВыбратьФайл.Заголовок = "Выбрать файл скриншота";

	КомандаОчистить = Команды.Добавить("ОчиститьСкриншот");
	КомандаОчистить.Действие = "ОчиститьСкриншот";
	КомандаОчистить.Заголовок = "Убрать скриншот";

	КнопкаВыбратьФайл = Элементы.Добавить("КнопкаВыбратьСкриншот", Тип("КнопкаФормы"));
	КнопкаВыбратьФайл.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаВыбратьФайл.ИмяКоманды = "ВыбратьСкриншот";

	КнопкаОчистить = Элементы.Добавить("КнопкаОчиститьСкриншот", Тип("КнопкаФормы"));
	КнопкаОчистить.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаОчистить.ИмяКоманды = "ОчиститьСкриншот";

	КомандаОбновить = Команды.Добавить("ОбновитьСписокОбъектов");
	КомандаОбновить.Действие = "ОбновитьСписокОбъектов";
	КомандаОбновить.Заголовок = "Обновить список окон";

	КомандаОтправить = Команды.Добавить("Отправить");
	КомандаОтправить.Действие = "Отправить";
	КомандаОтправить.Заголовок = "Отправить";

	КнопкаОбновить = Элементы.Добавить("КнопкаОбновитьСписокОбъектов", Тип("КнопкаФормы"));
	КнопкаОбновить.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаОбновить.ИмяКоманды = "ОбновитьСписокОбъектов";

	КнопкаОтправить = Элементы.Добавить("КнопкаОтправить", Тип("КнопкаФормы"));
	КнопкаОтправить.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаОтправить.ИмяКоманды = "Отправить";
	КнопкаОтправить.КнопкаПоУмолчанию = Истина;

	ЭтотОбъект.Заголовок = "Отправка задачи в Jira";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Скриншот делаем первым: пока ПриОткрытии не завершилась, окно самой формы ещё не показано
	// (при синхронном запуске), поэтому в кадр оно не попадает.
	СделатьАвтоматическийСкриншот();
	ЗаполнитьСписокОбъектов();

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ОбновитьСписокОбъектов(Команда)

	ЗаполнитьСписокОбъектов();

КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(СокрЛП(ЭтотОбъект.Проблема)) Тогда
		ПоказатьПредупреждение(, "Заполните поле ""Проблема"".");
		Возврат;
	КонецЕсли;

	Результат = ОтправитьЗадачуНаСервере(ЭтотОбъект.ОбъектЗадачи, ЭтотОбъект.Проблема, ЭтотОбъект.ЧтоНеобходимоСделать);

	Если Результат.Успех Тогда
		ЭтотОбъект.ОбъектЗадачи = "";
		ЭтотОбъект.Проблема = "";
		ЭтотОбъект.ЧтоНеобходимоСделать = "";
		ОчиститьСкриншотНаСервере();
		Сообщение = "Задача создана в Jira: " + Результат.Ключ + Символы.ПС + Результат.Ссылка;
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			Сообщение = Сообщение + Символы.ПС + Символы.ПС + Результат.Ошибка;
		КонецЕсли;
		ПоказатьПредупреждение(, Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Не удалось создать задачу." + Символы.ПС + Результат.Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСкриншот(Команда)

	НачатьПомещениеФайла(Новый ОписаниеОповещения("ВыбратьСкриншотЗавершение", ЭтотОбъект), , "", Истина,
		ЭтотОбъект.УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСкриншотЗавершение(Помещен, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Помещен Тогда
		УстановитьСкриншотНаСервере(Адрес);
	КонецЕсли;

КонецПроцедуры

#Область АвтоматическийСкриншот

&НаКлиенте
Процедура СделатьАвтоматическийСкриншот()

	Попытка
		КаталогВремени = КаталогВременныхФайлов();
		Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		ИмяСкрипта = КаталогВремени + "jira_scr_" + Идентификатор + ".ps1";
		ИмяКартинки = КаталогВремени + "jira_scr_" + Идентификатор + ".png";

		// Скрипт содержит только ASCII-символы, путь к картинке передаётся параметром.
		Скрипт = Новый ТекстовыйДокумент;
		Скрипт.ДобавитьСтроку("param([string]$Path)");
		Скрипт.ДобавитьСтроку("Add-Type -AssemblyName System.Windows.Forms,System.Drawing");
		Скрипт.ДобавитьСтроку("Add-Type -MemberDefinition '[DllImport(""user32.dll"")] public static extern bool SetProcessDPIAware();' -Name D -Namespace W");
		Скрипт.ДобавитьСтроку("[W.D]::SetProcessDPIAware() | Out-Null");
		Скрипт.ДобавитьСтроку("$b = [System.Windows.Forms.SystemInformation]::VirtualScreen");
		Скрипт.ДобавитьСтроку("$bmp = New-Object System.Drawing.Bitmap $b.Width, $b.Height");
		Скрипт.ДобавитьСтроку("$g = [System.Drawing.Graphics]::FromImage($bmp)");
		Скрипт.ДобавитьСтроку("$g.CopyFromScreen($b.Location, [System.Drawing.Point]::Empty, $b.Size)");
		Скрипт.ДобавитьСтроку("$bmp.Save($Path, [System.Drawing.Imaging.ImageFormat]::Png)");
		Скрипт.ДобавитьСтроку("$g.Dispose(); $bmp.Dispose()");
		Скрипт.Записать(ИмяСкрипта, КодировкаТекста.ANSI);

		Команда = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ + ИмяСкрипта
			+ """ """ + ИмяКартинки + """";

		Параметры = Новый Структура("ИмяСкрипта, ИмяКартинки", ИмяСкрипта, ИмяКартинки);

		Попытка
			// Синхронный запуск: форма не появится, пока снимок не сделан.
			ЗапуститьПриложение(Команда, КаталогВремени, Истина);
			ПослеЗапускаСкриншота(0, Параметры);
		Исключение
			// Синхронные вызовы запрещены в конфигурации: запускаем асинхронно (форма может попасть в кадр).
			НачатьЗапускПриложения(Новый ОписаниеОповещения("ПослеЗапускаСкриншота", ЭтотОбъект, Параметры),
				Команда, КаталогВремени, Истина);
		КонецПопытки;
	Исключение
		// Автоматический скриншот необязателен: при любой ошибке просто работаем без него.
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗапускаСкриншота(КодВозврата, Параметры) Экспорт

	Попытка
		Проверка = Новый Файл(Параметры.ИмяКартинки);
		Проверка.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ПослеПроверкиСкриншота", ЭтотОбъект, Параметры));
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиСкриншота(Существует, Параметры) Экспорт

	Если Существует Тогда
		Попытка
			НачатьПомещениеФайла(Новый ОписаниеОповещения("ПослеЗагрузкиСкриншота", ЭтотОбъект, Параметры),
				, Параметры.ИмяКартинки, Ложь, ЭтотОбъект.УникальныйИдентификатор);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗагрузкиСкриншота(Помещен, Адрес, ВыбранноеИмяФайла, Параметры) Экспорт

	Если Помещен Тогда
		УстановитьСкриншотНаСервере(Адрес);
	КонецЕсли;

	// Удаляем временные файлы.
	Попытка
		НачатьУдалениеФайлов(Новый ОписаниеОповещения("ПослеУдаленияВременныхФайлов", ЭтотОбъект), Параметры.ИмяКартинки);
		НачатьУдалениеФайлов(Новый ОписаниеОповещения("ПослеУдаленияВременныхФайлов", ЭтотОбъект), Параметры.ИмяСкрипта);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеУдаленияВременныхФайлов(ДополнительныеПараметры) Экспорт
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОчиститьСкриншот(Команда)

	ОчиститьСкриншотНаСервере();

КонецПроцедуры

&НаСервере
Процедура УстановитьСкриншотНаСервере(Знач Адрес)

	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		ЭтотОбъект.Скриншот = Новый ХранилищеЗначения(Новый Картинка(Данные), Новый СжатиеДанных(9));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьСкриншотНаСервере()

	ЭтотОбъект.Скриншот = Новый ХранилищеЗначения(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОткрытыеОкна

&НаКлиенте
Процедура ЗаполнитьСписокОбъектов()

	Список = Элементы.ОбъектЗадачи.СписокВыбора;
	Список.Очистить();
	Добавленные = Новый Соответствие;

	Попытка
		Окна = ПолучитьОкна();
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Окно Из Окна Цикл

		Попытка
			Содержимое = Окно.Содержимое;
		Исключение
			Продолжить;
		КонецПопытки;

		Для Каждого ОткрытаяФорма Из Содержимое Цикл

			Попытка
				ИмяФормы = ОткрытаяФорма.ИмяФормы;
				Заголовок = ОткрытаяФорма.Заголовок;
			Исключение
				Продолжить;
			КонецПопытки;

			// Пропускаем саму обработку.
			Если СтрНачинаетсяС(ИмяФормы, "ВнешняяОбработка.") Тогда
				Продолжить;
			КонецЕсли;

			// Имя объекта метаданных: всё, что до ".Форма.".
			ПозицияФормы = СтрНайти(ИмяФормы, ".Форма.");
			Если ПозицияФормы > 0 Тогда
				ИмяОбъекта = Лев(ИмяФормы, ПозицияФормы - 1);
			Иначе
				ИмяОбъекта = ИмяФормы;
			КонецЕсли;

			Если ПустаяСтрока(Заголовок) Тогда
				Значение = ИмяОбъекта;
			Иначе
				Значение = СокрЛП(Заголовок) + " [" + ИмяОбъекта + "]";
			КонецЕсли;

			Если Добавленные[Значение] = Неопределено Тогда
				Добавленные[Значение] = Истина;
				Список.Добавить(Значение);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОтправкаВJira

&НаСервере
Функция ОтправитьЗадачуНаСервере(Знач ОбъектЗадачи, Знач Проблема, Знач ЧтоНеобходимоСделать)

	Результат = Новый Структура("Успех, Ключ, Ссылка, Ошибка", Ложь, "", "", "");
	Настройки = НастройкиJira();

	Если ПустаяСтрока(Настройки.Email) Или СтрНачинаетсяС(Настройки.Email, "ВАШ_")
		Или ПустаяСтрока(Настройки.ApiToken) Или СтрНачинаетсяС(Настройки.ApiToken, "ВАШ_") Тогда
		Результат.Ошибка = "В функции НастройкиJira не заполнены Email и ApiToken.";
		Возврат Результат;
	КонецЕсли;

	// Заголовок: объект + первая строка проблемы (не длиннее 200 символов).
	ПерваяСтрока = СокрЛП(СтрПолучитьСтроку(Проблема, 1));
	Если ПустаяСтрока(ОбъектЗадачи) Тогда
		Заголовок = ПерваяСтрока;
	Иначе
		Заголовок = СокрЛП(ОбъектЗадачи) + ": " + ПерваяСтрока;
	КонецЕсли;
	Если СтрДлина(Заголовок) > 200 Тогда
		Заголовок = Лев(Заголовок, 197) + "...";
	КонецЕсли;

	// Описание в формате Atlassian Document Format.
	Содержимое = Новый Массив;
	Если Не ПустаяСтрока(ОбъектЗадачи) Тогда
		Содержимое.Добавить(АбзацADF("Объект: " + СокрЛП(ОбъектЗадачи)));
	КонецЕсли;
	Содержимое.Добавить(АбзацADF("Проблема:"));
	ДобавитьСтрокиADF(Содержимое, Проблема);
	Если Не ПустаяСтрока(СокрЛП(ЧтоНеобходимоСделать)) Тогда
		Содержимое.Добавить(АбзацADF("Что необходимо сделать:"));
		ДобавитьСтрокиADF(Содержимое, ЧтоНеобходимоСделать);
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("type", "doc");
	Описание.Вставить("version", 1);
	Описание.Вставить("content", Содержимое);

	Поля = Новый Структура;
	Поля.Вставить("project", Новый Структура("key", Настройки.КлючПроекта));
	Поля.Вставить("summary", Заголовок);
	Поля.Вставить("issuetype", Новый Структура("name", Настройки.ТипЗадачи));
	Поля.Вставить("description", Описание);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("fields", Поля));
	Тело = Запись.Закрыть();

	// Basic-авторизация: email:token в Base64.
	Авторизация = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Настройки.Email + ":" + Настройки.ApiToken, КодировкаТекста.UTF8));
	Авторизация = СтрЗаменить(СтрЗаменить(Авторизация, Символы.ПС, ""), Символы.ВК, "");

	Запрос = Новый HTTPЗапрос("/rest/api/3/issue");
	Запрос.Заголовки.Вставить("Authorization", "Basic " + Авторизация);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение(Настройки.Хост, 443, Неопределено, Неопределено, Неопределено, 30,
			Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Если Ответ.КодСостояния = 201 Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Результат.Успех = Истина;
		Результат.Ключ = Данные["key"];
		Результат.Ссылка = "https://" + Настройки.Хост + "/browse/" + Результат.Ключ;

		// Вложение со скриншотом (если есть).
		ДанныеСкриншота = ПолучитьДвоичныеДанныеСкриншота(ЭтотОбъект.Скриншот);
		Если ДанныеСкриншота <> Неопределено Тогда
			ОшибкаВложения = ПрикрепитьСкриншот(Соединение, Авторизация, Результат.Ключ, ДанныеСкриншота);
			Если Не ПустаяСтрока(ОшибкаВложения) Тогда
				Результат.Ошибка = "Задача создана, но скриншот не прикреплён: " + ОшибкаВложения;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Результат.Ошибка = "HTTP " + Ответ.КодСостояния + ": " + ТелоОтвета;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДвоичныеДанныеСкриншота(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Если ПустаяСтрока(Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Попытка
			Значение = ПолучитьИзВременногоХранилища(Значение);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Картинка") Тогда
		Возврат Значение.ПолучитьДвоичныеДанные();
	ИначеЕсли ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		Результат = Значение.Получить();
		Если ТипЗнч(Результат) = Тип("Картинка") Тогда
			Возврат Результат.ПолучитьДвоичныеДанные();
		ИначеЕсли ТипЗнч(Результат) = Тип("ДвоичныеДанные") Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает пустую строку при успехе или текст ошибки.
&НаСервереБезКонтекста
Функция ПрикрепитьСкриншот(Соединение, Знач Авторизация, Знач КлючЗадачи, Знач ДанныеСкриншота)

	// Определяем формат по сигнатуре файла.
	Расширение = "png";
	ТипСодержимого = "image/png";
	Если ДанныеСкриншота.Размер() >= 4 Тогда
		Чтение = Новый ЧтениеДанных(ДанныеСкриншота);
		Байт1 = Чтение.ПрочитатьБайт();
		Байт2 = Чтение.ПрочитатьБайт();
		Чтение.Закрыть();
		Если Байт1 = 255 И Байт2 = 216 Тогда
			Расширение = "jpg";
			ТипСодержимого = "image/jpeg";
		ИначеЕсли Байт1 = 66 И Байт2 = 77 Тогда
			Расширение = "bmp";
			ТипСодержимого = "image/bmp";
		КонецЕсли;
	КонецЕсли;

	Граница = "----1CJiraBoundary" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	Начало = "--" + Граница + Символы.ВК + Символы.ПС
		+ "Content-Disposition: form-data; name=""file""; filename=""screenshot." + Расширение + """" + Символы.ВК + Символы.ПС
		+ "Content-Type: " + ТипСодержимого + Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС;
	Конец = Символы.ВК + Символы.ПС + "--" + Граница + "--" + Символы.ВК + Символы.ПС;

	Поток = Новый ПотокВПамяти;
	Запись = Новый ЗаписьДанных(Поток);
	Запись.Записать(ПолучитьДвоичныеДанныеИзСтроки(Начало, КодировкаТекста.UTF8, Ложь));
	Запись.Записать(ДанныеСкриншота);
	Запись.Записать(ПолучитьДвоичныеДанныеИзСтроки(Конец, КодировкаТекста.UTF8, Ложь));
	Запись.Закрыть();
	Тело = Поток.ЗакрытьИПолучитьДвоичныеДанные();

	Запрос = Новый HTTPЗапрос("/rest/api/3/issue/" + КлючЗадачи + "/attachments");
	Запрос.Заголовки.Вставить("Authorization", "Basic " + Авторизация);
	Запрос.Заголовки.Вставить("X-Atlassian-Token", "no-check");
	Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Запрос.УстановитьТелоИзДвоичныхДанных(Тело);

	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Если Ответ.КодСостояния = 200 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

КонецФункции

&НаСервереБезКонтекста
Функция АбзацADF(Знач Текст)

	Абзац = Новый Структура;
	Абзац.Вставить("type", "paragraph");
	Узел = Новый Структура("type, text", "text", Текст);
	Абзац.Вставить("content", Новый Массив);
	Абзац.content.Добавить(Узел);
	Возврат Абзац;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокиADF(Содержимое, Знач Текст)

	Для Н = 1 По СтрЧислоСтрок(Текст) Цикл
		ТекстСтроки = СокрЛП(СтрПолучитьСтроку(Текст, Н));
		Если Не ПустаяСтрока(ТекстСтроки) Тогда
			Содержимое.Добавить(АбзацADF(ТекстСтроки));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

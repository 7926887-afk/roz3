&НаСервере
Функция ПроверитьОстаткиЖНВЛП()
	
	Если СписокМагазинов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Установим дату, если она не заполнена в шапке.
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ТаблицаВыгрузкиДанные = РеквизитФормыВЗначение("ТаблицаВыгрузки");
	Если ТаблицаВыгрузкиДанные.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	СписокСтруктурныхЕдиниц.Значение КАК СтруктурнаяЕдиница
	|ПОМЕСТИТЬ втСтруктурныеЕдиницы
	|ИЗ
	|	&СписокСтруктурныхЕдиниц КАК СписокСтруктурныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка КАК Склад,
	|	СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы КАК ТипСтруктурнойЕдиницы
	|ПОМЕСТИТЬ ДанныеТорговогоОбъекта
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|ГДЕ
	|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
	|	И СтруктурныеЕдиницы.Ссылка В
	|			(ВЫБРАТЬ
	|				ТорговыеОбъекты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
	|			ИЗ
	|				втСтруктурныеЕдиницы КАК ТорговыеОбъекты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка КАК Склад
	|ПОМЕСТИТЬ ТаблицаСклады
	|ИЗ
	|	ДанныеТорговогоОбъекта КАК ДанныеТорговогоОбъекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ПО ДанныеТорговогоОбъекта.Склад = СтруктурныеЕдиницы.Родитель
	|ГДЕ
	|	ДанныеТорговогоОбъекта.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка
	|ИЗ
	|	ДанныеТорговогоОбъекта КАК ДанныеТорговогоОбъекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ПО ДанныеТорговогоОбъекта.Склад = СтруктурныеЕдиницы.Ссылка
	|ГДЕ
	|	(ДанныеТорговогоОбъекта.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Склад)
	|			ИЛИ ДанныеТорговогоОбъекта.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Розница))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ТоварыИзТаблицы
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ТоварыНаСкладахОстатки.Номенклатура.Представление КАК НоменклатураПредставление,
	|	ТоварыНаСкладахОстатки.Характеристика.Представление КАК ХарактеристикаПредставление,
	|	ТоварыНаСкладахОстатки.СтруктурнаяЕдиница.Представление КАК СкладПредставление,
	|	ТоварыНаСкладахОстатки.Номенклатура.ЕдиницаИзмерения.Представление КАК ЕдиницаИзмеренияПредставление
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|			&Дата,
	|			Номенклатура.ор_ЖНВЛС
	|				И СтруктурнаяЕдиница В
	|					(ВЫБРАТЬ
	|						ТаблицаСклады.Склад КАК СтруктурнаяЕдиница
	|					ИЗ
	|						ТаблицаСклады КАК ТаблицаСклады)) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыИзТаблицы КАК ТоварыИзТаблицы
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыИзТаблицы.Номенклатура
	|			И ТоварыНаСкладахОстатки.Характеристика = ТоварыИзТаблицы.Характеристика
	|ГДЕ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
	|	И ТоварыИзТаблицы.Номенклатура ЕСТЬ NULL";
	
	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СписокСтруктурныхЕдиниц", СписокМагазинов);
	Запрос.УстановитьПараметр("Дата",                    Дата);
	Запрос.УстановитьПараметр("Таблица",                 ТаблицаВыгрузкиДанные);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ПредставлениеХарактеристики = ?(ЗначениеЗаполнено(Выборка.ХарактеристикаПредставление),"("+ Строка(Выборка.ХарактеристикаПредставление) +")", ""); 
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Товар %1%2 присутствует на складе %3 в количестве %4 %5'"),
										Выборка.НоменклатураПредставление,
										ПредставлениеХарактеристики,
										Выборка.СкладПредставление,
										Выборка.КоличествоОстаток,
										Выборка.ЕдиницаИзмеренияПредставление);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПодготовитьДанныеДляПересчета(ТекСтрока)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекСтрока", ТекСтрока);
	
	ОповещениеПересчетаЦен  = Новый ОписаниеОповещения("ПересчетЦенВопросЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОповещениеПересчетаЦен,"Выполнить пересчет цен?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКонтрагентаНаСервере(ДокументПоступления)
	 Возврат ДокументПоступления.Контрагент;
КонецФункции

&НаСервере
Функция СвернутьСписокЗначений(СписокМагазинов)
	
	ТаблицаЗначений = Новый ТаблицаЗначений();
	ТаблицаЗначений.Колонки.Добавить("СтруктурнаяЕдиница", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	
	Для каждого ЭлементСписка ИЗ СписокМагазинов Цикл
		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			НоваяСтрока = ТаблицаЗначений.Добавить();
			НоваяСтрока.СтруктурнаяЕдиница = ЭлементСписка.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЗначений.Свернуть("СтруктурнаяЕдиница");
	
	Возврат ТаблицаЗначений.ВыгрузитьКолонку("СтруктурнаяЕдиница");

КонецФункции

&НаКлиенте
Процедура СообщитьДублиНоменклатуры(ИндексыДублей)
	
	Для Каждого ДанныеДублей Из ИндексыДублей Цикл
		
		нТекстСообщения = СтрШаблон(НСтр("ru='Номенклатура %1 сопоставлена для нескольких товаров поставщика:'"), ДанныеДублей.Номенклатура); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(нТекстСообщения);
		
		Для Счетчик = 0 По ДанныеДублей.Индексы.ВГраница() Цикл
			Индекс = ДанныеДублей.Индексы[Счетчик];
			СтрокаТаблицы = ТаблицаСопоставления[Индекс];
			
			ТекстСообщения = СтрШаблон(НСтр("ru=' %1. Номенклатура %2;'"), Счетчик + 1, СтрокаТаблицы.НоменклатураПоставщика); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСопоставления", Индекс + 1, "Номенклатура"));
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

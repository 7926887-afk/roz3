	// Итоговая таблица для выгрузки в файл.
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицыДляВыгрузки.Номенклатура КАК Номенклатура,
	|	ТаблицыДляВыгрузки.Характеристика КАК Характеристика,
	|	СУММА(ТаблицыДляВыгрузки.Количество) КАК Количество,
	|	ТаблицыДляВыгрузки.ЦенаПроизводителя КАК ЦенаПроизводителя,
	|	ТаблицыДляВыгрузки.ЦенаЗакупочная КАК ЦенаЗакупочная,
	|	ТаблицыДляВыгрузки.ЦенаРозничная КАК ЦенаРозничная,
	|	ТаблицыДляВыгрузки.Поставщик КАК Поставщик,
	|	ТаблицыДляВыгрузки.Артикул КАК Артикул
	|ИЗ
	|	НоменклатурыСгрупированныеСПоступлением КАК ТаблицыДляВыгрузки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицыДляВыгрузки.Номенклатура,
	|	ТаблицыДляВыгрузки.Характеристика,
	|	ТаблицыДляВыгрузки.ЦенаПроизводителя,
	|	ТаблицыДляВыгрузки.ЦенаЗакупочная,
	|	ТаблицыДляВыгрузки.ЦенаРозничная,
	|	ТаблицыДляВыгрузки.Поставщик,
	|	ТаблицыДляВыгрузки.Артикул";
	
	Запрос.УстановитьПараметр("ПрайсЛист", ПрайсЛист);
	Запрос.УстановитьПараметр("Таблица",   Таблица);
	
	Выборка = Запрос.ВыполнитьПакет();
	ВыборкаСПоступлениями  = Выборка[3].Выгрузить();
	ВыборкаСгруппированная = Выборка[4].Выгрузить();
	
	ЕстьОшибкиЗаполнения = Ложь;
	ТекстСообщенияКритичныеОшибки = "";
	
	НомерСтроки = 0;
	
	// Произведем проверку по не группированным строкам, что указать пользователю
	// где и что не заполнено.
	Для Каждого СтрокаПроверки Из ВыборкаСПоступлениями Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Номенклатура) Тогда
			мСообщитьОбОшибке("В строке № "+НомерСтроки+" не заполнена номенклатура!",,,"ТаблицаВыгрузки["+Строка(НомерСтроки - 1)+"].Номенклатура");
			ЕстьОшибкиЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Характеристика) Тогда
			мСообщитьОбОшибке("В строке № "+НомерСтроки+" не заполнена характеристика!",,,"ТаблицаВыгрузки["+Строка(НомерСтроки - 1)+"].Характеристика");
			ЕстьОшибкиЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Количество) Тогда
			мСообщитьОбОшибке("В строке № "+НомерСтроки+" не заполнено количество!",,,"ТаблицаВыгрузки["+Строка(НомерСтроки - 1)+"].Количество");
			ЕстьОшибкиЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.ЦенаПроизводителя) Тогда
			мСообщитьОбОшибке("В строке № "+НомерСтроки+" не заполнена цена производителя!",,,"ТаблицаВыгрузки["+Строка(НомерСтроки - 1)+"].ЦенаПроизводителя");
			ЕстьОшибкиЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.ЦенаЗакупочная) Тогда
			мСообщитьОбОшибке("В строке № "+НомерСтроки+" не заполнена цена закупочная!",,,"ТаблицаВыгрузки["+Строка(НомерСтроки - 1)+"].ЦенаЗакупочная");
			ЕстьОшибкиЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.ЦенаРозничная) Тогда
			мСообщитьОбОшибке("В строке № "+НомерСтроки+" не заполнена цена розничная!",,,"ТаблицаВыгрузки["+Строка(НомерСтроки - 1)+"].ЦенаРозничная");
			ЕстьОшибкиЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Поставщик) Тогда
			мСообщитьОбОшибке("В строке № "+НомерСтроки+" не заполнен поставщик!",,,"ТаблицаВыгрузки["+Строка(НомерСтроки - 1)+"].Поставщик");
			ЕстьОшибкиЗаполнения = Истина;
		КонецЕсли;
		
		Если ЕстьОшибкиЗаполнения Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Артикул) Тогда
			// ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке №"+НомерСтроки+" для номенклатуры """+Выборка.Номенклатура+""" нет данных о товаре поставщика. Строка не выгружена в файл",, "ТаблицаВыгрузки["+Строка(НомерСтроки-1)+"].Номенклатура");
			мСообщитьОбОшибке("В строке №"+НомерСтроки+" для номенклатуры """+СтрокаПроверки.Номенклатура+""" нет данных о товаре поставщика. Строка не выгружена в файл",Ложь,,"ТаблицаВыгрузки["+Строка(НомерСтроки-1)+"].Номенклатура");
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	МассивСтрокВыгрузки = Новый Массив;
	
	Если ЕстьОшибкиЗаполнения Тогда
		Возврат МассивСтрокВыгрузки;
	КонецЕсли;
	
	СтрокаЗаголовка = ПолучитьСтрокуИзМассива(МассивКолонокФайлаВыгрузки, ";");
	МассивСтрокВыгрузки.Добавить(СтрокаЗаголовка);
	
	// Обойдем сгруппированные строки выборки и запишем в файл.
	Для Каждого СтрокаВыгрузки Из ВыборкаСгруппированная Цикл
		
		Артикул = СтрокаВыгрузки.Артикул;
		ДанныеАртикула = РазобратьАртикулПоставщика(Артикул);
		
		МассивДанныхСтрокиВыгрузки = Новый Массив;
		// ВАЖНО: элементы в массив добавляются строго в том порядке, в котором был сформирован заголовок, чтобы не было путаницы!!!
		
		// "DrugId"	- Число 		- Уникальный идентификатор ЛС в системе мониторинга цен
		МассивДанныхСтрокиВыгрузки.Добавить(ДанныеАртикула[0]);
		
		// "VendorID" - Число			- Код поставщика для системы мониторинга цен (из карточки контрагента поступления берется)
		МассивДанныхСтрокиВыгрузки.Добавить(СтрокаВыгрузки.Поставщик.ор_КодПоставщикаВСистемеМониторингаЦен);
		
		// "Segment"	- Число 		- Сегмент (1 - амбулаторный, 2 - госпитальный). У нас всегда 1
		МассивДанныхСтрокиВыгрузки.Добавить(1);
		
		// "Year"	- Число(4,0)	- Год даты поступления
		МассивДанныхСтрокиВыгрузки.Добавить(Формат(Год(ДатаВыгрузки), "ЧГ=0"));
		
		// "Month"	- Число(1-12)	- Месяц даты поступления
		МассивДанныхСтрокиВыгрузки.Добавить(Месяц(ДатаВыгрузки));
		
		// "Series"	- Строка		- Серийный номер выгружаемой серии номенклатуры
		МассивДанныхСтрокиВыгрузки.Добавить(?(Не ЗначениеЗаполнено(СтрокаВыгрузки.Характеристика.ор_СерияПроизводителя),"-", СтрокаВыгрузки.Характеристика.ор_СерияПроизводителя));
		
		// "TotDrugQn" - Число			- Количество закупленных упаковок номенклатуры в единице измерения прайс-листа
		МассивДанныхСтрокиВыгрузки.Добавить(Формат(СтрокаВыгрузки.Количество, "ЧДЦ=2; ЧРД=.; ЧН="));
		
		// "Funds"	- Число			- Средства на закупку (сумма поступления из документа с НДС). Для амбулаторного сегмента всегда 0.00. 
		МассивДанныхСтрокиВыгрузки.Добавить(Формат(0,"ЧЦ=3; ЧДЦ=2; ЧРД=.; ЧН="));
		
		// "MnfPrice" - Число			- Цена производителя или импортера в рублях (в валюте регламентированного учета)
		МассивДанныхСтрокиВыгрузки.Добавить(Формат(СтрокаВыгрузки.ЦенаПроизводителя,"ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН="));
		
		// "PrcPrice" - Число         - Закупочная цена одной упаковки с НДС в единицах измерения прайса в рублях.
		МассивДанныхСтрокиВыгрузки.Добавить(Формат(СтрокаВыгрузки.ЦенаЗакупочная,"ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН="));
		
		// "RtlPrice" - Число			- Розничная цена одной упаковки в единицах измерения прайса в рублях
		МассивДанныхСтрокиВыгрузки.Добавить(Формат(СтрокаВыгрузки.ЦенаРозничная,"ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН="));
		
		// "Remark"	- Строка        - Примечание
		МассивДанныхСтрокиВыгрузки.Добавить("");
		
		// "SrcOrg"	- Число         - Идентификатор организации, предоставившей сведения о цене
		МассивДанныхСтрокиВыгрузки.Добавить("");
		
		СтрокаЗаписи = ПолучитьСтрокуИзМассива(МассивДанныхСтрокиВыгрузки, ";", Истина);
		МассивСтрокВыгрузки.Добавить(СтрокаЗаписи);
	
	КонецЦикла;
	
	Возврат МассивСтрокВыгрузки;
	
КонецФункции

#КонецОбласти

// Выводит сообщение об ошибке и выставляет параметр Отказ в "Истина". 
// В случае работы на клиенте или на сервере выводит в окно сообщений,
// в случае внешнего соединения вызывает исключение.
//
// Параметры:
//  ТекстСообщения - Строка	- Текст сообщения.
//  Отказ          - Булево	- Признак отказа (необязательный).
//  Заголовок      - Строка	- Заголовок (необязательный).
//
Процедура мСообщитьОбОшибке(ТекстСообщения, ВызыватьИсключение = Истина, Заголовок = "", Поле = "") Экспорт

	НачалоСлужебногоСообщения    = Найти(ТекстСообщения, "{");
	ОкончаниеСлужебногоСообщения = Найти(ТекстСообщения, "}:");
	Если ОкончаниеСлужебногоСообщения > 0 И НачалоСлужебногоСообщения > 0 Тогда
		ТекстСообщения = Лев(ТекстСообщения, (НачалоСлужебногоСообщения - 1)) +
		                 Сред(ТекстСообщения, (ОкончаниеСлужебногоСообщения + 2));
	КонецЕсли;
	
	
	#Если ВнешнееСоединение Тогда
		
		Если ЗначениеЗаполнено(Заголовок) Тогда
			ТекстСообщения = Заголовок + Символы.ПС + ТекстСообщения;
			Заголовок = "";
		КонецЕсли;
		
		Если ВызыватьИсключение Тогда
			ВызватьИсключение (ТекстСообщения);
		КонецЕсли;
		
	#Иначе
		
		Если ЗначениеЗаполнено(Заголовок) Тогда
			Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru= '%1'"), Заголовок);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Заголовок);
			
			Заголовок = "";
		КонецЕсли;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru= '%1'"), ТекстСообщения);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,Поле);
		
	#КонецЕсли
	
КонецПроцедуры // СообщитьОбОшибке()

// Процедура получения строки из значений массива
//
Функция ПолучитьСтрокуИзМассива(МассивЗначений, Разделитель, НужноУбратьПробелВНулевомЭлементе = Ложь)
	Строка = "";
	СчитаноЭлементов = 0;
	// Необходимо для DrugID и VendorID убирать дописываемые пробелы от 1С. Пример, было - ххх ххх; стало - хххххх
	Для Каждого ЗначениеМассива Из МассивЗначений Цикл
		Если НужноУбратьПробелВНулевомЭлементе И СчитаноЭлементов < 2 Тогда
			Строка = Строка+СтрЗаменить(Строка(ЗначениеМассива),Символы.НПП,"")+Разделитель;
			СчитаноЭлементов = СчитаноЭлементов + 1;
		Иначе
			Строка = Строка+ЗначениеМассива+Разделитель;
		КонецЕсли;
	КонецЦикла;
	Строка = Лев(Строка, СтрДлина(Строка)-1);
	Возврат Строка;
КонецФункции
	
// Функция проверки корректности заполнения реквизитов
//
Функция ПроверитьКорректностьЗаполнения() Экспорт
	
	ТекстСообщения 	= "";
	Поле 			= "";
	ЕстьОшибки 		= Ложь;
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		мСообщитьОбОшибке("Не указан контрагент!",,,"Контрагент");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПрайсЛист) Тогда
		мСообщитьОбОшибке("Не указан прайс-лист контрагента!",,,"ПрайсЛист");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(ПрайсЛист) И ПрайсЛист.Владелец<>Контрагент Тогда
		мСообщитьОбОшибке("Прайс-лист """+ПрайсЛист+""" не является прайс-листом контрагента """+Контрагент+"""!",,,"ПрайсЛист");
		Поле = "ПрайсЛист";
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПрайсЛист) И НЕ ПрайсЛист.ПрайсЛистДляМониторингаЦен Тогда
		мСообщитьОбОшибке("Прайс-лист """+ПрайсЛист+""" не является прайс-листом для мониторинга цен!",,,"ПрайсЛист");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

// Функция получения подстроки из файла с учетом кавычек
//
Функция ПолучитьПодстрокуДоРазделителяСУчетомКовычек(Знач Стр, Разделитель)
	
	ПозицияРазделителя = Найти(Стр, Разделитель);
	Если ПозицияРазделителя = 0 Тогда
		Возврат Стр;
	КонецЕсли;
	
	ПозицияОткрывающейКавычки = Найти(Стр, """");
	Если ПозицияОткрывающейКавычки = 0 Или ПозицияОткрывающейКавычки > ПозицияРазделителя Тогда
		
		ПодстрокаДоРазделителя = Лев(Стр, ПозицияРазделителя - 1);
		
	Иначе
		
		ПодстрокаДоРазделителя = Лев(Стр, ПозицияОткрывающейКавычки);
		Стр = Сред(Стр, ПозицияОткрывающейКавычки + 1);
		
		ПозицияЗакрывающейКавычки = Найти(Стр, """");
		
		ПодстрокаДоРазделителя = ПодстрокаДоРазделителя + Лев(Стр, ПозицияЗакрывающейКавычки);
		Стр = Сред(Стр, ПозицияЗакрывающейКавычки + 1);
		
		ПодстрокаДоРазделителя = ПодстрокаДоРазделителя + ПолучитьПодстрокуДоРазделителяСУчетомКовычек(Стр, Разделитель);
		
	КонецЕсли;
		
	Возврат ПодстрокаДоРазделителя;
	
КонецФункции 

// Функция получения строки без кавычек
//
Функция ПолучитьСтрокуБезКовычек(Стр)
	
	Результат = СокрЛП(Стр);
	
	Если Не ПустаяСтрока(Результат) Тогда
		
		Если Лев(Результат, 1) = """" И Прав(Результат, 1) = """" Тогда
			Результат = Сред(Результат, 2, СтрДлина(Результат) - 2);
			Результат = СокрЛП(Результат);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;		
	
КонецФункции

// Функция разбора строки в массив подстрок, отделенных заданным разделителем
//
Функция РазложитьСтрокуФайлаВМассивПодстрок(Знач Стр, Разделитель = ";") Экспорт
	
	МассивСтрок = Новый Массив();
	
	ДлинаРазделителя = СтрДлина(Разделитель);
	
	Пока Не ПустаяСтрока(Стр) Цикл
		
		ПодстрокаДоРазделителя = ПолучитьПодстрокуДоРазделителяСУчетомКовычек(Стр, Разделитель);
		МассивСтрок.Добавить(ПолучитьСтрокуБезКовычек(ПодстрокаДоРазделителя));
		
		Если Стр = ПодстрокаДоРазделителя Тогда
			Возврат МассивСтрок;
		КонецЕсли;
		
		ПозицияРазделителя = СтрДлина(ПодстрокаДоРазделителя) + 1;
		Стр = Сред(Стр, ПозицияРазделителя + ДлинаРазделителя);
		
	КонецЦикла;
	
	МассивСтрок.Добавить(ПолучитьСтрокуБезКовычек(Стр));
		
	Возврат МассивСтрок;
	
КонецФункции

// Функция раскладывает артикул на 4 части
//
Функция РазобратьАртикулПоставщика(Знач Артикул) Экспорт
	МассивВозвращаемыхДанных = Новый Массив(4);
	
	// заполним массив первоначальными данными
	Для Сч = 0 по 3 Цикл
		МассивВозвращаемыхДанных[Сч] = 0;
	КонецЦикла;	
	
	Артикул = СокрЛП(Артикул);
	
	Для Сч = 0 по 3 Цикл
		ПозицияСлеша = Найти(Артикул, "/");
		Если ПозицияСлеша<>0 Тогда
			СтрокаДанных = Лев(Артикул, ПозицияСлеша-1);
			Артикул = Прав(Артикул, СтрДлина(Артикул)-ПозицияСлеша);
			Попытка
				МассивВозвращаемыхДанных[Сч] = Число(СтрокаДанных);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивВозвращаемыхДанных;
	
КонецФункции

#КонецОбласти

#Область Инициализация

МассивОбязательныхКолонокФайлаЗагрузки = Новый Соответствие;
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("DRUGID");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("PACKNX");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("MNFID");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("PCKNM");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("TRADENMR");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("DOSAGER");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("MNFNM");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("PACK");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("MAXMNFPRICE");
МассивОбязательныхКолонокФайлаЗагрузки.Вставить("EAN");


МассивКолонокФайлаВыгрузки = Новый Массив;
МассивКолонокФайлаВыгрузки.Добавить("DrugId");    // Число 		- Уникальный идентификатор ЛС в системе мониторинга цен
МассивКолонокФайлаВыгрузки.Добавить("VendorID");  // Число			- Код поставщика для системы мониторинга цен (из карточки контрагента поступления берется)
МассивКолонокФайлаВыгрузки.Добавить("Segment");   // Число 		- Сегмент (1 - амбулаторный, 2 - госпитальный). У нас всегда 1
МассивКолонокФайлаВыгрузки.Добавить("Year");      // Число(4,0)	- Год даты поступления
МассивКолонокФайлаВыгрузки.Добавить("Month");     // Число(1-12)	- Месяц даты поступления
МассивКолонокФайлаВыгрузки.Добавить("Series");    // Строка		- Серийный номер выгружаемой серии номенклатуры
МассивКолонокФайлаВыгрузки.Добавить("TotDrugQn"); // Число			- Количество закупленных упаковок номенклатуры в единице измерения прайс-листа
												  // 				  В нашем случае всегда базовое количество, потому как в прайсе хранится базовая единица измерения
МассивКолонокФайлаВыгрузки.Добавить("Funds");     // Число			- Средства на закупку (сумма поступления из документа с НДС). Для амбулаторного сегмента всегда 0.00. 
МассивКолонокФайлаВыгрузки.Добавить("MnfPrice");  // Число			- Цена производителя или импортера в рублях (в валюте регламентированного учета)
МассивКолонокФайлаВыгрузки.Добавить("PrcPrice");  // Число         - Закупочная цена одной упаковки с НДС в единицах измерения прайса в рублях. 
МассивКолонокФайлаВыгрузки.Добавить("RtlPrice");  // Число			- Розничная цена одной упаковки в единицах измерения прайса в рублях
МассивКолонокФайлаВыгрузки.Добавить("Remark");    // Строка        - Примечание
МассивКолонокФайлаВыгрузки.Добавить("SrcOrg");    // Число         - Идентификатор организации, предоставившей сведения о цене

#КонецОбласти

#КонецЕсли

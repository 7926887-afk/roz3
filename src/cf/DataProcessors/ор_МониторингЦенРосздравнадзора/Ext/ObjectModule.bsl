#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем МассивОбязательныхКолонокФайлаЗагрузки Экспорт; // Хранит массив с обязательными колонками файла загрузки
Перем МассивКолонокФайлаВыгрузки Экспорт; // Хранит массив с колонками файла выгрузки

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроцедурыИФункцииДляЗагрузкиДанных

// Функция получения пустой таблицы нужного формата
//
Функция ПолучитьПустуюТаблицуЗагрузки() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	
	Таблица.Колонки.Добавить("Пометка");
	// переберем обязательные колонки
	Для Каждого ОбязательнаяКолонка Из МассивОбязательныхКолонокФайлаЗагрузки Цикл
		Таблица.Колонки.Добавить(ОбязательнаяКолонка.Ключ);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Функция получения списка колонок, которые содержит загружаемый файл
//
Функция ПолучитьСписокКолонокФайла(Файл, Разделитель)
	
	МассивКолонок = Новый Массив();
	
	// заголовок у нас в первой строке
	ЗаголовокФайла = Файл.ПрочитатьСтроку();
	Если ЗаголовокФайла = Неопределено Тогда
		мСообщитьОбОшибке("Загружаемый файл не содержит данных.");
		Возврат МассивКолонок;
	КонецЕсли;
	
	// Разберем заголовок и посмотрим, что там за колонки в файле
	МассивКолонок = РазложитьСтрокуФайлаВМассивПодстрок(ЗаголовокФайла, Разделитель);
	
	Возврат МассивКолонок;
	
КонецФункции

// Функция проверки наличия в файле обязательных колонок для загрузки
//
Функция ПроверитьОбязательныеКолонкиДляЗагрузки(МассивКолонок)
	
	ОтсутствующиеКолонки = "";
	
	// заполним соответствие, чтобы имена колонок можно было без учета регистра искать
	КолонкиФайлаВРег = Новый Соответствие;
	Для Каждого Колонка Из МассивКолонок Цикл
		КолонкиФайлаВРег.Вставить(ВРег(Колонка), Колонка);
	КонецЦикла;
	
	ЗаполняемоеСоответствиеКолонок = Новый Соответствие;
	Для Каждого ИмяОбязательнойКолонки Из МассивОбязательныхКолонокФайлаЗагрузки Цикл
		
		ЗначениеСоответствия = КолонкиФайлаВРег.Получить(ИмяОбязательнойКолонки.Ключ);
		Если ЗначениеСоответствия = Неопределено И ИмяОбязательнойКолонки.Ключ<>"MNFID" Тогда
			ОтсутствующиеКолонки = ОтсутствующиеКолонки + ", " + ИмяОбязательнойКолонки.Ключ;
		Иначе
			ЗаполняемоеСоответствиеКолонок.Вставить(ИмяОбязательнойКолонки.Ключ, ЗначениеСоответствия);
		КонецЕсли;
		
	КонецЦикла;
	
	
	Если Не ПустаяСтрока(ОтсутствующиеКолонки) Тогда
		мСообщитьОбОшибке("Ошибка формата файла. Отсутствуют обязательные колонки: "+ОтсутствующиеКолонки);
		Возврат Ложь;
	Иначе
		МассивОбязательныхКолонокФайлаЗагрузки = ЗаполняемоеСоответствиеКолонок;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// Функция считывания файла и преобразования данных в таблицы
//
Функция ЗагрузитьДанныеМониторингаЦенВТаблицу(ИмяФайлаДляЗагрузки, ТаблицаЗагрузки, АдресХранилищаФайла) Экспорт
	ТаблицаЗагрузки = ПолучитьПустуюТаблицуЗагрузки().Скопировать();
	// проверим, указали вообще файл или нет
	Если ПустаяСтрока(ИмяФайлаДляЗагрузки) Тогда
		мСообщитьОбОшибке("Не указан файл для загрузки данных о мониторинге цен!");
		Возврат Ложь;
	КонецЕсли;
	
	Если ПустаяСтрока(АдресХранилищаФайла) Тогда
		мСообщитьОбОшибке("Файл не найден!");
		Возврат Ложь;
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилищаФайла);
	
	Если ДвоичныеДанные = Неопределено Тогда
		мСообщитьОбОшибке("Файл был удален!");
		Возврат Ложь;
	КонецЕсли;
	ВременныйКаталог = КаталогВременныхФайлов();
	ПутьКфайлу = ВременныйКаталог + "server.cvs";
	ДвоичныеДанные.Записать(ПутьКфайлу);
	
	// попытаемся прочитать файл
	Попытка
		НоменклатураПоставщика = Новый ЧтениеТекста(ПутьКфайлу);
	Исключение
		мСообщитьОбОшибке("Неизвестный формат файла!");
		Возврат Ложь;
	КонецПопытки;
	
	РазделительКолонок = ";";
	
	// Разберемся какие колонки есть в файле
	КолонкиВФайле = ПолучитьСписокКолонокФайла(НоменклатураПоставщика, РазделительКолонок);
	Если КолонкиВФайле.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим наличие обязательных колонок в файле
	Если НЕ ПроверитьОбязательныеКолонкиДляЗагрузки(КолонкиВФайле) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НомерСтроки = 0;
	СтрокаДанныхФайла = НоменклатураПоставщика.ПрочитатьСтроку();
	
	Пока СтрокаДанныхФайла<>Неопределено Цикл
		
		НомерСтроки = НомерСтроки + 1;
		// Состояние("Обрабатывается строка файла: "+НомерСтроки);
		МассивДанныхФайла = РазложитьСтрокуФайлаВМассивПодстрок(СтрокаДанныхФайла);
		
		// Добавляем строку в таблицу
		НоваяСтрокаТаблицы = ТаблицаЗагрузки.Добавить();
		НоваяСтрокаТаблицы.Пометка = Истина;
		
		Для Каждого ОбязательнаяКолонка Из МассивОбязательныхКолонокФайлаЗагрузки Цикл
			
			ИндексКолонкиВФайле = КолонкиВФайле.Найти(ОбязательнаяКолонка.Значение);
			Попытка
				НоваяСтрокаТаблицы[ОбязательнаяКолонка.Ключ] = МассивДанныхФайла[ИндексКолонкиВФайле];
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		СтрокаДанныхФайла = НоменклатураПоставщика.ПрочитатьСтроку();
		
	КонецЦикла;
	
	НоменклатураПоставщика.Закрыть();
	
	Возврат Истина;
	
КонецФункции

// Функция загрузки данных из таблицы в регистр
//
Функция ЗагрузитьДанные(Знач Таблица, ЗагружатьСНулевойЦеной = Ложь) Экспорт
	
	КоличествоЭлементов = Таблица.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество();
	
	ДатаЗагрузки = ТекущаяДатаСеанса();
	
	Для Каждого СтрокаТаблицы ИЗ Таблица Цикл
		
		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки = Таблица.Индекс(СтрокаТаблицы)+1;
		
		// С нулевой ценой не загружаем
		Если Не ЗагружатьСНулевойЦеной И (СтрокаТаблицы.MAXMNFPRICE = Неопределено ИЛИ СтрокаТаблицы.MAXMNFPRICE = 0) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			НаборЗаписейРегистра = РегистрыСведений.ор_ПрайсЛистыПоставщиков.СоздатьНаборЗаписей();
			НаборЗаписейРегистра.Отбор.ПрайсЛист.Установить(ПрайсЛист);
			АртикулТовараИзТаблицы = СокрЛП(Строка(СтрокаТаблицы.DRUGID))+"/"+СокрЛП(Строка(СтрокаТаблицы.PACKNX))+"/"+СокрЛП(Строка(СтрокаТаблицы.MNFNM))+"/"+СокрЛП(Строка(СтрокаТаблицы.PCKNM));
			ШКТовараИзТаблицы = СокрЛП(СтрокаТаблицы.EAN);
			НаборЗаписейРегистра.Отбор.ШтрихКод.Установить(ШКТовараИзТаблицы);
			НаборЗаписейРегистра.Отбор.Артикул.Установить(АртикулТовараИзТаблицы);
			НаборЗаписейРегистра.Прочитать();
			НаименованиеТовара = СокрЛП(СтрокаТаблицы.TRADENMR)+", "+СокрЛП(СтрокаТаблицы.DOSAGER)+", "+СокрЛП(СтрокаТаблицы.MNFNM)+", "+СокрЛП(СтрокаТаблицы.PACK);
			
			// такой записи нет, надо добавить
			Если НаборЗаписейРегистра.Количество()=0 Тогда
				НоваяЗапись = НаборЗаписейРегистра.Добавить();
				НоваяЗапись.ПрайсЛист      = ПрайсЛист;
				НоваяЗапись.ШтрихКод       = ШКТовараИзТаблицы;
				НоваяЗапись.Артикул        = АртикулТовараИзТаблицы;
				НоваяЗапись.Цена           = СтрокаТаблицы.MAXMNFPRICE;
				НоваяЗапись.Наименование   = НаименованиеТовара;
				НоваяЗапись.Контрагент     = Контрагент;
				НоваяЗапись.ДатаЗагрузки   = ДатаЗагрузки;
			Иначе
				// обновим существующие записи
				Для Каждого Запись ИЗ НаборЗаписейРегистра Цикл
					Запись.Цена           = СтрокаТаблицы.MAXMNFPRICE;
					Запись.Наименование   = НаименованиеТовара;
					Запись.Контрагент     = Контрагент;
					Запись.ДатаЗагрузки   = ДатаЗагрузки;
				КонецЦикла;
			КонецЕсли;
			
			НаборЗаписейРегистра.Записать();
			
		Исключение
			
			ОписаниеОшибки = ОписаниеОшибки();
			мСообщитьОбОшибке("В процессе загрузки данных возникли ошибки: "+Символы.ПС+ОписаниеОшибки);
			Возврат Ложь;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииДлячСопоставленияДанных

// Функция заполнения таблицы для сопоставления данных
//
Функция ЗаполнитьТаблицуСопоставления() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПрайсЛистыКонтрагентов.Номенклатура КАК Номенклатура,
	|	ПрайсЛистыКонтрагентов.Артикул КАК АртикулПоставщика,
	|	ПрайсЛистыКонтрагентов.Единица КАК ЕдиницаИзмерения,
	|	ПрайсЛистыКонтрагентов.ШтрихКод КАК Штрихкод,
	|	ПрайсЛистыКонтрагентов.Наименование КАК НоменклатураПоставщика,
	|	ЛОЖЬ КАК Пометка,
	|	ПрайсЛистыКонтрагентов.Номенклатура.ор_КодРосздравнадзора КАК КодРосздравнадзора,
	|	ПрайсЛистыКонтрагентов.Номенклатура.ор_Производитель КАК Производитель,
	|	ПрайсЛистыКонтрагентов.ПрайсЛист КАК ПрайсЛист,
	|	ЛОЖЬ КАК ПодсветитьНеУникальные
	|ИЗ
	|	РегистрСведений.ор_ПрайсЛистыПоставщиков КАК ПрайсЛистыКонтрагентов
	|ГДЕ
	|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист";
	
	Запрос.УстановитьПараметр("ПрайсЛист", ПрайсЛист);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	// добавим недостающие колонки
	Таблица.Колонки.Добавить("УникальныйИД",    Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ИДЛС",            Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ИДПроизводителя", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ИДУпаковщика",    Новый ОписаниеТипов("Число"));
	
	// Для каждой строки разберем артикул на нужные составляющие
	НомерСтроки = 0;
	КоличествоСтрок = Таблица.Количество();
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НомерСтроки = НомерСтроки + 1;

		// обновим индикатор, если он есть
		МассивДанных = РазобратьАртикулПоставщика(СтрокаТаблицы.АртикулПоставщика);
		СтрокаТаблицы.УникальныйИД 		= МассивДанных[0];
		СтрокаТаблицы.ИДЛС 				= МассивДанных[1];
		СтрокаТаблицы.ИДПроизводителя 	= МассивДанных[2];
		СтрокаТаблицы.ИДУпаковщика 		= МассивДанных[3];
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Процедура автоматического сопоставления данных
// Сопоставляет данные с уже в базе штрих-кодами и РДЛС.
// Так же производится проверка на не уникальные записи.
//
// Параметры:
//  Таблица				 - ТаблицаЗначений	 - Таблица сопоставлений.
//  НайденыНеУникальные	 - Булевое	 - Значение будет заменено на истину 
//                                     при обнаружении не уникальных строк.
//  ИндексыДублей -  Массив - Если передан массив, в него будут добавлены
//                            структуры хранящие индексы и номенклатуру дублей.
//                            Структура имеет поля:
//                                Номенклатура - Дублирующаяся номенклатура;
//                                Индексы - Массив индексов для дублирующейся номенклатуры.
//
Процедура ВыполнитьСопоставлениеДанных(Таблица, НайденыНеУникальные, ИндексыДублей) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица.Пометка КАК Пометка,
	|	Таблица.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	Таблица.ШтрихКод КАК ШтрихКод,
	|	Таблица.АртикулПоставщика КАК АртикулПоставщика,
	|	Таблица.ИДЛС КАК ИДЛС,
	|	Таблица.ПодсветитьНеУникальные КАК ПодсветитьНеУникальные
	|ПОМЕСТИТЬ Номенклатуры
	|ИЗ
	|	&Таблица КАК Таблица
	|ГДЕ
	|	Таблица.Пометка = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатуры.ШтрихКод КАК ШтрихКод,
	|	СУММА(1) КАК КоличествоШК
	|ПОМЕСТИТЬ КоличествоНеУникальныхШК
	|ИЗ
	|	Номенклатуры КАК Номенклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	Номенклатуры.ШтрихКод
	|
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатуры.ИДЛС КАК ИДЛС,
	|	СУММА(1) КАК КоличествоИДЛС
	|ПОМЕСТИТЬ КоличествоНеУникальныхИДРЛС
	|ИЗ
	|	Номенклатуры КАК Номенклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	Номенклатуры.ИДЛС
	|
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатуры.Пометка КАК Пометка,
	|	Номенклатуры.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	Номенклатуры.ШтрихКод КАК ШтрихКод,
	|	Номенклатуры.АртикулПоставщика КАК АртикулПоставщика,
	|	Номенклатуры.ИДЛС КАК ИДЛС,
	|	ВЫБОР
	|		КОГДА КоличествоНеУникальныхШК.ШтрихКод ЕСТЬ NULL
	|				И КоличествоНеУникальныхИДРЛС.ИДЛС ЕСТЬ NULL
	|			ТОГДА Номенклатуры.ПодсветитьНеУникальные
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ПодсветитьНеУникальные
	|ПОМЕСТИТЬ НоменклатурыСПроверкойУникальности
	|ИЗ
	|	Номенклатуры КАК Номенклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоНеУникальныхШК КАК КоличествоНеУникальныхШК
	|		ПО Номенклатуры.ШтрихКод = КоличествоНеУникальныхШК.ШтрихКод
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоНеУникальныхИДРЛС КАК КоличествоНеУникальныхИДРЛС
	|		ПО Номенклатуры.ИДЛС = КоличествоНеУникальныхИДРЛС.ИДЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатуры.Пометка КАК Пометка,
	|	Номенклатуры.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	Номенклатуры.ШтрихКод КАК ШтрихКод,
	|	Номенклатуры.АртикулПоставщика КАК АртикулПоставщика,
	|	Номенклатуры.ИДЛС КАК ИДЛС,
	|	МАКСИМУМ(ЕСТЬNULL(ШтрихКоды.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))) КАК НоменклатураПоШК,
	|	Номенклатуры.ПодсветитьНеУникальные КАК ПодсветитьНеУникальные
	|ПОМЕСТИТЬ НоменклатурыПоШК
	|ИЗ
	|	НоменклатурыСПроверкойУникальности КАК Номенклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихКоды
	|		ПО Номенклатуры.ШтрихКод = ШтрихКоды.Штрихкод
	|
	|СГРУППИРОВАТЬ ПО
	|	Номенклатуры.Пометка,
	|	Номенклатуры.НоменклатураПоставщика,
	|	Номенклатуры.ШтрихКод,
	|	Номенклатуры.АртикулПоставщика,
	|	Номенклатуры.ИДЛС,
	|	Номенклатуры.ПодсветитьНеУникальные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатурыПоШК.Пометка КАК Пометка,
	|	НоменклатурыПоШК.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	НоменклатурыПоШК.ШтрихКод КАК ШтрихКод,
	|	НоменклатурыПоШК.АртикулПоставщика КАК АртикулПоставщика,
	|	НоменклатурыПоШК.ИДЛС КАК ИДЛС,
	|	НоменклатурыПоШК.НоменклатураПоШК КАК НоменклатураПоШК,
	|	МАКСИМУМ(ЕСТЬNULL(Номенклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))) КАК НоменклатураПоАртикулу,
	|	НоменклатурыПоШК.ПодсветитьНеУникальные КАК ПодсветитьНеУникальные
	|ПОМЕСТИТЬ ТаблицаВозможноСПустойНоменклатурой
	|ИЗ
	|	НоменклатурыПоШК КАК НоменклатурыПоШК
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО НоменклатурыПоШК.ИДЛС = Номенклатура.ор_КодРосздравнадзора
	|
	|СГРУППИРОВАТЬ ПО
	|	НоменклатурыПоШК.Пометка,
	|	НоменклатурыПоШК.НоменклатураПоставщика,
	|	НоменклатурыПоШК.ШтрихКод,
	|	НоменклатурыПоШК.АртикулПоставщика,
	|	НоменклатурыПоШК.ИДЛС,
	|	НоменклатурыПоШК.НоменклатураПоШК,
	|	НоменклатурыПоШК.ПодсветитьНеУникальные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаВозможноСПустойНоменклатурой.Пометка КАК Пометка,
	|	ТаблицаВозможноСПустойНоменклатурой.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	ТаблицаВозможноСПустойНоменклатурой.ШтрихКод КАК ШтрихКод,
	|	ТаблицаВозможноСПустойНоменклатурой.АртикулПоставщика КАК АртикулПоставщика,
	|	ТаблицаВозможноСПустойНоменклатурой.ИДЛС КАК ИДЛС,
	|	ТаблицаВозможноСПустойНоменклатурой.НоменклатураПоШК КАК НоменклатураПоШК,
	|	ТаблицаВозможноСПустойНоменклатурой.НоменклатураПоАртикулу КАК НоменклатураПоАртикулу,
	|	ТаблицаВозможноСПустойНоменклатурой.ПодсветитьНеУникальные КАК ПодсветитьНеУникальные
	|ИЗ
	|	ТаблицаВозможноСПустойНоменклатурой КАК ТаблицаВозможноСПустойНоменклатурой
	|ГДЕ
	|	НЕ(ТаблицаВозможноСПустойНоменклатурой.НоменклатураПоШК = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И ТаблицаВозможноСПустойНоменклатурой.НоменклатураПоАртикулу = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))";

	Запрос.УстановитьПараметр("Таблица", Таблица);
	НоменклатурыПодбора = Запрос.Выполнить().Выгрузить();
	
	// Перенесем данные в нашу таблицу.
	Для Каждого СтрокаНоменклатур Из НоменклатурыПодбора Цикл
		
		
		
		СтруктураОтбора = Новый Структура("Пометка, НоменклатураПоставщика, ШтрихКод, АртикулПоставщика", Истина, СтрокаНоменклатур.НоменклатураПоставщика, СтрокаНоменклатур.ШтрихКод, СтрокаНоменклатур.АртикулПоставщика);
		МассивНайденныхСтрок = Таблица.НайтиСтроки(СтруктураОтбора);
		ПодставляемаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
		ПодставляемаяЕдиница = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		
		Если ЗначениеЗаполнено(СтрокаНоменклатур.НоменклатураПоШК) Тогда
			ПодставляемаяНоменклатура = СтрокаНоменклатур.НоменклатураПоШК;
		Иначе
			ПодставляемаяНоменклатура = СтрокаНоменклатур.НоменклатураПоАртикулу;
		КонецЕсли;
		
		ПодставляемаяЕдиница = ПодставляемаяНоменклатура.ЕдиницаИзмерения;
		
		ДанныеТекущихДублей = Неопределено;
		Для Каждого СтрокаМассива Из МассивНайденныхСтрок Цикл
			
			СтрокаМассива.Номенклатура            = ПодставляемаяНоменклатура;
			СтрокаМассива.ЕдиницаИзмерения        = ПодставляемаяЕдиница;
			СтрокаМассива.КодРосздравнадзора      = ПодставляемаяНоменклатура.ор_КодРосздравнадзора;
			СтрокаМассива.Производитель           = ПодставляемаяНоменклатура.ор_Производитель;
			СтрокаМассива.ПодсветитьНеУникальные  = СтрокаНоменклатур.ПодсветитьНеУникальные;
			
			Если СтрокаНоменклатур.ПодсветитьНеУникальные Тогда
				Если ДанныеТекущихДублей = Неопределено Тогда
					ДанныеТекущихДублей = Новый Структура("Номенклатура, Индексы", ПодставляемаяНоменклатура, Новый Массив);
				КонецЕсли;

				ИндексСтроки = Таблица.Индекс(СтрокаМассива);
				ДанныеТекущихДублей.Индексы.Добавить(ИндексСтроки);
			КонецЕсли;			
		КонецЦикла;
		
		Если ДанныеТекущихДублей <> Неопределено Тогда
			НайденыНеУникальные = Истина;
		    ИндексыДублей.Добавить(ДанныеТекущихДублей);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция проверки корректности сопоставления данных
// Сопоставление происходит с учётом данных записанных в регистре прайс-листов.
// При отсутствии дублирующих значений номенклатуры, изменённые данные вносятся в регистр прайс-листов.
//
// Параметры:
//  Таблица		 - 	ТаблицаЗначений - Таблица сопоставлений
//  ИндексыДублей -  Массив - Если передан массив, в него будут добавлены
//                            структуры хранящие индексы и номенклатуру дублей.
//                            Структура имеет поля:
//                                Номенклатура - Дублирующаяся номенклатура;
//                                Индексы - Массив индексов для дублирующейся номенклатуры.
// 
// Возвращаемое значение:
//  Булево       -  Успех записи
Функция ЗаписатьСопоставления(Таблица, ИндексыДублей=Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица.Пометка КАК Пометка,
	|	Таблица.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	Таблица.ШтрихКод КАК ШтрихКод,
	|	Таблица.АртикулПоставщика КАК АртикулПоставщика,
	|	Таблица.Номенклатура КАК НоменклатураТаблицы,
	|	Таблица.ЕдиницаИзмерения КАК ЕдиницаТаблицы,
	|	1 КАК СтрокаТаблицы
	|ПОМЕСТИТЬ ТаблицаСопоставления
	|ИЗ
	|	&Таблица КАК Таблица
	|ГДЕ
	|	Таблица.Пометка = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрайсЛистыКонтрагентов.Номенклатура КАК Номенклатура,
	|	ПрайсЛистыКонтрагентов.Артикул КАК Артикул,
	|	ПрайсЛистыКонтрагентов.ШтрихКод КАК ШтрихКод,
	|	ПрайсЛистыКонтрагентов.Наименование КАК Наименование
	|ПОМЕСТИТЬ ПрайсЛист
	|ИЗ
	|	РегистрСведений.ор_ПрайсЛистыПоставщиков КАК ПрайсЛистыКонтрагентов
	|ГДЕ
	|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСопоставления.НоменклатураТаблицы КАК НоменклатураТаблицы,
	|	ТаблицаСопоставления.ЕдиницаТаблицы КАК ЕдиницаТаблицы,
	|	ПрайсЛист.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТаблицаСопоставления.СтрокаТаблицы, 0) КАК СтрокаТаблицы,
	|	ПрайсЛист.Артикул КАК Артикул,
	|	ПрайсЛист.ШтрихКод КАК ШтрихКод,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТаблицаСопоставления.СтрокаТаблицы, 0) = 1
	|			ТОГДА ТаблицаСопоставления.НоменклатураТаблицы
	|		ИНАЧЕ ПрайсЛист.Номенклатура
	|	КОНЕЦ КАК ИтоговаяНоменклатура,
	|	ПрайсЛист.Наименование КАК Наименование
	|ПОМЕСТИТЬ ТаблицаСоВсемиДанными
	|ИЗ
	|	ПрайсЛист КАК ПрайсЛист
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСопоставления КАК ТаблицаСопоставления
	|		ПО ПрайсЛист.Артикул = ТаблицаСопоставления.АртикулПоставщика
	|			И ПрайсЛист.ШтрихКод = ТаблицаСопоставления.ШтрихКод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСоВсемиДанными.ИтоговаяНоменклатура КАК Номенклатура,
	|	ТаблицаСоВсемиДанными.СтрокаТаблицы КАК СтрокаТаблицы,
	|	ТаблицаСоВсемиДанными.ШтрихКод КАК ШтрихКод,
	|	ТаблицаСоВсемиДанными.Артикул КАК Артикул,
	|	1 КАК КоличествоНоменклатуры
	|ИЗ
	|	ТаблицаСоВсемиДанными КАК ТаблицаСоВсемиДанными
	|ГДЕ
	|	ТаблицаСоВсемиДанными.ИтоговаяНоменклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСоВсемиДанными.ИтоговаяНоменклатура,
	|	ТаблицаСоВсемиДанными.СтрокаТаблицы,
	|	ТаблицаСоВсемиДанными.ШтрихКод,
	|	ТаблицаСоВсемиДанными.Артикул
	|ИТОГИ
	|	СУММА(КоличествоНоменклатуры)
	|ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСоВсемиДанными.ИтоговаяНоменклатура КАК Номенклатура,
	|	ТаблицаСоВсемиДанными.ШтрихКод КАК ШтрихКод,
	|	ТаблицаСоВсемиДанными.Артикул КАК Артикул,
	|	ЕСТЬNULL(ТаблицаСоВсемиДанными.ЕдиницаТаблицы, ТаблицаСоВсемиДанными.ИтоговаяНоменклатура.ЕдиницаИзмерения) КАК Единица,
	|	ТаблицаСоВсемиДанными.Наименование КАК Наименование,
	|	&ПрайсЛист КАК ПрайсЛист,
	|	&Контрагент КАК Контрагент
	|ИЗ
	|	ТаблицаСоВсемиДанными КАК ТаблицаСоВсемиДанными
	|ГДЕ
	|	ТаблицаСоВсемиДанными.СтрокаТаблицы <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаСопоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПрайсЛист
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаСоВсемиДанными";
				   
	Запрос.УстановитьПараметр("ПрайсЛист", ПрайсЛист);	
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаПерезаписываемыхДанных = РезультатыЗапроса[4].Выгрузить();
	
	ПовторяющиесяНоменклатуры = РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);		
	
	ИмеютсяДубли = Ложь;
	
	Пока ПовторяющиесяНоменклатуры.Следующий() Цикл
		
		Если ПовторяющиесяНоменклатуры.КоличествоНоменклатуры = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ИндексыДублей) <> Тип("Массив") Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Выборка = ПовторяющиесяНоменклатуры.Выбрать();
		
		ДанныеДублей = Новый Структура("Номенклатура, Индексы",
											ПовторяющиесяНоменклатуры.Номенклатура, Новый Массив());
		Пока Выборка.Следующий() Цикл
			ПараметрыОтбора = Новый Структура("Номенклатура, АртикулПоставщика, ШтрихКод",
									Выборка.Номенклатура, Выборка.Артикул, Выборка.ШтрихКод); 
			СтрокиНоменклатуры = Таблица.НайтиСтроки(ПараметрыОтбора);
										
			Для Каждого Строка Из СтрокиНоменклатуры Цикл
				ИндексСтроки = Таблица.Индекс(Строка);
				ДанныеДублей.Индексы.Добавить(ИндексСтроки);	
			КонецЦикла;
							
		КонецЦикла;
					
		ИндексыДублей.Добавить(ДанныеДублей);
		
		ИмеютсяДубли = Истина;
	КонецЦикла;
		
	Если ИмеютсяДубли Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// перезапишем только строки, отмеченные в таблице
	Для Каждого СтрокаПерезаписываемых Из ТаблицаПерезаписываемыхДанных Цикл
		
		НаборЗаписейРегистра = РегистрыСведений.ор_ПрайсЛистыПоставщиков.СоздатьНаборЗаписей();
		НаборЗаписейРегистра.Отбор.ПрайсЛист.Установить(ПрайсЛист);
		НаборЗаписейРегистра.Отбор.Штрихкод.Установить(СтрокаПерезаписываемых.ШтрихКод);
		НаборЗаписейРегистра.Отбор.Артикул.Установить(СтрокаПерезаписываемых.Артикул);
		НаборЗаписейРегистра.Прочитать();
		
		Если НаборЗаписейРегистра.Количество()<>0 Тогда
		    НаборЗаписейРегистра[0].Номенклатура = СтрокаПерезаписываемых.Номенклатура;
		    НаборЗаписейРегистра[0].Единица = СтрокаПерезаписываемых.Единица;
			НаборЗаписейРегистра.Записать();
			Попытка
				Если Не СтрокаПерезаписываемых.Номенклатура.ор_ЗарегистрированВСистемеМониторингаЦен Тогда
					НоменклатураОбъект = СтрокаПерезаписываемых.Номенклатура.ПолучитьОбъект();
				 	НоменклатураОбъект.ор_ЗарегистрированВСистемеМониторингаЦен = Истина;
					НоменклатураОбъект.Записать();
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;

	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииДляВыгрузкиДанных

// Процедура заполнения таблицы выгрузки по остаткам
//
Процедура ЗаполнитьТаблицуВыгрузкиПоОстаткам(Таблица, Знач КонецПериода, Знач СписокСтруктурныхЕдиниц) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	СписокСтруктурныхЕдиниц.Значение КАК СтруктурнаяЕдиница
	|ПОМЕСТИТЬ втСтруктурныеЕдиницы
	|ИЗ
	|	&СписокСтруктурныхЕдиниц КАК СписокСтруктурныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыМинимальныхЦенСтруктурныхЕдиниц.ВидМинимальныхЦен КАК ВидМинимальныхЦен,
	|	втСтруктурныеЕдиницы.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
	|ПОМЕСТИТЬ ВидыМинимальныхЦенСкладов
	|ИЗ
	|	РегистрСведений.ВидыМинимальныхЦенСтруктурныхЕдиниц КАК ВидыМинимальныхЦенСтруктурныхЕдиниц
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСтруктурныеЕдиницы КАК втСтруктурныеЕдиницы
	|		ПО ВидыМинимальныхЦенСтруктурныхЕдиниц.СтруктурнаяЕдиница = втСтруктурныеЕдиницы.СтруктурнаяЕдиница
	|ГДЕ

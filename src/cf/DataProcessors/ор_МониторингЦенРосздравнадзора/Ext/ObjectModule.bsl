	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СгруппированныеДляВычисления.Номенклатура КАК Номенклатура,
	|	СгруппированныеДляВычисления.Характеристика КАК Характеристика
	|ИЗ
	|	СгруппированныеДляВычисления КАК СгруппированныеДляВычисления
	|ГДЕ
	|	ВЫБОР
	|			КОГДА СгруппированныеДляВычисления.КоличествоОстаток - СгруппированныеДляВычисления.Количество > 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СписокСтруктурныхЕдиниц",     СписокСтруктурныхЕдиниц);
	Запрос.УстановитьПараметр("ПрайсЛист",                   ПрайсЛист);
	Запрос.УстановитьПараметр("МинимальныеЦеныИспользуются", ЦенообразованиеСерверПовтИсп.МинимальныеЦеныИспользуются());
	
	ОсновнойВидЦенПродажи = ПерсональныеНастройкиРУНФ.Прочитать("ОсновнойВидЦенПродажи");
	Запрос.УстановитьПараметр("ОсновнойВидЦенПродажи", ОсновнойВидЦенПродажи);
	
	// Установим конец периода, если он не заполнен в шапке.
	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода =  ТекущаяДатаСеанса();
	КонецЕсли;
	
	// Будем рассматривать следующие периоды по поступлениям: пол года(-6), год(-12), два(-24), четыре(-48), восемь(-96).
	// Установим начальное уменьшение периода, за который будем рассматривать поступления, равный - пол года (-6 месяцев).
	ШагПериода = -6;
	
	НачалоПериода =  ДобавитьМесяц(КонецПериода, ШагПериода);
	
	// Т.к. лекарственные средства хранятся максимум 7 лет, 
	// установим максимальный период рассмотрения товаров по поступлениям равный 8 лет.
	НачалоПериодаМаксимальное = ДобавитьМесяц(КонецПериода, - 96);
	
	КонецПериода = КонецДня(КонецПериода);
	
	Запрос.УстановитьПараметр("Дата",          КонецПериода); // Для розничного запроса цен.
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	// Контроль первого шага.
	ПервыйШаг = Истина;
	
	// Переменная контролирующая выполнение перерасчёта.
	ВыполнитьПерерасчет = Истина;
	Пока ВыполнитьПерерасчет Цикл
		
		Результат = Запрос.ВыполнитьПакет();
		
		// Индекс изменяется из-за варьируемого количества подзапросов в розничном запросе цен.
		МаксимальныйИндексПакета = Результат.Количество() - 1;
		
		// Если не нашли необходимых поступлений за 8 лет, остановим поиск.
		Если НачалоПериодаМаксимальное = НачалоПериода Тогда
			Прервать;
		КонецЕсли;
		
		Если Результат[МаксимальныйИндексПакета].Пустой() Тогда
			// Если все необходимые поступления найдены, тогда прерываем цикл.
			Прервать;
		Иначе
			// Если поступления не найдены, увеличим период и выполним перерасчёт.
			Если ПервыйШаг Тогда
				// На первом шаге дополнительного увеличеия шага периода не надо,
				// т.к. увеличить нужно всего на пол года, а это и есть начальный шаг.
				ПервыйШаг = Ложь;
			Иначе
				ШагПериода = ШагПериода + ШагПериода;
			КонецЕсли;
			
			НачалоПериода = ДобавитьМесяц(НачалоПериода,ШагПериода);
			Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат[МаксимальныйИндексПакета-2].Пустой() Тогда
		Возврат;
	КонецЕсли;
		
	ВыборкаСтруктурнаяЕдиница = Результат[МаксимальныйИндексПакета-2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "СтруктурнаяЕдиница");
	Пока ВыборкаСтруктурнаяЕдиница.Следующий() Цикл
		
		ВыборкаНоменклатура = ВыборкаСтруктурнаяЕдиница.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Номенклатура");
		Пока ВыборкаНоменклатура.Следующий() Цикл
		
			ВыборкаХарактеристика = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Характеристика");
			Пока ВыборкаХарактеристика.Следующий() Цикл
					
				// Общее количество к списанию по характеристике.
				КоличествоСписатьПоХарактеристике = ВыборкаХарактеристика.КоличествоОстаток;
				
				ВыборкаДетальныеЗаписи = ВыборкаХарактеристика.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					Если КоличествоСписатьПоХарактеристике > 0 И ВыборкаДетальныеЗаписи.Количество > 0 Тогда
						НоваяСтрокаТаблицы = Таблица.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, ВыборкаДетальныеЗаписи);
						НоваяСтрокаТаблицы.Количество = ?(КоличествоСписатьПоХарактеристике - ВыборкаДетальныеЗаписи.Количество >= 0,
															ВыборкаДетальныеЗаписи.Количество,КоличествоСписатьПоХарактеристике);
						КоличествоСписатьПоХарактеристике = КоличествоСписатьПоХарактеристике - ВыборкаДетальныеЗаписи.Количество;
					КонецЕсли;
					
				КонецЦикла;
				
				// Если в итоге не смогли всё списать добавляем оставшееся в ТЧ.
				Если КоличествоСписатьПоХарактеристике > 0 Тогда
					НоваяСтрокаТаблицы = Таблица.Добавить();
					НоваяСтрокаТаблицы.Номенклатура    = ВыборкаХарактеристика.Номенклатура;
					НоваяСтрокаТаблицы.Характеристика  = ВыборкаХарактеристика.Характеристика;
					НоваяСтрокаТаблицы.ЦенаРозничная   = ВыборкаХарактеристика.ЦенаРозничная;
					НоваяСтрокаТаблицы.Количество      = КоличествоСписатьПоХарактеристике;
				КонецЕсли;
			
			КонецЦикла
		
		КонецЦикла;
	
	КонецЦикла;
	
	Если Таблица.Количество() > 0 Тогда
		// Дополнительно отсортируем таблицу, делаем это не в изначальном запросе, 
		// так как изначальный запрос может запускаться 5 раз, а здесь он выполниться один.
		ЗапросНаОстатки  = Новый Запрос;
		ЗапросНаОстатки.Текст = "ВЫБРАТЬ
		|	ВременнаяТаблицаДляСортировки.Номенклатура КАК Номенклатура,
		|	ВременнаяТаблицаДляСортировки.Характеристика КАК Характеристика,
		|	ВременнаяТаблицаДляСортировки.Количество КАК Количество,
		|	ВременнаяТаблицаДляСортировки.ЦенаПроизводителя КАК ЦенаПроизводителя,
		|	ВременнаяТаблицаДляСортировки.ЦенаЗакупочная КАК ЦенаЗакупочная,
		|	ВременнаяТаблицаДляСортировки.ЦенаРозничная КАК ЦенаРозничная,
		|	ВременнаяТаблицаДляСортировки.ДокументПоступления КАК ДокументПоступления,
		|	ВременнаяТаблицаДляСортировки.Поставщик КАК Поставщик
		|ПОМЕСТИТЬ ВременнаяТаблицаДляСортировки
		|ИЗ
		|	&ТаблицаДляСортировки КАК ВременнаяТаблицаДляСортировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблицаДляСортировки.Номенклатура КАК Номенклатура,
		|	ВременнаяТаблицаДляСортировки.Характеристика КАК Характеристика,
		|	ВременнаяТаблицаДляСортировки.Количество КАК Количество,
		|	ВременнаяТаблицаДляСортировки.ЦенаПроизводителя КАК ЦенаПроизводителя,
		|	ВременнаяТаблицаДляСортировки.ЦенаЗакупочная КАК ЦенаЗакупочная,
		|	ВременнаяТаблицаДляСортировки.ЦенаРозничная КАК ЦенаРозничная,
		|	ВременнаяТаблицаДляСортировки.ДокументПоступления КАК ДокументПоступления,
		|	ВременнаяТаблицаДляСортировки.Поставщик КАК Поставщик
		|ИЗ
		|	ВременнаяТаблицаДляСортировки КАК ВременнаяТаблицаДляСортировки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВременнаяТаблицаДляСортировки.Номенклатура.Наименование,
		|	ВременнаяТаблицаДляСортировки.Характеристика.Наименование,
		|	ВременнаяТаблицаДляСортировки.ДокументПоступления.Дата УБЫВ";
		
		ЗапросНаОстатки.УстановитьПараметр("ТаблицаДляСортировки", Таблица);
		Таблица = ЗапросНаОстатки.Выполнить().Выгрузить();
	КонецЕсли;
	
КонецПроцедуры

// Функция выгрузки данных в файл

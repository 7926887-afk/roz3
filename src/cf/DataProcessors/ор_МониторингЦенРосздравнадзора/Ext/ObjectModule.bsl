Функция ВыгрузитьДанные(Таблица, ДатаВыгрузки) Экспорт
	
	// Установим дату, если пользователь не указал её.
	Если Не ЗначениеЗаполнено(ДатаВыгрузки) Тогда
		ДатаВыгрузки =  ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Количество КАК Количество,
	|	Таблица.ЦенаПроизводителя КАК ЦенаПроизводителя,
	|	Таблица.ЦенаЗакупочная КАК ЦенаЗакупочная,
	|	Таблица.ЦенаРозничная КАК ЦенаРозничная,
	|	Таблица.Поставщик КАК Поставщик,
	|	Таблица.ДокументПоступления КАК ДокументПоступления
	|ПОМЕСТИТЬ Номенклатуры
	|ИЗ
	|	&Таблица КАК Таблица
	|;

КонецПроцедуры

#КонецОбласти

#Область КомандыПереходаПоСтраницам

&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	ОчиститьСообщения();
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ЗагрузкаДанныхИзФайла Тогда
		
		Если ПустаяСтрока(АдресХранилищаФайла) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не указан файл для загрузки!'"));
			Возврат;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура();
		ПараметрыОтбора.Вставить("Выбран", Истина);
		
		ЛистыКЗагрузке = ВыбранныеЛисты.НайтиСтроки(ПараметрыОтбора);
		
		Если ЛистыКЗагрузке.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбраны страницы для загрузки!'"));
			Возврат;
		КонецЕсли;
		
		ЗагрузитьДанныеИзФайлаВФоне();
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СопоставлениеДанных Тогда
		
		Если ПроверитьВыбранные() Тогда
			ЗагрузитьДанные();
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СопоставлениеДанных Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.ЗагрузкаДанныхИзФайла;
		Элементы.Назад.Видимость = Ложь;
		Элементы.Далее.Заголовок = НСтр("ru='Далее'");
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр("ru='Загрузка из файла'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


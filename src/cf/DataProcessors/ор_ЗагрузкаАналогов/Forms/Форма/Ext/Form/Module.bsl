
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ОтборВсе.Пометка = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФайлДанныхНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр 	= "Файл данных (*.xls, *.xlsx)|*.xls;*.xlsx";
	ПараметрыДиалога.Заголовок 	= НСтр("ru='Выберите файл!'");
	
	ОписаниеЗавершения = Новый ОписаниеОповещения("ЗавершениеПомещениеФайла", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(ОписаниеЗавершения,,,, ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоДляОтображения

&НаКлиенте
Процедура ДеревоДляОтображенияПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоДляОтображения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаложитьОтборНаСопоставленныеПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.КлючСвязи);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДляОтображенияВыбранПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоДляОтображения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоВерхнийУровень Тогда
		Для Каждого СтрокаДерева Из ТекущиеДанные.ПолучитьЭлементы() Цикл
			СтрокаДерева.Выбран = ТекущиеДанные.Выбран;
			ЗаполнитьПометкуВАналогах(СтрокаДерева.Номенклатура, СтрокаДерева.Выбран);
			ЗаполнитьПометкуВТаблицеЗагрузки(СтрокаДерева.КлючСвязи, СтрокаДерева.Выбран);
		КонецЦикла;
	Иначе
		ЗаполнитьПометкуВАналогах(ТекущиеДанные.Номенклатура, ТекущиеДанные.Выбран);
		ЗаполнитьПометкуВТаблицеЗагрузки(ТекущиеДанные.КлючСвязи, ТекущиеДанные.Выбран);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДляОтображенияНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоДляОтображения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МНН = ТекущиеДанные.ПолучитьРодителя().МНН;
	
	ДеревоДляОтображенияНоменклатураПриИзмененииНаСервере(
		ТекущиеДанные.КлючСвязи,
		МНН,
		ТекущиеДанные.Номенклатура);
	
	НаложитьОтборНаСопоставленныеПозиции(ТекущиеДанные.Номенклатура, ТекущиеДанные.КлючСвязи);
	ОбновитьКоличественнуюИнформациюВОтборах();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДляОтображенияПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	УдалитьСтрокуДерева();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСопоставленныеАналоги

&НаКлиенте
Процедура СопоставленныеАналогиКоэффициентПриИзменении(Элемент)
	
	ОбновитьДанныеВОбратнойЗаписиАналога(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставленныеАналогиИдентичныПриИзменении(Элемент)
	
	ОбновитьДанныеВОбратнойЗаписиАналога(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставленныеАналогиПриоритетПриИзменении(Элемент)
	
	ОбновитьДанныеВОбратнойЗаписиАналога(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставленныеАналогиКомментарийПриИзменении(Элемент)
	
	ОбновитьДанныеВОбратнойЗаписиАналога(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеВОбратнойЗаписиАналога(Элемент)
	
	ТекущиеДанные = Элементы.СопоставленныеАналоги.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Аналог", 		 ТекущиеДанные.Номенклатура);
	СтруктураПоиска.Вставить("Номенклатура", ТекущиеДанные.Аналог);
	
	ОбратнаяЗапись = СопоставленныеАналоги.НайтиСтроки(СтруктураПоиска);
	Если ОбратнаяЗапись.Количество() > 0 Тогда
		
		Если ТекущиеДанные.Идентичны Тогда
			
			// Если установлен флаг идентичны и меняется коээфициент, обновим его в обратной записи.
			Если Элемент.Имя = "СопоставленныеАналогиКоэффициент" Тогда
				ОбратнаяЗапись[0].ор_Коэффициент = ТекущиеДанные.ор_Коэффициент;
			КонецЕсли;
			
			Если Элемент.Имя = "СопоставленныеАналогиПриоритет" Тогда
				ОбратнаяЗапись[0].Приоритет = ТекущиеДанные.Приоритет;
			КонецЕсли;
			
			Если Элемент.Имя = "СопоставленныеАналогиИдентичны" Тогда
				ОбратнаяЗапись[0].Идентичны 		= Истина;
				ОбратнаяЗапись[0].ор_Коэффициент 	= ТекущиеДанные.ор_Коэффициент;
				ОбратнаяЗапись[0].Приоритет 		= ТекущиеДанные.Приоритет;
				ОбратнаяЗапись[0].Комментарий 		= ТекущиеДанные.Комментарий;
			КонецЕсли;
			
			Если Элемент.Имя = "СопоставленныеАналогиКомментарий" Тогда
				ОбратнаяЗапись[0].Комментарий = ТекущиеДанные.Комментарий;
			КонецЕсли;
			
		Иначе
			// Если флаг не установлен, меняем только у этой записи, 
			//при этом флаг идентичны сбрасывается у обратной записи.
			ОбратнаяЗапись[0].Идентичны = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


	ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ДополнитьВСтруктуруДопПараметры(СтруктураПараметров, ЭтотОбъект,Объект);
	СтруктураРезультата = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ЗагрузитьДанные(ТабличныйДокумент,СтруктураПараметров);
	
	Возврат СтруктураРезультата;
	
КонецФункции // мЗагрузитьДанные()

// Процедура заполнения результата выполнения мастера результатами работы и возникших ошибок
//
&НаКлиенте
Процедура ЗаполнитьРезультатРаботы(РезультатРаботыТекст="")
	
	РезультатРаботы = СтрЗаменить(РезультатРаботы, "%РезультатРаботы%", СтрЗаменить(РезультатРаботыТекст, Символы.ПС, "<BR>"));
	
КонецПроцедуры // ЗаполнитьРезультатРаботы()

// Процедура очищает поле HTML результата работы путем получения текста из макета
//
&НаСервере
Процедура ПодготовитьРезультатРаботы()
	
	РезультатРаботы = Обработки.ор_ЗагрузкаДанныхИзТабличногоДокумента.ПолучитьМакет("Макет").ПолучитьТекст();
	
КонецПроцедуры // ПодготовитьРезультатРаботы()

// Процедура выполняет непосредственную загрузку данных в документ, отображает ход выполнения процесса
&НаСервере
Процедура ЗагрузитьДанныеВФорме(ТабличныйДокумент, ОписаниеОшибок ="", НастройкиЗагрузкиНоменклатурыИскатьПо = "")
	
	// Проверим оставшиеся реквизиты формы
	СохранитьСоответсвия = Ложь;
	Если Элементы.СохранитьСоответствияВПрайсЛистеПоставщика.Доступность И СохранитьСоответствияВПрайсЛистеПоставщика Тогда
		Если НЕ ЗначениеЗаполнено(ПрайсЛистКонтрагента) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не указан прайс-лист поставщика"); 
			Возврат;
		КонецЕсли;
		СохранитьСоответсвия = Истина;
	КонецЕсли;
	
	Если Объект.ТабличнаяЧастьИсточника=Неопределено И НЕ Объект.ИмяВидаРегистра="" Тогда
		Объект.РежимЗагрузки = 2;
	КонецЕсли;
	
	// Выполним загрузку
	флКонтрольЗаполнения = Ложь;
	
	Результат = ЗагрузитьДанныеНаСервере(ТабличныйДокумент, ОписаниеОшибок);
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ОписаниеОшибок = Результат.ОписаниеОшибок;
		АдресТаблицаЗагрузкаИЗФайлаВХранилище = ПоместитьВоВременноеХранилище(Результат.ТЧДокумента, УникальныйИдентификатор);
		АдресСтруктураРеквизитовЗагрузкаИЗФайлаВХранилище = ПоместитьВоВременноеХранилище(Результат.РеквизитыШапкиДокумента, УникальныйИдентификатор);
	КонецЕсли;
	
	// Сохраним соответствие в прайс-лист контрагента
	
	Если СохранитьСоответсвия Тогда
		ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.СохранитьТаблицуСоответствия(ПрайсЛистКонтрагента, НастройкиЗагрузкиНоменклатурыИскатьПо, ТаблицаЗагружаемыхРеквизитов.Выгрузить(), Объект.СоответствиеНоменклатуры.Выгрузить(), ТаблицаДополнительныхПараметров.Выгрузить());
	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьДанныеВФорме()

// Заполняет настройки колонок по умолчанию или по переданным настройкам
//
// Параметры:
//  СтруктураУмолчаний - Структура - Структура настройки колонок по умолчанию
//
&НаСервере
Процедура ЗаполнитьНастройкиКолонок(Настройки)
	
	ТаблицаЗагружаемыхРеквизитов.Очистить();
	ТаблицаЗагружаемыхРеквизитовШапки.Очистить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитов    = ТаблицаЗагружаемыхРеквизитов.Выгрузить().СкопироватьКолонки();
	ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитовШапки = ТаблицаЗагружаемыхРеквизитовШапки.Выгрузить().СкопироватьКолонки();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СсылкаИсточника", 							ОбработкаОбъект.СсылкаИсточника);
	СтруктураПараметров.Вставить("РежимЗагрузки", 								ОбработкаОбъект.РежимЗагрузки);
	СтруктураПараметров.Вставить("ТабличнаяЧастьИсточника", 					ОбработкаОбъект.ТабличнаяЧастьИсточника);
	СтруктураПараметров.Вставить("ИмяВидаРегистра", 							ОбработкаОбъект.ИмяВидаРегистра);
	СтруктураПараметров.Вставить("ИмяСправочника", 								ОбработкаОбъект.ИмяСправочника);
	СтруктураПараметров.Вставить("ТабличнаяЧастьДокументаОбъекта",				ОбработкаОбъект.ТабличнаяЧастьДокументаОбъекта);
	СтруктураПараметров.Вставить("ТЧДокумента",									ОбработкаОбъект.ТЧДокумента);
	СтруктураПараметров.Вставить("НеСоздаватьНовыхЭлементов",					ОбработкаОбъект.ЗапретСозданияНовыхЭлементов);
	СтруктураПараметров.Вставить("НеОбновлятьСуществующиеЭлементы",				ОбработкаОбъект.ЗапретОбновленияСуществующихЭлементов);
	СтруктураПараметров.Вставить("ЗамещатьСуществующиеЗаписи",					ОбработкаОбъект.ЗамещатьСуществующиеЗаписи);
	СтруктураПараметров.Вставить("РучнаяНумерацияКолонокТабличногоДокумента",	ОбработкаОбъект.РучнаяНумерацияКолонокТабличногоДокумента);
	СтруктураПараметров.Вставить("ПерваяСтрокаДанныхТабличногоДокумента",		ОбработкаОбъект.ПерваяСтрокаДанныхТабличногоДокумента);
	СтруктураПараметров.Вставить("ФорматДатыСрокаГодности",						ОбработкаОбъект.ФорматДатыСрокаГодности);
	СтруктураПараметров.Вставить("ВсегдаФормироватьНовыеСерии",					ОбработкаОбъект.ВсегдаФормироватьНовыеСерии);
	СтруктураПараметров.Вставить("ДействиеСЗагружаемымФайлом",					ОбработкаОбъект.ДействиеСЗагружаемымФайлом);
	СтруктураПараметров.Вставить("флПоискПоПрайсуПоставщика",					ОбработкаОбъект.флПоискПоПрайсуПоставщика);
	СтруктураПараметров.Вставить("КаталогАрхиваЗагруженныхФайлов",				ОбработкаОбъект.КаталогАрхиваЗагруженныхФайлов);
	СтруктураПараметров.Вставить("СоздаватьПроизводителя",						ОбработкаОбъект.СоздаватьПроизводителя);
	СтруктураПараметров.Вставить("ИспользоватьВнешнийМодульПреобразованияФайла",ОбработкаОбъект.ИспользоватьВнешнийМодульПреобразованияФайла);
	СтруктураПараметров.Вставить("ОбработкаПреобразования",						ОбработкаОбъект.ОбработкаПреобразования);
	СтруктураПараметров.Вставить("Кодировка",									ОбработкаОбъект.Кодировка);
	СтруктураПараметров.Вставить("Табуляция",									ОбработкаОбъект.Табуляция);
	СтруктураПараметров.Вставить("ИмяТаблицы",									ОбработкаОбъект.ИмяТаблицы);
	СтруктураПараметров.Вставить("ПередЗаписьюОбъекта",							ОбработкаОбъект.ПередЗаписьюОбъекта);
	СтруктураПараметров.Вставить("ПриЗаписиОбъекта",							ОбработкаОбъект.ПриЗаписиОбъекта);
	СтруктураПараметров.Вставить("ПослеДобавленияСтроки",						ОбработкаОбъект.ПослеДобавленияСтроки);
	СтруктураПараметров.Вставить("ТаблицаЗагружаемыхРеквизитов",				ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитов.Скопировать());
	СтруктураПараметров.Вставить("ИмяВидаРегистра",								ОбработкаОбъект.ИмяВидаРегистра);
	СтруктураПараметров.Вставить("ИмяСправочника",								ОбработкаОбъект.ИмяСправочника);
	СтруктураПараметров.Вставить("ДополнительныеРеквизитыПоКатегорииНоменклатуры",	ОбработкаОбъект.ДополнительныеРеквизитыПоКатегорииНоменклатуры.Скопировать());
	СтруктураПараметров.Вставить("ЗагружатьДополнительныеРеквизитыИСведения",	ОбработкаОбъект.ЗагружатьДополнительныеРеквизитыИСведения);
	СтруктураПараметров.Вставить("ДополнительныеРеквизитыИСведенияТолькоОбщие",	ОбработкаОбъект.ДополнительныеРеквизитыИСведенияТолькоОбщие);
	СтруктураПараметров.Вставить("СоздаватьСтрануПроисхождения",				ОбработкаОбъект.СоздаватьСтрануПроисхождения);
	СтруктураПараметров.Вставить("ЗагружатьGTINДляСерии",						ОбработкаОбъект.ЗагружатьGTINДляСерии);
	
	СтруктураПараметров.Вставить("КоличествоНеОбрабатываемыхСтрок", 			ОбработкаОбъект.КоличествоНеОбрабатываемыхСтрок);
	
	СтруктураПараметров.Вставить("РучнаяНумерацияКолонокТабличногоДокументаДляШапки", ОбработкаОбъект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки);
	СтруктураПараметров.Вставить("ПерваяСтрокаДанныхШапки",                           ОбработкаОбъект.ПерваяСтрокаДанныхШапки);
	СтруктураПараметров.Вставить("ТаблицаЗагружаемыхРеквизитовШапки",                 ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитовШапки.Скопировать());

	ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ДополнитьВСтруктуруДопПараметры(СтруктураПараметров, ЭтотОбъект, ОбработкаОбъект, Истина);

	ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ЗаполнитьНастройкиКолонок(Настройки, СтруктураПараметров);
	
	ЗаполнитьЗначенияСвойств(ОбработкаОбъект, СтруктураПараметров);
	ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитов = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитов.Скопировать();
	ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитовШапки = СтруктураПараметров.ТаблицаЗагружаемыхРеквизитовШапки.Скопировать();
	ТаблицаЗагружаемыхРеквизитов.Загрузить(ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитов);
	ТаблицаЗагружаемыхРеквизитовШапки.Загрузить(ОбработкаОбъект.ТаблицаЗагружаемыхРеквизитовШапки);

	ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ПеренестиДопПараметрыВОбъектИНаФорму(СтруктураПараметров, ЭтотОбъект, ОбработкаОбъект);
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры // ЗаполнитьНастройкиКолонок()

// Функция создания номенклатуры по настройке
//
&НаСервере
Функция СоздатьНоменклатуруПоНастройкеНаСервере(ТабличныйДокументОбъекта, Настройка, НомерКолонкиНоменклатуры)
	
	Возврат ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.СоздатьНоменклатуруПоНастройке(ТабличныйДокументОбъекта,
																				Настройка, 
																				НомерКолонкиНоменклатуры, 
																				Объект.СоответствиеНоменклатуры.Выгрузить(), 
																				ЭтотОбъект,
																				Объект.ПерваяСтрокаДанныхТабличногоДокумента);
КонецФункции

// Функция формирования структуры параметров для установки отбора в форме выбора настроек
//
&НаСервере
Функция СформироватьСтруктуруОтбораДляВыбораНастройки(ДляФормированияНоменклатуры=Ложь)
	
	СтруктураРеквизитов = Новый Структура("РежимЗагрузки,СсылкаИсточника,ТабличнаяЧастьИсточника,ИмяВидаРегистра,ИмяСправочника",
							Объект.РежимЗагрузки,
							Объект.СсылкаИсточника,
							Объект.ТабличнаяЧастьИсточника,
							Объект.ИмяВидаРегистра,
							Объект.ИмяСправочника);
	
	ПараметрОтборПоМетаданнымТабличнойЧасти = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьМетаданныеИсточника(СтруктураРеквизитов);
	
	СтруктураПараметров = Новый Структура();
	
	СтруктураПараметров.Вставить("ПараметрОтборПоВариантуИспользования", Перечисления.ор_ВариантыИспользованияНастройки.ЗагрузкаДанных);
	
	Если ДляФормированияНоменклатуры Тогда
		
		СтруктураПараметров.Вставить("ПараметрОтборПоТипуПрикладногоОбъекта", Перечисления.ор_ТипыПрикладныхОбъектов.Справочник);
		СтруктураПараметров.Вставить("ПараметрОтборПоМетаданным"            , Метаданные.Справочники.Номенклатура.ПолноеИмя());
		СтруктураПараметров.Вставить("ПараметрОтборПоКонтрагенту"           , Контрагент);
		
	Иначе
		
		Если Метаданные.Справочники.Содержит(ПараметрОтборПоМетаданнымТабличнойЧасти) Тогда
			// Это справочник
			СтруктураПараметров.Вставить("ПараметрОтборПоТипуПрикладногоОбъекта", Перечисления.ор_ТипыПрикладныхОбъектов.Справочник);
			СтруктураПараметров.Вставить("ПараметрОтборПоМетаданным"            , ПараметрОтборПоМетаданнымТабличнойЧасти.ПолноеИмя());
			
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(ПараметрОтборПоМетаданнымТабличнойЧасти) Тогда
			// Это регистр сведений
			СтруктураПараметров.Вставить("ПараметрОтборПоТипуПрикладногоОбъекта", Перечисления.ор_ТипыПрикладныхОбъектов.РегистрСведений);
			СтруктураПараметров.Вставить("ПараметрОтборПоМетаданным"            , ПараметрОтборПоМетаданнымТабличнойЧасти.ПолноеИмя());
			
		Иначе
			// Это ТЧ, надо только выяснить чья
			Если Метаданные.Документы.Содержит(ПараметрОтборПоМетаданнымТабличнойЧасти.Родитель()) Тогда
				СтруктураПараметров.Вставить("ПараметрОтборПоКонтрагенту", Контрагент);
				СтруктураПараметров.Вставить("ПараметрОтборПоТипуПрикладногоОбъекта", Перечисления.ор_ТипыПрикладныхОбъектов.Документ);
			Иначе
				СтруктураПараметров.Вставить("ПараметрОтборПоТипуПрикладногоОбъекта", Перечисления.ор_ТипыПрикладныхОбъектов.Справочник);
			КонецЕсли;
			СтруктураПараметров.Вставить("ПараметрОтборПоМетаданным"              , ?(ПараметрОтборПоМетаданнымТабличнойЧасти = Неопределено, "", ПараметрОтборПоМетаданнымТабличнойЧасти.Родитель().ПолноеИмя()));
			СтруктураПараметров.Вставить("ПараметрОтборПоМетаданнымТабличнойЧасти", ПараметрОтборПоМетаданнымТабличнойЧасти.Имя);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервере
Функция СохранитьИзмененныеНастройкиНаСервере()
	Попытка
		НастройкаЗагрузкиОбъект = НастройкаЗагрузки.ПолучитьОбъект();
		МетаданныеИсточника = ПолучитьМетаданныеИсточникаИзВременногоХранилища();
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("МетаданныеИсточникаИзСправочника", МетаданныеИсточника);
		Если Метаданные.Справочники.Содержит(МетаданныеИсточника) Тогда
			ТекРежимЗагрузки                             = 0;
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеИсточника) Тогда
			ТекРежимЗагрузки                             = 2;
		Иначе
			ТекРежимЗагрузки                             = 1;	
		КонецЕсли;
		СтруктураПараметров.Вставить("РежимЗагрузки", 								ТекРежимЗагрузки);
		СтруктураПараметров.Вставить("НеСоздаватьНовыхЭлементов", 					Объект.ЗапретСозданияНовыхЭлементов);
		СтруктураПараметров.Вставить("ЗамещатьСуществующиеЗаписи", 					Ложь);
		СтруктураПараметров.Вставить("РучнаяНумерацияКолонокТабличногоДокумента", 	Объект.РучнаяНумерацияКолонокТабличногоДокумента);
		СтруктураПараметров.Вставить("ПерваяСтрокаДанныхТабличногоДокумента", 		Объект.ПерваяСтрокаДанныхТабличногоДокумента);
		СтруктураПараметров.Вставить("КоличествоНеОбрабатываемыхСтрок",				Объект.КоличествоНеОбрабатываемыхСтрок);
		СтруктураПараметров.Вставить("ДействиеСЗагружаемымФайлом", 					Объект.ДействиеСЗагружаемымФайлом);
		СтруктураПараметров.Вставить("флПоискПоПрайсуПоставщика", 					Объект.флПоискПоПрайсуПоставщика);
		СтруктураПараметров.Вставить("КаталогАрхиваЗагруженныхФайлов", 				Объект.КаталогАрхиваЗагруженныхФайлов);
		СтруктураПараметров.Вставить("Табуляция", 									Объект.Табуляция);
		СтруктураПараметров.Вставить("Кодировка", 									Объект.Кодировка);
		СтруктураПараметров.Вставить("ИмяТаблицы", 									Объект.ИмяТаблицы);
		СтруктураПараметров.Вставить("НеОбновлятьСуществующиеЭлементы", 			Объект.ЗапретОбновленияСуществующихЭлементов);
		СтруктураПараметров.Вставить("ИспользоватьВнешнийМодульПреобразованияФайла", Объект.ИспользоватьВнешнийМодульПреобразованияФайла);
		СтруктураПараметров.Вставить("ОбработкаПреобразования", 					Объект.ОбработкаПреобразования);
		СтруктураПараметров.Вставить("ТаблицаЗагружаемыхРеквизитов", 				ТаблицаЗагружаемыхРеквизитов.Выгрузить());
		СтруктураПараметров.Вставить("ПередЗаписьюОбъекта", 						Объект.ПередЗаписьюОбъекта);
		СтруктураПараметров.Вставить("ПриЗаписиОбъекта", 							Объект.ПриЗаписиОбъекта);
		СтруктураПараметров.Вставить("ПослеДобавленияСтроки", 						Объект.ПослеДобавленияСтроки);
		СтруктураПараметров.Вставить("ЗагружатьДополнительныеРеквизитыИСведения",	Ложь);
		СтруктураПараметров.Вставить("ДополнительныеРеквизитыИСведенияТолькоОбщие",	Ложь);
		СтруктураПараметров.Вставить("ДополнительныеРеквизитыПоКатегорииНоменклатуры",	Новый СписокЗначений);
		
		СтруктураПараметров.Вставить("РучнаяНумерацияКолонокТабличногоДокументаДляШапки", Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки);
		СтруктураПараметров.Вставить("ПерваяСтрокаДанныхШапки",                           Объект.ПерваяСтрокаДанныхШапки);
		СтруктураПараметров.Вставить("ТаблицаЗагружаемыхРеквизитовШапки",                 ТаблицаЗагружаемыхРеквизитовШапки.Выгрузить());
		
		ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаСервер.ДополнитьСтруктуруПараметровЗаполнитьТабличныйДокументИзНастроекПомощника(СтруктураПараметров, Объект, ТаблицаДополнительныхПараметров.Выгрузить());
		
		НастройкаЗагрузкиОбъект.НастройкиЗагрузкиВыгрузки = Новый ХранилищеЗначения(ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьНастройки(СтруктураПараметров));
		НастройкаЗагрузкиОбъект.Записать();
		Возврат "";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

// Функция формирует структуру, хранящую значения реквизитов шапки документа
//
Функция СформироватьСтруктуруРеквизитовШапкиДокумента(Источник)
	
	СтруктураРеквизитов = Новый Структура;
	Для Каждого Реквизит ИЗ Источник.Метаданные().Реквизиты Цикл
		СтруктураРеквизитов.Вставить(Реквизит.Имя, Источник[Реквизит.Имя]);
	КонецЦикла;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

// Процедура изменения настройки ручной нумерации колонок настроек загрузки шапки документа
//
&НаСервере
Процедура УстановитьРучнаяНумерацияКолонокНастройкиШапки()
	
	Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки = НЕ Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
	
КонецПроцедуры

// Заполняет списки выбора для реквизитов табличной части
//
&НаСервере
Функция ЗаполнитьСпискиВыбораШапки(ТекущаяСтрокаТаблицы, ТекущийЭлементИмя, РежимЗагрузкиИскать)
	
	СписокВыбора = Новый СписокЗначений;
	ТекущиеДанные = ТаблицаЗагружаемыхРеквизитовШапки[ТекущаяСтрокаТаблицы];
	
	Если ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиИскатьПо" Тогда
		
		СписокВыбора = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьСписокИменПредставлений(ТекущиеДанные);
		
	ИначеЕсли ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиСвязьПоВладельцу" Тогда
		
		СписокВыбора = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьСписокСвязейПоВладельцу(ТекущиеДанные, ТаблицаЗагружаемыхРеквизитовШапки);
		
	ИначеЕсли ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиСвязьПоТипу" Тогда
		
		СписокВыбора = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьСписокСвязейПоТипу(ТекущиеДанные, ТаблицаЗагружаемыхРеквизитовШапки);
		
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

// Проверяет наличие отмеченных чтрок в таблице настроек шапки
//
&НаСервере
Функция ЕстьОтмеченныеСтрокиВНастройкахШапки()
	
	Результат = ТаблицаЗагружаемыхРеквизитовШапки.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() <> 0;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КомандаДалееЗагрузкаФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Инкремент   = ДополнительныеПараметры.Инкремент;
	ФайлНаДиске = ДополнительныеПараметры.ФайлНаДиске;
	
	Если Результат <> Неопределено Тогда
		АдресВоВременномХранилище = Результат[0].Хранение;
		
		Если Объект.ИспользоватьВнешнийМодульПреобразованияФайла И ЗначениеЗаполнено(Объект.ОбработкаПреобразования) Тогда
			ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ЗаполнитьТабличныйДокументИзXMLСервер(ФайлДанных, Объект.ОбработкаПреобразования, Объект.ТабличныйДокумент, АдресВоВременномХранилище);
		Иначе
			ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПрочитатьТабличныйДокумент(Объект.ТабличныйДокумент, ФайлНаДиске.Расширение, ФайлНаДиске.ИмяБезРасширения, АдресВоВременномХранилище, Объект.Табуляция, Объект.Кодировка);
		КонецЕсли;
		
		ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаКлиент.НастроитьВидимостьЭлементовФормыПомощника(СтрокаНастройкиЗагрузкиНоменклатуры, Элементы,НастройкиЗагрузкиНоменклатурыИскатьПо);
		
		ЗаполнитьМассивКнопок();
		
		Элементы.ТаблицаЗагружаемыхРеквизитовНомерКолонки.Видимость = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
		Элементы.ТаблицаЗагружаемыхРеквизитовПеренумероватьКолонки.Доступность = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
		Элементы.ТаблицаЗагружаемыхРеквизитовРучнаяНумерацияКолонокТабличногоДокумента.Пометка = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
		
		Элементы.ТаблицаЗагружаемыхРеквизитовШапкиНомерКолонки.Видимость = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
		Элементы.ТаблицаЗагружаемыхРеквизитовШапкиПеренумероватьКолонкиНастройкиШапки.Доступность = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
		Элементы.ТаблицаЗагружаемыхРеквизитовШапкиРучнаяНумерацияКолонокНастройкиШапки.Пометка = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
		
		Если Объект.РежимЗагрузки = 3 И (НЕ Объект.ИмяВидаРегистра = "" ИЛИ НЕ Объект.ИмяСправочника = "") Тогда 
			Элементы.ГруппаСтраницаНастройкиШапки.Видимость = Ложь;
		КонецЕсли;
		
		КомандаДалееЗавершение(ДополнительныеПараметры);
	Иначе
		ПоказатьПредупреждение(,НСтр("ru= 'В ходе работы мастера возникли ошибки! Неудалось загрузить файл данных!'"),,НСтр("ru= 'Ошибка загрузки данных'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДалееЗавершение(ДополнительныеПараметры)
	
	Инкремент = ДополнительныеПараметры.Инкремент;
	
	Если Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаРезультат Тогда
		// Первое условие МОЖЕТ выполниться только в случае РежимЗагрузки = 3
		Если ЗначениеЗаполнено(АдресТаблицаЗагрузкаИЗФайлаВХранилище) И ЗначениеЗаполнено(АдресСтруктураРеквизитовЗагрузкаИЗФайлаВХранилище) Тогда
			Структура = Новый Структура("АдресТаблицаЗагрузкаИЗФайлаВХранилище, АдресСтруктураРеквизитовЗагрузкаИЗФайлаВХранилище", АдресТаблицаЗагрузкаИЗФайлаВХранилище, АдресСтруктураРеквизитовЗагрузкаИЗФайлаВХранилище);
			ОповеститьОВыборе(Структура);
		// Остальные режимы загрузки предполагают закрытие формы
		ИначеЕсли Объект.РежимЗагрузки <> 3 Тогда
			Закрыть();			
		Иначе
			ПоказатьПредупреждение(,НСтр("ru= 'В ходе работы мастера возникли ошибки! Невозможно выполнить загрузку в документ!'"),,НСтр("ru= 'Ошибка загрузки в документ'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	мТекущийНомерСтраницы = ?((мТекущийНомерСтраницы + Инкремент)>4, 4, мТекущийНомерСтраницы + Инкремент);
	Элементы.Страницы.ТекущаяСтраница = мСтраницы[мТекущийНомерСтраницы];
	УстановитьДоступностьКнопок();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагТаблицыСоответствий(ЗначениеФлага)
	
	ТаблицаСоответствия = Объект.СоответствиеНоменклатуры.Выгрузить();
	ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.УстановитьФлагТаблицыСоответствий(ЗначениеФлага, ТаблицаСоответствия);
	Объект.СоответствиеНоменклатуры.Загрузить(ТаблицаСоответствия);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДополнительныеПараметрыЗагрузкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.ШКЯвляетсяПолемПоискаНоменклатуры = Результат.ШКЯвляетсяПолемПоискаНоменклатуры;
	Объект.СоздаватьОбщиеХарактеристики      = Результат.СоздаватьОбщиеХарактеристики;
	
	Объект.ВсегдаФормироватьНовыеСерии  = Результат.ВсегдаФормироватьНовыеСерии;
	Объект.СоздаватьПроизводителя       = Результат.СоздаватьПроизводителя;
	Объект.ФорматДатыСрокаГодности      = Результат.ФорматДатыСрокаГодности;
	Объект.НеФормироватьДопНомерСерии   = Результат.НеФормироватьДопНомерСерии;
	Объект.ЗагружатьШК                  = Результат.ЗагружатьШК;
	Объект.СоздаватьСтрануПроисхождения = Результат.СоздаватьСтрануПроисхождения;
	Объект.ЗагружатьGTINДляСерии        = Результат.ЗагружатьGTINДляСерии;
	
	ЗагрузитьДопТаблицу(Результат) 

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДопТаблицу(Рез)
	Если Рез<>Неопределено Тогда
		ТаблицаДополнительныхПараметров.Загрузить(Рез.ТаблицаДополнительныхПараметров.Выгрузить());
		Объект.ТаблицаДополнительныхПараметров.Загрузить(Рез.ТаблицаДополнительныхПараметров.Выгрузить());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Рез = СохранитьИзмененныеНастройкиНаСервере();
	Если ПустаяСтрока(Рез) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Настройка успешно сохранена");
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("При сохранении настройки возникли ошибки: "+Рез);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКолонкуОбработкаВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьКолонкуЗавершение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКолонкуЗавершение(ДополнительныеПараметры)
	
	НомерКолонки     = ДополнительныеПараметры.НомерКолонки;
	ЭтоСтраницаШапки = ДополнительныеПараметры.ЭтоСтраницаШапки;
	ТекСтрока        = ДополнительныеПараметры.ТекСтрока;
	
	ТекСтрока.НомерКолонки = НомерКолонки;
	ТекСтрока.Пометка = Истина;
	
	Если Не Объект.РучнаяНумерацияКолонокТабличногоДокумента И НЕ ЭтоСтраницаШапки  Тогда
		Объект.РучнаяНумерацияКолонокТабличногоДокумента = Истина;
		Элементы.ТаблицаЗагружаемыхРеквизитовНомерКолонки.Видимость = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
		Элементы.ТаблицаЗагружаемыхРеквизитовПеренумероватьКолонки.Доступность = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
		Элементы.ТаблицаЗагружаемыхРеквизитовРучнаяНумерацияКолонокТабличногоДокумента.Пометка = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
	ИначеЕсли Не Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки И ЭтоСтраницаШапки Тогда
		Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки = Истина;
		Элементы.ТаблицаЗагружаемыхРеквизитовШапкиНомерКолонки.Видимость = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
		Элементы.ТаблицаЗагружаемыхРеквизитовШапкиПеренумероватьКолонкиНастройкиШапки.Доступность = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
		Элементы.ТаблицаЗагружаемыхРеквизитовШапкиРучнаяНумерацияКолонокНастройкиШапки.Пометка = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
	КонецЕсли;
	
	РасставитьПометкиНаКнопках(НомерКолонки);
	
КонецПроцедуры

&НаКлиенте
Процедура СобытияОткрытьФормуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого РезультирующееЗначение Из Результат Цикл
		Объект[РезультирующееЗначение.Ключ] = РезультирующееЗначение.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНоменклатуруОбработкаВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("СоответствиеНоменклатуры", Объект.СоответствиеНоменклатуры);
	
	ОткрытьФорму("Обработка.ор_ЗагрузкаДанныхИзТабличногоДокумента.Форма.ФормаДобавленияНоменклатуры",
		СтруктураПараметров,
		ЭтотОбъект,
		,,,
		Новый ОписаниеОповещения("СформироватьНоменклатуруОткрытьФормуЗавершение", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНоменклатуруОткрытьФормуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат=Неопределено Тогда
		ОбновитьСоответствиеНоменклатуры(Результат.СоответствиеНоменклатуры);
		ЗагрузитьСоответствиеНоменклатуры(Объект.ТабличныйДокумент, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНоменклатуруПоНастройкеОбработкаВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	// Выберем настройку, по которой будем загружать
	СтруктураПараметров = СформироватьСтруктуруОтбораДляВыбораНастройки(Истина);
	
	ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("СформироватьНоменклатуруПоНастройкеОткрытьФормуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Справочник.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ФормаВыбора", СтруктураПараметров, ЭтотОбъект,,,,ОписаниеОповещенияОВыборе, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНоменклатуруПоНастройкеОткрытьФормуЗавершение(Настройка, ДополнительныеПараметры) Экспорт
	
	ЕстьЧтоЗагружать = Ложь;
	НайденнаяСтрока  = ДополнительныеПараметры.НайденнаяСтрока;
	
	Если Настройка <> Неопределено Тогда
		
		ЕстьЧтоЗагружать = СоздатьНоменклатуруПоНастройкеНаСервере(Объект.ТабличныйДокумент,
																				Настройка, 
																				НайденнаяСтрока.НомерКолонки);
		
	КонецЕсли;
	
	Если ЕстьЧтоЗагружать Тогда
		ЗагрузитьСоответствиеНоменклатуры(Объект.ТабличныйДокумент, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрайсЛистКонтрагентаОткрытьФормуЗавершение(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ЗначениеВыбора) Тогда
		ПрайсЛистКонтрагента = ЗначениеВыбора;
		УправлениеДиалогом();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовВыражениеОткрытьФормуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//ЭтотОбъект[Элемент.Имя] = СокрЛП(Результат);
	ЭтотОбъект.ТекущийЭлемент.ТекущиеДанные.Выражение = СокрЛП(Результат);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиВыражениеОткрытьФормуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.ТекущийЭлемент.ТекущиеДанные.Выражение = СокрЛП(Результат);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьФормуВыбораОбъектаМетаданных(Тип)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Если Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектМетаданных.Иерархический
		И ОбъектМетаданных.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			Возврат ОбъектМетаданных.ПолноеИмя() + ".ФормаВыбораГруппы";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ОбновитьСоответствиеНоменклатуры(СоответствиеНоменклатуры)
	Объект.СоответствиеНоменклатуры.Загрузить(СоответствиеНоменклатуры.Выгрузить());
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормаПодбораНоменклатурыПоСхожести(ТаблицаДанных, ДополнительныеПараметры) Экспорт
	
	Если ТаблицаДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл
		Если СтрокаТаблицыДанных.Загружать Тогда
			
			СтрокаСоответствия = Объект.СоответствиеНоменклатуры.НайтиСтроки(Новый Структура("НомерСтроки", СтрокаТаблицыДанных.НомерСтроки))[0];
			СтрокаСоответствия.Номенклатура = СтрокаТаблицыДанных.Номенклатура;
			
			Если ЗначениеЗаполнено(СтрокаСоответствия.Номенклатура) И (СтрокаСоответствия.Загружать) Тогда
				СтрокаСоответствия.Загружать = Ложь
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.Номенклатура) И (НЕ СтрокаСоответствия.Загружать) Тогда
				СтрокаСоответствия.Загружать = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСопоставлениеПоШтрихкоду(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьСопоставлениеПоШтрихкодуСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСопоставлениеПоШтрихкодуСервер()
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаДанных.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(20)));
	
	Для Каждого ТекСтрока Из Объект.СоответствиеНоменклатуры Цикл
		Если ТекСтрока.Загружать И НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) И ЗначениеЗаполнено(ТекСТрока.Штрихкод) Тогда
			НоваяСтрока = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДанных.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДанных.ШтрихКод КАК ШтрихКод
	|ПОМЕСТИТЬ ВрТаблица
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаблица.НомерСтроки КАК НомерСтроки,
	|	ВрТаблица.ШтрихКод КАК ШтрихКод,
	|	ШтрихКоды.Номенклатура КАК СопоставляемаяНоменклатура
	|ИЗ
	|	ВрТаблица КАК ВрТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихКоды
	|		ПО ВрТаблица.ШтрихКод = ШтрихКоды.Штрихкод
	|ГДЕ
	|	НЕ ШтрихКоды.Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаСоответствия = Объект.СоответствиеНоменклатуры.НайтиСтроки(Новый Структура("НомерСтроки", Выборка.НомерСтроки))[0];
		СтрокаСоответствия.Номенклатура = Выборка.СопоставляемаяНоменклатура;
		
		Если ЗначениеЗаполнено(СтрокаСоответствия.Номенклатура) И (СтрокаСоответствия.Загружать) Тогда
			СтрокаСоответствия.Загружать = Ложь
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.Номенклатура) И (НЕ СтрокаСоответствия.Загружать) Тогда
			СтрокаСоответствия.Загружать = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСопоставлениеПоНаименованию(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьСопоставлениеПоНаименованиюСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСопоставлениеПоНаименованиюСервер()
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаДанных.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(150)));
	
	Для Каждого ТекСтрока Из Объект.СоответствиеНоменклатуры Цикл
		Если ТекСтрока.Загружать И НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) И ЗначениеЗаполнено(ТекСТрока.Наименование) Тогда
			НоваяСтрока = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДанных.НомерСтроки,
	|	ТаблицаДанных.Наименование
	|ПОМЕСТИТЬ ВрТаблица
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаблица.НомерСтроки,
	|	ВрТаблица.Наименование,
	|	СпрНоменклатура.Ссылка КАК СопоставляемаяНоменклатура
	|ИЗ
	|	ВрТаблица КАК ВрТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВрТаблица.Наименование = СпрНоменклатура.Наименование
	|ГДЕ
	|	НЕ СпрНоменклатура.Ссылка ЕСТЬ NULL 
	|	И НЕ СпрНоменклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаСоответствия = Объект.СоответствиеНоменклатуры.НайтиСтроки(Новый Структура("НомерСтроки", Выборка.НомерСтроки))[0];
		СтрокаСоответствия.Номенклатура = Выборка.СопоставляемаяНоменклатура;
		
		Если ЗначениеЗаполнено(СтрокаСоответствия.Номенклатура) И (СтрокаСоответствия.Загружать) Тогда
			СтрокаСоответствия.Загружать = Ложь
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.Номенклатура) И (НЕ СтрокаСоответствия.Загружать) Тогда
			СтрокаСоответствия.Загружать = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормаПодбораНоменклатуры(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СоответствиеНоменклатуры.ТекущиеДанные;
	ТекущиеДанные.Номенклатура = Результат;
	ТекущиеДанные.Загружать = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНоменклатурыДокумента(Документ, ДополнительныеПараметры) Экспорт
	
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьНесопоставленнаяНоменклатураДокумента(Документ) Тогда
		
		ПараметрыФормы = Новый Структура("КоллекцияСтрок, Документ", Объект.СоответствиеНоменклатуры, Документ);
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормаПодбораПоДокументу", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("Обработка.ор_ЗагрузкаДанныхИзТабличногоДокумента.Форма.ФормаПодбораПоДокументу", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе  <"+Документ+"> не обнаружено несопоставленных номенклатур.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормаПодбораПоДокументу(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Для Каждого ТекСтрока Из Результат Цикл
			
			СтрокаСоответствия = Объект.СоответствиеНоменклатуры.НайтиСтроки(Новый Структура("НомерСтроки", ТекСтрока.НомерСтроки))[0];
			СтрокаСоответствия.Номенклатура = ТекСтрока.Номенклатура;
			СтрокаСоответствия.Загружать = Ложь
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьНесопоставленнаяНоменклатураДокумента(Документ)
	
	НоменклатурыЗаказа = Документ.Товары.ВыгрузитьКолонку("Номенклатура");
	
	Результат = Ложь;
	Для Каждого Номенклатура Из НоменклатурыЗаказа Цикл
		НаденныеСтроки = Объект.СоответствиеНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
		Если НаденныеСтроки.Количество() = 0 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

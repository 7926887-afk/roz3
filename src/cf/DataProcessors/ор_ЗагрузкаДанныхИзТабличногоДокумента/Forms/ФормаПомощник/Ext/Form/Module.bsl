
#Область ОписаниеПеременных

&НаКлиенте
Перем мСтраницы; // Соответствие страниц и и их номеров.

&НаКлиенте
Перем СтрокаНастройкиЗагрузкиНоменклатуры; // Строка настройки загрузки номенклатуры.

&НаКлиенте
Перем НастройкиЗагрузкиНоменклатурыИскатьПо; // Значение реквизита "ИскатьПо" строки настройки загрузки номенклатуры.

&НаКлиенте
Перем ИзмененаРучнаяНумерацияКолонок;

&НаКлиенте
Перем РазвернутТабличныйДокумент;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ор_ПрограммноеСозданиеЭлементовФорм.СоздатьЭлементыФормы(ЭтотОбъект);
	
	Если НЕ Параметры.Свойство("РежимЗагрузки") Тогда
		Отказ = Истина;
		ВызватьИсключение НСтр("ru = 'Самостоятельное использование формы не предусмотрено'");
	КонецЕсли;
	
	Объект.РучнаяНумерацияКолонокТабличногоДокумента = Параметры.РучнаяНумерацияКолонокТабличногоДокумента;
	Объект.РежимЗагрузки                             = Параметры.РежимЗагрузки;
	
	Если Параметры.Свойство("ТабличнаяЧастьИсточника") Тогда
		Объект.ТабличнаяЧастьИсточника = Параметры.ТабличнаяЧастьИсточника;
		Объект.СсылкаИсточника         = Параметры.СсылкаИсточника;
		Контрагент = Параметры.Контрагент;
	ИначеЕсли Параметры.Свойство("ИмяВидаРегистра") Тогда
		Объект.ИмяВидаРегистра = Параметры.ИмяВидаРегистра;
	КонецЕсли;
	
	мТекущийНомерСтраницы = 0;
	
	// + ОР РежимВыбораИзСписка
	Элементы.КодировкаЗагрузка.КнопкаВыбора = Истина;
	// - ОР РежимВыбораИзСписка
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если НЕ ВебКлиент Тогда
		
		// Инициализация переменных управления страницами и кнопками перехода
		мСтраницы = Новый Соответствие;
		мСтраницы.Вставить(0, Элементы.СтраницаВыборНастройки);
		мСтраницы.Вставить(1, Элементы.СтраницаИсточникДанных);
		мСтраницы.Вставить(2, Элементы.СтраницаСоответствияНоменклатуры);
		мСтраницы.Вставить(3, Элементы.СтраницаРезультат);
		мСтраницы.Вставить(4, Элементы.СтраницаХодЗагрузки);
		
		ПодготовитьРезультатРаботы();
		
	#Иначе
		
		ПоказатьПредупреждение(,НСтр("ru = 'Загрузка данных из внешних файлов не поддерживается в веб-клиенте.'"));
		Отказ = ИСТИНА;
		Возврат;
		
	#КонецЕсли
	
	ИзмененаРучнаяНумерацияКолонок = Ложь;
	РазвернутТабличныйДокумент = Ложь;
	ОтображениеНастроекЗагрузки = Ложь;
	УстановитьВидимостьНастроекЗагрузки();
	
	Элементы.флПоискПоПрайсуПоставщика.Видимость 										= ПустаяСтрока(Объект.ИмяСправочника) И ПустаяСтрока(Объект.ИмяВидаРегистра);
	Элементы.ЗапретСозданияНовыхЭлементов.Видимость 									= Не ПустаяСтрока(Объект.ИмяСправочника);
	Элементы.ЗапретОбновленияСуществующихЭлементов.Видимость 							= Не ПустаяСтрока(Объект.ИмяСправочника);
	Элементы.ТаблицаЗагружаемыхРеквизитовДополнительныеПараметрыЗагрузки.Доступность 	= ПустаяСтрока(Объект.ИмяСправочника) И ПустаяСтрока(Объект.ИмяВидаРегистра);
	
КонецПроцедуры // ПриОткрытии()

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Процедура - обработчик события "НачалоВыбора" поля формы "ФайлДанных"
//
&НаКлиенте
Процедура ФайлДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.ПолноеИмяФайла = ФайлДанных;
	ДиалогВыбораФайла.Заголовок = "Выбрать источник данных";
	ДиалогВыбораФайла.Фильтр = "Все форматы (*.dbf;*.xls;*.xlsx;*.txt;*.mxl;*.mdb;*.sst;*.mmo;*.xml)|*.dbf;*.xls;*.xlsx;*.txt;*.mxl;*.mdb;*.sst;*.mmo;*.xml|dBase III (*.dbf)|*.dbf|Лист Excel (*.xls)|*.xls|Лист Excel 2007 (*.xlsx)|*.xlsx|Бинарная рабочая книга Excel (*.xlsb)|*.xlsb|Лист Excel с поддержкой макросов (*.xlsm)|*.xlsm|Текстовый документ (*.txt)|*.txt|Табличный документ (*.mxl)|*.mxl|Microsoft Access(*.mdb)|*.mdb|Формат sst (*.sst)|*.sst|Формат mmo (*.mmo)|*.mmo|Формат xml (*.xml)|*.xml |Формат OpenOffice (*.ods)|*.ods|";
	Если НЕ ДиалогВыбораФайла.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ФайлДанных = ДиалогВыбораФайла.ПолноеИмяФайла;
	
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля формы "НастройкаЗагрузки"
//
&НаКлиенте
Процедура НастройкаЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметров = СформироватьСтруктуруОтбораДляВыбораНастройки();
	
	ОткрытьФорму("Справочник.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.ФормаВыбора", СтруктураПараметров, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

// Процедура - обработчик события "СохранитьСоответствияВПрайсЛистеПоставщикаПриИзменении"
//
&НаКлиенте
Процедура СохранитьСоответствияВПрайсЛистеПоставщикаПриИзменении(Элемент)
	УправлениеДиалогом();
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля "ПрайсЛистКонтрагента".
//
&НаКлиенте
Процедура ПрайсЛистКонтрагентаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ФормаВыбораПрайса = ПолучитьФорму("Справочник.ор_ПрайсЛистыПоставщиков.ФормаВыбора");
	УправлениеНебольшойФирмойКлиент.УстановитьЭлементОтбораСписка(
		ФормаВыбораПрайса.Список,
		"Владелец",
		Контрагент,
		ВидСравненияКомпоновкиДанных.Равно);
		
	ор_ЗагрузкаИзЭлектронныхДокументовОтраслеваяСпецификаКлиент.УстановитьОтборПрайсаПоМониторингу(ФормаВыбораПрайса.Список);
	
	ФормаВыбораПрайса.ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПрайсЛистКонтрагентаОткрытьФормуЗавершение", ЭтотОбъект);
	
	// Выбираем прайс-лист контрагента
	ФормаВыбораПрайса.Открыть();
	
КонецПроцедуры

// Процедура - обработчик события "ПриСменеСтраницы" элемента "ГруппаСтраницыНастройкиЗагрузки"
//
&НаКлиенте
Процедура ГруппаСтраницыНастройкиЗагрузкиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ЗаполнитьМассивКнопок();
	
	Если Элементы.ГруппаСтраницыНастройкиЗагрузки.ТекущаяСтраница = Элементы.ГруппаСтраницаНастройкиШапки Тогда
		ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитовШапки);
	Иначе
		ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитов);
	КонецЕсли;
	
	РазобратьсяСОформлениемСтрок();
	
КонецПроцедуры

// Процедура - обработчик события "ПриАктивизацииОбласти" поля "ТабличныйДокумент"
//
&НаКлиенте
Процедура ТабличныйДокументПриАктивизацииОбласти(Элемент)
	
	Если Объект.ТабличныйДокумент.ТекущаяОбласть <> Неопределено Тогда
		НомерКолонки = Объект.ТабличныйДокумент.ТекущаяОбласть.Лево;
	Иначе
		НомерКолонки = 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерКолонки) Тогда
		РасставитьПометкиНаКнопках(НомерКолонки);
	КонецЕсли;
    ПодсветитьВыбраннуюКолонку(Неопределено);
	РазобратьсяСОформлениемСтрок();
КонецПроцедуры

&НаКлиенте
Процедура ПрайсЛистКонтрагентаОчистка(Элемент, СтандартнаяОбработка)
	УправлениеДиалогом();
КонецПроцедуры

&НаКлиенте
Процедура ПрайсЛистКонтрагентаПриИзменении(Элемент)
	УправлениеДиалогом();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоответствиеНоменклатуры

// Процедура - обработчик события "ПриИзменении" реквизита "Загружать" таблицы формы "СоответствиеНоменклатуры"
//
&НаКлиенте
Процедура СоответствиеНоменклатурыЗагружатьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоответствиеНоменклатуры.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) И ТекущиеДанные.Загружать Тогда
		ТекущиеДанные.Загружать = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" реквизита "Номенклатура" таблицы формы "СоответствиеНоменклатуры"
//
&НаКлиенте
Процедура СоответствиеНоменклатурыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоответствиеНоменклатуры.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) И (ТекущиеДанные.Загружать) Тогда
		ТекущиеДанные.Загружать = Ложь
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) И (НЕ ТекущиеДанные.Загружать) Тогда
		ТекущиеДанные.Загружать = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаЗагружаемыхРеквизитов

// Обработчик события "ТаблицаЗагружаемыхРеквизитовПередНачаломИзменения".
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовПередНачаломИзменения(Элемент, Отказ)
	
	ИндексТекущейСтроки = ТаблицаЗагружаемыхРеквизитов.Индекс(Элемент.ТекущиеДанные);
	ТекущийЭлементИмя = Элемент.ТекущийЭлемент.Имя;
	РежимЗагрузкиИскать = Элемент.ТекущиеДанные.РежимЗагрузки = "Искать";
	
	Если ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовИскатьПо"
	 ИЛИ ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовСвязьПоВладельцу"
	 ИЛИ ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовСвязьПоТипу" Тогда
		//СписокВыбора = ЗаполнитьСпискиВыбора(Элемент.ТекущаяСтрока, ТекущийЭлементИмя, РежимЗагрузкиИскать);
		СписокВыбора = ЗаполнитьСпискиВыбора(ИндексТекущейСтроки, ТекущийЭлементИмя, РежимЗагрузкиИскать);
		Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
		Для Каждого СтрокаСписка Из СписокВыбора Цикл
			Элемент.ТекущийЭлемент.СписокВыбора.Добавить(СтрокаСписка.Значение, СтрокаСписка.Представление);
		КонецЦикла;
		Элемент.ТекущийЭлемент.ТолькоПросмотр = СписокВыбора.Количество() = 0 ИЛИ НЕ РежимЗагрузкиИскать;
	КонецЕсли;
	
	Элементы.ТаблицаЗагружаемыхРеквизитовЗначениеПоУмолчанию.КнопкаВыбора = НЕ ТипЗНЧ(Элемент.ТекущиеДанные.ЗначениеПоУмолчанию) = Тип("Строка");
	
КонецПроцедуры

// Обработчик события "ТаблицаЗагружаемыхРеквизитовВыражениеНачалоВыбора".
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовВыражениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ФормаИмя = "Справочник.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.Форма.ФормаРедактированияВыражения";
	ПараметрыФормы = Новый Структура("Выражение", ЭтотОбъект.ТекущийЭлемент.ТекущиеДанные.Выражение);
	
	ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ТаблицаЗагружаемыхРеквизитовВыражениеОткрытьФормуЗавершение", ЭтотОбъект);
	ОткрытьФорму(ФормаИмя, ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещенияОВыборе, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля "ТаблицаЗагружаемыхРеквизитовНомерКолонки"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовНомерКолонкиПриИзменении(Элемент)
	ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитов);
	РазобратьсяСОформлениемСтрок();
КонецПроцедуры

// Процедура - обработчик события "ПриАктивизацииСтроки"  табличного поля "ТаблицаЗагружаемыхРеквизитов"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовПриАктивизацииСтроки(Элемент)
	
	// Проверка необходима для корректной работы при принудительном обновлении формы
	Если Элементы.ГруппаСтраницыНастройкиЗагрузки.ТекущаяСтраница = Элементы.ГруппаСтраницаНастройкиШапки Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ТекДанные.ИмяРеквизита = "Родитель" Тогда
		Элементы.ТаблицаЗагружаемыхРеквизитовЗначениеПоУмолчанию.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	Иначе
		Элементы.ТаблицаЗагружаемыхРеквизитовЗначениеПоУмолчанию.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.Авто;
	КонецЕсли;
	
	ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитов);
	РазобратьсяСОформлениемСтрок();
КонецПроцедуры

// Обработчик события "ТаблицаЗагружаемыхРеквизитовРежимЗагрузкиНачалоВыбора".
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовРежимЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		ВозможностьУстановкиЗагрузки = ОпределитьВозможностьУстановкиРежимаЗагрузкиДляТекущихДанных(ТекущиеДанные.ОписаниеТипов, ТекущиеДанные.ЗначениеПоУмолчанию);
		СписокВыбораЭлемента = Элемент.СписокВыбора;
		Если ВозможностьУстановкиЗагрузки И СписокВыбораЭлемента.Количество() = 3 Тогда
			СписокВыбораЭлемента.Добавить("Загружать", "Загружать");
		ИначеЕсли Не ВозможностьУстановкиЗагрузки И СписокВыбораЭлемента.Количество() = 4 Тогда
			СписокВыбораЭлемента.Удалить(СписокВыбораЭлемента.Количество() - 1);
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля "ТаблицаЗагружаемыхРеквизитовРежимПоиска"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовРежимПоискаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		ВозможностьУстановкиРежима = ОпределитьВозможностьУстановкиРежимаПоискаДляТекущихДанных(ТекущиеДанные.ИмяРеквизита, ТекущиеДанные.ОписаниеТипов, ТекущиеДанные.ИскатьПо, ТекущиеДанные.ЗначениеПоУмолчанию);
		СтандартнаяОбработка = ВозможностьУстановкиРежима;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовИскатьПоПриИзменении(Элемент)
	
	СтрокаНастройкиЗагрузкиНоменклатуры=Неопределено;
	ОтборСтрок = Новый Структура("ПредставлениеРеквизита", "Номенклатура");
	СтрокиТаблицы = ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(ОтборСтрок);
	Если СтрокиТаблицы.Количество() > 0 Тогда
		СтрокаНастройкиЗагрузкиНоменклатуры = СтрокиТаблицы[0];
		Если НЕ СтрокаНастройкиЗагрузкиНоменклатуры.Пометка ИЛИ (СтрокаНастройкиЗагрузкиНоменклатуры.РежимЗагрузки = "Искать" И СтрокаНастройкиЗагрузкиНоменклатуры.НомерКолонки=0) Тогда
			СтрокаНастройкиЗагрузкиНоменклатуры = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаНастройкиЗагрузкиНоменклатуры=Неопределено Тогда
		Элементы.НомерКолонкиНаименованиеТабличногоДокумента.Видимость = Ложь;
	Иначе
		НастройкиЗагрузкиНоменклатурыИскатьПо = СтрокаНастройкиЗагрузкиНоменклатуры.ИскатьПо;
		Элементы.НомерКолонкиНаименованиеТабличногоДокумента.Видимость = НЕ НастройкиЗагрузкиНоменклатурыИскатьПо="Наименование";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗначениеПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ЭтоШапка = СтрНачинаетсяС(Элемент.Имя, "ТаблицаЗагружаемыхРеквизитовШапки");
	Если ЭтоШапка Тогда
		ТекДанные = Элементы.ТаблицаЗагружаемыхРеквизитовШапки.ТекущиеДанные;
	Иначе
		ТекДанные = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
	КонецЕсли;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ЗначениеПоУмолчанию = Неопределено
		И ТекДанные.ДоступноеОписаниеТипов.Типы().Количество() > 1 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СписокТипов = Новый СписокЗначений;
		СписокТипов.ЗагрузитьЗначения(ТекДанные.ДоступноеОписаниеТипов.Типы());
		ВыбранныйТип = Ждать СписокТипов.ВыбратьЭлементАсинх(НСтр("ru = 'Выбор типа данных'"));
		
		Если ВыбранныйТип <> Неопределено Тогда
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ВыбранныйТип.Значение);
			ОписаниеВыбранныйТип = Новый ОписаниеТипов(МассивТипов);
			ТекДанные.ЗначениеПоУмолчанию = ОписаниеВыбранныйТип.ПривестиЗначение(ТекДанные.ЗначениеПоУмолчанию);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЭтоШапка И ТекДанные.ИмяРеквизита = "Родитель" Тогда
		ФормаВыбора = ПолучитьФормуВыбораОбъектаМетаданных(ТипЗнч(ТекДанные.ЗначениеПоУмолчанию));
		Если ФормаВыбора <> Неопределено Тогда
			СтандартнаяОбработка = Ложь;
			
			ПараметрыФормы = Новый Структура();
			ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
			ПараметрыФормы.Вставить("РежимВыбора", Истина);
			ОткрытьФорму(ФормаВыбора, ПараметрыФормы, Элемент);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеПоУмолчаниюОчистка(Элемент, СтандартнаяОбработка)
	
	Если СтрНачинаетсяС(Элемент.Имя, "ТаблицаЗагружаемыхРеквизитовШапки") Тогда
		ТекДанные = Элементы.ТаблицаЗагружаемыхРеквизитовШапки.ТекущиеДанные;
	Иначе
		ТекДанные = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекДанные <> Неопределено
		И ТекДанные.ДоступноеОписаниеТипов.Типы().Количество() > 1 Тогда
		СтандартнаяОбработка = Ложь;
		ТекДанные.ЗначениеПоУмолчанию = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовЗначениеПоУмолчаниюАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ТекДанные.ИмяРеквизита = "Родитель" Тогда
		
		ДанныеВыбораРодителя = ПолучитьДанныеВыбораРодителя(ТипЗнч(ТекДанные.ЗначениеПоУмолчанию), ПараметрыПолученияДанных, СтандартнаяОбработка);
		Если Не СтандартнаяОбработка Тогда
			ДанныеВыбора = ДанныеВыбораРодителя;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеВыбораРодителя(Тип, ПараметрыПолученияДанных, СтандартнаяОбработка = Истина)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	Если Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	Если Не ОбъектМетаданных.Иерархический
		Или ОбъектМетаданных.ВидИерархии <> Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ПустаяСтрока(ПараметрыПолученияДанных.СтрокаПоиска) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 5
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Таблица
		|ГДЕ
		|	Таблица.ЭтоГруппа");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура", ОбъектМетаданных.Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		ДанныеВыбора = Новый СписокЗначений;
		Пока Выборка.Следующий() Цикл
			ДанныеВыбора.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Иначе
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ЭтоГруппа", Истина);
		
		ПараметрыПолученияДанных.Отбор = ПараметрыОтбора;
		ПараметрыПолученияДанных.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы;
		
		ДанныеВыбора = Справочники[ОбъектМетаданных.Имя].ПолучитьДанныеВыбора(ПараметрыПолученияДанных);
	КонецЕсли;
	
	Возврат ДанныеВыбора;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаЗагружаемыхРеквизитовШапки

// Процедура - обработчик события "ПриАктивизацииСтроки" табличного поля "ТаблицаЗагружаемыхРеквизитовШапки"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиПриАктивизацииСтроки(Элемент)
	
	// Проверка необходима для корректной работы при принудительном обновлении формы
	Если Элементы.ГруппаСтраницыНастройкиЗагрузки.ТекущаяСтраница = Элементы.ГруппаСтраницаНастройкиТабличнойЧасти Тогда
		Возврат;
	КонецЕсли;
	
	ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитовШапки);
	РазобратьсяСОформлениемСтрок();
	
КонецПроцедуры

// Процедура - обработчик события "ПередНачаломИзменения" табличного поля "ТаблицаЗагружаемыхРеквизитовШапки"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиПередНачаломИзменения(Элемент, Отказ)
	
	ИндексТекущейСтроки = ТаблицаЗагружаемыхРеквизитовШапки.Индекс(Элемент.ТекущиеДанные);
	ТекущийЭлементИмя = Элемент.ТекущийЭлемент.Имя;
	РежимЗагрузкиИскать = Элемент.ТекущиеДанные.РежимЗагрузки = "Искать";
	
	Если ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиИскатьПо"
	 ИЛИ ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиСвязьПоВладельцу"
	 ИЛИ ТекущийЭлементИмя = "ТаблицаЗагружаемыхРеквизитовШапкиСвязьПоТипу" Тогда
		СписокВыбора = ЗаполнитьСпискиВыбораШапки(ИндексТекущейСтроки, ТекущийЭлементИмя, РежимЗагрузкиИскать);
		Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
		Для Каждого СтрокаСписка Из СписокВыбора Цикл
			Элемент.ТекущийЭлемент.СписокВыбора.Добавить(СтрокаСписка.Значение, СтрокаСписка.Представление);
		КонецЦикла;
		Элемент.ТекущийЭлемент.ТолькоПросмотр = СписокВыбора.Количество() = 0 ИЛИ НЕ РежимЗагрузкиИскать;
	КонецЕсли;
	
	Элементы.ТаблицаЗагружаемыхРеквизитовШапкиЗначениеПоУмолчанию.КнопкаВыбора = НЕ ТипЗНЧ(Элемент.ТекущиеДанные.ЗначениеПоУмолчанию) = Тип("Строка");
	
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля "ТаблицаЗагружаемыхРеквизитовШапкиРежимЗагрузки"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиРежимЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаЗагружаемыхРеквизитовШапки.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		ВозможностьУстановкиЗагрузки = ОпределитьВозможностьУстановкиРежимаЗагрузкиДляТекущихДанных(ТекущиеДанные.ОписаниеТипов, ТекущиеДанные.ЗначениеПоУмолчанию);
		СписокВыбораЭлемента = Элемент.СписокВыбора;
		Если ВозможностьУстановкиЗагрузки И СписокВыбораЭлемента.Количество() = 3 Тогда
			СписокВыбораЭлемента.Добавить("Загружать", "Загружать");
		ИначеЕсли Не ВозможностьУстановкиЗагрузки И СписокВыбораЭлемента.Количество() = 4 Тогда
			СписокВыбораЭлемента.Удалить(СписокВыбораЭлемента.Количество() - 1);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля "ТаблицаЗагружаемыхРеквизитовШапкиНомерКолонки"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиНомерКолонкиПриИзменении(Элемент)
	
	ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитовШапки);
	РазобратьсяСОформлениемСтрок();
	
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля "ТаблицаЗагружаемыхРеквизитовШапкиВыражение"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиВыражениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ФормаИмя = "Справочник.ор_НастройкиЗагрузкиДанныхИзТабличногоДокумента.Форма.ФормаРедактированияВыражения";
	ПараметрыФормы = Новый Структура("Выражение", ЭтотОбъект.ТекущийЭлемент.ТекущиеДанные.Выражение);
	
	ОписаниеОповещенияВыбора = Новый ОписаниеОповещения("ТаблицаЗагружаемыхРеквизитовШапкиВыражениеОткрытьФормуЗавершение", ЭтотОбъект);
	ОткрытьФорму(ФормаИмя, ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещенияВыбора, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
	
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля "ТаблицаЗагружаемыхРеквизитовШапкиРежимПоиска"
//
&НаКлиенте
Процедура ТаблицаЗагружаемыхРеквизитовШапкиРежимПоискаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаЗагружаемыхРеквизитовШапки.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		ВозможностьУстановкиРежима = ОпределитьВозможностьУстановкиРежимаПоискаДляТекущихДанных(ТекущиеДанные.ИмяРеквизита, ТекущиеДанные.ОписаниеТипов, ТекущиеДанные.ИскатьПо, ТекущиеДанные.ЗначениеПоУмолчанию);
		СтандартнаяОбработка = ВозможностьУстановкиРежима;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("СохранитьНастройкиЗавершение", ЭтотОбъект), "Записать измененные настройки?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Процедура - обработчик команды "УстановитьКолонку"
//
&НаКлиенте
Процедура УстановитьКолонку(Команда)
	
	Если Объект.ТабличныйДокумент.ТекущаяОбласть = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерКолонки = Объект.ТабличныйДокумент.ТекущаяОбласть.Лево;
	
	Если НомерКолонки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ГруппаСтраницыНастройкиЗагрузки.ТекущаяСтраница = Элементы.ГруппаСтраницаНастройкиШапки Тогда
		ТекСтрока = Элементы.ТаблицаЗагружаемыхРеквизитовШапки.ТекущиеДанные;
		ЭтоСтраницаШапки = Истина;
	Иначе
		ТекСтрока = Элементы.ТаблицаЗагружаемыхРеквизитов.ТекущиеДанные;
		ЭтоСтраницаШапки = Ложь;
	КонецЕсли;

	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекСтрока.НомерКолонки = НомерКолонки Тогда
		Возврат;
	ИначеЕсли ТекСтрока.НомерКолонки<>0 Тогда
		ТекстВопроса = "Для текущего реквизита """+СокрЛП(ТекСтрока.ПредставлениеРеквизита)+""" уже установлен номер колонки "+ТекСтрока.НомерКолонки+". Изменить его на номер "+НомерКолонки+"?";
		ОписаниеОповещенияВопроса = Новый ОписаниеОповещения("УстановитьКолонкуОбработкаВопроса", ЭтотОбъект, Новый Структура("ТекСтрока, НомерКолонки, ЭтоСтраницаШапки", ТекСтрока, НомерКолонки, ЭтоСтраницаШапки));
		ПоказатьВопрос(ОписаниеОповещенияВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	УстановитьКолонкуЗавершение(Новый Структура("ТекСтрока, НомерКолонки, ЭтоСтраницаШапки", ТекСтрока, НомерКолонки, ЭтоСтраницаШапки));
	
КонецПроцедуры

// Процедура - обработчик команды "События"
//
&НаКлиенте
Процедура События(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПередЗаписьюОбъекта",   Объект.ПередЗаписьюОбъекта);
	ПараметрыФормы.Вставить("ПриЗаписиОбъекта",      Объект.ПриЗаписиОбъекта);
	ПараметрыФормы.Вставить("ПослеДобавленияСтроки", Объект.ПослеДобавленияСтроки);
	ПараметрыФормы.Вставить("РежимЗагрузки",         Объект.РежимЗагрузки);
	
	ОткрытьФорму("Обработка.ор_ЗагрузкаДанныхИзТабличногоДокумента.Форма.ФормаРедактированияСобытий",
		Новый Структура("ПараметрыФормы", ПараметрыФормы),
		ЭтотОбъект,
		,,,
		Новый ОписаниеОповещения("СобытияОткрытьФормуЗавершение", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

// Процедура - обработчик команды "СнятьФлажки"
//
&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	ор_ЗагрузкаИзЭлектронныхДокументовКлиент.УстановитьФлагТаблицы(Ложь, ТаблицаЗагружаемыхРеквизитов);
	
КонецПроцедуры

// Процедура - обработчик команды "УстановитьФлажки"
//
&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	ор_ЗагрузкаИзЭлектронныхДокументовКлиент.УстановитьФлагТаблицы(Истина, ТаблицаЗагружаемыхРеквизитов);
	
КонецПроцедуры

// Процедура - обработчик команды "РучнаяНумерацияКолонокТабличногоДокумента"
//
&НаКлиенте
Процедура РучнаяНумерацияКолонокТабличногоДокумента(Команда)
	
	УстановитьРучнаяНумерацияКолонок();
	Элементы.ТаблицаЗагружаемыхРеквизитовНомерКолонки.Видимость = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
	Элементы.ТаблицаЗагружаемыхРеквизитовПеренумероватьКолонки.Доступность = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
	Элементы.ТаблицаЗагружаемыхРеквизитовРучнаяНумерацияКолонокТабличногоДокумента.Пометка = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
	ИзмененаРучнаяНумерацияКолонок = Истина;
	
КонецПроцедуры

// Процедура - обработчик команды "ПоказатьНастройки"
//
&НаКлиенте
Процедура ПоказатьНастройки(Команда)
	УстановитьВидимостьНастроекЗагрузки();
	ОбновитьОтображениеДанных();
	ЗаполнитьМассивКнопок();
	ПодсветитьВыбраннуюКолонку(Неопределено);
КонецПроцедуры

// Процедура - обработчик команды "ПодключаемыеКнопкиНажатие"
//
&НаКлиенте
Процедура ПодключаемыеКнопкиНажатие(Команда)
	
	НомерКолонки = Объект.ТабличныйДокумент.ТекущаяОбласть.Лево;
	Если НомерКолонки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ГруппаСтраницыНастройкиЗагрузки.ТекущаяСтраница = Элементы.ГруппаСтраницаНастройкиШапки Тогда
		ТекущаяТаблица = ТаблицаЗагружаемыхРеквизитовШапки;
		ЭтоСтраницаШапки = Истина;
	Иначе
		ТекущаяТаблица = ТаблицаЗагружаемыхРеквизитов;
		ЭтоСтраницаШапки = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаТек Из ТекущаяТаблица Цикл
		Если Команда.Имя = "ПодключаемаяКнопка_"+СтрокаТек.ИмяРеквизита Тогда
			Если Элементы[Команда.Имя].Пометка Тогда
				СтрокаТек.НомерКолонки = 0;
			Иначе
				СтрокаТек.НомерКолонки = НомерКолонки;
				Если Не СтрокаТек.Пометка Тогда
					СтрокаТек.Пометка = Истина;
				КонецЕсли;
				Если НЕ Объект.РучнаяНумерацияКолонокТабличногоДокумента Тогда
					Объект.РучнаяНумерацияКолонокТабличногоДокумента = Истина;
					Элементы.ТаблицаЗагружаемыхРеквизитовНомерКолонки.Видимость = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
					Элементы.ТаблицаЗагружаемыхРеквизитовПеренумероватьКолонки.Доступность = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
					Элементы.ТаблицаЗагружаемыхРеквизитовРучнаяНумерацияКолонокТабличногоДокумента.Пометка = Объект.РучнаяНумерацияКолонокТабличногоДокумента;
				ИначеЕсли НЕ Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки И ЭтоСтраницаШапки Тогда
					Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки = Истина;
					Элементы.ТаблицаЗагружаемыхРеквизитовШапкиНомерКолонки.Видимость = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
					Элементы.ТаблицаЗагружаемыхРеквизитовШапкиПеренумероватьКолонкиНастройкиШапки.Доступность = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
					Элементы.ТаблицаЗагружаемыхРеквизитовШапкиРучнаяНумерацияКолонокНастройкиШапки.Пометка = Объект.РучнаяНумерацияКолонокТабличногоДокументаДляШапки;
				КонецЕсли;
			КонецЕсли;
			РасставитьПометкиНаКнопках(НомерКолонки);
			РазобратьсяСОформлениемСтрок();
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура - обработчик команды "ПеренумероватьКолонки"
//
&НаКлиенте
Процедура ПеренумероватьКолонки(Команда)
	
	НомерКолонки = 1;
	Для Каждого Реквизит Из ТаблицаЗагружаемыхРеквизитов Цикл
		Если Реквизит.Пометка Тогда
			Если НЕ Реквизит.НомерКолонки = НомерКолонки Тогда
				Реквизит.НомерКолонки = НомерКолонки;
			КонецЕсли;
			НомерКолонки = НомерКолонки + 1;
		Иначе
			Реквизит.НомерКолонки = 0;
		КонецЕсли;
		
		Если Реквизит.НомерКолонки = 0 И Реквизит.РежимЗагрузки = "Искать" Тогда
			Реквизит.РежимЗагрузки = "Устанавливать"
		ИначеЕсли НЕ Реквизит.НомерКолонки = 0 И Реквизит.РежимЗагрузки = "Устанавливать" Тогда
			Реквизит.РежимЗагрузки = "Искать"
		КонецЕсли;
	КонецЦикла;
	
	ИзмененаРучнаяНумерацияКолонок = Истина;
	ЭтотОбъект.ТекущийЭлемент = Элементы.ТаблицаЗагружаемыхРеквизитов;
	ПодсветитьВыбраннуюКолонку(Элементы.ТаблицаЗагружаемыхРеквизитов);
	РазобратьсяСОформлениемСтрок();
	
КонецПроцедуры

// Процедура - обработчик команды "Далее"
//
&НаКлиенте
Процедура КомандаДалее(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаВыборНастройки Тогда
		
		Инкремент = 1;
		
		ОписаниеОшибок = "";
		Если НЕ ЗначениеЗаполнено(ФайлДанных) Тогда
			ОписаниеОшибок = ОписаниеОшибок+"Файл данных не указан"+Символы.ПС;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НастройкаЗагрузки) Тогда
			ОписаниеОшибок = ОписаниеОшибок+"Настройка загрузки не указана"+Символы.ПС;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ОписаниеОшибок) Тогда
			ПоказатьПредупреждение(,Лев(ОписаниеОшибок,СтрДлина(ОписаниеОшибок)-СтрДлина(Символы.ПС)),,"Ошибка");
			Возврат;
		КонецЕсли;
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаХодЗагрузки;
		Элементы.ИнформацияЗагрузки.Заголовок = НСтр("ru = 'Выполняется загрузка данных из файла.
		|Операция может занять несколько минут...'");
		УстановитьДоступностьКнопок();
		
		// Подключение настройки загрузки
		Попытка
			Если ЗначениеЗаполнено(НастройкаЗагрузки) Тогда
				Настройки = ор_ЗагрузкаИзЭлектронныхДокументовВызовСервера.ПолучитьНастройкуИзХранилища(НастройкаЗагрузки);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		ЗаполнитьНастройкиКолонок(Настройки);
		
		СтрокаНастройкиЗагрузкиНоменклатуры=Неопределено;
		ОтборСтрок = Новый Структура("ПредставлениеРеквизита", "Номенклатура");
		СтрокиТаблицы = ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(ОтборСтрок);
		Если СтрокиТаблицы.Количество() > 0 Тогда
			СтрокаНастройкиЗагрузкиНоменклатуры = СтрокиТаблицы[0];
			Если НЕ СтрокаНастройкиЗагрузкиНоменклатуры.Пометка ИЛИ (СтрокаНастройкиЗагрузкиНоменклатуры.РежимЗагрузки = "Искать" И СтрокаНастройкиЗагрузкиНоменклатуры.НомерКолонки=0) Тогда
				СтрокаНастройкиЗагрузкиНоменклатуры = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		// Проверка настройки загрузки
		ОтборСтрок = Новый Структура("Пометка", Истина);
		СтрокиТаблицы = ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(ОтборСтрок);
		Если СтрокиТаблицы.Количество() = 0 Тогда
			ПоказатьПредупреждение(,"В настройке загрузки не отмечен ни один загружаемый реквизит");
			Возврат;
		КонецЕсли;
		
		// Загрузка данных из файла
		ФайлНаДиске = Новый Файл(ФайлДанных);
		Если НЕ ФайлНаДиске.Существует() ИЛИ ФайлНаДиске.ЭтоКаталог() Тогда
			ПоказатьПредупреждение(,"Файл данных не существует",,"Ошибка");
			Возврат;
		КонецЕсли;
		Если Объект.ИспользоватьВнешнийМодульПреобразованияФайла И НЕ ЗначениеЗаполнено(Объект.ОбработкаПреобразования) Тогда
			ПоказатьПредупреждение(,"В настройке загрузки указано, что файл преобразовывается в табличный документ внешней обработкой, но обработка не указана!",,"Ошибка");
			Возврат;
		КонецЕсли;
		
		
		ОписаниеОповещенияПомещениеФайлов = Новый ОписаниеОповещения("КомандаДалееЗагрузкаФайлаЗавершение", ЭтотОбъект, Новый Структура("Инкремент, ФайлНаДиске", Инкремент, ФайлНаДиске));
		НачатьПомещениеФайлов(ОписаниеОповещенияПомещениеФайлов,, ФайлДанных, Ложь, УникальныйИдентификатор);
		Возврат;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаИсточникДанных Тогда
		
		Инкремент = 1;
		
		КоличествоЭлементов = Объект.ТабличныйДокумент.ВысотаТаблицы - Объект.ПерваяСтрокаДанныхТабличногоДокумента + 1;
		Если КоличествоЭлементов <= 0 Тогда
			ПоказатьПредупреждение(,"Нет данных для загрузки");
			Возврат;
		КонецЕсли;
		
		Если Объект.ПерваяСтрокаДанныхТабличногоДокумента = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не указана первая строка данных табличного документа");
			Возврат;
		КонецЕсли;
		
		Если Объект.ПерваяСтрокаДанныхШапки = 0 И ЕстьОтмеченныеСтрокиВНастройкахШапки() Тогда
			ТекстСообщения = "Не указана строка для загрузки данных шапки документа!";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,"ПерваяСтрокаДанныхШапки");
			Возврат;
		КонецЕсли;
		
		СтрокаНастройкиЗагрузкиНоменклатуры=Неопределено;
		ОтборСтрок = Новый Структура("ПредставлениеРеквизита", "Номенклатура");
		СтрокиТаблицы = ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(ОтборСтрок);
		Если СтрокиТаблицы.Количество() > 0 Тогда
			СтрокаНастройкиЗагрузкиНоменклатуры = СтрокиТаблицы[0];
			Если НЕ СтрокаНастройкиЗагрузкиНоменклатуры.Пометка ИЛИ (СтрокаНастройкиЗагрузкиНоменклатуры.РежимЗагрузки = "Искать" И СтрокаНастройкиЗагрузкиНоменклатуры.НомерКолонки=0) Тогда
				СтрокаНастройкиЗагрузкиНоменклатуры = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		// Проверим - необходимо ли показать страницу "СоответствиеНоменклатуры" 
		Если СтрокаНастройкиЗагрузкиНоменклатуры=Неопределено ИЛИ СтрокаНастройкиЗагрузкиНоменклатуры.РежимЗагрузки<>"Искать" Тогда
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаХодЗагрузки;
			Элементы.ИнформацияЗагрузки.Заголовок = НСтр("ru = 'Выполняется обработка данных.
			|Операция может занять несколько минут...'");
			УстановитьДоступностьКнопок();
			ЗагрузитьДанныеВФорме(Объект.ТабличныйДокумент, ОписаниеОшибок, "");
			// выполним действия с файлом после загрузки
			Попытка
				Файл = Новый Файл(ФайлДанных);
				Если Объект.ДействиеСЗагружаемымФайлом = 0 Тогда
					КаталогАрхиваПеремещаемыхФайлов = Объект.КаталогАрхиваЗагруженныхФайлов+"\"+Строка(Формат(ТекущаяДата(),"ДФ=""дд-ММ-гггг"""));
					СоздатьКаталог(КаталогАрхиваПеремещаемыхФайлов);
					ПереместитьФайл(ФайлДанных, КаталогАрхиваПеремещаемыхФайлов+"\"+Файл.Имя);
				ИначеЕсли Объект.ДействиеСЗагружаемымФайлом = 1 Тогда
					УдалитьФайлы(Файл.ПолноеИмя);
				КонецЕсли;
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				СтрокаОшибки ="Ошибка при выполнении действий с файлом после загрузки"+Символы.ПС+Символы.ПС;
				ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
				Пока ИнформацияОбОшибке<>Неопределено Цикл
					СтрокаОшибки = СтрокаОшибки+"   "+ИнформацияОбОшибке.Описание+Символы.ПС;
					ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
				КонецЦикла;
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрокаОшибки); //Загрузку все равно произвели, можно закрывать форму
			КонецПопытки;
			ЗаполнитьРезультатРаботы(ОписаниеОшибок);
			Инкремент = 2;
		Иначе
			
			ОтборСтрок = Новый Структура("ИмяРеквизита", "Наименование товара");
			СтрокиТаблицы = ТаблицаДополнительныхПараметров.НайтиСтроки(ОтборСтрок);
			Если СтрокиТаблицы.Количество() > 0 Тогда
				СтрокаНастройки = СтрокиТаблицы[0];
				Если СтрокаНастройкиЗагрузкиНоменклатуры.ИскатьПо<>"Наименование"
					И СтрокаНастройки.НомерКолонки=0 Тогда
					ПоказатьПредупреждение(,"Не указан номер колонки наименования номенклатуры в табличном документе.");
					Возврат;
				КонецЕсли;
				НастройкиЗагрузкиНоменклатурыИскатьПо = СтрокаНастройкиЗагрузкиНоменклатуры.ИскатьПо;
				Элементы.СоответствиеНоменклатурыНаименование.Видимость = НЕ НастройкиЗагрузкиНоменклатурыИскатьПо="Наименование";
			КонецЕсли;
			
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаХодЗагрузки;
			Элементы.ИнформацияЗагрузки.Заголовок = НСтр("ru = 'Выполняется обработка данных.
			|Операция может занять несколько минут...'");
			УстановитьДоступностьКнопок();
			УправлениеДиалогом();
			
			// Пользователь первый раз перешел на эту страницу
			Если Объект.СоответствиеНоменклатуры.Количество()=0 Тогда
				Результат = ЗагрузитьСоответствиеНоменклатуры(Объект.ТабличныйДокумент);
				Если НЕ Результат Тогда
					Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаИсточникДанных;
					УстановитьДоступностьКнопок();
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаСоответствияНоменклатуры Тогда
		
		Инкремент = 1;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаХодЗагрузки;
		Элементы.ИнформацияЗагрузки.Заголовок = НСтр("ru = 'Выполняется обработка данных.
		|Операция может занять несколько минут...'");
		УстановитьДоступностьКнопок();
		
		ЗагрузитьДанныеВФорме(Объект.ТабличныйДокумент, ОписаниеОшибок, НастройкиЗагрузкиНоменклатурыИскатьПо);
		// выполним действия с файлом после загрузки
		Попытка
			Файл = Новый Файл(ФайлДанных);
			Если Объект.ДействиеСЗагружаемымФайлом = 0 Тогда
				КаталогАрхиваПеремещаемыхФайлов = Объект.КаталогАрхиваЗагруженныхФайлов+"\"+Строка(Формат(ТекущаяДата(),"ДФ=""дд-ММ-гггг"""));
				СоздатьКаталог(КаталогАрхиваПеремещаемыхФайлов);
				ПереместитьФайл(ФайлДанных, КаталогАрхиваПеремещаемыхФайлов+"\"+Файл.Имя);
			ИначеЕсли Объект.ДействиеСЗагружаемымФайлом = 1 Тогда
				УдалитьФайлы(Файл.ПолноеИмя);
			КонецЕсли;
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			СтрокаОшибки ="Ошибка при выполнении действий с файлом после загрузки"+Символы.ПС+Символы.ПС;
			ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
			Пока ИнформацияОбОшибке<>Неопределено Цикл
				СтрокаОшибки = СтрокаОшибки+"   "+ИнформацияОбОшибке.Описание+Символы.ПС;
				ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
			КонецЦикла;
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрокаОшибки); //Загрузку все равно произвели, можно закрывать форму
		КонецПопытки;
		ЗаполнитьРезультатРаботы(ОписаниеОшибок);
		

	Иначе
		Инкремент = 1;
	КонецЕсли;
	
	КомандаДалееЗавершение(Новый Структура("Инкремент", Инкремент));
	
КонецПроцедуры // КомандаДалее()


#Область ПрограммныйИнтерфейс

// Регистрация в справочнике дополнительных обработок.
// Команда заполнения доступна на форме документа ЧекККМ и меняет объект формы без записи.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.4.1.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиЗаполнениеОбъекта();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Заполнение номеров упаковок чека ККМ'");
	ПараметрыРегистрации.БезопасныйРежим = Истина;
	ПараметрыРегистрации.Информация = НСтр("ru = 'Для каждой строки запасов чека ККМ добавляет одну строку ор_НомераУпаковок из других чеков. Связь строки: ИдентификаторСтроки = ор_ИдентификаторСтроки.'");
	ПараметрыРегистрации.Назначение.Добавить("Документ.ЧекККМ");
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Заполнить номера упаковок из истории чеков'");
	Команда.Идентификатор = "ЗаполнитьНомераУпаковок";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыЗаполнениеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Заполняет ор_НомераУпаковок открытого чека. Документ не записывается.
//
// Параметры:
//  ИдентификаторКоманды - Строка
//  ОбъектыНазначения - Неопределено - для команды заполнения формы не передаётся
//  ПараметрыВыполнения - Структура
//    * ЭтаФорма - ФормаКлиентскогоПриложения - форма чека ККМ
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения, ПараметрыВыполнения) Экспорт
	
	Если ИдентификаторКоманды <> "ЗаполнитьНомераУпаковок" Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестная команда обработки.'");
	КонецЕсли;
	
	ФормаДокумента = Неопределено;
	Если ПараметрыВыполнения <> Неопределено Тогда
		ПараметрыВыполнения.Свойство("ЭтаФорма", ФормаДокумента);
	КонецЕсли;
	Если ФормаДокумента = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Команда выполняется из формы чека ККМ.'");
	КонецЕсли;
	
	Результат = ЗаполнитьНомераУпаковок(ФормаДокумента.Объект);
	ФормаДокумента.Модифицированность = Истина;
	ОбщегоНазначения.СообщитьПользователю(Результат);
	
КонецПроцедуры

// Заполняет номера упаковок выбранного чека и записывает его.
// Проведённый чек записывается в режиме загрузки, без повторного проведения.
//
// Параметры:
//  ЧекККМ - ДокументСсылка.ЧекККМ
//
// Возвращаемое значение:
//  Строка - текст результата
//
Функция ЗаполнитьИЗаписать(ЧекККМ) Экспорт
	
	Если Не ЗначениеЗаполнено(ЧекККМ) Тогда
		ВызватьИсключение НСтр("ru = 'Выберите чек ККМ.'");
	КонецЕсли;
	
	ЧекОбъект = ЧекККМ.ПолучитьОбъект();
	Если ЧекОбъект = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Чек ККМ не найден.'");
	КонецЕсли;
	
	Попытка
		ЧекОбъект.Заблокировать();
	Исключение
		ВызватьИсключение НСтр("ru = 'Не удалось заблокировать чек. Закройте его, если он открыт в другом окне, и повторите заполнение.'");
	КонецПопытки;
	
	Результат = ЗаполнитьНомераУпаковок(ЧекОбъект);
	
	Если ЧекОбъект.Проведен Тогда
		ЧекОбъект.ОбменДанными.Загрузка = Истина;
	КонецЕсли;
	ЧекОбъект.Записать();
	
	Возврат Результат + Символы.ПС + НСтр("ru = 'Чек записан.'");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполнитьНомераУпаковок(ОбъектЧека)
	
	КоличествоСтрокТоваров = ОбъектЧека.Запасы.Количество();
	Если КоличествоСтрокТоваров = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В чеке нет строк товаров.'");
	КонецЕсли;
	
	История = НомераУпаковокИзИстории(ОбъектЧека.Ссылка, КоличествоСтрокТоваров);
	Если История.Количество() < КоличествоСтрокТоваров Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В истории других чеков ККМ найдено %1 различных номеров упаковок, а в чеке %2 строк товаров.'"),
			История.Количество(),
			КоличествоСтрокТоваров);
	КонецЕсли;
	
	ОбъектЧека.ор_НомераУпаковок.Очистить();
	
	Источники = Новый Массив;
	Индекс = 0;
	Для Каждого СтрокаЗапасов Из ОбъектЧека.Запасы Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаЗапасов.ор_ИдентификаторСтроки) Тогда
			СтрокаЗапасов.ор_ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		
		СтрокаИстории = История[Индекс];
		НоваяСтрока = ОбъектЧека.ор_НомераУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстории, ИменаКопируемыхРеквизитов());
		НоваяСтрока.ИдентификаторСтроки = СтрокаЗапасов.ор_ИдентификаторСтроки;
		ОбновитьСтатусЗаполненияУпаковок(ОбъектЧека, СтрокаЗапасов);
		
		ПредставлениеИсточника = Строка(СтрокаИстории.Чек);
		Если Источники.Найти(ПредставлениеИсточника) = Неопределено Тогда
			Источники.Добавить(ПредставлениеИсточника);
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	ОбъектЧека.ор_ЕстьМаркируемаяПродукция = Истина;
	
	Возврат СтрШаблон(
		НСтр("ru = 'Добавлено строк номеров упаковок: %1, по одной на каждую строку запасов.
		|Связь: ор_НомераУпаковок.ИдентификаторСтроки = Запасы.ор_ИдентификаторСтроки.
		|Источники: %2'"),
		КоличествоСтрокТоваров,
		СтрСоединить(Источники, ", "));
	
КонецФункции

Функция НомераУпаковокИзИстории(ТекущийЧек, КоличествоСтрок)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2000
	|	Номера.Ссылка КАК Чек,
	|	Номера.НомерКИЗ КАК НомерКИЗ,
	|	Номера.ПолныйКодМаркировки КАК ПолныйКодМаркировки,
	|	Номера.РазрешительныйРежимИдентификаторЗапросаГИСМТ КАК РазрешительныйРежимИдентификаторЗапросаГИСМТ,
	|	Номера.РазрешительныйРежимДатаЗапросаГИСМТ КАК РазрешительныйРежимДатаЗапросаГИСМТ,
	|	Номера.РазрешительныйРежимИдентификаторЭкземпляраПО КАК РазрешительныйРежимИдентификаторЭкземпляраПО,
	|	Номера.РазрешительныйРежимВерсияБазы КАК РазрешительныйРежимВерсияБазы
	|ИЗ
	|	Документ.ЧекККМ.ор_НомераУпаковок КАК Номера
	|ГДЕ
	|	Номера.Ссылка <> &ТекущийЧек
	|	И НЕ Номера.Ссылка.ПометкаУдаления
	|	И Номера.НомерКИЗ <> """"";
	Запрос.УстановитьПараметр("ТекущийЧек", ТекущийЧек);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	ПеремешатьСтроки(Таблица);
	
	Результат = Таблица.СкопироватьКолонки();
	УжеВыбранные = Новый Соответствие;
	Для Каждого СтрокаИстории Из Таблица Цикл
		Если УжеВыбранные.Получить(СтрокаИстории.НомерКИЗ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеВыбранные.Вставить(СтрокаИстории.НомерКИЗ, Истина);
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаИстории);
		Если Результат.Количество() >= КоличествоСтрок Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПеремешатьСтроки(Таблица)
	
	КоличествоСтрок = Таблица.Количество();
	Если КоличествоСтрок < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Генератор = Новый ГенераторСлучайныхЧисел;
	ИндексПоследней = КоличествоСтрок - 1;
	Для Индекс = 0 По ИндексПоследней - 1 Цикл
		ИндексОбмена = Генератор.СлучайноеЧисло(Индекс, ИндексПоследней);
		Если ИндексОбмена = Индекс Тогда
			Продолжить;
		КонецЕсли;
		Буфер = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Буфер.Вставить(Колонка.Имя, Таблица[Индекс][Колонка.Имя]);
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(Таблица[Индекс], Таблица[ИндексОбмена]);
		ЗаполнитьЗначенияСвойств(Таблица[ИндексОбмена], Буфер);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьСтатусЗаполненияУпаковок(ОбъектЧека, СтрокаЗапасов)
	
	Отбор = Новый Структура("ИдентификаторСтроки", СтрокаЗапасов.ор_ИдентификаторСтроки);
	КоличествоНомеров = ОбъектЧека.ор_НомераУпаковок.НайтиСтроки(Отбор).Количество();
	
	Если КоличествоНомеров > 0 И КоличествоНомеров = СтрокаЗапасов.Количество Тогда
		СтрокаЗапасов.ор_СтатусЗаполненияУпаковок = 1;
	Иначе
		СтрокаЗапасов.ор_СтатусЗаполненияУпаковок = 2;
	КонецЕсли;
	
КонецПроцедуры

Функция ИменаКопируемыхРеквизитов()
	
	Возврат "НомерКИЗ, ПолныйКодМаркировки, РазрешительныйРежимИдентификаторЗапросаГИСМТ, РазрешительныйРежимДатаЗапросаГИСМТ, РазрешительныйРежимИдентификаторЭкземпляраПО, РазрешительныйРежимВерсияБазы";
	
КонецФункции

#КонецОбласти
